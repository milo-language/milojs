// @error: expected StmtId, got BlockId

from "../../src/ast" import {
    StmtId, addBlock, getStmt, newProg
}

fn confuseBlockAndStatement(): void {
    var prog = newProg()
    var statements: Vec<StmtId> = Vec.new()
    let blockId = addBlock(prog, statements)
    let _ = getStmt(prog, blockId)
}
