// @error: expected ExprId, got SwitchId

from "../../src/ast" import {
    SwitchCase, addSwitch, getExpr, newProg
}

fn confuseSwitchAndExpression(): void {
    var prog = newProg()
    var cases: Vec<SwitchCase> = Vec.new()
    let switchId = addSwitch(prog, cases)
    let _ = getExpr(prog, switchId)
}
