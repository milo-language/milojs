get() ERR_MISSING_ARGS | The "name" argument must be specified
getAll() ERR_MISSING_ARGS | The "name" argument must be specified
has() ERR_MISSING_ARGS | The "name" argument must be specified
delete() ERR_MISSING_ARGS | The "name" argument must be specified
append() ERR_MISSING_ARGS | The "name" and "value" arguments must be specified
append(name only) ERR_MISSING_ARGS | The "name" and "value" arguments must be specified
set() ERR_MISSING_ARGS | The "name" and "value" arguments must be specified
