/(z)((a+)?(b+)?(c))*/ on "zaacbbbcac" => zaacbbbcac,z,ac,a,,c
/(?:(a)|(b))+/ on "ab" => ab,,b
/((a)|(b))*/ on "ab" => ab,b,,b
/(?:(a)(b)?)+/ on "aab" => aab,a,b
/(?:(a)(b)?){2,3}/ on "aab" => aab,a,b
/(a)|(b)/ on "b" => b,,b
/(a*)*/ on "aaa" => aaa,aaa
/(a*)+/ on "aaa" => aaa,aaa
