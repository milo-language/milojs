// Unicode property tables for RegExp `\p{...}` / `\P{...}`.
//
// The data lives in src/uniprops.txt, generated by tools/gen-uniprops.mjs from
// node's own ICU (node is the oracle here as everywhere else in this repo). It is
// a DATA file rather than generated Milo: 471 properties as if-trees — the shape
// src/unicase.milo uses — would be megabytes of code, while delta-encoded ranges
// in one embedded string are 65KB and decode with a loop.
//
// Resolution happens once, when a pattern is COMPILED: the ranges go straight
// into the regex's ReClass, so matching costs exactly what `[a-z]` costs and
// nothing decodes per character.

// 5 data bits per character, bit 6 (value 32) as the continuation flag, low
// group first. Must stay in step with the ALPHA table in tools/gen-uniprops.mjs.
fn upDigit(c: u8): i64 {
    if c >= '0' && c <= '9' {
        return (c - '0') as i64
    }
    if c >= 'A' && c <= 'Z' {
        return 10 + (c - 'A') as i64
    }
    if c >= 'a' && c <= 'z' {
        return 36 + (c - 'a') as i64
    }
    if c == '-' {
        return 62
    }
    if c == '_' {
        return 63
    }
    return -1
}

// The whole table, embedded at compile time.
fn upData(): string {
    return @embedFile("uniprops.txt")
}

// Substring search. Local and `up`-prefixed rather than std's strIndexOf, which is
// private to string.milo — and per AGENTS.md a same-named helper here would
// shadow it program-wide.
fn upFind(hay: &string, needle: &string): i64 {
    if needle.len() == 0 || needle.len() > hay.len() {
        return -1
    }
    let last = hay.len() - needle.len()
    var i: i64 = 0
    while i <= last {
        var k: i64 = 0
        while k < needle.len() && hay[i + k] == needle[k] {
            k = k + 1
        }
        if k == needle.len() {
            return i
        }
        i = i + 1
    }
    return -1
}

// Byte offset just past the tab of `<name>\t`, or -1. Anchored to a line start so
// `Script=Han` cannot be found inside `Script=Hanifi_Rohingya`.
fn upFindLine(data: &string, name: &string): i64 {
    let needle = "\n" + name.clone() + "\t"
    let at = upFind(data, needle)
    if at < 0 {
        return -1
    }
    return at + needle.len()
}

// Decode one property's ranges into a flat [lo, hi, lo, hi, ...] vector.
// Returns an empty vector for an unknown name; the caller distinguishes the two
// with uniPropExists, because a property CAN legitimately be empty.
pub fn uniPropRanges(name: &string): Vec<i32> {
    var out: Vec<i32> = Vec.new()
    let data = upData()
    var at = upFindLine(data, name)
    if at < 0 {
        return out
    }
    // an alias line is "=<other name>": follow it once. The generator never
    // chains aliases, so one hop is enough and a cycle is impossible.
    if data[at] == '=' {
        var target = ""
        var k = at + 1
        while k < data.len() && data[k] != 10 as u8 {
            target.push(data[k])
            k = k + 1
        }
        at = upFindLine(data, target)
        if at < 0 {
            return out
        }
    }
    var prevEnd: i64 = -1
    var i = at
    while i < data.len() && data[i] != 10 as u8 {
        // gap from the previous range's end, then the span of this one
        var vals: Vec<i64> = Vec.new()
        var which: i64 = 0
        while which < 2 {
            var n: i64 = 0
            var shift: i64 = 0
            var more = true
            while more {
                let d = upDigit(data[i])
                if d < 0 {
                    return out
                }
                n = n | ((d & 31) << shift)
                more = (d & 32) != 0
                shift = shift + 5
                i = i + 1
            }
            vals.push(n)
            which = which + 1
        }
        let lo = prevEnd + 1 + vals[0]
        let hi = lo + vals[1]
        out.push(lo as i32)
        out.push(hi as i32)
        prevEnd = hi
    }
    return out
}

// Is this a property name the tables know? `\p{NotAProperty}` is an early
// SyntaxError, not a pattern that matches nothing, so the parser has to ask
// before it commits.
pub fn uniPropExists(name: &string): bool {
    let data = upData()
    return upFindLine(data, name) >= 0
}
