@externalLinkage
fn napi_delete_reference(_env: *u8, _ref: i64): i32 {
    return NAPI_OK
}

@externalLinkage
fn napi_reference_unref(_env: *u8, _ref: i64, result: *u8): i32 {
    // node answers napi_invalid_arg for a NULL out-param. Writing to it
    // instead killed the process mid-callback with no output and exit
