// napi_get_property_names(env, object, result) — own enumerable string keys, as an
// array. napi-rs's serde deserializer walks this to build a struct, so a stub that
// returns napi_ok without writing anything leaves it reading an uninitialized
// handle off its own stack.
@externalLinkage
fn napi_get_property_names(_env: *u8, object: i64, result: *u8): i32 {
    // node answers napi_invalid_arg for a NULL out-param. Writing to it
    // instead killed the process mid-callback with no output and exit
    // code 0, which a CI run reads as success.
    if (result as i64) == 0 {
        return NAPI_INVALID_ARG
    }
    match napiValueOf(object) {
        JSValue.Obj(o) => {
            let arr = newArray(gInterp)
            var i: i64 = 0
            while i < gInterp.objects[o].props.len() {
                let k = gInterp.objects[o].props[i].key.clone()
                gInterp.objects[arr].elems.push(JSValue.Str(k))
                i = i + 1
            }
            napiWriteHandle(result, napiHandle(JSValue.Obj(arr)))
            return NAPI_OK
        }
        _ => {
            return NAPI_INVALID_ARG
        }
    }
}

// ── buffers and references ──

// Allocate the stable native view used as a Buffer's `.bytes`. Keeping ownership
// on the view means `const bytes = buf.bytes` also keeps the allocation alive.
fn napiNewBufferView(length: i64, source: *u8): i64 {
    if length < 0 {
        return -1
    }
    var allocLen = length
    if allocLen == 0 {
        allocLen = 1
    }
    var ptr: *u8 = 0 as *u8
    unsafe {
        ptr = malloc(allocLen)
        if (ptr as i64) == 0 {
            return -1
        }
        if length > 0 {
            if (source as i64) != 0 {
                memcpy(ptr, source, length)
            } else {
                memset(ptr, 0, length)
            }
        }
    }
    let view = newObject(gInterp)
    gInterp.objects[view].proto = gInterp.arrayProtoObj
    let ex = ensureExtra(gInterp, view)
    gInterp.objExtras[ex].nativeBufPtr = ptr as i64
    gInterp.objExtras[ex].nativeBufLen = length
    gInterp.objExtras[ex].nativeBufOwned = true
    return view
}

fn napiBufferPrototype(): i64 {
    match scopeLookup(gInterp, 0, "Buffer") {
        JSValue.Func(fnIdx, _env) => {
            return getFuncProto(gInterp, fnIdx)
        }
        _ => {
            return -1
        }
    }
}

fn napiWrapBufferView(view: i64): i64 {
    let buf = newObject(gInterp)
    let proto = napiBufferPrototype()
    if proto >= 0 {
        gInterp.objects[buf].proto = proto
    }
    objSet(gInterp, buf, "bytes", JSValue.Obj(view))
    objSet(gInterp, buf, "length", JSValue.Number(nativeBufferLen(gInterp, view) as f64))
    objSet(gInterp, buf, "__isBuf", JSValue.Bool(true))
    objSetNonEnumerable(gInterp, buf, "__isBuf")
    return buf
}

// JavaScript-created Buffers use a JS array. Promote it once when native code
// asks for a pointer so later C and JS mutations share the stable allocation.
fn napiEnsureBufferView(buf: i64): i64 {
    let existing = bufferNativeViewHandle(gInterp, buf)
    if existing >= 0 {
        return existing
    }
    let bytes = bufferBytesHandle(gInterp, buf)
    if bytes < 0 {
        return -1
    }
    let n = gInterp.objects[bytes].elems.len()
    let view = napiNewBufferView(n, 0 as *u8)
    if view < 0 {
        return -1
    }
    var i: i64 = 0
    while i < n {
        let _ = nativeBufferSet(gInterp, view, i, toNum(gInterp.objects[bytes].elems[i]))
        i = i + 1
    }
    objSet(gInterp, buf, "bytes", JSValue.Obj(view))
    return view
}

@externalLinkage
fn napi_create_buffer(_env: *u8, length: i64, data: *u8, result: *u8): i32 {
    // node answers napi_invalid_arg for a NULL out-param. Writing to it
    // instead killed the process mid-callback with no output and exit
    // code 0, which a CI run reads as success.
    if (result as i64) == 0 {
        return NAPI_INVALID_ARG
    }
    if (result as i64) == 0 || (data as i64) == 0 || length < 0 {
        return NAPI_INVALID_ARG
    }
    let view = napiNewBufferView(length, 0 as *u8)
    if view < 0 {
        return NAPI_GENERIC_FAILURE
    }
    let buf = napiWrapBufferView(view)
    napiWriteHandle(data, nativeBufferPtr(gInterp, view))
    napiWriteHandle(result, napiHandle(JSValue.Obj(buf)))
    return NAPI_OK
}

@externalLinkage
fn napi_create_buffer_copy(_env: *u8, length: i64, source: *u8, data: *u8, result: *u8): i32 {
    // node answers napi_invalid_arg for a NULL out-param. Writing to it
    // instead killed the process mid-callback with no output and exit
    // code 0, which a CI run reads as success.
    if (result as i64) == 0 {
        return NAPI_INVALID_ARG
    }
    if (result as i64) == 0 || length < 0 || (length > 0 && (source as i64) == 0) {
        return NAPI_INVALID_ARG
    }
    let view = napiNewBufferView(length, source)
    if view < 0 {
        return NAPI_GENERIC_FAILURE
    }
    let buf = napiWrapBufferView(view)
    if (data as i64) != 0 {
        napiWriteHandle(data, nativeBufferPtr(gInterp, view))
    }
    napiWriteHandle(result, napiHandle(JSValue.Obj(buf)))
    return NAPI_OK
}

@externalLinkage
fn napi_get_buffer_info(_env: *u8, value: i64, data: *u8, length: *u8): i32 {
    match napiValueOf(value) {
        JSValue.Obj(buf) => {
            let view = napiEnsureBufferView(buf)
            if view < 0 {
                return NAPI_INVALID_ARG
            }
            if (data as i64) != 0 {
                napiWriteHandle(data, nativeBufferPtr(gInterp, view))
            }
            if (length as i64) != 0 {
                napiWriteHandle(length, nativeBufferLen(gInterp, view))
            }
            return NAPI_OK
        }
        _ => {
            return NAPI_INVALID_ARG
        }
    }
}

// Every predicate MUST write its out-param. Returning napi_ok without doing so
// leaves the caller reading an uninitialized bool off its own stack — napi-rs then
// took a plain string for a Buffer and the whole deserialize failed with a bare
// InvalidArg and no reason string.
@externalLinkage
fn napi_is_buffer(_env: *u8, value: i64, result: *u8): i32 {
    // node answers napi_invalid_arg for a NULL out-param. Writing to it
    // instead killed the process mid-callback with no output and exit
    // code 0, which a CI run reads as success.
    if (result as i64) == 0 {
        return NAPI_INVALID_ARG
    }
    match napiValueOf(value) {
        JSValue.Obj(o) => {
            napiWriteBool(result, bufferBytesHandle(gInterp, o) >= 0 || bufferNativeViewHandle(gInterp, o) >= 0)
        }
        _ => {
            napiWriteBool(result, false)
        }
    }
    return NAPI_OK
}

// References keep a value alive across calls. There is no finalizer hook in the
// collector yet, so a reference is simply a handle that is never released — it
// over-retains rather than freeing something the addon still points at.
@externalLinkage
fn napi_create_reference(_env: *u8, value: i64, _initialRefcount: i32, result: *u8): i32 {
    // node answers napi_invalid_arg for a NULL out-param. Writing to it
    // instead killed the process mid-callback with no output and exit
    // code 0, which a CI run reads as success.
    if (result as i64) == 0 {
        return NAPI_INVALID_ARG
    }
    napiWriteHandle(result, napiHandle(napiValueOf(value)))
    return NAPI_OK
}

@externalLinkage
fn napi_get_reference_value(_env: *u8, ref: i64, result: *u8): i32 {
    // node answers napi_invalid_arg for a NULL out-param. Writing to it
    // instead killed the process mid-callback with no output and exit
