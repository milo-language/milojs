// ── promises ──

// napi_create_promise(env, deferred, promise)
//
// The deferred and the promise are the same underlying object here, handed out as
// two handles: milojs settles a promise in place, so there is no separate resolver
// state to track.
fn napiSettle(p: i64, state: i64, value: JSValue) {
    if gNapi.liveDeferred > 0 {
        gNapi.liveDeferred = gNapi.liveDeferred - 1
    }
    gNapi.pending.push(NapiPending {
        promise: p, state: state, value: value
    }
    )
}

// True while an addon owes us a settlement. Keeps the event loop from exiting
// before a worker thread replies.
pub fn napiHasPendingWork(): bool {
    // A live threadsafe function counts: napi-rs resolves an async call by
    // invoking one from a tokio worker, without ever creating a deferred here,
    // so a registered tsfn means a settlement can still arrive from off-thread.
    // Node keeps its loop alive for a ref'd tsfn for the same reason.
    if gNapi.liveDeferred > 0 || gNapi.pending.len() > 0 {
        return true
    }
    var i: i64 = 0
    while i < gNapi.tsfns.len() {
        if gNapi.tsfns[i].refs > 0 && !gNapi.tsfns[i].unrefed {
            return true
        }
        i = i + 1
    }
    return false
}

// Whether a settlement can still arrive from an addon's own threads. Unlike
// napiHasPendingWork this ignores unref'd-ness: napi-rs unrefs its threadsafe
// functions (so they must not keep the process alive), yet they are exactly how
// a query result comes back, so a blocked await still has to wait on them.
// The await's own deadline is the backstop if the addon never answers.
pub fn napiMayDeliver(): bool {
    if gNapi.liveDeferred > 0 || gNapi.pending.len() > 0 {
        return true
    }
    var i: i64 = 0
    while i < gNapi.tsfns.len() {
        if gNapi.tsfns[i].refs > 0 {
            return true
        }
        i = i + 1
    }
    return false
}

// Drained by the interpreter after any call into an addon.
pub fn napiTakePending(): Vec<NapiPending> {
    var out: Vec<NapiPending> = Vec.new()
    while gNapi.pending.len() > 0 {
        out.push(gNapi.pending.remove(0))
    }
    return out
}

@externalLinkage
fn napi_create_promise(_env: *u8, deferred: *u8, promise: *u8): i32 {
    let p = newPromise(gInterp, 0, JSValue.Undefined)
    gNapi.liveDeferred = gNapi.liveDeferred + 1
    napiWriteHandle(deferred, napiHandle(JSValue.Obj(p)))
    napiWriteHandle(promise, napiHandle(JSValue.Obj(p)))
    return NAPI_OK
}

@externalLinkage
fn napi_resolve_deferred(_env: *u8, deferred: i64, resolution: i64): i32 {
    match napiValueOf(deferred) {
        JSValue.Obj(p) => {
            napiSettle(p, 1, napiValueOf(resolution))
            return NAPI_OK
        }
        _ => {
            return NAPI_INVALID_ARG
        }
    }
}

@externalLinkage
fn napi_reject_deferred(_env: *u8, deferred: i64, rejection: i64): i32 {
    match napiValueOf(deferred) {
        JSValue.Obj(p) => {
            napiSettle(p, 2, napiValueOf(rejection))
            return NAPI_OK
        }
        _ => {
            return NAPI_INVALID_ARG
        }
    }
}

// ── threadsafe functions ──
//
// Prisma runs a tokio worker pool and settles its promises from those threads.
// A worker must never touch the interpreter, so napi_call_threadsafe_function does
// exactly one thing: write the queued call into a self-pipe. The event loop drains
// it on the main thread, where calling into JS is safe.
//
// No mutex is needed. A write of <= PIPE_BUF is atomic, so concurrent workers cannot
// interleave within a record.

fn napiEnsurePipe() {
    if gNapi.tsfnR >= 0 {
        return
    }
    unsafe {
        var fds: [i32; 2] = [0; 2]
        if pipe(fds as *i32) != 0 {
            return
        }
        // fd 0/1 would mean pipe() never wrote the array: reading stdin returns EOF
        // and writing "succeeds" straight to the terminal, so the queue silently
        // never delivers. Refuse rather than run in that state.
        if fds[0] <= 2 || fds[1] <= 2 {
            return
        }
        // the loop polls; a blocking read would stall the whole interpreter
        let _r = setNonblocking(fds[0])
        gNapi.tsfnR = fds[0]
        gNapi.tsfnW = fds[1]
    }
}

@externalLinkage
fn napi_create_threadsafe_function(_env: *u8, func: i64, _asyncResource: i64, _asyncResourceName: i64, _maxQueueSize: i64, _initialThreadCount: i64, _threadFinalizeData: i64, _threadFinalizeCb: i64, context: i64, callJsCb: i64, result: *u8): i32 {
    // node answers napi_invalid_arg for a NULL out-param. Writing to it
    // instead killed the process mid-callback with no output and exit
    // code 0, which a CI run reads as success.
    if (result as i64) == 0 {
        return NAPI_INVALID_ARG
    }
    napiEnsurePipe()
    var initialRefs = _initialThreadCount
    if initialRefs < 1 {
        initialRefs = 1
    }
    gNapi.tsfns.push(NapiTsfn {
        jsFunc: napiValueOf(func), callJsCb: callJsCb, context: context, refs: initialRefs, unrefed: false
    }
    )
    // the opaque handle is 1-based so a valid tsfn is never a null pointer
    napiWriteHandle(result, gNapi.tsfns.len())
    return NAPI_OK
}

// CALLED FROM A FOREIGN THREAD. Touch nothing but the pipe fd, which is read-only
// after setup.
@externalLinkage
fn napi_call_threadsafe_function(func: i64, data: i64, _isBlocking: i32): i32 {
    unsafe {
        if gNapi.tsfnW < 0 {
            return NAPI_INVALID_ARG
        }
        var rec: [i64; 2] = [func; 2]
        rec[1] = data
        let n = write(gNapi.tsfnW, rec as *u8, 16)
        if n != 16 {
            return NAPI_INVALID_ARG
        }
    }
    return NAPI_OK
}

@externalLinkage
fn napi_get_threadsafe_function_context(func: i64, result: *u8): i32 {
    // node answers napi_invalid_arg for a NULL out-param. Writing to it
    // instead killed the process mid-callback with no output and exit
    // code 0, which a CI run reads as success.
    if (result as i64) == 0 {
        return NAPI_INVALID_ARG
    }
    let i = func - 1
    if i < 0 || i >= gNapi.tsfns.len() {
        return NAPI_INVALID_ARG
    }
    napiWriteHandle(result, gNapi.tsfns[i].context)
    return NAPI_OK
}

@externalLinkage
fn napi_acquire_threadsafe_function(_func: i64): i32 {
    let i = _func - 1
    if i >= 0 && i < gNapi.tsfns.len() {
        gNapi.tsfns[i].refs = gNapi.tsfns[i].refs + 1
    }
    return NAPI_OK
}

@externalLinkage
fn napi_release_threadsafe_function(_func: i64, _mode: i32): i32 {
    let i = _func - 1
    if i >= 0 && i < gNapi.tsfns.len() {
        // mode 1 is napi_tsfn_abort: drop every outstanding reference at once
        if _mode == 1 {
            gNapi.tsfns[i].refs = 0
        } else if gNapi.tsfns[i].refs > 0 {
            gNapi.tsfns[i].refs = gNapi.tsfns[i].refs - 1
        }
    }
    return NAPI_OK
}

@externalLinkage
fn napi_unref_threadsafe_function(_env: *u8, _func: i64): i32 {
    let i = _func - 1
    if i >= 0 && i < gNapi.tsfns.len() {
        gNapi.tsfns[i].unrefed = true
    }
    return NAPI_OK
}

@externalLinkage
fn napi_ref_threadsafe_function(_env: *u8, _func: i64): i32 {
    let i = _func - 1
    if i >= 0 && i < gNapi.tsfns.len() {
        gNapi.tsfns[i].unrefed = false
    }
    return NAPI_OK
}

// One queued threadsafe call, taken off the pipe on the main thread.
struct NapiTsfnCall {
    tsfn: i64,
    data: i64,
}

// Non-blocking drain. Returns the calls that were waiting.
pub fn napiPollTsfn(): Vec<NapiTsfnCall> {
    var out: Vec<NapiTsfnCall> = Vec.new()
    if gNapi.tsfnR < 0 {
        return out
    }
    unsafe {
        var going = true
        while going {
            var rec: [i64; 2] = [0; 2]
            let n = read(gNapi.tsfnR, rec as *u8, 16)
            if n == 16 {
                out.push(NapiTsfnCall {
                    tsfn: rec[0], data: rec[1]
                }
                )
            } else {
                going = false
            }
        }
    }
    return out
}

// Run one queued call on the main thread. When the addon supplied a call_js_cb it
// owns the dispatch entirely (that is where it converts `data` into JS values);
// otherwise the spec says to invoke the JS function with no arguments.
pub fn napiRunTsfnCall(c: &NapiTsfnCall): JSValue {
    let i = c.tsfn - 1
    if i < 0 || i >= gNapi.tsfns.len() {
        return JSValue.Undefined
    }
    let cb = gNapi.tsfns[i].callJsCb
    if cb != 0 {
        let jsh = napiHandle(cloneValue(gNapi.tsfns[i].jsFunc))
        unsafe {
            let f = (cb as *u8) as extern (*u8, i64, i64, i64) => void
            f(0 as *u8, jsh, gNapi.tsfns[i].context, c.data)
        }
        return JSValue.Undefined
    }
    return cloneValue(gNapi.tsfns[i].jsFunc)
}

extern fn usleep(_usec: u32): i32

// Yield the CPU while waiting on an addon's worker thread. Polling flat out would
// burn a core for the whole duration of a query.
pub fn napiWaitBriefly() {
    unsafe {
        let _r = usleep(200 as u32)
    }
}

pub fn napiHasTsfn(): bool {
    return gNapi.tsfns.len() > 0
}

// ── entry points an addon needs at LINK time ─────────────────────────────────
//
// These were absent from the binary rather than stubbed, so dlopen failed before
// a single line of the addon ran: `sharp` names 52 Node-API symbols and 18 of
// them were missing. A missing symbol is not a missing feature, it is a module
// that cannot load at all, which is why they land together.

// Handle scopes. Every handle this runtime hands out is already mirrored into
// the interpreter's foreign-host root set for its lifetime, so a scope has no
// storage to reclaim and these are bookkeeping. The scope handle is a counter so
// an addon that compares or nests them sees distinct values.
@externalLinkage
fn napi_open_handle_scope(_env: *u8, result: *u8): i32 {
    gNapi.scopeSeq = gNapi.scopeSeq + 1
    if (result as i64) != 0 {
        napiWriteHandle(result, gNapi.scopeSeq)
    }
    return NAPI_OK
}

@externalLinkage
fn napi_close_handle_scope(_env: *u8, _scope: i64): i32 {
    return NAPI_OK
}

@externalLinkage
fn napi_open_escapable_handle_scope(_env: *u8, result: *u8): i32 {
    gNapi.scopeSeq = gNapi.scopeSeq + 1
    if (result as i64) != 0 {
        napiWriteHandle(result, gNapi.scopeSeq)
    }
    return NAPI_OK
}

@externalLinkage
fn napi_close_escapable_handle_scope(_env: *u8, _scope: i64): i32 {
    return NAPI_OK
}

// Escaping a value to the enclosing scope. With no per-scope storage the value
// already outlives the scope, so this hands back a fresh handle to the same
// value rather than moving anything.
@externalLinkage
fn napi_escape_handle(_env: *u8, _scope: i64, escapee: i64, result: *u8): i32 {
    if (result as i64) != 0 {
        napiWriteHandle(result, napiHandle(napiValueOf(escapee)))
    }
    return NAPI_OK
}

// napi_get_last_error_info(env, const napi_extended_error_info** result)
// The struct is { const char* error_message; void* engine_reserved;
//                 uint32_t engine_error_code; napi_status error_code; }
// A caller reads it after a failure to build a message, so the pointer must be
// to storage that outlives this call: it is a single reused static record.
@externalLinkage
fn napi_get_last_error_info(_env: *u8, result: *u8): i32 {
    unsafe {
        if (gNapi.lastErrorInfo as i64) == 0 {
            // { const char* error_message; void* engine_reserved;
            //   uint32_t engine_error_code; napi_status error_code; }
            // 8 + 8 + 4 + 4 = 24 bytes, zeroed: a null message and napi_ok.
            gNapi.lastErrorInfo = malloc(24)
            let _z = memset(gNapi.lastErrorInfo, 0 as i32, 24)
        }
        if (result as i64) != 0 {
            napiWriteHandle(result, gNapi.lastErrorInfo as i64)
        }
    }
    return NAPI_OK
}

@externalLinkage
fn napi_is_exception_pending(_env: *u8, result: *u8): i32 {
    // node answers napi_invalid_arg for a NULL out-param. Writing to it
    // instead killed the process mid-callback with no output and exit
    // code 0, which a CI run reads as success.
    if (result as i64) == 0 {
        return NAPI_INVALID_ARG
    }
    napiWriteBool(result, gInterp.throwing)
    return NAPI_OK
}

@externalLinkage
fn napi_create_type_error(_env: *u8, _code: i64, msg: i64, result: *u8): i32 {
    // node answers napi_invalid_arg for a NULL out-param. Writing to it
    // instead killed the process mid-callback with no output and exit
    // code 0, which a CI run reads as success.
    if (result as i64) == 0 {
        return NAPI_INVALID_ARG
    }
    let o = newObject(gInterp)
    gInterp.objects[o].isError = true
    objSet(gInterp, o, "name", JSValue.Str("TypeError"))
    objSet(gInterp, o, "message", JSValue.Str(toStr(napiValueOf(msg))))
    objSet(gInterp, o, "stack", JSValue.Str("TypeError: " + toStr(napiValueOf(msg))))
    napiWriteHandle(result, napiHandle(JSValue.Obj(o)))
    return NAPI_OK
}

// latin1 is one byte per code point, so each byte is its own code point rather
// than a UTF-8 continuation. Decoding it as UTF-8 mangles anything over 0x7f.
@externalLinkage
fn napi_create_string_latin1(_env: *u8, str: *u8, length: i64, result: *u8): i32 {
    // node answers napi_invalid_arg for a NULL out-param. Writing to it
    // instead killed the process mid-callback with no output and exit
    // code 0, which a CI run reads as success.
    if (result as i64) == 0 {
        return NAPI_INVALID_ARG
    }
    unsafe {
        var out = String.withCapacity(16)
        if length < 0 {
            var i: i64 = 0
            var go = true
            while go {
                let b = _loadU8(((str as i64) + i) as *u8)
                if (b as i64) == 0 {
                    go = false
                } else {
                    encodeCodepoint(out, b as i32)
                    i = i + 1
                }
            }
        } else {
            var i: i64 = 0
            while i < length {
                encodeCodepoint(out, _loadU8(((str as i64) + i) as *u8) as i32)
                i = i + 1
            }
        }
        napiWriteHandle(result, napiHandle(JSValue.Str(out)))
    }
    return NAPI_OK
}

@externalLinkage
fn napi_get_value_int64(_env: *u8, value: i64, result: *u8): i32 {
    // node answers napi_invalid_arg for a NULL out-param. Writing to it
    // instead killed the process mid-callback with no output and exit
    // code 0, which a CI run reads as success.
    if (result as i64) == 0 {
        return NAPI_INVALID_ARG
    }
    napiWriteHandle(result, toNum(napiValueOf(value)) as i64)
    return NAPI_OK
}

@externalLinkage
fn napi_has_property(_env: *u8, object: i64, key: i64, result: *u8): i32 {
    // node answers napi_invalid_arg for a NULL out-param. Writing to it
    // instead killed the process mid-callback with no output and exit
    // code 0, which a CI run reads as success.
    if (result as i64) == 0 {
        return NAPI_INVALID_ARG
    }
    match napiValueOf(object) {
        JSValue.Obj(o) => {
            // objHasInChain, not a hand-rolled walk over `.proto`: a plain
            // object's proto field is -1 and the link to Object.prototype is
            // resolved by type, so walking the raw field misses everything
            // inherited.
            napiWriteBool(result, objHasInChain(gInterp, o, toStr(napiValueOf(key))))
            return NAPI_OK
        }
        _ => {
            napiWriteBool(result, false)
            return NAPI_INVALID_ARG
        }
    }
}

@externalLinkage
fn napi_has_own_property(_env: *u8, object: i64, key: i64, result: *u8): i32 {
    // node answers napi_invalid_arg for a NULL out-param. Writing to it
    // instead killed the process mid-callback with no output and exit
    // code 0, which a CI run reads as success.
    if (result as i64) == 0 {
        return NAPI_INVALID_ARG
    }
    match napiValueOf(object) {
        JSValue.Obj(o) => {
            napiWriteBool(result, objHas(gInterp, o, toStr(napiValueOf(key))))
            return NAPI_OK
        }
        _ => {
            napiWriteBool(result, false)
            return NAPI_INVALID_ARG
        }
    }
}

// napi_get_typedarray_info(env, ta, type*, length*, data**, arraybuffer*, offset*)
// `length` is in ELEMENTS and `data` points at the view's first byte, not the
// buffer's: an addon that reads the buffer base for a subarray sees the wrong
// pixels.
@externalLinkage
fn napi_get_typedarray_info(_env: *u8, typedarray: i64, ttype: *u8, length: *u8, data: *u8, arraybuffer: *u8, byteOffset: *u8): i32 {
    match napiValueOf(typedarray) {
        JSValue.Obj(o) => {
            let ex = gInterp.objects[o].extra
            let buf = gInterp.objExtras[ex].taBuf
            if buf < 0 {
                return NAPI_INVALID_ARG
            }
            let kind = gInterp.objExtras[ex].taKind
            let off = gInterp.objExtras[ex].taOffset
            if (ttype as i64) != 0 {
                napiWriteI32(ttype, napiTypedArrayType(kind))
            }
            if (length as i64) != 0 {
                napiWriteHandle(length, gInterp.objExtras[ex].taLen)
            }
            if (byteOffset as i64) != 0 {
                napiWriteHandle(byteOffset, off)
            }
            if (arraybuffer as i64) != 0 {
                napiWriteHandle(arraybuffer, napiHandle(JSValue.Obj(buf)))
            }
            if (data as i64) != 0 {
                let base = gInterp.objExtras[gInterp.objects[buf].extra].bytes.ptr() as i64
                napiWriteHandle(data, base + off)
            }
            return NAPI_OK
        }
        _ => {
            return NAPI_INVALID_ARG
        }
    }
}

// napi_typedarray_type: int8 0, uint8 1, uint8_clamped 2, int16 3, uint16 4,
// int32 5, uint32 6, float32 7, float64 8, bigint64 9, biguint64 10
fn napiTypedArrayType(kind: i64): i32 {
    // runtime.milo's kind encoding (u8 0, i8 1, u16 2, i16 3, u32 4, i32 5,
    // f32 6, f64 7, u8clamped 8) mapped onto napi_typedarray_type's order
    // (int8 0, uint8 1, uint8_clamped 2, int16 3, uint16 4, int32 5, uint32 6,
    // float32 7, float64 8). The two disagree, so this is a real translation.
    if kind == 0 {
        return 1 as i32
    }
    if kind == 1 {
        return 0 as i32
    }
    if kind == 2 {
        return 4 as i32
    }
    if kind == 3 {
        return 3 as i32
    }
    if kind == 4 {
        return 6 as i32
    }
    if kind == 5 {
        return 5 as i32
    }
    if kind == 6 {
        return 7 as i32
    }
    if kind == 8 {
        return 2 as i32
    }
    return 8 as i32
}

// napi_define_properties(env, object, count, descriptors)
// The same descriptor layout napi_define_class walks, applied to an existing
// object. Accessors are honoured: a getter-only descriptor must not become a
// data property, or an addon's computed field reads as a function.
@externalLinkage
fn napi_define_properties(_env: *u8, object: i64, propertyCount: i64, properties: *u8): i32 {
    match napiValueOf(object) {
        JSValue.Obj(target) => {
            var i: i64 = 0
            unsafe {
                while i < propertyCount {
                    let base = (properties as i64) + i * NAPI_PD_SIZE
                    let namePtr = napiLoadI64((base + NAPI_PD_UTF8NAME) as *u8)
                    var pname = ""
                    if namePtr != 0 {
                        pname = napiReadStr(namePtr as *u8, -1)
                    } else {
                        // the name may arrive as a napi_value instead of a C string
                        let nameVal = napiLoadI64((base + 8) as *u8)
                        if nameVal != 0 {
                            pname = toStr(napiValueOf(nameVal))
                        }
                    }
                    if pname.len() > 0 {
                        let method = napiLoadI64((base + NAPI_PD_METHOD) as *u8)
                        let getter = napiLoadI64((base + 24) as *u8)
                        let setter = napiLoadI64((base + 32) as *u8)
                        let data = napiLoadI64((base + 56) as *u8)
                        if getter != 0 || setter != 0 {
                            var g = JSValue.Undefined
                            var sfn = JSValue.Undefined
                            if getter != 0 {
                                g = JSValue.Obj(napiMakeFn(getter, data))
                            }
                            if setter != 0 {
                                sfn = JSValue.Obj(napiMakeFn(setter, data))
                            }
                            objDefineAccessor(gInterp, target, pname, g, sfn)
                        } else if method != 0 {
                            objSet(gInterp, target, pname, JSValue.Obj(napiMakeFn(method, data)))
                        } else {
                            objSet(gInterp, target, pname, napiValueOf(napiLoadI64((base + NAPI_PD_VALUE) as *u8)))
                        }
                    }
                    i = i + 1
                }
            }
            return NAPI_OK
        }
        _ => {
            return NAPI_INVALID_ARG
        }
    }
}

// napi_add_finalizer(env, js_object, native_object, cb, hint, result)
//
// Recorded, not scheduled. milojs's collector has no finalizer hook (the same
// limitation napi_wrap documents), so the callback is kept against the object
// rather than dropped silently: an addon that registers one and never sees it
// run leaks, and that is worth saying in one place instead of pretending.
@externalLinkage
fn napi_add_finalizer(_env: *u8, jsObject: i64, nativeObject: i64, _finalizeCb: i64, _finalizeHint: i64, result: *u8): i32 {
    match napiValueOf(jsObject) {
        JSValue.Obj(o) => {
            let _ea = ensureExtra(gInterp, o)
            if gInterp.objExtras[gInterp.objects[o].extra].napiWrap == 0 {
                gInterp.objExtras[gInterp.objects[o].extra].napiWrap = nativeObject
            }
            if (result as i64) != 0 {
                napiWriteHandle(result, napiHandle(JSValue.Obj(o)))
            }
            return NAPI_OK
        }
        _ => {
            return NAPI_INVALID_ARG
        }
    }
}

// ── async work ──
//
// node runs `execute` on a libuv threadpool and `complete` back on the loop
// thread. milojs has one JS thread and no worker pool, so queueing runs execute
// immediately and then complete, in that order. An addon sees its work finish
// correctly; what it does NOT get is parallelism, so a long execute blocks the
// loop instead of overlapping with it. Honest and useful is better here than
// absent, which is a module that will not link.
struct NapiWork {
    execute: i64,
    complete: i64,
    data: i64,
    done: bool,
}

var gNapiWork: Vec<NapiWork> = Vec.new()

@externalLinkage
fn napi_create_async_work(_env: *u8, _asyncResource: i64, _asyncResourceName: i64, execute: i64, complete: i64, data: i64, result: *u8): i32 {
    gNapiWork.push(NapiWork {
        execute: execute, complete: complete, data: data, done: false
    }
    )
    if (result as i64) != 0 {
        napiWriteHandle(result, gNapiWork.len())
    }
    return NAPI_OK
}

@externalLinkage
fn napi_queue_async_work(_env: *u8, work: i64): i32 {
    let idx = work - 1
    if idx < 0 || idx >= gNapiWork.len() {
        return NAPI_INVALID_ARG
    }
    if gNapiWork[idx].done {
        return NAPI_OK
    }
    gNapiWork[idx].done = true
    let ex = gNapiWork[idx].execute
    let comp = gNapiWork[idx].complete
    let data = gNapiWork[idx].data
    unsafe {
        if ex != 0 {
            let f = (ex as *u8) as extern (*u8, *u8) => void
            f(0 as *u8, data as *u8)
        }
        if comp != 0 {
            // (env, napi_status status, void* data); status 0 is napi_ok
            let c = (comp as *u8) as extern (*u8, i32, *u8) => void
            c(0 as *u8, 0 as i32, data as *u8)
        }
    }
    return NAPI_OK
}

@externalLinkage
fn napi_delete_async_work(_env: *u8, work: i64): i32 {
    let idx = work - 1
    if idx < 0 || idx >= gNapiWork.len() {
        return NAPI_INVALID_ARG
    }
    gNapiWork[idx].execute = 0
    gNapiWork[idx].complete = 0
    return NAPI_OK
}

// napi_create_external / napi_get_value_external
//
// An external wraps an opaque C pointer in a JS value the addon can hand back to
// itself later. There is no JS-visible shape: the pointer is kept on the object
// and only the addon can read it out. fsevents stores its event-stream handle
// this way.
@externalLinkage
fn napi_create_external(_env: *u8, data: i64, _finalizeCb: i64, _finalizeHint: i64, result: *u8): i32 {
    // node answers napi_invalid_arg for a NULL out-param. Writing to it
    // instead killed the process mid-callback with no output and exit
    // code 0, which a CI run reads as success.
    if (result as i64) == 0 {
        return NAPI_INVALID_ARG
    }
    let o = newObject(gInterp)
    let _ex = ensureExtra(gInterp, o)
    gInterp.objExtras[gInterp.objects[o].extra].napiWrap = data
    gInterp.objExtras[gInterp.objects[o].extra].napiIsExternal = true
    napiWriteHandle(result, napiHandle(JSValue.Obj(o)))
    return NAPI_OK
}

@externalLinkage
fn napi_get_value_external(_env: *u8, value: i64, result: *u8): i32 {
    // node answers napi_invalid_arg for a NULL out-param. Writing to it
    // instead killed the process mid-callback with no output and exit
    // code 0, which a CI run reads as success.
    if (result as i64) == 0 {
        return NAPI_INVALID_ARG
    }
    match napiValueOf(value) {
        JSValue.Obj(o) => {
            napiWriteHandle(result, gInterp.objExtras[gInterp.objects[o].extra].napiWrap)
            return NAPI_OK
        }
        _ => {
            napiWriteHandle(result, 0)
            return NAPI_INVALID_ARG
        }
    }
}
