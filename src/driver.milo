// Shared setup for both entry points: milojs-core (the interpreter) and milojs
// (the runtime). Builds an interpreter, wires the global scope, and runs a source
// string to completion.

from "std/arena" import {
    arenaNew
}
from "./lexer" import {
    lex
}
from "./ast" import {
    BlockId, Prog, Stmt, getStmt, newProg
}
from "./parser" import {
    PState, parseProgram
}
from "./value" import {
    toStr, i64ToStr, JSValue
}
from "./runtime" import {
    Interp, newScope, collect, pushTemp, popTemp
}
from "./eval" import {
    execBlock, execStmt, evalExpr, hoistBlock, makeError, runEventLoop, setupGlobals
}

// gcThreshold is the allocation count that triggers a collection. Lowering it to
// 1 collects at every safepoint, which is how GC-rooting bugs are shaken out —
// see MILOJS_GC_THRESHOLD.
// An Error object stringifies as [object Object], which says nothing about what
// went wrong. Report name and message when the thrown value is an error.
pub fn describeThrown(st: &Interp, v: &JSValue): string {
    let h = objHandle(v)
    if h >= 0 {
        // a real Error, or any error-shaped object (a thrown custom error like
        // test262's Test262Error carries name+message but is not flagged isError,
        // and toStr'ing it just gives the useless "[object Object]")
        let msg = toStr(objGet(st, h, "message"))
        if st.objects[h].isError || objOwnIndex(st, h, "message") >= 0 {
            let name = toStr(objGet(st, h, "name"))
            if name.len() > 0 && msg.len() > 0 {
                return name + ": " + msg
            }
            if msg.len() > 0 {
                return msg
            }
            if name.len() > 0 {
                return name
            }
        }
    }
    return toStr(v)
}

pub fn makeInterp(gcStats: bool, gcThreshold: i64, gcGrowth: i64): Interp {
    return Interp {
        scopes: Vec.new(), freeList: Vec.new(), active: Vec.new(),
        objects: Vec.new(), objFreeList: Vec.new(), objExtras: Vec.new(), objExtraFree: Vec.new(), accessors: arenaNew(), funcProtos: Vec.new(), funcStatics: Vec.new(), regexes: Vec.new(), tempRoots: Vec.new(), hostRoots: Vec.new(), hostRootLive: Vec.new(),
        modPaths: Vec.new(), modBlocks: Vec.new(), modExports: Vec.new(), modState: Vec.new(), modDirStack: Vec.new(), modPathStack: Vec.new(), fnFileStack: Vec.new(),
        throwing: false, genReturning: false, thrownValue: JSValue.Undefined,
        optShort: false, pendingLabel: "", callDepthLimit: 104,
        rngState: 88172645463325252,
        allocSinceGc: 0, promiseCtorObj: -1, stringCtorProps: -1, stringProtoObj: -1, functionProtoObj: -1, nativeProps: Vec.new(), dateCtorProps: -1, dateProtoObj: -1, regexProtoObj: -1, mapProtoObj: -1, setProtoObj: -1, promiseProtoObj: -1, iterProtoObj: -1, arrayCtorObj: -1, objectProtoObj: -1, arrayProtoObj: -1, arrayProtoPristine: false, stringProtoPristine: false, symbolCounter: 0, timers: Vec.new(), microtasks: Vec.new(), nextTimerId: 1, callDepth: 0, mainTask: 0 as *u8, awaitPromise: Vec.new(), awaitTask: Vec.new(), suspended: Vec.new(), genObj: Vec.new(), genFn: Vec.new(), genTask: Vec.new(), genEnv: Vec.new(), genArgs: Vec.new(), genThis: Vec.new(), genYielded: Vec.new(), genSent: Vec.new(), genResumeMode: Vec.new(), genAsync: Vec.new(), genDone: Vec.new(), genThrew: Vec.new(), genErr: Vec.new(), genCaller: Vec.new(), genStarted: Vec.new(), suspendedTask: Vec.new(), actTask: Vec.new(), actCreator: Vec.new(), actNotified: Vec.new(), actEnv: Vec.new(), actArgs: Vec.new(), actThis: Vec.new(), actPromise: Vec.new(), suppressAsyncSpawn: false, suppressGenSpawn: false, fetches: Vec.new(), napiAddonPaths: Vec.new(), napiAddonExports: Vec.new(), newTarget: JSValue.Undefined, reportedMissing: Vec.new(), httpServers: Vec.new(), unhandledRejects: Vec.new(), awaitBudgetMs: 30000.0, listeners: Vec.new(), conns: Vec.new(), connOpen: Vec.new(), sqliteDbs: Vec.new(), sqliteDbLive: Vec.new(), sqliteStmts: Vec.new(), sqliteStmtLive: Vec.new(), sqliteStmtDb: Vec.new(), gcThreshold: gcThreshold, gcMinThreshold: gcThreshold, gcGrowthFactor: gcGrowth, gcRuns: 0, gcStats: gcStats
    }
}

// scope 0 = global (never collected — always a GC root), then install builtins
pub fn bootInterp(st: &mut Interp) {
    // objExtras[0] = the shared read-only default: every object starts with
    // extra==0, so reads of a rare field are valid before any private slot is
    // allocated. ensureExtra never returns 0, so this slot is never mutated.
    st.objExtras.push(defaultExtra())
    newScope(st, -1)
    setupGlobals(st)
}

// Evaluate one script into a persistent program and return its completion value.
// Unlike the CLI path, this never prints an uncaught exception: callers inspect
// st.throwing/st.thrownValue. Keeping `prog` alive is required because functions
// retain indices into its arenas after evaluation returns.
pub fn evalSourceValue(src: &string, prog: &mut Prog, st: &mut Interp): JSValue {
    st.throwing = false
    st.thrownValue = JSValue.Undefined
    let toks = lex(src)
    var p = PState {
        toks: toks, pos: 0, curClass: "", file: "<embed>", errored: false, eofError: false, quiet: true, strict: false
    }
    let top = parseProgram(p, prog)
    if p.errored {
        st.throwing = true
        st.thrownValue = makeError(st, "SyntaxError", "failed to parse script")
        return JSValue.Undefined
    }

    hoistBlock(prog, top, st, 0)
    var completion = JSValue.Undefined
    var i: i64 = 0
    let n = prog.blocks[top.index].len()
    while i < n && !st.throwing {
        let stmtIdx = prog.blocks[top.index][i]
        if i == n - 1 {
            match getStmt(prog, stmtIdx) {
                Stmt.ExprStmt(e) => {
                    completion = evalExpr(prog, e, st, 0)
                }
                _ => {
                    execStmt(prog, stmtIdx, st, 0)
                }
            }
        } else {
            execStmt(prog, stmtIdx, st, 0)
        }
        i = i + 1
    }
    if !st.throwing {
        // Event-loop work can allocate and collect before the C host receives
        // the completion value. Keep it rooted across that drain.
        pushTemp(st, cloneValue(completion))
        runEventLoop(prog, st)
        popTemp(st)
    }
    return completion
}

// Lex, parse, and execute a source string in the given interpreter's globals.
// Returns 0 on success, 1 if an uncaught exception escaped.
fn runSource(src: &string, st: &mut Interp): i32 {
    let toks = lex(src)
    var prog = newProg()
    var p = PState {
        toks: toks, pos: 0, curClass: "", file: "<entry>", errored: false, eofError: false, quiet: false, strict: false
    }
    let top = parseProgram(p, prog)
    hoistBlock(prog, top, st, 0)
    execBlock(prog, top, st, 0)
    // the script only schedules callbacks; without draining, every .then handler
    // and timer queued by it would be silently dropped
    if !st.throwing {
        runEventLoop(prog, st)
    }
    if st.throwing {
        eprint("Uncaught " + describeThrown(st, st.thrownValue))
        return 1
    }
    if st.gcStats {
        collect(st)
        eprint("[gc] total runs " + i64ToStr(st.gcRuns) + ", arena slots " + i64ToStr(st.scopes.len()) + ", free " + i64ToStr(st.freeList.len()))
    }
    return 0
}
