                        setMember(st, t, key, v)
                    }
                }
                // enumerable elements come across too (assign from an array)
                var e: i64 = 0
                while e < st.objects[src].elems.len() {
                    let ev = cloneValue(st.objects[src].elems[e])
                    setMember(st, t, i64ToStr(e), ev)
                    e = e + 1
                }
            }
            s = s + 1
        }
        return target
    }
    return JSValue.Undefined
}

// The property bag a value carries, or -1. A function's own properties live in
// its statics bag, not in an object slot, so Object.assign has to look there for
// both its target and its sources — prisma's debug module is a function on both
// sides of `Object.assign(fn, otherFn)`.
// The prototype object index for object `h`, or -1 (null). milojs fakes the
// prototype chain — a plain `{}` has proto -1 and inherits Object.prototype
// methods by dispatch — so getPrototypeOf / `__proto__` / `constructor` resolve
// the right singleton by type here rather than reading a real link.
fn protoOfHandle(st: &Interp, h: i64): i64 {
    if h < 0 {
        return -1
    }
    // Object.prototype is the top of the chain; its own proto is null
    if h == st.objectProtoObj {
        return -1
    }
    // an explicit link (user `new F()`, Object.create, setPrototypeOf) wins
    if st.objects[h].proto >= 0 {
        return st.objects[h].proto
    }
    if st.objects[h].isArray && st.arrayProtoObj >= 0 {
        return st.arrayProtoObj
    }
    // functions, errors and plain objects fall back to Object.prototype
    // (Function.prototype / Error.prototype are not distinct singletons here)
    return st.objectProtoObj
}

// The `constructor` for a builtin object, when the (faked) prototype chain has
// none. Returns Undefined for anything without a well-defined builtin
// constructor here, so a real (user) constructor resolved through the chain is
// never overridden — this is only ever consulted as a fallback.
fn builtinConstructorOf(st: &Interp, o: i64): JSValue {
    if o == st.objectProtoObj {
        return JSValue.Native(NATIVE_OBJECT_CTOR)
    }
    if o == st.arrayProtoObj && st.arrayCtorObj >= 0 {
        return JSValue.Obj(st.arrayCtorObj)
    }
    if st.objects[o].isError {
        // the specific constructor named by the error's `name` (TypeError, …)
        let nm = getMember(st, o, "name")
        match nm {
            JSValue.Str(s) => {
                if scopeHasOwn(st, 0, s) {
                    return scopeLookup(st, 0, s)
                }
            }
            _ => {
            }
        }
        if scopeHasOwn(st, 0, "Error") {
            return scopeLookup(st, 0, "Error")
        }
        return JSValue.Undefined
    }
    if st.objects[o].isArray && st.arrayCtorObj >= 0 {
        return JSValue.Obj(st.arrayCtorObj)
    }
    // a genuinely plain object → Object; special builtins without a dedicated
    // constructor here (Map/Set/Date/typed-array/proxy/promise/function…) are
    // left Undefined rather than mis-reported as Object
    if !st.objects[o].isMap && !st.objects[o].isSet && !st.objects[o].isDate && !st.objects[o].isProxy && !st.objects[o].isArrayBuffer && st.objExtras[st.objects[o].extra].taBuf < 0 && !st.objects[o].isGenerator && st.objects[o].promiseState < 0 && !st.objects[o].isFunctionLike && !st.objects[o].isBound {
        return JSValue.Native(NATIVE_OBJECT_CTOR)
    }
    return JSValue.Undefined
}

fn mathNative(id: i64, args: &Vec<JSValue>, st: &mut Interp): JSValue {
    if id == NATIVE_MATH_RANDOM {
        let next = mjNextRandom(st.rngState)
        st.rngState = next
        var bits = next
        if bits < 0 {
            bits = -bits
        }
        let m = bits % 9007199254740992
        return JSValue.Number((m as f64) / 9007199254740992.0)
    }
    if id == NATIVE_MATH_MIN {
        if args.len() == 0 {
            return JSValue.Number(jsInf())
        }
        var m = toNum(args[0])
        var i: i64 = 0
        while i < args.len() {
            let v = toNum(args[i])
            if !(v == v) {
                return JSValue.Number(jsNan())
            }
            if v < m {
                m = v
            }
            i = i + 1
        }
        return JSValue.Number(m)
    }
    if id == NATIVE_MATH_MAX {
        if args.len() == 0 {
            return JSValue.Number(0.0 - jsInf())
        }
        var m = toNum(args[0])
        var i: i64 = 0
        while i < args.len() {
            let v = toNum(args[i])
            if !(v == v) {
                return JSValue.Number(jsNan())
            }
            if v > m {
                m = v
            }
            i = i + 1
        }
        return JSValue.Number(m)
    }
    var x = 0.0
    if args.len() > 0 {
        x = toNum(args[0])
    }
    if id == NATIVE_MATH_FLOOR {
        return JSValue.Number(mjFloor(x))
    }
    if id == NATIVE_MATH_CEIL {
        return JSValue.Number(mjCeil(x))
    }
    if id == NATIVE_MATH_ROUND {
        return JSValue.Number(mjRound(x))
    }
    if id == NATIVE_MATH_TRUNC {
        return JSValue.Number(mjTrunc(x))
    }
    if id == NATIVE_MATH_ABS {
        return JSValue.Number(mjAbs(x))
    }
    if id == NATIVE_MATH_SIGN {
        return JSValue.Number(mjSign(x))
    }
    if id == NATIVE_MATH_EXP {
        return JSValue.Number(Math.exp(x))
    }
    // std's mathLog* carry `requires x > 0.0`; JS defines the whole domain
    // (ECMA-262 21.3.2.20-22: log(+-0) is -Infinity, log(x < 0) is NaN). Handle the
    // non-positive cases here rather than calling out of contract — a contract
    // violation aborts under --debug, and only survives -O2 because the check is
    // compiled out and libc happens to return the right value.
    if id == NATIVE_MATH_LOG || id == NATIVE_MATH_LOG2 || id == NATIVE_MATH_LOG10 {
        if x < 0.0 {
            return JSValue.Number(jsNan())
        }
        if x == 0.0 {
            return JSValue.Number(0.0 - jsInf())
        }
        if id == NATIVE_MATH_LOG {
            return JSValue.Number(Math.log(x))
        }
        if id == NATIVE_MATH_LOG2 {
            return JSValue.Number(Math.log2(x))
        }
        return JSValue.Number(Math.log10(x))
    }
    if id == NATIVE_MATH_SIN {
        return JSValue.Number(Math.sin(x))
    }
    if id == NATIVE_MATH_COS {
        return JSValue.Number(Math.cos(x))
    }
    if id == NATIVE_MATH_TAN {
        return JSValue.Number(Math.tan(x))
    }
    if id == NATIVE_MATH_ASIN {
        return JSValue.Number(Math.atan2(x, Math.sqrt(1.0 - x * x)))
    }
    if id == NATIVE_MATH_ACOS {
        return JSValue.Number(Math.atan2(Math.sqrt(1.0 - x * x), x))
    }
    if id == NATIVE_MATH_ATAN {
        return JSValue.Number(Math.atan2(x, 1.0))
    }
    if id == NATIVE_MATH_ATAN2 {
        var y2 = 0.0
        if args.len() > 1 {
            y2 = toNum(args[1])
        }
        return JSValue.Number(Math.atan2(x, y2))
    }
    if id == NATIVE_MATH_SQRT {
        return JSValue.Number(Math.sqrt(x))
    }
    if id == NATIVE_MATH_POW {
        var y = 0.0
        if args.len() > 1 {
            y = toNum(args[1])
        }
        return JSValue.Number(Math.pow(x, y))
    }
    return JSValue.Undefined
}

// x instanceof C: for a user constructor, the object must have been made by it
// (its `ctor` slot matches); for a native Error constructor, the object must be
// an error whose kind matches (Error itself matches any error).
// Compile a pattern and wrap it as a RegExp object (regexId links to the
// compiled program; source/flags/lastIndex are ordinary properties).
// A single-character search over a flags string. Named mj* per the house rule:
// std/string owns strIndexOf.
fn strIndexOfMj(hay: &string, needle: &string): i64 {
    if needle.len() == 0 {
        return 0
    }
    var i: i64 = 0
    while i < hay.len() {
        if hay[i] == needle[0] {
            return i
        }
        i = i + 1
    }
    return -1
}

fn makeRegex(st: &mut Interp, pattern: string, flags: string): JSValue {
    let re = regexCompile(pattern.clone(), flags.clone())
    let isGlobal = re.flagG
    st.regexes.push(re)
    let id = st.regexes.len() - 1
    let o = newObject(st)
    let _er = ensureExtra(st, o)
    st.objExtras[st.objects[o].extra].regexId = id
    objSet(st, o, "source", JSValue.Str(pattern))
    objSetNonEnumerable(st, o, "source")
    objSet(st, o, "flags", JSValue.Str(flags.clone()))
    objSetNonEnumerable(st, o, "flags")
    // the whole flag family, not just `global` — a test that reads .multiline or
    // .sticky got undefined, and `undefined` is not `false`
    objSet(st, o, "global", JSValue.Bool(isGlobal))
    objSetNonEnumerable(st, o, "global")
    objSet(st, o, "ignoreCase", JSValue.Bool(strIndexOfMj(flags.clone(), "i") >= 0))
    objSetNonEnumerable(st, o, "ignoreCase")
    objSet(st, o, "multiline", JSValue.Bool(strIndexOfMj(flags.clone(), "m") >= 0))
    objSetNonEnumerable(st, o, "multiline")
    objSet(st, o, "sticky", JSValue.Bool(strIndexOfMj(flags.clone(), "y") >= 0))
    objSetNonEnumerable(st, o, "sticky")
    objSet(st, o, "unicode", JSValue.Bool(strIndexOfMj(flags.clone(), "u") >= 0))
    objSetNonEnumerable(st, o, "unicode")
    objSet(st, o, "unicodeSets", JSValue.Bool(strIndexOfMj(flags.clone(), "v") >= 0))
    objSetNonEnumerable(st, o, "unicodeSets")
    objSet(st, o, "dotAll", JSValue.Bool(strIndexOfMj(flags.clone(), "s") >= 0))
    objSetNonEnumerable(st, o, "dotAll")
    objSet(st, o, "hasIndices", JSValue.Bool(strIndexOfMj(flags.clone(), "d") >= 0))
    objSetNonEnumerable(st, o, "hasIndices")
    objSet(st, o, "lastIndex", JSValue.Number(0.0))
    objSetNonEnumerable(st, o, "lastIndex")
    objSetNonConfigurable(st, o, "lastIndex")
    if st.regexProtoObj >= 0 {
        st.objects[o].proto = st.regexProtoObj
    }
    return JSValue.Obj(o)
}

// Define `key` on `o` from a descriptor object `d`, applying get/set or value
// AND the enumerable/configurable/writable attributes (each defaulting to false
// when omitted, per Object.defineProperty). Shared by defineProperty,
// defineProperties, and Object.create's second argument — all three previously
// dropped the attributes for accessors, and the latter two for data props too.
fn applyDescriptor(st: &mut Interp, o: i64, key: &string, d: i64) {
    let g = getMember(st, d, "get")
    let sfn = getMember(st, d, "set")
    if isCallable(g) || isCallable(sfn) {
        objDefineAccessor(st, o, key.clone(), g, sfn)
    } else {
        objSet(st, o, key.clone(), getMember(st, d, "value"))
    }
    let at = objOwnIndex(st, o, key)
    if at >= 0 {
        st.objects[o].props[at].enumerable = truthy(getMember(st, d, "enumerable"))
        st.objects[o].props[at].configurable = truthy(getMember(st, d, "configurable"))
        st.objects[o].props[at].writable = truthy(getMember(st, d, "writable"))
    }
}

// Build a property-descriptor object { value, writable | get, set }+enumerable+
// configurable for own property `idx` of `h`. Shared by getOwnPropertyDescriptor
// and getOwnPropertyDescriptors.
fn buildPropDescriptor(st: &mut Interp, h: i64, idx: i64): i64 {
    let isAcc = propIsAccessor(st, h, idx)
    let pv = cloneValue(st.objects[h].props[idx].value)
    let pg = accGetter(st, st.objects[h].props[idx].acc)
    let ps = accSetter(st, st.objects[h].props[idx].acc)
    let d = newObject(st)
    pushTemp(st, JSValue.Obj(d))
    if isAcc {
        objSet(st, d, "get", pg)
        objSet(st, d, "set", ps)
    } else {
        objSet(st, d, "value", pv)
        objSet(st, d, "writable", JSValue.Bool(st.objects[h].props[idx].writable))
    }
    objSet(st, d, "enumerable", JSValue.Bool(st.objects[h].props[idx].enumerable))
    objSet(st, d, "configurable", JSValue.Bool(st.objects[h].props[idx].configurable))
    popTemp(st)
    return d
}

fn regexIdOf(st: &Interp, v: &JSValue): i64 {
    match v {
        JSValue.Obj(o) => {
            return st.objExtras[st.objects[o].extra].regexId
        }
        _ => {
            return -1
        }
    }
}

// [wholeMatch, group1, group2, ...]; a non-participating group is undefined.
// `rid` is the regex handle (-1 when none), used to attach `.groups` for named
// captures (?<name>...).
fn buildMatchArray(st: &mut Interp, s: &string, saves: &Vec<i64>, rid: i64): JSValue {
    let arr = newArray(st)
    pushTemp(st, JSValue.Obj(arr))
    var g: i64 = 0
    let ng = saves.len() / 2
    while g < ng {
        let a = saves[2 * g]
        let b = saves[2 * g + 1]
        if a < 0 || b < 0 {
            arrPush(st, arr, JSValue.Undefined)
        } else {
            arrPush(st, arr, JSValue.Str(strSlice(s, a, b)))
        }
        g = g + 1
    }
    // .index (match start) and .input, which callers like content-type read.
    // The index is in UTF-16 code units, as every JS string index is: it was the
    // BYTE offset, so any match after a non-ASCII character reported a position
    // the caller could not use to slice the same string.
    objSet(st, arr, "index", JSValue.Number(byteToUtf16(s, saves[0]) as f64))
    objSet(st, arr, "input", JSValue.Str(s.clone()))
    // .groups: an object of named-capture substrings, or undefined when the
    // pattern has no (?<name>...) groups (matching JS, where .groups is
    // undefined not {} for an un-named pattern)
    if rid >= 0 && st.regexes[rid].groupNames.len() > 0 {
        let groups = newObject(st)
        var gi: i64 = 0
        while gi < st.regexes[rid].groupNames.len() {
            let nm = st.regexes[rid].groupNames[gi].clone()
            let gnum = st.regexes[rid].groupNums[gi]
            var gv = JSValue.Undefined
            if 2 * gnum + 1 < saves.len() {
                let a = saves[2 * gnum]
                let b = saves[2 * gnum + 1]
                if a >= 0 && b >= 0 {
                    gv = JSValue.Str(strSlice(s, a, b))
                }
            }
            objSet(st, groups, nm, gv)
            gi = gi + 1
        }
        objSet(st, arr, "groups", JSValue.Obj(groups))
    } else {
        objSet(st, arr, "groups", JSValue.Undefined)
    }
    popTemp(st)
    return JSValue.Obj(arr)
}

fn regexMethod(st: &mut Interp, o: i64, name: &string, args: &Vec<JSValue>): JSValue {
    // the prototype's flag accessors, dispatched under an internal name so they
    // cannot shadow an instance's own data property of the same name
    if name.len() > 8 && strSlice(name.clone(), 0, 8) == "__reGet_" {
        return objGet(st, o, strSlice(name.clone(), 8, name.len()))
    }
    // RegExp.prototype[@@match](str) and friends: delegate to the String method
    // that actually implements the operation in this engine
    var strOp = ""
    if name == "@@sym:Symbol.match:0" {
        strOp = "match"
    } else if name == "@@sym:Symbol.matchAll:0" {
        strOp = "matchAll"
    } else if name == "@@sym:Symbol.replace:0" {
        strOp = "replace"
    } else if name == "@@sym:Symbol.search:0" {
        strOp = "search"
    } else if name == "@@sym:Symbol.split:0" {
        strOp = "split"
    }
    if strOp.len() > 0 {
        var sArgs: Vec<JSValue> = Vec.new()
        sArgs.push(JSValue.Obj(o))
        var ai: i64 = 1
        while ai < args.len() {
            sArgs.push(cloneValue(args[ai]))
            ai = ai + 1
        }
        var recvStr = JSValue.Str("")
        if args.len() > 0 {
            recvStr = JSValue.Str(toStrProg(gProg, args[0], st))
            if st.throwing {
                return JSValue.Undefined
            }
        }
        return callBuiltinByName(gProg, recvStr, strOp, sArgs, st)
    }
    let rid = st.objExtras[st.objects[o].extra].regexId
    // exec/test ToString their argument, and that conversion can run user code
    // and throw. is-regex is built entirely on that: it passes exec an object
    // whose toString throws a private marker and catches it. An engine that
    // stringifies without asking returns null here and is-regex answers
    // undefined, which is neither true nor false and breaks every caller.
    var subject = ""
    if args.len() > 0 {
        subject = toStrProg(gProg, args[0], st)
        if st.throwing {
            return JSValue.Undefined
        }
    }
    if name == "toString" {
        // listed as a regex method but never implemented — /ab/gi.toString()
        // returned undefined
        return JSValue.Str("/" + toStr(objGet(st, o, "source")) + "/" + toStr(objGet(st, o, "flags")))
    }
    if name == "compile" {
        // node's legacy in-place recompile: replaces the pattern and flags on
        // THIS object rather than returning a new one
        var np = toStr(objGet(st, o, "source"))
        var nf = ""
        if args.len() > 0 {
            np = toStr(args[0])
        }
        if args.len() > 1 {
            nf = toStr(args[1])
        }
        let fresh = makeRegex(st, np, nf)
        let fh = objHandle(fresh)
        if fh >= 0 {
            st.objExtras[st.objects[o].extra].regexId = st.objExtras[st.objects[fh].extra].regexId
            objSet(st, o, "source", objGet(st, fh, "source"))
            objSet(st, o, "flags", objGet(st, fh, "flags"))
            objSet(st, o, "global", objGet(st, fh, "global"))
            objSet(st, o, "ignoreCase", objGet(st, fh, "ignoreCase"))
            objSet(st, o, "multiline", objGet(st, fh, "multiline"))
            objSet(st, o, "sticky", objGet(st, fh, "sticky"))
            objSet(st, o, "unicode", objGet(st, fh, "unicode"))
            objSet(st, o, "unicodeSets", objGet(st, fh, "unicodeSets"))
            objSet(st, o, "dotAll", objGet(st, fh, "dotAll"))
            objSet(st, o, "hasIndices", objGet(st, fh, "hasIndices"))
            objSet(st, o, "lastIndex", JSValue.Number(0.0))
        }
        return JSValue.Obj(o)
    }
    if name == "test" {
        let saves = regexExec(st.regexes[rid], subject, 0)
        return JSValue.Bool(saves.len() > 0)
    }
    if name == "exec" {
        // a global (or sticky) regex resumes from lastIndex and advances it, so
        // `while ((m = re.exec(s)))` terminates instead of re-matching forever
        let isG = st.regexes[rid].flagG
        var start: i64 = 0
        if isG {
            // lastIndex is a STRING index the caller can read and write, so it
            // is in UTF-16 units; internally the matcher works in bytes. It was
            // stored raw, so after a non-ASCII match the value handed back was a
            // byte offset the caller could not use, and feeding it back in
            // resumed mid-character.
            let lastU16 = toNum(objGet(st, o, "lastIndex")) as i64
            if lastU16 < 0 || lastU16 > utf16Length(subject) {
                objSet(st, o, "lastIndex", JSValue.Number(0.0))
                return JSValue.Null
            }
            start = utf16ToByte(subject, lastU16)
        }
        let saves = regexExec(st.regexes[rid], subject, start)
        if saves.len() == 0 {
            if isG {
                objSet(st, o, "lastIndex", JSValue.Number(0.0))
            }
            return JSValue.Null
        }
        if isG {
            var next = saves[1]
            // a zero-width match must still advance, or the loop stalls; by a
            // whole character, or it resumes inside one
            if next <= start {
                next = start + utf8LenAt(subject, start)
            }
            objSet(st, o, "lastIndex", JSValue.Number(byteToUtf16(subject, next) as f64))
        }
        return buildMatchArray(st, subject, saves, rid)
    }
    return JSValue.Undefined
}

// Expand $1..$9, $&, $$, and $<name> in a replacement string against a match's
// saves. `re` supplies the named-capture map for $<name> (pass a regex with no
// named groups to disable it).
fn expandRepl(repl: &string, s: &string, saves: &Vec<i64>, re: &Regex): string {
    var out = String.withCapacity(repl.len())
    var i: i64 = 0
    while i < repl.len() {
        let c = repl[i]
        if c == '$' && i + 1 < repl.len() {
            let n = repl[i + 1]
            if n == '$' {
                out.push('$')
                i = i + 2
            } else if n == '&' {
                out = out + strSlice(s, saves[0], saves[1])
                i = i + 2
            } else if n == '<' {
                // $<name>: substitute the named capture, empty when absent
                var j = i + 2
                var nm = String.withCapacity(8)
                while j < repl.len() && repl[j] != '>' {
                    nm.push(repl[j])
                    j = j + 1
                }
                var gnum: i64 = -1
                var k: i64 = 0
                while k < re.groupNames.len() {
                    if re.groupNames[k] == nm {
                        gnum = re.groupNums[k]
                    }
                    k = k + 1
                }
                if gnum >= 0 && 2 * gnum + 1 < saves.len() {
                    let a = saves[2 * gnum]
                    let b = saves[2 * gnum + 1]
                    if a >= 0 && b >= 0 {
                        out = out + strSlice(s, a, b)
                    }
                }
                if j < repl.len() {
                    j = j + 1
                }
                i = j
            } else if n >= '1' && n <= '9' {
                let g = n as i64 - 48
                if 2 * g + 1 < saves.len() {
                    let a = saves[2 * g]
                    let b = saves[2 * g + 1]
                    if a >= 0 && b >= 0 {
                        out = out + strSlice(s, a, b)
                    }
                }
                i = i + 2
            } else {
                out.push(c)
                i = i + 1
            }
        } else {
            out.push(c)
            i = i + 1
        }
    }
    return out
}

fn regexReplace(st: &mut Interp, s: &string, rid: i64, repl: &string): JSValue {
    let global = st.regexes[rid].flagG
    var out = String.withCapacity(s.len())
    var last: i64 = 0
    var searchPos: i64 = 0
    var going = true
    while going {
        let saves = regexExec(st.regexes[rid], s, searchPos)
        if saves.len() == 0 {
            going = false
        } else {
            let mstart = saves[0]
            let mend = saves[1]
            out = out + strSlice(s, last, mstart)
            out = out + expandRepl(repl, s, saves, st.regexes[rid])
            last = mend
            // advance a whole CHARACTER past a zero-width match: stepping one
            // byte lands inside a multibyte character, which both invents extra
            // matches and (for replace) splices output around half of one,
            // producing invalid UTF-8
            if mend == mstart {
                searchPos = mend + utf8LenAt(s, mend)
            } else {
                searchPos = mend
            }
            if !global || searchPos > s.len() {
                going = false
            }
        }
    }
    out = out + strSlice(s, last, s.len())
    return JSValue.Str(out)
}

// s.replace(re, fn): the callback receives (match, ...groups, offset, string) and
// its return value is substituted. Without this the function was coerced with
// toStr and the literal text "function" ended up in the output.
fn regexReplaceFn(prog: &Prog, st: &mut Interp, s: &string, rid: i64, fn_: &JSValue): JSValue {
    let global = st.regexes[rid].flagG
    var out = String.withCapacity(s.len())
    var last: i64 = 0
    var searchPos: i64 = 0
    var going = true
    while going && !st.throwing {
        let saves = regexExec(st.regexes[rid], s, searchPos)
        if saves.len() == 0 {
            going = false
        } else {
            let mstart = saves[0]
            let mend = saves[1]
            out = out + strSlice(s, last, mstart)
            var args: Vec<JSValue> = Vec.new()
            args.push(JSValue.Str(strSlice(s, mstart, mend)))
            var g: i64 = 1
            let ng = saves.len() / 2
            while g < ng {
                let a = saves[2 * g]
                let b = saves[2 * g + 1]
                if a < 0 || b < 0 {
                    args.push(JSValue.Undefined)
                } else {
                    args.push(JSValue.Str(strSlice(s, a, b)))
                }
                g = g + 1
            }
            // the offset a replace callback receives is a string index, so
            // UTF-16 units rather than bytes
            args.push(JSValue.Number(byteToUtf16(s, mstart) as f64))
            args.push(JSValue.Str(s.clone()))
            let r = callValue(prog, fn_, args, JSValue.Undefined, st)
            out = out + toStr(r)
            last = mend
            // advance a whole CHARACTER past a zero-width match: stepping one
            // byte lands inside a multibyte character, which both invents extra
            // matches and (for replace) splices output around half of one,
            // producing invalid UTF-8
            if mend == mstart {
                searchPos = mend + utf8LenAt(s, mend)
            } else {
                searchPos = mend
            }
            if !global || searchPos > s.len() {
                going = false
            }
        }
    }
    out = out + strSlice(s, last, s.len())
    return JSValue.Str(out)
}

// s.split(re) — the separator is whatever the pattern matches. A zero-width
// match advances by one so the split cannot loop forever.
// s.split(re). Two things were missing, both common idioms:
//
//   "fooBarBaz".split(/(?=[A-Z])/)  ->  ["fooBarBaz"], node gives ["foo","Bar","Baz"]
//   "a1b".split(/(\d)/)             ->  ["a","b"],     node gives ["a","1","b"]
//
// A ZERO-WIDTH match never split at all (the old loop just advanced past it),
// and capture groups in the separator were dropped instead of becoming elements.
// This follows the spec's shape: `p` is the start of the pending piece and `q`
// the search cursor, and an empty match only advances `q` when it lands exactly
// at `p`.
fn regexSplit(st: &mut Interp, s: &string, rid: i64): JSValue {
    let arr = newArray(st)
    pushTemp(st, JSValue.Obj(arr))
    let size = s.len()
    if size == 0 {
        // "".split(re) is [""] unless the separator matches the empty string
        let saves0 = regexExec(st.regexes[rid], s, 0)
        if saves0.len() == 0 {
            arrPush(st, arr, JSValue.Str(""))
        }
        popTemp(st)
        return JSValue.Obj(arr)
    }
    var p: i64 = 0
    var q: i64 = 0
    while q < size {
        let saves = regexExec(st.regexes[rid], s, q)
        // The spec matches AT q; regexExec SEARCHES from q, so it can report a
        // match starting at the end of the string, which the `q < size` loop is
        // supposed to exclude. Without this, a trailing zero-width match adds a
        // spurious "" element: "a1b2".split(/(?<=\d)/) came out with three.
        if saves.len() == 0 || saves[0] >= size {
            q = size
        } else {
            let mstart = saves[0]
            let mend = saves[1]
            if mend == p {
                // an empty match sitting at the piece start would split forever;
                // step one CHARACTER, not one byte, or the next attempt starts on
                // a UTF-8 continuation byte
                q = mstart + utf8LenAt(s, mstart)
            } else {
                arrPush(st, arr, JSValue.Str(strSlice(s, p, mstart)))
                // every capture in the separator becomes an element, undefined
                // for one that did not participate
                var gi: i64 = 2
                while gi + 1 < saves.len() {
                    if saves[gi] >= 0 && saves[gi + 1] >= 0 {
                        arrPush(st, arr, JSValue.Str(strSlice(s, saves[gi], saves[gi + 1])))
                    } else {
                        arrPush(st, arr, JSValue.Undefined)
                    }
                    gi = gi + 2
                }
                p = mend
                if mend == mstart {
                    q = mend + utf8LenAt(s, mend)
                } else {
                    q = mend
                }
            }
        }
    }
    arrPush(st, arr, JSValue.Str(strSlice(s, p, size)))
    popTemp(st)
    return JSValue.Obj(arr)
}

// Byte length of the UTF-8 sequence at `at`; 1 for ASCII, a continuation byte or
// a truncated tail, so a caller stepping through always makes progress.
fn utf8LenAt(s: &string, at: i64): i64 {
    if at >= s.len() {
        return 1
    }
    let b = s[at] as i64
    var n: i64 = 1
    if b >= 240 {
        n = 4
    } else if b >= 224 {
        n = 3
    } else if b >= 192 {
        n = 2
    }
    if at + n > s.len() {
        return 1
    }
    return n
}

// s.match(re): with the g flag, an array of all matched substrings (or null);
// otherwise the first match array (whole + groups) or null.
// Encode a single Unicode code point to UTF-8 (milojs's string encoding).
fn codePointToUtf8(cp: i64): string {
    var out = String.withCapacity(4)
    if cp < 128 {
        out.push(cp as u8)
    } else if cp < 2048 {
        out.push((192 | (cp >> 6)) as u8)
        out.push((128 | (cp & 63)) as u8)
    } else if cp < 65536 {
        out.push((224 | (cp >> 12)) as u8)
        out.push((128 | ((cp >> 6) & 63)) as u8)
        out.push((128 | (cp & 63)) as u8)
    } else {
        out.push((240 | (cp >> 18)) as u8)
        out.push((128 | ((cp >> 12) & 63)) as u8)
        out.push((128 | ((cp >> 6) & 63)) as u8)
        out.push((128 | (cp & 63)) as u8)
    }
    return out
}

fn regexStrMatch(st: &mut Interp, s: &string, rid: i64): JSValue {
    let global = st.regexes[rid].flagG
    if !global {
        let saves = regexExec(st.regexes[rid], s, 0)
        if saves.len() == 0 {
            return JSValue.Null
        }
        return buildMatchArray(st, s, saves, rid)
    }
    let arr = newArray(st)
    pushTemp(st, JSValue.Obj(arr))
    var pos: i64 = 0
    var any = false
    var going = true
    while going {
        // NOT named `saves`: a second local of that name already exists in this
        // function (the non-global path above), and milo's bounds checks used to
        // cache the hoisted length per source NAME, so the checks here compared
        // against the other, empty `saves` and trapped 0/0 on every match. Fixed
        // in milo 45c7b0a1; the distinct name stays so an older compiler still
        // builds this correctly.
        let gsaves = regexExec(st.regexes[rid], s, pos)
        if gsaves.len() == 0 {
            going = false
        } else {
            any = true
            arrPush(st, arr, JSValue.Str(strSlice(s, gsaves[0], gsaves[1])))
            if gsaves[1] == gsaves[0] {
                // same character-advance rule as replace, split and matchAll
                pos = gsaves[1] + utf8LenAt(s, gsaves[1])
            } else {
                pos = gsaves[1]
            }
            if pos > s.len() {
                going = false
            }
        }
    }
    popTemp(st)
    if !any {
        return JSValue.Null
    }
    return JSValue.Obj(arr)
}

// str.matchAll(re): every match as a full exec-style array (match text, capture
// groups, .index, .input) — unlike match/g which yields only the match strings.
// Returned as an array, which is iterable for the usual `[...]` / for-of
// consumption. Iterates regardless of the /g flag (lenient vs the spec's throw).
fn regexStrMatchAll(st: &mut Interp, s: &string, rid: i64): JSValue {
    let arr = newArray(st)
    pushTemp(st, JSValue.Obj(arr))
    var pos: i64 = 0
    var going = true
    while going {
        let saves = regexExec(st.regexes[rid], s, pos)
        if saves.len() == 0 {
            going = false
        } else {
            let m = buildMatchArray(st, s, saves, rid)
            arrPush(st, arr, m)
            if saves[1] == saves[0] {
                // same character-advance rule as replace and split
                pos = saves[1] + utf8LenAt(s, saves[1])
            } else {
                pos = saves[1]
            }
            if pos > s.len() {
                going = false
            }
        }
    }
    popTemp(st)
    // matchAll answers an ITERATOR, not an array. Returning the array made the
    // common `[...s.matchAll(re)]` work and everything else fail: `.next` did
    // not exist, and spreading the same value twice yielded the matches twice
    // where an iterator is exhausted after one pass. Reusing the array iterator
    // gives the protocol (next, @@iterator, one-shot) for free.
    return makeArrayIterator(st, arr, 0)
}

// Execute a pre-loaded module in a fresh CommonJS scope and cache its exports.
// A module already loading (a require cycle) returns its partial exports, which
// is what Node does.
pub fn runModule(prog: &Prog, idx: i64, st: &mut Interp): JSValue {
    if st.modState[idx] == 2 {
        return cloneValue(st.modExports[idx])
    }
    if st.modState[idx] == 1 {
        return cloneValue(st.modExports[idx])
    }
    st.modState[idx] = 1
    let path = st.modPaths[idx].clone()
    let dir = dirOf(path)

    let modScope = newScope(st, 0)
    pushActive(st, modScope)
    let moduleObj = newObject(st)
    let exportsObj = newObject(st)
    objSet(st, moduleObj, "exports", JSValue.Obj(exportsObj))
    scopeDefine(st, modScope, "module", JSValue.Obj(moduleObj))
    scopeDefine(st, modScope, "exports", JSValue.Obj(exportsObj))
    // node guarantees these are ABSOLUTE, and packages build paths from them:
    // `bindings` joins its candidate addon paths onto the module root it derives
    // from __filename, so a relative one made every candidate resolve against
    // the wrong directory and no addon could ever be found.
    scopeDefine(st, modScope, "__filename", JSValue.Str(absolutePathOf(path.clone())))
    scopeDefine(st, modScope, "__dirname", JSValue.Str(absolutePathOf(dir.clone())))
    // `require` as a value, bound to THIS module's directory
    scopeDefine(st, modScope, "require", makeBoundMethod(st, JSValue.Str(dir.clone()), "__require"))
    // publish partial exports up front so a cycle sees something
    st.modExports[idx] = JSValue.Obj(exportsObj)

    st.modDirStack.push(dir)
    st.modPathStack.push(st.modPaths[idx].clone())
    let blk = st.modBlocks[idx]
    // a module body is function-like: its vars and function declarations hoist
    // to the module scope
    hoistBlock(prog, blk, st, modScope)
    execBlock(prog, blk, st, modScope)
    let _ = st.modDirStack.pop()
    let _p = st.modPathStack.pop()
    popActive(st)

    // module.exports may have been reassigned wholesale
    let finalExports = getMember(st, moduleObj, "exports")
    st.modExports[idx] = cloneValue(finalExports)
    st.modState[idx] = 2
    return finalExports
}

// require(spec) — resolved against the directory of the module the call SITE
// belongs to, which is not always the module currently running.
//
// `st.modDirStack` is dynamic: it is popped when a module body finishes. A lazy
// require inside a closure runs long after that, so it saw whoever triggered it.
// body-parser's `Object.defineProperty(exports, 'json', {get: … require('./lib/types/json')})`
// is exactly this shape, and express reaching for `bodyParser.json` resolved it
// as `node_modules/express/lib/lib/types/json` — express 4 could not load at all.
// The lexical `__dirname` binding is per module scope, so looking it up through
// the closure's own env chain names the right module.
// Make a path absolute against the process working directory. Module paths are
// stored relative internally; what escapes to JS must not be.
fn absolutePathOf(p: string): string {
    if p.len() > 0 && p[0] == '/' {
        return p
    }
    // a builtin module is not a filesystem path and must not acquire one
    if p.len() >= 8 && strSlice(p, 0, 8) == "builtin:" {
        return p
    }
    let base = match currentDir() {
        Result.Ok(d) => d
        Result.Err(_e) => {
            return p
        }
    }
    if p.len() == 0 {
        return base
    }
    if p == "." {
        return base
    }
    return base + "/" + p
}

fn requireModule(prog: &Prog, spec: &string, st: &mut Interp, scope: i64): JSValue {
    var dir = ""
    if scope >= 0 && scopeHas(st, scope, "__dirname") {
        dir = toStr(scopeLookup(st, scope, "__dirname"))
    }
    if dir.len() == 0 && st.modDirStack.len() > 0 {
        dir = st.modDirStack[st.modDirStack.len() - 1].clone()
    }
    return requireModuleFrom(prog, spec, st, dir)
}

// `require` reached as a VALUE rather than a call. It was only ever handled at
// the call site by name, so `typeof require` was "undefined" and passing it
// around threw: `bindings` does
//     const requireFunc = typeof __non_webpack_require__ === 'function' ? __non_webpack_require__ : require;
// and every addon loader is built on that. Each module scope now binds its own

fn requireModuleFrom(prog: &Prog, spec: &string, st: &mut Interp, dirIn: string): JSValue {
    let dir = relativizeToCwd(dirIn)
    // A .node file is a shared library, not JS: it never goes through the module
    // pre-loader, so it is dlopened here. prisma reaches its query engine this
    // way (require(<abs>/libquery_engine.node)).
    if hasNodeAddonExt(spec) {
        var addonPath = spec.clone()
        if spec[0] != '/' && dir.len() > 0 {
            addonPath = dir + "/" + spec
        }
        let cached = findNapiAddon(st, addonPath)
        match cached {
            Option.Some(v) => {
                return v
            }
            Option.None => {
            }
        }
        match napiLoadAddon(addonPath) {
            Result.Ok(v) => {
                st.napiAddonPaths.push(addonPath)
                st.napiAddonExports.push(cloneValue(v))
                return v
            }
            Result.Err(e) => {
                st.throwing = true
                st.thrownValue = makeError(st, "Error", e)
                return JSValue.Undefined
            }
        }
    }
    let path = resolveSpec(dir, spec)
    if path.len() == 0 {
        // relative and node_modules specifiers resolve; what lands here is a node
        // builtin (path/fs/http/...) which still needs a shim module
        // node throws MODULE_NOT_FOUND; packages rely on that to probe for
        // optional dependencies with try/catch. Returning undefined instead made
        // the failure surface later as a confusing "undefined is not a function".
        reportUnresolved(st, spec)
        st.throwing = true
        st.thrownValue = makeError(st, "Error", "Cannot find module '" + spec + "'")
        return JSValue.Undefined
    }
    let idx = findModule(st, path)
    if idx < 0 {
        eprint("milojs: module was not pre-loaded: '" + path + "'")
        return JSValue.Undefined
    }
    return runModule(prog, idx, st)
}

fn instanceOf(st: &Interp, val: &JSValue, ctor: &JSValue): bool {
    // `f instanceof Function` for a plain function value: functions are not Objs
    // here, so the object walk below never saw them and answered false.
    match ctor {
        JSValue.Native(cid) => {
            if cid == NATIVE_FUNCTION_CTOR {
                return isCallableIn(st, val)
            }
        }
        _ => {
        }
    }
    match val {
        JSValue.Obj(o) => {
            match ctor {
                JSValue.Func(fIdx, _e) => {
                    if st.objects[o].ctor == fIdx {
                        return true
                    }
                    // a subclass instance is also an instance of every base, so
                    // walk the prototype chain: Dog.prototype's proto is
                    // Animal.prototype (linked by instantiateClass)
                    if fIdx < st.funcProtos.len() {
                        let target = st.funcProtos[fIdx]
                        if target >= 0 {
                            var p = st.objects[o].proto
                            while p >= 0 {
                                if p == target {
                                    return true
                                }
                                p = st.objects[p].proto
                            }
                        }
                    }
                    return false
                }
                JSValue.Native(id) => {
                    // every object inherits from Object.prototype
                    if id == NATIVE_OBJECT_CTOR {
                        return true
                    }
                    // the built-in exotic constructors are recognised by the
                    // object's internal kind (Date/Map/Set/RegExp/ArrayBuffer are
                    // Native values, so `x instanceof Date` reaches here)
                    if id == NATIVE_DATE {
                        return st.objects[o].isDate
                    }
                    // a wrapper is an instance of the constructor that boxed it
                    if id == NATIVE_STRING || id == NATIVE_NUMBER || id == NATIVE_BOOLEAN {
                        match st.objExtras[st.objects[o].extra].boxed {
                            JSValue.Str(_ws) => {
                                return id == NATIVE_STRING
                            }
                            JSValue.Number(_wn) => {
                                return id == NATIVE_NUMBER
                            }
                            JSValue.Bool(_wb) => {
                                return id == NATIVE_BOOLEAN
                            }
                            _ => {
                                return false
                            }
                        }
                    }
                    if id == NATIVE_MAP {
                        return st.objects[o].isMap
                    }
                    if id == NATIVE_SET {
                        return st.objects[o].isSet
                    }
                    if id == NATIVE_REGEXP {
                        return st.objExtras[st.objects[o].extra].regexId >= 0
                    }
                    if id == NATIVE_ARRAYBUFFER {
                        return st.objects[o].isArrayBuffer
                    }
                    // a typed-array view instanceof its exact kind (Uint8Array,
                    // Float64Array, …): a view has taBuf >= 0 and its taKind is
                    // the ctor's offset from the base id
                    if id >= NATIVE_TA_BASE && id <= NATIVE_TA_BASE + TA_U8C {
                        return st.objExtras[st.objects[o].extra].taBuf >= 0 && !st.objects[o].isDataView && st.objExtras[st.objects[o].extra].taKind == (id - NATIVE_TA_BASE)
                    }
                    if !st.objects[o].isError {
                        return false
                    }
                    if id == NATIVE_ERROR {
                        return true
                    }
                    let nm = objGet(st, o, "name")
                    return toStr(nm) == nativeErrorName(id)
                }
                JSValue.Obj(c) => {
                    // Array is an object constructor (JSValue.Obj), not a Native,
                    // so `[] instanceof Array` reaches here — match by the array flag
                    if c == st.arrayCtorObj {
                        return st.objects[o].isArray
                    }
                    // Promise's constructor is an Obj too; a promise is recognised
                    // by its settlement-state slot
                    if st.promiseCtorObj >= 0 && c == st.promiseCtorObj {
                        return st.objects[o].promiseState >= 0
                    }
                    // a constructor object with a .prototype linked into the
                    // object's chain (user functions assigned as constructors)
                    var p = st.objects[o].proto
                    while p >= 0 {
                        if p == c {
                            return true
                        }
                        p = st.objects[p].proto
                    }
                    return false
                }
                _ => {
                    return false
                }
            }
        }
        _ => {
            return false
        }
    }
}

// Give the Error family real prototype objects. They are natives, so before
// this `TypeError.prototype` was undefined and `TypeError.prototype.constructor`
// threw — a common branch in library code, and the single largest failure
// bucket in the test262 sweep.
//
// The objects live in each native's property bag (getNativeProps), which the
// collector already walks, so they need no new GC root. Subtype prototypes chain
// to Error.prototype the way the spec says, which is what makes
// `Object.getPrototypeOf(TypeError.prototype) === Error.prototype` hold.
// Every typed-array method name, as a list. isTypedArrayMethodName is the
// predicate over the same set; both have to move together.
fn typedArrayMethodNames(): Vec<string> {
    var v: Vec<string> = Vec.new()
    v.push("fill")
    v.push("set")
    v.push("subarray")
    v.push("slice")
    v.push("at")
    v.push("indexOf")
    v.push("includes")
    v.push("join")
    v.push("toString")
    v.push("forEach")
    v.push("map")
    v.push("filter")
    v.push("reduce")
    v.push("reduceRight")
    v.push("find")
    v.push("findIndex")
    v.push("findLast")
    v.push("findLastIndex")
    v.push("some")
    v.push("every")
    v.push("reverse")
    v.push("sort")
    v.push("with")
    v.push("copyWithin")
    v.push("lastIndexOf")
    v.push("keys")
    v.push("values")
    v.push("entries")
    v.push("toReversed")
    v.push("toSorted")
    v.push("toLocaleString")
    // %TypedArray%.prototype[Symbol.iterator] is the same function as .values
    v.push(symIteratorKey())
    return v
}

// %TypedArray%, the intrinsic that every concrete typed-array constructor
// inherits from, plus a real `prototype` object for each of them.
//
// Typed arrays were pure name dispatch here: `Int8Array.prototype` was
// undefined and the methods existed only as a whitelist checked on the property
// path. test262's testTypedArray.js harness opens with
// `var TypedArray = Object.getPrototypeOf(Int8Array)` and then reads
// TypedArray.prototype for nearly every assertion, so the whole
// built-ins/TypedArray tree — 1446 cases — died on "cannot read property of
// undefined" before running a line of its own.
//
// The methods go on as UNBOUND bound-methods, exactly as Array.prototype does:
// the call site's receiver wins, which is what makes the generic
// `TypedArray.prototype.map.call(ta, fn)` idiom resolve.
fn setupTypedArrayProtos(st: &mut Interp) {
    let taProto = newObject(st)
    st.objects[taProto].proto = st.objectProtoObj
    let names = typedArrayMethodNames()
    var i: i64 = 0
    while i < names.len() {
        objSet(st, taProto, names[i].clone(), makeBrandedMethod(st, names[i].clone(), 1))
        objSetNonEnumerable(st, taProto, names[i])
        i = i + 1
    }
    let taCtor = newObject(st)
    st.objects[taCtor].isFunctionLike = true
    objSet(st, taCtor, "prototype", JSValue.Obj(taProto))
    objSetNonEnumerable(st, taCtor, "prototype")
    objSet(st, taCtor, "name", JSValue.Str("TypedArray"))
    objSetNonEnumerable(st, taCtor, "name")
    objSet(st, taProto, "constructor", JSValue.Obj(taCtor))
    objSetNonEnumerable(st, taProto, "constructor")

    var tk: i64 = 0
    while tk <= TA_U8C {
        let sub = newObject(st)
        st.objects[sub].proto = taProto
        objSet(st, sub, "constructor", JSValue.Native(NATIVE_TA_BASE + tk))
        objSetNonEnumerable(st, sub, "constructor")
        objSet(st, sub, "BYTES_PER_ELEMENT", JSValue.Number(taWidth(tk) as f64))
        objSetNonEnumerable(st, sub, "BYTES_PER_ELEMENT")
        let bag = getNativeProps(st, NATIVE_TA_BASE + tk)
        objDefineProtoAttr(st, bag, "prototype", JSValue.Obj(sub))
        objSet(st, bag, "BYTES_PER_ELEMENT", JSValue.Number(taWidth(tk) as f64))
        objSetNonEnumerable(st, bag, "BYTES_PER_ELEMENT")
        objSet(st, bag, "name", JSValue.Str(taName(tk)))
        objSetNonEnumerable(st, bag, "name")
        // this is what makes Object.getPrototypeOf(Int8Array) === %TypedArray%:
        // getPrototypeOf reads the proto of the native's property bag
        st.objects[bag].proto = taCtor
        tk = tk + 1
    }
}

// The prototype a freshly created view of this kind links to, or -1 before
// setupTypedArrayProtos has run.
fn typedArrayProtoFor(st: &mut Interp, kind: i64): i64 {
    let bag = getNativeProps(st, NATIVE_TA_BASE + kind)
    return objHandle(objGet(st, bag, "prototype"))
}

// ArrayBuffer.prototype and DataView.prototype, for the same reason as
// %TypedArray% above: both were undefined, and testTypedArray.js opens its
// resizable-buffer section with `if (ArrayBuffer.prototype.resize)` — reading a
// property of undefined, which threw before any test in the tree ran.
fn setupBufferProtos(st: &mut Interp) {
    let abProto = newObject(st)
    st.objects[abProto].proto = st.objectProtoObj
    var abNames: Vec<string> = Vec.new()
    abNames.push("slice")
    abNames.push("resize")
    abNames.push("transfer")
    var i: i64 = 0
    while i < abNames.len() {
        objSet(st, abProto, abNames[i].clone(), makeBrandedMethod(st, abNames[i].clone(), 2))
        objSetNonEnumerable(st, abProto, abNames[i])
        i = i + 1
    }
    objSet(st, abProto, "constructor", JSValue.Native(NATIVE_ARRAYBUFFER))
    objSetNonEnumerable(st, abProto, "constructor")
    let abBag = getNativeProps(st, NATIVE_ARRAYBUFFER)
    objSet(st, abBag, "isView", JSValue.Native(NATIVE_ARRAYBUFFER_ISVIEW))
    objSetNonEnumerable(st, abBag, "isView")
    objDefineProtoAttr(st, abBag, "prototype", JSValue.Obj(abProto))

    let dvProto = newObject(st)
    st.objects[dvProto].proto = st.objectProtoObj
    var dvNames: Vec<string> = Vec.new()
    dvNames.push("getInt8")
    dvNames.push("getUint8")
    dvNames.push("getInt16")
    dvNames.push("getUint16")
    dvNames.push("getInt32")
    dvNames.push("getUint32")
    dvNames.push("getFloat32")
    dvNames.push("getFloat64")
    dvNames.push("setInt8")
    dvNames.push("setUint8")
    dvNames.push("setInt16")
    dvNames.push("setUint16")
    dvNames.push("setInt32")
    dvNames.push("setUint32")
    dvNames.push("setFloat32")
    dvNames.push("setFloat64")
    var d: i64 = 0
    while d < dvNames.len() {
        objSet(st, dvProto, dvNames[d].clone(), makeBrandedMethod(st, dvNames[d].clone(), 3))
        objSetNonEnumerable(st, dvProto, dvNames[d])
        d = d + 1
    }
    objSet(st, dvProto, "constructor", JSValue.Native(NATIVE_DATAVIEW))
    objSetNonEnumerable(st, dvProto, "constructor")
    let dvBag = getNativeProps(st, NATIVE_DATAVIEW)
    objDefineProtoAttr(st, dvBag, "prototype", JSValue.Obj(dvProto))
}

fn arrayBufferProto(st: &mut Interp): i64 {
    return objHandle(objGet(st, getNativeProps(st, NATIVE_ARRAYBUFFER), "prototype"))
}

fn dataViewProto(st: &mut Interp): i64 {
    return objHandle(objGet(st, getNativeProps(st, NATIVE_DATAVIEW), "prototype"))
}

// RegExp.prototype. Like the buffer family and Date before it, this object did
// not exist: `RegExp.prototype` read as undefined, so every test262 case that
// starts from the prototype — and there are many, since the flag accessors and
// the @@match/@@replace/@@split family all live there — failed before testing
// anything. Instances now link it, which is also what makes
// `Object.getPrototypeOf(/x/) === RegExp.prototype` hold.
//
// The flag properties stay OWN properties of each instance (that is where this
// engine resolves them); the prototype carries the methods.
// The regex-taking String operations. These used to live only on evalExpr's
// method-call path, so `s.match(/re/)` worked while
// `String.prototype.match.call(s, /re/)` returned undefined and
// `String.prototype.split.call(s, /,/)` returned the string unsplit —
// callBuiltinByName goes straight to stringMethod, which knows nothing about
// regexes. Both paths call this now.
fn isStringRegexOp(st: &Interp, name: &string, args: &Vec<JSValue>): bool {
    if args.len() == 0 {
        return false
    }
    if regexIdOf(st, args[0]) < 0 {
        return false
    }
    return name == "replace" || name == "replaceAll" || name == "match" || name == "matchAll" || name == "split" || name == "search"
}

// match/matchAll/search have NO non-regex form: the spec builds a RegExp from
// whatever it is handed. `"a1b".match("\\d")` is ["1"], not undefined, and
// passing a plain string is the common way to write it. replace/split do have
// literal-string forms, so they are deliberately absent here.
fn stringOpNeedsRegexArg(st: &Interp, name: &string, args: &Vec<JSValue>): bool {
    if !(name == "match" || name == "matchAll" || name == "search") {
        return false
    }
    if args.len() == 0 {
        return true
    }
    return regexIdOf(st, args[0]) < 0
}

// The argument re-made as a RegExp, with matchAll keeping the /g the spec
// requires of it.
fn regexArgFor(st: &mut Interp, name: &string, args: &Vec<JSValue>): Vec<JSValue> {
    var pat = ""
    if args.len() > 0 {
        match args[0] {
            JSValue.Undefined => {
            }
            _ => {
                pat = toStr(args[0])
            }
        }
    }
    var flags = ""
    if name == "matchAll" {
        flags = "g"
    }
    var out: Vec<JSValue> = Vec.new()
    out.push(makeRegex(st, pat, flags))
    var i: i64 = 1
    while i < args.len() {
        out.push(cloneValue(args[i]))
        i = i + 1
    }
    return out
}

fn stringRegexOp(prog: &Prog, s: &string, name: &string, args: &Vec<JSValue>, st: &mut Interp): JSValue {
    let rid = regexIdOf(st, args[0])
    if name == "replace" || name == "replaceAll" {
        if args.len() > 1 && isCallable(args[1]) {
            return regexReplaceFn(prog, st, s, rid, cloneValue(args[1]))
        }
        var repl = ""
        if args.len() > 1 {
            repl = toStr(args[1])
        }
        return regexReplace(st, s, rid, repl)
    }
    if name == "match" {
        return regexStrMatch(st, s, rid)
    }
    if name == "matchAll" {
        // the spec rejects a non-global regex here, because the result would be
        // an infinite sequence of the same match
        if !st.regexes[rid].flagG {
            st.throwing = true
            st.thrownValue = makeError(st, "TypeError", "String.prototype.matchAll called with a non-global RegExp argument")
            return JSValue.Undefined
        }
        return regexStrMatchAll(st, s, rid)
    }
    if name == "split" {
        return regexSplit(st, s, rid)
    }
    // search: index of the first match, or -1 (UTF-16 units)
    let saves = regexExec(st.regexes[rid], s, 0)
    if saves.len() == 0 {
        return JSValue.Number(0.0 - 1.0)
    }
    return JSValue.Number(byteToUtf16(s, saves[0]) as f64)
}

// Build a prototype object for a native constructor: the named methods as
// bound-method values (the call site's receiver wins), a `constructor` back
// link, and the object hung off the native's property bag as `prototype`.
// Returns the prototype handle.
//
// Number, Boolean, Symbol, BigInt, Map, Set and Promise had NO prototype object
// at all — `Number.prototype` read as undefined — which is the same gap the
// buffer family, Date and RegExp each turned out to have. Anything that starts
// from the prototype (every test262 property-descriptor case, and the common
// `Map.prototype.get.call(m, k)` idiom) failed before doing anything.
fn buildNativeProto(st: &mut Interp, nativeId: i64, names: &Vec<string>): i64 {
    let proto = newObject(st)
    st.objects[proto].proto = st.objectProtoObj
    // the receiver is Undefined for a prototype method, so the brand cannot be
    // read off it; the constructor id names it instead
    var host = ""
    if nativeId == NATIVE_MAP {
        host = "Map"
    }
    var i: i64 = 0
    while i < names.len() {
        objSet(st, proto, names[i].clone(), makeBoundMethodOn(st, JSValue.Undefined, names[i].clone(), host.clone()))
        objSetNonEnumerable(st, proto, names[i])
        i = i + 1
    }
    objSet(st, proto, "constructor", JSValue.Native(nativeId))
    objSetNonEnumerable(st, proto, "constructor")
    let bag = getNativeProps(st, nativeId)
    objDefineProtoAttr(st, bag, "prototype", JSValue.Obj(proto))
    return proto
}

fn setupRemainingProtos(st: &mut Interp) {
    var bigNames: Vec<string> = Vec.new()
    bigNames.push("toString")
    bigNames.push("valueOf")
    bigNames.push("toLocaleString")
    let gp = buildNativeProto(st, NATIVE_BIGINT, bigNames)
    var vt: Vec<string> = Vec.new()
    vt.push("valueOf")
    vt.push("toString")
    brandProtoMethods(st, gp, BRAND_BIGINT, vt)

    // Number / Boolean / BigInt / Symbol: primitives, so nothing links these as
    // an instance proto — they exist so the prototype itself is reachable.
    var numNames: Vec<string> = Vec.new()
    numNames.push("toString")
    numNames.push("valueOf")
    numNames.push("toFixed")
    numNames.push("toPrecision")
    numNames.push("toExponential")
    numNames.push("toLocaleString")
    let np = buildNativeProto(st, NATIVE_NUMBER, numNames)
    var numBrand: Vec<string> = Vec.new()
    numBrand.push("valueOf")
    numBrand.push("toString")
    numBrand.push("toFixed")
    numBrand.push("toPrecision")
    numBrand.push("toExponential")
    brandProtoMethods(st, np, BRAND_NUMBER, numBrand)
    boxProtoItself(st, np, JSValue.Number(0.0))

    var boolNames: Vec<string> = Vec.new()
    boolNames.push("toString")
    boolNames.push("valueOf")
    let bp = buildNativeProto(st, NATIVE_BOOLEAN, boolNames)
    var boolBrand: Vec<string> = Vec.new()
    boolBrand.push("valueOf")
    boolBrand.push("toString")
    brandProtoMethods(st, bp, BRAND_BOOLEAN, boolBrand)
    boxProtoItself(st, bp, JSValue.Bool(false))

    var symNames: Vec<string> = Vec.new()
    symNames.push("toString")
    symNames.push("valueOf")
    let sp = buildNativeProto(st, NATIVE_SYMBOL, symNames)
    var symBrand: Vec<string> = Vec.new()
    symBrand.push("valueOf")
    symBrand.push("toString")
    brandProtoMethods(st, sp, BRAND_SYMBOL, symBrand)

    // Map and Set share one method list here because they share a dispatcher;
    // only the names each actually answers are listed per side.
    var mapNames: Vec<string> = Vec.new()
    mapNames.push("get")
    mapNames.push("set")
    mapNames.push("has")
    mapNames.push("delete")
    mapNames.push("clear")
    mapNames.push("forEach")
    mapNames.push("keys")
    mapNames.push("values")
    mapNames.push("entries")
    st.mapProtoObj = buildNativeProto(st, NATIVE_MAP, mapNames)

    var setNames: Vec<string> = Vec.new()
    setNames.push("add")
    setNames.push("has")
    setNames.push("delete")
    setNames.push("clear")
    setNames.push("forEach")
    setNames.push("keys")
    setNames.push("values")
    setNames.push("entries")
    setNames.push("union")
    setNames.push("intersection")
    setNames.push("difference")
    setNames.push("isSubsetOf")
    setNames.push("isSupersetOf")
    setNames.push("isDisjointFrom")
    st.setProtoObj = buildNativeProto(st, NATIVE_SET, setNames)

    var promNames: Vec<string> = Vec.new()
    promNames.push("then")
    promNames.push("catch")
    promNames.push("finally")
    st.promiseProtoObj = buildNativeProto(st, NATIVE_PROMISE, promNames)
    // Promise's global binding is a plain OBJECT, not a JSValue.Native, so the
    // prototype hung off the NATIVE_PROMISE bag is unreachable from it — hang it
    // on the constructor object too. This runs after setupGlobals built that
    // object, which is why the link is made here rather than there.
    if st.promiseCtorObj >= 0 {
        objDefineProtoAttr(st, st.promiseCtorObj, "prototype", JSValue.Obj(st.promiseProtoObj))
        objSet(st, st.promiseProtoObj, "constructor", JSValue.Obj(st.promiseCtorObj))
        objSetNonEnumerable(st, st.promiseProtoObj, "constructor")
    }
}

fn setupRegexProto(st: &mut Interp) {
    let rp = newObject(st)
    st.objects[rp].proto = st.objectProtoObj
    var names: Vec<string> = Vec.new()
    names.push("exec")
    names.push("test")
    names.push("toString")
    names.push("compile")
    // String.prototype.match/replace/search/split are the real implementations
    // here; these delegate to them, which is the direction the spec runs in
    // reverse. Having them at all is what lets code feature-detect a regex.
    names.push("@@sym:Symbol.match:0")
    names.push("@@sym:Symbol.matchAll:0")
    names.push("@@sym:Symbol.replace:0")
    names.push("@@sym:Symbol.search:0")
    names.push("@@sym:Symbol.split:0")
    var i: i64 = 0
    while i < names.len() {
        objSet(st, rp, names[i].clone(), makeBoundMethod(st, JSValue.Undefined, names[i].clone()))
        objSetNonEnumerable(st, rp, names[i])
        i = i + 1
    }
    // The flag family is an ACCESSOR on the prototype in the spec, while this
    // engine keeps them as own data properties on each instance. Both can hold:
    // the getter is registered under an internal name, so an instance's own
    // property still wins on a normal read and only a read through the prototype
    // itself reaches the accessor.
    var flagNames: Vec<string> = Vec.new()
    flagNames.push("source")
    flagNames.push("flags")
    flagNames.push("global")
    flagNames.push("ignoreCase")
    flagNames.push("multiline")
    flagNames.push("sticky")
    flagNames.push("unicode")
    flagNames.push("unicodeSets")
    flagNames.push("dotAll")
    flagNames.push("hasIndices")
    var f: i64 = 0
    while f < flagNames.len() {
        let getter = makeBoundMethod(st, JSValue.Undefined, "__reGet_" + flagNames[f].clone())
        objDefineAccessor(st, rp, flagNames[f].clone(), getter, JSValue.Undefined)
        objSetNonEnumerable(st, rp, flagNames[f])
        f = f + 1
    }
    objSet(st, rp, "constructor", JSValue.Native(NATIVE_REGEXP))
    objSetNonEnumerable(st, rp, "constructor")
    let rbag = getNativeProps(st, NATIVE_REGEXP)
    objDefineProtoAttr(st, rbag, "prototype", JSValue.Obj(rp))
    st.regexProtoObj = rp
}

fn setupErrorProtos(st: &mut Interp) {
    let errorProto = newObject(st)
    objSet(st, errorProto, "name", JSValue.Str("Error"))
    objSet(st, errorProto, "message", JSValue.Str(""))
    objSet(st, errorProto, "constructor", JSValue.Native(NATIVE_ERROR))
    objSet(st, errorProto, "toString", makeBoundMethod(st, JSValue.Undefined, "toString"))
    let errBag = getNativeProps(st, NATIVE_ERROR)
    objSet(st, errBag, "prototype", JSValue.Obj(errorProto))
    st.objects[errorProto].proto = st.objectProtoObj

    var eid = NATIVE_ERROR + 1
    while eid <= NATIVE_REFERENCE_ERROR {
        setupOneErrorProto(st, eid, errorProto)
        eid = eid + 1
    }
    setupOneErrorProto(st, NATIVE_EVAL_ERROR, errorProto)
    setupOneErrorProto(st, NATIVE_URI_ERROR, errorProto)
}

fn setupOneErrorProto(st: &mut Interp, eid: i64, errorProto: i64) {
    let sub = newObject(st)
    objSet(st, sub, "name", JSValue.Str(nativeErrorName(eid)))
    objSet(st, sub, "message", JSValue.Str(""))
    objSet(st, sub, "constructor", JSValue.Native(eid))
    st.objects[sub].proto = errorProto
    let bag = getNativeProps(st, eid)
    objSet(st, bag, "prototype", JSValue.Obj(sub))
}

// The prototype object a freshly constructed error of this kind should link to,
// or -1 before setupErrorProtos has run (makeError is reachable during startup).
fn errorProtoFor(st: &mut Interp, nativeId: i64): i64 {
    let bag = getNativeProps(st, nativeId)
    return objHandle(objGet(st, bag, "prototype"))
}

// Give every native reachable as a method of `owner` its own `name`, derived
// from the key it is registered under. A native's properties live in a per-id
// bag (getNativeProps), so there is nowhere to put a name at the ~145 individual
// registration sites; one pass per namespace covers them all.
fn nameNativesOf(st: &mut Interp, owner: i64) {
    var i: i64 = 0
    while i < st.objects[owner].props.len() {
        let key = st.objects[owner].props[i].key.clone()
        let v = cloneValue(st.objects[owner].props[i].value)
        match v {
            JSValue.Native(nid) => {
                let bag = getNativeProps(st, nid)
                objDefineBuiltinAttr(st, bag, "length", JSValue.Number(builtinStaticArity(key) as f64))
                objDefineBuiltinAttr(st, bag, "name", JSValue.Str(key))
            }
            _ => {
            }
        }
        i = i + 1
    }
}

pub // A global built-in constructor's own `name` and `length`. They are bound with
// scopeDefine rather than hung off a namespace object, so nameNativesOf never
// reaches them and `Date.length` / `Array.name` were undefined.
fn nameGlobalCtor(st: &mut Interp, gname: string, nid: i64) {
    let bag = getNativeProps(st, nid)
    objDefineBuiltinAttr(st, bag, "length", JSValue.Number(builtinCtorArity(gname) as f64))
    objDefineBuiltinAttr(st, bag, "name", JSValue.Str(gname))
}

pub fn setupGlobals(st: &mut Interp) {
    scopeDefine(st, 0, "Error", JSValue.Native(NATIVE_ERROR))
    nameGlobalCtor(st, "Error", NATIVE_ERROR)
    scopeDefine(st, 0, "TypeError", JSValue.Native(NATIVE_TYPE_ERROR))
    nameGlobalCtor(st, "TypeError", NATIVE_TYPE_ERROR)
    scopeDefine(st, 0, "RangeError", JSValue.Native(NATIVE_RANGE_ERROR))
    nameGlobalCtor(st, "RangeError", NATIVE_RANGE_ERROR)
    scopeDefine(st, 0, "SyntaxError", JSValue.Native(NATIVE_SYNTAX_ERROR))
    nameGlobalCtor(st, "SyntaxError", NATIVE_SYNTAX_ERROR)
    scopeDefine(st, 0, "ReferenceError", JSValue.Native(NATIVE_REFERENCE_ERROR))
    nameGlobalCtor(st, "ReferenceError", NATIVE_REFERENCE_ERROR)
    scopeDefine(st, 0, "EvalError", JSValue.Native(NATIVE_EVAL_ERROR))
    nameGlobalCtor(st, "EvalError", NATIVE_EVAL_ERROR)
    scopeDefine(st, 0, "URIError", JSValue.Native(NATIVE_URI_ERROR))
    nameGlobalCtor(st, "URIError", NATIVE_URI_ERROR)
    scopeDefine(st, 0, "eval", JSValue.Native(NATIVE_EVAL))
    nameGlobalCtor(st, "eval", NATIVE_EVAL)
    // JSON is a plain object whose methods are native functions
    let json = newObject(st)
    objSet(st, json, "stringify", JSValue.Native(NATIVE_JSON_STRINGIFY))
    objSet(st, json, "parse", JSValue.Native(NATIVE_JSON_PARSE))
    nameNativesOf(st, json)
    scopeDefine(st, 0, "JSON", JSValue.Obj(json))
    // Math likewise: native-fn methods + numeric constants
    let math = newObject(st)
    objSet(st, math, "floor", JSValue.Native(NATIVE_MATH_FLOOR))
    objSet(st, math, "ceil", JSValue.Native(NATIVE_MATH_CEIL))
    objSet(st, math, "round", JSValue.Native(NATIVE_MATH_ROUND))
    objSet(st, math, "trunc", JSValue.Native(NATIVE_MATH_TRUNC))
    objSet(st, math, "abs", JSValue.Native(NATIVE_MATH_ABS))
    objSet(st, math, "sign", JSValue.Native(NATIVE_MATH_SIGN))
    objSet(st, math, "sqrt", JSValue.Native(NATIVE_MATH_SQRT))
    objSet(st, math, "pow", JSValue.Native(NATIVE_MATH_POW))
    objSet(st, math, "min", JSValue.Native(NATIVE_MATH_MIN))
    objSet(st, math, "max", JSValue.Native(NATIVE_MATH_MAX))
    objSet(st, math, "random", JSValue.Native(NATIVE_MATH_RANDOM))
    objSet(st, math, "exp", JSValue.Native(NATIVE_MATH_EXP))
    objSet(st, math, "log", JSValue.Native(NATIVE_MATH_LOG))
    objSet(st, math, "log2", JSValue.Native(NATIVE_MATH_LOG2))
    objSet(st, math, "log10", JSValue.Native(NATIVE_MATH_LOG10))
    objSet(st, math, "sin", JSValue.Native(NATIVE_MATH_SIN))
    objSet(st, math, "cos", JSValue.Native(NATIVE_MATH_COS))
    objSet(st, math, "tan", JSValue.Native(NATIVE_MATH_TAN))
    objSet(st, math, "asin", JSValue.Native(NATIVE_MATH_ASIN))
    objSet(st, math, "acos", JSValue.Native(NATIVE_MATH_ACOS))
    objSet(st, math, "atan", JSValue.Native(NATIVE_MATH_ATAN))
    objSet(st, math, "atan2", JSValue.Native(NATIVE_MATH_ATAN2))
    objSet(st, math, "LN2", JSValue.Number(0.6931471805599453))
    objSet(st, math, "LN10", JSValue.Number(2.302585092994046))
    objSet(st, math, "LOG2E", JSValue.Number(1.4426950408889634))
    objSet(st, math, "LOG10E", JSValue.Number(0.4342944819032518))
    objSet(st, math, "SQRT2", JSValue.Number(1.4142135623730951))
    objSet(st, math, "SQRT1_2", JSValue.Number(0.7071067811865476))
    objSet(st, math, "PI", JSValue.Number(3.141592653589793))
    objSet(st, math, "E", JSValue.Number(2.718281828459045))
    nameNativesOf(st, math)
    scopeDefine(st, 0, "Math", JSValue.Obj(math))
    scopeDefine(st, 0, "RegExp", JSValue.Native(NATIVE_REGEXP))
    nameGlobalCtor(st, "RegExp", NATIVE_REGEXP)
    let promiseCtor = newObject(st)
    nameNativesOf(st, promiseCtor)
    st.promiseCtorObj = promiseCtor
    objSet(st, promiseCtor, "resolve", JSValue.Native(NATIVE_PROMISE_RESOLVE))
    objSet(st, promiseCtor, "reject", JSValue.Native(NATIVE_PROMISE_REJECT))
    scopeDefine(st, 0, "Promise", JSValue.Obj(promiseCtor))
    // Object's statics live in the property bag that belongs to the native id,
    // so reading `Object.keys` as a value and calling `Object.keys(o)` both go
    // through the same place. A standalone object would only serve the call path.
    let objectCtor = getNativeProps(st, NATIVE_OBJECT_CTOR)
    objSet(st, objectCtor, "defineProperty", JSValue.Native(NATIVE_OBJECT_DEFINEPROPERTY))
    objSet(st, objectCtor, "keys", JSValue.Native(NATIVE_OBJECT_KEYS))
    objSet(st, objectCtor, "assign", JSValue.Native(NATIVE_OBJECT_ASSIGN))
    objSet(st, objectCtor, "values", JSValue.Native(NATIVE_OBJECT_VALUES))
    objSet(st, objectCtor, "entries", JSValue.Native(NATIVE_OBJECT_ENTRIES))
    objSet(st, objectCtor, "freeze", JSValue.Native(NATIVE_OBJECT_FREEZE))
    objSet(st, objectCtor, "isFrozen", JSValue.Native(NATIVE_OBJECT_ISFROZEN))
    objSet(st, objectCtor, "preventExtensions", JSValue.Native(NATIVE_OBJECT_PREVENTEXT))
    objSet(st, objectCtor, "isExtensible", JSValue.Native(NATIVE_OBJECT_ISEXT))
    objSet(st, objectCtor, "seal", JSValue.Native(NATIVE_OBJECT_SEAL))
    objSet(st, objectCtor, "isSealed", JSValue.Native(NATIVE_OBJECT_ISSEALED))
    objSet(st, objectCtor, "create", JSValue.Native(NATIVE_OBJECT_CREATE))
    objSet(st, objectCtor, "getPrototypeOf", JSValue.Native(NATIVE_OBJECT_GETPROTO))
    objSet(st, objectCtor, "setPrototypeOf", JSValue.Native(NATIVE_OBJECT_SETPROTO))
    objSet(st, objectCtor, "getOwnPropertyDescriptor", JSValue.Native(NATIVE_OBJECT_GETOWNPROPDESC))
    objSet(st, objectCtor, "getOwnPropertyDescriptors", JSValue.Native(NATIVE_OBJECT_GETOWNPROPDESCS))
    objSet(st, objectCtor, "defineProperties", JSValue.Native(NATIVE_OBJECT_DEFINEPROPERTIES))
    objSet(st, objectCtor, "getOwnPropertyNames", JSValue.Native(NATIVE_OBJECT_GETOWNPROPNAMES))
    objSet(st, objectCtor, "getOwnPropertySymbols", JSValue.Native(NATIVE_OBJECT_GETOWNPROPSYMBOLS))
    objSet(st, objectCtor, "is", JSValue.Native(NATIVE_OBJECT_IS))
    objSet(st, objectCtor, "hasOwn", JSValue.Native(NATIVE_OBJECT_HASOWN))
    let objectProto = newObject(st)
    objSet(st, objectProto, "hasOwnProperty", makeBoundMethod(st, JSValue.Undefined, "hasOwnProperty"))
    // Object.prototype.toString.call(x) is the standard type-detection idiom
    // bound under a private name, not "toString": dispatching by the plain name
    // sent Object.prototype.toString.call(x) into x's OWN toString (a function
    // printed its source, a regex returned undefined), which broke the
    // `Object.prototype.toString.call(o).slice(8, -1)` type-tag idiom.
    objSet(st, objectProto, "toString", makeBoundMethod(st, JSValue.Undefined, "@@objProtoToString"))
    objSet(st, objectProto, "valueOf", makeBoundMethod(st, JSValue.Undefined, "valueOf"))
    objSet(st, objectProto, "isPrototypeOf", makeBoundMethod(st, JSValue.Undefined, "isPrototypeOf"))
    objSet(st, objectProto, "propertyIsEnumerable", makeBoundMethod(st, JSValue.Undefined, "propertyIsEnumerable"))
    // Object.prototype's own methods are non-enumerable. Nothing had it in a
    // for-in reachable chain before (a plain object is not linked to it here),
    // so the omission stayed invisible until String wrappers arrived and listed
    // hasOwnProperty/toString/valueOf/isPrototypeOf among a string's indices.
    for opm in ["hasOwnProperty", "toString", "valueOf", "isPrototypeOf", "propertyIsEnumerable"] {
        objSetNonEnumerable(st, objectProto, opm)
    }
    objSet(st, objectCtor, "prototype", JSValue.Obj(objectProto))
    st.objectProtoObj = objectProto
    // after objectProtoObj exists: Error.prototype chains to it
    setupErrorProtos(st)
    setupTypedArrayProtos(st)
    setupBufferProtos(st)
    setupRegexProto(st)
    setupRemainingProtos(st)
    // Object is itself an object, so it carries the Object.prototype methods.
    // Code borrows them from the constructor — `Object.hasOwnProperty.call(o, k)`
    // is a common way to avoid a shadowed own property — and the native's bag
    // does not inherit, so they are installed explicitly.
    objSet(st, objectCtor, "hasOwnProperty", makeBoundMethod(st, JSValue.Undefined, "hasOwnProperty"))
    objSet(st, objectCtor, "isPrototypeOf", makeBoundMethod(st, JSValue.Undefined, "isPrototypeOf"))
    objSet(st, objectCtor, "propertyIsEnumerable", makeBoundMethod(st, JSValue.Undefined, "propertyIsEnumerable"))
    objSet(st, objectCtor, "toString", makeBoundMethod(st, JSValue.Undefined, "@@objProtoToString"))
    objSet(st, objectCtor, "valueOf", makeBoundMethod(st, JSValue.Undefined, "valueOf"))
    nameNativesOf(st, objectCtor)
    scopeDefine(st, 0, "Object", JSValue.Native(NATIVE_OBJECT_CTOR))
    nameGlobalCtor(st, "Object", NATIVE_OBJECT_CTOR)
    scopeDefine(st, 0, "Number", JSValue.Native(NATIVE_NUMBER))
    nameGlobalCtor(st, "Number", NATIVE_NUMBER)
    scopeDefine(st, 0, "BigInt", JSValue.Native(NATIVE_BIGINT))
    nameGlobalCtor(st, "BigInt", NATIVE_BIGINT)
    let stringCtorObj = getNativeProps(st, NATIVE_STRING)
    objSet(st, stringCtorObj, "fromCharCode", JSValue.Native(NATIVE_STRING_FROMCHARCODE))
    objSet(st, stringCtorObj, "fromCodePoint", JSValue.Native(NATIVE_STRING_FROMCODEPOINT))
    objSet(st, stringCtorObj, "raw", JSValue.Native(NATIVE_STRING_RAW))
    // String.prototype methods as bound-method values, so
    // String.prototype.replace.call(str, ...) — the qs module's pattern — works
    let stringProto = newObject(st)
    for sm in strProtoMethodNames() {
        objSet(st, stringProto, sm.clone(), makeBrandedMethod(st, sm.clone(), BRAND_STRING_GENERIC))
        objSetNonEnumerable(st, stringProto, sm)
    }
    var strBrand: Vec<string> = Vec.new()
    strBrand.push("valueOf")
    strBrand.push("toString")
    brandProtoMethods(st, stringProto, BRAND_STRING, strBrand)
    boxProtoItself(st, stringProto, JSValue.Str(""))
    objSetFrozenOwn(st, stringProto, "length", JSValue.Number(0.0), false)
    objSet(st, stringProto, "constructor", JSValue.Native(NATIVE_STRING))
    objSetNonEnumerable(st, stringProto, "constructor")
    st.objects[stringProto].proto = objectProto
    objSet(st, stringCtorObj, "prototype", JSValue.Obj(stringProto))
    nameNativesOf(st, stringCtorObj)
    st.stringCtorProps = stringCtorObj
    st.stringProtoObj = stringProto
    st.stringProtoPristine = true
    scopeDefine(st, 0, "String", JSValue.Native(NATIVE_STRING))
    nameGlobalCtor(st, "String", NATIVE_STRING)
    scopeDefine(st, 0, "Boolean", JSValue.Native(NATIVE_BOOLEAN))
    nameGlobalCtor(st, "Boolean", NATIVE_BOOLEAN)
    scopeDefine(st, 0, "NaN", JSValue.Number(jsNan()))
    scopeDefine(st, 0, "Infinity", JSValue.Number(jsInfinity()))
    scopeDefine(st, 0, "isNaN", JSValue.Native(NATIVE_IS_NAN))
    scopeDefine(st, 0, "gc", JSValue.Native(NATIVE_GC))
    scopeDefine(st, 0, "isFinite", JSValue.Native(NATIVE_IS_FINITE))
    scopeDefine(st, 0, "parseInt", JSValue.Native(NATIVE_PARSE_INT))
    scopeDefine(st, 0, "parseFloat", JSValue.Native(NATIVE_PARSE_FLOAT))
    // The shared iterator prototype. The prelude installs the helper methods
    // (map/filter/take/...) onto this one object; every iterator the engine
    // builds points its proto here, so helpers work on array iterators too.
    let iterProto = newObject(st)
    // %IteratorPrototype% inherits from Object.prototype. The link was missing,
    // so the array-iterator chain was one shorter than node's and
    // getPrototypeOf three deep answered null. Invisible until Reflect started
    // rejecting a non-object argument, which is what a null third link is.
    st.objects[iterProto].proto = st.objectProtoObj
    st.iterProtoObj = iterProto
    scopeDefine(st, 0, "__iteratorProto", JSValue.Obj(iterProto))
    // globalThis: a real object whose properties ARE the global bindings
    let globalObj = newObject(st)
    st.objects[globalObj].isGlobal = true
    scopeDefine(st, 0, "globalThis", JSValue.Obj(globalObj))
    scopeDefine(st, 0, "Symbol", JSValue.Native(NATIVE_SYMBOL))
    nameGlobalCtor(st, "Symbol", NATIVE_SYMBOL)
    let symbolCtorObj = getNativeProps(st, NATIVE_SYMBOL)
    objSet(st, symbolCtorObj, "iterator", JSValue.Str(symIteratorKey()))
    // other well-known symbols — interned keys like @@iterator, counter 0
    objSet(st, symbolCtorObj, "asyncIterator", JSValue.Str("@@sym:Symbol.asyncIterator:0"))
    objSet(st, symbolCtorObj, "toPrimitive", JSValue.Str(symToPrimitiveKey()))
    objSet(st, symbolCtorObj, "toStringTag", JSValue.Str(symToStringTagKey()))
    objSet(st, symbolCtorObj, "hasInstance", JSValue.Str("@@sym:Symbol.hasInstance:0"))
    // the regex protocol symbols, which RegExp.prototype implements
    objSet(st, symbolCtorObj, "match", JSValue.Str("@@sym:Symbol.match:0"))
    objSet(st, symbolCtorObj, "matchAll", JSValue.Str("@@sym:Symbol.matchAll:0"))
    objSet(st, symbolCtorObj, "replace", JSValue.Str("@@sym:Symbol.replace:0"))
    objSet(st, symbolCtorObj, "search", JSValue.Str("@@sym:Symbol.search:0"))
    objSet(st, symbolCtorObj, "split", JSValue.Str("@@sym:Symbol.split:0"))
    let dateCtorObj = getNativeProps(st, NATIVE_DATE)
    objSet(st, dateCtorObj, "now", JSValue.Native(NATIVE_DATE_NOW))
    objSet(st, dateCtorObj, "UTC", JSValue.Native(NATIVE_DATE_UTC))
    objSet(st, dateCtorObj, "parse", JSValue.Native(NATIVE_DATE_PARSE))
    // Date.prototype methods as bound-method values, so
    // Date.prototype.toISOString.call(d) — qs's pattern — works
    let dateProto = newObject(st)
    for dm in dateProtoMethodNames() {
        objSet(st, dateProto, dm.clone(), makeBrandedMethod(st, dm.clone(), BRAND_DATE))
    }
    objDefineProtoAttr(st, dateCtorObj, "prototype", JSValue.Obj(dateProto))
    objSet(st, dateProto, "constructor", JSValue.Native(NATIVE_DATE))
    objSetNonEnumerable(st, dateProto, "constructor")
    st.objects[dateProto].proto = st.objectProtoObj
    nameNativesOf(st, dateCtorObj)
    // after nameNativesOf, which would otherwise overwrite it: Date.parse is the
    // one static whose name collides across namespaces (JSON.parse is 2), and
    // builtinStaticArity is keyed by name alone
    objDefineBuiltinAttr(st, getNativeProps(st, NATIVE_DATE_PARSE), "length", JSValue.Number(1.0))
    st.dateProtoObj = dateProto
    st.dateCtorProps = dateCtorObj
    scopeDefine(st, 0, "Date", JSValue.Native(NATIVE_DATE))
    nameGlobalCtor(st, "Date", NATIVE_DATE)
    // Function.prototype.{call,apply,bind} are bound-method values: invoking
    // .call on them re-targets to whatever function is passed as the receiver,
    // which is how Function.prototype.apply.call(fn, ...) resolves
    let functionProto = newObject(st)
    objSet(st, functionProto, "call", makeBoundMethod(st, JSValue.Undefined, "call"))
    objSet(st, functionProto, "apply", makeBoundMethod(st, JSValue.Undefined, "apply"))
    objSet(st, functionProto, "bind", makeBoundMethod(st, JSValue.Undefined, "bind"))
    // lodash and friends compare functions by source text via
    // Function.prototype.toString.call(fn)
    objSet(st, functionProto, "toString", makeBoundMethod(st, JSValue.Undefined, "toString"))
    st.objects[functionProto].isFunctionLike = true
    // Function is a Native rather than a plain object so that CALLING it reaches
    // callNativeProg; as an object it was only ever a namespace holding
    // .prototype, and `Function("return 1")` reported "Function is not a
    // function".
    let functionCtorBag = getNativeProps(st, NATIVE_FUNCTION_CTOR)
    objDefineProtoAttr(st, functionCtorBag, "prototype", JSValue.Obj(functionProto))
    objSet(st, functionProto, "constructor", JSValue.Native(NATIVE_FUNCTION_CTOR))
    objSetNonEnumerable(st, functionProto, "constructor")
    scopeDefine(st, 0, "Function", JSValue.Native(NATIVE_FUNCTION_CTOR))
    nameGlobalCtor(st, "Function", NATIVE_FUNCTION_CTOR)
    scopeDefine(st, 0, "setTimeout", JSValue.Native(NATIVE_SET_TIMEOUT))
    scopeDefine(st, 0, "setInterval", JSValue.Native(NATIVE_SET_INTERVAL))
    scopeDefine(st, 0, "clearTimeout", JSValue.Native(NATIVE_CLEAR_TIMER))
    scopeDefine(st, 0, "clearInterval", JSValue.Native(NATIVE_CLEAR_TIMER))
    scopeDefine(st, 0, "clearImmediate", JSValue.Native(NATIVE_CLEAR_TIMER))
    scopeDefine(st, 0, "setImmediate", JSValue.Native(NATIVE_SET_IMMEDIATE))
    scopeDefine(st, 0, "queueMicrotask", JSValue.Native(NATIVE_QUEUE_MICROTASK_JS))
    // not a JS global in node; lib/util.js reads it off globalThis so util.inspect
    // and console.log render identically
    scopeDefine(st, 0, "__inspect", JSValue.Native(NATIVE_INSPECT))
    // The raw "wrap a value in a resolved promise" primitive, exposed under its
    // own name so the prelude can build the public Promise.resolve on top of it.
    // Capturing `Promise.resolve` from JS does not work: reading a method off a
    // native constructor yields a late-bound dispatcher that looks the name up
    // again at call time, so a wrapper calling the captured value re-entered
    // itself forever.
    scopeDefine(st, 0, "__promiseResolveValue", JSValue.Native(NATIVE_PROMISE_RESOLVE))
    scopeDefine(st, 0, "encodeURIComponent", JSValue.Native(NATIVE_ENCODE_URI_COMPONENT))
    scopeDefine(st, 0, "decodeURIComponent", JSValue.Native(NATIVE_DECODE_URI_COMPONENT))
    scopeDefine(st, 0, "encodeURI", JSValue.Native(NATIVE_ENCODE_URI))
    scopeDefine(st, 0, "decodeURI", JSValue.Native(NATIVE_DECODE_URI))
    scopeDefine(st, 0, "ArrayBuffer", JSValue.Native(NATIVE_ARRAYBUFFER))
    nameGlobalCtor(st, "ArrayBuffer", NATIVE_ARRAYBUFFER)
    scopeDefine(st, 0, "DataView", JSValue.Native(NATIVE_DATAVIEW))
    nameGlobalCtor(st, "DataView", NATIVE_DATAVIEW)
    var tk: i64 = 0
    while tk <= TA_U8C {
        scopeDefine(st, 0, taName(tk), JSValue.Native(NATIVE_TA_BASE + tk))
        tk = tk + 1
    }
    scopeDefine(st, 0, "Map", JSValue.Native(NATIVE_MAP))
    nameGlobalCtor(st, "Map", NATIVE_MAP)
    scopeDefine(st, 0, "WeakMap", JSValue.Native(NATIVE_MAP))
    scopeDefine(st, 0, "Set", JSValue.Native(NATIVE_SET))
    nameGlobalCtor(st, "Set", NATIVE_SET)
    scopeDefine(st, 0, "WeakSet", JSValue.Native(NATIVE_SET))
    // Array.prototype.<m> as a bound-method value, so the ES5 idiom
    // Array.prototype.slice.call(arguments) resolves
    let arrayProto = newObject(st)
    // Every whitelisted method, not a hand-picked few: each is generic in ES, so
    // Array.prototype.<m>.call(arrayLike) has to resolve for all of them. The
    // bound `this` is left unset so the call site's receiver wins (see
    // isBoundThisSet).
    // Non-enumerable, which matters now that arrays link this as a real proto:
    // `for (k in [1,2])` and Object.keys must yield indices only, not 36 methods.
    var apm: i64 = 0
    let apNames = arrayMethodNames()
    while apm < apNames.len() {
        objSet(st, arrayProto, apNames[apm].clone(), makeBoundMethod(st, JSValue.Undefined, apNames[apm].clone()))
        objSetNonEnumerable(st, arrayProto, apNames[apm])
        apm = apm + 1
    }
    let arrayCtor = newObject(st)
    st.objects[arrayCtor].isFunctionLike = true
    objSet(st, arrayCtor, "prototype", JSValue.Obj(arrayProto))
    objSet(st, arrayCtor, "name", JSValue.Str("Array"))
    nameNativesOf(st, arrayCtor)
    st.arrayCtorObj = arrayCtor
    st.arrayProtoObj = arrayProto
    // Set only now that setup has finished writing the methods in, so the setup
    // writes themselves do not count as a user touch.
    st.arrayProtoPristine = true
    objSet(st, arrayCtor, "isArray", JSValue.Native(NATIVE_ARRAY_ISARRAY))
    objSet(st, arrayCtor, "from", JSValue.Native(NATIVE_ARRAY_FROM))
    scopeDefine(st, 0, "Array", JSValue.Obj(arrayCtor))
    // file natives, named as minibun's runtime expects them
    // raw TCP, used by the http builtin; not part of the JS surface
    scopeDefine(st, 0, "__tcpListen", JSValue.Native(NATIVE_TCP_LISTEN))
    scopeDefine(st, 0, "__tcpAccept", JSValue.Native(NATIVE_TCP_ACCEPT))
    scopeDefine(st, 0, "__tcpRecv", JSValue.Native(NATIVE_TCP_RECV))
    scopeDefine(st, 0, "__tcpSend", JSValue.Native(NATIVE_TCP_SEND))
    scopeDefine(st, 0, "__tcpClose", JSValue.Native(NATIVE_TCP_CLOSE))
    scopeDefine(st, 0, "__httpFetch", JSValue.Native(NATIVE_HTTP_FETCH))
    scopeDefine(st, 0, "__sqliteOpen", JSValue.Native(NATIVE_SQLITE_OPEN))
    scopeDefine(st, 0, "__sqliteClose", JSValue.Native(NATIVE_SQLITE_CLOSE))
    scopeDefine(st, 0, "__sqliteExec", JSValue.Native(NATIVE_SQLITE_EXEC))
    scopeDefine(st, 0, "__sqlitePrepare", JSValue.Native(NATIVE_SQLITE_PREPARE))
    scopeDefine(st, 0, "__sqliteErrmsg", JSValue.Native(NATIVE_SQLITE_ERRMSG))
    scopeDefine(st, 0, "__sqliteStep", JSValue.Native(NATIVE_SQLITE_STEP))
    scopeDefine(st, 0, "__sqliteColumnCount", JSValue.Native(NATIVE_SQLITE_COLUMN_COUNT))
    scopeDefine(st, 0, "__sqliteColumnName", JSValue.Native(NATIVE_SQLITE_COLUMN_NAME))
    scopeDefine(st, 0, "__sqliteColumnValue", JSValue.Native(NATIVE_SQLITE_COLUMN_VALUE))
    scopeDefine(st, 0, "__sqliteBind", JSValue.Native(NATIVE_SQLITE_BIND))
    scopeDefine(st, 0, "__sqliteReset", JSValue.Native(NATIVE_SQLITE_RESET))
    scopeDefine(st, 0, "__sqliteFinalize", JSValue.Native(NATIVE_SQLITE_FINALIZE))
    scopeDefine(st, 0, "__sqliteChanges", JSValue.Native(NATIVE_SQLITE_CHANGES))
    scopeDefine(st, 0, "__sqliteLastInsertId", JSValue.Native(NATIVE_SQLITE_LAST_INSERT_ID))
    scopeDefine(st, 0, "__sqliteBindIndex", JSValue.Native(NATIVE_SQLITE_BIND_INDEX))
    scopeDefine(st, 0, "__sqliteFilename", JSValue.Native(NATIVE_SQLITE_FILENAME))
    scopeDefine(st, 0, "__httpRegister", JSValue.Native(NATIVE_HTTP_REGISTER))
    scopeDefine(st, 0, "__httpUnregister", JSValue.Native(NATIVE_HTTP_UNREGISTER))
    scopeDefine(st, 0, "__writeFileSync", JSValue.Native(NATIVE_WRITE_FILE))
    scopeDefine(st, 0, "__readFileSync", JSValue.Native(NATIVE_READ_FILE_SYNC))
    scopeDefine(st, 0, "__mkdirSync", JSValue.Native(NATIVE_MKDIR))
    scopeDefine(st, 0, "__readdirSync", JSValue.Native(NATIVE_READDIR))
    scopeDefine(st, 0, "__callFrames", JSValue.Native(NATIVE_CALL_FRAMES))
    scopeDefine(st, 0, "__unlinkSync", JSValue.Native(NATIVE_UNLINK))
    scopeDefine(st, 0, "__rmdirSync", JSValue.Native(NATIVE_RMDIR))
    scopeDefine(st, 0, "__renameSync", JSValue.Native(NATIVE_RENAME))
    scopeDefine(st, 0, "__isDir", JSValue.Native(NATIVE_IS_DIR))
    scopeDefine(st, 0, "__fileExists", JSValue.Native(NATIVE_FILE_EXISTS))
    scopeDefine(st, 0, "__byteLength", JSValue.Native(NATIVE_BYTE_LENGTH))
    scopeDefine(st, 0, "__napiLoad", JSValue.Native(NATIVE_NAPI_LOAD))
    scopeDefine(st, 0, "__httpFetchAsync", JSValue.Native(NATIVE_HTTP_FETCH_ASYNC))
    let consoleObj = newObject(st)
    objSet(st, consoleObj, "log", JSValue.Native(NATIVE_CONSOLE_LOG))
    objSet(st, consoleObj, "info", JSValue.Native(NATIVE_CONSOLE_LOG))
    objSet(st, consoleObj, "debug", JSValue.Native(NATIVE_CONSOLE_LOG))
    objSet(st, consoleObj, "trace", JSValue.Native(NATIVE_CONSOLE_LOG))
    objSet(st, consoleObj, "dir", JSValue.Native(NATIVE_CONSOLE_LOG))
    objSet(st, consoleObj, "warn", JSValue.Native(NATIVE_CONSOLE_ERROR))
    objSet(st, consoleObj, "error", JSValue.Native(NATIVE_CONSOLE_ERROR))
    scopeDefine(st, 0, "console", JSValue.Obj(consoleObj))
    scopeDefine(st, 0, "Proxy", JSValue.Native(NATIVE_PROXY))
    nameGlobalCtor(st, "Proxy", NATIVE_PROXY)
}

// typeof: never throws, even for an unbound name (scopeLookup returns undefined).
fn typeofStr(v: &JSValue): string {
    match v {
        JSValue.Undefined => {
            return "undefined"
        }
        JSValue.Null => {
            return "object"
        }
        JSValue.Bool(_b) => {
            return "boolean"
        }
        JSValue.Number(_n) => {
            return "number"
        }
        JSValue.Str(_s) => {
            return "string"
        }
        JSValue.BigInt(_s) => {
            return "bigint"
        }
        JSValue.Func(_f, _e) => {
            return "function"
        }
        JSValue.Obj(_o) => {
            return "object"
        }
        JSValue.Native(_id) => {
            return "function"
        }
    }
}

fn isBigIntVal(v: &JSValue): bool {
    match v {
        JSValue.BigInt(_s) => {
            return true
        }
        _ => {
            return false
        }
    }
}

fn isStrVal(v: &JSValue): bool {
    match v {
        JSValue.Str(_s) => {
            return true
        }
        _ => {
            return false
        }
    }
}

// the decimal string of a BigInt, or "" for anything else
fn bigStrOf(v: &JSValue): string {
    match v {
        JSValue.BigInt(s) => {
            return s.clone()
        }
        _ => {
            return ""
        }
    }
}

// Binary operators where at least one operand is a BigInt. Arithmetic requires
// BOTH to be BigInt (JS throws on a mix); comparison and == coerce across types;
// === defers to the value-equality rule; bitwise on BigInt is not implemented and
// throws rather than returning a silently-wrong (double-based) answer.
fn evalBigIntBin(op: &string, va: JSValue, vb: JSValue, st: &mut Interp): JSValue {
    let aBig = isBigIntVal(va)
    let bBig = isBigIntVal(vb)
    // `+` with a string operand concatenates (BigInt stringifies without the `n`)
    if op == "+" && (isStrVal(va) || isStrVal(vb)) {
        return JSValue.Str(toStr(va) + toStr(vb))
    }
    if op == "===" {
        return JSValue.Bool(jsStrictEquals(va, vb))
    }
    if op == "!==" {
        return JSValue.Bool(!jsStrictEquals(va, vb))
    }
    // arithmetic: both operands must be BigInt
    if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || op == "**" {
        if !(aBig && bBig) {
            st.throwing = true
            st.thrownValue = makeError(st, "TypeError", "Cannot mix BigInt and other types, use explicit conversions")
            return JSValue.Undefined
        }
        let sa = bigStrOf(va)
        let sb = bigStrOf(vb)
        if op == "+" {
            return JSValue.BigInt(bnAdd(sa, sb))
        }
        if op == "-" {
            return JSValue.BigInt(bnSub(sa, sb))
        }
        if op == "*" {
            return JSValue.BigInt(bnMul(sa, sb))
        }
        if op == "/" {
            if sb == "0" {
                st.throwing = true
                st.thrownValue = makeError(st, "RangeError", "Division by zero")
                return JSValue.Undefined
            }
            return JSValue.BigInt(bnDiv(sa, sb))
        }
        if op == "%" {
            if sb == "0" {
                st.throwing = true
                st.thrownValue = makeError(st, "RangeError", "Division by zero")
                return JSValue.Undefined
            }
            return JSValue.BigInt(bnMod(sa, sb))
        }
        // op == "**"
        if sb.len() > 0 && sb[0] == '-' {
            st.throwing = true
            st.thrownValue = makeError(st, "RangeError", "Exponent must be non-negative")
            return JSValue.Undefined
        }
        return JSValue.BigInt(bnPow(sa, sb))
    }
    // comparison + loose equality: mixing is allowed. Both BigInt compare exactly;
    // a BigInt vs Number/String comparison goes through f64 (lossy only past 2^53).
    if op == "<" || op == ">" || op == "<=" || op == ">=" || op == "==" || op == "!=" {
        var c: i64 = 0
        if aBig && bBig {
            c = bnCmp(bigStrOf(va), bigStrOf(vb))
        } else {
            let na = toNum(va)
            let nb = toNum(vb)
            if na < nb {
                c = -1
            } else if na > nb {
                c = 1
            } else {
                c = 0
            }
        }
        if op == "<" {
            return JSValue.Bool(c < 0)
        }
        if op == ">" {
            return JSValue.Bool(c > 0)
        }
        if op == "<=" {
            return JSValue.Bool(c <= 0)
        }
        if op == ">=" {
            return JSValue.Bool(c >= 0)
        }
        if op == "==" {
            return JSValue.Bool(c == 0)
        }
        return JSValue.Bool(c != 0)
    }
    // &, |, ^, <<, >> on BigInt. Both operands must be BigInt (like arithmetic).
    if op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" || op == ">>>" {
        if !(aBig && bBig) {
            st.throwing = true
            st.thrownValue = makeError(st, "TypeError", "Cannot mix BigInt and other types, use explicit conversions")
            return JSValue.Undefined
        }
        let sa = bigStrOf(va)
        let sb = bigStrOf(vb)
        if op == "<<" {
            return JSValue.BigInt(bnShl(sa, sb))
        }
        if op == ">>" {
            return JSValue.BigInt(bnShr(sa, sb))
        }
        if op == ">>>" {
            // JS: BigInts are signed, `>>>` has no meaning → TypeError
            st.throwing = true
            st.thrownValue = makeError(st, "TypeError", "BigInts have no unsigned right shift, use >> instead")
            return JSValue.Undefined
        }
        var opc: u8 = '&'
        if op == "|" {
            opc = '|'
        } else if op == "^" {
            opc = '^'
        }
        return JSValue.BigInt(bnBitwise(opc, sa, sb))
    }
    st.throwing = true
    st.thrownValue = makeError(st, "TypeError", "BigInt operation not supported")
    return JSValue.Undefined
}

// Binary evaluation is separated from the full expression dispatcher because a
// tree-walk keeps this frame live while evaluating either operand. Keeping only
// binary locals here prevents rare expression arms from inflating every
// recursive JavaScript call's native stack usage.
// Whether a `==` operand takes part in the object-to-primitive conversion.
// Null and Undefined never do: they compare equal to each other and to nothing
// else, so a loose comparison against them must not run user code.
fn isEqCoercible(v: &JSValue): bool {
    match v {
        JSValue.Null => {
            return false
        }
        JSValue.Undefined => {
            return false
        }
        _ => {
            return true
        }
    }
}

fn evalBinaryExpr(prog: &Prog, op: &string, a: ExprId, b: ExprId, st: &mut Interp, scope: i64): JSValue {
    if op == "&&" {
        let va = evalExpr(prog, a, st, scope)
        if !truthy(va) {
            return va
        }
        return evalExpr(prog, b, st, scope)
    }
    if op == "||" {
        let va = evalExpr(prog, a, st, scope)
        if truthy(va) {
            return va
        }
        return evalExpr(prog, b, st, scope)
    }
    if op == "??" {
        let va = evalExpr(prog, a, st, scope)
        match va {
            JSValue.Null => {
                return evalExpr(prog, b, st, scope)
            }
            JSValue.Undefined => {
                return evalExpr(prog, b, st, scope)
            }
            _ => {
                return va
            }
        }
    }
    if op == "in" {
        let kv = evalExpr(prog, a, st, scope)
        let ov = evalExpr(prog, b, st, scope)
        return evalInOperator(prog, toStr(kv), ov, st)
    }
    if op == "instanceof" {
        let lv = evalExpr(prog, a, st, scope)
        pushTemp(st, cloneValue(lv))
        let rv = evalExpr(prog, b, st, scope)
        popTemp(st)
        return JSValue.Bool(instanceOf(st, lv, rv))
    }
    let va = evalExpr(prog, a, st, scope)
    pushTemp(st, cloneValue(va))
    let vb = evalExpr(prog, b, st, scope)
    popTemp(st)
    if isBigIntVal(va) || isBigIntVal(vb) {
        return evalBigIntBin(op, va, vb, st)
    }
    // `==` between an object and a primitive converts the OBJECT side, which is
    // how `new String("a") == "a"` is true while `===` stays false. Two objects
    // still compare by reference, so this fires only on a mixed pair.
    // ...but ONLY against a Number/String/BigInt/Symbol. `obj == null` and
    // `obj == undefined` are false by definition, with no conversion at all, so
    // converting there calls valueOf on an object whose valueOf may legitimately
    // throw: `Date.prototype != null` is the null-guard get-intrinsic opens with.
    if (op == "==" || op == "!=") && (objHandle(va) >= 0) != (objHandle(vb) >= 0) && isEqCoercible(va) && isEqCoercible(vb) {
        pushTemp(st, cloneValue(va))
        pushTemp(st, cloneValue(vb))
        var ea = cloneValue(va)
        var eb = cloneValue(vb)
        if objHandle(va) >= 0 {
            ea = toPrimitiveDefault(prog, va, st)
        } else {
            eb = toPrimitiveDefault(prog, vb, st)
        }
        popTemp(st)
        popTemp(st)
        if st.throwing {
            return JSValue.Undefined
        }
        return evalBin(op, ea, eb)
    }
    let coerces = op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || op == "**" || op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" || op == ">>>" || op == "<" || op == ">" || op == "<=" || op == ">="
    if coerces && (objHandle(va) >= 0 || objHandle(vb) >= 0) {
        pushTemp(st, cloneValue(va))
        pushTemp(st, cloneValue(vb))
        var pa = JSValue.Undefined
        var pb = JSValue.Undefined
        if op == "+" {
            pa = toPrimitiveDefault(prog, va, st)
            pushTemp(st, cloneValue(pa))
            pb = toPrimitiveDefault(prog, vb, st)
            popTemp(st)
        } else {
            pa = toPrimitiveNumber(prog, va, st)
            pushTemp(st, cloneValue(pa))
            pb = toPrimitiveNumber(prog, vb, st)
            popTemp(st)
        }
        popTemp(st)
        popTemp(st)
        return evalBin(op, pa, pb)
    }
    return evalBin(op, va, vb)
}

// Hot recursive nodes bypass the full dispatcher. The fallback contains large
// await/literal/construction arms whose locals otherwise reserve stack space on
// every simple call, even when those arms are not selected.
pub fn evalExpr(prog: &Prog, id: ExprId, st: &mut Interp, scope: i64): JSValue {
    if st.throwing {
        return JSValue.Undefined
    }
    match prog.exprs[id.index] {
        Expr.Num(n) => {
            return JSValue.Number(n)
        }
        Expr.StrLit(s) => {
            return JSValue.Str(s.clone())
        }
        Expr.BigIntLit(s) => {
            return JSValue.BigInt(bigNormalizeDec(s))
        }
        Expr.BoolLit(b) => {
            return JSValue.Bool(b)
        }
        Expr.NullLit => {
            return JSValue.Null
        }
        Expr.UndefLit => {
            return JSValue.Undefined
        }
        Expr.Ident(name) => {
            match scopeTryLookup(st, scope, name) {
                Option.Some(v) => {
                    return v
                }
                Option.None => {
                    if name != "this" {
                        st.throwing = true
                        st.thrownValue = makeError(st, "ReferenceError", name.clone() + " is not defined")
                    }
                    return JSValue.Undefined
                }
            }
        }
        Expr.Bin(op, a, b) => {
            return evalBinaryExpr(prog, op, a, b, st, scope)
        }
        Expr.Call(callee, argsIdx) => {
            return evalCall(prog, callee, argsIdx, st, scope)
        }
        _ => {
    return evalExprFallback(prog, id, st, scope)
        }
    }
}

fn evalExprFallback(prog: &Prog, id: ExprId, st: &mut Interp, scope: i64): JSValue {
    // an exception is unwinding — stop evaluating, produce a placeholder
    if st.throwing {
        return JSValue.Undefined
    }
    // match the arena slot in place — cloning the node (and its string payloads)
    // per visit was the dominant interpreter cost
    match prog.exprs[id.index] {
        Expr.Num(n) => {
            return JSValue.Number(n)
        }
        Expr.StrLit(s) => {
            return JSValue.Str(s.clone())
        }
        Expr.BigIntLit(s) => {
            return JSValue.BigInt(bigNormalizeDec(s))
        }
        Expr.BoolLit(b) => {
            return JSValue.Bool(b)
        }
        Expr.NullLit => {
            return JSValue.Null
        }
        Expr.UndefLit => {
            return JSValue.Undefined
        }
        Expr.Ident(name) => {
            match scopeTryLookup(st, scope, name) {
                Option.Some(v) => {
                    return v
                }
                Option.None => {
                    // reading an undeclared identifier is a ReferenceError in JS;
                    // without this a typo just evaluates to undefined and the
                    // failure surfaces somewhere else entirely
                    // `this` is never a ReferenceError — unbound at module top
                    // level it is simply undefined, and CommonJS code reads it
                    // freely
                    if name != "this" {
                        st.throwing = true
                        st.thrownValue = makeError(st, "ReferenceError", name.clone() + " is not defined")
                    }
                    return JSValue.Undefined
                }
            }
        }
        Expr.Bin(op, a, b) => {
            // && and || short-circuit and yield the operand value, JS-style
            if op == "&&" {
                let va = evalExpr(prog, a, st, scope)
                if !truthy(va) {
                    return va
                }
                return evalExpr(prog, b, st, scope)
            }
            if op == "||" {
                let va = evalExpr(prog, a, st, scope)
                if truthy(va) {
                    return va
                }
                return evalExpr(prog, b, st, scope)
            }
            if op == "??" {
                // nullish coalescing: only null/undefined fall through
                let va = evalExpr(prog, a, st, scope)
                match va {
                    JSValue.Null => {
                        return evalExpr(prog, b, st, scope)
                    }
                    JSValue.Undefined => {
                        return evalExpr(prog, b, st, scope)
                    }
                    _ => {
                        return va
                    }
                }
            }
            if op == "in" {
                let kv = evalExpr(prog, a, st, scope)
                let ov = evalExpr(prog, b, st, scope)
                return evalInOperator(prog, toStr(kv), ov, st)
            }
            if op == "instanceof" {
                let lv = evalExpr(prog, a, st, scope)
                pushTemp(st, cloneValue(lv))
                let rv = evalExpr(prog, b, st, scope)
                popTemp(st)
                return JSValue.Bool(instanceOf(st, lv, rv))
            }
            let va = evalExpr(prog, a, st, scope)
            // evaluating the right operand can run user code and collect
            pushTemp(st, cloneValue(va))
            let vb = evalExpr(prog, b, st, scope)
            popTemp(st)
            // a BigInt operand takes a dedicated path: arbitrary-precision math,
            // its own mixing rules (BigInt + Number throws), and value equality
            if isBigIntVal(va) || isBigIntVal(vb) {
                return evalBigIntBin(op, va, vb, st)
            }
            // arithmetic/relational operators on an object operand need
            // interp-aware ToPrimitive (a Date valueOf's to its ms, arrays join,
            // objects call valueOf/toString). evalBin is a pure function with no
            // interp access, so do the coercion here. Gated on an object operand
            // to keep the hot number/string path free of overhead. Equality
            // (==/!=/===/!==) is excluded — it has its own object rules.
            let coerces = op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || op == "**" || op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" || op == ">>>" || op == "<" || op == ">" || op == "<=" || op == ">="
            if coerces && (objHandle(va) >= 0 || objHandle(vb) >= 0) {
                pushTemp(st, cloneValue(va))
                pushTemp(st, cloneValue(vb))
                // `+` uses the default hint (Date -> string); the arithmetic and
                // relational operators use the number hint (Date -> epoch ms).
                // Each operand coerced once, so a side-effecting valueOf runs once.
                var pa = JSValue.Undefined
                var pb = JSValue.Undefined
                if op == "+" {
                    pa = toPrimitiveDefault(prog, va, st)
                    pushTemp(st, cloneValue(pa))
                    pb = toPrimitiveDefault(prog, vb, st)
                    popTemp(st)
                } else {
                    pa = toPrimitiveNumber(prog, va, st)
                    pushTemp(st, cloneValue(pa))
                    pb = toPrimitiveNumber(prog, vb, st)
                    popTemp(st)
                }
                popTemp(st)
                popTemp(st)
                return evalBin(op, pa, pb)
            }
            return evalBin(op, va, vb)
        }
        Expr.Un(op, a) => {
            // delete needs the unevaluated target, not its value
            if op == "delete" {
                return evalDelete(prog, a, st, scope)
            }
            // typeof is the one context where an undeclared name is legal
            if op == "typeof" {
                match prog.exprs[a.index] {
                    Expr.Ident(iname) => {
                        if !scopeHas(st, scope, iname) {
                            return JSValue.Str("undefined")
                        }
                    }
                    _ => {
                    }
                }
            }
            let va = evalExpr(prog, a, st, scope)
            if op == "-" {
                // BigInt negation stays a BigInt; unary + on a BigInt throws in JS
                if isBigIntVal(va) {
                    return JSValue.BigInt(bnNeg(bigStrOf(va)))
                }
                // negate, don't subtract from zero: 0.0 - 0.0 is +0, so `-0`
                // lost its sign and Object.is(0, -0) came out true
                return JSValue.Number(-toNum(va))
            }
            if op == "~" && isBigIntVal(va) {
                // ~x on a BigInt is -(x+1); exact and cheap without full bitwise
                return JSValue.BigInt(bnSub(bnNeg(bigStrOf(va)), "1"))
            }
            if op == "typeof" {
                // a bind() result is an object internally but a function to JS
                let th = objHandle(va)
                if th >= 0 && (st.objects[th].isBound || st.objects[th].isFunctionLike) {
                    return JSValue.Str("function")
                }
                // symbols are unique strings internally; typeof still says symbol
                if isSymbolValue(va) {
                    return JSValue.Str("symbol")
                }
                return JSValue.Str(typeofStr(va))
            }
            if op == "void" {
                return JSValue.Undefined
            }
            if op == "await" {
                return awaitValue(prog, va, st)
            }
            if op == "yield" {
                return genYield(va, st)
            }
            if op == "yield*" {
                // Delegate: drive the operand's iterator, re-yielding each value to
                // our own consumer. The value of `yield* it` is the inner
                // iterator's return value (the value carried by its {done:true}).
                let vh = objHandle(va)
                var last = JSValue.Undefined
                if vh >= 0 && st.objects[vh].isGenerator {
                    // inner generator: drive genResume directly (its next/throw/
                    // return are native methods, not stored properties)
                    var guard: i64 = 0
                    // how to resume the inner on the next turn: 0 next, 1 throw,
                    // 2 return — mirrors what our own consumer did to US
                    var mode: i64 = 0
                    var sendVal = JSValue.Undefined
                    while !st.throwing && guard < 100000000 {
                        guard = guard + 1
                        var nA: Vec<JSValue> = Vec.new()
                        nA.push(cloneValue(sendVal))
                        let step = genResume(vh, nA, mode, st)
                        let sh = objHandle(step)
                        if st.throwing || sh < 0 {
                            // the inner did not handle it (or has no record left);
                            // the completion keeps unwinding through us
                            guard = 100000000
                        } else if truthy(getMemberDyn(prog, sh, "done", st)) {
                            last = getMemberDyn(prog, sh, "value", st)
                            if mode == 2 {
                                // the inner finished closing — pick our own
                                // return-unwind back up where it was interrupted
                                st.throwing = true
                                st.genReturning = true
                                st.thrownValue = cloneValue(last)
                            }
                            guard = 100000000
                        } else {
                            let v = getMemberDyn(prog, sh, "value", st)
                            if st.throwing {
                                // the value getter threw: do NOT hand the
                                // undefined it left behind to our consumer
                                guard = 100000000
                                continue
                            }
                            let sent = genYield(v, st)
                            mode = 0
                            sendVal = cloneValue(sent)
                            if st.throwing {
                                // Our consumer called throw()/return() while we
                                // were parked in this delegation. yield* hands the
                                // completion to the INNER iterator first, so its
                                // own catch/finally runs; whatever the inner then
                                // does is what continues outward. Without this the
                                // inner generator stayed parked and its finally
                                // never ran.
                                mode = 1
                                if st.genReturning {
                                    mode = 2
                                }
                                sendVal = cloneValue(st.thrownValue)
                                st.throwing = false
                                st.genReturning = false
                                st.thrownValue = JSValue.Undefined
                            }
                        }
                    }
                    return last
                }
                // any other iterable: resolve [Symbol.iterator] and drive next().
                // Guarded on vh: a primitive (`yield* "hi"`) has handle -1, and
                // getMemberDyn indexed st.objects with it and trapped.
                var iter = cloneValue(va)
                if vh >= 0 {
                    let itFn = getMemberDyn(prog, vh, symIteratorKey(), st)
                    if isCallableIn(st, itFn) {
                        var noArgs: Vec<JSValue> = Vec.new()
                        iter = callValue(prog, itFn, noArgs, cloneValue(va), st)
                    }
                }
                var drove = false
                let ih = objHandle(iter)
                if ih >= 0 && isCallableIn(st, getMemberDyn(prog, ih, "next", st)) {
                    drove = true
                    pushTemp(st, cloneValue(iter))
                    var guard2: i64 = 0
                    // same completion forwarding as the generator branch above,
                    // through the iterator's own next/throw/return properties
                    var mode2: i64 = 0
                    var sendVal2 = JSValue.Undefined
                    while !st.throwing && guard2 < 100000000 {
                        guard2 = guard2 + 1
                        var mname = "next"
                        if mode2 == 1 {
                            mname = "throw"
                        }
                        if mode2 == 2 {
                            mname = "return"
                        }
                        let stepFn = getMemberDyn(prog, objHandle(iter), mname, st)
                        if !isCallableIn(st, stepFn) {
                            // the iterator does not implement this completion, so
                            // there is nothing to close — resume our own unwind
                            if mode2 == 1 {
                                st.throwing = true
                                st.thrownValue = cloneValue(sendVal2)
                            } else if mode2 == 2 {
                                st.throwing = true
                                st.genReturning = true
                                st.thrownValue = cloneValue(sendVal2)
                            }
                            guard2 = 100000000
                        } else {
                            var nArgs: Vec<JSValue> = Vec.new()
                            nArgs.push(cloneValue(sendVal2))
                            let step = callValue(prog, stepFn, nArgs, cloneValue(iter), st)
                            let sh = objHandle(step)
                            if st.throwing || sh < 0 {
                                guard2 = 100000000
                            } else if truthy(getMemberDyn(prog, sh, "done", st)) {
                                last = getMemberDyn(prog, sh, "value", st)
                                if mode2 == 2 {
                                    st.throwing = true
                                    st.genReturning = true
                                    st.thrownValue = cloneValue(last)
                                }
                                guard2 = 100000000
                            } else {
                                let v = getMemberDyn(prog, sh, "value", st)
                                if st.throwing {
                                    guard2 = 100000000
                                    continue
                                }
                                let sent = genYield(v, st)
                                mode2 = 0
                                sendVal2 = cloneValue(sent)
                                if st.throwing {
                                    mode2 = 1
                                    if st.genReturning {
                                        mode2 = 2
                                    }
                                    sendVal2 = cloneValue(st.thrownValue)
                                    st.throwing = false
                                    st.genReturning = false
                                    st.thrownValue = JSValue.Undefined
                                }
                            }
                        }
                    }
                    popTemp(st)
                }
                if !drove {
                    // A string, or a native Map/Set: neither exposes a `next`
                    // through the prototype chain yet, so the loop above cannot
                    // drive them and `yield* new Set(...)` silently yielded
                    // nothing. spreadInto already knows every built-in iterable,
                    // so borrow it. Eager, unlike the loop above — only
                    // observable for an infinite inner iterator, which none of
                    // these shapes can be. Their completion value is undefined,
                    // so `last` correctly stays Undefined.
                    var items: Vec<JSValue> = Vec.new()
                    spreadInto(prog, items, cloneValue(va), st)
                    // hold the values in a rooted array: genYield parks this task,
                    // and a collect while it is parked would sweep anything the
                    // plain Vec is the only reference to
                    let hold = newArray(st)
                    pushTemp(st, JSValue.Obj(hold))
                    var hi: i64 = 0
                    while hi < items.len() {
                        arrPush(st, hold, cloneValue(items[hi]))
                        hi = hi + 1
                    }
                    var k: i64 = 0
                    while !st.throwing && k < arrLen(st, hold) {
                        let _sent = genYield(arrGet(st, hold, k), st)
                        k = k + 1
                    }
                    popTemp(st)
                }
                return last
            }
            if op == "+" {
                // unary plus is ToNumber, which ToPrimitive(number)s an object
                // first (so +new Date(0) is its epoch ms, not NaN)
                if objHandle(va) >= 0 {
                    return JSValue.Number(toNum(toPrimitiveNumber(prog, va, st)))
                }
                return JSValue.Number(toNum(va))
            }
            if op == "~" {
                let r = (0 - toInt32(va)) - 1
                return JSValue.Number(r as f64)
            }
            return JSValue.Bool(!truthy(va))
        }
        Expr.Assign(name, e) => {
            let v = evalExpr(prog, e, st, scope)
            scopeAssign(st, scope, name.clone(), cloneValue(v))
            return v
        }
        Expr.Call(callee, argsIdx) => {
            return evalCall(prog, callee, argsIdx, st, scope)
        }
        Expr.Member(objIdx, name) => {
            let ov = evalExpr(prog, objIdx, st, scope)
            // a preceding `?.` in this chain short-circuited: the whole chain,
            // including this member access, is undefined
            if st.optShort {
                return JSValue.Undefined
            }
            match ov {
                JSValue.Obj(o) => {
                    return getMemberDyn(prog, o, name, st)
                }
                JSValue.Number(_nv) => {
                    if name == "__proto__" {
                        let npp = primitiveProtoHandle(st, ov)
                        if npp >= 0 {
                            return JSValue.Obj(npp)
                        }
                    }
                    // number primitives answer these by dispatch; without this a
                    // read yields undefined, which breaks feature detection
                    if isPrimitiveMethodName(name) {
                        return makeBoundMethod(st, cloneValue(ov), name.clone())
                    }
                    return JSValue.Undefined
                }
                JSValue.Bool(_bv) => {
                    if name == "__proto__" {
                        let bpp = primitiveProtoHandle(st, ov)
                        if bpp >= 0 {
                            return JSValue.Obj(bpp)
                        }
                    }
                    if isPrimitiveMethodName(name) {
                        return makeBoundMethod(st, cloneValue(ov), name.clone())
                    }
                    return JSValue.Undefined
                }
                JSValue.Str(s) => {
                    if name == "__proto__" {
                        let sp = primitiveProtoHandle(st, JSValue.Str(s.clone()))
                        if sp >= 0 {
                            return JSValue.Obj(sp)
                        }
                    }
                    return stringPrimitiveMember(st, s, name)
                }
                JSValue.Func(fIdx, fe) => {
                    if name == "prototype" {
                        return JSValue.Obj(getFuncProto(st, fIdx))
                    }
                    // `fn.constructor === Function`: functions are not objects in
                    // this value model, so nothing linked them to Function.
                    if name == "constructor" {
                        let statics1 = getFuncStatics(st, fIdx, fe)
                        if objOwnIndex(st, statics1, name) < 0 {
                            return JSValue.Native(NATIVE_FUNCTION_CTOR)
                        }
                    }
                    // fn.call / fn.apply / fn.bind as VALUES. They already work
                    // when invoked directly; this is the extraction form real
                    // bundles use (var slice = Array.prototype.slice; slice.call).
                    if name == "call" || name == "apply" || name == "bind" {
                        let statics0 = getFuncStatics(st, fIdx, fe)
                        if objOwnIndex(st, statics0, name) < 0 {
                            return makeBoundMethod(st, JSValue.Func(fIdx, fe), name.clone())
                        }
                    }
                    if name == "length" {
                        return JSValue.Number(funcArity(prog, fIdx) as f64)
                    }
                    if name == "name" {
                        return JSValue.Str(prog.funcs[fIdx].name.clone())
                    }
                    let statics = getFuncStatics(st, fIdx, fe)
                    // getMemberDyn, not getMember: a `static get v()` is stored on
                    // the statics object as an accessor, and the plain read never
                    // invoked it — every static getter returned undefined
                    return getMemberDyn(prog, statics, name, st)
                }
                JSValue.Native(nid) => {
                    let bag = getNativeProps(st, nid)
                    if name == "name" && objOwnIndex(st, bag, "name") < 0 {
                        let nn = nativeCtorName(nid)
                        if nn.len() > 0 {
                            return JSValue.Str(nn)
                        }
                    }
                    return getMember(st, bag, name)
                }
                JSValue.Null => {
                    return throwNullMember(st, name, "null")
                }
                JSValue.Undefined => {
                    return throwNullMember(st, name, "undefined")
                }
                _ => {
                    return JSValue.Undefined
                }
            }
        }
        Expr.Index(objIdx, keyIdx) => {
            let ov = evalExpr(prog, objIdx, st, scope)
            // a preceding `?.` short-circuited this chain
            if st.optShort {
                return JSValue.Undefined
            }
            // the key expression can run user code and collect the base
            pushTemp(st, cloneValue(ov))
            let kv = evalExpr(prog, keyIdx, st, scope)
            popTemp(st)
            let key = toStr(kv)
            match ov {
                JSValue.Obj(o) => {
                    // buf[i] indexes a Buffer's bytes (it is a plain object, not a
                    // Uint8Array, so the numeric property is not otherwise present)
                    let bidx = asArrayIndex(key)
                    if bidx >= 0 {
                        let nv = bufferNativeViewHandle(st, o)
                        if nv >= 0 {
                            return nativeBufferGet(st, nv, bidx)
                        }
                        let bh = bufferBytesHandle(st, o)
                        if bh >= 0 {
                            return arrGet(st, bh, bidx)
                        }
                    }
                    return getMemberDyn(prog, o, key, st)
                }
                JSValue.Func(fIdx, fe) => {
                    // computed read of a property assigned onto a function, e.g.
                    // statuses[404] after statuses[code] = message
                    if key == "prototype" {
                        return JSValue.Obj(getFuncProto(st, fIdx))
                    }
                    let statics = getFuncStatics(st, fIdx, fe)
                    if (key == "call" || key == "apply" || key == "bind") && objOwnIndex(st, statics, key) < 0 {
                        return makeBoundMethod(st, JSValue.Func(fIdx, fe), key.clone())
                    }
                    return getMember(st, statics, key)
                }
                JSValue.Native(nid) => {
                    let bag = getNativeProps(st, nid)
                    if (key == "call" || key == "apply" || key == "bind") && objOwnIndex(st, bag, key) < 0 {
                        return makeBoundMethod(st, JSValue.Native(nid), key.clone())
                    }
                    if key == "name" && objOwnIndex(st, bag, "name") < 0 {
                        let nn = nativeCtorName(nid)
                        if nn.len() > 0 {
                            return JSValue.Str(nn)
                        }
                    }
                    return getMember(st, bag, key)
                }
                JSValue.Str(s) => {
                    // s["slice"] is the METHOD, not s[NaN] — asArrayIndex rejects
                    // non-numeric keys, which toNum would have coerced to 0
                    if asArrayIndex(key) < 0 {
                        return stringPrimitiveMember(st, s, key)
                    }
                    // s[i] → the i-th UTF-16 code unit as a string (charAt
                    // semantics), or undefined out of range — not a raw byte
                    let i = toNum(kv) as i64
                    if i >= 0 && i < utf16Length(s) {
                        return JSValue.Str(utf16Slice(s, i, i + 1))
                    }
                    return JSValue.Undefined
                }
                JSValue.Null => {
                    return throwNullMember(st, key, "null")
                }
                JSValue.Undefined => {
                    return throwNullMember(st, key, "undefined")
                }
                _ => {
                    return JSValue.Undefined
                }
            }
        }
        Expr.SetMember(objIdx, keyIdx, valIdx) => {
            let ov = evalExpr(prog, objIdx, st, scope)
            // both key and value can run user code, so the target stays rooted
            // across both — else obj[f()] = g() writes into a reused slot
            pushTemp(st, cloneValue(ov))
            let kv = evalExpr(prog, keyIdx, st, scope)
            let key = toStr(kv)
            let v = evalExpr(prog, valIdx, st, scope)
            popTemp(st)
            match ov {
                JSValue.Obj(o) => {
                    // buf[i] = n writes the byte (masked to 0-255) into the
                    // Buffer's backing array, matching Uint8Array assignment
                    let bwidx = asArrayIndex(key)
                    if bwidx >= 0 {
                        let nv = bufferNativeViewHandle(st, o)
                        if nv >= 0 && nativeBufferSet(st, nv, bwidx, toNum(v)) {
                            return cloneValue(v)
                        }
                        let bh = bufferBytesHandle(st, o)
                        if bh >= 0 && bwidx < st.objects[bh].elems.len() {
                            let byte = (toNum(v) as i64) & 255
                            st.objects[bh].elems[bwidx] = JSValue.Number(byte as f64)
                            return cloneValue(v)
                        }
                    }
                    setMemberDyn(prog, o, key, cloneValue(v), st)
                }
                JSValue.Native(nid) => {
                    // assigning onto a builtin constructor, e.g.
                    // Error.captureStackTrace = fn. setMemberDyn, not objSet, so
                    // a non-writable property (every built-in `prototype`) drops
                    // the write instead of silently replacing itself.
                    let bag = getNativeProps(st, nid)
                    setMemberDyn(prog, bag, key, cloneValue(v), st)
                }
                JSValue.Func(sf, senv) => {
                    if key == "prototype" {
                        // `Child.prototype = Object.create(Parent.prototype)` —
                        // the ES5 inheritance idiom. Replacing the prototype
                        // object is what makes instances inherit from Parent.
                        let newProto = objHandle(v)
                        if newProto >= 0 {
                            while st.funcProtos.len() <= sf {
                                st.funcProtos.push(-1)
                            }
                            st.funcProtos[sf] = newProto
                        }
                    } else {
                        let statics = getFuncStatics(st, sf, senv)
                        // setMemberDyn, not objSet: a `static set x(v)` accessor
                        // has to be invoked, and objSet would replace it with a
                        // plain data property
                        setMemberDyn(prog, statics, key, cloneValue(v), st)
                    }
                }
                _ => {
                }
            }
            return v
        }
        Expr.ClassExpr(classIdx) => {
            return instantiateClass(prog, classIdx, st, scope)
        }
        Expr.ObjLit(litIdx) => {
            let obj = newObject(st)
            // root the part-built object so a GC while evaluating later property
            // values (a value may be a call) can't reclaim it
            pushTemp(st, JSValue.Obj(obj))
            var i: i64 = 0
            let n = prog.objLits[litIdx.index].len()
            while i < n {
                var key = prog.objLits[litIdx.index][i].key.clone()
                match prog.objLits[litIdx.index][i].keyExpr {
                    Option.Some(keyExprId) => {
                        key = toStr(evalExpr(prog, keyExprId, st, scope))
                    }
                    Option.None => {
                    }
                }
                let valIdx = prog.objLits[litIdx.index][i].val
                let v = evalExpr(prog, valIdx, st, scope)
                let propKind = prog.objLits[litIdx.index][i].kind
                if propKind > 0 {
                    // a getter and setter for the same key share one property
                    let existing = objOwnIndex(st, obj, key)
                    var g = JSValue.Undefined
                    var sfn = JSValue.Undefined
                    if existing >= 0 && propIsAccessor(st, obj, existing) {
                        g = accGetter(st, st.objects[obj].props[existing].acc)
                        sfn = accSetter(st, st.objects[obj].props[existing].acc)
                    }
                    if propKind == 1 {
                        g = v
                    } else {
                        sfn = v
                    }
                    objDefineAccessor(st, obj, key, g, sfn)
                } else if key == "..." {
                    let src = objHandle(v)
                    if src >= 0 {
                        if st.objects[src].isArray {
                            var e: i64 = 0
                            let ne = arrLen(st, src)
                            while e < ne {
                                objSet(st, obj, i64ToStr(e), arrGet(st, src, e))
                                e = e + 1
                            }
                        }
                        let order = enumOrder(st, src)
                        var oi: i64 = 0
                        while oi < order.len() {
                            let k = order[oi]
                            oi = oi + 1
                            if !st.objects[src].props[k].enumerable {
                                continue
                            }
                            let pk = st.objects[src].props[k].key.clone()
                            // spread copies the VALUE of an accessor, so invoke the
                            // getter rather than copying the (unused) value slot
                            var pv = JSValue.Undefined
                            if propIsAccessor(st, src, k) {
                                pv = getMemberDyn(prog, src, pk, st)
                            } else {
                                pv = cloneValue(st.objects[src].props[k].value)
                            }
                            objSet(st, obj, pk, pv)
                        }
                    }
                } else {
                    objSet(st, obj, key, v)
                }
                i = i + 1
            }
            popTemp(st)
            return JSValue.Obj(obj)
        }

        Expr.ToStrHole(inner) => {
            let hv = evalExpr(prog, inner, st, scope)
            if st.throwing {
                return JSValue.Undefined
            }
            // String(sym) is legal, `${sym}` is not — the template's implicit
            // ToString has no symbol case, so it throws where String() does not
            match cloneValue(hv) {
                JSValue.Str(hs) => {
                    if isSymbolStr(hs) {
                        st.throwing = true
                        st.thrownValue = makeError(st, "TypeError", "Cannot convert a Symbol value to a string")
                        return JSValue.Undefined
                    }
                }
                _ => {
                }
            }
            return JSValue.Str(toStrProg(prog, hv, st))
        }
        Expr.TemplateStrings(litIdx, rawIdx) => {
            // cooked chunks, plus the parallel un-escaped chunks as `raw`
            let arr = newArray(st)
            pushTemp(st, JSValue.Obj(arr))
            let rawArr = newArray(st)
            pushTemp(st, JSValue.Obj(rawArr))
            var ti: i64 = 0
            while ti < prog.arrLits[litIdx.index].len() {
                let v = evalExpr(prog, prog.arrLits[litIdx.index][ti]!, st, scope)
                arrPush(st, arr, v)
                let rv = evalExpr(prog, prog.arrLits[rawIdx.index][ti]!, st, scope)
                arrPush(st, rawArr, rv)
                ti = ti + 1
            }
            objSet(st, arr, "raw", JSValue.Obj(rawArr))
            popTemp(st)
            popTemp(st)
            return JSValue.Obj(arr)
        }
        Expr.ArrLit(litIdx) => {
            let arr = newArray(st)
            // root the part-built array so a GC while evaluating later elements
            // (an element may be a call) can't reclaim it
            pushTemp(st, JSValue.Obj(arr))
            var i: i64 = 0
            let n = prog.arrLits[litIdx.index].len()
            while i < n {
                match prog.arrLits[litIdx.index][i] {
                    Option.None => {
                    let at = arrLen(st, arr)
                    arrPush(st, arr, JSValue.Undefined)
                    arrMarkHole(st, arr, at)
                    }
                    Option.Some(elemIdx) => {
                    match prog.exprs[elemIdx.index] {
                        Expr.Spread(inner) => {
                        let sv = evalExpr(prog, inner, st, scope)
                        var tmp: Vec<JSValue> = Vec.new()
                        spreadInto(prog, tmp, sv, st)
                        var t: i64 = 0
                        while t < tmp.len() {
                            arrPush(st, arr, cloneValue(tmp[t]))
                            t = t + 1
                        }
                    }
                        _ => {
                            let v = evalExpr(prog, elemIdx, st, scope)
                            arrPush(st, arr, v)
                        }
                    }
                    }
                }
                i = i + 1
            }
            popTemp(st)
            return JSValue.Obj(arr)
        }
        Expr.New(calleeIdx, argsIdx) => {
            let calleeVal = evalExpr(prog, calleeIdx, st, scope)
            // a throw while resolving the constructor expression must propagate:
            // continuing here replaced the real error with "value is not a
            // constructor", which pointed at the wrong line entirely
            if st.throwing {
                return JSValue.Undefined
            }
            // `new Promise(executor)` runs its executor immediately with a
            // resolve/reject pair bound to the new promise. Handled here rather
            // than in callNative because the executor is a user function and
            // needs the program to run.
            let ah = objHandle(calleeVal)
            if ah >= 0 && st.arrayCtorObj >= 0 && ah == st.arrayCtorObj {
                let argVals = evalArgs(prog, argsIdx, st, scope)
                return makeArrayFromCtor(st, argVals)
            }
            let ph = objHandle(calleeVal)
            if ph >= 0 && isPromiseCtor(st, ph) {
                let argVals = evalArgs(prog, argsIdx, st, scope)
                let pr = newPromise(st, 0, JSValue.Undefined)
                pushTemp(st, JSValue.Obj(pr))
                if argVals.len() > 0 {
                    var exArgs: Vec<JSValue> = Vec.new()
                    exArgs.push(JSValue.Native(NATIVE_RESOLVER_BASE + pr * 2))
                    exArgs.push(JSValue.Native(NATIVE_RESOLVER_BASE + pr * 2 + 1))
                    let _ = callValue(prog, argVals[0], exArgs, JSValue.Undefined, st)
                    if st.throwing {
                        let err = cloneValue(st.thrownValue)
                        st.throwing = false
                        st.thrownValue = JSValue.Undefined
                        if st.objects[pr].promiseState == 0 {
                            st.objects[pr].promiseState = 2
                            st.objExtras[st.objects[pr].extra].promiseValue = err
                        }
                    }
                }
                popTemp(st)
                return JSValue.Obj(pr)
            }
            match calleeVal {
                JSValue.Func(fIdx, envIdx) => {
                    pushTemp(st, JSValue.Func(fIdx, envIdx))
                    let argVals = evalArgs(prog, argsIdx, st, scope)
                    let obj = newObject(st)
                    // record the constructor (for instanceof) and link the
                    // instance to the constructor's prototype (for shared methods)
                    st.objects[obj].ctor = fIdx
                    let proto = getFuncProto(st, fIdx)
                    linkProtoConstructor(st, proto, fIdx, envIdx)
                    st.objects[obj].proto = proto
                    pushTemp(st, JSValue.Obj(obj))
                    st.newTarget = JSValue.Func(fIdx, envIdx)
                    let result = callFunction(prog, fIdx, envIdx, argVals, JSValue.Obj(obj), st)
                    st.newTarget = JSValue.Undefined
                    popTemp(st)
                    popTemp(st)
                    // A constructor that returns an object OR a function replaces
                    // the new instance. express's Router is a factory that returns
                    // an inner function; discarding it yielded an empty object.
                    match result {
                        JSValue.Obj(r) => {
                            return JSValue.Obj(r)
                        }
                        JSValue.Func(rf, renv) => {
                            return JSValue.Func(rf, renv)
                        }
                        _ => {
                            return JSValue.Obj(obj)
                        }
                    }
                }
                JSValue.Native(nativeId) => {
                    let argVals = evalArgs(prog, argsIdx, st, scope)
                    // Called as a function these three coerce; called with `new`
                    // they BOX. Ignoring `new` made `new Boolean(false)` falsy
                    // and `typeof new String("")` report "string".
                    if nativeId == NATIVE_STRING || nativeId == NATIVE_NUMBER || nativeId == NATIVE_BOOLEAN {
                        let prim = callNativeProg(prog, nativeId, argVals, st)
                        if st.throwing {
                            return JSValue.Undefined
                        }
                        return makeWrapper(st, prim)
                    }
                    return callNativeProg(prog, nativeId, argVals, st)
                }
                JSValue.Obj(co) => {
                    if st.objects[co].isProxy {
                        let trap = proxyTrap(st, co, "construct")
                        let target = cloneValue(st.objExtras[st.objects[co].extra].proxyTarget)
                        let argVals = evalArgs(prog, argsIdx, st, scope)
                        if isCallableIn(st, trap) {
                            // construct(target, argsArray, newTarget)
                            let arr = newArray(st)
                            var ai: i64 = 0
                            while ai < argVals.len() {
                                st.objects[arr].elems.push(cloneValue(argVals[ai]))
                                ai = ai + 1
                            }
                            var targs: Vec<JSValue> = Vec.new()
                            targs.push(cloneValue(target))
                            targs.push(JSValue.Obj(arr))
                            targs.push(JSValue.Obj(co))
                            return callValue(prog, trap, targs, cloneValue(st.objExtras[st.objects[co].extra].proxyHandler), st)
                        }
                        // no construct trap: build the instance ourselves and run
                        // the target as its constructor, matching `new target()`
                        let inst = newObject(st)
                        let th = objHandle(target)
                        if th >= 0 {
                            match objGet(st, th, "prototype") {
                                JSValue.Obj(pr) => {
                                    st.objects[inst].proto = pr
                                }
                                _ => {
                                }
                            }
                        }
                        pushTemp(st, JSValue.Obj(inst))
                        let cr = callValue(prog, target, argVals, JSValue.Obj(inst), st)
                        popTemp(st)
                        match cr {
                            JSValue.Obj(ro) => {
                                return JSValue.Obj(ro)
                            }
                            _ => {
                                return JSValue.Obj(inst)
                            }
                        }
                    }
                    // a class defined by a node-api addon (napi_define_class): build
                    // the instance here and link its prototype, then let the addon's
                    // constructor callback populate it — typically via napi_wrap.
                    // `new` on a bind() result constructs the TARGET, with the
                    // pre-bound arguments in front and the bound `this` ignored
                    // — the spec's [[Construct]] on a bound function. It fell
                    // through to "value is not a constructor".
                    if st.objects[co].isBound {
                        let bex = st.objects[co].extra
                        let btarget = cloneValue(st.objExtras[bex].boundTarget)
                        let callArgs = evalArgs(prog, argsIdx, st, scope)
                        var nargs: Vec<JSValue> = Vec.new()
                        var bj: i64 = 0
                        while bj < st.objExtras[bex].boundArgs.len() {
                            nargs.push(cloneValue(st.objExtras[bex].boundArgs[bj]))
                            bj = bj + 1
                        }
                        var cj: i64 = 0
                        while cj < callArgs.len() {
                            nargs.push(cloneValue(callArgs[cj]))
                            cj = cj + 1
                        }
                        match btarget {
                            JSValue.Func(tf, te) => {
                                let binst = newObject(st)
                                st.objects[binst].ctor = tf
                                let bproto = getFuncProto(st, tf)
                                linkProtoConstructor(st, bproto, tf, te)
                                st.objects[binst].proto = bproto
                                pushTemp(st, JSValue.Obj(binst))
                                st.newTarget = JSValue.Func(tf, te)
                                let bres = callFunction(prog, tf, te, nargs, JSValue.Obj(binst), st)
                                st.newTarget = JSValue.Undefined
                                popTemp(st)
                                match bres {
                                    JSValue.Obj(br) => {
                                        return JSValue.Obj(br)
                                    }
                                    JSValue.Func(brf, bre) => {
                                        return JSValue.Func(brf, bre)
                                    }
                                    _ => {
                                        return JSValue.Obj(binst)
                                    }
                                }
                            }
                            _ => {
                                return callValue(prog, btarget, nargs, JSValue.Undefined, st)
                            }
                        }
                    }
                    if st.objExtras[st.objects[co].extra].napiFn >= 0 {
                        let argVals = evalArgs(prog, argsIdx, st, scope)
                        let inst = newObject(st)
                        match objGet(st, co, "prototype") {
                            JSValue.Obj(pr) => {
                                st.objects[inst].proto = pr
                            }
                            _ => {
                            }
                        }
                        pushTemp(st, JSValue.Obj(inst))
                        let r = napiInvoke(st.objExtras[st.objects[co].extra].napiFn, argVals, JSValue.Obj(inst))
                        popTemp(st)
                        match r {
                            JSValue.Obj(ro) => {
                                return JSValue.Obj(ro)
                            }
                            _ => {
                                return JSValue.Obj(inst)
                            }
                        }
                    }
                    st.throwing = true
                    st.thrownValue = makeError(st, "TypeError", "value is not a constructor" + currentModule(st))
                    return JSValue.Undefined
                }
                _ => {
                    st.throwing = true
                    st.thrownValue = makeError(st, "TypeError", "value is not a constructor" + currentModule(st))
                    return JSValue.Undefined
                }
            }
        }
        Expr.Update(targetIdx, isInc, isPrefix) => {
            let old = readLValue(prog, targetIdx, st, scope)
            // a BigInt counter increments by 1n and stays a BigInt (x++ on 5n
            // must yield 5n / store 6n, not coerce through f64)
            if isBigIntVal(old) {
                var op = "+"
                if !isInc {
                    op = "-"
                }
                let updated = evalBigIntBin(op, cloneValue(old), JSValue.BigInt("1"), st)
                writeLValue(prog, targetIdx, st, scope, cloneValue(updated))
                if isPrefix {
                    return updated
                }
                return old
            }
            let oldNum = toNum(old)
            var newNum = oldNum + 1.0
            if !isInc {
                newNum = oldNum - 1.0
            }
            writeLValue(prog, targetIdx, st, scope, JSValue.Number(newNum))
            if isPrefix {
                return JSValue.Number(newNum)
            }
            // postfix yields the numeric value before the update (JS coerces)
            return JSValue.Number(oldNum)
        }
        Expr.CompoundAssign(targetIdx, op, rhsIdx) => {
            let cur = readLValue(prog, targetIdx, st, scope)
            let rhs = evalExpr(prog, rhsIdx, st, scope)
            // a BigInt operand takes the arbitrary-precision path, same as a
            // plain binary expression — evalBin would coerce it through f64
            let result = if isBigIntVal(cur) || isBigIntVal(rhs) {
                evalBigIntBin(op, cloneValue(cur), cloneValue(rhs), st)
            } else {
                evalBin(op, cur, rhs)
            }
            writeLValue(prog, targetIdx, st, scope, cloneValue(result))
            return result
        }
        Expr.LogicalAssign(targetIdx, op, rhsIdx) => {
            // short-circuit: read the target, and only evaluate + store the rhs
            // when the operator says an update is due (a ||= b assigns only when a
            // is falsy, &&= only when truthy, ??= only when null/undefined)
            let cur = readLValue(prog, targetIdx, st, scope)
            var doAssign = isNullish(cur)
            if op == "||" {
                doAssign = !truthy(cur)
            } else if op == "&&" {
                doAssign = truthy(cur)
            }
            if !doAssign {
                return cur
            }
            let rhs = evalExpr(prog, rhsIdx, st, scope)
            writeLValue(prog, targetIdx, st, scope, cloneValue(rhs))
            return rhs
        }
        Expr.DestructAssign(patIdx, rhsIdx) => {
            let rhs = evalExpr(prog, rhsIdx, st, scope)
            pushTemp(st, cloneValue(rhs))
            assignPattern(prog, patIdx, cloneValue(rhs), st, scope)
            popTemp(st)
            // the assignment expression evaluates to the whole rhs
            return rhs
        }
        Expr.Cond(c, a, b) => {
            let vc = evalExpr(prog, c, st, scope)
            if truthy(vc) {
                return evalExpr(prog, a, st, scope)
            }
            return evalExpr(prog, b, st, scope)
        }
        Expr.Spread(inner) => {
            // evaluated directly only in odd positions; flattening happens in
            // evalArgs / array literals
            return evalExpr(prog, inner, st, scope)
        }
        Expr.Comma(a, b) => {
            evalExpr(prog, a, st, scope)
            return evalExpr(prog, b, st, scope)
        }
        Expr.RegexLit(pat, flags) => {
            return makeRegex(st, pat.clone(), flags.clone())
        }
        Expr.OptChainRoot(inner) => {
            // scope the short-circuit flag to this chain: a nullish `?.` link
            // anywhere inside makes the whole chain undefined, and nested chains
            // (in args) mustn't leak their own short-circuit outward
            let saved = st.optShort
            st.optShort = false
            let v = evalExpr(prog, inner, st, scope)
            let shorted = st.optShort
            st.optShort = saved
            if shorted {
                return JSValue.Undefined
            }
            return v
        }
        Expr.OptCall(calleeIdx, argsIdx) => {
            // f?.(args): skip the call (result undefined) when f is nullish or an
            // earlier `?.` in the chain already short-circuited
            let calleeVal = evalExpr(prog, calleeIdx, st, scope)
            if st.optShort {
                return JSValue.Undefined
            }
            if isNullish(calleeVal) {
                st.optShort = true
                return JSValue.Undefined
            }
            pushTemp(st, cloneValue(calleeVal))
            let argVals = evalArgs(prog, argsIdx, st, scope)
            popTemp(st)
            return callValue(prog, calleeVal, argVals, JSValue.Undefined, st)
        }
        Expr.OptIndex(objIdx, keyIdx) => {
            let ov = evalExpr(prog, objIdx, st, scope)
            if st.optShort {
                return JSValue.Undefined
            }
            if isNullish(ov) {
                st.optShort = true
                return JSValue.Undefined
            }
            pushTemp(st, cloneValue(ov))
            let kv = evalExpr(prog, keyIdx, st, scope)
            popTemp(st)
            let key = toStr(kv)
            let o = objHandle(ov)
            if o >= 0 {
                return getMemberDyn(prog, o, key, st)
            }
            // non-nullish function/native base is a property carrier too
            match ov {
                JSValue.Func(fIdx, fe) => {
                    let statics = getFuncStatics(st, fIdx, fe)
                    return getMemberDyn(prog, statics, key, st)
                }
                JSValue.Native(nid) => {
                    return getMember(st, getNativeProps(st, nid), key)
                }
                _ => {
                    return JSValue.Undefined
                }
            }
        }
        Expr.OptMember(objIdx, name) => {
            let ov = evalExpr(prog, objIdx, st, scope)
            if st.optShort {
                return JSValue.Undefined
            }
            if isNullish(ov) {
                st.optShort = true
                return JSValue.Undefined
            }
            match ov {
                JSValue.Obj(o) => {
                    return getMemberDyn(prog, o, name, st)
                }
                JSValue.Number(_nv) => {
                    if name == "__proto__" {
                        let npp = primitiveProtoHandle(st, ov)
                        if npp >= 0 {
                            return JSValue.Obj(npp)
                        }
                    }
                    // number primitives answer these by dispatch; without this a
                    // read yields undefined, which breaks feature detection
                    if isPrimitiveMethodName(name) {
                        return makeBoundMethod(st, cloneValue(ov), name.clone())
                    }
                    return JSValue.Undefined
                }
                JSValue.Bool(_bv) => {
                    if name == "__proto__" {
                        let bpp = primitiveProtoHandle(st, ov)
                        if bpp >= 0 {
                            return JSValue.Obj(bpp)
                        }
                    }
                    if isPrimitiveMethodName(name) {
                        return makeBoundMethod(st, cloneValue(ov), name.clone())
                    }
                    return JSValue.Undefined
                }
                JSValue.Str(s) => {
                    if name == "__proto__" {
                        let sp = primitiveProtoHandle(st, JSValue.Str(s.clone()))
                        if sp >= 0 {
                            return JSValue.Obj(sp)
                        }
                    }
                    return stringPrimitiveMember(st, s, name)
                }
                JSValue.Func(fIdx, fe) => {
                    // a non-nullish function base reads like `.` does: a function
                    // is a property carrier (fn?._def, fn?.name). This was the
                    // missing case — @trpc's `procedure?._def.type`.
                    if name == "prototype" {
                        return JSValue.Obj(getFuncProto(st, fIdx))
                    }
                    if name == "constructor" {
                        let statics2 = getFuncStatics(st, fIdx, fe)
                        if objOwnIndex(st, statics2, name) < 0 {
                            return JSValue.Native(NATIVE_FUNCTION_CTOR)
                        }
                    }
                    if name == "length" {
                        return JSValue.Number(funcArity(prog, fIdx) as f64)
                    }
                    if name == "name" {
                        return JSValue.Str(prog.funcs[fIdx].name.clone())
                    }
                    let statics = getFuncStatics(st, fIdx, fe)
                    return getMemberDyn(prog, statics, name, st)
                }
                JSValue.Native(nid) => {
                    let bag = getNativeProps(st, nid)
                    if name == "name" && objOwnIndex(st, bag, "name") < 0 {
                        let nn = nativeCtorName(nid)
                        if nn.len() > 0 {
                            return JSValue.Str(nn)
                        }
                    }
                    return getMember(st, bag, name)
                }
                _ => {
                    return JSValue.Undefined
                }
            }
        }
        Expr.FuncExpr(f) => {
            return JSValue.Func(f, scope)
        }
    }
}

// Spread an array value's elements into `out` (a no-op for non-arrays).
// Spread any iterable: the built-ins directly, and anything carrying
// [Symbol.iterator] by driving its next(). Driving calls back into user code, so
// this needs the program and a mutable interpreter — which is why it is not the
// immutable helper it once was.
fn spreadInto(prog: &Prog, out: &mut Vec<JSValue>, v: &JSValue, st: &mut Interp) {
    let h = objHandle(v)
    // a String wrapper iterates as its string does, by code point. Its index
    // properties would make an array-like fallback plausible, but the spec
    // reaches String.prototype[@@iterator] through the chain, and that yields
    // whole characters rather than UTF-16 units.
    if h >= 0 && isWrapperObj(st, h) {
        match boxedPrimitive(st, h) {
            JSValue.Str(bs) => {
                if !isSymbolStr(bs) {
                    for cp in strCodePoints(bs) {
                        out.push(JSValue.Str(cp.clone()))
                    }
                    return
                }
            }
            _ => {
            }
        }
    }
    // typed arrays are iterable by element
    if h >= 0 && st.objExtras[st.objects[h].extra].taBuf >= 0 && !st.objects[h].isDataView {
        var i: i64 = 0
        while i < st.objExtras[st.objects[h].extra].taLen {
            out.push(JSValue.Number(taElem(st, h, i)))
            i = i + 1
        }
        return
    }
    // a generator drives through genNext (its `next` is native, not a property)
    if h >= 0 && st.objects[h].isGenerator {
        var guard: i64 = 0
        while !st.throwing && guard < 100000000 {
            guard = guard + 1
            var nA: Vec<JSValue> = Vec.new()
            let step = genNext(h, nA, st)
            let sh = objHandle(step)
            if sh < 0 || truthy(getMemberDyn(prog, sh, "done", st)) || st.throwing {
                guard = 100000000
            } else {
                out.push(getMemberDyn(prog, sh, "value", st))
                if st.throwing {
                    guard = 100000000
                }
            }
        }
        return
    }
    // a Map spreads to freshly built [key, value] pairs, which needs allocation
    if h >= 0 && st.objects[h].isMap {
        var mi: i64 = 0
        while mi < st.objExtras[st.objects[h].extra].mapKeys.len() {
            let pair = newArray(st)
            pushTemp(st, JSValue.Obj(pair))
            arrPush(st, pair, cloneValue(st.objExtras[st.objects[h].extra].mapKeys[mi]))
            arrPush(st, pair, cloneValue(st.objExtras[st.objects[h].extra].mapVals[mi]))
            popTemp(st)
            out.push(JSValue.Obj(pair))
            mi = mi + 1
        }
        return
    }
    if h >= 0 && !st.objects[h].isArray && !st.objects[h].isSet {
        let itFn = getMember(st, h, symIteratorKey())
        if isCallableIn(st, itFn) {
            var noArgs: Vec<JSValue> = Vec.new()
            let iter = callValue(prog, itFn, noArgs, cloneValue(v), st)
            pushTemp(st, cloneValue(iter))
            let ih = objHandle(iter)
            // `*[Symbol.iterator]() {}` hands back a GENERATOR, whose `next` is a
            // native method rather than a stored property, so the getMember below
            // finds nothing and the spread comes out empty. The generator branch
            // at the top of this function is exactly the driver it needs.
            if ih >= 0 && st.objects[ih].isGenerator && !st.throwing {
                spreadInto(prog, out, JSValue.Obj(ih), st)
                popTemp(st)
                return
            }
            var guard: i64 = 0
            while ih >= 0 && !st.throwing && guard < 100000000 {
                // guard was never incremented here, so this loop had no runaway
                // protection at all
                guard = guard + 1
                let nextFn = getMember(st, ih, "next")
                if !isCallableIn(st, nextFn) {
                    guard = 100000000
                } else {
                    var nArgs: Vec<JSValue> = Vec.new()
                    let step = callValue(prog, nextFn, nArgs, cloneValue(iter), st)
                    let sh = objHandle(step)
                    // getMemberDyn, not getMember: an iterator result may expose
                    // `done`/`value` as GETTERS, and the plain read never invoked
                    // them — a getter that throws (test262's
                    // set-iterator-value-failure) left done reading false for
                    // ever and the loop spun until the process was killed
                    if sh < 0 || truthy(getMemberDyn(prog, sh, "done", st)) || st.throwing {
                        guard = 100000000
                    } else {
                        out.push(getMemberDyn(prog, sh, "value", st))
                        if st.throwing {
                            guard = 100000000
                        }
                    }
                }
            }
            popTemp(st)
            return
        }
    }
    spreadBuiltin(out, v, st)
}

// A rooted array holding everything `v` iterates, or `v` unchanged when it is not
// a user iterable. The index-reading consumers (array destructuring, the Map/Set
// constructors) answer undefined for an object that has only [Symbol.iterator]
// and no indexed properties, so they materialize through here first.
//
// Divergence: the spec pulls exactly as many elements as the consumer needs, so
// an infinite iterator destructures fine there and spins here. Every eager path
// in this engine has that shape today (Array.from, spread); a lazy pull needs an
// element-count-limited driver, which spreadInto has no argument for.
fn iterableToArray(prog: &Prog, v: &JSValue, st: &mut Interp): JSValue {
    let h = objHandle(v)
    if h < 0 || st.objects[h].isArray {
        return cloneValue(v)
    }
    let drivable = st.objects[h].isGenerator || st.objects[h].isMap || st.objects[h].isSet
        || isCallableIn(st, getMember(st, h, symIteratorKey()))
    if !drivable {
        return cloneValue(v)
    }
    var items: Vec<JSValue> = Vec.new()
    spreadInto(prog, items, cloneValue(v), st)
    let arr = newArray(st)
    pushTemp(st, JSValue.Obj(arr))
    var i: i64 = 0
    while i < items.len() {
        arrPush(st, arr, cloneValue(items[i]))
        i = i + 1
    }
    popTemp(st)
    return JSValue.Obj(arr)
}

fn spreadBuiltin(out: &mut Vec<JSValue>, v: &JSValue, st: &Interp) {
    match v {
        JSValue.Obj(o) => {
            if st.objects[o].isArray {
                var k: i64 = 0
                let m = arrLen(st, o)
                while k < m {
                    out.push(arrGet(st, o, k))
                    k = k + 1
                }
            } else if st.objects[o].isSet {
                var k: i64 = 0
                while k < st.objExtras[st.objects[o].extra].mapKeys.len() {
                    out.push(cloneValue(st.objExtras[st.objects[o].extra].mapKeys[k]))
                    k = k + 1
                }
            }
        }
        JSValue.Str(s) => {
            // [..."café"] is ["c","a","f","é"] — code points, not UTF-8 bytes
            for cp in strCodePoints(s) {
                out.push(JSValue.Str(cp.clone()))
            }
        }
        _ => {
        }
    }
}

// `out` is a plain Milo local, invisible to the collector, but evaluating a later
// argument can run user code and therefore collect — so each finished argument is
// temp-rooted until the whole list is built. Without this, f([1,2], g()) can see
// the array swept and its slot reused while g() runs.
fn evalArgs(prog: &Prog, argsIdx: ArgListId, st: &mut Interp, scope: i64): Vec<JSValue> {
    var out: Vec<JSValue> = Vec.new()
    var rooted: i64 = 0
    var j: i64 = 0
    let n = prog.argLists[argsIdx.index].len()
    while j < n {
        let eIdx = prog.argLists[argsIdx.index][j]
        match prog.exprs[eIdx.index] {
            Expr.Spread(inner) => {
                let v = evalExpr(prog, inner, st, scope)
                pushTemp(st, cloneValue(v))
                rooted = rooted + 1
                spreadInto(prog, out, v, st)
            }
            _ => {
                let v = evalExpr(prog, eIdx, st, scope)
                pushTemp(st, cloneValue(v))
                rooted = rooted + 1
                out.push(v)
            }
        }
        j = j + 1
    }
    // the caller binds these into a scope before the next safepoint, so the
    // temp roots can be released here
    var r: i64 = 0
    while r < rooted {
        popTemp(st)
        r = r + 1
    }
    return out
}

fn spaces(n: i64): string {
    var s = ""
    var i: i64 = 0
    while i < n {
        s = s + " "
        i = i + 1
    }
    return s
}

// console.log's value rendering, reproducing node's `util.inspect` defaults
// (depth 2, breakLength 80, compact 3) rather than bun's. The algorithm is
// node's: render every entry, then decide layout — one line when the entries
// fit inside breakLength, otherwise one per line at the parent indent + 2 with
// NO trailing comma. Arrays of more than six entries are first laid out in
// columns by inspectGroupArray, exactly as node's groupArrayElements does.
//
// Why mirror node this closely: every .expected in tests/ is a byte-exact node
// capture, so any divergence here is a divergence in 17 fixtures at once.
fn inspBreakLength(): i64 {
    return 80
}


fn mjInspectHexUpper(v: i64): u8 {
    if v < 10 {
        return ('0' as i64 + v) as u8
    }
    return ('A' as i64 + (v - 10)) as u8
}

// node's strEscape: a nested string is single-quoted, switching to double when
// it contains a single quote and no double, and to a backtick when it contains
// both. Control characters become \n / \t / \r / \b / \f or \xNN (upper-case
// hex, as node's escape table spells it).
fn inspectQuoteStr(s: &string): string {
    var hasSingle = false
    var hasDouble = false
    var hasBack = false
    var i: i64 = 0
    while i < s.len() {
        let c = s[i]
        if c == 39 as u8 {
            hasSingle = true
        }
        if c == 34 as u8 {
            hasDouble = true
        }
        if c == 96 as u8 {
            hasBack = true
        }
        i = i + 1
    }
    var q = 39 as u8
    if hasSingle {
        if !hasDouble {
            q = 34 as u8
        } else if !hasBack {
            q = 96 as u8
        }
    }
    var out = String.withCapacity(s.len() + 2)
    out.push(q)
    var k: i64 = 0
    while k < s.len() {
        let c = s[k]
        if c == q || c == 92 as u8 {
            out.push(92 as u8)
            out.push(c)
        } else if c == 10 as u8 {
            out.push(92 as u8)
            out.push('n')
        } else if c == 9 as u8 {
            out.push(92 as u8)
            out.push('t')
        } else if c == 13 as u8 {
            out.push(92 as u8)
            out.push('r')
        } else if c == 8 as u8 {
            out.push(92 as u8)
            out.push('b')
        } else if c == 12 as u8 {
            out.push(92 as u8)
            out.push('f')
        } else if c < 32 as u8 || c == 127 as u8 {
            out.push(92 as u8)
            out.push('x')
            out.push(mjInspectHexUpper(((c as i64) >> 4) & 15))
            out.push(mjInspectHexUpper((c as i64) & 15))
        } else {
            out.push(c)
        }
        k = k + 1
    }
    out.push(q)
    return out
}

// node leaves a key bare only when it matches /^[a-zA-Z_][a-zA-Z_0-9]*$/ — note
// that `$` is NOT in that set, so `{ $x: 1 }` prints as `{ '$x': 1 }`.
fn inspectKeyStr(k: &string): string {
    if isSymbolStr(k) {
        return "[" + symbolDisplay(k) + "]"
    }
    var ok = k.len() > 0
    var i: i64 = 0
    while i < k.len() {
        let c = k[i]
        let alpha = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == 95 as u8
        let digit = c >= '0' && c <= '9'
        if !alpha && !(digit && i > 0) {
            ok = false
        }
        i = i + 1
    }
    if ok {
        return k.clone()
    }
    return inspectQuoteStr(k)
}

fn strHasNewline(s: &string): bool {
    var i: i64 = 0
    while i < s.len() {
        if s[i] == 10 as u8 {
            return true
        }
        i = i + 1
    }
    return false
}

fn mjPadLeft(s: &string, width: i64): string {
    if s.len() >= width {
        return s.clone()
    }
    return spaces(width - s.len()) + s
}

fn mjPadRight(s: &string, width: i64): string {
    if s.len() >= width {
        return s.clone()
    }
    return s + spaces(width - s.len())
}

// node's reduceToSingleString. `base` is the prefix an exotic object carries
// ("Map(1)", "Set(2)"); `grouped` says the entries already went through the
// column layout, which node treats as a hard "do not put this on one line"
// (its `entries === output.length` guard).
fn inspectJoin(parts: &Vec<string>, open: &string, close: &string, base: &string, indentLvl: i64, grouped: bool): string {
    var pre = ""
    if base.len() > 0 {
        pre = base + " "
    }
    if parts.len() == 0 {
        return pre + open + close
    }
    let n = parts.len()
    // node: start = entries + indentationLvl + braces[0].length + base.length + 10
    let start = n + indentLvl + open.len() + base.len() + 10
    var total = n + start
    var fits = !grouped
    if total + n > inspBreakLength() {
        fits = false
    }
    var i: i64 = 0
    while i < n {
        total = total + parts[i].len()
        if total > inspBreakLength() {
            fits = false
        }
        if strHasNewline(parts[i]) {
            fits = false
        }
        i = i + 1
    }
    if fits {
        var out = pre + open + " "
        i = 0
        while i < n {
            if i > 0 {
                out = out + ", "
            }
            out = out + parts[i]
            i = i + 1
        }
        return out + " " + close
    }
    let ind = spaces(indentLvl)
    var out = pre + open + "\n"
    i = 0
    while i < n {
        out = out + ind + "  " + parts[i]
        // node emits no trailing comma on the last entry
        if i + 1 < n {
            out = out + ","
        }
        out = out + "\n"
        i = i + 1
    }
    return out + ind + close
}

// node's groupArrayElements: an array of more than six entries is laid out in
// columns rather than one-per-line. Returns the original parts unchanged when
// the shape does not qualify (entries too wide, or too uneven in width).
// `allNumeric` selects right-alignment, as node does for number/bigint arrays.
fn inspectGroupArray(parts: &Vec<string>, indentLvl: i64, allNumeric: bool): Vec<string> {
    let outputLength = parts.len()
    let separatorSpace: i64 = 2
    var totalLength: i64 = 0
    var maxLength: i64 = 0
    var dataLen: Vec<i64> = Vec.new()
    var i: i64 = 0
    while i < outputLength {
        let len = parts[i].len()
        dataLen.push(len)
        totalLength = totalLength + len + separatorSpace
        if maxLength < len {
            maxLength = len
        }
        i = i + 1
    }
    let actualMax = maxLength + separatorSpace
    // at least three entries must fit side by side, and one entry must not
    // dwarf the rest — otherwise the padding between short entries is enormous
    let evenEnough = ((totalLength as f64) / (actualMax as f64)) > 5.0 || maxLength <= 6
    if !(actualMax * 3 + indentLvl < inspBreakLength() && evenEnough) {
        var same: Vec<string> = Vec.new()
        var c: i64 = 0
        while c < outputLength {
            same.push(parts[c].clone())
            c = c + 1
        }
        return same
    }
    let approxCharHeights = 2.5
    let averageBias = Math.sqrt((actualMax as f64) - (totalLength as f64) / (outputLength as f64))
    var biasedMax = (actualMax as f64) - 3.0 - averageBias
    if biasedMax < 1.0 {
        biasedMax = 1.0
    }
    var columns = Math.round(Math.sqrt(approxCharHeights * biasedMax * (outputLength as f64)) / biasedMax) as i64
    let byWidth = (inspBreakLength() - indentLvl) / actualMax
    if columns > byWidth {
        columns = byWidth
    }
    // node caps at ctx.compact * 4 (12) and at 15
    if columns > 12 {
        columns = 12
    }
    if columns > 15 {
        columns = 15
    }
    if columns <= 1 {
        var same: Vec<string> = Vec.new()
        var c: i64 = 0
        while c < outputLength {
            same.push(parts[c].clone())
            c = c + 1
        }
        return same
    }
    var maxLineLength: Vec<i64> = Vec.new()
    var col: i64 = 0
    while col < columns {
        var lineLength: i64 = 0
        var j = col
        while j < outputLength {
            if dataLen[j] > lineLength {
                lineLength = dataLen[j]
            }
            j = j + columns
        }
        maxLineLength.push(lineLength + separatorSpace)
        col = col + 1
    }
    var rows: Vec<string> = Vec.new()
    var r: i64 = 0
    while r < outputLength {
        var maxJ = r + columns
        if maxJ > outputLength {
            maxJ = outputLength
        }
        var str = ""
        var j = r
        while j < maxJ - 1 {
            let width = maxLineLength[j - r]
            let cell = parts[j] + ", "
            if allNumeric {
                str = str + mjPadLeft(cell, width)
            } else {
                str = str + mjPadRight(cell, width)
            }
            j = j + 1
        }
        if allNumeric {
            str = str + mjPadLeft(parts[j], maxLineLength[j - r] - separatorSpace)
        } else {
            str = str + parts[j]
        }
        rows.push(str)
        r = r + columns
    }
    return rows
}

// A number renders through toStr except for -0, which JS stringifies as "0" but
// node's inspect shows as -0.
fn inspectNum(n: f64): string {
    if n == 0.0 && (1.0 / n) < 0.0 {
        return "-0"
    }
    return toStr(JSValue.Number(n))
}

fn inspectFuncLabel(name: &string): string {
    if name.len() == 0 {
        return "[Function (anonymous)]"
    }
    return "[Function: " + name + "]"
}

// A value as it appears INSIDE a container: strings are quoted, unlike the
// top-level form (see inspectTop).
fn inspectInner(st: &Interp, v: &JSValue, depth: i64, indentLvl: i64): string {
    match v {
        JSValue.Str(s) => {
            // a symbol is a tagged string internally; console.log shows it as
            // Symbol(desc) without quotes, not the raw "@@sym:..." form
            if isSymbolStr(s) {
                return symbolDisplay(s)
            }
            return inspectQuoteStr(s)
        }
        JSValue.Number(n) => {
            return inspectNum(n)
        }
        JSValue.BigInt(s) => {
            // console.log shows a BigInt with the trailing `n` (String() does not)
            return s + "n"
        }
        JSValue.Func(fidx, _env) => {
            return inspectFuncLabel(gProg.funcs[fidx].name)
        }
        JSValue.Obj(o) => {
            return inspectObj(st, o, depth, indentLvl)
        }
        _ => {
            return toStr(v)
        }
    }
}

fn inspectArr(st: &Interp, o: i64, depth: i64, indentLvl: i64): string {
    if depth > 2 {
        return "[Array]"
    }
    let n = st.objects[o].elems.len()
    if n == 0 {
        return "[]"
    }
    var parts: Vec<string> = Vec.new()
    var allNumeric = true
    var i: i64 = 0
    while i < n {
        if arrIsHole(st, o, i) {
            // node collapses a run of holes into one "<N empty items>" entry
            // (singular for a run of one), rather than printing undefined
            var run: i64 = 0
            while i + run < n && arrIsHole(st, o, i + run) {
                run = run + 1
            }
            var unit = " empty items>"
            if run == 1 {
                unit = " empty item>"
            }
            parts.push("<" + run.toString() + unit)
            allNumeric = false
            i = i + run
            continue
        }
        // a separate clone for the match: matching moves the value, and the
        // element is still needed for the render below
        let probe = cloneValue(st.objects[o].elems[i])
        match probe {
            JSValue.Number(_x) => {
            }
            JSValue.BigInt(_b) => {
            }
            _ => {
                allNumeric = false
            }
        }
        let v = cloneValue(st.objects[o].elems[i])
        parts.push(inspectInner(st, v, depth + 1, indentLvl + 2))
        i = i + 1
    }
    var grouped = false
    if n > 6 {
        let rows = inspectGroupArray(parts, indentLvl, allNumeric)
        if rows.len() != parts.len() {
            grouped = true
            parts = rows
        }
    }
    return inspectJoin(parts, "[", "]", "", indentLvl, grouped)
}

fn objIsoOrTag(st: &Interp, o: i64): string {
    return isoFromMillis(st.objExtras[st.objects[o].extra].dateMs)
}

fn inspectMapSet(st: &Interp, o: i64, depth: i64, indentLvl: i64): string {
    let keys = st.objExtras[st.objects[o].extra].mapKeys.len()
    var base = "Set(" + keys.toString() + ")"
    if st.objects[o].isMap {
        base = "Map(" + keys.toString() + ")"
    }
    if depth > 2 {
        if st.objects[o].isMap {
            return "[Map]"
        }
        return "[Set]"
    }
    var parts: Vec<string> = Vec.new()
    var i: i64 = 0
    while i < keys {
        let k = cloneValue(st.objExtras[st.objects[o].extra].mapKeys[i])
        if st.objects[o].isMap {
            let val = cloneValue(st.objExtras[st.objects[o].extra].mapVals[i])
            parts.push(inspectInner(st, k, depth + 1, indentLvl + 2) + " => " + inspectInner(st, val, depth + 1, indentLvl + 2))
        } else {
            parts.push(inspectInner(st, k, depth + 1, indentLvl + 2))
        }
        i = i + 1
    }
    return inspectJoin(parts, "{", "}", base, indentLvl, false)
}

fn inspectObj(st: &Interp, o: i64, depth: i64, indentLvl: i64): string {
    if st.objects[o].isArray {
        return inspectArr(st, o, depth, indentLvl)
    }
    // an Error prints as "Name: message [\n stack]", like node's console
    if st.objects[o].isError {
        let ename = toStr(objGet(st, o, "name"))
        let emsg = toStr(objGet(st, o, "message"))
        let estack = objGet(st, o, "stack")
        var head = ename.clone()
        if emsg.len() > 0 {
            head = ename + ": " + emsg
        }
        // console.log(error) prints the stack, which already begins with the
        // "Name: message" header (node appends the trace after it); fall back to
        // the header when there is no stack
        match estack {
            JSValue.Str(sv) => {
                if sv.len() > 0 {
                    return sv
                }
            }
            _ => {
            }
        }
        return head
    }
    if st.objects[o].isDate {
        return objIsoOrTag(st, o)
    }
    // a RegExp shows as its literal, not as its property bag
    if st.objExtras[st.objects[o].extra].regexId >= 0 {
        return "/" + toStr(objGet(st, o, "source")) + "/" + toStr(objGet(st, o, "flags"))
    }
    if st.objects[o].isMap || st.objects[o].isSet {
        return inspectMapSet(st, o, depth, indentLvl)
    }
    if st.objects[o].isFunctionLike {
        return inspectFuncLabel(toStr(objGet(st, o, "name")))
    }
    if depth > 2 {
        return "[Object]"
    }
    var parts: Vec<string> = Vec.new()
    var i: i64 = 0
    while i < st.objects[o].props.len() {
        if st.objects[o].props[i].enumerable {
            let key = st.objects[o].props[i].key.clone()
            let val = cloneValue(st.objects[o].props[i].value)
            parts.push(inspectKeyStr(key) + ": " + inspectInner(st, val, depth + 1, indentLvl + 2))
        }
        i = i + 1
    }
    if parts.len() == 0 {
        return "{}"
    }
    return inspectJoin(parts, "{", "}", "", indentLvl, false)
}

pub fn inspectTop(st: &Interp, v: &JSValue): string {
    match v {
        JSValue.Obj(o) => {
            return inspectObj(st, o, 0, 0)
        }
        JSValue.Number(n) => {
            return inspectNum(n)
        }
        JSValue.BigInt(s) => {
            return s + "n"
        }
        JSValue.Func(fidx, _env) => {
            return inspectFuncLabel(gProg.funcs[fidx].name)
        }
        JSValue.Str(s) => {
            // a bare string logs unquoted (console.log("hi") → hi), but a symbol
            // (a tagged string) logs as Symbol(desc), not its "@@sym:..." form
            if isSymbolStr(s) {
                return symbolDisplay(s)
            }
            return s.clone()
        }
        _ => {
            return toStr(v)
        }
    }
}

// Invoke a Milo-level JS function: a fresh scope off the closure's captured env,
// with `this` and the parameters bound, then run the body. argVals is consumed.

// Records the called function's source file for the duration of the call, so a
// V8-style stack trace can name the file each frame belongs to. Wrapping rather
// than editing callFunctionBody's many early returns keeps the push and pop
// paired without touching its control flow.
fn callFunction(prog: &Prog, fIdx: i64, envIdx: i64, argVals: Vec<JSValue>, thisVal: JSValue, st: &mut Interp): JSValue {
    if fIdx >= 0 && fIdx < prog.funcs.len() {
        st.fnFileStack.push(prog.funcs[fIdx].file.clone())
    } else {
        st.fnFileStack.push("")
    }
    let r = callFunctionBody(prog, fIdx, envIdx, argVals, thisVal, st)
    let _popped = st.fnFileStack.pop()
    return r
}

fn callFunctionBody(prog: &Prog, fIdx: i64, envIdx: i64, argVals: Vec<JSValue>, thisVal: JSValue, st: &mut Interp): JSValue {
    // R1: an async call runs its body on its own activation and returns at that
    // body's first await. Cleared immediately so a nested async call spawns.
    let alreadyOnActivation = st.suppressAsyncSpawn
    st.suppressAsyncSpawn = false
    // An `async function*` is a generator first: calling it returns an async
    // generator OBJECT, not a promise. Its body still awaits — that works
    // because the body runs on its own green task, which is all parkOnPromise
    // needs. Checked before the activation spawn, which would otherwise swallow
    // it and hand back a promise with no next().
    if prog.funcs[fIdx].isAsync && prog.funcs[fIdx].isGenerator && !st.suppressGenSpawn {
        st.suppressAsyncSpawn = false
        return makeGenerator(fIdx, envIdx, argVals, thisVal, true, st)
    }
    if prog.funcs[fIdx].isAsync && !alreadyOnActivation {
        let caller = schedulerCurrent()
        if caller as i64 != 0 {
            return spawnActivation(fIdx, envIdx, argVals, thisVal, st, caller)
        }
    }
    // Without this, runaway recursion exhausts the native stack and the process
    // dies with no JS-level error — express's error middleware expects a
    // catchable RangeError instead.
    // The safe limit tracks the stack the interpreter runs on. After splitting
    // the hot evaluator dispatcher, the engine's normal process stack supports
    // a 104-frame guard; the runtime uses 500 on its separately sized green task.
    // Keep the guard below the native ceiling so constructing the RangeError and
    // unwinding it remain reliable rather than ending in a process crash.
    if st.callDepth >= st.callDepthLimit {
        st.throwing = true
        st.thrownValue = makeError(st, "RangeError", "Maximum call stack size exceeded")
        return JSValue.Undefined
    }
    let genBody = st.suppressGenSpawn
    st.suppressGenSpawn = false
    if prog.funcs[fIdx].isGenerator && !genBody {
        return makeGenerator(fIdx, envIdx, argVals, thisVal, false, st)
    }
    st.callDepth = st.callDepth + 1
    let callScope = newScope(st, envIdx)
    // root the frame across the whole call so a GC inside the body (or a nested
    // call) can't reclaim it
    pushActive(st, callScope)
    // arrows have no own `this` — it stays lexical (resolved up the scope chain)
    if !prog.funcs[fIdx].isArrow {
        // A non-strict function called with no receiver gets globalThis, not
        // undefined. That is OrdinaryCallBindThis, and it is what
        // `Function("return this")()` — the standard global probe, and the core
        // of every UMD wrapper — depends on. This engine has no strict-mode
        // tracking, so it applies the sloppy rule throughout, which is also the
        // mode the test262 sweep runs in.
        var boundThisVal = thisVal
        match boundThisVal {
            JSValue.Undefined => {
                if scopeHas(st, 0, "globalThis") {
                    boundThisVal = scopeLookup(st, 0, "globalThis")
                }
            }
            _ => {
            }
        }
        scopeDefine(st, callScope, "this", boundThisVal)
        // new.target is the constructor this frame was invoked with, or
        // undefined for a plain call
        scopeDefine(st, callScope, "new.target", cloneValue(st.newTarget))
        // a named function expression can refer to itself by name from inside its
        // own body, even though the name is not bound in the enclosing scope
        let selfName = prog.funcs[fIdx].name.clone()
        if selfName.len() > 0 {
            scopeDefine(st, callScope, selfName, JSValue.Func(fIdx, envIdx))
        }
    }
    var j: i64 = 0
    let nParams = prog.funcs[fIdx].params.len()
    let restFrom = prog.funcs[fIdx].restFrom
    while j < nParams {
        let pName = prog.funcs[fIdx].params[j].clone()
        if j == restFrom {
            let rest = newArray(st)
            var r = j
            while r < argVals.len() {
                arrPush(st, rest, cloneValue(argVals[r]))
                r = r + 1
            }
            scopeDefine(st, callScope, pName, JSValue.Obj(rest))
        } else {
            var v = JSValue.Undefined
            if j < argVals.len() {
                v = cloneValue(argVals[j])
            }
            scopeDefine(st, callScope, pName, v)
        }
        j = j + 1
    }
    // `arguments` — ES5 libraries lean on it for variadics (path.join etc).
    // Arrows don't get their own, matching JS.
    if !prog.funcs[fIdx].isArrow {
        let argsArr = newArray(st)
        var ai: i64 = 0
        while ai < argVals.len() {
            arrPush(st, argsArr, cloneValue(argVals[ai]))
            ai = ai + 1
        }
        scopeDefine(st, callScope, "arguments", JSValue.Obj(argsArr))
    }
    let body = prog.funcs[fIdx].body
    // `var`s and nested function declarations belong to the whole call frame
    hoistBlock(prog, body, st, callScope)
    let flow = execBlock(prog, body, st, callScope)
    popActive(st)
    st.callDepth = st.callDepth - 1
    var result = JSValue.Undefined
    match flow {
        Flow.Ret(v) => {
            result = v
        }
        _ => {
        }
    }
    // Not for an async GENERATOR body: its completion is delivered through the
    // generator protocol (genFinish), so wrapping the return in a promise made
    // `return v` surface as {value: Promise, done: true}, and wrapping a throw
    // hid it from genFinish entirely.
    if prog.funcs[fIdx].isAsync && !prog.funcs[fIdx].isGenerator {
        // an async body that threw yields a rejected promise instead of
        // propagating the throw to its (synchronous) caller
        if st.throwing {
            let err = cloneValue(st.thrownValue)
            st.throwing = false
            st.thrownValue = JSValue.Undefined
            return JSValue.Obj(newPromise(st, 2, err))
        }
        // already-promise results are adopted rather than double-wrapped
        let ro = objHandle(result)
        if ro >= 0 && isPromise(st, ro) {
            return result
        }
        return JSValue.Obj(newPromise(st, 1, result))
    }
    return result
}

// Function.prototype.call/apply keeps a method-dispatch frame live around the
// ordinary JS call. Charge that extra native frame to the recursion budget so a
// recursive adapter path cannot reach the C stack before callFunction's guard.
fn callFunctionViaMethod(prog: &Prog, fIdx: i64, envIdx: i64, argVals: Vec<JSValue>, thisVal: JSValue, st: &mut Interp): JSValue {
    st.callDepth = st.callDepth + 1
    let result = callFunction(prog, fIdx, envIdx, argVals, thisVal, st)
    st.callDepth = st.callDepth - 1
    return result
}

// Invoke any callable JSValue (user function or native).
// Build a class: the constructor becomes the class value, instance methods go on
// its prototype, statics on its own property bag. `extends` chains the prototype
// so instances inherit the base's methods, and records the base constructor
// under __super$<Name> so super(...) can find it.
// Best-effort name for a callee expression, so "is not a function" says which
// one. Diagnostics only.
fn describeCallee(prog: &Prog, calleeId: ExprId): string {
    match prog.exprs[calleeId.index] {
        Expr.Ident(n) => {
            return n.clone()
        }
        Expr.Member(_o, n) => {
            return "." + n.clone()
        }
        Expr.OptMember(_o, n) => {
            return "?." + n.clone()
        }
        Expr.OptIndex(_o, _k) => {
            return "?.[]"
        }
        _ => {
            return "value"
        }
    }
}

// A real Error object, so catch blocks see .name/.message and instanceof works.
// Raise a TypeError and yield undefined, for the proxy traps.
fn throwTypeErr(st: &mut Interp, msg: string): JSValue {
    st.throwing = true
    st.thrownValue = makeError(st, "TypeError", msg)
    return JSValue.Undefined
}

// The handler trap `name`, or undefined when the handler does not define it.
fn proxyTrap(st: &Interp, o: i64, name: &string): JSValue {
    let h = objHandle(st.objExtras[st.objects[o].extra].proxyHandler)
    if h < 0 {
        return JSValue.Undefined
    }
    return getMember(st, h, name)
}

// Enumerable own string keys of a proxy: the ownKeys trap supplies the list,
// then each key is kept only if its descriptor (getOwnPropertyDescriptor trap,
// falling back to the target's own descriptor) says enumerable. Missing ownKeys
// forwards to the target. Feeds for-in and Object.keys.
fn proxyOwnEnumKeys(prog: &Prog, st: &mut Interp, o: i64): Vec<string> {
    var out: Vec<string> = Vec.new()
    let target = cloneValue(st.objExtras[st.objects[o].extra].proxyTarget)
    let trap = proxyTrap(st, o, "ownKeys")
    var keyList: Vec<string> = Vec.new()
    if isCallableIn(st, trap) {
        var args: Vec<JSValue> = Vec.new()
        args.push(cloneValue(target))
        let res = callValue(prog, trap, args, cloneValue(st.objExtras[st.objects[o].extra].proxyHandler), st)
        if st.throwing {
            return out
        }
        let rh = objHandle(res)
        if rh >= 0 && st.objects[rh].isArray {
            var i: i64 = 0
            while i < arrLen(st, rh) {
                let kv = arrGet(st, rh, i)
                keyList.push(toStr(kv))
                i = i + 1
            }
        }
    } else {
        let th = objHandle(target)
        if th >= 0 {
            if st.objects[th].isArray {
                var e: i64 = 0
                while e < st.objects[th].elems.len() {
                    if !arrIsHole(st, th, e) {
                        out.push(i64ToStr(e))
                    }
                    e = e + 1
                }
            }
            let order = enumOrder(st, th)
            var oi: i64 = 0
            while oi < order.len() {
                let k = order[oi]
                if st.objects[th].props[k].enumerable {
                    out.push(st.objects[th].props[k].key.clone())
                }
                oi = oi + 1
            }
        }
        return out
    }
    let dtrap = proxyTrap(st, o, "getOwnPropertyDescriptor")
    var i: i64 = 0
    while i < keyList.len() {
        if isCallableIn(st, dtrap) {
            var dargs: Vec<JSValue> = Vec.new()
            dargs.push(cloneValue(target))
            dargs.push(JSValue.Str(keyList[i].clone()))
            let d = callValue(prog, dtrap, dargs, cloneValue(st.objExtras[st.objects[o].extra].proxyHandler), st)
            if st.throwing {
                return out
            }
            let dh = objHandle(d)
            if dh >= 0 && truthy(getMember(st, dh, "enumerable")) {
                out.push(keyList[i].clone())
            }
        } else {
            let th = objHandle(target)
            if th >= 0 {
                let pi = objOwnIndex(st, th, keyList[i])
                if pi >= 0 {
                    if st.objects[th].props[pi].enumerable {
                        out.push(keyList[i].clone())
                    }
                } else if st.objects[th].isArray {
                    let ai = asArrayIndex(keyList[i])
                    if ai >= 0 && ai < arrLen(st, th) && !arrIsHole(st, th, ai) {
                        out.push(keyList[i].clone())
                    }
                }
            }
        }
        i = i + 1
    }
    return out
}

pub fn makeError(st: &mut Interp, kind: string, msg: string): JSValue {
    let o = newObject(st)
    st.objects[o].isError = true
    objSet(st, o, "name", JSValue.Str(kind.clone()))
    objSet(st, o, "message", JSValue.Str(msg.clone()))
    // a string stack (headed "Name: message") so a caught runtime error's .stack
    // is a string, like a constructed Error's — no real backtrace available
    var stackHead = kind.clone()
    if msg.len() > 0 {
        stackHead = stackHead + ": " + msg
    }
    objSet(st, o, "stack", JSValue.Str(stackHead + errorStackFrames(st)))
    // same prototype a constructed error of this kind gets, so a caught runtime
    // TypeError answers e.constructor and getPrototypeOf the way a thrown one does
    let ep = errorProtoFor(st, errorCtorIdFor(kind))
    if ep >= 0 {
        st.objects[o].proto = ep
    }
    objSetNonEnumerable(st, o, "name")
    objSetNonEnumerable(st, o, "message")
    objSetNonEnumerable(st, o, "stack")
    return JSValue.Obj(o)
}

fn isSymbolValue(v: &JSValue): bool {
    match v {
        JSValue.Str(s) => {
            if s.len() < 6 {
                return false
            }
            return s[0] == '@' && s[1] == '@' && s[2] == 's' && s[3] == 'y' && s[4] == 'm' && s[5] == ':'
        }
        _ => {
            return false
        }
    }
}

// The well-known @@iterator key. Symbols are interned strings, so this is just a
// fixed one; counter 0 is reserved because user symbols start at 1.
fn symAsyncIteratorKey(): string {
    return "@@sym:Symbol.asyncIterator:0"
}

fn symIteratorKey(): string {
    return "@@sym:Symbol.iterator:0"
}

fn symToPrimitiveKey(): string {
    return "@@sym:Symbol.toPrimitive:0"
}

fn symToStringTagKey(): string {
    return "@@sym:Symbol.toStringTag:0"
}

// Symbol test on the raw string. The JSValue-level isSymbolValue cannot be used
// from inside a `match` arm on that same value: matching moves it, so reading the
// original binding afterwards sees a zeroed slot and the test silently fails.
fn isSymbolStr(s: &string): bool {
    if s.len() < 6 {
        return false
    }
    return s[0] == '@' && s[1] == '@' && s[2] == 's' && s[3] == 'y' && s[4] == 'm' && s[5] == ':'
}

// The description inside "@@sym:<desc>:<counter>". The counter is what makes two
// same-description symbols distinct, so it is stripped from the LAST colon —
// a description may itself contain colons.
fn symbolDescription(s: &string): string {
    var cut = s.len()
    var i = s.len() - 1
    var found = false
    while i >= 6 && !found {
        if s[i] == ':' {
            cut = i
            found = true
        }
        i = i - 1
    }
    var out = String.withCapacity(cut)
    var j: i64 = 6
    while j < cut {
        out.push(s[j])
        j = j + 1
    }
    return out
}

// What a symbol shows as: Symbol(desc). Without this the internal representation
// leaks out of String(sym) and sym.toString().
fn symbolDisplay(s: &string): string {
    return "Symbol(" + symbolDescription(s) + ")"
}

// Drain every queued microtask. Microtasks may enqueue more, which is correct:
// JS runs the queue to exhaustion before the next timer.
// Settle a promise and queue every reaction that was waiting on it. Settling
// twice is ignored, as in JS.
// Run threadsafe-function calls queued by an addon's own threads, then apply any
// promise settlements they made. This is the only place a foreign thread's work
// crosses into the interpreter.
// Settle any fetch whose worker thread has finished. Called from the event loop
// and from a blocked await, the same way node-api work is serviced.
fn serviceFetches(st: &mut Interp) {
    var i: i64 = 0
    while i < st.fetches.len() {
        var done = false
        var payload = ""
        match st.fetches[i].chan.tryRecv() {
            Option.Some(v) => {
                payload = v
                done = true
            }
            Option.None => {
            }
        }
        if done {
            let p = st.fetches[i].promise
            st.fetches.remove(i)
            settlePromise(st, p, 1, JSValue.Str(payload))
        } else {
            i = i + 1
        }
    }
}

fn hasPendingFetches(st: &Interp): bool {
    return st.fetches.len() > 0
}

fn napiServiceTsfn(st: &mut Interp) {
    if !napiHasTsfn() {
        return
    }
    var q = napiPollTsfn()
    var i: i64 = 0
    while i < q.len() {
        let _r = napiRunTsfnCall(q[i])
        i = i + 1
    }
    napiDrainSettlements(st)
}

// Apply promise settlements an addon requested while it held control.
fn napiDrainSettlements(st: &mut Interp) {
    var q = napiTakePending()
    var i: i64 = 0
    while i < q.len() {
        settlePromise(st, q[i].promise, q[i].state, cloneValue(q[i].value))
        i = i + 1
    }
}

// Let the caller of this activation continue. Called at the activation's first
// suspension point, and at completion if it never suspends — an async call
// returns once its body reaches the first await, not when the body finishes.
fn releaseCreatorOnce(st: &mut Interp) {
    let me = schedulerCurrent()
    if me as i64 == 0 {
        return
    }
    var i: i64 = 0
    while i < st.actTask.len() {
        if st.actTask[i] as i64 == me as i64 {
            if !st.actNotified[i] {
                st.actNotified[i] = true
                schedulerUnpark(st.actCreator[i])
            }
            return
        }
        i = i + 1
    }
}

// Drop this activation's bookkeeping and its pre-bind roots once the body ends.
// An activation reaching any await hands control back to whoever called it and
// lets the scheduler run them before this body continues. A no-op off an
// activation: the main task owns the event loop and must not yield here.
fn yieldAtAwait(st: &mut Interp) {
    let me = schedulerCurrent()
    if me as i64 == 0 {
        return
    }
    var onActivation = false
    var i: i64 = 0
    while i < st.actTask.len() {
        if st.actTask[i] as i64 == me as i64 {
            onActivation = true
        }
        i = i + 1
    }
    if !onActivation {
        return
    }
    releaseCreatorOnce(st)
    schedulerYield()
}

fn endActivation(st: &mut Interp) {
    let me = schedulerCurrent()
    if me as i64 == 0 {
        return
    }
    var i: i64 = 0
    while i < st.actTask.len() {
        if st.actTask[i] as i64 == me as i64 {
            st.actTask.remove(i)
            st.actCreator.remove(i)
            st.actNotified.remove(i)
            st.actEnv.remove(i)
            st.actArgs.remove(i)
            st.actThis.remove(i)
            st.actPromise.remove(i)
            return
        }
        i = i + 1
    }
}

// R1: run an async body on its own green task and hand the caller a pending
// promise as soon as that body reaches its first await.
//
// The caller parks straight after spawning. Tasks are cooperative and only one
// runs at a time, so the body cannot start before that park — there is no race
// between spawning and waiting.
fn spawnActivation(fIdx: i64, envIdx: i64, argVals: Vec<JSValue>, thisVal: JSValue, st: &mut Interp, caller: *u8): JSValue {
    let p = newPromise(st, 0, JSValue.Undefined)
    var rootedArgs: Vec<JSValue> = Vec.new()
    var ri: i64 = 0
    while ri < argVals.len() {
        rootedArgs.push(cloneValue(argVals[ri]))
        ri = ri + 1
    }
    let rootedThis = cloneValue(thisVal)
    var args = argVals
    let body = Task.spawnWithStack(move(): void => {
        // gProg/gInterp rather than captured references: a task body cannot hold
        // a borrow from the frame that spawned it (docs/proposal-task-shared-state.md)
        gInterp.suppressAsyncSpawn = true
        let r = callFunction(gProg, fIdx, envIdx, args, thisVal, gInterp)
        if gInterp.throwing {
            let err = cloneValue(gInterp.thrownValue)
            gInterp.throwing = false
            gInterp.thrownValue = JSValue.Undefined
            settlePromise(gInterp, p, 2, err)
        } else {
            let ro = objHandle(r)
            if ro >= 0 && isPromise(gInterp, ro) {
                let rs = gInterp.objects[ro].promiseState
                if rs == 0 {
                    // The body returned a still-pending promise (e.g. `return
                    // fetchData(url).then(...)`). Reading its state now settles the
                    // activation's promise with `pending`, which is a no-op — the
                    // caller's await then hangs forever. Instead adopt it: a
                    // reaction with non-callable handlers passes the returned
                    // promise's eventual settlement straight through to `p`.
                    gInterp.objExtras[gInterp.objects[ro].extra].reactions.push(Reaction {
                        onFulfilled: JSValue.Undefined, onRejected: JSValue.Undefined, derived: p, isFinally: false
                    }
                    )
                } else {
                    // the inner promise's settlement is forwarded to the
                    // activation promise, so it is handled — clear it from the
                    // unhandled set (a throwing async body wraps its rejection in
                    // a fresh newPromise(2) that was flagged unhandled at birth;
                    // without this a caught `await asyncThatThrows()` printed a
                    // spurious "unhandled promise rejection")
                    if rs == 2 {
                        markRejectHandled(gInterp, ro)
                    }
                    settlePromise(gInterp, p, rs, cloneValue(gInterp.objExtras[gInterp.objects[ro].extra].promiseValue))
                }
            } else {
                settlePromise(gInterp, p, 1, r)
            }
        }
        // a body that never awaited still has to let its caller go
        releaseCreatorOnce(gInterp)
        endActivation(gInterp)
    }
    , 8388608)
    st.actTask.push(body._ptr)
    st.actCreator.push(caller)
    st.actNotified.push(false)
    st.actEnv.push(envIdx)
    st.actArgs.push(rootedArgs)
    st.actThis.push(rootedThis)
    st.actPromise.push(p)
    // Root the activation's promise across the park: until this task resumes
    // and its caller binds the returned value, `p` is held only by native
    // locals and the body closure — neither is a GC root — so a collect while
    // the body runs sweeps it and recycles the slot. Observed as awaits
    // resolving with foreign values ("json is not a function") or never
    // (reaction list wiped on reuse) under concurrent fetches. Pushed before
    // saveExecCtx so it rides in the suspended ctx that collect marks.
    pushTemp(st, JSValue.Obj(p))
    // the body runs while this task is parked; it unparks us at its first await
    let ctx = saveExecCtx(st)
    st.suspended.push(ctx)
    st.suspendedTask.push(caller)
    schedulerPark()
    resumeExecCtx(st, caller)
    popTemp(st)
    return JSValue.Obj(p)
}

// Take back the execution belonging to `task`, wherever it sits in the parked
// set. Parks and wakes interleave, so position says nothing about ownership.
pub fn resumeExecCtx(st: &mut Interp, task: *u8) {
    var i: i64 = 0
    while i < st.suspendedTask.len() {
        if st.suspendedTask[i] as i64 == task as i64 {
            let back = st.suspended.remove(i)
            st.suspendedTask.remove(i)
            restoreExecCtx(st, back)
            return
        }
        i = i + 1
    }
}

// R2 of docs/milojs-async-suspension.md. Park the running activation until
// `p` settles. Only legal off the main task: the main task runs the event loop,
// so parking it would stop the timers and off-thread servicing that settle
// promises in the first place — that path still drains in place.
//
// Returns false when parking is not possible, so the caller can fall back.
// A settled `await` still yields to the microtask queue in node (the continuation
// is queued as a microtask). Run the microtasks pending RIGHT NOW — a snapshot,
// so ones they queue run after this await, matching node — inline: no park, so
// the activation's own ExecCtx (tempRoots/active scopes) stays live in the Interp
// and rooted (the reverted R1a attempt bypassed that by yielding the task). Only
// on an activation task; the main event-loop task drains microtasks itself.
fn awaitYieldMicrotasks(prog: &Prog, st: &mut Interp) {
    let me = schedulerCurrent()
    if me as i64 == 0 || me as i64 == st.mainTask as i64 {
        return
    }
    let snap = st.microtasks.len()
    if snap > 0 {
        drainMicrotasks(prog, st, snap)
    }
}

pub fn parkOnPromise(st: &mut Interp, p: i64): bool {
    let me = schedulerCurrent()
    if me as i64 == 0 || me as i64 == st.mainTask as i64 {
        return false
    }
    // Already settled: there is nothing to wait for, and parking would be
    // permanent — the wake happens at settle time, which has passed.
    if st.objects[p].promiseState != 0 {
        return true
    }
    // reaching an await is what makes the async call return to its caller
    releaseCreatorOnce(st)
    st.awaitPromise.push(p)
    st.awaitTask.push(me)
    // the activation's execution leaves the Interp with it; whoever runs next
    // starts clean, and collect keeps these roots alive (R6, R7)
    let ctx = saveExecCtx(st)
    st.suspended.push(ctx)
    st.suspendedTask.push(me)
    schedulerPark()
    // Resumed: take back OUR execution, found by task identity. Taking the last
    // entry instead hands this activation someone else's state — its pops then
    // unroot that activation's scopes and the collector sweeps frames that are
    // still live, which surfaces later as an identifier that no longer resolves.
    resumeExecCtx(st, me)
    return true
}

// ── generators ──────────────────────────────────────────────────────────────
// A `function*` call returns a generator object whose body runs on its own green
// task, reusing the async-suspension machinery: `yield` and `next()` hand control
// back and forth via schedulerPark/Unpark + the ExecCtx save/restore that the
// `suspended` set already does. The body task is spawned LAZILY on the first
// next(), which is what keeps a fresh generator paused — calling a gen* runs no
// user code. Because each generator body has its own dedicated task, `yield`
// finds its generator by schedulerCurrent()==genTask; no per-task current-gen
// stack is needed even for nested generators (a design simplification over
// docs/milojs-generators.md, which assumed a shared task).

// True if any generator has been started but not run to completion, so its body
// task is parked forever. Such a task keeps the scheduler's task count > 0, which
// would block main's final -1 poll and hang the process at exit — Node instead
// drops an unfinished generator, so the entry point exits directly when this holds.
pub fn anyGenParked(st: &Interp): bool {
    var i: i64 = 0
    while i < st.genObj.len() {
        if st.genStarted[i] && !st.genDone[i] {
            return true
        }
        i = i + 1
    }
    return false
}

// Drop a completed generator's record. Left in place, its stale body-task
// pointer would collide with a future generator whose freshly-spawned task
// reuses the same freed address — genIndexOfTask would then resolve `yield` to
// the wrong (dead) record and write the yielded value into the wrong slot, so
// the real consumer reads a stale value. Object indices of removed generators
// are free to be recycled since collect no longer marks them.
fn removeGen(st: &mut Interp, gi: i64) {
    st.genObj.remove(gi)
    st.genFn.remove(gi)
    st.genTask.remove(gi)
    st.genEnv.remove(gi)
    st.genArgs.remove(gi)
    st.genThis.remove(gi)
    st.genYielded.remove(gi)
    st.genSent.remove(gi)
    st.genAsync.remove(gi)
    st.genResumeMode.remove(gi)
    st.genDone.remove(gi)
    st.genThrew.remove(gi)
    st.genErr.remove(gi)
    st.genCaller.remove(gi)
    st.genStarted.remove(gi)
}

// Index of the gen* record for gen object `o`, or -1.
fn genIndexOf(st: &Interp, o: i64): i64 {
    var i: i64 = 0
    while i < st.genObj.len() {
        if st.genObj[i] == o {
            return i
        }
        i = i + 1
    }
    return -1
}

// Index of the gen* record whose body task is `task`, or -1 — how `yield`
// resolves which generator it belongs to.
fn genIndexOfTask(st: &Interp, task: *u8): i64 {
    var i: i64 = 0
    while i < st.genTask.len() {
        if st.genTask[i] as i64 == task as i64 {
            return i
        }
        i = i + 1
    }
    return -1
}

// Build a `{ value, done }` iterator-result object.
fn iterResult(st: &mut Interp, value: JSValue, done: bool): JSValue {
    let r = newObject(st)
    pushTemp(st, JSValue.Obj(r))
    objSet(st, r, "value", value)
    objSet(st, r, "done", JSValue.Bool(done))
    popTemp(st)
    return JSValue.Obj(r)
}

// Called when a generator body finishes (return or fell off the end). Records the
// return value (or the thrown error), marks it done, and hands control back to
// whoever is inside next(). Runs on the generator's own task.
fn genFinish(st: &mut Interp, gi: i64, r: JSValue) {
    if st.genReturning {
        // the body unwound from a gen.return(v): complete with v, not as a throw
        st.genYielded[gi] = cloneValue(st.thrownValue)
        st.genReturning = false
        st.throwing = false
        st.thrownValue = JSValue.Undefined
        st.genDone[gi] = true
        schedulerUnpark(st.genCaller[gi])
        return
    }
    if st.throwing {
        st.genThrew[gi] = true
        st.genErr[gi] = cloneValue(st.thrownValue)
        st.throwing = false
        st.thrownValue = JSValue.Undefined
        st.genYielded[gi] = JSValue.Undefined
    } else {
        st.genYielded[gi] = cloneValue(r)
    }
    st.genDone[gi] = true
    // hand control back to the next() caller; this task then returns and ends
    schedulerUnpark(st.genCaller[gi])
}

// Create a generator object for a `function*` call. Does NOT run the body — that
// starts on the first next(). Registers the gen* record and returns the object.
fn makeGenerator(fIdx: i64, envIdx: i64, argVals: Vec<JSValue>, thisVal: JSValue, isAsync: bool, st: &mut Interp): JSValue {
    let g = newObject(st)
    st.objects[g].isGenerator = true
    st.objects[g].isAsyncGenerator = isAsync
    var rootedArgs: Vec<JSValue> = Vec.new()
    var ri: i64 = 0
    while ri < argVals.len() {
        rootedArgs.push(cloneValue(argVals[ri]))
        ri = ri + 1
    }
    st.genObj.push(g)
    st.genFn.push(fIdx)
    st.genTask.push(0 as *u8)
    st.genEnv.push(envIdx)
    st.genArgs.push(rootedArgs)
    st.genThis.push(cloneValue(thisVal))
    st.genYielded.push(JSValue.Undefined)
    st.genSent.push(JSValue.Undefined)
    st.genAsync.push(isAsync)
    st.genResumeMode.push(0)
    st.genDone.push(false)
    st.genThrew.push(false)
    st.genErr.push(JSValue.Undefined)
    st.genCaller.push(0 as *u8)
    st.genStarted.push(false)
    return JSValue.Obj(g)
}

// gen.next(v): drive the generator one step. Spawns the body task on the first
// call. Parks the caller and runs the body until its next `yield`, `return`, or
// throw, then returns `{ value, done }`. If the body threw, the error is
// re-raised at this next() site.
// What next/throw/return yield for a generator with no body left to run.
fn genCompletedResult(arg0: &JSValue, mode: i64, st: &mut Interp): JSValue {
    if mode == 1 {
        // throw() on a completed generator raises at the CALLER — there is no
        // body left that could catch it
        st.throwing = true
        st.thrownValue = cloneValue(arg0)
        return JSValue.Undefined
    }
    if mode == 2 {
        return iterResult(st, cloneValue(arg0), true)
    }
    return iterResult(st, JSValue.Undefined, true)
}

fn genNext(o: i64, args: Vec<JSValue>, st: &mut Interp): JSValue {
    return genResume(o, args, 0, st)
}

// The async-generator wrapper: same drive, but the step comes back as a promise
// (rejected if the body threw), because next/throw/return on an async generator
// are promise-returning.
//
// Divergence from node, deliberate for now: node returns a PENDING promise and
// runs the body afterwards, whereas this drives the body to its next yield
// first and hands back an already-settled promise. Values and ordering within
// the generator are identical; what differs is interleaving with other work
// queued between the next() call and its await.
fn genResumeAsync(o: i64, args: Vec<JSValue>, mode: i64, st: &mut Interp): JSValue {
    let step = genResume(o, args, mode, st)
    if st.throwing {
        let err = cloneValue(st.thrownValue)
        st.throwing = false
        st.thrownValue = JSValue.Undefined
        let rej = newPromise(st, 2, err)
        markRejectHandled(st, rej)
        return JSValue.Obj(rej)
    }
    return JSValue.Obj(newPromise(st, 1, step))
}

// gen.next(v) / gen.throw(e) / gen.return(v), by `mode` (0/1/2). All three drive
// the same parked body; they differ only in how it resumes from its `yield`.
fn genResume(o: i64, args: Vec<JSValue>, mode: i64, st: &mut Interp): JSValue {
    var arg0 = JSValue.Undefined
    if args.len() > 0 {
        arg0 = cloneValue(args[0])
    }
    let gi = genIndexOf(st, o)
    if gi < 0 {
        // No record: a completed generator whose record was reclaimed (calling
        // next() on a done generator yields {done:true} forever in JS), or a
        // genuinely non-generator receiver.
        if o >= 0 && st.objects[o].isGenerator {
            return genCompletedResult(arg0, mode, st)
        }
        st.throwing = true
        st.thrownValue = makeError(st, "TypeError", "not a generator")
        return JSValue.Undefined
    }
    // Never started, or already finished: neither throw() nor return() runs any
    // of the body — there is no `yield` parked to resume from. throw() raises at
    // the caller and return(v) completes with v, both leaving the generator done.
    if st.genDone[gi] || (mode != 0 && !st.genStarted[gi]) {
        st.genDone[gi] = true
        removeGen(st, gi)
        return genCompletedResult(arg0, mode, st)
    }
    let caller = schedulerCurrent()
    if caller as i64 == 0 {
        // no green task to drive the body (engine main thread) — generators need
        // the runtime's task scheduler; see the R1b note in the suspension doc
        st.throwing = true
        st.thrownValue = makeError(st, "TypeError", "generators require the milojs runtime (not the engine)")
        return JSValue.Undefined
    }
    st.genSent[gi] = cloneValue(arg0)
    st.genResumeMode[gi] = mode
    st.genCaller[gi] = caller
    var justSpawned = false
    if !st.genStarted[gi] {
        st.genStarted[gi] = true
        justSpawned = true
        let fIdx = st.genFn[gi]
        let envIdx = st.genEnv[gi]
        var bodyArgs: Vec<JSValue> = Vec.new()
        var ai: i64 = 0
        while ai < st.genArgs[gi].len() {
            bodyArgs.push(cloneValue(st.genArgs[gi][ai]))
            ai = ai + 1
        }
        let bodyThis = cloneValue(st.genThis[gi])
        let genObjIdx = o
        let body = Task.spawnWithStack(move(): void => {
            // gProg/gInterp: a task body cannot borrow from the spawning frame.
            // Run the function* body (not another makeGenerator) — see callFunction.
            gInterp.suppressGenSpawn = true
            // an async generator's body is already ON a task; without this the
            // isAsync branch would spawn an activation and hand back a promise
            gInterp.suppressAsyncSpawn = true
            let r = callFunction(gProg, fIdx, envIdx, bodyArgs, bodyThis, gInterp)
            let fgi = genIndexOf(gInterp, genObjIdx)
            if fgi >= 0 {
                genFinish(gInterp, fgi, r)
            }
        }
        , 8388608)
        st.genTask[gi] = body._ptr
    }
    // Root the gen object across the park: its record vectors reference it, but
    // the caller may hold it only in a temp the save/restore does not cover.
    pushTemp(st, JSValue.Obj(o))
    let ctx = saveExecCtx(st)
    st.suspended.push(ctx)
    st.suspendedTask.push(caller)
    // A just-spawned body task is already runnable; parking the caller hands it
    // control (mirrors spawnActivation). Only a body parked at a prior yield
    // needs an explicit unpark to become runnable again.
    if !justSpawned {
        schedulerUnpark(st.genTask[gi])
    }
    schedulerPark()
    resumeExecCtx(st, caller)
    popTemp(st)
    // re-read the record: a nested generator could have shuffled the vectors
    let gj = genIndexOf(st, o)
    if gj < 0 {
        return iterResult(st, JSValue.Undefined, true)
    }
    if st.genThrew[gj] {
        st.throwing = true
        st.thrownValue = cloneValue(st.genErr[gj])
        // the body ended (by throwing); its record is dead
        removeGen(st, gj)
        return JSValue.Undefined
    }
    let done = st.genDone[gj]
    let yielded = cloneValue(st.genYielded[gj])
    // the body ran off the end / returned; drop the record so its stale task
    // pointer cannot collide with a future generator's reused task address
    if done {
        removeGen(st, gj)
    }
    return iterResult(st, yielded, done)
}


// `await v`, factored out of the Unary branch so `for await (… of …)` can reuse
// it verbatim rather than growing a second, drifting copy of the thenable
// unwrapping, the activation park, and the main-task drain.
pub fn awaitValue(prog: &Prog, va: &JSValue, st: &mut Interp): JSValue {
            var awaited = cloneValue(va)
            // Resolution is recursive: a thenable may resolve with another
            // thenable, and each one has to be unwrapped in turn. The bound
            // is a runaway guard — a self-resolving chain would spin here.
            var rounds: i64 = 0
            while rounds < 1000 {
                rounds = rounds + 1
                // `await thenable` adopts it: the spec resolves the awaited value
                // through Promise.resolve, which calls .then on anything that has
                // one. prisma's query builders return a PrismaPromise (a plain
                // object with .then), and without this `await model.findMany()`
                // handed the builder itself back instead of the rows.
                let th = objHandle(awaited)
                if th >= 0 && !isPromise(st, th) {
                    let thenFn = getMemberDyn(prog, th, "then", st)
                    if isCallableIn(st, thenFn) {
                        let adopted = newPromise(st, 0, JSValue.Undefined)
                        pushTemp(st, JSValue.Obj(adopted))
                        var thenArgs: Vec<JSValue> = Vec.new()
                        thenArgs.push(JSValue.Native(NATIVE_RESOLVER_BASE + adopted * 2))
                        thenArgs.push(JSValue.Native(NATIVE_RESOLVER_BASE + adopted * 2 + 1))
                        let _tr = callValue(prog, thenFn, thenArgs, JSValue.Obj(th), st)
                        popTemp(st)
                        if st.throwing {
                            return JSValue.Undefined
                        }
                        awaited = JSValue.Obj(adopted)
                    }
                }
                let po = objHandle(awaited)
                if po >= 0 && isPromise(st, po) {
                    let ps = st.objects[po].promiseState
                    let pv = cloneValue(st.objExtras[st.objects[po].extra].promiseValue)
                    if ps == 2 {
                        awaitYieldMicrotasks(prog, st)
                        markRejectHandled(st, po)
                        st.throwing = true
                        st.thrownValue = pv
                        return JSValue.Undefined
                    }
                    if ps == 1 {
                        // already settled — but with a thenable, which the
                        // loop above still has to unwrap
                        let fh = objHandle(pv)
                        var fnested = false
                        if fh >= 0 && !isPromise(st, fh) {
                            let fthen = getMemberDyn(prog, fh, "then", st)
                            if isCallableIn(st, fthen) {
                                fnested = true
                            }
                        }
                        if !fnested {
                            awaitYieldMicrotasks(prog, st)
                            return pv
                        }
                        awaited = pv
                    } else {
                        // Pending. On an activation task this suspends properly:
                        // the task parks and the settle wakes it, so other
                        // activations and the event loop keep running (R2).
                        //
                        // Root the awaited promise for the whole park: the temp
                        // rides in the saved ExecCtx that collect marks. Without
                        // this the promise (often an activation's own promise,
                        // referenced from nothing else) was swept mid-park — its
                        // settle then hit a recycled slot and was silently
                        // dropped, wedging the awaiter forever. Worse, the old
                        // popTemp here had NO matching push, so each park stole
                        // an unrelated live temp root from the resumed
                        // activation — that unrooted objects at random under
                        // concurrent fetches ("json is not a function").
                        pushTemp(st, JSValue.Obj(po))
                        if parkOnPromise(st, po) {
                            let ps2 = st.objects[po].promiseState
                            let pv2 = cloneValue(st.objExtras[st.objects[po].extra].promiseValue)
                            if ps2 == 2 {
                                popTemp(st)
                                markRejectHandled(st, po)
                                st.throwing = true
                                st.thrownValue = pv2
                                return JSValue.Undefined
                            }
                            if ps2 == 1 {
                                popTemp(st)
                                return pv2
                            }
                            // still pending (spurious wake): keep the temp and
                            // fall through to the drain, which pops on exit
                        }
                        // On the main task there is nowhere to suspend to — it
                        // runs the event loop — so the loop is drained in place
                        // until the promise settles. Ordering therefore differs from
                        // real JS — work queued *after* this await can run before the
                        // awaiting function resumes — but the value flow is correct.
                        // If nothing is runnable the await can never complete, which
                        // is a deadlock and is reported as one.
                        // (the temp root pushed above stays live for the drain: the
                        // promise may be a temporary reachable from nothing while
                        // the drain runs user code)
                        // Budget: an unrelated interval keeps the loop runnable
                        // forever, so "nothing runnable" alone cannot detect a stuck
                        // await — the tahoeroads bundle hung silently for exactly
                        // this reason (its 2s interval kept feeding the drain).
                        // Node abandons the continuation instead; without coroutines
                        // the honest alternative is a loud error after a deadline.
                        let awaitDeadline = (epochMillis() as f64) + st.awaitBudgetMs
                        var spins: i64 = 0
                        while st.objects[po].promiseState == 0 && !st.throwing {
                            // Service off-thread work on EVERY iteration, not
                            // only when no timer is runnable: an app with a
                            // live interval always has a timer to run, so a
                            // response delivered by a worker thread was never
                            // picked up and the await ran out its budget.
                            serviceFetches(st)
                            if (epochMillis() as f64) > awaitDeadline {
                                popTemp(st)
                                st.throwing = true
                                st.thrownValue = makeError(st, "TypeError", "await did not settle within budget — likely a promise nothing will ever resolve" + currentModule(st))
                                return JSValue.Undefined
                            }
                            if st.microtasks.len() > 0 {
                                drainMicrotasks(prog, st, 1000000)
                            } else {
                                compactTimers(st)
                                // Only timers that are ALREADY due: runOneTimer
                                // sleeps until the earliest timer fires, which is
                                // right for an idle event loop but not here. A
                                // blocked await is waiting on a worker thread or
                                // an addon that can answer at any moment, so
                                // sleeping through a far-future timer made the
                                // await take that timer's delay — a request that
                                // fetched in a second took 32s behind a 30s cache
                                // timer.
                                if !runDueTimer(prog, st) {
                                    // A node-api addon settles from its own threads,
                                    // so there is no timer or microtask to run while
                                    // it works — this await is waiting on exactly
                                    // that. Without it, `await engine.connect()`
                                    // (prisma's query engine) was reported as an
                                    // unsettleable promise the moment it was made.
                                    napiServiceTsfn(st)
                                    serviceFetches(st)
                                    if hasPendingFetches(st) {
                                        napiWaitBriefly()
                                    } else if napiMayDeliver() {
                                        napiWaitBriefly()
                                    } else if earliestTimer(st) >= 0 {
                                        // A timer will fire eventually — very
                                        // likely the one that settles this await.
                                        // Wait in slices rather than sleeping to
                                        // its due time, so a worker thread or an
                                        // addon that answers sooner is still
                                        // picked up promptly.
                                        napiWaitBriefly()
                                    } else if st.microtasks.len() == 0 {
                                        popTemp(st)
                                        st.throwing = true
                                        st.thrownValue = makeError(st, "TypeError", "await on a promise that can never settle (no pending work)" + currentModule(st))
                                        return JSValue.Undefined
                                    }
                                }
                            }
                            spins = spins + 1
                        }
                        popTemp(st)
                        if st.throwing {
                            return JSValue.Undefined
                        }
                        let settled = st.objects[po].promiseState
                        let sv = cloneValue(st.objExtras[st.objects[po].extra].promiseValue)
                        if settled == 2 {
                            markRejectHandled(st, po)
                            st.throwing = true
                            st.thrownValue = sv
                            return JSValue.Undefined
                        }
                        // resolved with another thenable: unwrap it too
                        let sh = objHandle(sv)
                        var nested = false
                        if sh >= 0 && !isPromise(st, sh) {
                            let nthen = getMemberDyn(prog, sh, "then", st)
                            if isCallableIn(st, nthen) {
                                nested = true
                            }
                        }
                        if !nested {
                            return sv
                        }
                        awaited = sv
                    }
                } else {
                    // await of a non-thenable value: still yields a microtask tick
                    awaitYieldMicrotasks(prog, st)
                    return awaited
                }

            }
            return awaited
}
// The `yield e` expression, evaluated on a generator's body task. `handed` is the
// already-evaluated operand. Hands it out, parks the body, and on resume returns
// the value the next() caller passed in.
fn genYield(handed: JSValue, st: &mut Interp): JSValue {
    let me = schedulerCurrent()
    let gi = genIndexOfTask(st, me)
    if gi < 0 {
        // `yield` outside any generator body — not reachable through the parser,
        // which only emits it inside a function*, but fail soft rather than wedge
        return JSValue.Undefined
    }
    st.genYielded[gi] = cloneValue(handed)
    st.genDone[gi] = false
    // root the gen object across the park, like genNext does
    pushTemp(st, JSValue.Obj(st.genObj[gi]))
    let ctx = saveExecCtx(st)
    st.suspended.push(ctx)
    st.suspendedTask.push(me)
    schedulerUnpark(st.genCaller[gi])
    schedulerPark()
    resumeExecCtx(st, me)
    popTemp(st)
    let gj = genIndexOfTask(st, me)
    if gj < 0 {
        return JSValue.Undefined
    }
    let mode = st.genResumeMode[gj]
    st.genResumeMode[gj] = 0
    if mode == 1 {
        // gen.throw(e): raise at the yield, so the body's own try/catch sees it
        st.throwing = true
        st.thrownValue = cloneValue(st.genSent[gj])
        return JSValue.Undefined
    }
    if mode == 2 {
        // gen.return(v): unwind on the throw machinery so every enclosing
        // `finally` runs, with genReturning set so no `catch` intercepts it.
        // genFinish turns it back into a normal completion carrying v.
        st.throwing = true
        st.genReturning = true
        st.thrownValue = cloneValue(st.genSent[gj])
        return JSValue.Undefined
    }
    return cloneValue(st.genSent[gj])
}

// Wake every activation waiting on `p`, in the order they began awaiting (R3).
fn wakeAwaiters(st: &mut Interp, p: i64) {
    var i: i64 = 0
    while i < st.awaitPromise.len() {
        if st.awaitPromise[i] == p {
            let t = st.awaitTask[i]
            st.awaitPromise.remove(i)
            st.awaitTask.remove(i)
            schedulerUnpark(t)
        } else {
            i = i + 1
        }
    }
}

pub fn settlePromise(st: &mut Interp, p: i64, state: i64, value: JSValue) {
    if p < 0 || !isPromise(st, p) {
        return
    }
    if st.objects[p].promiseState != 0 {
        return
    }
    st.objects[p].promiseState = state
    st.objExtras[st.objects[p].extra].promiseValue = cloneValue(value)
    // an activation parked in `await p` IS a handler — the rejection is delivered
    // to it (to catch, or to re-reject its own promise). Capture that before
    // wakeAwaiters clears the registry, or Promise.any-style rejections that are
    // awaited-and-caught get falsely reported as unhandled.
    var hadAwaiter = false
    var ai: i64 = 0
    while ai < st.awaitPromise.len() {
        if st.awaitPromise[ai] == p {
            hadAwaiter = true
            ai = st.awaitPromise.len()
        } else {
            ai = ai + 1
        }
    }
    // wake activations parked on this promise before running reactions (R2/R3)
    wakeAwaiters(st, p)
    if state == 2 && st.objExtras[st.objects[p].extra].reactions.len() == 0 && !hadAwaiter {
        // nobody is waiting on this rejection; report it when the loop idles
        // unless a .catch attaches first
        st.unhandledRejects.push(p)
    }
    var i: i64 = 0
    while i < st.objExtras[st.objects[p].extra].reactions.len() {
        var handler = cloneValue(st.objExtras[st.objects[p].extra].reactions[i].onFulfilled)
        if state == 2 {
            handler = cloneValue(st.objExtras[st.objects[p].extra].reactions[i].onRejected)
        }
        st.microtasks.push(Microtask {
            cb: handler, arg: cloneValue(value), derived: st.objExtras[st.objects[p].extra].reactions[i].derived, passthroughReject: state == 2, isFinally: st.objExtras[st.objects[p].extra].reactions[i].isFinally, noArgs: false
        }
        )
        i = i + 1
    }
    st.objExtras[st.objects[p].extra].reactions = Vec.new()
}

// Awaiting or attaching a handler to a rejected promise counts as handling it,
// so drop it from the unhandled-rejection set reported at loop end. (Without this,
// `try { await Promise.reject(e) } catch {}` still printed a spurious unhandled
// rejection — GC-masked, since a collected promise slot was skipped at reporting.)
fn markRejectHandled(st: &mut Interp, p: i64) {
    var kept: Vec<i64> = Vec.new()
    var ki: i64 = 0
    while ki < st.unhandledRejects.len() {
        if st.unhandledRejects[ki] != p {
            kept.push(st.unhandledRejects[ki])
        }
        ki = ki + 1
    }
    st.unhandledRejects = kept
}

// Make `derived` follow `source`: settle now if it already has, else register.
fn adoptPromise(st: &mut Interp, derived: i64, source: i64) {
    let state = st.objects[source].promiseState
    if state == 2 {
        // the derived promise now observes the source's rejection
        var kept: Vec<i64> = Vec.new()
        var ki: i64 = 0
        while ki < st.unhandledRejects.len() {
            if st.unhandledRejects[ki] != source {
                kept.push(st.unhandledRejects[ki])
            }
            ki = ki + 1
        }
        st.unhandledRejects = kept
    }
    if state == 0 {
        st.objExtras[st.objects[source].extra].reactions.push(Reaction {
            onFulfilled: JSValue.Undefined, onRejected: JSValue.Undefined, derived: derived, isFinally: false
        }
        )
        return
    }
    settlePromise(st, derived, state, cloneValue(st.objExtras[st.objects[source].extra].promiseValue))
}

fn describeThrownValue(st: &Interp, v: &JSValue): string {
    let h = objHandle(v)
    if h >= 0 && st.objects[h].isError {
        return toStr(objGet(st, h, "name")) + ": " + toStr(objGet(st, h, "message"))
    }
    return toStr(v)
}

// Node reports (and by default dies on) rejections nothing handles; silently
// dropping them turned a thrown await-deadline error into an invisible hang.
fn reportUnhandledRejections(st: &mut Interp) {
    var i: i64 = 0
    while i < st.unhandledRejects.len() {
        let p = st.unhandledRejects[i]
        if isPromise(st, p) && st.objects[p].promiseState == 2 {
            let v = cloneValue(st.objExtras[st.objects[p].extra].promiseValue)
            eprint("Unhandled promise rejection: " + describeThrownValue(st, v))
        }
        i = i + 1
    }
    st.unhandledRejects = Vec.new()
}

// Run queued microtasks. `limit` caps how many are processed (also the runaway
// guard); pass a large value to drain the whole queue. A bounded limit lets an
// `await` run exactly the microtasks pending at the await point — matching node,
// which queues the await continuation as a microtask, so microtasks queued
// before it run first and ones they queue run after.
fn drainMicrotasks(prog: &Prog, st: &mut Interp, limit: i64) {
    var guard: i64 = 0
    while st.microtasks.len() > 0 && guard < limit {
        let task = cloneValue(st.microtasks[0].cb)
        let arg = cloneValue(st.microtasks[0].arg)
        let derived = st.microtasks[0].derived
        let passthrough = st.microtasks[0].passthroughReject
        let isFinallyTask = st.microtasks[0].isFinally
        let noArgsTask = st.microtasks[0].noArgs
        var rest: Vec<Microtask> = Vec.new()
        var i: i64 = 1
        while i < st.microtasks.len() {
            rest.push(Microtask {
                cb: cloneValue(st.microtasks[i].cb), arg: cloneValue(st.microtasks[i].arg), derived: st.microtasks[i].derived, passthroughReject: st.microtasks[i].passthroughReject, isFinally: st.microtasks[i].isFinally, noArgs: st.microtasks[i].noArgs
            }
            )
            i = i + 1
        }
        st.microtasks = rest
        if derived < 0 {
            pushTemp(st, cloneValue(task))
            var args: Vec<JSValue> = Vec.new()
            if !noArgsTask {
                args.push(arg)
            }
            let _ = callValue(prog, task, args, JSValue.Undefined, st)
            popTemp(st)
            if st.throwing {
                eprint("Uncaught (in microtask) " + describeThrownValue(st, st.thrownValue))
                st.throwing = false
                st.thrownValue = JSValue.Undefined
            }
        } else if !isCallable(task) {
            // no handler for this state: the value flows to the derived promise
            var passState: i64 = 1
            if passthrough {
                passState = 2
            }
            settlePromise(st, derived, passState, arg)
        } else {
            // The queue entry has already been popped, so it no longer roots
            // anything: the handler, the settlement value and the derived promise
            // must all be rooted across the call, which runs user code and can
            // collect. Omitting the handler let a collection free the scope it
            // captured, and it resumed with its closure variables gone.
            pushTemp(st, cloneValue(task))
            pushTemp(st, cloneValue(arg))
            pushTemp(st, JSValue.Obj(derived))
            var args: Vec<JSValue> = Vec.new()
            args.push(cloneValue(arg))
            let r = callValue(prog, task, args, JSValue.Undefined, st)
            popTemp(st)
            popTemp(st)
            popTemp(st)
            if st.throwing {
                let err = cloneValue(st.thrownValue)
                st.throwing = false
                st.thrownValue = JSValue.Undefined
                settlePromise(st, derived, 2, err)
            } else if isFinallyTask {
                // finally: the handler's value is discarded, the original
                // settlement (including a rejection) continues down the chain
                var origState: i64 = 1
                if passthrough {
                    origState = 2
                }
                settlePromise(st, derived, origState, arg)
            } else {
                let rp = objHandle(r)
                if rp >= 0 && isPromise(st, rp) {
                    // adopt the returned promise's eventual state
                    adoptPromise(st, derived, rp)
                } else {
                    settlePromise(st, derived, 1, r)
                }
            }
        }
        guard = guard + 1
    }
}

// Index of the earliest active timer, or -1 when none remain.
fn earliestTimer(st: &Interp): i64 {
    var best: i64 = -1
    var i: i64 = 0
    while i < st.timers.len() {
        if st.timers[i].active {
            if best < 0 || st.timers[i].dueMs < st.timers[best].dueMs {
                best = i
            }
        }
        i = i + 1
    }
    return best
}

// Run one due timer, sleeping until it is due. Returns false when there is
// nothing left to run.
fn runOneTimer(prog: &Prog, st: &mut Interp): bool {
    let idx = earliestTimer(st)
    if idx < 0 {
        return false
    }
    let nowMs = epochMillis() as f64
    let due = st.timers[idx].dueMs
    if due > nowMs {
        sleepMs((due - nowMs) as i64)
    }
    let cb = cloneValue(st.timers[idx].cb)
    var args: Vec<JSValue> = Vec.new()
    var ai: i64 = 0
    while ai < st.timers[idx].args.len() {
        args.push(cloneValue(st.timers[idx].args[ai]))
        ai = ai + 1
    }
    if st.timers[idx].intervalMs > 0.0 {
        st.timers[idx].dueMs = (epochMillis() as f64) + st.timers[idx].intervalMs
    } else {
        st.timers[idx].active = false
    }
    let _ = callValue(prog, cb, args, JSValue.Undefined, st)
    if st.throwing {
        eprint("Uncaught (in timer) " + describeThrownValue(st, st.thrownValue))
        st.throwing = false
        st.thrownValue = JSValue.Undefined
    }
    return true
}

// The event loop: microtasks to exhaustion, then one timer, repeat. Returns when
// nothing is left to run — which for a server with an interval never happens.
// Give any runnable activation the CPU. Returns true if one was there to run,
// so the event loop prefers a live continuation over sleeping on a timer.
fn schedulerYieldedToActivation(st: &mut Interp): bool {
    var ready = false
    var i: i64 = 0
    while i < st.actTask.len() {
        if !isParkedOnPromise(st, st.actTask[i]) {
            ready = true
        }
        i = i + 1
    }
    if ready {
        schedulerYield()
    }
    return ready
}

fn isParkedOnPromise(st: &Interp, t: *u8): bool {
    var i: i64 = 0
    while i < st.awaitTask.len() {
        if st.awaitTask[i] as i64 == t as i64 {
            return true
        }
        i = i + 1
    }
    return false
}

pub fn runEventLoop(prog: &Prog, st: &mut Interp) {
    var going = true
    while going {
        // Deliver anything an addon's worker threads queued. Runs before
        // microtasks so a settlement made off-thread is visible in this turn.
        napiServiceTsfn(st)
        serviceFetches(st)
        drainMicrotasks(prog, st, 1000000)
        compactTimers(st)
        // Order matters: run timers that are already due, then service a
        // listening server, and only sleep for a future timer when no server is
        // waiting. Sleeping first would block accept() for the whole delay — a
        // pending 9s timer made the server unreachable for 9s.
        if runDueTimer(prog, st) {
            // ran one; loop round
        } else if serveHttpOnce(prog, st) {
            // handled a connection
        } else if st.actTask.len() > 0 && schedulerYieldedToActivation(st) {
            // An activation woken by a settle is runnable now. Yield to it before
            // sleeping on a timer: runOneTimer sleeps until the earliest timer is
            // due, so a far-future timer would otherwise fire long before an
            // activation that is ready right now.
        } else if hasPendingFetches(st) {
            // A worker thread owes us a response; sleep rather than spin a core.
            // Checked BEFORE runOneTimer: serveHttpOnce no longer swallows this
            // branch, and runOneTimer sleeps to the next due timer — behind a
            // far-future timer the fetch would sit delivered but unserviced.
            napiWaitBriefly()
        } else if napiHasPendingWork() {
            // an addon still owes us a settlement, and it will arrive on one of its
            // own threads — there is no timer or socket to wait on, so yield briefly
            // rather than spinning a core while the worker finishes.
            napiWaitBriefly()
        } else if st.httpServers.len() > 0 {
            // A listener with nothing pending, but the loop was not idle enough
            // for a blocking accept (live activations or an armed timer). Sleep a
            // slice and re-probe; due timers are caught at the top of the loop.
            sleepMs(1)
        } else if runOneTimer(prog, st) {
            // nothing to serve, so waiting for the next timer is correct
        } else if st.actTask.len() > 0 {
            // activations are still live; their continuations are real work, so
            // exiting here would drop them on the floor
            schedulerYield()
        } else {
            // Report only here, where the loop is genuinely out of work. A
            // rejection is "unhandled" the moment it settles with no reaction
            // and no parked awaiter, but the awaiter of `await thr()` attaches
            // only after its activation task is scheduled back in — several
            // loop turns later. Reporting at the top of every turn caught that
            // window and printed a spurious unhandled rejection for a
            // try/catch-ed await (and for Promise.allSettled).
            reportUnhandledRejections(st)
            going = false
        }
    }
}

// Run a timer only if it is already due; never sleeps.
fn runDueTimer(prog: &Prog, st: &mut Interp): bool {
    let idx = earliestTimer(st)
    if idx < 0 {
        return false
    }
    if st.timers[idx].dueMs > (epochMillis() as f64) {
        return false
    }
    return runOneTimer(prog, st)
}

// Ask each registered http server to accept and handle one connection. Returns
// true only when a connection was actually handled, so the event loop can tell
// a served request apart from an idle listener.
fn serveHttpOnce(prog: &Prog, st: &mut Interp): bool {
    if st.httpServers.len() == 0 {
        return false
    }
    // A blocking accept is only safe when nothing else needs the loop: any live
    // activation, in-flight fetch, queued microtask, pending addon settlement or
    // armed timer must keep being serviced, and a park on the listener stops all
    // of them until the next connection arrives. That park was the cold-fetch
    // hang: a request whose handler awaited an upstream fetch parked, the loop
    // re-entered accept, and the response sat unserviced in its channel forever.
    let mayBlock = st.httpServers.len() == 1 && st.actTask.len() == 0 && st.fetches.len() == 0 && st.microtasks.len() == 0 && earliestTimer(st) < 0 && !napiHasPendingWork()
    var handled = false
    var i: i64 = 0
    while i < st.httpServers.len() {
        let so = st.httpServers[i]
        if so >= 0 {
            let server = JSValue.Obj(so)
            var args: Vec<JSValue> = Vec.new()
            args.push(JSValue.Bool(mayBlock))
            let r = callMemberValue(prog, server, "_serveOnce", args, st)
            if truthy(r) {
                handled = true
            }
            if st.throwing {
                eprint("Uncaught (in request handler) " + describeThrownValue(st, st.thrownValue))
                st.throwing = false
                st.thrownValue = JSValue.Undefined
            }
        }
        i = i + 1
    }
    // A request's transient graph — the parsed body, fetched response strings
    // (each a single but often multi-MB allocation), the Request/Response objects
    // — is garbage the moment the response is sent. The alloc-COUNT GC threshold
    // barely moves for a few huge strings, so without this the heap grows
    // unbounded across requests (observed: ~30 MB/request to >1 GB). This request
    // boundary is a safe collection point: nothing is in flight on the eval stack.
    if handled {
        collect(st)
    }
    return handled
}

// Call a method on an object with already-evaluated arguments.
fn callMemberValue(prog: &Prog, recv: &JSValue, name: &string, args: Vec<JSValue>, st: &mut Interp): JSValue {
    let o = objHandle(recv)
    if o < 0 {
        return JSValue.Undefined
    }
    let m = getMemberDyn(prog, o, name, st)
    return callValue(prog, m, args, cloneValue(recv), st)
}

// Drop cancelled timers so the list cannot grow without bound in a long run.
fn compactTimers(st: &mut Interp) {
    var anyDead = false
    var i: i64 = 0
    while i < st.timers.len() {
        if !st.timers[i].active {
            anyDead = true
        }
        i = i + 1
    }
    if !anyDead {
        return
    }
    var live: Vec<Timer> = Vec.new()
    var j: i64 = 0
    while j < st.timers.len() {
        if st.timers[j].active {
            var args: Vec<JSValue> = Vec.new()
            var k: i64 = 0
            while k < st.timers[j].args.len() {
                args.push(cloneValue(st.timers[j].args[k]))
                k = k + 1
            }
            live.push(Timer {
                id: st.timers[j].id, dueMs: st.timers[j].dueMs, intervalMs: st.timers[j].intervalMs, cb: cloneValue(st.timers[j].cb), args: args, active: true
            }
            )
        }
        j = j + 1
    }
    st.timers = live
}

// `delete obj.k` / `delete obj[k]` — remove an own property. Array elements
// become holes (undefined) rather than shifting, as in JS. Always returns true
// here; the non-configurable cases the spec reports false for do not arise.
// `delete proxy[key]`: the deleteProperty trap, else delete on the target.
fn proxyDelete(prog: &Prog, o: i64, key: string, st: &mut Interp): JSValue {
    let trap = proxyTrap(st, o, "deleteProperty")
    if isCallableIn(st, trap) {
        var dargs: Vec<JSValue> = Vec.new()
        dargs.push(cloneValue(st.objExtras[st.objects[o].extra].proxyTarget))
        dargs.push(JSValue.Str(key.clone()))
        return JSValue.Bool(truthy(callValue(prog, trap, dargs, cloneValue(st.objExtras[st.objects[o].extra].proxyHandler), st)))
    }
    let th = objHandle(st.objExtras[st.objects[o].extra].proxyTarget)
    if th >= 0 {
        return JSValue.Bool(objDeleteKey(st, th, key))
    }
    return JSValue.Bool(true)
}

fn evalDelete(prog: &Prog, targetId: ExprId, st: &mut Interp, scope: i64): JSValue {
    match prog.exprs[targetId.index] {
        Expr.Member(objIdx, name) => {
            let ov = evalExpr(prog, objIdx, st, scope)
            let o = objHandle(ov)
            if o >= 0 {
                if st.objects[o].isProxy {
                    return proxyDelete(prog, o, name.clone(), st)
                }
                if st.objects[o].frozen || st.objects[o].sealed {
                    return JSValue.Bool(false)
                }
                return JSValue.Bool(objDeleteKey(st, o, name))
            }
            return JSValue.Bool(true)
        }
        Expr.Index(objIdx, keyIdx) => {
            let ov = evalExpr(prog, objIdx, st, scope)
            pushTemp(st, cloneValue(ov))
            let kv = evalExpr(prog, keyIdx, st, scope)
            popTemp(st)
            let key = toStr(kv)
            let o = objHandle(ov)
            if o >= 0 {
                if st.objects[o].isProxy {
                    return proxyDelete(prog, o, key, st)
                }
                if st.objects[o].frozen || st.objects[o].sealed {
                    return JSValue.Bool(false)
                }
                return JSValue.Bool(objDeleteKey(st, o, key))
            }
            return JSValue.Bool(true)
        }
        _ => {
            // `delete someVariable` is not permitted on bindings; evaluate for
            // effect and report false
            let _ = evalExpr(prog, targetId, st, scope)
            return JSValue.Bool(false)
        }
    }
}

// new Array(n) preallocates n holes; new Array(a, b, ...) is a literal list.
fn makeArrayFromCtor(st: &mut Interp, argVals: &Vec<JSValue>): JSValue {
    let arr = newArray(st)
    if argVals.len() == 1 {
        match cloneValue(argVals[0]) {
            JSValue.Number(n) => {
                var i: i64 = 0
                while i < (n as i64) {
                    arrPush(st, arr, JSValue.Undefined)
                    i = i + 1
                }
                return JSValue.Obj(arr)
            }
            _ => {
            }
        }
    }
    var k: i64 = 0
    while k < argVals.len() {
        arrPush(st, arr, cloneValue(argVals[k]))
        k = k + 1
    }
    return JSValue.Obj(arr)
}

// The object that holds a value's properties: itself for an object, the statics
// bag for a function, the native bag for a builtin. Functions are property
// carriers in JS, and express builds its app by copying descriptors onto one.
// The prototype ToObject would give a primitive. Object.getPrototypeOf boxes its
// argument, so `Object.getPrototypeOf(42)` is Number.prototype, not null;
// Reflect.getPrototypeOf does NOT box and throws for the same input, and that
// difference is the whole of what get-proto and reflect.getprototypeof test.
fn primitiveProtoHandle(st: &mut Interp, v: &JSValue): i64 {
    match v {
        JSValue.Str(sv) => {
            if isSymbolStr(sv) {
                return nativeProtoHandle(st, NATIVE_SYMBOL)
            }
            return st.stringProtoObj
        }
        JSValue.Number(_n) => {
            return nativeProtoHandle(st, NATIVE_NUMBER)
        }
        JSValue.Bool(_b) => {
            return nativeProtoHandle(st, NATIVE_BOOLEAN)
        }
        JSValue.BigInt(_g) => {
            return nativeProtoHandle(st, NATIVE_BIGINT)
        }
        _ => {
            return -1
        }
    }
}

fn propertyBagOf(st: &mut Interp, v: &JSValue): i64 {
    let o = objHandle(v)
    if o >= 0 {
        return o
    }
    let f = funcHandle(v)
    if f >= 0 {
        return getFuncStatics(st, f, funcEnv(v))
    }
    let n = nativeHandle(v)
    if n >= 0 {
        return getNativeProps(st, n)
    }
    return -1
}

// The module currently executing, for error messages. Empty at top level.

fn hasNodeAddonExt(p: &string): bool {
    let n = p.len()
    if n < 6 {
        return false
    }
    return p[n - 5] == '.' && p[n - 4] == 'n' && p[n - 3] == 'o' && p[n - 2] == 'd' && p[n - 1] == 'e'
}

// dlopen is not idempotent for addon state: a second registration would hand back
// a fresh exports object and re-run module init, so loaded addons are cached by
// path exactly like JS modules are.
fn findNapiAddon(st: &Interp, path: &string): Option<JSValue> {
    var i: i64 = 0
    while i < st.napiAddonPaths.len() {
        if st.napiAddonPaths[i] == path {
            return Option.Some(cloneValue(st.napiAddonExports[i]))
        }
        i = i + 1
    }
    return Option.None
}

fn isUndefinedValue(v: &JSValue): bool {
    match v {
        JSValue.Undefined => {
            return true
        }
        _ => {
            return false
        }
    }
}

// SameValue: strict equality with the two exceptions the spec carves out —
// NaN is equal to itself, and +0 is not equal to -0.
fn sameValue(a: &JSValue, b: &JSValue): bool {
    match a {
        JSValue.Number(x) => {
            match b {
                JSValue.Number(y) => {
                    if x != x && y != y {
                        return true
                    }
                    if x == 0.0 && y == 0.0 {
                        // 1/x distinguishes the zeroes; the sign bit is not
                        // otherwise reachable from f64 here
                        return (1.0 / x) == (1.0 / y)
                    }
                    return x == y
                }
                _ => {
                    return false
                }
            }
        }
        _ => {
            return jsStrictEquals(a, b)
        }
    }
}

// A single JS identifier and nothing else — what the limited eval accepts.
fn isIdentifierText(s: &string): bool {
    if s.len() == 0 {
        return false
    }
    var i: i64 = 0
    while i < s.len() {
        let c = s[i]
        let alpha = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || c == '$'
        let digit = c >= '0' && c <= '9'
        if !alpha && !(digit && i > 0) {
            return false
        }
        i = i + 1
    }
    return true
}

fn currentModule(st: &Interp): string {
    if st.modPathStack.len() == 0 {
        return ""
    }
    return " (in " + st.modPathStack[st.modPathStack.len() - 1].clone() + ")"
}

fn isBoundThisSet(st: &Interp, o: i64): bool {
    match st.objExtras[st.objects[o].extra].boundThis {
        JSValue.Undefined => {
            return false
        }
        _ => {
            return true
        }
    }
}

// Builtin methods dispatch natively by name; they are not properties. Reading one
// as a VALUE therefore used to yield undefined even though calling it worked, which
// breaks two very common patterns: feature detection (`typeof x.test === "function"`)
// and method extraction (`Array.prototype.slice.call(args)`). These predicates say
// whether a receiver answers to a name, so the member paths can hand back a bound
// method instead of undefined.
fn isPrimitiveMethodName(n: &string): bool {
    return n == "toString" || n == "valueOf" || n == "toFixed" || n == "toPrecision" || n == "toExponential" || n == "toLocaleString"
}

fn isStringMethodName(n: &string): bool {
    return n == "charAt" || n == "charCodeAt" || n == "codePointAt" || n == "at" || n == "indexOf" || n == "lastIndexOf" || n == "includes" || n == "startsWith" || n == "endsWith" || n == "slice" || n == "substring" || n == "substr" || n == "split" || n == "replace" || n == "replaceAll" || n == "toUpperCase" || n == "toLowerCase" || n == "toLocaleUpperCase" || n == "toLocaleLowerCase" || n == "isWellFormed" || n == "toWellFormed" || n == "trim" || n == "trimStart" || n == "trimEnd" || n == "trimLeft" || n == "trimRight" || n == "padStart" || n == "padEnd" || n == "repeat" || n == "concat" || n == "localeCompare" || n == "normalize" || n == "match" || n == "matchAll" || n == "search" || n == "toString" || n == "valueOf"
}

fn stringPrimitiveMember(st: &mut Interp, value: &string, key: &string): JSValue {
    if key == "length" {
        return JSValue.Number(utf16Length(value) as f64)
    }
    // "abc"[Symbol.iterator] as a VALUE. for-of and spread over a string never
    // needed it (they walk the code points directly), so reading it answered
    // undefined until get-intrinsic tried to call it.
    if key == symIteratorKey() && !isSymbolStr(value) {
        return makeBoundMethod(st, JSValue.Str(value.clone()), "__stringIterator")
    }
    if key == "description" && isSymbolStr(value) {
        return JSValue.Str(symbolDescription(value))
    }
    if st.stringProtoObj >= 0 {
        return getMember(st, st.stringProtoObj, key)
    }
    return JSValue.Undefined
}

fn isMapSetMethodName(n: &string): bool {
    return n == "get" || n == "set" || n == "add" || n == "has" || n == "delete" || n == "clear" || n == "forEach" || n == "keys" || n == "values" || n == "entries" || n == "isSupersetOf" || n == "isSubsetOf" || n == "isDisjointFrom" || n == "union" || n == "intersection" || n == "difference"
}

fn isRegexMethodName(n: &string): bool {
    if n.len() > 8 && strSlice(n.clone(), 0, 8) == "__reGet_" {
        return true
    }
    if n == "@@sym:Symbol.match:0" || n == "@@sym:Symbol.matchAll:0" || n == "@@sym:Symbol.replace:0" || n == "@@sym:Symbol.search:0" || n == "@@sym:Symbol.split:0" {
        return true
    }
    return n == "test" || n == "exec" || n == "toString" || n == "compile"
}

fn isTypedArrayMethodName(n: &string): bool {
    return n == "fill" || n == "set" || n == "subarray" || n == "slice" || n == "at" || n == "indexOf" || n == "includes" || n == "join" || n == "toString" || n == "forEach" || n == "map" || n == "filter" || n == "reduce" || n == "reduceRight" || n == "find" || n == "findIndex" || n == "findLast" || n == "findLastIndex" || n == "some" || n == "every" || n == "reverse" || n == "sort" || n == "with" || n == "copyWithin" || n == "lastIndexOf" || n == "keys" || n == "values" || n == "entries" || n == "toReversed" || n == "toSorted" || n == "toLocaleString" || n == symIteratorKey()
}

// Typed-array methods. Views share their buffer, so subarray returns a new view
// over the SAME bytes while slice copies — getting that backwards is the classic
// typed-array bug.
fn typedArrayMethod(prog: &Prog, o: i64, name: &string, args: &Vec<JSValue>, st: &mut Interp): JSValue {
    if taIsDetached(st, o) {
        st.throwing = true
        st.thrownValue = makeError(st, "TypeError", "Cannot perform " + name.clone() + " on a detached ArrayBuffer" + currentModule(st))
        return JSValue.Undefined
    }
    let n = st.objExtras[st.objects[o].extra].taLen
    let kind = st.objExtras[st.objects[o].extra].taKind
    let w = taWidth(kind)

    if name == "at" {
        var idx: i64 = 0
        if args.len() > 0 {
            idx = toNum(args[0]) as i64
        }
        if idx < 0 {
            idx = n + idx
        }
        if idx < 0 || idx >= n {
            return JSValue.Undefined
        }
        return JSValue.Number(taElem(st, o, idx))
    }
    if name == "fill" {
        var v: f64 = 0.0
        if args.len() > 0 {
            v = toNum(args[0])
        }
        var start: i64 = 0
        if argPresent(args, 1) {
            start = toNum(args[1]) as i64
            if start < 0 {
                start = n + start
            }
        }
        var end = n
        if argPresent(args, 2) {
            end = toNum(args[2]) as i64
            if end < 0 {
                end = n + end
            }
        }
        if start < 0 {
            start = 0
        }
        if end > n {
            end = n
        }
        var i = start
        while i < end {
            taSetElem(st, o, i, v)
            i = i + 1
        }
        return JSValue.Obj(o)
    }
    if name == "indexOf" || name == "includes" {
        var target: f64 = 0.0
        if args.len() > 0 {
            target = toNum(args[0])
        }
        var i: i64 = 0
        while i < n {
            if taElem(st, o, i) == target {
                if name == "includes" {
                    return JSValue.Bool(true)
                }
                return JSValue.Number(i as f64)
            }
            i = i + 1
        }
        if name == "includes" {
            return JSValue.Bool(false)
        }
        return JSValue.Number(0.0 - 1.0)
    }
    if name == "join" || name == "toString" {
        var sep = ","
        if name == "join" && argPresent(args, 0) {
            sep = toStr(args[0])
        }
        var out = ""
        var i: i64 = 0
        while i < n {
            if i > 0 {
                out = out + sep
            }
            out = out + numToStr(taElem(st, o, i))
            i = i + 1
        }
        return JSValue.Str(out)
    }
    if name == "set" {
        // set(source, offset) — copies element values in
        if args.len() == 0 {
            return JSValue.Undefined
        }
        var off: i64 = 0
        if args.len() > 1 {
            off = toNum(args[1]) as i64
        }
        let sh = objHandle(args[0])
        if sh < 0 {
            return JSValue.Undefined
        }
        if st.objects[sh].isArray {
            var i: i64 = 0
            while i < arrLen(st, sh) {
                taSetElem(st, o, off + i, toNum(arrGet(st, sh, i)))
                i = i + 1
            }
        } else if st.objExtras[st.objects[sh].extra].taBuf >= 0 {
            var i: i64 = 0
            while i < st.objExtras[st.objects[sh].extra].taLen {
                taSetElem(st, o, off + i, taElem(st, sh, i))
                i = i + 1
            }
        }
        return JSValue.Undefined
    }
    if name == "subarray" || name == "slice" {
        var start: i64 = 0
        if argPresent(args, 0) {
            start = toNum(args[0]) as i64
            if start < 0 {
                start = n + start
            }
        }
        var end = n
        if argPresent(args, 1) {
            end = toNum(args[1]) as i64
            if end < 0 {
                end = n + end
            }
        }
        if start < 0 {
            start = 0
        }
        if end > n {
            end = n
        }
        if end < start {
            end = start
        }
        let count = end - start
        if name == "subarray" {
            // a VIEW over the same buffer: writes through it are visible in the
            // original, which is the whole point of subarray
            let view = newObject(st)
            let _ev = ensureExtra(st, view)
            st.objExtras[st.objects[view].extra].taBuf = st.objExtras[st.objects[o].extra].taBuf
            st.objExtras[st.objects[view].extra].taKind = kind
    st.objects[view].proto = typedArrayProtoFor(st, kind)
            st.objExtras[st.objects[view].extra].taOffset = st.objExtras[st.objects[o].extra].taOffset + start * w
            st.objExtras[st.objects[view].extra].taLen = count
            return JSValue.Obj(view)
        }
        // slice COPIES into a fresh buffer
        let nb = newObject(st)
        st.objects[nb].isArrayBuffer = true
        st.objects[nb].proto = arrayBufferProto(st)
        let _eb = ensureExtra(st, nb)
        pushTemp(st, JSValue.Obj(nb))
        var bytes: Vec<u8> = Vec.new()
        var bi: i64 = 0
        while bi < count * w {
            bytes.push(0 as u8)
            bi = bi + 1
        }
        st.objExtras[st.objects[nb].extra].bytes = bytes
        let view = newObject(st)
        let _ev = ensureExtra(st, view)
        st.objExtras[st.objects[view].extra].taBuf = nb
        st.objExtras[st.objects[view].extra].taKind = kind
    st.objects[view].proto = typedArrayProtoFor(st, kind)
        st.objExtras[st.objects[view].extra].taOffset = 0
        st.objExtras[st.objects[view].extra].taLen = count
        var i: i64 = 0
        while i < count {
            taSetElem(st, view, i, taElem(st, o, start + i))
            i = i + 1
        }
        popTemp(st)
        return JSValue.Obj(view)
    }
    // callback-based iteration methods. The element and index are passed to the
    // callback; map/filter build a new typed array (map keeps the kind).
    if name == "forEach" {
        var i: i64 = 0
        while i < n && !st.throwing {
            var cbArgs: Vec<JSValue> = Vec.new()
            cbArgs.push(JSValue.Number(taElem(st, o, i)))
            cbArgs.push(JSValue.Number(i as f64))
            let _r = callValue(prog, args[0], cbArgs, JSValue.Undefined, st)
            i = i + 1
        }
        return JSValue.Undefined
    }
    if name == "map" {
        var lenArgs: Vec<JSValue> = Vec.new()
        lenArgs.push(JSValue.Number(n as f64))
        let out = makeTypedArray(prog, st, kind, lenArgs)
        let oh = objHandle(out)
        pushTemp(st, cloneValue(out))
        var i: i64 = 0
        while i < n && !st.throwing {
            var cbArgs: Vec<JSValue> = Vec.new()
            cbArgs.push(JSValue.Number(taElem(st, o, i)))
            cbArgs.push(JSValue.Number(i as f64))
            let r = callValue(prog, args[0], cbArgs, JSValue.Undefined, st)
            taSetElem(st, oh, i, toNum(r))
            i = i + 1
        }
        popTemp(st)
        return out
    }
    if name == "filter" {
        var kept: Vec<f64> = Vec.new()
        var i: i64 = 0
        while i < n && !st.throwing {
            let e = taElem(st, o, i)
            var cbArgs: Vec<JSValue> = Vec.new()
            cbArgs.push(JSValue.Number(e))
            cbArgs.push(JSValue.Number(i as f64))
            if truthy(callValue(prog, args[0], cbArgs, JSValue.Undefined, st)) {
                kept.push(e)
            }
            i = i + 1
        }
        var lenArgs: Vec<JSValue> = Vec.new()
        lenArgs.push(JSValue.Number(kept.len() as f64))
        let out = makeTypedArray(prog, st, kind, lenArgs)
        let oh = objHandle(out)
        var k: i64 = 0
        while k < kept.len() {
            taSetElem(st, oh, k, kept[k])
            k = k + 1
        }
        return out
    }
    if name == "reduce" || name == "reduceRight" {
        let rev = name == "reduceRight"
        var acc = JSValue.Undefined
        var started = false
        if args.len() > 1 {
            acc = cloneValue(args[1])
            started = true
        }
        var c: i64 = 0
        while c < n && !st.throwing {
            let i = if rev {
                n - 1 - c
            } else {
                c
            }
            let e = JSValue.Number(taElem(st, o, i))
            if !started {
                acc = e
                started = true
            } else {
                var cbArgs: Vec<JSValue> = Vec.new()
                cbArgs.push(cloneValue(acc))
                cbArgs.push(e)
                cbArgs.push(JSValue.Number(i as f64))
                acc = callValue(prog, args[0], cbArgs, JSValue.Undefined, st)
            }
            c = c + 1
        }
        return acc
    }
    if name == "find" || name == "findIndex" || name == "some" || name == "every" || name == "findLast" || name == "findLastIndex" {
        let rev = name == "findLast" || name == "findLastIndex"
        var c: i64 = 0
        while c < n && !st.throwing {
            let i = if rev {
                n - 1 - c
            } else {
                c
            }
            let e = taElem(st, o, i)
            var cbArgs: Vec<JSValue> = Vec.new()
            cbArgs.push(JSValue.Number(e))
            cbArgs.push(JSValue.Number(i as f64))
            let hit = truthy(callValue(prog, args[0], cbArgs, JSValue.Undefined, st))
            if name == "some" && hit {
                return JSValue.Bool(true)
            }
            if name == "every" && !hit {
                return JSValue.Bool(false)
            }
            if (name == "find" || name == "findLast") && hit {
                return JSValue.Number(e)
            }
            if (name == "findIndex" || name == "findLastIndex") && hit {
                return JSValue.Number(i as f64)
            }
            c = c + 1
        }
        if name == "some" {
            return JSValue.Bool(false)
        }
        if name == "every" {
            return JSValue.Bool(true)
        }
        if name == "find" || name == "findLast" {
            return JSValue.Undefined
        }
        return JSValue.Number(0.0 - 1.0)
    }
    if name == "with" {
        // a copy with one element replaced (negative index from the end)
        var idx: i64 = 0
        if args.len() > 0 {
            idx = toNum(args[0]) as i64
        }
        if idx < 0 {
            idx = n + idx
        }
        var lenArgs: Vec<JSValue> = Vec.new()
        lenArgs.push(JSValue.Number(n as f64))
        let out = makeTypedArray(prog, st, kind, lenArgs)
        let oh = objHandle(out)
        pushTemp(st, cloneValue(out))
        var i: i64 = 0
        while i < n {
            if i == idx && args.len() > 1 {
                taSetElem(st, oh, i, toNum(args[1]))
            } else {
                taSetElem(st, oh, i, taElem(st, o, i))
            }
            i = i + 1
        }
        popTemp(st)
        return out
    }
    if name == "reverse" {
        var i: i64 = 0
        while i < n / 2 {
            let tmp = taElem(st, o, i)
            taSetElem(st, o, i, taElem(st, o, n - 1 - i))
            taSetElem(st, o, n - 1 - i, tmp)
            i = i + 1
        }
        return JSValue.Obj(o)
    }
    if name == "copyWithin" {
        // copies WITHIN the same buffer, so the ranges may overlap — snapshot
        // the source before writing, exactly as memmove would
        var tgt = relIndex(toNum(args[0]), n)
        var cs: i64 = 0
        if args.len() > 1 {
            cs = relIndex(toNum(args[1]), n)
        }
        var ce = n
        if args.len() > 2 && !(args[2] is JSValue.Undefined) {
            ce = relIndex(toNum(args[2]), n)
        }
        var snap: Vec<f64> = Vec.new()
        var si = cs
        while si < ce {
            snap.push(taElem(st, o, si))
            si = si + 1
        }
        var k: i64 = 0
        while k < snap.len() && tgt + k < n {
            taSetElem(st, o, tgt + k, snap[k])
            k = k + 1
        }
        return JSValue.Obj(o)
    }
    if name == "lastIndexOf" {
        if args.len() == 0 || n == 0 {
            return JSValue.Number(-1.0)
        }
        let needle = toNum(args[0])
        var from = n - 1
        if args.len() > 1 {
            let raw = toNum(args[1])
            if raw < 0.0 {
                from = n + (raw as i64)
            } else {
                from = raw as i64
            }
            if from >= n {
                from = n - 1
            }
        }
        var i = from
        while i >= 0 {
            if taElem(st, o, i) == needle {
                return JSValue.Number(i as f64)
            }
            i = i - 1
        }
        return JSValue.Number(-1.0)
    }
    if name == "keys" || name == "values" || name == "entries" || name == symIteratorKey() {
        // snapshot into a plain array and hand back the shared array iterator,
        // so for-of / spread / Array.from / .next() all work the same way
        let snapArr = newArray(st)
        pushTemp(st, JSValue.Obj(snapArr))
        var i: i64 = 0
        while i < n {
            arrPush(st, snapArr, JSValue.Number(taElem(st, o, i)))
            i = i + 1
        }
        var iterKind: i64 = 0
        if name == "keys" {
            iterKind = 1
        } else if name == "entries" {
            iterKind = 2
        }
        let it = makeArrayIterator(st, snapArr, iterKind)
        popTemp(st)
        return it
    }
    if name == "toReversed" {
        var lenArgs: Vec<JSValue> = Vec.new()
        lenArgs.push(JSValue.Number(n as f64))
        let out = makeTypedArray(prog, st, kind, lenArgs)
        let oh = objHandle(out)
        pushTemp(st, cloneValue(out))
        var i: i64 = 0
        while i < n {
            taSetElem(st, oh, i, taElem(st, o, n - 1 - i))
            i = i + 1
        }
        popTemp(st)
        return out
    }
    if name == "toSorted" {
        var lenArgs: Vec<JSValue> = Vec.new()
        lenArgs.push(JSValue.Number(n as f64))
        let out = makeTypedArray(prog, st, kind, lenArgs)
        let oh = objHandle(out)
        pushTemp(st, cloneValue(out))
        var c: i64 = 0
        while c < n {
            taSetElem(st, oh, c, taElem(st, o, c))
            c = c + 1
        }
        var srtArgs: Vec<JSValue> = Vec.new()
        if args.len() > 0 {
            srtArgs.push(cloneValue(args[0]))
        }
        let _srt = typedArrayMethod(prog, oh, "sort", srtArgs, st)
        popTemp(st)
        return out
    }
    if name == "toLocaleString" {
        // no locale support here: the spec calls each element's toLocaleString,
        // which for a plain number is its ordinary string form
        var out = ""
        var i: i64 = 0
        while i < n {
            if i > 0 {
                out = out + ","
            }
            out = out + toStr(JSValue.Number(taElem(st, o, i)))
            i = i + 1
        }
        return JSValue.Str(out)
    }
    if name == "sort" {
        // numeric ascending by default; a comparator (args[0]) overrides. Simple
        // insertion sort over the element values (typed arrays are usually small).
        var i: i64 = 1
        while i < n && !st.throwing {
            let cur = taElem(st, o, i)
            var j = i - 1
            var cont = true
            while j >= 0 && cont {
                let ej = taElem(st, o, j)
                var swap = ej > cur
                if args.len() > 0 && isCallableIn(st, args[0]) {
                    var cbArgs: Vec<JSValue> = Vec.new()
                    cbArgs.push(JSValue.Number(ej))
                    cbArgs.push(JSValue.Number(cur))
                    swap = toNum(callValue(prog, args[0], cbArgs, JSValue.Undefined, st)) > 0.0
                }
                if swap {
                    taSetElem(st, o, j + 1, ej)
                    j = j - 1
                } else {
                    cont = false
                }
            }
            taSetElem(st, o, j + 1, cur)
            i = i + 1
        }
        return JSValue.Obj(o)
    }
    return JSValue.Undefined
}

fn isDataViewMethodName(n: &string): bool {
    return n == "getInt8" || n == "getUint8" || n == "getInt16" || n == "getUint16" || n == "getInt32" || n == "getUint32" || n == "getFloat32" || n == "getFloat64" || n == "setInt8" || n == "setUint8" || n == "setInt16" || n == "setUint16" || n == "setInt32" || n == "setUint32" || n == "setFloat32" || n == "setFloat64"
}

// DataView get/set. Default endianness is BIG-endian (the littleEndian arg
// defaults false), unlike typed arrays which store host/little-endian. taLen is
// the view's byte length here; taBuf/taOffset locate it in the backing buffer.
fn dataViewMethod(o: i64, name: &string, args: &Vec<JSValue>, st: &mut Interp): JSValue {
    var width: i64 = 1
    var isFloat = false
    var signed = false
    if name == "getInt16" || name == "setInt16" || name == "getUint16" || name == "setUint16" {
        width = 2
    } else if name == "getInt32" || name == "setInt32" || name == "getUint32" || name == "setUint32" {
        width = 4
    } else if name == "getFloat32" || name == "setFloat32" {
        width = 4
        isFloat = true
    } else if name == "getFloat64" || name == "setFloat64" {
        width = 8
        isFloat = true
    }
    if name == "getInt8" || name == "setInt8" || name == "getInt16" || name == "setInt16" || name == "getInt32" || name == "setInt32" {
        signed = true
    }
    // "set..." starts with 's' (115), "get..." with 'g'
    let isSet = name.len() > 0 && name[0] == 115
    var byteOffset: i64 = 0
    if args.len() > 0 {
        byteOffset = toNum(args[0]) as i64
    }
    if byteOffset < 0 || byteOffset + width > st.objExtras[st.objects[o].extra].taLen {
        st.throwing = true
        st.thrownValue = makeError(st, "RangeError", "Offset is outside the bounds of the DataView")
        return JSValue.Undefined
    }
    let buf = st.objExtras[st.objects[o].extra].taBuf
    let absPos = st.objExtras[st.objects[o].extra].taOffset + byteOffset
    if isSet {
        var value: f64 = 0.0
        if args.len() > 1 {
            value = toNum(args[1])
        }
        var littleEndian = false
        if args.len() > 2 {
            littleEndian = truthy(args[2])
        }
        var bits: i64 = 0
        if isFloat {
            if width == 8 {
                bits = f64ToBits(value)
            } else {
                bits = f32ToBits(value)
            }
        } else {
            bits = value as i64
        }
        var i: i64 = 0
        while i < width {
            var shift = 8 * i
            if !littleEndian {
                shift = 8 * (width - 1 - i)
            }
            st.objExtras[st.objects[buf].extra].bytes[absPos + i] = ((bits >> shift) & 255) as u8
            i = i + 1
        }
        return JSValue.Undefined
    }
    var littleEndian = false
    if args.len() > 1 {
        littleEndian = truthy(args[1])
    }
    var bits: i64 = 0
    var i: i64 = 0
    while i < width {
        var shift = 8 * i
        if !littleEndian {
            shift = 8 * (width - 1 - i)
        }
        bits = bits | ((st.objExtras[st.objects[buf].extra].bytes[absPos + i] as i64) << shift)
        i = i + 1
    }
    if isFloat {
        if width == 8 {
            return JSValue.Number(bitsToF64(bits))
        }
        return JSValue.Number(bitsToF32(bits))
    }
    if signed {
        let signbit = (1 as i64) << (8 * width - 1)
        if (bits & signbit) != 0 {
            bits = bits - ((1 as i64) << (8 * width))
        }
    }
    return JSValue.Number(bits as f64)
}

fn dateProtoMethodNames(): Vec<string> {
    var out: Vec<string> = Vec.new()
    // the full Date.prototype surface, taken from node
    out.push("toString")
    out.push("toDateString")
    out.push("toTimeString")
    out.push("toISOString")
    out.push("toUTCString")
    out.push("toGMTString")
    out.push("getDate")
    out.push("setDate")
    out.push("getDay")
    out.push("getFullYear")
    out.push("setFullYear")
    out.push("getHours")
    out.push("setHours")
    out.push("getMilliseconds")
    out.push("setMilliseconds")
    out.push("getMinutes")
    out.push("setMinutes")
    out.push("getMonth")
    out.push("setMonth")
    out.push("getSeconds")
    out.push("setSeconds")
    out.push("getTime")
    out.push("setTime")
    out.push("getTimezoneOffset")
    out.push("getUTCDate")
    out.push("setUTCDate")
    out.push("getUTCDay")
    out.push("getUTCFullYear")
    out.push("setUTCFullYear")
    out.push("getUTCHours")
    out.push("setUTCHours")
    out.push("getUTCMilliseconds")
    out.push("setUTCMilliseconds")
    out.push("getUTCMinutes")
    out.push("setUTCMinutes")
    out.push("getUTCMonth")
    out.push("setUTCMonth")
    out.push("getUTCSeconds")
    out.push("setUTCSeconds")
    out.push("valueOf")
    out.push("getYear")
    out.push("setYear")
    out.push("toJSON")
    out.push("toLocaleString")
    out.push("toLocaleDateString")
    out.push("toLocaleTimeString")
    return out
}

fn strProtoMethodNames(): Vec<string> {
    var out: Vec<string> = Vec.new()
    out.push("replace")
    out.push("split")
    out.push("slice")
    out.push("substring")
    out.push("substr")
    out.push("indexOf")
    out.push("lastIndexOf")
    out.push("charAt")
    out.push("charCodeAt")
    out.push("toUpperCase")
    out.push("toLowerCase")
    out.push("toLocaleUpperCase")
    out.push("toLocaleLowerCase")
    out.push("isWellFormed")
    out.push("toWellFormed")
    // These dispatched by name but were absent from the prototype, so
    // `typeof "".matchAll` was "undefined" and every test262 case that starts
    // from String.prototype failed before calling anything: matchAll was 0/25
    // for that reason alone, not for 25 defects.
    out.push("codePointAt")
    out.push("at")
    out.push("replaceAll")
    out.push("localeCompare")
    out.push("normalize")
    out.push("matchAll")
    out.push("trim")
    out.push("trimStart")
    out.push("trimEnd")
    out.push("startsWith")
    out.push("endsWith")
    out.push("includes")
    out.push("repeat")
    out.push("padStart")
    out.push("padEnd")
    out.push("concat")
    out.push("match")
    out.push("search")
    out.push("toString")
    out.push("valueOf")
    return out
}

// Function.prototype.length: the count of parameters before the first one with
// a default or a rest parameter. milojs does not record defaults per-param, so
// this counts declared params minus a trailing rest — enough for express, which
// only checks length === 4 to detect error-handler middleware.
fn funcArity(prog: &Prog, fIdx: i64): i64 {
    var n = prog.funcs[fIdx].params.len()
    if prog.funcs[fIdx].restFrom >= 0 {
        n = prog.funcs[fIdx].restFrom
    }
    return n
}

fn isSuperName(name: &string): bool {
    if name.len() < 8 {
        return false
    }
    return name[0] == '_' && name[1] == '_' && name[2] == 's' && name[3] == 'u' && name[4] == 'p' && name[5] == 'e' && name[6] == 'r' && name[7] == '$'
}

fn instantiateClass(prog: &Prog, classIdx: i64, st: &mut Interp, scope: i64): JSValue {
    var ctorFn = prog.classes[classIdx].ctorFn
    if ctorFn < 0 {
        // no declared constructor — reuse an empty one so the class is callable
        ctorFn = prog.classes[classIdx].defaultCtor
    }
    // A named class expression binds its own name inside the class body, in a
    // scope of its own: `X = class e { static empty() { return new e } }` — `e`
    // exists only in there, and prisma's runtime is built out of exactly this.
    // Methods and the constructor close over this scope rather than the defining
    // one; the super binding lives here too, so it can't be seen by siblings.
    let classScope = newScope(st, scope)
    pushActive(st, classScope)
    let classVal = JSValue.Func(ctorFn, classScope)
    let className = prog.classes[classIdx].name.clone()
    if className.len() > 0 {
        scopeDefine(st, classScope, className, JSValue.Func(ctorFn, classScope))
    }
    let proto = getFuncProto(st, ctorFn)
    linkProtoConstructor(st, proto, ctorFn, classScope)
    let superName = prog.classes[classIdx].superName.clone()
    if superName.len() > 0 {
        let baseVal = scopeLookup(st, scope, superName)
        let baseFn = funcHandle(baseVal)
        if baseFn >= 0 {
            let baseProto = getFuncProto(st, baseFn)
            st.objects[proto].proto = baseProto
            // Statics are inherited too: `class D extends B {}` makes D.staticOfB
            // resolve. Only the instance side was linked, so a static method or
            // accessor declared on the base was invisible on the subclass.
            var baseEnv: i64 = -1
            match baseVal {
                JSValue.Func(_bf, be) => {
                    baseEnv = be
                }
                _ => {
                }
            }
            let baseStatics = getFuncStatics(st, baseFn, baseEnv)
            let ownStatics = getFuncStatics(st, ctorFn, classScope)
            st.objects[ownStatics].proto = baseStatics
        }
        scopeDefine(st, classScope, "__super$" + prog.classes[classIdx].superKey.clone(), baseVal)
    }
    var i: i64 = 0
    while i < prog.classes[classIdx].members.len() {
        var mName = prog.classes[classIdx].members[i].name.clone()
        // a computed key (`[Symbol.iterator]() {}`) is evaluated once here, in the
        // class scope, exactly as an object literal evaluates its computed keys
        match prog.classes[classIdx].members[i].keyExpr {
            Option.Some(keyExprId) => {
                mName = toStr(evalExpr(prog, keyExprId, st, classScope))
            }
            Option.None => {
            }
        }
        let mFn = prog.classes[classIdx].members[i].fnIdx
        let mv = JSValue.Func(mFn, classScope)
        let mKind = prog.classes[classIdx].members[i].kind
        var target = proto
        if prog.classes[classIdx].members[i].isStatic {
            target = getFuncStatics(st, ctorFn, classScope)
        }
        if mKind > 0 {
            let existing = objOwnIndex(st, target, mName)
            var g = JSValue.Undefined
            var sfn = JSValue.Undefined
            if existing >= 0 && propIsAccessor(st, target, existing) {
                g = accGetter(st, st.objects[target].props[existing].acc)
                sfn = accSetter(st, st.objects[target].props[existing].acc)
            }
            if mKind == 1 {
                g = mv
            } else {
                sfn = mv
            }
            objDefineAccessor(st, target, mName, g, sfn)
        } else {
            objSet(st, target, mName, mv)
        }
        i = i + 1
    }
    // static field initializers, evaluated in the class scope (so they can see
    // the class binding and static methods) and set on the constructor object
    var sf: i64 = 0
    while sf < prog.classes[classIdx].staticFieldNames.len() {
        let sfName = prog.classes[classIdx].staticFieldNames[sf].clone()
        let sfInit = prog.classes[classIdx].staticFieldInits[sf]
        let statics = getFuncStatics(st, ctorFn, classScope)
        let sfVal = evalExpr(prog, sfInit, st, classScope)
        if sfName.len() == 0 {
            // a `static { }` block, not a field: run it with `this` bound to the
            // class and keep nothing
            var sbArgs: Vec<JSValue> = Vec.new()
            let _r = callValue(prog, sfVal, sbArgs, cloneValue(classVal), st)
        } else {
            objSet(st, statics, sfName, sfVal)
        }
        sf = sf + 1
    }
    popActive(st)
    return classVal
}

fn callValue(prog: &Prog, fnVal: &JSValue, args: Vec<JSValue>, thisVal: JSValue, st: &mut Interp): JSValue {
    match fnVal {
        JSValue.Func(fIdx, envIdx) => {
            return callFunction(prog, fIdx, envIdx, args, thisVal, st)
        }
        JSValue.Native(id) => {
            return callNativeProg(prog, id, args, st)
        }
        JSValue.Obj(o) => {
            if st.objects[o].isProxy {
                let trap = proxyTrap(st, o, "apply")
                let target = cloneValue(st.objExtras[st.objects[o].extra].proxyTarget)
                if isCallableIn(st, trap) {
                    // apply(target, thisArg, argsArray)
                    let arr = newArray(st)
                    var i: i64 = 0
                    while i < args.len() {
                        st.objects[arr].elems.push(cloneValue(args[i]))
                        i = i + 1
                    }
                    var targs: Vec<JSValue> = Vec.new()
                    targs.push(cloneValue(target))
                    targs.push(cloneValue(thisVal))
                    targs.push(JSValue.Obj(arr))
                    return callValue(prog, trap, targs, cloneValue(st.objExtras[st.objects[o].extra].proxyHandler), st)
                }
                return callValue(prog, target, args, thisVal, st)
            }
            // implemented by a loaded node-api addon: dispatch to its C callback
            if st.objExtras[st.objects[o].extra].napiFn >= 0 {
                let r = napiInvoke(st.objExtras[st.objects[o].extra].napiFn, args, thisVal)
                napiDrainSettlements(st)
                return r
            }
            // a bind() result: the captured receiver wins over the call site's
            if st.objects[o].isBound {
                let ex = st.objects[o].extra
                if st.objExtras[ex].boundMethod.len() > 0 {
                    let mname = st.objExtras[ex].boundMethod.clone()
                    var recvV = cloneValue(st.objExtras[ex].boundThis)
                    // an unbound builtin method (Object.prototype.toString stored
                    // with no bound this) takes the call-site receiver, so
                    // ({}).toString() gets `this` = {} rather than undefined
                    if !isBoundThisSet(st, o) {
                        recvV = cloneValue(thisVal)
                    }
                    if !brandOk(st, o, mname, recvV) {
                        return JSValue.Undefined
                    }
                    recvV = coerceGenericStringReceiver(prog, st, o, recvV)
                    if st.throwing {
                        return JSValue.Undefined
                    }
                    return callBuiltinByName(prog, recvV, mname, args, st)
                }
                let target = cloneValue(st.objExtras[ex].boundTarget)
                let boundThis = cloneValue(st.objExtras[ex].boundThis)
                var merged: Vec<JSValue> = Vec.new()
                var b: i64 = 0
                while b < st.objExtras[ex].boundArgs.len() {
                    merged.push(cloneValue(st.objExtras[ex].boundArgs[b]))
                    b = b + 1
                }
                var a: i64 = 0
                while a < args.len() {
                    merged.push(cloneValue(args[a]))
                    a = a + 1
                }
                return callValue(prog, target, merged, boundThis, st)
            }
            return JSValue.Undefined
        }
        _ => {
            return JSValue.Undefined
        }
    }
}

// Node-API's synchronous callback into JavaScript. This adapter lives beside
// callValue rather than in napi.milo because the evaluator already imports the
// Node-API layer; importing the evaluator back from there would create a cycle.
@externalLinkage
fn napi_call_function(_env: *u8, recv: i64, func: i64, argc: i64, argv: *u8, result: *u8): i32 {
    if argc < 0 || (argc > 0 && argv as i64 == 0) {
        return NAPI_INVALID_ARG
    }
    let fnVal = napiValueOf(func)
    if !isCallableIn(gInterp, fnVal) {
        return NAPI_INVALID_ARG
    }
    var args: Vec<JSValue> = Vec.new()
    var i: i64 = 0
    while i < argc {
        var handle: i64 = 0
        unsafe {
            handle = napiLoadI64(((argv as i64) + i * 8) as *u8)
        }
        args.push(napiValueOf(handle))
        i = i + 1
    }
    let returned = callValue(gProg, fnVal, args, napiValueOf(recv), gInterp)
    if gInterp.throwing {
        return NAPI_PENDING_EXCEPTION
    }
    if result as i64 != 0 {
        napiWriteHandle(result, napiHandle(returned))
    }
    return NAPI_OK
}

// The (element, index, array) triple JS array-iteration callbacks receive.
// The optional `thisArg` that map/filter/forEach/some/every/find/flatMap take
// after their callback, and which the callback then runs with as `this`.
// reduce/reduceRight are deliberately NOT in that group: their second argument
// is the initial accumulator, so they always call with `this === undefined`.
fn cbThisArg(args: &Vec<JSValue>): JSValue {
    if args.len() > 1 {
        return cloneValue(args[1])
    }
    return JSValue.Undefined
}

fn makeCbArgs(st: &Interp, o: i64, i: i64): Vec<JSValue> {
    var v: Vec<JSValue> = Vec.new()
    v.push(arrGet(st, o, i))
    v.push(JSValue.Number(i as f64))
    // on a scratch array adapting an array-like receiver, the spec hands the
    // callback the ORIGINAL object, not the copy the method is walking
    let orig = st.objExtras[st.objects[o].extra].arrayLikeOrig
    if orig >= 0 {
        v.push(JSValue.Obj(orig))
    } else {
        v.push(JSValue.Obj(o))
    }
    return v
}

// Map and Set share one entry list; a Set just stores true as every value.
// Call a method by name on a user object (set-like argument plumbing).
fn callObjMethod(prog: &Prog, st: &mut Interp, recv: &JSValue, name: &string, args: Vec<JSValue>): JSValue {
    let h = objHandle(recv)
    if h < 0 {
        return JSValue.Undefined
    }
    let f = getMember(st, h, name)
    if !isCallableIn(st, f) {
        st.throwing = true
        st.thrownValue = makeError(st, "TypeError", name.clone() + " is not a function")
        return JSValue.Undefined
    }
    return callValue(prog, f, args, cloneValue(recv), st)
}

// The set-methods proposal takes "set-like" objects: {size, has, keys}. `size` is
// validated first and its diagnostics must name `.size`, which the suite checks.
// Returns the size, or -1.0 after throwing.
fn setLikeSize(_prog: &Prog, st: &mut Interp, other: &JSValue): f64 {
    let h = objHandle(other)
    if h < 0 {
        st.throwing = true
        st.thrownValue = makeError(st, "TypeError", "set-like argument has no .size")
        return 0.0 - 1.0
    }
    // a real Set answers .size itself
    if st.objects[h].isSet || st.objects[h].isMap {
        return st.objExtras[st.objects[h].extra].mapKeys.len() as f64
    }
    let sv = getMember(st, h, "size")
    let n = toNum(sv)
    if n != n {
        st.throwing = true
        st.thrownValue = makeError(st, "TypeError", "set-like argument has a NaN .size")
        return 0.0 - 1.0
    }
    if n < 0.0 {
        st.throwing = true
        st.thrownValue = makeError(st, "RangeError", "set-like argument has a negative .size")
        return 0.0 - 1.0
    }
    return n
}

// other.keys() — the iterator a set-like exposes.
fn setLikeKeys(prog: &Prog, st: &mut Interp, other: &JSValue): JSValue {
    let h = objHandle(other)
    if h >= 0 && (st.objects[h].isSet || st.objects[h].isMap) {
        var noArgs: Vec<JSValue> = Vec.new()
        return mapMethod(prog, h, "keys", noArgs, st)
    }
    var noArgs: Vec<JSValue> = Vec.new()
    return callObjMethod(prog, st, other, "keys", noArgs)
}

// One step of an iterator: returns done via the out-param slot.
fn iterStep(prog: &Prog, st: &mut Interp, iter: &JSValue, done: &mut bool): JSValue {
    var noArgs: Vec<JSValue> = Vec.new()
    let step = callObjMethod(prog, st, iter, "next", noArgs)
    let sh = objHandle(step)
    if sh < 0 || st.throwing {
        done = true
        return JSValue.Undefined
    }
    // getMemberDyn: `done`/`value` may be accessors, and a plain read never
    // invokes them — a throwing `value` getter then looked like an endless
    // stream of undefined values
    done = truthy(getMemberDyn(prog, sh, "done", st))
    if done || st.throwing {
        done = true
        return JSValue.Undefined
    }
    let dv = getMemberDyn(prog, sh, "value", st)
    if st.throwing {
        done = true
        return JSValue.Undefined
    }
    return dv
}

// Closing an iterator early is observable (the suite counts return() calls), so
// every early exit from a set method has to do it.
fn iterClose(prog: &Prog, st: &mut Interp, iter: &JSValue) {
    let h = objHandle(iter)
    if h < 0 {
        return
    }
    let f = getMember(st, h, "return")
    if isCallableIn(st, f) {
        var noArgs: Vec<JSValue> = Vec.new()
        let _ = callValue(prog, f, noArgs, cloneValue(iter), st)
    }
}

fn setHasValue(st: &Interp, o: i64, v: &JSValue): bool {
    return mapFind(st, o, v) >= 0
}

// `other.has(v)` where other may be a real Set (whose `has` is native dispatch,
// not a property) or a user set-like (where it is a property).
fn setLikeHas(prog: &Prog, st: &mut Interp, other: &JSValue, v: &JSValue): bool {
    let h = objHandle(other)
    if h >= 0 && (st.objects[h].isSet || st.objects[h].isMap) {
        return mapFind(st, h, v) >= 0
    }
    var hargs: Vec<JSValue> = Vec.new()
    hargs.push(cloneValue(v))
    return truthy(callObjMethod(prog, st, other, "has", hargs))
}

fn mapMethod(prog: &Prog, o: i64, name: &string, args: &Vec<JSValue>, st: &mut Interp): JSValue {
    // `m[Symbol.iterator]()` written as one expression dispatches by the symbol
    // KEY rather than through the member read, so the key has to resolve here
    // too. Extracting the method first and calling it took the other path and
    // worked, which is why this only showed up on the direct form.
    if name == symIteratorKey() {
        if st.objects[o].isSet {
            return mapMethod(prog, o, "values", args, st)
        }
        return mapMethod(prog, o, "entries", args, st)
    }
    let isSet = st.objects[o].isSet
    if name == "get" {
        var key = JSValue.Undefined
        if args.len() > 0 {
            key = cloneValue(args[0])
        }
        let at = mapFind(st, o, key)
        if at < 0 {
            return JSValue.Undefined
        }
        return cloneValue(st.objExtras[st.objects[o].extra].mapVals[at])
    }
    if name == "set" || name == "add" {
        var key = JSValue.Undefined
        if args.len() > 0 {
            key = cloneValue(args[0])
        }
        var val = JSValue.Bool(true)
        if !isSet && args.len() > 1 {
            val = cloneValue(args[1])
        }
        mapPut(st, o, key, val)
        return JSValue.Obj(o)
    }
    if name == "has" {
        var key = JSValue.Undefined
        if args.len() > 0 {
            key = cloneValue(args[0])
        }
        return JSValue.Bool(mapFind(st, o, key) >= 0)
    }
    if name == "delete" {
        var key = JSValue.Undefined
        if args.len() > 0 {
            key = cloneValue(args[0])
        }
        let at = mapFind(st, o, key)
        if at < 0 {
            return JSValue.Bool(false)
        }
        var nk: Vec<JSValue> = Vec.new()
        var nv: Vec<JSValue> = Vec.new()
        var i: i64 = 0
        while i < st.objExtras[st.objects[o].extra].mapKeys.len() {
            if i != at {
                nk.push(cloneValue(st.objExtras[st.objects[o].extra].mapKeys[i]))
                nv.push(cloneValue(st.objExtras[st.objects[o].extra].mapVals[i]))
            }
            i = i + 1
        }
        st.objExtras[st.objects[o].extra].mapKeys = nk
        st.objExtras[st.objects[o].extra].mapVals = nv
        return JSValue.Bool(true)
    }
    if name == "clear" {
        st.objExtras[st.objects[o].extra].mapKeys = Vec.new()
        st.objExtras[st.objects[o].extra].mapVals = Vec.new()
        return JSValue.Undefined
    }
    if name == "isSupersetOf" || name == "isSubsetOf" || name == "isDisjointFrom" || name == "union" || name == "intersection" || name == "difference" {
        var other = JSValue.Undefined
        if args.len() > 0 {
            other = cloneValue(args[0])
        }
        let osize = setLikeSize(prog, st, other)
        if st.throwing {
            return JSValue.Undefined
        }
        let mine = st.objExtras[st.objects[o].extra].mapKeys.len() as f64

        if name == "isSupersetOf" {
            if mine < osize {
                return JSValue.Bool(false)
            }
            let iter = setLikeKeys(prog, st, other)
            pushTemp(st, cloneValue(iter))
            var done = false
            var ok = true
            while !done && !st.throwing {
                let v = iterStep(prog, st, iter, done)
                if !done && !setHasValue(st, o, v) {
                    iterClose(prog, st, iter)
                    ok = false
                    done = true
                }
            }
            popTemp(st)
            return JSValue.Bool(ok)
        }
        if name == "isSubsetOf" {
            if mine > osize {
                return JSValue.Bool(false)
            }
            var i: i64 = 0
            while i < st.objExtras[st.objects[o].extra].mapKeys.len() && !st.throwing {
                let mk = cloneValue(st.objExtras[st.objects[o].extra].mapKeys[i])
                if !setLikeHas(prog, st, other, mk) {
                    return JSValue.Bool(false)
                }
                i = i + 1
            }
            return JSValue.Bool(true)
        }
        if name == "isDisjointFrom" {
            // walk whichever side is smaller; only the other-side walk uses an
            // iterator, which is what makes the suite's call counts meaningful
            if mine <= osize {
                var i: i64 = 0
                while i < st.objExtras[st.objects[o].extra].mapKeys.len() && !st.throwing {
                    let mk = cloneValue(st.objExtras[st.objects[o].extra].mapKeys[i])
                    if setLikeHas(prog, st, other, mk) {
                        return JSValue.Bool(false)
                    }
                    i = i + 1
                }
                return JSValue.Bool(true)
            }
            let iter = setLikeKeys(prog, st, other)
            pushTemp(st, cloneValue(iter))
            var done = false
            var disjoint = true
            while !done && !st.throwing {
                let v = iterStep(prog, st, iter, done)
                if !done && setHasValue(st, o, v) {
                    iterClose(prog, st, iter)
                    disjoint = false
                    done = true
                }
            }
            popTemp(st)
            return JSValue.Bool(disjoint)
        }
        // union / intersection / difference all build a fresh Set
        let res = newObject(st)
        st.objects[res].isSet = true
        if st.setProtoObj >= 0 {
            st.objects[res].proto = st.setProtoObj
        }
        let _re = ensureExtra(st, res)
        pushTemp(st, JSValue.Obj(res))
        if name == "union" {
            var i: i64 = 0
            while i < st.objExtras[st.objects[o].extra].mapKeys.len() {
                mapPut(st, res, cloneValue(st.objExtras[st.objects[o].extra].mapKeys[i]), JSValue.Bool(true))
                i = i + 1
            }
            let iter = setLikeKeys(prog, st, other)
            pushTemp(st, cloneValue(iter))
            var done = false
            while !done && !st.throwing {
                let v = iterStep(prog, st, iter, done)
                if !done {
                    mapPut(st, res, v, JSValue.Bool(true))
                }
            }
            popTemp(st)
        } else {
            let wantIn = name == "intersection"
            var i: i64 = 0
            while i < st.objExtras[st.objects[o].extra].mapKeys.len() && !st.throwing {
                let k = cloneValue(st.objExtras[st.objects[o].extra].mapKeys[i])
                let inOther = setLikeHas(prog, st, other, k)
                if inOther == wantIn {
                    mapPut(st, res, k, JSValue.Bool(true))
                }
                i = i + 1
            }
        }
        popTemp(st)
        return JSValue.Obj(res)
    }
    if name == "keys" || name == "values" || name == "entries" {
        // Snapshot into an array, then hand back a real iterator over it — so
        // .next(), the Iterator.prototype helpers, for-of and Array.from all
        // work. (A snapshot, not a live view: mutating the map mid-iteration
        // will not be observed, which JS would show.)
        let arr = newArray(st)
        pushTemp(st, JSValue.Obj(arr))
        var i: i64 = 0
        while i < st.objExtras[st.objects[o].extra].mapKeys.len() {
            let k = cloneValue(st.objExtras[st.objects[o].extra].mapKeys[i])
            let v = cloneValue(st.objExtras[st.objects[o].extra].mapVals[i])
            if name == "keys" {
                arrPush(st, arr, k)
            } else if name == "values" {
                if isSet {
                    arrPush(st, arr, k)
                } else {
                    arrPush(st, arr, v)
                }
            } else {
                let pair = newArray(st)
                pushTemp(st, JSValue.Obj(pair))
                arrPush(st, pair, k)
                if isSet {
                    arrPush(st, pair, cloneValue(st.objExtras[st.objects[o].extra].mapKeys[i]))
                } else {
                    arrPush(st, pair, v)
                }
                popTemp(st)
                arrPush(st, arr, JSValue.Obj(pair))
            }
            i = i + 1
        }
        let it = makeArrayIterator(st, arr, 0)
        popTemp(st)
        return it
    }
    if name == "forEach" {
        if args.len() == 0 {
            return JSValue.Undefined
        }
        let cb = cloneValue(args[0])
        pushTemp(st, cloneValue(cb))
        // The callback may delete entries (including the current one) or add
        // new ones; the backing vecs compact on delete, so a plain i++ would
        // skip the entry that shifted into slot i. Re-sync the cursor against
        // the just-visited key after every call; if that key is gone, resume at
        // the first entry not yet visited (keys are unique, so this is sound).
        var visited: Vec<JSValue> = Vec.new()
        var i: i64 = 0
        while i < st.objExtras[st.objects[o].extra].mapKeys.len() && !st.throwing {
            let k = cloneValue(st.objExtras[st.objects[o].extra].mapKeys[i])
            var v = cloneValue(st.objExtras[st.objects[o].extra].mapVals[i])
            if isSet {
                v = cloneValue(st.objExtras[st.objects[o].extra].mapKeys[i])
            }
            visited.push(cloneValue(k))
            var cbArgs: Vec<JSValue> = Vec.new()
            cbArgs.push(v)
            cbArgs.push(cloneValue(k))
            cbArgs.push(JSValue.Obj(o))
            let _ = callValue(prog, cb, cbArgs, JSValue.Undefined, st)
            if st.throwing {
                break
            }
            if i < st.objExtras[st.objects[o].extra].mapKeys.len() && sameValue(st.objExtras[st.objects[o].extra].mapKeys[i], k) {
                i = i + 1
            } else {
                let j = mapFind(st, o, k)
                if j >= 0 {
                    i = j + 1
                } else {
                    var p: i64 = 0
                    var next = st.objExtras[st.objects[o].extra].mapKeys.len()
                    while p < st.objExtras[st.objects[o].extra].mapKeys.len() {
                        var seen = false
                        var q: i64 = 0
                        while q < visited.len() {
                            if sameValue(st.objExtras[st.objects[o].extra].mapKeys[p], visited[q]) {
                                seen = true
                                q = visited.len()
                            }
                            q = q + 1
                        }
                        if !seen {
                            next = p
                            p = st.objExtras[st.objects[o].extra].mapKeys.len()
                        }
                        p = p + 1
                    }
                    i = next
                }
            }
        }
        popTemp(st)
        return JSValue.Undefined
    }
    return JSValue.Undefined
}

// Date instance methods. Everything derives from the stored epoch milliseconds.
// ISO-8601 in UTC, the format Date.prototype.toISOString produces.
// Date's own three-letter abbreviations. std/datetime's weekdayName/monthName
// spell the names out in full ("Friday", "January"); Date.prototype.toString and
// toUTCString want "Fri" and "Jan".
fn dateAbbrevDay(wd: i32): string {
    let d = wd as i64
    if d == 0 {
        return "Sun"
    }
    if d == 1 {
        return "Mon"
    }
    if d == 2 {
        return "Tue"
    }
    if d == 3 {
        return "Wed"
    }
    if d == 4 {
        return "Thu"
    }
    if d == 5 {
        return "Fri"
    }
    return "Sat"
}

fn dateAbbrevMonth(m: i32): string {
    let i = m as i64
    if i == 1 {
        return "Jan"
    }
    if i == 2 {
        return "Feb"
    }
    if i == 3 {
        return "Mar"
    }
    if i == 4 {
        return "Apr"
    }
    if i == 5 {
        return "May"
    }
    if i == 6 {
        return "Jun"
    }
    if i == 7 {
        return "Jul"
    }
    if i == 8 {
        return "Aug"
    }
    if i == 9 {
        return "Sep"
    }
    if i == 10 {
        return "Oct"
    }
    if i == 11 {
        return "Nov"
    }
    return "Dec"
}

fn isoFromMillis(ms: f64): string {
    if ms != ms {
        return "Invalid Date"
    }
    let total = (ms / 1000.0) as i64
    let dt = DateTime.fromEpoch(total)
    var frac = Math.mod(ms, 1000.0) as i64
    if frac < 0 {
        frac = frac + 1000
    }
    return i64ToStr(dt.year as i64) + "-" + pad2(dt.month as i64) + "-" + pad2(dt.day as i64) + "T" + pad2(dt.hour as i64) + ":" + pad2(dt.minute as i64) + ":" + pad2(dt.second as i64) + "." + pad3(frac) + "Z"
}

fn dateMethod(st: &mut Interp, o: i64, name: &string, args: &Vec<JSValue>): JSValue {
    let ms = st.objExtras[st.objects[o].extra].dateMs
    if name == "getTime" || name == "valueOf" {
        return JSValue.Number(ms)
    }
    if name == "setTime" {
        var v = 0.0
        if args.len() > 0 {
            v = toNum(args[0])
        }
        st.objExtras[st.objects[o].extra].dateMs = v
        return JSValue.Number(v)
    }
    if name == "toISOString" || name == "toJSON" {
        return JSValue.Str(isoFromMillis(ms))
    }
    // the set*/setUTC* family. milojs keeps dates in UTC with a 0 offset, so the
    // local and UTC setters are equivalent — normalise setUTCFoo -> setFoo. The
    // date is decomposed to civil parts, the requested field(s) replaced, and
    // recomposed to epoch ms.
    var sname = name.clone()
    if sname.len() >= 6 && strSlice(sname, 0, 6) == "setUTC" {
        sname = "set" + strSlice(sname, 6, sname.len())
    }
    if sname == "setFullYear" || sname == "setMonth" || sname == "setDate" || sname == "setHours" || sname == "setMinutes" || sname == "setSeconds" || sname == "setMilliseconds" {
        let secs = (ms / 1000.0) as i64
        let dt = DateTime.fromEpoch(secs)
        var frac = Math.mod(ms, 1000.0) as i64
        if frac < 0 {
            frac = frac + 1000
        }
        var year = dt.year as i64
        var month = dt.month as i64
        var day = dt.day as i64
        var hour = dt.hour as i64
        var minute = dt.minute as i64
        var second = dt.second as i64
        var millis = frac
        if sname == "setFullYear" {
            if args.len() > 0 {
                year = toNum(args[0]) as i64
            }
            if args.len() > 1 {
                month = (toNum(args[1]) as i64) + 1
            }
            if args.len() > 2 {
                day = toNum(args[2]) as i64
            }
        } else if sname == "setMonth" {
            if args.len() > 0 {
                month = (toNum(args[0]) as i64) + 1
            }
            if args.len() > 1 {
                day = toNum(args[1]) as i64
            }
        } else if sname == "setDate" {
            if args.len() > 0 {
                day = toNum(args[0]) as i64
            }
        } else if sname == "setHours" {
            if args.len() > 0 {
                hour = toNum(args[0]) as i64
            }
            if args.len() > 1 {
                minute = toNum(args[1]) as i64
            }
            if args.len() > 2 {
                second = toNum(args[2]) as i64
            }
            if args.len() > 3 {
                millis = toNum(args[3]) as i64
            }
        } else if sname == "setMinutes" {
            if args.len() > 0 {
                minute = toNum(args[0]) as i64
            }
            if args.len() > 1 {
                second = toNum(args[1]) as i64
            }
            if args.len() > 2 {
                millis = toNum(args[2]) as i64
            }
        } else if sname == "setSeconds" {
            if args.len() > 0 {
                second = toNum(args[0]) as i64
            }
            if args.len() > 1 {
                millis = toNum(args[1]) as i64
            }
        } else if sname == "setMilliseconds" {
            if args.len() > 0 {
                millis = toNum(args[0]) as i64
            }
        }
        let days = daysFromCivil(year, month, day)
        let newMs = ((days * 86400 + hour * 3600 + minute * 60 + second) * 1000 + millis) as f64
        st.objExtras[st.objects[o].extra].dateMs = newMs
        return JSValue.Number(newMs)
    }
    // getUTC* mirrors the local accessors but decomposes in UTC; normalise
    // getUTCFoo -> getFoo for the branch match and pick the decomposition by
    // whether the caller asked for UTC.
    // The RFC 7231 form used by toUTCString/toGMTString, e.g.
    // "Fri, 15 May 2020 10:30:45 GMT" — timezone-independent by definition.
    if name == "toUTCString" || name == "toGMTString" {
        if ms != ms {
            return JSValue.Str("Invalid Date")
        }
        let u = DateTime.fromEpoch((ms / 1000.0) as i64)
        return JSValue.Str(dateAbbrevDay(u.weekday) + ", " + pad2(u.day as i64) + " " + dateAbbrevMonth(u.month) + " " + i64ToStr(u.year as i64) + " " + pad2(u.hour as i64) + ":" + pad2(u.minute as i64) + ":" + pad2(u.second as i64) + " GMT")
    }
    // toString / toDateString / toTimeString. node renders these in the host
    // timezone; with no timezone database these are the UTC rendering, which is
    // what node prints under TZ=UTC.
    if name == "toString" || name == "toDateString" || name == "toTimeString" {
        if ms != ms {
            return JSValue.Str("Invalid Date")
        }
        let u = DateTime.fromEpoch((ms / 1000.0) as i64)
        let datePart = dateAbbrevDay(u.weekday) + " " + dateAbbrevMonth(u.month) + " " + pad2(u.day as i64) + " " + i64ToStr(u.year as i64)
        let timePart = pad2(u.hour as i64) + ":" + pad2(u.minute as i64) + ":" + pad2(u.second as i64) + " GMT+0000 (Coordinated Universal Time)"
        if name == "toDateString" {
            return JSValue.Str(datePart)
        }
        if name == "toTimeString" {
            return JSValue.Str(timePart)
        }
        return JSValue.Str(datePart + " " + timePart)
    }
    // node's default locale output (en-US), rendered in UTC like everything else
    if name == "toLocaleString" || name == "toLocaleDateString" || name == "toLocaleTimeString" {
        if ms != ms {
            return JSValue.Str("Invalid Date")
        }
        let u = DateTime.fromEpoch((ms / 1000.0) as i64)
        let dpart = i64ToStr(u.month as i64) + "/" + i64ToStr(u.day as i64) + "/" + i64ToStr(u.year as i64)
        var h12 = (u.hour as i64) % 12
        if h12 == 0 {
            h12 = 12
        }
        var ampm = "AM"
        if (u.hour as i64) >= 12 {
            ampm = "PM"
        }
        let tpart = i64ToStr(h12) + ":" + pad2(u.minute as i64) + ":" + pad2(u.second as i64) + " " + ampm
        if name == "toLocaleDateString" {
            return JSValue.Str(dpart)
        }
        if name == "toLocaleTimeString" {
            return JSValue.Str(tpart)
        }
        return JSValue.Str(dpart + ", " + tpart)
    }
    // the legacy annex-B pair: getYear is the year minus 1900
    if name == "getYear" {
        if ms != ms {
            return JSValue.Number(ms)
        }
        let u = DateTime.fromEpoch((ms / 1000.0) as i64)
        return JSValue.Number((u.year as f64) - 1900.0)
    }
    if name == "setYear" {
        var yv = 0.0
        if args.len() > 0 {
            yv = toNum(args[0])
        }
        // 0..99 mean 1900..1999; anything else is a full year
        if yv >= 0.0 && yv <= 99.0 {
            yv = yv + 1900.0
        }
        var yArgs: Vec<JSValue> = Vec.new()
        yArgs.push(JSValue.Number(yv))
        return dateMethod(st, o, "setFullYear", yArgs)
    }
    // getUTCFoo and getFoo are the same here — see the UTC note below
    var gname = name.clone()
    if gname.len() >= 6 && strSlice(gname, 0, 6) == "getUTC" {
        gname = "get" + strSlice(gname, 6, gname.len())
    }
    if gname == "getFullYear" || gname == "getMonth" || gname == "getDate" || gname == "getHours" || gname == "getMinutes" || gname == "getSeconds" || gname == "getMilliseconds" || gname == "getDay" {
        // UTC, not the host timezone, for BOTH families. milojs carries no
        // timezone database: the set* family already decomposes in UTC, and
        // getTimezoneOffset reports 0, so a local getter was the one piece that
        // disagreed — `d.setHours(d.getHours())` shifted the date by the host
        // offset. Behaviour now matches node run under TZ=UTC throughout.
        let dt = DateTime.fromEpoch((ms / 1000.0) as i64)
        if gname == "getFullYear" {
            return JSValue.Number(dt.year as f64)
        }
        if gname == "getMonth" {
            // JS months are zero-based
            return JSValue.Number((dt.month - 1) as f64)
        }
        if gname == "getDate" {
            return JSValue.Number(dt.day as f64)
        }
        if gname == "getHours" {
            return JSValue.Number(dt.hour as f64)
        }
        if gname == "getMinutes" {
            return JSValue.Number(dt.minute as f64)
        }
        if gname == "getSeconds" {
            return JSValue.Number(dt.second as f64)
        }
        if gname == "getDay" {
            return JSValue.Number(dt.weekday as f64)
        }
        return JSValue.Number(Math.mod(ms, 1000.0))
    }
    if name == "toString" || name == "toUTCString" || name == "toLocaleString" || name == "toLocaleDateString" || name == "toLocaleTimeString" || name == "toDateString" {
        return JSValue.Str(isoFromMillis(ms))
    }
    if name == "getTimezoneOffset" {
        return JSValue.Number(0.0)
    }
    return JSValue.Undefined
}

// isArrayMethod's set as data, used to populate Array.prototype. Kept separate
// because isArrayMethod is on the property-access hot path and a Vec scan there
// would cost an allocation per lookup. Every name here MUST also be in
// isArrayMethod, or it resolves to a method that then refuses to run.
//
// `toString` IS included: Array.prototype.toString is join(","), and it is a
// distinct function from Object.prototype.toString in the spec. It does not
// shadow the type-tag path, which travels under the private @@objProtoToString
// name precisely so the two cannot collide.
fn arrayMethodNames(): Vec<string> {
    var v: Vec<string> = Vec.new()
    v.push("map")
    v.push("filter")
    v.push("forEach")
    v.push("reduce")
    v.push("join")
    v.push("indexOf")
    v.push("includes")
    v.push("slice")
    v.push("reverse")
    v.push("concat")
    v.push("push")
    v.push("pop")
    v.push("find")
    v.push("findIndex")
    v.push("some")
    v.push("every")
    v.push("shift")
    v.push("unshift")
    v.push("splice")
    v.push("sort")
    v.push("lastIndexOf")
    v.push("flat")
    v.push("fill")
    v.push("at")
    v.push("findLast")
    v.push("findLastIndex")
    v.push("copyWithin")
    v.push("reduceRight")
    v.push("flatMap")
    v.push("values")
    v.push("keys")
    v.push("entries")
    v.push("with")
    v.push("toReversed")
    v.push("toSorted")
    v.push("toSpliced")
    v.push("toString")
    return v
}

fn isArrayMethod(name: &string): bool {
    return name == "map" || name == "filter" || name == "forEach" || name == "reduce" || name == "join" || name == "toString" || name == "indexOf" || name == "includes" || name == "slice" || name == "reverse" || name == "concat" || name == "push" || name == "pop" || name == "find" || name == "findIndex" || name == "some" || name == "every" || name == "shift" || name == "unshift" || name == "splice" || name == "sort" || name == "lastIndexOf" || name == "flat" || name == "fill" || name == "at" || name == "findLast" || name == "findLastIndex" || name == "copyWithin" || name == "reduceRight" || name == "flatMap" || name == "values" || name == "keys" || name == "entries" || name == "with" || name == "toReversed" || name == "toSorted" || name == "toSpliced"
}

// Dispatch a built-in Array method. `o` (the array) is temp-rooted by the caller;
// the result array and the callback are additionally rooted while callbacks run
// (a callback can allocate and collect).
// .then/.catch/.finally on an already-settled promise. Callbacks run immediately
// (no microtask queue), so ordering differs from real JS, but the value flow and
// the rejection-skips-onFulfilled rule match.
// .then/.catch/.finally. Handlers never run synchronously: they are queued as
// microtasks, so ordering matches JS instead of the old settle-in-place model.
fn promiseMethod(o: i64, name: &string, args: &Vec<JSValue>, st: &mut Interp): JSValue {
    var onFul = JSValue.Undefined
    var onRej = JSValue.Undefined
    var isFinally = false
    if name == "then" {
        if args.len() > 0 {
            onFul = cloneValue(args[0])
        }
        if args.len() > 1 {
            onRej = cloneValue(args[1])
        }
    } else if name == "catch" {
        if args.len() > 0 {
            onRej = cloneValue(args[0])
        }
    } else {
        // finally: run the callback on either path, then pass the ORIGINAL
        // settlement through — the callback's return value is discarded and a
        // rejection stays a rejection
        if args.len() > 0 {
            onFul = cloneValue(args[0])
            onRej = cloneValue(args[0])
        }
        isFinally = true
    }
    let derived = newPromise(st, 0, JSValue.Undefined)
    let state = st.objects[o].promiseState
    if state == 2 {
        var ki: i64 = 0
        var kept: Vec<i64> = Vec.new()
        while ki < st.unhandledRejects.len() {
            if st.unhandledRejects[ki] != o {
                kept.push(st.unhandledRejects[ki])
            }
            ki = ki + 1
        }
        st.unhandledRejects = kept
    }
    if state == 0 {
        st.objExtras[st.objects[o].extra].reactions.push(Reaction {
            onFulfilled: onFul, onRejected: onRej, derived: derived, isFinally: isFinally
        }
        )
    } else {
        var handler = onFul
        if state == 2 {
            handler = onRej
        }
        st.microtasks.push(Microtask {
            cb: handler, arg: cloneValue(st.objExtras[st.objects[o].extra].promiseValue), derived: derived, passthroughReject: state == 2, isFinally: isFinally, noArgs: false
        }
        )
    }
    return JSValue.Obj(derived)
}

fn isCallable(v: &JSValue): bool {
    match v {
        JSValue.Func(_f, _e) => {
            return true
        }
        JSValue.Native(_i) => {
            return true
        }
        _ => {
            return false
        }
    }
}

// isCallable, but also true for bound-method objects (Function.prototype.bind
// results and the builtin bound methods). They are ordinary JSObjs, so the
// JSValue-only test above cannot see them — typeof already reports "function".
fn isCallableIn(st: &Interp, v: &JSValue): bool {
    if isCallable(v) {
        return true
    }
    let h = objHandle(v)
    if h >= 0 {
        // napiFn objects are functions implemented by a loaded addon; a proxy is
        // callable when whatever it wraps is
        if st.objects[h].isProxy {
            return isCallableIn(st, st.objExtras[st.objects[h].extra].proxyTarget)
        }
        return st.objects[h].isBound || st.objExtras[st.objects[h].extra].napiFn >= 0
    }
    return false
}

// ── generic (array-like) receivers ───────────────────────────────────────────
//
// Every Array.prototype method is *generic* in ES: the spec defines it over any
// object with a `length` and indexed properties, and over strings. But the
// natives in `arrayMethod` read `elems` directly, so they only ever worked on a
// real array — `Array.prototype.join.call({length:3, 0:"a"})` silently returned
// undefined rather than "a,,".
//
// So a non-array receiver is ADAPTED: its indexed properties are copied into a
// scratch array, the method runs on that, and the mutating methods write the
// result back. The copy is observable in exactly one place — the 3rd callback
// argument, which the spec says is the ORIGINAL object — so the scratch array
// records where it came from in `arrayLikeOrig` and `makeCbArgs` hands that out
// instead. Storing it on the scratch array rather than on Interp is what makes
// nesting work: a callback that itself calls a generic method gets its own.

// Materializing a length this large would hang long before it OOMs, and the
// spec limit (2^53-1) is not representable as an allocation. Past this the
// adapter throws instead — a loud, bounded failure beats a wedged process.
let ARRAY_LIKE_MAX: i64 = 1 << 24

// ToLength: NaN/negative clamp to 0, fractions truncate. The postcondition is the
// safety contract arrayLikeToArray relies on — it loops to this value and pushes
// an element each time, so an unbounded or negative result is either a runaway
// allocation or a malformed array.
//
// NOT currently provable: `milo prove --solver=z3` reports unknown because the
// SMT translator has no rule for float literals and `toNum` declares no `ensures`
// to model its result. Contracts are static-only — nothing checks this at run
// time — so treat it as documentation until the translator learns f64.
fn arrayLikeLength(prog: &Prog, o: i64, st: &mut Interp): i64
ensures result >= -1 && result <= ARRAY_LIKE_MAX
{
    let raw = toNum(getMemberDyn(prog, o, "length", st))
    if !(raw == raw) || raw <= 0.0 {
        return 0
    }
    if raw > (ARRAY_LIKE_MAX as f64) {
        return -1
    }
    return raw as i64
}

// Copy an array-like receiver into a scratch array. Returns -1 if the receiver
// is not adaptable or its length is out of range (with the error already
// thrown). The result is NOT temp-rooted — the caller owns that.
fn arrayLikeToArray(prog: &Prog, recv: &JSValue, st: &mut Interp): i64 {
    let tmp = newArray(st)
    pushTemp(st, JSValue.Obj(tmp))
    match recv {
        // a string receiver indexes as its UTF-16 units and has no own props
        JSValue.Str(sv) => {
            let slen = utf16Length(sv)
            var ci: i64 = 0
            while ci < slen {
                arrPush(st, tmp, JSValue.Str(utf16Slice(sv, ci, ci + 1)))
                ci = ci + 1
            }
            popTemp(st)
            return tmp
        }
        JSValue.Obj(o) => {
            let n = arrayLikeLength(prog, o, st)
            if n < 0 {
                popTemp(st)
                st.throwing = true
                st.thrownValue = makeError(st, "RangeError", "array-like length exceeds this engine's limit")
                return -1
            }
            var i: i64 = 0
            while i < n {
                let key = numToStr(i as f64)
                // absent index → a hole, so forEach/map/filter skip it the way
                // they skip a hole in a sparse array
                if objOwnIndex(st, o, key) >= 0 || st.objects[o].isArray || st.objects[o].proto >= 0 {
                    let v = getMemberDyn(prog, o, key, st)
                    arrPush(st, tmp, v)
                    if st.throwing {
                        popTemp(st)
                        return -1
                    }
                } else {
                    arrMarkHole(st, tmp, arrLen(st, tmp))
                    arrPush(st, tmp, JSValue.Undefined)
                }
                i = i + 1
            }
            let ex = ensureExtra(st, tmp)
            st.objExtras[ex].arrayLikeOrig = o
            popTemp(st)
            return tmp
        }
        _ => {
            // undefined/null/number/bool: the spec's ToObject throws on the
            // first two and yields a lengthless wrapper for the rest, which
            // every method then treats as empty
            popTemp(st)
            match recv {
                JSValue.Undefined => {
                    st.throwing = true
                    st.thrownValue = makeError(st, "TypeError", "Array.prototype method called on null or undefined")
                    return -1
                }
                JSValue.Null => {
                    st.throwing = true
                    st.thrownValue = makeError(st, "TypeError", "Array.prototype method called on null or undefined")
                    return -1
                }
                _ => {
                    return tmp
                }
            }
        }
    }
}

// The methods that mutate their receiver in place: after running on the scratch
// array their result has to be copied back, or the call looks like a no-op.
fn arrayMethodMutates(name: &string): bool {
    return name == "push" || name == "pop" || name == "shift" || name == "unshift" || name == "splice" || name == "sort" || name == "reverse" || name == "fill" || name == "copyWithin"
}

fn writeBackArrayLike(st: &mut Interp, tmp: i64, o: i64) {
    let before = arrayLikeOwnLength(st, o)
    let n = arrLen(st, tmp)
    var i: i64 = 0
    while i < n {
        objSet(st, o, numToStr(i as f64), arrGet(st, tmp, i))
        i = i + 1
    }
    // shrinking methods (pop/shift/splice) must DELETE the trailing indices,
    // not leave the old values visible past the new length
    var d = n
    while d < before {
        let _ = objDeleteKey(st, o, numToStr(d as f64))
        d = d + 1
    }
    objSet(st, o, "length", JSValue.Number(n as f64))
}

// The receiver's length BEFORE a mutating method ran, so write-back knows how far
// to delete. Bounded for the same reason as arrayLikeLength: it drives a loop.
fn arrayLikeOwnLength(st: &Interp, o: i64): i64
ensures result >= 0 && result <= ARRAY_LIKE_MAX
{
    let raw = toNum(objGet(st, o, "length"))
    if !(raw == raw) || raw <= 0.0 || raw > (ARRAY_LIKE_MAX as f64) {
        return 0
    }
    return raw as i64
}

// Run an Array.prototype method against a receiver that is not a real array.
fn arrayMethodGeneric(prog: &Prog, recv: &JSValue, name: &string, args: &Vec<JSValue>, st: &mut Interp): JSValue {
    let tmp = arrayLikeToArray(prog, recv, st)
    if tmp < 0 {
        return JSValue.Undefined
    }
    pushTemp(st, JSValue.Obj(tmp))
    let r = arrayMethod(prog, tmp, name, args, st)
    if !st.throwing && arrayMethodMutates(name) {
        let o = objHandle(recv)
        if o >= 0 && !st.objects[o].frozen {
            writeBackArrayLike(st, tmp, o)
        }
    }
    popTemp(st)
    return r
}

fn arrayMethod(prog: &Prog, o: i64, name: &string, args: &Vec<JSValue>, st: &mut Interp): JSValue {
    let n = arrLen(st, o)
    // the mutating methods write through arrPush/elems directly, bypassing
    // setMember's frozen check, so a frozen array has to be caught here too
    if st.objects[o].frozen {
        if name == "push" || name == "pop" || name == "shift" || name == "unshift" || name == "splice" || name == "sort" || name == "reverse" || name == "fill" || name == "copyWithin" {
            return JSValue.Number(n as f64)
        }
    }
    if name == "push" {
        if n > 4294967295 - args.len() {
            st.throwing = true
            st.thrownValue = makeError(st, "RangeError", "Invalid array length")
            return JSValue.Undefined
        }
        var j: i64 = 0
        while j < args.len() {
            arrPush(st, o, cloneValue(args[j]))
            j = j + 1
        }
        return JSValue.Number(arrLen(st, o) as f64)
    }
    if name == "pop" {
        if n == 0 {
            return JSValue.Undefined
        }
        let result = arrGet(st, o, n - 1)
        setArrayLength(st, o, n - 1)
        return result
    }
    if name == "shift" {
        if n == 0 {
            return JSValue.Undefined
        }
        let head = arrGet(st, o, 0)
        var rest: Vec<JSValue> = Vec.new()
        var i: i64 = 1
        while i < n {
            rest.push(arrGet(st, o, i))
            i = i + 1
        }
        st.objects[o].elems = rest
        return head
    }
    if name == "unshift" {
        var merged: Vec<JSValue> = Vec.new()
        var a: i64 = 0
        while a < args.len() {
            merged.push(cloneValue(args[a]))
            a = a + 1
        }
        var i: i64 = 0
        while i < n {
            merged.push(arrGet(st, o, i))
            i = i + 1
        }
        st.objects[o].elems = merged
        return JSValue.Number((n + args.len()) as f64)
    }
    if name == "find" || name == "findIndex" || name == "some" || name == "every" {
        if args.len() == 0 {
            if name == "every" {
                return JSValue.Bool(true)
            }
            if name == "some" {
                return JSValue.Bool(false)
            }
            if name == "findIndex" {
                return JSValue.Number(0.0 - 1.0)
            }
            return JSValue.Undefined
        }
        let cb = cloneValue(args[0])
        pushTemp(st, cloneValue(cb))
        let thisArg = cbThisArg(args)
        pushTemp(st, cloneValue(thisArg))
        var i: i64 = 0
        var found = -1
        var allTrue = true
        var anyTrue = false
        while i < arrLen(st, o) && found < 0 {
            // some/every are specified over PRESENT indices; find/findIndex are
            // not, and visit a hole as undefined
            if (name == "some" || name == "every") && arrIsHole(st, o, i) {
                i = i + 1
                continue
            }
            let cbArgs = makeCbArgs(st, o, i)
            let r = callValue(prog, cb, cbArgs, cloneValue(thisArg), st)
            let t = truthy(r)
            if t {
                anyTrue = true
                if name == "find" || name == "findIndex" || name == "some" {
                    found = i
                }
            } else {
                allTrue = false
                if name == "every" {
                    found = i
                }
            }
            if st.throwing {
                found = i
            }
            i = i + 1
        }
        popTemp(st)
        popTemp(st)
        if name == "every" {
            return JSValue.Bool(allTrue)
        }
        if name == "some" {
            return JSValue.Bool(anyTrue)
        }
        if name == "findIndex" {
            return JSValue.Number(found as f64)
        }
        if found >= 0 {
            return arrGet(st, o, found)
        }
        return JSValue.Undefined
    }
    if name == "lastIndexOf" {
        var target = JSValue.Undefined
        if args.len() > 0 {
            target = cloneValue(args[0])
        }
        // fromIndex is the LAST index searched, and it was being ignored
        // entirely: `[1,2,3,2].lastIndexOf(2, 0)` must be -1, not 3. An absent
        // one (or an explicit undefined, which ToIntegerOrInfinity turns into
        // 0) is not the same as no second argument at all.
        var i = n - 1
        if args.len() > 1 {
            var from = toNum(args[1]) as i64
            if from < 0 {
                from = n + from
            }
            if from < i {
                i = from
            }
        }
        while i >= 0 {
            if jsStrictEquals(arrGet(st, o, i), target) {
                return JSValue.Number(i as f64)
            }
            i = i - 1
        }
        return JSValue.Number(0.0 - 1.0)
    }
    if name == "values" || name == "keys" || name == "entries" {
        var kind: i64 = 0
        if name == "keys" {
            kind = 1
        } else if name == "entries" {
            kind = 2
        }
        return makeArrayIterator(st, o, kind)
    }
    if name == "at" {
        var idx: i64 = 0
        if args.len() > 0 {
            idx = toNum(args[0]) as i64
        }
        if idx < 0 {
            idx = n + idx
        }
        if idx < 0 || idx >= n {
            return JSValue.Undefined
        }
        return arrGet(st, o, idx)
    }
    // ES2023 change-by-copy: build a new array, never touch the receiver. These
    // live here rather than in the prelude because array member lookup never
    // falls back to Array.prototype — a method has to be on the whitelist above
    // and implemented here to be reachable at all.
    if name == "with" {
        var wi: i64 = 0
        if args.len() > 0 {
            wi = toNum(args[0]) as i64
        }
        if wi < 0 {
            wi = wi + n
        }
        // spec: out of range throws rather than clamping, so a bad index is a
        // loud error instead of a silently misplaced element
        if wi < 0 || wi >= n {
            st.throwing = true
            st.thrownValue = makeError(st, "RangeError", "Invalid index")
            return JSValue.Undefined
        }
        var wv = JSValue.Undefined
        if args.len() > 1 {
            wv = cloneValue(args[1])
        }
        let wout = newArray(st)
        pushTemp(st, JSValue.Obj(wout))
        var wk: i64 = 0
        while wk < n {
            if wk == wi {
                arrPush(st, wout, cloneValue(wv))
            } else {
                arrPush(st, wout, arrGet(st, o, wk))
            }
            wk = wk + 1
        }
        popTemp(st)
        return JSValue.Obj(wout)
    }
    if name == "toReversed" {
        let rout = newArray(st)
        pushTemp(st, JSValue.Obj(rout))
        var rk = n - 1
        while rk >= 0 {
            arrPush(st, rout, arrGet(st, o, rk))
            rk = rk - 1
        }
        popTemp(st)
        return JSValue.Obj(rout)
    }
    if name == "toSorted" {
        let sout = newArray(st)
        pushTemp(st, JSValue.Obj(sout))
        var sk: i64 = 0
        while sk < n {
            arrPush(st, sout, arrGet(st, o, sk))
            sk = sk + 1
        }
        // sort the copy in place with the existing implementation, so the two
        // orderings cannot drift apart
        let sorted = arrayMethod(prog, sout, "sort", args, st)
        popTemp(st)
        return sorted
    }
    if name == "toSpliced" {
        var ss: i64 = 0
        if args.len() > 0 {
            ss = toNum(args[0]) as i64
        }
        if ss < 0 {
            ss = n + ss
            if ss < 0 {
                ss = 0
            }
        } else if ss > n {
            ss = n
        }
        // no args deletes nothing; a lone start deletes the whole tail
        var sd: i64 = 0
        if args.len() == 1 {
            sd = n - ss
        } else if args.len() > 1 {
            sd = toNum(args[1]) as i64
            if sd < 0 {
                sd = 0
            }
            if sd > n - ss {
                sd = n - ss
            }
        }
        let tout = newArray(st)
        pushTemp(st, JSValue.Obj(tout))
        var tk: i64 = 0
        while tk < ss {
            arrPush(st, tout, arrGet(st, o, tk))
            tk = tk + 1
        }
        var ta: i64 = 2
        while ta < args.len() {
            arrPush(st, tout, cloneValue(args[ta]))
            ta = ta + 1
        }
        var tb = ss + sd
        while tb < n {
            arrPush(st, tout, arrGet(st, o, tb))
            tb = tb + 1
        }
        popTemp(st)
        return JSValue.Obj(tout)
    }
    if name == "findLast" || name == "findLastIndex" {
        if args.len() == 0 {
            if name == "findLastIndex" {
                return JSValue.Number(0.0 - 1.0)
            }
            return JSValue.Undefined
        }
        let cb = cloneValue(args[0])
        pushTemp(st, cloneValue(cb))
        let thisArg = cbThisArg(args)
        pushTemp(st, cloneValue(thisArg))
        var i = n - 1
        var found: i64 = -1
        while i >= 0 && found < 0 {
            let cbArgs = makeCbArgs(st, o, i)
            let r = callValue(prog, cb, cbArgs, cloneValue(thisArg), st)
            if truthy(r) || st.throwing {
                found = i
            }
            i = i - 1
        }
        popTemp(st)
        popTemp(st)
        if name == "findLastIndex" {
            return JSValue.Number(found as f64)
        }
        if found >= 0 {
            return arrGet(st, o, found)
        }
        return JSValue.Undefined
    }
    if name == "copyWithin" {
        // copyWithin(target, start, end) — an in-place memmove within the array
        var target: i64 = 0
        if argPresent(args, 0) {
            target = toNum(args[0]) as i64
        }
        if target < 0 {
            target = n + target
        }
        var start: i64 = 0
        if argPresent(args, 1) {
            start = toNum(args[1]) as i64
        }
        if start < 0 {
            start = n + start
        }
        var end = n
        if argPresent(args, 2) {
            end = toNum(args[2]) as i64
            if end < 0 {
                end = n + end
            }
        }
        if target < 0 {
            target = 0
        }
        if start < 0 {
            start = 0
        }
        if end > n {
            end = n
        }
        // snapshot first: source and destination ranges may overlap
        var snap: Vec<JSValue> = Vec.new()
        var s = start
        while s < end {
            snap.push(arrGet(st, o, s))
            s = s + 1
        }
        var k: i64 = 0
        while k < snap.len() && target + k < n {
            st.objects[o].elems[target + k] = cloneValue(snap[k])
            k = k + 1
        }
        return JSValue.Obj(o)
    }
    if name == "fill" {
        var v = JSValue.Undefined
        if args.len() > 0 {
            v = cloneValue(args[0])
        }
        // fill(value, start, end) — the range args are optional but not ignorable
        var start: i64 = 0
        if argPresent(args, 1) {
            start = toNum(args[1]) as i64
            if start < 0 {
                start = n + start
            }
        }
        var end = n
        if argPresent(args, 2) {
            end = toNum(args[2]) as i64
            if end < 0 {
                end = n + end
            }
        }
        if start < 0 {
            start = 0
        }
        if end > n {
            end = n
        }
        var i = start
        while i < end {
            st.objects[o].elems[i] = cloneValue(v)
            i = i + 1
        }
        return JSValue.Obj(o)
    }
    if name == "splice" {
        // splice(start, deleteCount, ...items) — mutates and returns the removed
        var start: i64 = 0
        if args.len() > 0 {
            start = toNum(args[0]) as i64
        }
        if start < 0 {
            start = n + start
        }
        if start < 0 {
            start = 0
        }
        if start > n {
            start = n
        }
        var delCount = n - start
        if args.len() > 1 {
            delCount = toNum(args[1]) as i64
        }
        if delCount < 0 {
            delCount = 0
        }
        if start + delCount > n {
            delCount = n - start
        }
        let removed = newArray(st)
        pushTemp(st, JSValue.Obj(removed))
        var kept: Vec<JSValue> = Vec.new()
        var i: i64 = 0
        while i < n {
            if i == start {
                var a: i64 = 2
                while a < args.len() {
                    kept.push(cloneValue(args[a]))
                    a = a + 1
                }
            }
            if i >= start && i < start + delCount {
                arrPush(st, removed, arrGet(st, o, i))
            } else {
                kept.push(arrGet(st, o, i))
            }
            i = i + 1
        }
        if start >= n {
            var a: i64 = 2
            while a < args.len() {
                kept.push(cloneValue(args[a]))
                a = a + 1
            }
        }
        st.objects[o].elems = kept
        popTemp(st)
        return JSValue.Obj(removed)
    }
    if name == "sort" {
        // insertion sort; default order is by string value, as in JS
        var hasCmp = false
        var cmp = JSValue.Undefined
        if args.len() > 0 && isCallable(args[0]) {
            hasCmp = true
            cmp = cloneValue(args[0])
        }
        pushTemp(st, cloneValue(cmp))
        // Sorting in place over the raw elements got holes wrong twice: the
        // holes list names INDICES, so moving elements under it leaves it
        // pointing at the wrong slots, and the spec sinks undefined below every
        // defined value and a hole below that — neither of which falls out of
        // comparing "undefined" as a string. So: lift the present, defined
        // values out, sort those, and lay the tail back down afterwards.
        var vals: Vec<JSValue> = Vec.new()
        var undefs: i64 = 0
        let vn = arrLen(st, o)
        var vi: i64 = 0
        while vi < vn {
            if !arrIsHole(st, o, vi) {
                let e = arrGet(st, o, vi)
                if isUndefinedValue(e) {
                    undefs = undefs + 1
                } else {
                    vals.push(e)
                }
            }
            vi = vi + 1
        }
        var i: i64 = 1
        while i < vals.len() {
            let key = cloneValue(vals[i])
            var j = i - 1
            var placed = false
            while j >= 0 && !placed {
                let cur = cloneValue(vals[j])
                var greater = false
                if hasCmp {
                    var cargs: Vec<JSValue> = Vec.new()
                    cargs.push(cloneValue(cur))
                    cargs.push(cloneValue(key))
                    let r = callValue(prog, cmp, cargs, JSValue.Undefined, st)
                    greater = toNum(r) > 0.0
                } else {
                    greater = strLess(toStr(key), toStr(cur))
                }
                if greater {
                    vals[j + 1] = cur
                    j = j - 1
                } else {
                    placed = true
                }
            }
            vals[j + 1] = key
            i = i + 1
        }
        var newHoles: Vec<i64> = Vec.new()
        let defined = vals.len()
        var w: i64 = 0
        while w < vn && w < st.objects[o].elems.len() {
            if w < defined {
                st.objects[o].elems[w] = cloneValue(vals[w])
            } else {
                st.objects[o].elems[w] = JSValue.Undefined
                if w >= defined + undefs {
                    newHoles.push(w)
                }
            }
            w = w + 1
        }
        st.objects[o].holes = newHoles
        popTemp(st)
        return JSValue.Obj(o)
    }
    if name == "join" || name == "toString" {
        // Array.prototype.toString is join(",") — NOT the [object Array] type tag
        // (that is Object.prototype.toString.call(arr), a separate dispatch)
        var sep = ","
        if name == "join" && argPresent(args, 0) {
            sep = toStr(args[0])
        }
        return JSValue.Str(joinArrayProg(prog, st, o, sep))
    }
    if name == "indexOf" {
        // optional fromIndex (negative counts from the end)
        var i: i64 = 0
        if args.len() > 1 {
            var fi = toNum(args[1]) as i64
            if fi < 0 {
                fi = n + fi
                if fi < 0 {
                    fi = 0
                }
            }
            i = fi
        }
        while i < n {
            if arrIsHole(st, o, i) {
                // indexOf is specified over PRESENT indices, so a hole never
                // matches — not even a search for undefined. includes() does
                // look at holes, and stays as it is.
                i = i + 1
                continue
            }
            let e = arrGet(st, o, i)
            if args.len() > 0 && jsEquals(e, args[0]) {
                return JSValue.Number(i as f64)
            }
            i = i + 1
        }
        return JSValue.Number(0.0 - 1.0)
    }
    if name == "includes" {
        var i: i64 = 0
        while i < n {
            let e = arrGet(st, o, i)
            // includes uses SameValueZero, so it finds NaN (unlike indexOf's ===)
            if args.len() > 0 && sameValueZero(e, args[0]) {
                return JSValue.Bool(true)
            }
            i = i + 1
        }
        return JSValue.Bool(false)
    }
    if name == "slice" {
        var a: i64 = 0
        var b = n
        if argPresent(args, 0) {
            a = toNum(args[0]) as i64
        }
        if argPresent(args, 1) {
            b = toNum(args[1]) as i64
        }
        if a < 0 {
            a = n + a
            if a < 0 {
                a = 0
            }
        }
        if b < 0 {
            b = n + b
        }
        if b > n {
            b = n
        }
        let sliced = newArray(st)
        var i = a
        while i < b {
            arrPushMaybeHole(st, sliced, o, i)
            i = i + 1
        }
        return JSValue.Obj(sliced)
    }
    if name == "reverse" {
        var i: i64 = 0
        var j = n - 1
        while i < j {
            let lo = arrGet(st, o, i)
            let hi = arrGet(st, o, j)
            arrSet(st, o, i, hi)
            arrSet(st, o, j, lo)
            i = i + 1
            j = j - 1
        }
        return JSValue.Obj(o)
    }
    if name == "concat" {
        let joined = newArray(st)
        pushTemp(st, JSValue.Obj(joined))
        var i: i64 = 0
        while i < n {
            arrPushMaybeHole(st, joined, o, i)
            i = i + 1
        }
        var a: i64 = 0
        while a < args.len() {
            let av = cloneValue(args[a])
            match av {
                JSValue.Obj(other) => {
                    if st.objects[other].isArray {
                        var k: i64 = 0
                        let m = arrLen(st, other)
                        while k < m {
                            arrPushMaybeHole(st, joined, other, k)
                            k = k + 1
                        }
                    } else {
                        arrPush(st, joined, JSValue.Obj(other))
                    }
                }
                _ => {
                    arrPush(st, joined, cloneValue(args[a]))
                }
            }
            a = a + 1
        }
        popTemp(st)
        return JSValue.Obj(joined)
    }
    // callback methods: root the callback across the loop
    var cb = JSValue.Undefined
    if args.len() > 0 {
        cb = cloneValue(args[0])
    }
    pushTemp(st, cloneValue(cb))
    if name == "map" {
        let mapped = newArray(st)
        pushTemp(st, JSValue.Obj(mapped))
        let thisArg = cbThisArg(args)
        pushTemp(st, cloneValue(thisArg))
        var i: i64 = 0
        while i < n {
            if arrIsHole(st, o, i) {
                // the callback is not called for a hole, and the result stays
                // sparse at that index
                arrPushMaybeHole(st, mapped, o, i)
                i = i + 1
                continue
            }
            let cbArgs = makeCbArgs(st, o, i)
            let r = callValue(prog, cb, cbArgs, cloneValue(thisArg), st)
            arrPush(st, mapped, r)
            i = i + 1
        }
        popTemp(st)
        popTemp(st)
        popTemp(st)
        return JSValue.Obj(mapped)
    }
    if name == "filter" {
        let kept = newArray(st)
        pushTemp(st, JSValue.Obj(kept))
        let thisArg = cbThisArg(args)
        pushTemp(st, cloneValue(thisArg))
        var i: i64 = 0
        while i < n {
            if arrIsHole(st, o, i) {
                i = i + 1
                continue
            }
            let elem = arrGet(st, o, i)
            let cbArgs = makeCbArgs(st, o, i)
            let keep = callValue(prog, cb, cbArgs, cloneValue(thisArg), st)
            if truthy(keep) {
                arrPush(st, kept, elem)
            }
            i = i + 1
        }
        popTemp(st)
        popTemp(st)
        popTemp(st)
        return JSValue.Obj(kept)
    }
    if name == "forEach" {
        let thisArg = cbThisArg(args)
        pushTemp(st, cloneValue(thisArg))
        var i: i64 = 0
        while i < n {
            if arrIsHole(st, o, i) {
                i = i + 1
                continue
            }
            let cbArgs = makeCbArgs(st, o, i)
            let _ = callValue(prog, cb, cbArgs, cloneValue(thisArg), st)
            i = i + 1
        }
        popTemp(st)
        popTemp(st)
        return JSValue.Undefined
    }
    if name == "reduce" {
        var acc = JSValue.Undefined
        var start: i64 = 0
        if args.len() > 1 {
            acc = cloneValue(args[1])
        } else {
            // no seed: the accumulator is the first PRESENT element, not
            // element 0 — a leading hole must not become the seed
            var f: i64 = 0
            while f < n && arrIsHole(st, o, f) {
                f = f + 1
            }
            if f < n {
                acc = arrGet(st, o, f)
                start = f + 1
            } else {
                start = n
            }
        }
        pushTemp(st, cloneValue(acc))
        var i = start
        while i < n {
            if arrIsHole(st, o, i) {
                i = i + 1
                continue
            }
            var cbArgs: Vec<JSValue> = Vec.new()
            cbArgs.push(cloneValue(acc))
            cbArgs.push(arrGet(st, o, i))
            cbArgs.push(JSValue.Number(i as f64))
            acc = callValue(prog, cb, cbArgs, JSValue.Undefined, st)
            i = i + 1
        }
        popTemp(st)
        popTemp(st)
        return acc
    }
    if name == "reduceRight" {
        var acc = JSValue.Undefined
        var start = n - 1
        if args.len() > 1 {
            acc = cloneValue(args[1])
        } else {
            var f = n - 1
            while f >= 0 && arrIsHole(st, o, f) {
                f = f - 1
            }
            if f >= 0 {
                acc = arrGet(st, o, f)
                start = f - 1
            } else {
                start = 0 - 1
            }
        }
        pushTemp(st, cloneValue(acc))
        var i = start
        while i >= 0 {
            if arrIsHole(st, o, i) {
                i = i - 1
                continue
            }
            var cbArgs: Vec<JSValue> = Vec.new()
            cbArgs.push(cloneValue(acc))
            cbArgs.push(arrGet(st, o, i))
            cbArgs.push(JSValue.Number(i as f64))
            acc = callValue(prog, cb, cbArgs, JSValue.Undefined, st)
            i = i - 1
        }
        popTemp(st)
        popTemp(st)
        return acc
    }
    if name == "flatMap" {
        let out = newArray(st)
        pushTemp(st, JSValue.Obj(out))
        let thisArg = cbThisArg(args)
        pushTemp(st, cloneValue(thisArg))
        var i: i64 = 0
        while i < arrLen(st, o) && !st.throwing {
            if arrIsHole(st, o, i) {
                i = i + 1
                continue
            }
            let cbArgs = makeCbArgs(st, o, i)
            let r = callValue(prog, cb, cbArgs, cloneValue(thisArg), st)
            // one level of flattening, and only for array results
            let rh = objHandle(r)
            if rh >= 0 && st.objects[rh].isArray {
                var j: i64 = 0
                while j < arrLen(st, rh) {
                    arrPush(st, out, arrGet(st, rh, j))
                    j = j + 1
                }
            } else {
                arrPush(st, out, r)
            }
            i = i + 1
        }
        popTemp(st)
        popTemp(st)
        popTemp(st)
        return JSValue.Obj(out)
    }
    if name == "flat" {
        var depth: i64 = 1
        if argPresent(args, 0) {
            let dn = toNum(args[0])
            if dn > 1000000.0 {
                // Infinity / very deep → cap (real arrays never nest this far)
                depth = 1000000
            } else if dn < 0.0 || dn != dn {
                depth = 0
            } else {
                depth = dn as i64
            }
        }
        let out = newArray(st)
        pushTemp(st, JSValue.Obj(out))
        flattenInto(st, out, o, depth)
        popTemp(st)
        popTemp(st)
        return JSValue.Obj(out)
    }
    popTemp(st)
    return JSValue.Undefined
}

// Copy element `i` of `src` onto the end of `dst`, keeping a HOLE a hole.
// slice/concat/map all preserve sparseness in their result; pushing arrGet's
// undefined would silently fill the gap in.
fn arrPushMaybeHole(st: &mut Interp, dst: i64, src: i64, i: i64) {
    let at = arrLen(st, dst)
    arrPush(st, dst, arrGet(st, src, i))
    if arrIsHole(st, src, i) {
        arrMarkHole(st, dst, at)
    }
}

// Flatten `arr` into `out` up to `depth` levels of nested arrays.
fn flattenInto(st: &mut Interp, out: i64, arr: i64, depth: i64) {
    var i: i64 = 0
    while i < arrLen(st, arr) {
        if arrIsHole(st, arr, i) {
            // flat/flatMap DROP holes rather than flattening them to undefined
            i = i + 1
            continue
        }
        let v = arrGet(st, arr, i)
        let vh = objHandle(v)
        if depth > 0 && vh >= 0 && st.objects[vh].isArray {
            flattenInto(st, out, vh, depth - 1)
        } else {
            arrPush(st, out, v)
        }
        i = i + 1
    }
}

// Call a member as a method: `this` binds to the receiver. String and array
// receivers dispatch to built-in methods; object receivers use function-valued
// properties. The receiver is temp-rooted across argument evaluation (an argument
// may be a call that triggers GC).
// toString/valueOf and friends on a number, boolean, string, null or undefined.
// Number.toLocaleString default (en-US): thousands-grouped integer part, up to 3
// fraction digits with trailing zeros stripped — (1000000).toLocaleString() is
// "1,000,000" and (1234.5678) is "1,234.568". Only the default locale; no
// currency/percent options.
fn numToLocale(n: f64): string {
    if !(n == n) {
        return "NaN"
    }
    if !isFiniteF(n) {
        if n < 0.0 {
            return "-∞"
        }
        return "∞"
    }
    let neg = n < 0.0
    var abs = n
    if neg {
        abs = -n
    }
    // round to 3 fraction digits, then split on the '.'
    let fixed = numToFixed(abs, 3)
    var intPart = fixed.clone()
    var fracPart = ""
    var dot: i64 = 0
    while dot < fixed.len() {
        if fixed[dot] == '.' {
            intPart = strSlice(fixed, 0, dot)
            fracPart = strSlice(fixed, dot + 1, fixed.len())
            dot = fixed.len()
        } else {
            dot = dot + 1
        }
    }
    // strip trailing zeros from the fraction
    var fe = fracPart.len()
    while fe > 0 && fracPart[fe - 1] == '0' {
        fe = fe - 1
    }
    fracPart = strSlice(fracPart, 0, fe)
    // group the integer part with commas every three digits from the right
    var grouped = ""
    let ilen = intPart.len()
    var k: i64 = 0
    while k < ilen {
        if k > 0 && (ilen - k) % 3 == 0 {
            grouped = grouped + ","
        }
        grouped = grouped + strSlice(intPart, k, k + 1)
        k = k + 1
    }
    var out = grouped
    if fracPart.len() > 0 {
        out = out + "." + fracPart
    }
    if neg {
        out = "-" + out
    }
    return out
}

fn primitiveMethod(name: &string, recv: &JSValue, args: &Vec<JSValue>): JSValue {
    if name == "valueOf" {
        return cloneValue(recv)
    }
    // symbols are interned strings, so a direct sym.toString() lands here before
    // the builtin-method path and would otherwise leak the internal form
    match recv {
        JSValue.Str(sv) => {
            if isSymbolStr(sv) && name == "toString" {
                return JSValue.Str(symbolDisplay(sv))
            }
        }
        _ => {
        }
    }
    if name == "toExponential" {
        if args.len() == 0 {
            return JSValue.Str(numToExponential(toNum(recv), 0, false))
        }
        return JSValue.Str(numToExponential(toNum(recv), toNum(args[0]) as i64, true))
    }
    if name == "toFixed" || name == "toPrecision" {
        var digits: i64 = 0
        if args.len() > 0 {
            digits = toNum(args[0]) as i64
        }
        if name == "toPrecision" {
            if args.len() == 0 {
                return JSValue.Str(toStr(recv))
            }
            return JSValue.Str(numToPrecision(toNum(recv), digits))
        }
        return JSValue.Str(numToFixed(toNum(recv), digits))
    }
    // toString(radix). BigInt uses arbitrary-precision conversion (bnToRadix);
    // numbers go through the f64-backed numToRadix. A BigInt is exact at any size.
    if isBigIntVal(recv) {
        var radix: i64 = 10
        if args.len() > 0 {
            radix = toNum(args[0]) as i64
        }
        if radix >= 2 && radix <= 36 {
            return JSValue.Str(bnToRadix(bigStrOf(recv), radix))
        }
    }
    if args.len() > 0 {
        let radix = toNum(args[0]) as i64
        if radix >= 2 && radix <= 36 && radix != 10 {
            return JSValue.Str(numToRadix(toNum(recv), radix))
        }
    }
    // number.toLocaleString() → thousands-grouped default-locale form
    if name == "toLocaleString" {
        match recv {
            JSValue.Number(n) => {
                return JSValue.Str(numToLocale(n))
            }
            _ => {
            }
        }
    }
    return JSValue.Str(toStr(recv))
}

fn callMember(prog: &Prog, recv: JSValue, name: &string, argsIdx: ArgListId, st: &mut Interp, scope: i64): JSValue {
    // Methods every primitive answers to. JS boxes the receiver for these; here
    // they are answered directly, which covers the cases real code uses.
    if name == "toString" || name == "valueOf" || name == "toFixed" || name == "toPrecision" || name == "toExponential" || name == "toLocaleString" {
        var useDirectPrimitive = objHandle(recv) < 0 && funcHandle(recv) < 0
        match recv {
            JSValue.Str(_) => {
                useDirectPrimitive = useDirectPrimitive && st.stringProtoPristine
            }
            _ => {
            }
        }
        if useDirectPrimitive {
            let argVals = evalArgs(prog, argsIdx, st, scope)
            return primitiveMethod(name, recv, argVals)
        }
    }
    match recv {
        JSValue.Str(s) => {
            let argVals = evalArgs(prog, argsIdx, st, scope)
            if !st.stringProtoPristine {
                let method = getMember(st, st.stringProtoObj, name)
                if isCallableIn(st, method) {
                    return callValue(prog, method, argVals, JSValue.Str(s.clone()), st)
                }
                st.throwing = true
                st.thrownValue = makeError(st, "TypeError", name.clone() + " is not a function" + currentModule(st))
                return JSValue.Undefined
            }
            // regex-based string ops when the first arg is a RegExp
            if stringOpNeedsRegexArg(st, name, argVals) {
                let ra = regexArgFor(st, name, argVals)
                return stringRegexOp(prog, s, name, ra, st)
            }
            if isStringRegexOp(st, name, argVals) {
                return stringRegexOp(prog, s, name, argVals, st)
            }
            if name == "concat" {
                return JSValue.Str(strConcatProg(prog, s, argVals, st))
            }
            if name == "__stringIterator" || name == symIteratorKey() {
                return makeStringIterator(st, s)
            }
            if stringArgsNeedCoercion(name, argVals) {
                let ca = coercedStringArgs(prog, name, argVals, st)
                if st.throwing {
                    return JSValue.Undefined
                }
                return stringMethod(name, s, ca, st)
            }
            return stringMethod(name, s, argVals, st)
        }
        JSValue.Obj(o) => {
            pushTemp(st, JSValue.Obj(o))
            // ArrayBuffer methods (resize/transfer/slice) live in
            // callBuiltinByName; route them there rather than duplicating
            if st.objects[o].isArrayBuffer {
                let argVals = evalArgs(prog, argsIdx, st, scope)
                let r = callBuiltinByName(prog, JSValue.Obj(o), name, argVals, st)
                popTemp(st)
                return r
            }
            if st.objExtras[st.objects[o].extra].regexId >= 0 {
                let argVals = evalArgs(prog, argsIdx, st, scope)
                let r = regexMethod(st, o, name, argVals)
                popTemp(st)
                return r
            }
            // .call/.apply on a bound-method value: [].slice.call(arguments, 1)
            if st.objects[o].isBound && (name == "call" || name == "apply" || name == "bind") {
                let argVals = evalArgs(prog, argsIdx, st, scope)
                var newThis = JSValue.Undefined
                if argVals.len() > 0 {
                    newThis = cloneValue(argVals[0])
                }
                var rest: Vec<JSValue> = Vec.new()
                if name == "apply" {
                    if argVals.len() > 1 {
                        let ah = objHandle(argVals[1])
                        if ah >= 0 && st.objects[ah].isArray {
                            var ai: i64 = 0
                            while ai < arrLen(st, ah) {
                                rest.push(arrGet(st, ah, ai))
                                ai = ai + 1
                            }
                        }
                    }
                } else {
                    var ai: i64 = 1
                    while ai < argVals.len() {
                        rest.push(cloneValue(argVals[ai]))
                        ai = ai + 1
                    }
                }
                let exo = st.objects[o].extra
                let mname = st.objExtras[exo].boundMethod.clone()
                if name == "bind" {
                    // An UNBOUND builtin method value (Array.prototype.sort, read
                    // off an array or off the prototype) carries no `this` yet, so
                    // this is its FIRST bind and the thisArg must stick. Only a
                    // genuinely re-bound function falls through to the keep-the-
                    // original rule below.
                    if !isBoundThisSet(st, o) {
                        var fb: Vec<JSValue> = Vec.new()
                        var fi: i64 = 0
                        while fi < st.objExtras[exo].boundArgs.len() {
                            fb.push(cloneValue(st.objExtras[exo].boundArgs[fi]))
                            fi = fi + 1
                        }
                        var fr: i64 = 0
                        while fr < rest.len() {
                            fb.push(cloneValue(rest[fr]))
                            fr = fr + 1
                        }
                        let fTarget = cloneValue(st.objExtras[exo].boundTarget)
                        let nf = newObject(st)
                        st.objects[nf].isBound = true
                        let exf = ensureExtra(st, nf)
                        st.objExtras[exf].boundTarget = fTarget
                        st.objExtras[exf].boundMethod = mname.clone()
                        // a bound buffer-family method keeps its receiver brand
                        st.objExtras[exf].boundBrand = st.objExtras[exo].boundBrand

                        st.objExtras[exf].boundThis = newThis
                        let nb2 = fb.len()
                        st.objExtras[exf].boundArgs = fb
                        finishBind(prog, st, nf, JSValue.Obj(o), nb2)
                        popTemp(st)
                        return JSValue.Obj(nf)
                    }
                    // re-binding an already-bound function: JS keeps the ORIGINAL
                    // this and only APPENDS args (the second bind's thisArg is
                    // ignored). The old code dropped to makeBoundMethod with the
                    // (usually empty) method name, so a double bind returned a
                    // broken value — which silently made zod's constructor-bound
                    // parseAsync return undefined once tRPC bound it again.
                    // newObject runs while `o` is still temp-rooted (popTemp below).
                    var na: Vec<JSValue> = Vec.new()
                    var oi: i64 = 0
                    while oi < st.objExtras[exo].boundArgs.len() {
                        na.push(cloneValue(st.objExtras[exo].boundArgs[oi]))
                        oi = oi + 1
                    }
                    var ri: i64 = 0
                    while ri < rest.len() {
                        na.push(cloneValue(rest[ri]))
                        ri = ri + 1
                    }
                    let bTarget = cloneValue(st.objExtras[exo].boundTarget)
                    let bThis = cloneValue(st.objExtras[exo].boundThis)
                    let nb = newObject(st)
                    st.objects[nb].isBound = true
                    let exn = ensureExtra(st, nb)
                    st.objExtras[exn].boundTarget = bTarget
                    st.objExtras[exn].boundMethod = mname.clone()
                    st.objExtras[exn].boundBrand = st.objExtras[exo].boundBrand

                    st.objExtras[exn].boundThis = bThis
                    let nb3 = na.len()
                    st.objExtras[exn].boundArgs = na
                    finishBind(prog, st, nb, JSValue.Obj(o), nb3)
                    popTemp(st)
                    return JSValue.Obj(nb)
                }
                popTemp(st)
                if mname.len() > 0 {
                    if !brandOk(st, o, mname, newThis) {
                        return JSValue.Undefined
                    }
                    let recvS = coerceGenericStringReceiver(prog, st, o, newThis)
                    if st.throwing {
                        return JSValue.Undefined
                    }
                    return callBuiltinByName(prog, recvS, mname, rest, st)
                }
                // `.call` on a bind() RESULT cannot change the receiver — the
                // binding already fixed it — and the pre-bound arguments still
                // come first. Calling the TARGET directly discarded both.
                return callValue(prog, JSValue.Obj(o), rest, newThis, st)
            }
            if st.objects[o].isBound && st.objExtras[st.objects[o].extra].boundMethod.len() == 0 {
                // any other method on a bind() result goes to its target
                let target = cloneValue(st.objExtras[st.objects[o].extra].boundTarget)
                let th = objHandle(target)
                if th >= 0 {
                    let r = callMember(prog, target, name, argsIdx, st, scope)
                    popTemp(st)
                    return r
                }
            }
            if name == "hasOwnProperty" || name == "isPrototypeOf" || name == "propertyIsEnumerable" {
                let argVals = evalArgs(prog, argsIdx, st, scope)
                let r = callBuiltinByName(prog, JSValue.Obj(o), name, argVals, st)
                popTemp(st)
                return r
            }
            // err.toString() -> "Name: message"; arr.toString() -> join(",").
            // Object.prototype.toString.call(x) still gives the type tag (it
            // reaches callBuiltinByName directly, a separate path).
            if name == "toString" && st.objects[o].isError {
                let en = toStr(objGet(st, o, "name"))
                let em = toStr(objGet(st, o, "message"))
                popTemp(st)
                if em.len() > 0 {
                    return JSValue.Str(en + ": " + em)
                }
                return JSValue.Str(en)
            }
            if st.objects[o].isDate {
                let argVals = evalArgs(prog, argsIdx, st, scope)
                let r = dateMethod(st, o, name, argVals)
                popTemp(st)
                return r
            }
            if st.objects[o].isMap || st.objects[o].isSet {
                let argVals = evalArgs(prog, argsIdx, st, scope)
                let r = mapMethod(prog, o, name, argVals, st)
                popTemp(st)
                return r
            }
            if isPromise(st, o) && (name == "then" || name == "catch" || name == "finally") {
                let argVals = evalArgs(prog, argsIdx, st, scope)
                let r = promiseMethod(o, name, argVals, st)
                popTemp(st)
                return r
            }
            // Fast path: while nobody has touched Array.prototype and this array
            // still has it as its proto and defines no own property of that name,
            // the chain walk can only ever arrive back at the native — so call it
            // directly. The moment a user writes to Array.prototype the flag
            // clears for good and every call takes the real chain, which is what
            // keeps an override authoritative. Worth the guard: without it, a
            // tight arr.indexOf() loop ran ~30% slower.
            if st.arrayProtoPristine && st.objects[o].isArray && st.objects[o].proto == st.arrayProtoObj && isArrayMethod(name) && objOwnIndex(st, o, name) < 0 {
                let argVals = evalArgs(prog, argsIdx, st, scope)
                let r = arrayMethod(prog, o, name, argVals, st)
                popTemp(st)
                return r
            }
            // Otherwise the lookup below walks Array.prototype and finds the
            // native there, so a user who replaces Array.prototype.map actually
            // gets their version called. Dispatching by name unconditionally made
            // an override visible to a read but not to a call.
            // A wrapper delegates to its primitive for anything it does not own.
            // Its prototype's entries are bound methods carrying no receiver, so
            // the generic chain walk below cannot supply one; a user-defined
            // override (a Func) still wins and falls through.
            if isWrapperObj(st, o) && objOwnIndex(st, o, name) < 0 {
                var wrapperOverridden = false
                match getMemberDyn(prog, o, name, st) {
                    JSValue.Func(_wf, _we) => {
                        wrapperOverridden = true
                    }
                    _ => {
                    }
                }
                if !wrapperOverridden {
                    // valueOf unwraps, and there is no primitive method to
                    // delegate it to: a primitive IS its own valueOf, so the
                    // string path answers undefined for it.
                    if name == "valueOf" {
                        popTemp(st)
                        return boxedPrimitive(st, o)
                    }
                    let argVals = evalArgs(prog, argsIdx, st, scope)
                    let r = callBuiltinByName(prog, boxedPrimitive(st, o), name, argVals, st)
                    popTemp(st)
                    return r
                }
            }
            // getMemberDyn so a property whose value comes from a getter is
            // callable, e.g. Object.defineProperty(o, "fn", { get: () => f })
            let m = getMemberDyn(prog, o, name, st)
            match m {
                JSValue.Func(fIdx, envIdx) => {
                    let argVals = evalArgs(prog, argsIdx, st, scope)
                    let r = callFunction(prog, fIdx, envIdx, argVals, JSValue.Obj(o), st)
                    popTemp(st)
                    return r
                }
                JSValue.Native(id) => {
                    let argVals = evalArgs(prog, argsIdx, st, scope)
                    let r = callNativeProg(prog, id, argVals, st)
                    popTemp(st)
                    return r
                }
                JSValue.Obj(fo) => {
                    // a bound-method or bind() result stored as a property: it is
                    // callable (typeof reports "function") but is not a Func/Native
                    if st.objects[fo].isBound || st.objExtras[st.objects[fo].extra].napiFn >= 0 || st.objects[fo].isProxy {
                        let argVals = evalArgs(prog, argsIdx, st, scope)
                        let r = callValue(prog, JSValue.Obj(fo), argVals, JSValue.Obj(o), st)
                        popTemp(st)
                        return r
                    }
                    popTemp(st)
                    st.throwing = true
                    st.thrownValue = makeError(st, "TypeError", name.clone() + " is not a function" + currentModule(st))
                    return JSValue.Undefined
                }
                _ => {
                    // plain objects are not linked to Object.prototype, so its
                    // methods (toString/valueOf) fall through to here
                    if name == "toString" || name == "valueOf" {
                        let argVals = evalArgs(prog, argsIdx, st, scope)
                        let r = callBuiltinByName(prog, JSValue.Obj(o), name, argVals, st)
                        popTemp(st)
                        return r
                    }
                    popTemp(st)
                    st.throwing = true
                    st.thrownValue = makeError(st, "TypeError", name.clone() + " is not a function" + currentModule(st))
                    return JSValue.Undefined
                }
            }
        }
        JSValue.Native(nid) => {
            // Function.prototype.apply/call/bind on a native function
            // (Math.max.apply(null, arr) etc.) — dispatch through callBuiltinByName
            if name == "apply" || name == "call" || name == "bind" {
                let argVals = evalArgs(prog, argsIdx, st, scope)
                return callBuiltinByName(prog, JSValue.Native(nid), name, argVals, st)
            }
            // statics hanging off a native constructor, e.g. String.fromCharCode
            let bag = getNativeProps(st, nid)
            let assigned = getMember(st, bag, name)
            if isCallable(assigned) {
                let argVals = evalArgs(prog, argsIdx, st, scope)
                return callValue(prog, assigned, argVals, JSValue.Native(nid), st)
            }
            if nid == NATIVE_DATE && st.dateCtorProps >= 0 {
                let m = getMember(st, st.dateCtorProps, name)
                if isCallable(m) {
                    let argVals = evalArgs(prog, argsIdx, st, scope)
                    return callValue(prog, m, argVals, JSValue.Undefined, st)
                }
            }
            if nid == NATIVE_STRING && st.stringCtorProps >= 0 {
                let m = getMember(st, st.stringCtorProps, name)
                if isCallable(m) {
                    let argVals = evalArgs(prog, argsIdx, st, scope)
                    return callValue(prog, m, argVals, JSValue.Undefined, st)
                }
            }
            st.throwing = true
            st.thrownValue = makeError(st, "TypeError", name.clone() + " is not a function" + currentModule(st))
            return JSValue.Undefined
        }
        JSValue.Func(bf, benv) => {
            // method call on a function value: either a static (Class.make())
            // or .call/.apply, which retarget `this`
            //
            // An OWN static wins over Function.prototype: `class C { static
            // call() {} }` then `C.call()` must run the static, not
            // Function.prototype.call, which silently returned undefined.
            if name == "call" || name == "apply" || name == "bind" {
                let ownStatics = getFuncStatics(st, bf, benv)
                if objOwnIndex(st, ownStatics, name) >= 0 {
                    let own = getMemberDyn(prog, ownStatics, name, st)
                    if isCallableIn(st, own) {
                        let argVals = evalArgs(prog, argsIdx, st, scope)
                        return callValue(prog, own, argVals, JSValue.Func(bf, benv), st)
                    }
                }
            }
            if name == "bind" {
                let argVals = evalArgs(prog, argsIdx, st, scope)
                var extra: Vec<JSValue> = Vec.new()
                var bi: i64 = 1
                while bi < argVals.len() {
                    extra.push(cloneValue(argVals[bi]))
                    bi = bi + 1
                }
                let bo = newObject(st)
                st.objects[bo].isBound = true
                let ex = ensureExtra(st, bo)
                st.objExtras[ex].boundTarget = JSValue.Func(bf, benv)
                if argVals.len() > 0 {
                    st.objExtras[ex].boundThis = cloneValue(argVals[0])
                }
                let nb0 = extra.len()
                st.objExtras[ex].boundArgs = extra
                finishBind(prog, st, bo, JSValue.Func(bf, benv), nb0)
                return JSValue.Obj(bo)
            }
            if name == "call" || name == "apply" {
                var argVals = evalArgs(prog, argsIdx, st, scope)
                var thisArg = JSValue.Undefined
                var rest: Vec<JSValue> = Vec.new()
                if argVals.len() > 0 {
                    thisArg = cloneValue(argVals[0])
                }
                if name == "apply" {
                    // apply takes the args as one array
                    if argVals.len() > 1 {
                        let ah = objHandle(argVals[1])
                        if ah >= 0 && st.objects[ah].isArray {
                            var ai: i64 = 0
                            while ai < arrLen(st, ah) {
                                rest.push(arrGet(st, ah, ai))
                                ai = ai + 1
                            }
                        }
                    }
                } else {
                    var ai: i64 = 1
                    while ai < argVals.len() {
                        rest.push(cloneValue(argVals[ai]))
                        ai = ai + 1
                    }
                }
                return callFunctionViaMethod(prog, bf, benv, rest, thisArg, st)
            }
            let statics = getFuncStatics(st, bf, benv)
            // getMemberDyn so `static get m()` is invoked and its RESULT is what
            // gets called — C.m() where m is a static accessor returning a
            // function reported "m is not a function"
            let m = getMemberDyn(prog, statics, name, st)
            if st.throwing {
                return JSValue.Undefined
            }
            let mf = funcHandle(m)
            if mf >= 0 {
                let argVals = evalArgs(prog, argsIdx, st, scope)
                return callValue(prog, m, argVals, JSValue.Func(bf, benv), st)
            }
            // a static whose value is a callable object (a bound method, or a
            // generator returned by an accessor) is still callable
            if isCallableIn(st, m) {
                let argVals = evalArgs(prog, argsIdx, st, scope)
                return callValue(prog, m, argVals, JSValue.Func(bf, benv), st)
            }
            st.throwing = true
            st.thrownValue = makeError(st, "TypeError", name.clone() + " is not a function" + currentModule(st))
            return JSValue.Undefined
        }
        _ => {
            st.throwing = true
            st.thrownValue = makeError(st, "TypeError", "cannot read property '" + name.clone() + "' of a non-object" + currentModule(st))
            return JSValue.Undefined
        }
    }
}

// Reading a property of null/undefined is a TypeError, not undefined. Returning
// undefined instead turns a typo into a value that fails much later, somewhere
// unrelated.
fn throwNullMember(st: &mut Interp, name: &string, base: &string): JSValue {
    // No currentModule() suffix here: this message is spec-defined text that real
    // code (and the conformance suite) compares against, so decorating it would
    // corrupt e.message.
    st.throwing = true
    st.thrownValue = makeError(st, "TypeError", "cannot read property '" + name.clone() + "' of " + base.clone())
    return JSValue.Undefined
}

// Parse `src` into the shared program and run it in `scope`, answering the
// completion value (the last value-producing statement), which is what eval
// returns.
//
// Appending to gProg mid-evaluation is the part worth understanding: the arena
// Vecs can reallocate while an outer evalExpr walk is live. It holds because
// Milo's `&Prog` is a second-class reference that is re-read through rather than
// cached across a call, so the walk picks up the new buffer. The stress case is
// covered by tests/evalRuntime.js: 400 eval'd closures escaping into an array,
// each forcing more appends, then all called afterwards.
pub fn runEvalSource(src: &string, st: &mut Interp, scope: i64): JSValue {
    var ep = PState {
        toks: lex(src.clone()), pos: 0, curClass: "", file: "<eval>", errored: false, eofError: false, quiet: true
    }
    let top = parseProgram(ep, gProg)
    // The parser recovers by skipping tokens rather than stopping, so `errored`
    // alone misses input like `var =`. Unconsumed tokens are the other half of
    // the signal: a clean parse ends on EOF.
    var leftover = false
    if ep.pos < ep.toks.len() && ep.toks[ep.pos].kind != T_EOF {
        leftover = true
    }
    if ep.errored || ep.eofError || leftover {
        st.throwing = true
        st.thrownValue = makeError(st, "SyntaxError", "Unexpected token in eval")
        return JSValue.Undefined
    }
    // A top-level `return` is legal in a CommonJS module (node wraps the file in
    // a function) but not in eval, so this check belongs here rather than in the
    // parser, which has no way to tell the two apart.
    var ri: i64 = 0
    while ri < gProg.blocks[top.index].len() {
        match getStmt(gProg, gProg.blocks[top.index][ri]) {
            Stmt.Ret(_rv) => {
                st.throwing = true
                st.thrownValue = makeError(st, "SyntaxError", "Illegal return statement")
                return JSValue.Undefined
            }
            _ => {
            }
        }
        ri = ri + 1
    }
    // `var` and function declarations belong to the CALLER's scope (that is what
    // makes `eval("var q = 6")` visible afterwards), but `let`, `const` and
    // `class` are scoped to the eval itself and must not leak. Hoisting into the
    // caller and executing in a child of it gives both.
    hoistBlock(gProg, top, st, scope)
    let evalScope = newScope(st, scope)
    var result = JSValue.Undefined
    let n = gProg.blocks[top.index].len()
    var i: i64 = 0
    while i < n {
        let sIdx = gProg.blocks[top.index][i]
        match getStmt(gProg, sIdx) {
            Stmt.ExprStmt(e) => {
                result = evalExpr(gProg, e, st, evalScope)
            }
            _ => {
                execStmt(gProg, sIdx, st, evalScope)
            }
        }
        if st.throwing {
            return JSValue.Undefined
        }
        i = i + 1
    }
    return result
}

// The `in` operator. Extracted because it existed twice, and both copies fell
// through to `false` for a NATIVE or a FUNCTION right-hand side: `"prototype" in
// String` answered false while `String.prototype` read fine. get-intrinsic walks
// `%String.prototype.indexOf%` with exactly that test, so every package that
// depends on it (a large slice of npm) died on "base intrinsic for
// %String.prototype.indexOf% exists, but the property is not available".
fn evalInOperator(prog: &Prog, key: string, ov: JSValue, st: &mut Interp): JSValue {
    match cloneValue(ov) {
        JSValue.Obj(o) => {
            if st.objects[o].isProxy {
                let trap = proxyTrap(st, o, "has")
                if isCallableIn(st, trap) {
                    var hargs: Vec<JSValue> = Vec.new()
                    hargs.push(cloneValue(st.objExtras[st.objects[o].extra].proxyTarget))
                    hargs.push(JSValue.Str(key.clone()))
                    return JSValue.Bool(truthy(callValue(prog, trap, hargs, cloneValue(st.objExtras[st.objects[o].extra].proxyHandler), st)))
                }
                var pcur = objHandle(st.objExtras[st.objects[o].extra].proxyTarget)
                while pcur >= 0 {
                    if objHas(st, pcur, key) {
                        return JSValue.Bool(true)
                    }
                    pcur = protoOfHandle(st, pcur)
                }
                return JSValue.Bool(false)
            }
            if st.objects[o].isArray {
                let ai = asArrayIndex(key)
                if ai >= 0 && ai < arrLen(st, o) {
                    return JSValue.Bool(!arrIsHole(st, o, ai))
                }
            }
            var cur = o
            while cur >= 0 {
                if objHas(st, cur, key) {
                    return JSValue.Bool(true)
                }
                cur = protoOfHandle(st, cur)
            }
            return JSValue.Bool(false)
        }
        JSValue.Native(nid) => {
            var ncur = getNativeProps(st, nid)
            while ncur >= 0 {
                if objHas(st, ncur, key) {
                    return JSValue.Bool(true)
                }
                ncur = protoOfHandle(st, ncur)
            }
            return JSValue.Bool(false)
        }
        JSValue.Func(fIdx, fenv) => {
            // every function carries these whether or not they were ever stored
            if key == "prototype" || key == "name" || key == "length" || key == "call" || key == "apply" || key == "bind" || key == "constructor" {
                return JSValue.Bool(true)
            }
            var fcur = getFuncStatics(st, fIdx, fenv)
            while fcur >= 0 {
                if objHas(st, fcur, key) {
                    return JSValue.Bool(true)
                }
                fcur = protoOfHandle(st, fcur)
            }
            return JSValue.Bool(false)
        }
        _ => {
            // `"a" in 5` is a TypeError, not false
            st.throwing = true
            st.thrownValue = makeError(st, "TypeError", "Cannot use 'in' operator to search for '" + key.clone() + "' in " + toStr(ov))
            return JSValue.Undefined
        }
    }
}

// The frame lines for an Error's `.stack`, innermost first. milojs records the
// source file of every function on the call stack (see fnFileStack, added for
// V8-style structured traces), so a stack can name where it came from instead of
// being a bare "Name: message" header.
//
// No line or column: this engine does not record positions per frame, and
// printing ":0:0" would be fake precision a reader would try to use. The path
// alone is the part that is true.
fn errorStackFrames(st: &Interp): string {
    var out = ""
    var n: i64 = 0
    var i = st.fnFileStack.len() - 1
    while i >= 0 && n < 10 {
        if st.fnFileStack[i].len() > 0 {
            out = out + "\n    at " + st.fnFileStack[i].clone()
            n = n + 1
        }
        i = i - 1
    }
    var m = st.modPathStack.len() - 1
    while m >= 0 && n < 10 {
        out = out + "\n    at " + st.modPathStack[m].clone()
        n = n + 1
        m = m - 1
    }
    return out
}

// True while `console.<name>` still holds the builtin this fast path implements.
// A user assignment replaces it with a Func/Obj, and then the call has to go
// through ordinary property dispatch or the assignment is silently ignored.
fn consoleMethodIsPristine(st: &mut Interp, scope: i64, name: &string): bool {
    if !scopeHas(st, scope, "console") {
        return true
    }
    let c = scopeLookup(st, scope, "console")
    let h = objHandle(c)
    if h < 0 {
        return true
    }
    match getMember(st, h, name) {
        JSValue.Native(_n) => {
            return true
        }
        _ => {
            return false
        }
    }
}

fn evalCall(prog: &Prog, calleeId: ExprId, argsIdx: ArgListId, st: &mut Interp, scope: i64): JSValue {
    // builtin: console.log(...)
    match prog.exprs[calleeId.index] {
        Expr.Ident(fname) => {
            // super(...) — parsed as a call of __super$<Class>. The base
            // constructor runs against the instance being built, so `this` has
            // to be threaded through explicitly.
            if isSuperName(fname) {
                let baseVal = scopeLookup(st, scope, fname)
                let thisVal = scopeLookup(st, scope, "this")
                let argVals = evalArgs(prog, argsIdx, st, scope)
                // A native base constructor (class X extends Error) would build
                // and return its own object, discarding `this`. Initialise the
                // instance in place instead, so this.message is set and the
                // instance is recognised by instanceof Error.
                let baseNative = nativeHandle(baseVal)
                if baseNative >= 0 && isErrorCtor(baseNative) {
                    let selfObj = objHandle(thisVal)
                    if selfObj >= 0 {
                        st.objects[selfObj].isError = true
                        objSet(st, selfObj, "name", JSValue.Str(nativeErrorName(baseNative)))
                        var msg = ""
                        if argVals.len() > 0 {
                            msg = toStr(argVals[0])
                        }
                        objSet(st, selfObj, "message", JSValue.Str(msg.clone()))
                        // `class E extends Error {}` produced an instance with
                        // NO stack at all, so the one thing a caller reaches for
                        // when logging a custom error was undefined
                        var subHead = nativeErrorName(baseNative)
                        if msg.len() > 0 {
                            subHead = subHead + ": " + msg
                        }
                        objSet(st, selfObj, "stack", JSValue.Str(subHead + errorStackFrames(st)))
                        objSetNonEnumerable(st, selfObj, "stack")
                    }
                    return JSValue.Undefined
                }
                return callValue(prog, baseVal, argVals, thisVal, st)
            }
            // Direct eval. This used to resolve a bare identifier and hard-error
            // on anything else, with a comment saying there is no runtime
            // compiler. That was never true: src/repl.milo has always lexed and
            // parsed new source into the shared Prog at runtime and executed it,
            // and eval is that same operation with the CALLER's scope instead of
            // the REPL's global one.
            if fname == "eval" && !scopeHasBelowGlobal(st, scope, "eval") {
                let argVals = evalArgs(prog, argsIdx, st, scope)
                if argVals.len() == 0 {
                    return JSValue.Undefined
                }
                match cloneValue(argVals[0]) {
                    JSValue.Str(src) => {
                        return runEvalSource(src, st, scope)
                    }
                    _ => {
                        // eval of a non-string returns the argument untouched
                        return cloneValue(argVals[0])
                    }
                }
            }
            if fname == "require" {
                let argVals = evalArgs(prog, argsIdx, st, scope)
                var spec = ""
                if argVals.len() > 0 {
                    spec = toStr(argVals[0])
                }
                return requireModule(prog, spec, st, scope)
            }
        }
        Expr.Member(objIdx, name) => {
            match prog.exprs[objIdx.index] {
                Expr.Ident(objName) => {
                    // The fast path only applies while console.<name> is still
                    // the ORIGINAL native. It used to fire on the name alone, so
                    // assigning `console.log = fn` had no effect at all: the
                    // call went straight to the builtin and the replacement was
                    // never consulted. Monkey-patching console is how loggers,
                    // test harnesses and output capture all work.
                    if objName == "console" && (name == "log" || name == "error" || name == "warn" || name == "info" || name == "debug" || name == "trace" || name == "dir") && consoleMethodIsPristine(st, scope, name) {
                        let argVals = evalArgs(prog, argsIdx, st, scope)
                        // an argument that threw must not still be printed
                        if st.throwing {
                            return JSValue.Undefined
                        }
                        var line = ""
                        var j: i64 = 0
                        while j < argVals.len() {
                            if j > 0 {
                                line = line + " "
                            }
                            line = line + inspectTop(st, argVals[j])
                            j = j + 1
                        }
                        // same split as the native: diagnostics on stderr
                        if name == "error" || name == "warn" {
                            eprint(line)
                        } else {
                            print(line)
                        }
                        // node line-buffers to a terminal; without flushing here
                        // a Ctrl-C or SIGKILL discards everything the program
                        // printed, which makes a long-running server look silent
                        flush()
                        return JSValue.Undefined
                    }
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }

    // A Member/Index callee is a method call: `this` binds to the receiver.
    // Anything else is a plain call with `this` = undefined.
    match prog.exprs[calleeId.index] {
        Expr.Member(objIdx, name) => {
            // super.method() — the base's *prototype* holds the method, and it
            // must run against the current `this`, not against the base itself
            match prog.exprs[objIdx.index] {
                Expr.Ident(bname) => {
                    if isSuperName(bname) {
                        let baseVal = scopeLookup(st, scope, bname)
                        let bf = funcHandle(baseVal)
                        if bf >= 0 {
                            let baseProto = getFuncProto(st, bf)
                            let m = getMember(st, baseProto, name)
                            let thisVal = scopeLookup(st, scope, "this")
                            let argVals = evalArgs(prog, argsIdx, st, scope)
                            return callValue(prog, m, argVals, thisVal, st)
                        }
                    }
                }
                _ => {
                }
            }
            let recv = evalExpr(prog, objIdx, st, scope)
            if st.optShort {
                return JSValue.Undefined
            }
            // a throw while evaluating the receiver must propagate. Continuing
            // called the method on `undefined`, so a real error deep in a
            // method chain surfaced as "cannot read property 'x' of a
            // non-object" at the NEXT link — pointing at the wrong code.
            if st.throwing {
                return JSValue.Undefined
            }
            return callMember(prog, recv, name, argsIdx, st, scope)
        }
        Expr.Index(objIdx, keyIdx) => {
            let recv = evalExpr(prog, objIdx, st, scope)
            if st.optShort {
                return JSValue.Undefined
            }
            if st.throwing {
                return JSValue.Undefined
            }
            let kv = evalExpr(prog, keyIdx, st, scope)
            let key = toStr(kv)
            return callMember(prog, recv, key, argsIdx, st, scope)
        }
        Expr.OptMember(objIdx, name) => {
            // a?.method(args): dispatch as a method call on the base (so string/
            // native methods resolve) unless the base is nullish
            let recv = evalExpr(prog, objIdx, st, scope)
            if st.optShort {
                return JSValue.Undefined
            }
            if isNullish(recv) {
                st.optShort = true
                return JSValue.Undefined
            }
            return callMember(prog, recv, name, argsIdx, st, scope)
        }
        Expr.OptIndex(objIdx, keyIdx) => {
            let recv = evalExpr(prog, objIdx, st, scope)
            if st.optShort {
                return JSValue.Undefined
            }
            if isNullish(recv) {
                st.optShort = true
                return JSValue.Undefined
            }
            let kv = evalExpr(prog, keyIdx, st, scope)
            let key = toStr(kv)
            return callMember(prog, recv, key, argsIdx, st, scope)
        }
        _ => {
            let calleeVal = evalExpr(prog, calleeId, st, scope)
            // a preceding `?.` short-circuited: the call is skipped, result undefined
            if st.optShort {
                return JSValue.Undefined
            }
            // evaluating the callee can throw (an undeclared name is a
            // ReferenceError); reporting "is not a function" on top of that just
            // buries the real error
            if st.throwing {
                return JSValue.Undefined
            }
            match calleeVal {
                JSValue.Func(fIdx, envIdx) => {
                    pushTemp(st, JSValue.Func(fIdx, envIdx))
                    let argVals = evalArgs(prog, argsIdx, st, scope)
                    let r = callFunction(prog, fIdx, envIdx, argVals, JSValue.Undefined, st)
                    popTemp(st)
                    return r
                }
                JSValue.Native(id) => {
                    let argVals = evalArgs(prog, argsIdx, st, scope)
                    return callNativeProg(prog, id, argVals, st)
                }
                JSValue.Obj(bo) => {
                    // bound methods, addon functions and proxies are all callable
                    // objects rather than Func/Native values
                    if st.objects[bo].isBound || st.objects[bo].isProxy || st.objExtras[st.objects[bo].extra].napiFn >= 0 {
                        let argVals = evalArgs(prog, argsIdx, st, scope)
                        return callValue(prog, JSValue.Obj(bo), argVals, JSValue.Undefined, st)
                    }
                    // Array(n) without `new` behaves identically to new Array(n)
                    if st.arrayCtorObj >= 0 && bo == st.arrayCtorObj {
                        let argVals = evalArgs(prog, argsIdx, st, scope)
                        return makeArrayFromCtor(st, argVals)
                    }
                    st.throwing = true
                    st.thrownValue = makeError(st, "TypeError", describeCallee(prog, calleeId) + " is not a function" + currentModule(st))
                    return JSValue.Undefined
                }
                _ => {
                    st.throwing = true
                    st.thrownValue = makeError(st, "TypeError", describeCallee(prog, calleeId) + " is not a function" + currentModule(st))
                    return JSValue.Undefined
                }
            }
        }
    }
}

// Run the try/catch portion independently so execTry can decide whether a
// finally block exists before it creates a Flow that later code must inspect.
fn execTryBody(prog: &Prog, tryB: BlockId, param: &string, catchB: Option<BlockId>, st: &mut Interp, scope: i64): Flow {
    let tryScope = newScope(st, scope)
    pushActive(st, tryScope)
    var flow = execBlock(prog, tryB, st, tryScope)
    popActive(st)

    // `st.genReturning` deliberately skips catch: a gen.return(v) unwind runs
    // every `finally` but is not a catchable exception in JS
    if st.throwing && !st.genReturning {
        match catchB {
            Option.Some(catchBlock) => {
                let caught = cloneValue(st.thrownValue)
                st.throwing = false
                st.thrownValue = JSValue.Undefined
                let catchScope = newScope(st, scope)
                pushActive(st, catchScope)
                if param.len() > 0 {
                    scopeDefine(st, catchScope, param.clone(), caught)
                }
                flow = execBlock(prog, catchBlock, st, catchScope)
                popActive(st)
            }
            Option.None => {
            }
        }
    }
    return flow
}

// try/catch/finally. The catch binding and both the pending throw value and any
// pending return value are rooted across the finally block (which can allocate
// and collect). finally overrides: its own throw or return wins; otherwise the
// try/catch's pending throw or return is restored.
fn execTry(prog: &Prog, tryB: BlockId, param: &string, catchB: Option<BlockId>, finallyB: Option<BlockId>, st: &mut Interp, scope: i64): Flow {
    if finallyB is Option.None {
        return execTryBody(prog, tryB, param, catchB, st, scope)
    }
    let finallyBlock = finallyB!
    let flow = execTryBody(prog, tryB, param, catchB, st, scope)

    // capture what try/catch left pending, then run finally with a clean slate
    let hadThrow = st.throwing
    let hadGenReturn = st.genReturning
    var savedThrow = cloneValue(st.thrownValue)
    var hadRet = false
    var savedRet = JSValue.Undefined
    match flow {
        Flow.Ret(v) => {
            hadRet = true
            savedRet = cloneValue(v)
        }
        _ => {
        }
    }
    st.throwing = false
    st.genReturning = false
    st.thrownValue = JSValue.Undefined
    // stash the captured values on the temp-root stack so finally's allocations
    // can't collect them, then recover them afterward (Vec.pop returns the value)
    pushTemp(st, savedThrow)
    pushTemp(st, savedRet)
    let finScope = newScope(st, scope)
    pushActive(st, finScope)
    let finFlow = execBlock(prog, finallyBlock, st, finScope)
    popActive(st)
    savedRet = st.tempRoots.pop()!
    savedThrow = st.tempRoots.pop()!

    match finFlow {
        Flow.Ret(fv) => {
            return Flow.Ret(fv)
        }
        _ => {
        }
    }
    if st.throwing {
        return Flow.Normal
    }
    if hadThrow {
        st.throwing = true
        st.genReturning = hadGenReturn
        st.thrownValue = savedThrow
        return Flow.Normal
    }
    if hadRet {
        return Flow.Ret(savedRet)
    }
    return Flow.Normal
}

pub fn execStmt(prog: &Prog, id: StmtId, st: &mut Interp, scope: i64): Flow {
    if st.throwing {
        return Flow.Normal
    }
    // Take any label handed down by an enclosing Stmt.Labeled and clear it, so
    // it reaches only the statement being executed now (a loop reads myLabel; a
    // block or if drops it). Cleared globally here, re-set only by Labeled just
    // before it recurses, so it cannot leak into a nested loop.
    let myLabel = st.pendingLabel.clone()
    st.pendingLabel = ""
    match prog.stmts[id.index] {
        Stmt.Decl(name, e) => {
            let v = evalExpr(prog, e, st, scope)
            scopeDefine(st, scope, name.clone(), v)
            return Flow.Normal
        }
        Stmt.DoWhile(body, cond) => {
            var looping = true
            while looping {
                let flow = execStmt(prog, body, st, scope)
                match flow {
                    Flow.Ret(v) => {
                        return Flow.Ret(v)
                    }
                    Flow.Break(l) => {
                        if l == "" || l == myLabel {
                            looping = false
                        } else {
                            return Flow.Break(l.clone())
                        }
                    }
                    Flow.Continue(l) => {
                        if l != "" && l != myLabel {
                            return Flow.Continue(l.clone())
                        }
                    }
                    Flow.Normal => {
                    }
                }
                if looping {
                    if st.throwing || !truthy(evalExpr(prog, cond, st, scope)) {
                        looping = false
                    }
                }
            }
            return Flow.Normal
        }
        Stmt.Switch(discrIdx, casesIdx) => {
            let dv = evalExpr(prog, discrIdx, st, scope)
            pushTemp(st, cloneValue(dv))
            let n = prog.switches[casesIdx.index].len()
            // pick the arm, then run every arm from there on: fallthrough is the
            // default in JS and only break stops it
            var start = -1
            var defaultAt = -1
            var i: i64 = 0
            while i < n && start < 0 {
                match prog.switches[casesIdx.index][i].test {
                    Option.None => {
                        if defaultAt < 0 {
                            defaultAt = i
                        }
                    }
                    Option.Some(test) => {
                        let tv = evalExpr(prog, test, st, scope)
                        if jsStrictEquals(dv, tv) {
                            start = i
                        }
                    }
                }
                i = i + 1
            }
            if start < 0 {
                start = defaultAt
            }
            var result = Flow.Normal
            if start >= 0 {
                let switchScope = newScope(st, scope)
                pushActive(st, switchScope)
                var c = start
                var going = true
                while going && c < n {
                    let flow = execBlock(prog, prog.switches[casesIdx.index][c].body, st, switchScope)
                    match flow {
                        Flow.Ret(v) => {
                            result = Flow.Ret(v)
                            going = false
                        }
                        Flow.Break(l) => {
                            // an unlabeled break ends the switch; a labeled one
                            // targets an enclosing statement, so let it out
                            going = false
                            if l != "" {
                                result = Flow.Break(l.clone())
                            }
                        }
                        Flow.Continue(l) => {
                            // a continue always belongs to an enclosing loop
                            result = Flow.Continue(l.clone())
                            going = false
                        }
                        Flow.Normal => {
                        }
                    }
                    if st.throwing {
                        going = false
                    }
                    c = c + 1
                }
                popActive(st)
            }
            popTemp(st)
            return result
        }
        Stmt.ClassDecl(classIdx) => {
            let v = instantiateClass(prog, classIdx, st, scope)
            scopeDefine(st, scope, prog.classes[classIdx].name.clone(), v)
            return Flow.Normal
        }
        Stmt.ForOf(name, objExpr, body, isForAwait) => {
            let ov = evalExpr(prog, objExpr, st, scope)
            // the snapshot's element handles are only kept alive by the source
            // object, so it must stay rooted for the whole loop. `holder` keeps
            // alive any values synthesised during iteration (Map pairs), which
            // the source does not reference.
            pushTemp(st, cloneValue(ov))
            let holder = newArray(st)
            pushTemp(st, JSValue.Obj(holder))

            // A user object carrying [Symbol.iterator] drives the real protocol:
            // next() is called lazily, one step per iteration, so an iterator with
            // side effects (or one the body mutates) observes the same order it
            // would in JS. Built-in types below keep their eager snapshot.
            let srcH = objHandle(ov)
            // A generator is its own iterator but its `next` is a native method,
            // not a stored property, so it drives through genNext rather than the
            // getMember(next)+callValue path a user iterator uses.
            var isGen = srcH >= 0 && st.objects[srcH].isGenerator
            var driveIter = isGen
            var iterVal = cloneValue(ov)
            // `for await` takes Symbol.asyncIterator when the object has one;
            // anything else is driven as a sync iterator whose VALUES are then
            // awaited (the spec's CreateAsyncFromSyncIterator)
            var asyncIter = isForAwait && srcH >= 0 && st.objects[srcH].isAsyncGenerator
            if isForAwait && srcH >= 0 && !asyncIter {
                let aFn = getMember(st, srcH, symAsyncIteratorKey())
                if isCallableIn(st, aFn) {
                    var aArgs: Vec<JSValue> = Vec.new()
                    iterVal = callValue(prog, aFn, aArgs, cloneValue(ov), st)
                    driveIter = true
                    asyncIter = true
                    let aH = objHandle(iterVal)
                    isGen = aH >= 0 && st.objects[aH].isGenerator
                }
            }
            if !asyncIter && srcH >= 0 && !isGen && !st.objects[srcH].isArray && !st.objects[srcH].isMap && !st.objects[srcH].isSet {
                let itFn = getMember(st, srcH, symIteratorKey())
                if isCallableIn(st, itFn) {
                    var noArgs: Vec<JSValue> = Vec.new()
                    iterVal = callValue(prog, itFn, noArgs, cloneValue(ov), st)
                    driveIter = true
                }
            }
            if driveIter {
                let iter = cloneValue(iterVal)
                pushTemp(st, cloneValue(iter))
                let iterH = objHandle(iter)
                // `*[Symbol.iterator]() {}` returns a generator, and a generator's
                // `next` is native rather than a stored property — without this the
                // getMember(next) below reports "iterator has no next method" for an
                // object that is perfectly iterable.
                if iterH >= 0 && st.objects[iterH].isGenerator {
                    isGen = true
                }
                let loopScope2 = newScope(st, scope)
                pushActive(st, loopScope2)
                var running = true
                // the iterator ran to done() on its own, so there is nothing to
                // close — see the IteratorClose step after the loop
                var closed = false
                var out = Flow.Normal
                while running && !st.throwing && iterH >= 0 {
                    var step = JSValue.Undefined
                    if isGen {
                        var nArgs: Vec<JSValue> = Vec.new()
                        if st.objects[iterH].isAsyncGenerator {
                            step = genResumeAsync(iterH, nArgs, 0, st)
                        } else {
                            step = genNext(iterH, nArgs, st)
                        }
                    } else {
                        let nextFn = getMember(st, iterH, "next")
                        if !isCallableIn(st, nextFn) {
                            st.throwing = true
                            st.thrownValue = makeError(st, "TypeError", "iterator has no next method" + currentModule(st))
                            running = false
                        } else {
                            var nArgs: Vec<JSValue> = Vec.new()
                            step = callValue(prog, nextFn, nArgs, cloneValue(iter), st)
                        }
                    }
                    if isForAwait && !st.throwing {
                        // an async iterator hands back a promise of {value,done}
                        step = awaitValue(prog, cloneValue(step), st)
                    }
                    if running && !st.throwing {
                        let stepH = objHandle(step)
                        if stepH < 0 || st.throwing {
                            running = false
                            closed = true
                        } else if truthy(getMemberDyn(prog, stepH, "done", st)) {
                            running = false
                            closed = true
                        } else {
                            pushTemp(st, cloneValue(step))
                            // fresh per-iteration binding so body closures don't
                            // all capture the final value (for-of over let/const)
                            let iterScope = newScope(st, loopScope2)
                            pushActive(st, iterScope)
                            var bound = getMemberDyn(prog, stepH, "value", st)
                            if isForAwait && !asyncIter {
                                // sync iterator under `for await`: the VALUE is
                                // what gets awaited, so `for await (x of [p1,p2])`
                                // binds the resolved values
                                bound = awaitValue(prog, cloneValue(bound), st)
                            }
                            scopeDefine(st, iterScope, name.clone(), bound)
                            let flow = execStmt(prog, body, st, iterScope)
                            popActive(st)
                            popTemp(st)
                            match flow {
                                Flow.Ret(v) => {
                                    out = Flow.Ret(v)
                                    running = false
                                }
                                Flow.Break(l) => {
                                    // an unmatched label re-propagates through
                                    // out so the loop's cleanup below still runs
                                    running = false
                                    if l != "" && l != myLabel {
                                        out = Flow.Break(l.clone())
                                    }
                                }
                                Flow.Continue(l) => {
                                    if l != "" && l != myLabel {
                                        out = Flow.Continue(l.clone())
                                        running = false
                                    }
                                }
                                Flow.Normal => {
                                }
                            }
                        }
                    }
                }
                // IteratorClose: a loop abandoned by break, return, or a throw out
                // of the body calls the iterator's return(). That is what runs a
                // generator's `finally` — without it, `for (x of g()) break` left
                // the body parked at its yield and the cleanup never ran.
                if !closed && iterH >= 0 {
                    let hadThrow = st.throwing
                    pushTemp(st, cloneValue(st.thrownValue))
                    st.throwing = false
                    st.thrownValue = JSValue.Undefined
                    if isGen {
                        var rArgs: Vec<JSValue> = Vec.new()
                        let _r = genResume(iterH, rArgs, 2, st)
                    } else {
                        let retFn = getMember(st, iterH, "return")
                        if isCallableIn(st, retFn) {
                            var rArgs: Vec<JSValue> = Vec.new()
                            let _r = callValue(prog, retFn, rArgs, cloneValue(iter), st)
                        }
                    }
                    let savedThrow = st.tempRoots.pop()!
                    if hadThrow {
                        // the loop was already unwinding: an error from return()
                        // is discarded and the original throw wins, as in node
                        st.throwing = true
                        st.thrownValue = savedThrow
                    }
                    // otherwise whatever return() raised propagates on its own
                }
                popActive(st)
                popTemp(st)
                popTemp(st)
                popTemp(st)
                return out
            }

            var vals: Vec<JSValue> = Vec.new()
            var iterable = false
            match ov {
                JSValue.Obj(o) => {
                    if st.objects[o].isArray {
                        iterable = true
                        var e: i64 = 0
                        let ne = arrLen(st, o)
                        while e < ne {
                            vals.push(arrGet(st, o, e))
                            e = e + 1
                        }
                    } else if st.objExtras[st.objects[o].extra].taBuf >= 0 && !st.objects[o].isDataView {
                        // typed array: iterate by element
                        iterable = true
                        var e: i64 = 0
                        while e < st.objExtras[st.objects[o].extra].taLen {
                            vals.push(JSValue.Number(taElem(st, o, e)))
                            e = e + 1
                        }
                    } else if st.objects[o].isMap || st.objects[o].isSet {
                        // a Map yields freshly built [key, value] pairs; a Set
                        // yields its values. The pairs exist only in `vals`,
                        // which the collector cannot see, so they are also held
                        // in a rooted holder array for the life of the loop.
                        iterable = true
                        let isSet = st.objects[o].isSet
                        var e: i64 = 0
                        while e < st.objExtras[st.objects[o].extra].mapKeys.len() {
                            if isSet {
                                vals.push(cloneValue(st.objExtras[st.objects[o].extra].mapKeys[e]))
                            } else {
                                let pair = newArray(st)
                                pushTemp(st, JSValue.Obj(pair))
                                arrPush(st, pair, cloneValue(st.objExtras[st.objects[o].extra].mapKeys[e]))
                                arrPush(st, pair, cloneValue(st.objExtras[st.objects[o].extra].mapVals[e]))
                                popTemp(st)
                                arrPush(st, holder, JSValue.Obj(pair))
                                vals.push(JSValue.Obj(pair))
                            }
                            e = e + 1
                        }
                    }
                }
                JSValue.Str(s) => {
                    iterable = true
                    // iterate Unicode code points, not bytes (é/😀 must stay whole)
                    for cp in strCodePoints(s) {
                        vals.push(JSValue.Str(cp.clone()))
                    }
                }
                _ => {
                }
            }
            if !iterable {
                popTemp(st)
                popTemp(st)
                st.throwing = true
                st.thrownValue = JSValue.Str("TypeError: value is not iterable")
                return Flow.Normal
            }
            let loopScope = newScope(st, scope)
            pushActive(st, loopScope)
            var i: i64 = 0
            var looping = true
            while looping && i < vals.len() {
                // each iteration gets its own binding (for-of over let/const), so a
                // closure made in the body captures that iteration's value, not the
                // last — the isbot `for (let key of ...) getters[key]=...` idiom
                let iterScope = newScope(st, loopScope)
                pushActive(st, iterScope)
                var eagerBound = cloneValue(vals[i])
                if isForAwait {
                    // the eager path covers arrays/strings/Map/Set, all sync, so
                    // `for await` awaits each value: `for await (x of [p1, p2])`
                    // binds the resolved values, not the promises
                    eagerBound = awaitValue(prog, cloneValue(eagerBound), st)
                }
                scopeDefine(st, iterScope, name.clone(), eagerBound)
                let flow = execStmt(prog, body, st, iterScope)
                popActive(st)
                match flow {
                    Flow.Ret(v) => {
                        popActive(st)
                        popTemp(st)
                        popTemp(st)
                        return Flow.Ret(v)
                    }
                    Flow.Break(l) => {
                        looping = false
                        if l != "" && l != myLabel {
                            popActive(st)
                            popTemp(st)
                            popTemp(st)
                            return Flow.Break(l.clone())
                        }
                    }
                    Flow.Continue(l) => {
                        if l != "" && l != myLabel {
                            popActive(st)
                            popTemp(st)
                            popTemp(st)
                            return Flow.Continue(l.clone())
                        }
                    }
                    Flow.Normal => {
                    }
                }
                if st.throwing {
                    looping = false
                }
                i = i + 1
            }
            popActive(st)
            popTemp(st)
            popTemp(st)
            return Flow.Normal
        }
        Stmt.ForIn(name, objExpr, body) => {
            let ov = evalExpr(prog, objExpr, st, scope)
            var keys: Vec<string> = Vec.new()
            match ov {
                JSValue.Obj(o) => {
                    if st.objects[o].isProxy {
                        keys = proxyOwnEnumKeys(prog, st, o)
                    }
                    if st.objects[o].isArray {
                        var e: i64 = 0
                        let ne = st.objects[o].elems.len()
                        while e < ne {
                            if !arrIsHole(st, o, e) {
                                keys.push(i64ToStr(e))
                            }
                            e = e + 1
                        }
                    }
                    // own properties, then inherited ones (JS enumerates the chain)
                    var cur = o
                    while cur >= 0 {
                        let order = enumOrder(st, cur)
                        var oi: i64 = 0
                        while oi < order.len() {
                            let k = order[oi]
                            if st.objects[cur].props[k].enumerable {
                                keys.push(st.objects[cur].props[k].key.clone())
                            }
                            oi = oi + 1
                        }
                        cur = st.objects[cur].proto
                    }
                }
                _ => {
                }
            }
            let loopScope = newScope(st, scope)
            pushActive(st, loopScope)
            var i: i64 = 0
            var looping = true
            while looping && i < keys.len() {
                // fresh per-iteration binding (for-in over let/const) so a closure
                // in the body captures this key, not the last one enumerated
                let iterScope = newScope(st, loopScope)
                pushActive(st, iterScope)
                scopeDefine(st, iterScope, name.clone(), JSValue.Str(keys[i].clone()))
                let flow = execStmt(prog, body, st, iterScope)
                popActive(st)
                match flow {
                    Flow.Ret(v) => {
                        popActive(st)
                        return Flow.Ret(v)
                    }
                    Flow.Break(l) => {
                        looping = false
                        if l != "" && l != myLabel {
                            popActive(st)
                            return Flow.Break(l.clone())
                        }
                    }
                    Flow.Continue(l) => {
                        if l != "" && l != myLabel {
                            popActive(st)
                            return Flow.Continue(l.clone())
                        }
                    }
                    Flow.Normal => {
                    }
                }
                if st.throwing {
                    looping = false
                }
                i = i + 1
            }
            popActive(st)
            return Flow.Normal
        }
        Stmt.MultiDecl(listIdx) => {
            var i: i64 = 0
            let n = prog.declLists[listIdx.index].len()
            while i < n {
                let name = prog.declLists[listIdx.index][i].name.clone()
                let initIdx = prog.declLists[listIdx.index][i].init
                let v = evalExpr(prog, initIdx, st, scope)
                if prog.declLists[listIdx.index][i].isVar {
                    // `var` was already bound in the function scope by hoisting;
                    // assign there rather than shadowing it in this block
                    scopeAssign(st, scope, name, v)
                } else {
                    scopeDefine(st, scope, name, v)
                }
                i = i + 1
            }
            return Flow.Normal
        }
        Stmt.ExprStmt(e) => {
            evalExpr(prog, e, st, scope)
            return Flow.Normal
        }
        Stmt.If(c, t, f) => {
            let vc = evalExpr(prog, c, st, scope)
            if truthy(vc) {
                return execStmt(prog, t, st, scope)
            }
            match f {
                Option.Some(elseStmt) => {
                    return execStmt(prog, elseStmt, st, scope)
                }
                Option.None => {
                }
            }
            return Flow.Normal
        }
        Stmt.While(c, body) => {
            var looping = true
            while looping {
                let vc = evalExpr(prog, c, st, scope)
                if st.throwing || !truthy(vc) {
                    looping = false
                } else {
                    let flow = execStmt(prog, body, st, scope)
                    match flow {
                        Flow.Ret(v) => {
                            return Flow.Ret(v)
                        }
                        Flow.Break(l) => {
                            looping = false
                            if l != "" && l != myLabel {
                                return Flow.Break(l.clone())
                            }
                        }
                        Flow.Continue(l) => {
                            if l != "" && l != myLabel {
                                return Flow.Continue(l.clone())
                            }
                        }
                        Flow.Normal => {
                        }
                    }
                    if st.throwing {
                        looping = false
                    }
                }
            }
            return Flow.Normal
        }
        Stmt.For(init, cond, update, body) => {
            // the loop gets its own scope so `let`/`var` in the init clause don't
            // leak, and closures made per-iteration capture it
            let loopScope = newScope(st, scope)
            pushActive(st, loopScope)
            var letNames: Vec<string> = Vec.new()
            match init {
                Option.Some(initStmt) => {
                execStmt(prog, initStmt, st, loopScope)
                // names the init clause declared with let/const need re-binding
                // per iteration
                match prog.stmts[initStmt.index] {
                    Stmt.MultiDecl(listIdx) => {
                        var di: i64 = 0
                        while di < prog.declLists[listIdx.index].len() {
                            if !prog.declLists[listIdx.index][di].isVar {
                                letNames.push(prog.declLists[listIdx.index][di].name.clone())
                            }
                            di = di + 1
                        }
                    }
                    _ => {
                    }
                }
                }
                Option.None => {
                }
            }
            var looping = true
            while looping {
                if st.throwing {
                    looping = false
                } else {
                    var run = true
                    match cond {
                        Option.Some(condExpr) => {
                            let vc = evalExpr(prog, condExpr, st, loopScope)
                            run = truthy(vc)
                        }
                        Option.None => {
                        }
                    }
                    if !run || st.throwing {
                        looping = false
                    } else {
                        // `for (let i ...)` gives each iteration its own binding,
                        // so a closure made in the body captures that iteration's
                        // value rather than the final one
                        var bodyScope = loopScope
                        if letNames.len() > 0 {
                            bodyScope = newScope(st, loopScope)
                            pushActive(st, bodyScope)
                            var li: i64 = 0
                            while li < letNames.len() {
                                scopeDefine(st, bodyScope, letNames[li].clone(), scopeLookup(st, loopScope, letNames[li]))
                                li = li + 1
                            }
                        }
                        let flow = execStmt(prog, body, st, bodyScope)
                        if letNames.len() > 0 {
                            // copy back so the update clause sees the body's writes
                            var lo: i64 = 0
                            while lo < letNames.len() {
                                scopeAssign(st, loopScope, letNames[lo].clone(), scopeLookup(st, bodyScope, letNames[lo]))
                                lo = lo + 1
                            }
                            popActive(st)
                        }
                        var broke = false
                        match flow {
                            Flow.Ret(v) => {
                                popActive(st)
                                return Flow.Ret(v)
                            }
                            Flow.Break(l) => {
                                broke = true
                                if l != "" && l != myLabel {
                                    popActive(st)
                                    return Flow.Break(l.clone())
                                }
                            }
                            Flow.Continue(l) => {
                                if l != "" && l != myLabel {
                                    popActive(st)
                                    return Flow.Continue(l.clone())
                                }
                            }
                            Flow.Normal => {
                            }
                        }
                        if broke {
                            looping = false
                        } else if st.throwing {
                            looping = false
                        } else {
                            match update {
                                Option.Some(updateExpr) => {
                                    evalExpr(prog, updateExpr, st, loopScope)
                                }
                                Option.None => {
                                }
                            }
                        }
                    }
                }
            }
            popActive(st)
            return Flow.Normal
        }
        Stmt.Throw(e) => {
            let v = evalExpr(prog, e, st, scope)
            if !st.throwing {
                st.throwing = true
                st.thrownValue = v
            }
            return Flow.Normal
        }
        Stmt.Try(tryB, param, catchB, finallyB) => {
            return execTry(prog, tryB, param, catchB, finallyB, st, scope)
        }
        Stmt.Ret(e) => {
            let v = evalExpr(prog, e, st, scope)
            return Flow.Ret(v)
        }
        Stmt.Block(b) => {
            let child = newScope(st, scope)
            pushActive(st, child)
            let flow = execBlock(prog, b, st, child)
            popActive(st)
            return flow
        }
        Stmt.FuncDecl(f) => {
            let name = prog.funcs[f].name.clone()
            scopeDefine(st, scope, name, JSValue.Func(f, scope))
            return Flow.Normal
        }
        Stmt.Empty => {
            return Flow.Normal
        }
        Stmt.Break(label) => {
            return Flow.Break(label.clone())
        }
        Stmt.Continue(label) => {
            return Flow.Continue(label.clone())
        }
        Stmt.Labeled(label, body) => {
            // Hand the label to the wrapped statement (a loop reads it), then run
            // it. A loop consumes a break/continue naming this label and returns
            // Normal. A labeled non-loop (e.g. `foo: { ... break foo }`) does not,
            // so catch a matching break here — that is what makes break out of a
            // labeled block work.
            st.pendingLabel = label.clone()
            let f = execStmt(prog, body, st, scope)
            match f {
                Flow.Break(l) => {
                    if l == label {
                        return Flow.Normal
                    }
                    return Flow.Break(l.clone())
                }
                _ => {
                    return f
                }
            }
        }
    }
}

// Bind `var` declarations and function declarations for a whole function body
// before it runs. JS hoists both to the function scope through arbitrary
// nesting, so this walks into blocks, loops, if/else, switch and try — unlike
// let/const, which stay in the block they are written in.
pub fn hoistBlock(prog: &Prog, blockId: BlockId, st: &mut Interp, scope: i64) {
    var i: i64 = 0
    let n = prog.blocks[blockId.index].len()
    while i < n {
        hoistStmt(prog, prog.blocks[blockId.index][i], st, scope)
        i = i + 1
    }
}

fn hoistStmt(prog: &Prog, id: StmtId, st: &mut Interp, scope: i64) {
    match prog.stmts[id.index] {
        Stmt.FuncDecl(fIdx) => {
            let fname = prog.funcs[fIdx].name.clone()
            if fname.len() > 0 {
                scopeDefine(st, scope, fname, JSValue.Func(fIdx, scope))
            }
        }
        Stmt.MultiDecl(listIdx) => {
            var d: i64 = 0
            while d < prog.declLists[listIdx.index].len() {
                if prog.declLists[listIdx.index][d].isVar {
                    let dname = prog.declLists[listIdx.index][d].name.clone()
                    if dname.len() > 0 && !scopeHasOwn(st, scope, dname) {
                        scopeDefine(st, scope, dname, JSValue.Undefined)
                    }
                }
                d = d + 1
            }
        }
        Stmt.Block(b) => {
            hoistBlock(prog, b, st, scope)
        }
        Stmt.If(_c, thenS, elseS) => {
            hoistStmt(prog, thenS, st, scope)
            match elseS {
                Option.Some(elseStmt) => {
                    hoistStmt(prog, elseStmt, st, scope)
                }
                Option.None => {
                }
            }
        }
        Stmt.While(_c, body) => {
            hoistStmt(prog, body, st, scope)
        }
        Stmt.DoWhile(body, _c) => {
            hoistStmt(prog, body, st, scope)
        }
        Stmt.For(init, _c, _u, body) => {
            match init {
                Option.Some(initStmt) => {
                    hoistStmt(prog, initStmt, st, scope)
                }
                Option.None => {
                }
            }
            hoistStmt(prog, body, st, scope)
        }
        Stmt.ForIn(_nm, _o, body) => {
            hoistStmt(prog, body, st, scope)
        }
        Stmt.ForOf(_nm, _o, body, _aw) => {
            hoistStmt(prog, body, st, scope)
        }
        Stmt.Try(tryB, _p, catchB, finallyB) => {
            hoistBlock(prog, tryB, st, scope)
            match catchB {
                Option.Some(catchBlock) => {
                    hoistBlock(prog, catchBlock, st, scope)
                }
                Option.None => {
                }
            }
            match finallyB {
                Option.Some(finallyBlock) => {
                    hoistBlock(prog, finallyBlock, st, scope)
                }
                Option.None => {
                }
            }
        }
        Stmt.Switch(_d, casesIdx) => {
            var c: i64 = 0
            while c < prog.switches[casesIdx.index].len() {
                hoistBlock(prog, prog.switches[casesIdx.index][c].body, st, scope)
                c = c + 1
            }
        }
        _ => {
        }
    }
}

pub fn execBlock(prog: &Prog, blockId: BlockId, st: &mut Interp, scope: i64): Flow {
    let n = prog.blocks[blockId.index].len()
    var j: i64 = 0
    while j < n {
        // statement boundary = the only GC safepoint (no closure in-flight, all
        // live values rooted in scopes)
        maybeGc(st)
        let sIdx = prog.blocks[blockId.index][j]
        let flow = execStmt(prog, sIdx, st, scope)
        match flow {
            Flow.Ret(v) => {
                return Flow.Ret(v)
            }
            Flow.Break(l) => {
                return Flow.Break(l.clone())
            }
            Flow.Continue(l) => {
                return Flow.Continue(l.clone())
            }
            Flow.Normal => {
            }
        }
        // an exception raised in this statement unwinds out of the block
        if st.throwing {
            return Flow.Normal
        }
        j = j + 1
    }
    return Flow.Normal
}
