// A few method NAMES are shared by builtins whose arities differ, so a table
// keyed by the name alone is necessarily wrong for one of them. `set` is the
// live case: Map.prototype.set and WeakMap.prototype.set take (key, value) and
// report 2, while %TypedArray%.prototype.set takes (array, offset) and reports
// 1. builtinArity holds the TypedArray value, so the host is passed in at the
// sites that know it rather than the constant being flipped (which would only
// move the failure onto TypedArray).
fn builtinArityOn(host: &string, n: &string): i64 {
    if n == "set" && (host == "Map" || host == "WeakMap") {
        return 2
    }
    return builtinArity(n)
}

// The host brand a receiver belongs to, for builtinArityOn. Only the brands
// that take part in an arity conflict need naming; everything else is "".
fn hostBrandOf(st: &Interp, recv: &JSValue): string {
    let h = objHandle(recv)
    if h < 0 {
        return ""
    }
    if st.objects[h].isMap {
        return "Map"
    }
    return ""
}

fn makeBoundMethod(st: &mut Interp, recv: JSValue, name: string): JSValue {
    let host = hostBrandOf(st, recv)
    return makeBoundMethodOn(st, recv, name, host)
}

// A bind() result carries its own `length` — the target's, less the pre-bound
// arguments, floored at 0 — and `name`, which is "bound " prefixed to the
// target's. Both were absent, so a wrapper that preserves arity by reading
// fn.length off a bound function got undefined; function-bind asserts each.
fn finishBind(prog: &Prog, st: &mut Interp, bo: i64, target: &JSValue, nBound: i64) {
    var arity: i64 = 0
    var nm = ""
    match target {
        JSValue.Func(tf, _te) => {
            arity = funcArity(prog, tf)
            nm = prog.funcs[tf].name.clone()
        }
        JSValue.Obj(to) => {
            arity = toNum(getMember(st, to, "length")) as i64
            nm = toStr(getMember(st, to, "name"))
        }
        JSValue.Native(tn) => {
            let bag = getNativeProps(st, tn)
            arity = toNum(getMember(st, bag, "length")) as i64
            nm = toStr(getMember(st, bag, "name"))
        }
        _ => {
        }
    }
    var len = arity - nBound
    if len < 0 {
        len = 0
    }
    objDefineBuiltinAttr(st, bo, "length", JSValue.Number(len as f64))
    objDefineBuiltinAttr(st, bo, "name", JSValue.Str("bound " + nm))
}

fn makeBoundMethodOn(st: &mut Interp, recv: JSValue, name: string, host: string): JSValue {
    let bo = newObject(st)
    st.objects[bo].isBound = true
    let ex = ensureExtra(st, bo)
    st.objExtras[ex].boundThis = recv
    st.objExtras[ex].boundMethod = name.clone()
    // every built-in function has own `name` and `length` — test262 checks one
    // of each per method, with verifyProperty, so they must be real own
    // properties with the spec's attributes and not synthesised on read
    objDefineBuiltinAttr(st, bo, "length", JSValue.Number(builtinArityOn(host, name) as f64))
    objDefineBuiltinAttr(st, bo, "name", JSValue.Str(name))
    return JSValue.Obj(bo)
}

// An array iterator: a plain object holding the source array plus a cursor, with
// `next` and `[Symbol.iterator]` as bound builtin methods. Built this way because
// a native has no per-instance state and JSValue has nowhere to carry a cursor.
// kind: 0 values, 1 keys, 2 entries.
// An array iterator over a string's CODE POINTS: the same yields node's string
// iterator produces, and the object shape callers walk. Shared by the two string
// dispatch sites — the extracted-then-called form and the direct
// `"ab"[Symbol.iterator]()` form take different paths and both need it.
fn makeStringIterator(st: &mut Interp, sv: &string): JSValue {
    let cps = newArray(st)
    pushTemp(st, JSValue.Obj(cps))
    for cp in strCodePoints(sv) {
        arrPush(st, cps, JSValue.Str(cp.clone()))
    }
    let itv = makeArrayIterator(st, cps, 0)
    popTemp(st)
    return itv
}

fn makeArrayIterator(st: &mut Interp, arr: i64, kind: i64): JSValue {
    let it = newObject(st)
    pushTemp(st, JSValue.Obj(it))
    objSet(st, it, "__ai_arr", JSValue.Obj(arr))
    objSet(st, it, "__ai_i", JSValue.Number(0.0))
    objSet(st, it, "__ai_kind", JSValue.Number(kind as f64))
    let nextFn = makeBoundMethod(st, JSValue.Obj(it), "__arrayIterNext")
    objSet(st, it, "next", nextFn)
    let selfFn = makeBoundMethod(st, JSValue.Obj(it), "__arrayIterSelf")
    objSet(st, it, symIteratorKey(), selfFn)
    if st.iterProtoObj >= 0 {
        st.objects[it].proto = st.iterProtoObj
    }
    popTemp(st)
    return JSValue.Obj(it)
}

fn arrayIterNext(st: &mut Interp, it: i64): JSValue {
    let arrV = getMember(st, it, "__ai_arr")
    let arr = objHandle(arrV)
    let i = toNum(getMember(st, it, "__ai_i")) as i64
    let kind = toNum(getMember(st, it, "__ai_kind")) as i64
    let res = newObject(st)
    pushTemp(st, JSValue.Obj(res))
    if arr < 0 || i >= arrLen(st, arr) {
        objSet(st, res, "done", JSValue.Bool(true))
        objSet(st, res, "value", JSValue.Undefined)
    } else {
        objSet(st, it, "__ai_i", JSValue.Number((i + 1) as f64))
        var v = arrGet(st, arr, i)
        if kind == 1 {
            v = JSValue.Number(i as f64)
        } else if kind == 2 {
            let pair = newArray(st)
            pushTemp(st, JSValue.Obj(pair))
            arrPush(st, pair, JSValue.Number(i as f64))
            arrPush(st, pair, arrGet(st, arr, i))
            popTemp(st)
            v = JSValue.Obj(pair)
        }
        objSet(st, res, "value", v)
        objSet(st, res, "done", JSValue.Bool(false))
    }
    popTemp(st)
    return JSValue.Obj(res)
}

// new <T>Array(n | buffer | array) — allocates its own buffer except when handed
// an existing ArrayBuffer, which it views in place (mutations are shared).
// A view whose backing buffer has been detached (ArrayBuffer.prototype.transfer,
// or the test262 host hook). The spec makes such a view behave as a zero-length
// one for length/byteLength/byteOffset, undefined for every index, and a
// TypeError from every %TypedArray%.prototype method.
fn taIsDetached(st: &Interp, o: i64): bool {
    let buf = st.objExtras[st.objects[o].extra].taBuf
    if buf < 0 {
        return false
    }
    return st.objects[buf].abDetached
}

// A relative index argument (negative counts from the end), clamped to [0, n].
fn relIndex(raw: f64, n: i64): i64 {
    var i = raw as i64
    if raw < 0.0 {
        i = n + i
    }
    if i < 0 {
        i = 0
    }
    if i > n {
        i = n
    }
    return i
}

fn makeTypedArray(prog: &Prog, st: &mut Interp, kind: i64, args: &Vec<JSValue>): JSValue {
    let w = taWidth(kind)
    var bufH: i64 = -1
    var viewOffset: i64 = 0
    var len: i64 = 0
    var seed: Vec<f64> = Vec.new()
    if args.len() > 0 {
        let h = objHandle(args[0])
        if h >= 0 && st.objects[h].isArrayBuffer {
            bufH = h
            // new T(buffer, byteOffset, length) — a window into the buffer, not
            // necessarily the whole thing
            var boff: i64 = 0
            if args.len() > 1 {
                boff = toNum(args[1]) as i64
                if boff < 0 {
                    boff = 0
                }
            }
            let avail = st.objExtras[st.objects[h].extra].bytes.len() - boff
            var count = avail / w
            if count < 0 {
                count = 0
            }
            if args.len() > 2 {
                let want = toNum(args[2]) as i64
                if want >= 0 && want < count {
                    count = want
                }
            }
            viewOffset = boff
            len = count
        } else if h >= 0 && st.objects[h].isArray {
            var i: i64 = 0
            while i < arrLen(st, h) {
                seed.push(toNum(arrGet(st, h, i)))
                i = i + 1
            }
            len = seed.len()
        } else if h >= 0 && st.objExtras[st.objects[h].extra].taBuf >= 0 {
            // from another typed array: copy the element values
            var i: i64 = 0
            while i < st.objExtras[st.objects[h].extra].taLen {
                seed.push(taElem(st, h, i))
                i = i + 1
            }
            len = seed.len()
        } else if h >= 0 {
            // any other OBJECT: the spec takes the iterable path when it has
            // Symbol.iterator (a Set, a generator, and here a Buffer) and the
            // array-like path otherwise (`length` plus indexed reads). Neither
            // existed — every such argument fell through to the length branch,
            // where toNum of an object is NaN, so `new Uint8Array(buf)` came
            // back EMPTY rather than throwing.
            // same drivability test iterableToArray itself uses — a Set/Map
            // carries no Symbol.iterator PROPERTY, so probing for one alone
            // would send `new Uint8Array(new Set([1,2,3]))` down the array-like
            // path and produce an empty view
            let drivable = st.objects[h].isGenerator || st.objects[h].isMap
                || st.objects[h].isSet
                || isCallableIn(st, getMember(st, h, symIteratorKey()))
            var srcH: i64 = -1
            if drivable {
                let arr = iterableToArray(prog, cloneValue(args[0]), st)
                srcH = objHandle(arr)
            }
            if srcH >= 0 {
                pushTemp(st, JSValue.Obj(srcH))
                var i: i64 = 0
                while i < arrLen(st, srcH) {
                    seed.push(toNum(arrGet(st, srcH, i)))
                    i = i + 1
                }
                popTemp(st)
            } else {
                let lv = toNum(getMemberDyn(prog, h, "length", st))
                var ln: i64 = 0
                if lv == lv && lv > 0.0 {
                    ln = lv as i64
                }
                var i: i64 = 0
                while i < ln {
                    seed.push(toNum(getMemberDyn(prog, h, i64ToStr(i), st)))
                    i = i + 1
                }
            }
            len = seed.len()
        } else {
            len = toNum(args[0]) as i64
            if len < 0 {
                len = 0
            }
        }
    }
    if bufH < 0 {
        let nb = newObject(st)
        st.objects[nb].isArrayBuffer = true
        st.objects[nb].proto = arrayBufferProto(st)
        let _e = ensureExtra(st, nb)
        var b: Vec<u8> = Vec.new()
        var i: i64 = 0
        while i < len * w {
            b.push(0 as u8)
            i = i + 1
        }
        st.objExtras[st.objects[nb].extra].bytes = b
        bufH = nb
    }
    let view = newObject(st)
    let _ev = ensureExtra(st, view)
    st.objExtras[st.objects[view].extra].taBuf = bufH
    st.objExtras[st.objects[view].extra].taKind = kind
    st.objects[view].proto = typedArrayProtoFor(st, kind)
    st.objExtras[st.objects[view].extra].taOffset = viewOffset
    st.objExtras[st.objects[view].extra].taLen = len
    var k: i64 = 0
    while k < seed.len() {
        taSetElem(st, view, k, seed[k])
        k = k + 1
    }
    return JSValue.Obj(view)
}

fn taElem(st: &Interp, view: i64, i: i64): f64 {
    let buf = st.objExtras[st.objects[view].extra].taBuf
    if buf < 0 || i < 0 || i >= st.objExtras[st.objects[view].extra].taLen {
        return 0.0
    }
    let w = taWidth(st.objExtras[st.objects[view].extra].taKind)
    let at = st.objExtras[st.objects[view].extra].taOffset + i * w
    // the backing buffer may have been resized/detached under this view (a sort
    // comparator or a length getter can do it) — out-of-range reads yield 0
    if at < 0 || at + w > st.objExtras[st.objects[buf].extra].bytes.len() {
        return 0.0
    }
    return taLoad(st.objExtras[st.objects[buf].extra].bytes, st.objExtras[st.objects[view].extra].taKind, at)
}

fn taSetElem(st: &mut Interp, view: i64, i: i64, v: f64) {
    let buf = st.objExtras[st.objects[view].extra].taBuf
    if buf < 0 || i < 0 || i >= st.objExtras[st.objects[view].extra].taLen {
        return
    }
    let kind = st.objExtras[st.objects[view].extra].taKind
    let w = taWidth(kind)
    let at = st.objExtras[st.objects[view].extra].taOffset + i * w
    // a resized/detached buffer drops the write rather than overflowing its bytes
    if at < 0 || at + w > st.objExtras[st.objects[buf].extra].bytes.len() {
        return
    }
    taStore(st.objExtras[st.objects[buf].extra].bytes, kind, at, v)
}

// Invoke a builtin method by name against an already-evaluated receiver+args.
fn callBuiltinByName(prog: &Prog, recv: &JSValue, name: &string, args: Vec<JSValue>, st: &mut Interp): JSValue {
    // a per-module `require` value: the receiver carries the directory it was
    // bound to, so resolution matches the module the reference came from
    if name == "__require" {
        var rspec = ""
        if args.len() > 0 {
            rspec = toStr(args[0])
        }
        return requireModuleFrom(prog, rspec, st, toStr(recv))
    }
    // Object.prototype.toString applied to ANY receiver, ignoring overrides
    if name == "@@objProtoToString" {
        let o = objHandle(recv)
        if o >= 0 {
            // a user [Symbol.toStringTag] (a plain string, possibly via a getter)
            // wins over the built-in tag: class { get [Symbol.toStringTag](){…} }
            let tag = getMemberDyn(prog, o, symToStringTagKey(), st)
            match tag {
                JSValue.Str(ts) => {
                    if !isSymbolStr(ts) {
                        return JSValue.Str("[object " + ts + "]")
                    }
                }
                _ => {
                }
            }
            return JSValue.Str("[object " + objectTag(st, o) + "]")
        }
        match recv {
            JSValue.Func(fi, _fe) => {
                return JSValue.Str("[object " + funcTag(prog, fi) + "]")
            }
            _ => {
            }
        }
        return JSValue.Str("[object " + objectTypeTag(recv) + "]")
    }
    // A primitive receiver reaching a built-in method value: this is
    // `Number.prototype.toString.call(255, 16)` and friends, which fell through
    // to the generic "[object Number]" tag above instead of dispatching.
    if isPrimitiveMethodName(name) {
        match recv {
            JSValue.Number(_pn) => {
                return primitiveMethod(name, recv, args)
            }
            JSValue.Bool(_pb) => {
                return primitiveMethod(name, recv, args)
            }
            JSValue.BigInt(_pg) => {
                return primitiveMethod(name, recv, args)
            }
            _ => {
            }
        }
    }
    match recv {
        JSValue.Str(sv) => {
            if isSymbolStr(sv) && name == "toString" {
                return JSValue.Str(symbolDisplay(sv))
            }
            // Array.prototype.map.call("abc", f) — an array method a string does
            // NOT also define runs generically over the string's units. Names
            // both sides share (slice, indexOf, concat, at…) stay with the
            // string, which is what a bare "abc".slice() must keep doing.
            if isArrayMethod(name) && !isStringMethodName(name) {
                return arrayMethodGeneric(prog, JSValue.Str(sv.clone()), name, args, st)
            }
            if stringOpNeedsRegexArg(st, name, args) {
                let ra = regexArgFor(st, name, args)
                return stringRegexOp(prog, sv, name, ra, st)
            }
            if isStringRegexOp(st, name, args) {
                return stringRegexOp(prog, sv, name, args, st)
            }
            if name == "concat" {
                return JSValue.Str(strConcatProg(prog, sv, args, st))
            }
            if name == "__stringIterator" || name == symIteratorKey() {
                return makeStringIterator(st, sv)
            }
            if stringArgsNeedCoercion(name, args) {
                let ca = coercedStringArgs(prog, name, args, st)
                if st.throwing {
                    return JSValue.Undefined
                }
                return stringMethod(name, sv, ca, st)
            }
            return stringMethod(name, sv, args, st)
        }
        JSValue.Obj(o) => {
            // .call/.apply/.bind on a BUILT-IN method value. This is the
            // uncurry-this idiom —
            //   var hop = Function.prototype.call.bind(Object.prototype.hasOwnProperty)
            // — which arrives here as receiver = the built-in, name = "call".
            // Nothing handled it, so it returned undefined. test262's
            // propertyHelper.js is built entirely out of this, so EVERY
            // verifyProperty test failed regardless of the property involved.
            if st.objects[o].isBound && (name == "call" || name == "apply" || name == "bind") {
                var uThis = JSValue.Undefined
                if args.len() > 0 {
                    uThis = cloneValue(args[0])
                }
                var uRest: Vec<JSValue> = Vec.new()
                if name == "apply" {
                    if args.len() > 1 {
                        let ah = objHandle(args[1])
                        if ah >= 0 && st.objects[ah].isArray {
                            var ai: i64 = 0
                            while ai < arrLen(st, ah) {
                                uRest.push(arrGet(st, ah, ai))
                                ai = ai + 1
                            }
                        }
                    }
                } else {
                    var ai: i64 = 1
                    while ai < args.len() {
                        uRest.push(cloneValue(args[ai]))
                        ai = ai + 1
                    }
                }
                if name == "bind" {
                    let nb = newObject(st)
                    st.objects[nb].isBound = true
                    let nex = ensureExtra(st, nb)
                    st.objExtras[nex].boundTarget = JSValue.Obj(o)
                    st.objExtras[nex].boundThis = uThis
                    let nb1 = uRest.len()
                    st.objExtras[nex].boundArgs = uRest
                    finishBind(prog, st, nb, JSValue.Obj(o), nb1)
                    return JSValue.Obj(nb)
                }
                return callValue(prog, JSValue.Obj(o), uRest, uThis, st)
            }
            // array iterator steps: state lives in properties on the iterator
            // object itself, which is also the bound receiver
            if name == "__arrayIterNext" {
                return arrayIterNext(st, o)
            }
            if name == "__arrayIterSelf" {
                return JSValue.Obj(o)
            }
            if st.objects[o].isArrayBuffer {
                if name == "resize" {
                    var to: i64 = 0
                    if args.len() > 0 {
                        to = toNum(args[0]) as i64
                    }
                    // only a buffer created with {maxByteLength} may resize, and
                    // only within [0, cap]
                    if st.objExtras[st.objects[o].extra].abMaxLen < 0 || to < 0 || to > st.objExtras[st.objects[o].extra].abMaxLen {
                        st.throwing = true
                        st.thrownValue = makeError(st, "RangeError", "ArrayBuffer.prototype.resize: invalid length")
                        return JSValue.Undefined
                    }
                    var b: Vec<u8> = Vec.new()
                    var ci: i64 = 0
                    while ci < to {
                        if ci < st.objExtras[st.objects[o].extra].bytes.len() {
                            b.push(st.objExtras[st.objects[o].extra].bytes[ci])
                        } else {
                            b.push(0 as u8)
                        }
                        ci = ci + 1
                    }
                    st.objExtras[st.objects[o].extra].bytes = b
                    return JSValue.Undefined
                }
                if name == "transfer" {
                    let nb = newObject(st)
                    st.objects[nb].isArrayBuffer = true
        st.objects[nb].proto = arrayBufferProto(st)
                    let _e = ensureExtra(st, nb)
                    var tb: Vec<u8> = Vec.new()
                    var ti: i64 = 0
                    while ti < st.objExtras[st.objects[o].extra].bytes.len() {
                        tb.push(st.objExtras[st.objects[o].extra].bytes[ti])
                        ti = ti + 1
                    }
                    st.objExtras[st.objects[nb].extra].bytes = tb
                    st.objExtras[st.objects[nb].extra].abMaxLen = st.objExtras[st.objects[o].extra].abMaxLen
                    st.objExtras[st.objects[o].extra].bytes = Vec.new()
                    st.objects[o].abDetached = true
                    return JSValue.Obj(nb)
                }
                if name == "slice" {
                    let n = st.objExtras[st.objects[o].extra].bytes.len()
                    var a: i64 = 0
                    if args.len() > 0 {
                        a = toNum(args[0]) as i64
                    }
                    if a < 0 {
                        a = n + a
                    }
                    var e = n
                    if args.len() > 1 {
                        e = toNum(args[1]) as i64
                        if e < 0 {
                            e = n + e
                        }
                    }
                    if a < 0 {
                        a = 0
                    }
                    if e > n {
                        e = n
                    }
                    let nb = newObject(st)
                    st.objects[nb].isArrayBuffer = true
        st.objects[nb].proto = arrayBufferProto(st)
                    let _e = ensureExtra(st, nb)
                    var b: Vec<u8> = Vec.new()
                    var i = a
                    while i < e {
                        b.push(st.objExtras[st.objects[o].extra].bytes[i])
                        i = i + 1
                    }
                    st.objExtras[st.objects[nb].extra].bytes = b
                    return JSValue.Obj(nb)
                }
            }
            // Date-specific methods dispatch here (Date.prototype.toISOString.call);
            // toString/valueOf are left to the Object.prototype type-tag logic
            // below, so Object.prototype.toString.call(date) stays [object Date]
            if st.objects[o].isDate {
                // `toString` and `valueOf` were excluded here, so a Date reached
                // through a bound method value — which is every generic
                // conversion, since ToPrimitive reads them off the prototype —
                // fell through to the object tag: `String(d)` and `"" + d` both
                // answered "[object Date]", and `d.valueOf.call(d)` answered the
                // ISO string instead of the epoch number.
                return dateMethod(st, o, name, args)
            }
            if st.objects[o].isMap || st.objects[o].isSet {
                return mapMethod(prog, o, name, args, st)
            }
            // a bound regex/buffer/typed-array method re-dispatches through here,
            // so these must be reachable or an extracted method silently does
            // nothing (no throw, no result — the process just unwinds)
            if st.objExtras[st.objects[o].extra].regexId >= 0 && isRegexMethodName(name) {
                return regexMethod(st, o, name, args)
            }
            if st.objects[o].isDataView && isDataViewMethodName(name) {
                return dataViewMethod(o, name, args, st)
            }
            if st.objects[o].isGenerator {
                var gmode: i64 = -1
                if name == "next" {
                    gmode = 0
                } else if name == "throw" {
                    gmode = 1
                } else if name == "return" {
                    gmode = 2
                }
                if gmode >= 0 {
                    if st.objects[o].isAsyncGenerator {
                        return genResumeAsync(o, args, gmode, st)
                    }
                    return genResume(o, args, gmode, st)
                }
                // a generator is its own iterator: gen[Symbol.iterator]() === gen
                if name == symIteratorKey() || name == symAsyncIteratorKey() {
                    return JSValue.Obj(o)
                }
            }
            if st.objExtras[st.objects[o].extra].taBuf >= 0 && isTypedArrayMethodName(name) {
                return typedArrayMethod(prog, o, name, args, st)
            }
            // A Node-API Buffer's `.bytes` is an array-like native view with
            // Array.prototype in its chain. Re-looking up that same bound method
            // here recurses forever; apply the generic operation to the view.
            if nativeBufferLen(st, o) >= 0 && isArrayMethod(name) {
                return arrayMethodGeneric(prog, JSValue.Obj(o), name, args, st)
            }

            if name == "hasOwnProperty" {
                var key = ""
                if args.len() > 0 {
                    key = toStr(args[0])
                }
                return JSValue.Bool(objOwnIndex(st, o, key) >= 0 || (st.objects[o].isArray && asArrayIndex(key) >= 0 && asArrayIndex(key) < arrLen(st, o) && !arrIsHole(st, o, asArrayIndex(key))))
            }
            if name == "toString" {
                // Array.prototype.toString is join(","), not the type tag. The
                // tag path is @@objProtoToString, a different name entirely.
                if st.objects[o].isArray {
                    return JSValue.Str(joinArray(st, o, ","))
                }
                // Error.prototype.toString is "Name: message", NOT the type tag —
                // this is the path String(err) and `"" + err` take through
                // ToPrimitive, and the tag made them print "[object Error]".
                // Object.prototype.toString.call(err) is unaffected: it arrives
                // under the private @@objProtoToString name.
                if st.objects[o].isError {
                    let en = toStr(objGet(st, o, "name"))
                    let em = toStr(objGet(st, o, "message"))
                    if em.len() > 0 {
                        return JSValue.Str(en + ": " + em)
                    }
                    return JSValue.Str(en)
                }
                if st.objects[o].isDate {
                    return JSValue.Str("[object Date]")
                }
                return JSValue.Str("[object Object]")
            }
            if name == "valueOf" {
                return JSValue.Obj(o)
            }
            if name == "isPrototypeOf" {
                if args.len() == 0 {
                    return JSValue.Bool(false)
                }
                let other = objHandle(args[0])
                if other < 0 {
                    return JSValue.Bool(false)
                }
                var pcur = st.objects[other].proto
                while pcur >= 0 {
                    if pcur == o {
                        return JSValue.Bool(true)
                    }
                    pcur = st.objects[pcur].proto
                }
                return JSValue.Bool(false)
            }
            if name == "propertyIsEnumerable" {
                var key = ""
                if args.len() > 0 {
                    key = toStr(args[0])
                }
                // own AND enumerable — a non-enumerable own prop is still `false`
                let pi = objOwnIndex(st, o, key)
                return JSValue.Bool(pi >= 0 && st.objects[o].props[pi].enumerable)
            }
            if st.objects[o].isArray && isArrayMethod(name) {
                return arrayMethod(prog, o, name, args, st)
            }
            let m = getMemberDyn(prog, o, name, st)
            // Array.prototype.<m>.call(arrayLike, …): the receiver has no such
            // method of its own, so the spec's generic definition applies. Only
            // reached when lookup came up empty, so ({map: f}).map() still calls
            // the object's own map.
            if isUndefinedValue(m) && isArrayMethod(name) {
                return arrayMethodGeneric(prog, JSValue.Obj(o), name, args, st)
            }
            return callValue(prog, m, args, JSValue.Obj(o), st)
        }
        JSValue.Func(bf, benv) => {
            if name == "toString" {
                let fname = prog.funcs[bf].name.clone()
                return JSValue.Str("function " + fname + "() { [native code] }")
            }
            if name == "hasOwnProperty" {
                var key = ""
                if args.len() > 0 {
                    key = toStr(args[0])
                }
                let statics = getFuncStatics(st, bf, benv)
                return JSValue.Bool(objOwnIndex(st, statics, key) >= 0)
            }
            // Function.prototype.apply.call(fn, thisArg, args) lands here with
            // recv = fn: re-dispatch against the function itself
            if name == "call" || name == "apply" {
                var thisArg = JSValue.Undefined
                if args.len() > 0 {
                    thisArg = cloneValue(args[0])
                }
                var rest: Vec<JSValue> = Vec.new()
                if name == "apply" {
                    if args.len() > 1 {
                        let ah = objHandle(args[1])
                        if ah >= 0 && st.objects[ah].isArray {
                            var ai: i64 = 0
                            while ai < arrLen(st, ah) {
                                rest.push(arrGet(st, ah, ai))
                                ai = ai + 1
                            }
                        }
                    }
                } else {
                    var ai: i64 = 1
                    while ai < args.len() {
                        rest.push(cloneValue(args[ai]))
                        ai = ai + 1
                    }
                }
                return callFunctionViaMethod(prog, bf, benv, rest, thisArg, st)
            }
            if name == "bind" {
                let bo = newObject(st)
                st.objects[bo].isBound = true
                var extra: Vec<JSValue> = Vec.new()
                var bi: i64 = 1
                while bi < args.len() {
                    extra.push(cloneValue(args[bi]))
                    bi = bi + 1
                }
                let ex = ensureExtra(st, bo)
                st.objExtras[ex].boundTarget = JSValue.Func(bf, benv)
                if args.len() > 0 {
                    st.objExtras[ex].boundThis = cloneValue(args[0])
                }
                let nb0 = extra.len()
                st.objExtras[ex].boundArgs = extra
                finishBind(prog, st, bo, JSValue.Func(bf, benv), nb0)
                return JSValue.Obj(bo)
            }
            let statics = getFuncStatics(st, bf, benv)
            let m = getMember(st, statics, name)
            if isCallable(m) {
                return callValue(prog, m, args, JSValue.Func(bf, benv), st)
            }
            return JSValue.Undefined
        }
        _ => {
            // .apply / .call / .bind on a native function (Math.max.apply, …).
            // recv is the function; re-dispatch it through callValue, which
            // routes a Native to callNative.
            if name == "apply" || name == "call" {
                var thisArg = JSValue.Undefined
                if args.len() > 0 {
                    thisArg = cloneValue(args[0])
                }
                var rest: Vec<JSValue> = Vec.new()
                if name == "apply" {
                    if args.len() > 1 {
                        let ah = objHandle(args[1])
                        if ah >= 0 && st.objects[ah].isArray {
                            var ai: i64 = 0
                            while ai < arrLen(st, ah) {
                                rest.push(arrGet(st, ah, ai))
                                ai = ai + 1
                            }
                        }
                    }
                } else {
                    var ai: i64 = 1
                    while ai < args.len() {
                        rest.push(cloneValue(args[ai]))
                        ai = ai + 1
                    }
                }
                return callValue(prog, recv, rest, thisArg, st)
            }
            if name == "bind" {
                let bo = newObject(st)
                st.objects[bo].isBound = true
                var extra: Vec<JSValue> = Vec.new()
                var bi: i64 = 1
                while bi < args.len() {
                    extra.push(cloneValue(args[bi]))
                    bi = bi + 1
                }
                let ex = ensureExtra(st, bo)
                st.objExtras[ex].boundTarget = cloneValue(recv)
                if args.len() > 0 {
                    st.objExtras[ex].boundThis = cloneValue(args[0])
                }
                let nb4 = extra.len()
                st.objExtras[ex].boundArgs = extra
                finishBind(prog, st, bo, recv, nb4)
                return JSValue.Obj(bo)
            }
            if name == "toString" {
                return JSValue.Str("[object " + objectTypeTag(recv) + "]")
            }
            if name == "valueOf" {
                return cloneValue(recv)
            }
            // Array.prototype.<m>.call(null) must throw the spec's ToObject
            // TypeError, and .call(42) must behave as an empty array — both
            // handled by the generic adapter rather than silently answering
            // undefined here
            if isArrayMethod(name) {
                return arrayMethodGeneric(prog, cloneValue(recv), name, args, st)
            }
            return primitiveMethod(name, recv, args)
        }
    }
}

// The tag Object.prototype.toString uses for a heap-object receiver.
fn objectTag(st: &Interp, o: i64): string {
    if isWrapperObj(st, o) {
        match st.objExtras[st.objects[o].extra].boxed {
            JSValue.Str(bs) => {
                if isSymbolStr(bs) {
                    return "Symbol"
                }
                return "String"
            }
            JSValue.Number(_bn) => {
                return "Number"
            }
            JSValue.Bool(_bb) => {
                return "Boolean"
            }
            JSValue.BigInt(_bg) => {
                return "BigInt"
            }
            _ => {
            }
        }
    }
    if st.objects[o].isArray {
        return "Array"
    }
    if st.objects[o].isError {
        return "Error"
    }
    if st.objects[o].isDate {
        return "Date"
    }
    if st.objExtras[st.objects[o].extra].regexId >= 0 {
        return "RegExp"
    }
    if st.objects[o].isMap {
        return "Map"
    }
    if st.objects[o].isSet {
        return "Set"
    }
    if st.objects[o].promiseState >= 0 {
        return "Promise"
    }
    // @@toStringTag for the buffer family: a view reports its exact kind
    // ("[object Int8Array]"), which test262 asserts throughout
    if st.objects[o].isDataView {
        return "DataView"
    }
    if st.objects[o].isArrayBuffer {
        return "ArrayBuffer"
    }
    if st.objExtras[st.objects[o].extra].taBuf >= 0 {
        return taName(st.objExtras[st.objects[o].extra].taKind)
    }
    // A generator OBJECT is not a plain object: node reports [object Generator],
    // and util.types.isGeneratorObject is built on exactly this tag.
    if st.objects[o].isAsyncGenerator {
        return "AsyncGenerator"
    }
    if st.objects[o].isGenerator {
        return "Generator"
    }
    if st.objects[o].isBound || st.objects[o].isFunctionLike {
        return "Function"
    }
    return "Object"
}

// The tag for a FUNCTION value, which needs the Prog to see whether the
// definition was async or a generator. Object.prototype.toString reports
// [object AsyncFunction] / [object GeneratorFunction] for those, and
// util.types.isAsyncFunction and isGeneratorFunction read them.
fn funcTag(prog: &Prog, fIdx: i64): string {
    if fIdx < 0 || fIdx >= prog.funcs.len() {
        return "Function"
    }
    if prog.funcs[fIdx].isAsync && prog.funcs[fIdx].isGenerator {
        return "AsyncGeneratorFunction"
    }
    if prog.funcs[fIdx].isAsync {
        return "AsyncFunction"
    }
    if prog.funcs[fIdx].isGenerator {
        return "GeneratorFunction"
    }
    return "Function"
}

// The tag Object.prototype.toString uses for a primitive receiver.
fn objectTypeTag(v: &JSValue): string {
    match v {
        JSValue.Undefined => {
            return "Undefined"
        }
        JSValue.Null => {
            return "Null"
        }
        JSValue.Bool(_b) => {
            return "Boolean"
        }
        JSValue.Number(_n) => {
            return "Number"
        }
        JSValue.Str(s) => {
            // symbols are interned strings in this engine, so the tag has to come
            // from the marker rather than the value kind
            if isSymbolStr(s) {
                return "Symbol"
            }
            return "String"
        }
        JSValue.Func(_f, _e) => {
            return "Function"
        }
        JSValue.Native(_n) => {
            return "Function"
        }
        _ => {
            return "Object"
        }
    }
}

fn setMemberDyn(prog: &Prog, o: i64, key: string, v: JSValue, st: &mut Interp) {
    if st.objects[o].isProxy {
        let trap = proxyTrap(st, o, "set")
        let target = cloneValue(st.objExtras[st.objects[o].extra].proxyTarget)
        if isCallableIn(st, trap) {
            var args: Vec<JSValue> = Vec.new()
            args.push(cloneValue(target))
            args.push(JSValue.Str(key.clone()))
            args.push(cloneValue(v))
            args.push(JSValue.Obj(o))
            let _r = callValue(prog, trap, args, cloneValue(st.objExtras[st.objects[o].extra].proxyHandler), st)
            return
        }
        let th = objHandle(target)
        if th >= 0 {
            setMemberDyn(prog, th, key, v, st)
        }
        return
    }
    // `o.__proto__ = X` is a setter on Object.prototype in the spec. Only the
    // READ side existed (getMemberDyn resolves it), so the write silently made
    // an ordinary own property named "__proto__" and the object kept its old
    // prototype — the ES5 inheritance idiom `Child.prototype.__proto__ = Parent.prototype`
    // did nothing at all.
    if key == "__proto__" {
        match v {
            JSValue.Null => {
                st.objects[o].proto = -1
            }
            _ => {
                let np = propertyBagOf(st, v)
                if np >= 0 {
                    st.objects[o].proto = np
                }
            }
        }
        return
    }
    let sfn = findSetter(st, o, key)
    if isCallable(sfn) {
        var args: Vec<JSValue> = Vec.new()
        args.push(v)
        let _ = callValue(prog, sfn, args, JSValue.Obj(o), st)
        return
    }
    // a getter with no setter: writing is a silent no-op in sloppy mode, and
    // must not replace the accessor with a plain data property
    let own = objOwnIndex(st, o, key)
    if own >= 0 && propIsAccessor(st, o, own) {
        return
    }
    setMember(st, o, key, v)
}

pub fn getMember(st: &Interp, o: i64, key: &string): JSValue {
    let nativeLen = nativeBufferLen(st, o)
    if nativeLen >= 0 {
        if key == "length" {
            return JSValue.Number(nativeLen as f64)
        }
        let ni = asArrayIndex(key)
        if ni >= 0 {
            return nativeBufferGet(st, o, ni)
        }
    }
    // A DataView shares taBuf/taOffset/taLen with typed arrays but is not
    // index-accessible and its byteLength is already in bytes. Handle its props
    // here and skip the typed-array element path below.
    if st.objects[o].isDataView {
        if key == "byteLength" {
            return JSValue.Number(st.objExtras[st.objects[o].extra].taLen as f64)
        }
        if key == "byteOffset" {
            return JSValue.Number(st.objExtras[st.objects[o].extra].taOffset as f64)
        }
        if key == "buffer" {
            return JSValue.Obj(st.objExtras[st.objects[o].extra].taBuf)
        }
    }
    if st.objExtras[st.objects[o].extra].taBuf >= 0 && !st.objects[o].isDataView {
        // a detached view reports zeroes rather than its stale extent
        if taIsDetached(st, o) && (key == "length" || key == "byteLength" || key == "byteOffset") {
            return JSValue.Number(0.0)
        }
        if key == "length" {
            return JSValue.Number(st.objExtras[st.objects[o].extra].taLen as f64)
        }
        if key == "byteLength" {
            return JSValue.Number((st.objExtras[st.objects[o].extra].taLen * taWidth(st.objExtras[st.objects[o].extra].taKind)) as f64)
        }
        if key == "byteOffset" {
            return JSValue.Number(st.objExtras[st.objects[o].extra].taOffset as f64)
        }
        if key == "BYTES_PER_ELEMENT" {
            return JSValue.Number(taWidth(st.objExtras[st.objects[o].extra].taKind) as f64)
        }
        if key == "buffer" {
            return JSValue.Obj(st.objExtras[st.objects[o].extra].taBuf)
        }
        let ti = asArrayIndex(key)
        if ti >= 0 {
            // a detached view has no elements, so every index reads undefined
            if taIsDetached(st, o) {
                return JSValue.Undefined
            }
            if ti >= st.objExtras[st.objects[o].extra].taLen {
                return JSValue.Undefined
            }
            return JSValue.Number(taElem(st, o, ti))
        }
    }
    if st.objects[o].isArrayBuffer {
        if key == "byteLength" {
            return JSValue.Number(st.objExtras[st.objects[o].extra].bytes.len() as f64)
        }
        if key == "maxByteLength" {
            if st.objExtras[st.objects[o].extra].abMaxLen >= 0 {
                return JSValue.Number(st.objExtras[st.objects[o].extra].abMaxLen as f64)
            }
            return JSValue.Number(st.objExtras[st.objects[o].extra].bytes.len() as f64)
        }
        if key == "resizable" {
            return JSValue.Bool(st.objExtras[st.objects[o].extra].abMaxLen >= 0)
        }
        if key == "detached" {
            return JSValue.Bool(st.objects[o].abDetached)
        }
    }
    if st.objects[o].isArray {
        if key == "length" {
            return JSValue.Number(arrLen(st, o) as f64)
        }
        let ai = asArrayIndex(key)
        if ai >= 0 {
            return arrGet(st, o, ai)
        }
    }
    // own property first, then walk the prototype chain
    var cur = o
    while cur >= 0 {
        if objHas(st, cur, key) {
            return objGet(st, cur, key)
        }
        cur = st.objects[cur].proto
    }
    return JSValue.Undefined
}

fn setMember(st: &mut Interp, o: i64, key: string, value: JSValue) {
    if nativeBufferLen(st, o) >= 0 {
        let ni = asArrayIndex(key)
        if ni >= 0 {
            let _ = nativeBufferSet(st, o, ni, toNum(value))
            return
        }
    }
    // Any write to a builtin prototype retires its fast dispatch path for the
    // rest of the run. Calls then resolve through the real chain so a replaced
    // method remains authoritative even if the original is restored later.
    if o == st.arrayProtoObj {
        st.arrayProtoPristine = false
    }
    if o == st.stringProtoObj {
        st.stringProtoPristine = false
    }
    // sloppy mode drops writes to a frozen object rather than throwing
    if st.objects[o].frozen {
        return
    }
    // non-extensible: existing properties stay writable, new ones are refused
    if st.objects[o].noExtend && objOwnIndex(st, o, key) < 0 && !st.objects[o].isArray {
        return
    }
    // a non-writable data property silently ignores assignment in sloppy mode
    let own = objOwnIndex(st, o, key)
    if own >= 0 && !propIsAccessor(st, o, own) && !st.objects[o].props[own].writable {
        return
    }
    if st.objExtras[st.objects[o].extra].taBuf >= 0 && !st.objects[o].isDataView {
        let ti = asArrayIndex(key)
        if ti >= 0 {
            // a write through a detached view is dropped, not an error
            if !taIsDetached(st, o) {
                taSetElem(st, o, ti, toNum(value))
            }
            return
        }
    }
    // globalThis.x = v defines/updates the global binding, not a detached property
    if st.objects[o].isGlobal {
        scopeDefine(st, 0, key, value)
        return
    }
    if st.objects[o].isArray {
        let ai = asArrayIndex(key)
        if ai >= 0 {
            arrSet(st, o, ai, value)
            return
        }
        if key == "length" {
            let rawLength = toNum(value)
            let arrayLength = rawLength as i64
            if !(rawLength == rawLength) || rawLength < 0.0 || rawLength > 4294967295.0 || (arrayLength as f64) != rawLength {
                st.throwing = true
                st.thrownValue = makeError(st, "RangeError", "Invalid array length")
                return
            }
            setArrayLength(st, o, arrayLength)
            return
        }
    }
    objSet(st, o, key, value)
}

// One element of a value being destructured: `value[i]`. Arrays/array-likes go
// through getMember by index; a string yields its i-th character.
fn destructElement(_prog: &Prog, value: &JSValue, i: i64, st: &mut Interp): JSValue {
    let vh = objHandle(value)
    if vh >= 0 {
        return getMember(st, vh, i64ToStr(i))
    }
    match value {
        JSValue.Str(s) => {
            // s[i] indexes UTF-16 code units like charAt, not raw UTF-8 bytes —
            // "café"[3] is "é", not the first byte of its 2-byte encoding
            if i >= 0 && i < utf16Length(s) {
                return JSValue.Str(utf16Slice(s, i, i + 1))
            }
        }
        _ => {
        }
    }
    return JSValue.Undefined
}

// Assign `value` to a single destructuring target: a nested pattern recurses; a
// `name = default` element applies the default when value is undefined; otherwise
// the target is an ordinary lvalue (identifier / member / index).
fn assignTarget(prog: &Prog, targetId: ExprId, value: JSValue, st: &mut Interp, scope: i64) {
    match prog.exprs[targetId.index] {
        Expr.ArrLit(_li) => {
            assignPattern(prog, targetId, value, st, scope)
        }
        Expr.ObjLit(_li) => {
            assignPattern(prog, targetId, value, st, scope)
        }
        Expr.Assign(name, defaultIdx) => {
            var v = cloneValue(value)
            if isUndefinedValue(value) {
                v = evalExpr(prog, defaultIdx, st, scope)
            }
            scopeAssign(st, scope, name.clone(), cloneValue(v))
        }
        _ => {
            writeLValue(prog, targetId, st, scope, cloneValue(value))
        }
    }
}

// Destructure `value` into a pattern (ArrLit / ObjLit) of existing lvalue
// targets. Handles nesting, holes, `...rest`, and `= default` elements.
fn assignPattern(prog: &Prog, patId: ExprId, value: JSValue, st: &mut Interp, scope: i64) {
    match prog.exprs[patId.index] {
        Expr.ArrLit(litIdx) => {
            // `const [a, b] = obj` reads obj[0], obj[1] — right for arrays and
            // strings, empty for an object that is iterable and nothing else.
            let items = iterableToArray(prog, value, st)
            pushTemp(st, cloneValue(items))
            var i: i64 = 0
            while i < prog.arrLits[litIdx.index].len() {
                match prog.arrLits[litIdx.index][i] {
                    Option.Some(e) => {
                    match prog.exprs[e.index] {
                        Expr.Spread(target) => {
                        // ...rest — the remaining elements as a fresh array
                        let rest = newArray(st)
                        pushTemp(st, JSValue.Obj(rest))
                        let vh = objHandle(items)
                        if vh >= 0 {
                            let vn = arrLen(st, vh)
                            var j = i
                            while j < vn {
                                arrPush(st, rest, arrGet(st, vh, j))
                                j = j + 1
                            }
                        }
                        popTemp(st)
                        assignTarget(prog, target, JSValue.Obj(rest), st, scope)
                    }
                        _ => {
                            let ev = destructElement(prog, items, i, st)
                            assignTarget(prog, e, ev, st, scope)
                        }
                    }
                    }
                    Option.None => {
                        // elision: skip this position
                    }
                }
                i = i + 1
            }
            popTemp(st)
        }
        Expr.ObjLit(litIdx) => {
            pushTemp(st, cloneValue(value))
            let vh = objHandle(value)
            var i: i64 = 0
            while i < prog.objLits[litIdx.index].len() {
                let key = prog.objLits[litIdx.index][i].key.clone()
                let target = prog.objLits[litIdx.index][i].val
                var pv = JSValue.Undefined
                if vh >= 0 {
                    pv = getMemberDyn(prog, vh, key, st)
                }
                assignTarget(prog, target, pv, st, scope)
                i = i + 1
            }
            popTemp(st)
        }
        _ => {
            assignTarget(prog, patId, value, st, scope)
        }
    }
}

// Read an assignable target (identifier / member / computed index) as a value.
// Backs ++/-- and compound assignment; the base object of a member target is
// evaluated here and again by writeLValue (harmless unless the base has side
// effects, which is rare).
fn readLValue(prog: &Prog, targetId: ExprId, st: &mut Interp, scope: i64): JSValue {
    match prog.exprs[targetId.index] {
        Expr.Ident(name) => {
            match scopeTryLookup(st, scope, name) {
                Option.Some(v) => {
                    return v
                }
                Option.None => {
                    // reading an undeclared identifier is a ReferenceError in JS;
                    // without this a typo just evaluates to undefined and the
                    // failure surfaces somewhere else entirely
                    st.throwing = true
                    st.thrownValue = makeError(st, "ReferenceError", name.clone() + " is not defined")
                    return JSValue.Undefined
                }
            }
        }
        Expr.Member(objIdx, name) => {
            let ov = evalExpr(prog, objIdx, st, scope)
            match ov {
                JSValue.Obj(o) => {
                    return getMember(st, o, name)
                }
                JSValue.Func(fIdx, fe) => {
                    // a class static read as an lvalue (C.count++)
                    let statics = getFuncStatics(st, fIdx, fe)
                    return getMemberDyn(prog, statics, name, st)
                }
                _ => {
                    return JSValue.Undefined
                }
            }
        }
        Expr.Index(objIdx, keyIdx) => {
            let ov = evalExpr(prog, objIdx, st, scope)
            // the key expression can run user code and collect the base
            pushTemp(st, cloneValue(ov))
            let kv = evalExpr(prog, keyIdx, st, scope)
            popTemp(st)
            let key = toStr(kv)
            match ov {
                JSValue.Obj(o) => {
                    return getMember(st, o, key)
                }
                JSValue.Func(fIdx, fe) => {
                    let statics = getFuncStatics(st, fIdx, fe)
                    return getMemberDyn(prog, statics, key, st)
                }
                _ => {
                    return JSValue.Undefined
                }
            }
        }
        _ => {
            return JSValue.Undefined
        }
    }
}

fn writeLValue(prog: &Prog, targetId: ExprId, st: &mut Interp, scope: i64, value: JSValue) {
    match prog.exprs[targetId.index] {
        Expr.Ident(name) => {
            scopeAssign(st, scope, name.clone(), value)
        }
        Expr.Member(objIdx, name) => {
            let ov = evalExpr(prog, objIdx, st, scope)
            match ov {
                JSValue.Obj(o) => {
                    setMember(st, o, name.clone(), value)
                }
                JSValue.Func(fIdx, fe) => {
                    // a class static written as an lvalue (C.count++)
                    let statics = getFuncStatics(st, fIdx, fe)
                    // setMemberDyn so a `static set x(v)` accessor is invoked;
                    // the plain set overwrote the accessor with a data property
                    setMemberDyn(prog, statics, name.clone(), value, st)
                }
                _ => {
                }
            }
        }
        Expr.Index(objIdx, keyIdx) => {
            let ov = evalExpr(prog, objIdx, st, scope)
            // the key expression can run user code and collect the base
            pushTemp(st, cloneValue(ov))
            let kv = evalExpr(prog, keyIdx, st, scope)
            popTemp(st)
            let key = toStr(kv)
            match ov {
                JSValue.Obj(o) => {
                    setMember(st, o, key, value)
                }
                JSValue.Func(fIdx, fe) => {
                    let statics = getFuncStatics(st, fIdx, fe)
                    setMemberDyn(prog, statics, key, value, st)
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
}

// Built-in function/constructor ids. The Error family shares one path; the
// specific kind is carried in the object's `name` property.
let NATIVE_ERROR: i64 = 0
let NATIVE_TYPE_ERROR: i64 = 1
let NATIVE_RANGE_ERROR: i64 = 2
let NATIVE_SYNTAX_ERROR: i64 = 3
let NATIVE_REFERENCE_ERROR: i64 = 4
let NATIVE_JSON_STRINGIFY: i64 = 5
let NATIVE_JSON_PARSE: i64 = 6
let NATIVE_MATH_FLOOR: i64 = 7
let NATIVE_MATH_CEIL: i64 = 8
let NATIVE_MATH_ROUND: i64 = 9
let NATIVE_MATH_TRUNC: i64 = 10
let NATIVE_MATH_ABS: i64 = 11
let NATIVE_MATH_SIGN: i64 = 12
let NATIVE_MATH_LOG2: i64 = 98
let NATIVE_MATH_LOG10: i64 = 99
let NATIVE_MATH_EXP: i64 = 89
let NATIVE_MATH_LOG: i64 = 90
let NATIVE_MATH_SIN: i64 = 91
let NATIVE_MATH_COS: i64 = 92
let NATIVE_MATH_TAN: i64 = 93
let NATIVE_MATH_ASIN: i64 = 94
let NATIVE_MATH_ACOS: i64 = 95
let NATIVE_MATH_ATAN: i64 = 96
let NATIVE_MATH_ATAN2: i64 = 97
let NATIVE_MATH_SQRT: i64 = 13
let NATIVE_MATH_POW: i64 = 14
let NATIVE_MATH_MIN: i64 = 15
let NATIVE_MATH_MAX: i64 = 16
let NATIVE_MATH_RANDOM: i64 = 17
let NATIVE_REGEXP: i64 = 18
let NATIVE_OBJECT_DEFINEPROPERTY: i64 = 19
let NATIVE_OBJECT_KEYS: i64 = 20
let NATIVE_OBJECT_ASSIGN: i64 = 21
let NATIVE_NUMBER: i64 = 22
pub let NATIVE_STRING: i64 = 23
let NATIVE_BOOLEAN: i64 = 24
let NATIVE_READ_FILE_SYNC: i64 = 25
let NATIVE_FILE_EXISTS: i64 = 26
let NATIVE_OBJECT_VALUES: i64 = 27
let NATIVE_OBJECT_ENTRIES: i64 = 28
let NATIVE_OBJECT_FREEZE: i64 = 29
let NATIVE_PROMISE_RESOLVE: i64 = 30
let NATIVE_PROMISE_REJECT: i64 = 31
// 32/33/34 were Promise.all/allSettled/race. They are self-hosted in the prelude
// now: the native took a synchronous snapshot of each input's state instead of
// subscribing to it, and could not adopt a thenable at all (calling user .then
// needs the program, which a native does not have). Ids left retired rather than
// reused so an old id in a serialized form can never mean something new.
// `new Promise(cb)` hands its executor a resolve/reject pair bound to one
// specific promise. Natives are identified by a bare id, so the promise handle
// is encoded into the id itself: base + handle*2 + (0 resolve | 1 reject).
let NATIVE_PROMISE: i64 = 35
let NATIVE_IS_NAN: i64 = 36
let NATIVE_IS_FINITE: i64 = 37
let NATIVE_ARRAY_ISARRAY: i64 = 38
let NATIVE_OBJECT_CREATE: i64 = 39
let NATIVE_OBJECT_GETPROTO: i64 = 40
let NATIVE_OBJECT_SETPROTO: i64 = 41
let NATIVE_OBJECT_GETOWNPROPDESC: i64 = 42
let NATIVE_PARSE_INT: i64 = 43
let NATIVE_PARSE_FLOAT: i64 = 44
let NATIVE_SYMBOL: i64 = 45
let NATIVE_OBJECT_DEFINEPROPERTIES: i64 = 46
let NATIVE_MAP: i64 = 47
let NATIVE_SET: i64 = 48
let NATIVE_OBJECT_GETOWNPROPNAMES: i64 = 49
let NATIVE_ARRAY_FROM: i64 = 50
pub let NATIVE_PROCESS_EXIT: i64 = 51
pub let NATIVE_NOOP: i64 = 52
pub let NATIVE_PROCESS_HRTIME: i64 = 53
pub let NATIVE_PROCESS_CWD: i64 = 54
let NATIVE_STRING_FROMCHARCODE: i64 = 55
pub let NATIVE_DATE: i64 = 56
let NATIVE_DATE_NOW: i64 = 57
// Date.UTC(year, month[, day, hours, minutes, seconds, ms]) — the fields are
// interpreted as UTC and out-of-range values roll over (month 12 is January of
// the next year), which falls out of doing the arithmetic in days and seconds
// rather than validating each field.
let NATIVE_DATE_UTC: i64 = 110
// The Object constructor itself. Registering the global as a plain object made
// `typeof Object` report "object" and `new Object()` fail outright — both used
// constantly, and by three of the QuickJS builtin tests.
let NATIVE_OBJECT_CTOR: i64 = 111
let NATIVE_ENCODE_URI_COMPONENT: i64 = 58
let NATIVE_DECODE_URI_COMPONENT: i64 = 59
let NATIVE_ENCODE_URI: i64 = 60
let NATIVE_DECODE_URI: i64 = 61
let NATIVE_SET_TIMEOUT: i64 = 62
let NATIVE_SET_INTERVAL: i64 = 63
let NATIVE_CLEAR_TIMER: i64 = 64
let NATIVE_SET_IMMEDIATE: i64 = 65
pub let NATIVE_QUEUE_MICROTASK: i64 = 66
// queueMicrotask has its own native (distinct from process.nextTick, which
// shares NATIVE_QUEUE_MICROTASK) so it can call the callback with zero
// arguments per spec while nextTick's behaviour is left untouched.
let NATIVE_QUEUE_MICROTASK_JS: i64 = 112
let NATIVE_DATAVIEW: i64 = 113
let NATIVE_OBJECT_HASOWN: i64 = 114
let NATIVE_STRING_RAW: i64 = 115
let NATIVE_STRING_FROMCODEPOINT: i64 = 116
let NATIVE_DATE_PARSE: i64 = 117
let NATIVE_MKDIR: i64 = 118
let NATIVE_READDIR: i64 = 119
let NATIVE_UNLINK: i64 = 120
let NATIVE_RMDIR: i64 = 121
let NATIVE_RENAME: i64 = 122
let NATIVE_IS_DIR: i64 = 123
let NATIVE_BIGINT: i64 = 124
let NATIVE_OBJECT_GETOWNPROPSYMBOLS: i64 = 125
let NATIVE_OBJECT_GETOWNPROPDESCS: i64 = 126
let NATIVE_ARRAY_CTOR: i64 = 67
let NATIVE_TCP_LISTEN: i64 = 68
let NATIVE_TCP_ACCEPT: i64 = 69
let NATIVE_TCP_RECV: i64 = 70
let NATIVE_TCP_SEND: i64 = 71
let NATIVE_TCP_CLOSE: i64 = 72
let NATIVE_HTTP_REGISTER: i64 = 73
let NATIVE_HTTP_UNREGISTER: i64 = 74
let NATIVE_WRITE_FILE: i64 = 75
let NATIVE_GC: i64 = 76
let NATIVE_OBJECT_ISFROZEN: i64 = 77
let NATIVE_OBJECT_PREVENTEXT: i64 = 100
let NATIVE_OBJECT_ISEXT: i64 = 101
let NATIVE_OBJECT_SEAL: i64 = 102
let NATIVE_OBJECT_ISSEALED: i64 = 103
// __byteLength(s): the raw UTF-8 byte count of an engine string. JS `.length`
// decodes to code points and charCodeAt is lossy on bytes that aren't valid
// UTF-8, so neither can measure file content read as a string. Content-Length
// must come from here or binary responses (fonts, images) get truncated.
let NATIVE_BYTE_LENGTH: i64 = 104
// __napiLoad(path): dlopen a .node addon, run napi_register_module_v1, return its
// exports. This is what require() resolves a .node file to.
let NATIVE_NAPI_LOAD: i64 = 105
// console.* as real functions. The identifier fast path above handles the common
// `console.log(x)` call shape, but code that passes the method around — prisma's
// runtime does `console.debug || console.log` — needs `console` to be a real
// object whose properties are callable values.
pub let NATIVE_CONSOLE_LOG: i64 = 106
// console.error/warn: same formatting, stderr instead of stdout
let NATIVE_CONSOLE_ERROR: i64 = 152
// new Proxy(target, handler)
let NATIVE_PROXY: i64 = 107
// Object.is — SameValue: like ===, except NaN equals itself and +0 differs
// from -0. ts-pattern (bundled into prisma's runtime) matches literals with it.
let NATIVE_OBJECT_IS: i64 = 108
// __httpFetchAsync(method, url, headersJson, body): runs the request on a worker
// OS thread and returns a promise the event loop settles with the raw response.
let NATIVE_HTTP_FETCH_ASYNC: i64 = 109
let NATIVE_ARRAYBUFFER: i64 = 78
// the typed-array constructors occupy a contiguous block so the element kind is
// just (id - NATIVE_TA_BASE); keep in step with the TA_* order in runtime.milo
let NATIVE_TA_BASE: i64 = 79
// __httpFetch(method, url, headersJson, body): synchronous outbound HTTP/HTTPS.
// Above the TA block (79..87). node-fetch is built on this.
let NATIVE_HTTP_FETCH: i64 = 88

// node:sqlite primitives (lib/sqlite.js wraps these into the Node API shape).
// Databases and statements are addressed by index into st.sqliteDbs/sqliteStmts;
// JS never sees a pointer. Left a gap above the last id (126) so the unrelated
// blocks stay easy to extend.
let NATIVE_SQLITE_OPEN: i64 = 130
let NATIVE_SQLITE_CLOSE: i64 = 131
let NATIVE_SQLITE_EXEC: i64 = 132
let NATIVE_SQLITE_PREPARE: i64 = 133
let NATIVE_SQLITE_ERRMSG: i64 = 134
let NATIVE_SQLITE_STEP: i64 = 135
let NATIVE_SQLITE_COLUMN_COUNT: i64 = 136
let NATIVE_SQLITE_COLUMN_NAME: i64 = 137
let NATIVE_SQLITE_COLUMN_VALUE: i64 = 138
let NATIVE_SQLITE_BIND: i64 = 139
let NATIVE_SQLITE_RESET: i64 = 140
let NATIVE_SQLITE_FINALIZE: i64 = 141
let NATIVE_SQLITE_CHANGES: i64 = 142
let NATIVE_SQLITE_LAST_INSERT_ID: i64 = 143
let NATIVE_SQLITE_BIND_INDEX: i64 = 144
let NATIVE_SQLITE_FILENAME: i64 = 145
// The engine's console.log renderer, exposed to JS so lib/util.js does not have
// to keep a second, diverging copy of node's util.inspect.
pub let NATIVE_INSPECT: i64 = 146
// ArrayBuffer.isView(x): true for a typed-array view or a DataView, and
// crucially FALSE for an ArrayBuffer itself
let NATIVE_ARRAYBUFFER_ISVIEW: i64 = 147
// EvalError and URIError are core ECMAScript constructors that simply did not
// exist: `EvalError` was a ReferenceError at the first mention, and get-intrinsic
// (a dependency of a large slice of npm) reads all seven error constructors on
// its first line. They do not fit the contiguous NATIVE_ERROR..NATIVE_REFERENCE_ERROR
// range — 0..4 is full — so the range checks below name them explicitly.
let NATIVE_EVAL_ERROR: i64 = 148
let NATIVE_URI_ERROR: i64 = 149
// `eval` as a VALUE. There is no runtime compiler, so calling this throws — but
// it has to EXIST, because get-intrinsic tabulates `'%eval%': eval` on its way
// to being required by a large slice of npm. The direct-call form
// `eval("bareIdent")` is handled at the call site and still works.
let NATIVE_EVAL: i64 = 150
// `Function(body)` / `new Function(a, b, body)`. Built on the same evaluator as
// eval: `Function("return this")()` is the classic globalThis probe, and
// es-get-iterator and function-bind both build their test subjects with it.
let NATIVE_FUNCTION_CTOR: i64 = 153
// __callFrames() → the module paths currently executing, innermost first. This
// is what Error.captureStackTrace turns into V8 CallSite objects: `bindings`
// (under better-sqlite3 and most native addons) discovers the filename of its
// CALLER through Error.prepareStackTrace and CallSite#getFileName, and with no
// frames at all it read undefined and threw on `fileName.indexOf`.
let NATIVE_CALL_FRAMES: i64 = 151

// sqlite3_column_name is not wrapped by std/sqlite, but node:sqlite's get()/all()
// return row objects keyed by column name, so it is declared here directly. The
// libsqlite3 link flag already comes from the std/sqlite import.
extern fn sqlite3_column_name(stmt: *u8, col: i32): *u8

// Named parameters (`$id`, `:id`, `@id`) resolve to a 1-based index through this;
// also not wrapped by std/sqlite. Returns 0 for a name the statement does not use.
extern fn sqlite3_bind_parameter_index(stmt: *u8, name: *u8): i32

// The path sqlite resolved the connection to, which is what Node's
// DatabaseSync.location() reports (not the string the caller passed).
extern fn sqlite3_db_filename(db: *u8, dbName: *u8): *u8

// A live index into st.sqliteDbs, or -1 when the handle is closed or bogus. Every
// sqlite native funnels through this so a use-after-close is a JS-level error
// rather than a call on a freed sqlite3*.
fn sqliteDbIdx(st: &Interp, v: &JSValue): i64 {
    let i = toNum(v) as i64
    if i < 0 || i >= st.sqliteDbs.len() || !st.sqliteDbLive[i] {
        return 0 - 1
    }
    return i
}

fn sqliteStmtIdx(st: &Interp, v: &JSValue): i64 {
    let i = toNum(v) as i64
    if i < 0 || i >= st.sqliteStmts.len() || !st.sqliteStmtLive[i] {
        return 0 - 1
    }
    return i
}

// The `.name` of a native constructor (Object.name === "Object" etc), so
// `err.constructor.name` and similar resolve. Empty for natives that are not
// named constructors.
fn nativeCtorName(id: i64): string {
    if id >= NATIVE_ERROR && id <= NATIVE_REFERENCE_ERROR {
        return nativeErrorName(id)
    }
    if id == NATIVE_OBJECT_CTOR {
        return "Object"
    }
    if id == NATIVE_NUMBER {
        return "Number"
    }
    if id == NATIVE_BIGINT {
        return "BigInt"
    }
    if id == NATIVE_STRING {
        return "String"
    }
    if id == NATIVE_BOOLEAN {
        return "Boolean"
    }
    return ""
}

fn nativeErrorName(id: i64): string {
    if id == NATIVE_TYPE_ERROR {
        return "TypeError"
    }
    if id == NATIVE_RANGE_ERROR {
        return "RangeError"
    }
    if id == NATIVE_SYNTAX_ERROR {
        return "SyntaxError"
    }
    if id == NATIVE_REFERENCE_ERROR {
        return "ReferenceError"
    }
    if id == NATIVE_EVAL_ERROR {
        return "EvalError"
    }
    if id == NATIVE_URI_ERROR {
        return "URIError"
    }
    return "Error"
}

fn isErrorCtor(id: i64): bool {
    return (id >= NATIVE_ERROR && id <= NATIVE_REFERENCE_ERROR) || id == NATIVE_EVAL_ERROR || id == NATIVE_URI_ERROR
}

// Reverse of nativeErrorName: the constructor id for a kind string, so an error
// raised internally by makeError links to the same prototype a constructed one
// does. Unknown kinds (URIError, EvalError — thrown by name but with no native
// constructor) fall back to Error.
fn errorCtorIdFor(kind: &string): i64 {
    if kind == "TypeError" {
        return NATIVE_TYPE_ERROR
    }
    if kind == "RangeError" {
        return NATIVE_RANGE_ERROR
    }
    if kind == "SyntaxError" {
        return NATIVE_SYNTAX_ERROR
    }
    if kind == "ReferenceError" {
        return NATIVE_REFERENCE_ERROR
    }
    if kind == "EvalError" {
        return NATIVE_EVAL_ERROR
    }
    if kind == "URIError" {
        return NATIVE_URI_ERROR
    }
    return NATIVE_ERROR
}

// Invoke a native function/constructor. Error(msg) and new Error(msg) behave the
// same (both mint an error object), matching JS.
// Synchronous outbound HTTP/HTTPS. Milo has no coroutines and the event loop is
// drained in place on await, so a blocking request is consistent with the rest of
// the runtime (the server side blocks on accept too). Returns the raw HTTP
// response text prefixed with 'O', or 'E' + message on any failure — the JS side
// (lib/node-fetch.js) strips the sentinel and parses the response.
fn doHttpFetch(method: &string, url: &string, headersRaw: &string, body: &string): string {
    // parse scheme://host[:port]/path
    var rest = url.clone()
    var tls = true
    var defPort: i64 = 443
    if jsStartsWith(rest, "https://") {
        rest = strSlice(rest, 8, rest.len())
    } else if jsStartsWith(rest, "http://") {
        tls = false
        defPort = 80
        rest = strSlice(rest, 7, rest.len())
    } else {
        return "Eunsupported URL scheme: " + url.clone()
    }
    // host[:port] is up to the first '/'
    var slash = jsIndexOf(rest, "/", 0)
    var authority = rest.clone()
    var path = "/"
    if slash >= 0 {
        authority = strSlice(rest, 0, slash)
        path = strSlice(rest, slash, rest.len())
    }
    var host = authority.clone()
    var port = defPort
    let colon = jsIndexOf(authority, ":", 0)
    if colon >= 0 {
        host = strSlice(authority, 0, colon)
        let portStr = strSlice(authority, colon + 1, authority.len())
        port = toNum(JSValue.Str(portStr)) as i64
        if port <= 0 {
            port = defPort
        }
    }
    // DNS
    var ip: u32 = 0
    match resolve(host) {
        Result.Ok(a) => {
            ip = a
        }
        Result.Err(_e) => {
            return "Ecannot resolve host: " + host.clone()
        }
    }
    // build the request. HTTP/1.1 with Connection: close so the read loop ends at
    // EOF instead of needing to parse content-length/chunked to know when to stop.
    var req = method.clone() + " " + path.clone() + " HTTP/1.1\r\n"
    req = req + "Host: " + host.clone() + "\r\n"
    req = req + headersRaw.clone()
    req = req + "Connection: close\r\n"
    if body.len() > 0 {
        req = req + "Content-Length: " + i64ToStr(body.len()) + "\r\n"
    }
    req = req + "\r\n" + body.clone()

    if tls {
        match TlsStream.connect(ip, port as u16, host) {
            Result.Ok(conn) => {
                match conn.send(req) {
                    Result.Ok(_n) => {
                    }
                    Result.Err(_e) => {
                        return "Esend failed"
                    }
                }
                var resp = ""
                var reading = true
                while reading {
                    match conn.recv() {
                        Result.Ok(chunk) => {
                            if chunk.len() == 0 {
                                reading = false
                            } else {
                                resp = resp + chunk
                            }
                        }
                        Result.Err(_e) => {
                            reading = false
                        }
                    }
                }
                return "O" + resp
            }
            Result.Err(_e) => {
                return "ETLS connect failed to " + host.clone()
            }
        }
    }
    match TcpStream.connect(ip, port as u16) {
        Result.Ok(conn) => {
            match conn.send(req) {
                Result.Ok(_n) => {
                }
                Result.Err(_e) => {
                    return "Esend failed"
                }
            }
            var resp = ""
            var reading = true
            while reading {
                match conn.recv() {
                    Result.Ok(chunk) => {
                        if chunk.len() == 0 {
                            reading = false
                        } else {
                            resp = resp + chunk
                        }
                    }
                    Result.Err(_e) => {
                        reading = false
                    }
                }
            }
            return "O" + resp
        }
        Result.Err(_e) => {
            return "ETCP connect failed to " + host.clone()
        }
    }
}

// Native dispatch for the call sites that hold a Prog. callNative itself does
// not, so any native whose answer depends on re-entering user code has to be
// intercepted here — otherwise `String(obj)` reports "[object Object]" for an
// object whose toString says otherwise, while `${obj}` and `"" + obj` (both of
// which run the full ToPrimitive) disagree with it.
pub fn callNativeProg(prog: &Prog, id: i64, argVals: &Vec<JSValue>, st: &mut Interp): JSValue {
    if id == NATIVE_STRING && argVals.len() > 0 {
        let h = objHandle(argVals[0])
        if h >= 0 {
            // only take over when the object really has a toString to run, so
            // callNative's prog-free array and error answers stay authoritative
            // for everything that does not
            let tf = getMemberDyn(prog, h, "toString", st)
            if isCallableIn(st, tf) {
                return JSValue.Str(toStrProg(prog, argVals[0], st))
            }
        }
    }
    return callNative(id, argVals, st)
}

fn callNative(id: i64, argVals: &Vec<JSValue>, st: &mut Interp): JSValue {
    if isErrorCtor(id) {
        let o = newObject(st)
        st.objects[o].isError = true
        let ename = nativeErrorName(id)
        objSet(st, o, "name", JSValue.Str(ename.clone()))
        var msg = ""
        if argVals.len() > 0 {
            msg = toStr(argVals[0])
        }
        objSet(st, o, "message", JSValue.Str(msg.clone()))
        // error.stack: no real backtrace here, but a string headed "Name: message"
        // so code that reads or logs e.stack (a typeof check, express's error
        // middleware) sees a string rather than undefined
        var stackHead = ename.clone()
        if msg.len() > 0 {
            stackHead = stackHead + ": " + msg
        }
        objSet(st, o, "stack", JSValue.Str(stackHead + errorStackFrames(st)))
        // new Error(msg, { cause }) — ES2022 error chaining
        if argVals.len() > 1 {
            let oh = objHandle(argVals[1])
            if oh >= 0 && objOwnIndex(st, oh, "cause") >= 0 {
                objSet(st, o, "cause", cloneValue(getMember(st, oh, "cause")))
            }
        }
        // link to the real prototype so getPrototypeOf(e) === TypeError.prototype
        // and e.constructor resolve. -1 while setupGlobals is still running: an
        // error thrown during startup just gets no proto, as before.
        let ep = errorProtoFor(st, id)
        if ep >= 0 {
            st.objects[o].proto = ep
        }
        objSetNonEnumerable(st, o, "name")
        objSetNonEnumerable(st, o, "message")
        objSetNonEnumerable(st, o, "stack")
        return JSValue.Obj(o)
    }
    if id == NATIVE_JSON_STRINGIFY {
        if argVals.len() == 0 || mjJsonOmitted(argVals[0]) {
            // JSON.stringify(undefined) / a function is the JS value undefined
            return JSValue.Undefined
        }
        return JSValue.Str(mjStringifyVal(argVals[0], st))
    }
    if id == NATIVE_JSON_PARSE {
        if argVals.len() == 0 {
            return JSValue.Undefined
        }
        let text = toStr(argVals[0])
        return mjJsonParse(text, st)
    }
    if id >= NATIVE_MATH_FLOOR && id <= NATIVE_MATH_RANDOM {
        return mathNative(id, argVals, st)
    }
    // the transcendentals were appended after the original block, so they sit
    // outside the contiguous FLOOR..RANDOM range the gate above covers
    if (id >= NATIVE_MATH_EXP && id <= NATIVE_MATH_ATAN2) || id == NATIVE_MATH_LOG2 || id == NATIVE_MATH_LOG10 {
        return mathNative(id, argVals, st)
    }
    if id == NATIVE_GC {
        // a real collection, not a no-op: the QuickJS GC tests call this to force
        // finalization, and a stub would make them pass without exercising anything
        collect(st)
        return JSValue.Undefined
    }
    if id == NATIVE_REGEXP {
        var pat = ""
        var flags = ""
        if argVals.len() > 0 {
            pat = toStr(argVals[0])
        }
        if argVals.len() > 1 {
            flags = toStr(argVals[1])
        }
        return makeRegex(st, pat, flags)
    }
    if id == NATIVE_NUMBER {
        if argVals.len() == 0 {
            return JSValue.Number(0.0)
        }
        // an object coerces via ToPrimitive(number) — honouring a user
        // [Symbol.toPrimitive]/valueOf — before ToNumber; toNum alone gives NaN
        if objHandle(argVals[0]) >= 0 {
            let p = toPrimitiveNumber(gProg, argVals[0], st)
            return JSValue.Number(toNum(p))
        }
        return JSValue.Number(toNum(argVals[0]))
    }
    if id == NATIVE_BIGINT {
        if argVals.len() == 0 {
            return JSValue.BigInt("0")
        }
        match cloneValue(argVals[0]) {
            JSValue.BigInt(s) => {
                return JSValue.BigInt(s.clone())
            }
            JSValue.Bool(b) => {
                if b {
                    return JSValue.BigInt("1")
                }
                return JSValue.BigInt("0")
            }
            JSValue.Str(s) => {
                let t = jsTrim(s)
                if isDecimalIntStr(t) {
                    return JSValue.BigInt(bigNormalizeDec(t))
                }
                // radix-prefixed strings (0x/0b/0o) parse with full precision
                if t.len() > 2 && t[0] == '0' {
                    let p = t[1]
                    if p == 'x' || p == 'X' {
                        return JSValue.BigInt(bnFromRadix(bnStrFrom(t, 2), 16))
                    }
                    if p == 'b' || p == 'B' {
                        return JSValue.BigInt(bnFromRadix(bnStrFrom(t, 2), 2))
                    }
                    if p == 'o' || p == 'O' {
                        return JSValue.BigInt(bnFromRadix(bnStrFrom(t, 2), 8))
                    }
                }
                // anything else (empty → 0n) via the numeric path
                return JSValue.BigInt(bnFromF64(strToNum(t)))
            }
            _ => {
                // BigInt(number): must be an integer (JS throws otherwise); we
                // truncate defensively rather than throw, staying non-crashing
                return JSValue.BigInt(bnFromF64(toNum(argVals[0])))
            }
        }
    }
    if id == NATIVE_STRING {
        if argVals.len() == 0 {
            return JSValue.Str("")
        }
        // String(sym) is the one conversion the spec allows for a symbol, and it
        // must show Symbol(desc) rather than the internal tagged string
        match argVals[0] {
            JSValue.Str(sv) => {
                if isSymbolStr(sv) {
                    return JSValue.Str(symbolDisplay(sv))
                }
            }
            _ => {
            }
        }
        // arrays coerce to their join, not "[object Object]"
        let a0h = objHandle(argVals[0])
        if a0h >= 0 && st.objects[a0h].isArray {
            return JSValue.Str(joinArray(st, a0h, ","))
        }
        // an error coerces to "Name: message" the same way. Special-cased here
        // for the same reason arrays are: callNative has no `prog`, so it cannot
        // run the full ToPrimitive that `"" + err` goes through, and plain toStr
        // would answer "[object Object]".
        if a0h >= 0 && st.objects[a0h].isError {
            let en = toStr(objGet(st, a0h, "name"))
            let em = toStr(objGet(st, a0h, "message"))
            if em.len() > 0 {
                return JSValue.Str(en + ": " + em)
            }
            return JSValue.Str(en)
        }
        return JSValue.Str(toStr(argVals[0]))
    }
    if id == NATIVE_BOOLEAN {
        if argVals.len() == 0 {
            return JSValue.Bool(false)
        }
        return JSValue.Bool(truthy(argVals[0]))
    }
    if id == NATIVE_READ_FILE_SYNC {
        if argVals.len() == 0 {
            return JSValue.Undefined
        }
        match readFile(toStr(argVals[0])) {
            Result.Ok(txt) => {
                return JSValue.Str(txt)
            }
            Result.Err(_e) => {
                return JSValue.Undefined
            }
        }
    }
    if id == NATIVE_FILE_EXISTS {
        if argVals.len() == 0 {
            return JSValue.Bool(false)
        }
        match readFile(toStr(argVals[0])) {
            Result.Ok(_txt) => {
                return JSValue.Bool(true)
            }
            Result.Err(_e) => {
                return JSValue.Bool(false)
            }
        }
    }
    if id == NATIVE_OBJECT_DEFINEPROPERTY {
        if argVals.len() < 3 {
            return JSValue.Undefined
        }
        let target = cloneValue(argVals[0])
        let key = toStr(argVals[1])
        let o = propertyBagOf(st, target)
        if o < 0 {
            return target
        }
        let d = objHandle(argVals[2])
        if d >= 0 {
            applyDescriptor(st, o, key, d)
            return JSValue.Obj(o)
        }
        setMember(st, o, key, JSValue.Undefined)
        return JSValue.Obj(o)
    }
    if id >= NATIVE_RESOLVER_BASE {
        let off = id - NATIVE_RESOLVER_BASE
        let target = off / 2
        var v = JSValue.Undefined
        if argVals.len() > 0 {
            v = cloneValue(argVals[0])
        }
        // first settle wins, as in JS. resolve(p) where p is a promise adopts it.
        if st.objects[target].promiseState == 0 {
            let state = 1 + (off % 2)
            let vp = objHandle(v)
            if state == 1 && vp >= 0 && isPromise(st, vp) {
                adoptPromise(st, target, vp)
            } else {
                settlePromise(st, target, state, v)
            }
        }
        return JSValue.Undefined
    }
    if id == NATIVE_PROMISE_RESOLVE || id == NATIVE_PROMISE_REJECT {
        var v = JSValue.Undefined
        if argVals.len() > 0 {
            v = cloneValue(argVals[0])
        }
        if id == NATIVE_PROMISE_RESOLVE {
            // Promise.resolve(p) is p
            let h = objHandle(v)
            if h >= 0 && isPromise(st, h) {
                return v
            }
            return JSValue.Obj(newPromise(st, 1, v))
        }
        return JSValue.Obj(newPromise(st, 2, v))
    }
    if id == NATIVE_IS_NAN || id == NATIVE_IS_FINITE {
        var x = jsNan()
        if argVals.len() > 0 {
            x = toNum(argVals[0])
        }
        let isNan = x != x
        if id == NATIVE_IS_NAN {
            return JSValue.Bool(isNan)
        }
        return JSValue.Bool(!isNan && x != jsInfinity() && x != (0.0 - jsInfinity()))
    }
    if id == NATIVE_ARRAY_ISARRAY {
        if argVals.len() > 0 {
            let h = objHandle(argVals[0])
            if h >= 0 {
                return JSValue.Bool(st.objects[h].isArray)
            }
        }
        return JSValue.Bool(false)
    }
    if id == NATIVE_PARSE_INT || id == NATIVE_PARSE_FLOAT {
        if argVals.len() == 0 {
            return JSValue.Number(jsNan())
        }
        let text = toStr(argVals[0])
        if id == NATIVE_PARSE_FLOAT {
            return JSValue.Number(jsParseFloatPrefix(text))
        }
        var radix: i64 = 10
        if argVals.len() > 1 {
            let r = toNum(argVals[1]) as i64
            if r >= 2 && r <= 36 {
                radix = r
            }
        }
        return JSValue.Number(jsParsePrefixNum(text, radix))
    }
    if id == NATIVE_SYMBOL {
        // Symbols are modelled as unique strings; enough for the well-known
        // ones used as property keys, not for real symbol semantics
        var desc = ""
        if argVals.len() > 0 {
            desc = toStr(argVals[0])
        }
        st.symbolCounter = st.symbolCounter + 1
        return JSValue.Str("@@sym:" + desc + ":" + i64ToStr(st.symbolCounter))
    }
    if id == NATIVE_OBJECT_DEFINEPROPERTIES {
        if argVals.len() < 2 {
            return JSValue.Undefined
        }
        let o = propertyBagOf(st, argVals[0])
        let descs = objHandle(argVals[1])
        if o < 0 || descs < 0 {
            return cloneValue(argVals[0])
        }
        var i: i64 = 0
        while i < st.objects[descs].props.len() {
            let key = st.objects[descs].props[i].key.clone()
            let d = objHandle(st.objects[descs].props[i].value)
            if d >= 0 {
                applyDescriptor(st, o, key, d)
            }
            i = i + 1
        }
        return JSValue.Obj(o)
    }
    if id == NATIVE_MAP || id == NATIVE_SET {
        let o = newObject(st)
        if id == NATIVE_MAP {
            st.objects[o].isMap = true
            if st.mapProtoObj >= 0 {
                st.objects[o].proto = st.mapProtoObj
            }
        } else {
            st.objects[o].isSet = true
            if st.setProtoObj >= 0 {
                st.objects[o].proto = st.setProtoObj
            }
        }
        // Map/Set entries live in the side table — allocate the slot up front so
        // every later mapKeys/mapVals access reaches a private extra, not the
        // shared default at index 0.
        let _me = ensureExtra(st, o)
        pushTemp(st, JSValue.Obj(o))
        // new Map([[k, v], ...]) / new Set([v, ...])
        if argVals.len() > 0 {
            // new Set(gen) / new Map(gen) — anything iterable, not just an array
            let srcVal = iterableToArray(gProg, cloneValue(argVals[0]), st)
            pushTemp(st, cloneValue(srcVal))
            let src = objHandle(srcVal)
            if src >= 0 && st.objects[src].isArray {
                var i: i64 = 0
                while i < arrLen(st, src) {
                    let e = arrGet(st, src, i)
                    if id == NATIVE_SET {
                        mapPut(st, o, e, JSValue.Bool(true))
                    } else {
                        let pair = objHandle(e)
                        if pair >= 0 && st.objects[pair].isArray && arrLen(st, pair) >= 2 {
                            mapPut(st, o, arrGet(st, pair, 0), arrGet(st, pair, 1))
                        }
                    }
                    i = i + 1
                }
            }
            popTemp(st)
        }
        popTemp(st)
        return JSValue.Obj(o)
    }
    if id == NATIVE_OBJECT_GETOWNPROPNAMES {
        let arr = newArray(st)
        if argVals.len() > 0 {
            let h = propertyBagOf(st, argVals[0])
            if h >= 0 {
                pushTemp(st, JSValue.Obj(arr))
                if st.objects[h].isArray {
                    var e: i64 = 0
                    while e < arrLen(st, h) {
                        arrPush(st, arr, JSValue.Str(i64ToStr(e)))
                        e = e + 1
                    }
                    arrPush(st, arr, JSValue.Str("length"))
                }
                let order = enumOrder(st, h)
                var oi: i64 = 0
                while oi < order.len() {
                    let k = order[oi]
                    arrPush(st, arr, JSValue.Str(st.objects[h].props[k].key.clone()))
                    oi = oi + 1
                }
                popTemp(st)
            }
        }
        return JSValue.Obj(arr)
    }
    if id == NATIVE_OBJECT_GETOWNPROPSYMBOLS {
        // the mirror of getOwnPropertyNames: the symbol-valued own keys, which
        // enumOrder / getOwnPropertyNames deliberately skip. symbols are stored
        // as "@@sym:..."-prefixed string keys, and a symbol value IS that string.
        let arr = newArray(st)
        if argVals.len() > 0 {
            let h = propertyBagOf(st, argVals[0])
            if h >= 0 {
                pushTemp(st, JSValue.Obj(arr))
                var pi: i64 = 0
                while pi < st.objects[h].props.len() {
                    let k = st.objects[h].props[pi].key.clone()
                    if isSymbolStr(k) {
                        arrPush(st, arr, JSValue.Str(k))
                    }
                    pi = pi + 1
                }
                popTemp(st)
            }
        }
        return JSValue.Obj(arr)
    }
    if id == NATIVE_ARRAY_FROM {
        let arr = newArray(st)
        pushTemp(st, JSValue.Obj(arr))
        // gather the source elements, then apply the optional map function
        var elems: Vec<JSValue> = Vec.new()
        if argVals.len() > 0 {
            let h = objHandle(argVals[0])
            if h >= 0 {
                if st.objects[h].isArray {
                    var i: i64 = 0
                    while i < arrLen(st, h) {
                        elems.push(arrGet(st, h, i))
                        i = i + 1
                    }
                } else if st.objects[h].isSet {
                    // Array.from(set) → its values
                    var i: i64 = 0
                    while i < st.objExtras[st.objects[h].extra].mapKeys.len() {
                        elems.push(cloneValue(st.objExtras[st.objects[h].extra].mapKeys[i]))
                        i = i + 1
                    }
                } else if st.objects[h].isMap {
                    // Array.from(map) → [key, value] PAIRS, not just keys
                    var i: i64 = 0
                    while i < st.objExtras[st.objects[h].extra].mapKeys.len() {
                        let pair = newArray(st)
                        pushTemp(st, JSValue.Obj(pair))
                        arrPush(st, pair, cloneValue(st.objExtras[st.objects[h].extra].mapKeys[i]))
                        arrPush(st, pair, cloneValue(st.objExtras[st.objects[h].extra].mapVals[i]))
                        popTemp(st)
                        elems.push(JSValue.Obj(pair))
                        i = i + 1
                    }
                } else {
                    let itFn = getMember(st, h, symIteratorKey())
                    if isCallableIn(st, itFn) {
                        // a real iterable (Buffer, custom [Symbol.iterator], …) —
                        // drive its iterator, exactly as spread does. Comes before
                        // the array-like path so an iterable with a length still
                        // iterates rather than index-reads.
                        spreadInto(gProg, elems, JSValue.Obj(h), st)
                    } else {
                        // array-like: use its `length` and index 0..length-1
                        // (covers the common Array.from({length:n}, fn) idiom)
                        let lenV = getMember(st, h, "length")
                        let len = toNum(lenV) as i64
                        var i: i64 = 0
                        while i < len {
                            elems.push(getMember(st, h, i64ToStr(i)))
                            i = i + 1
                        }
                    }
                }
            } else {
                match cloneValue(argVals[0]) {
                    JSValue.Str(sv) => {
                        // code points, not bytes — Array.from("café") is 4 chars
                        for cp in strCodePoints(sv) {
                            elems.push(JSValue.Str(cp.clone()))
                        }
                    }
                    _ => {
                    }
                }
            }
        }
        // optional map function (element, index) — gProg: natives reach user code
        // through the global program
        let hasMap = argVals.len() > 1 && isCallableIn(st, argVals[1])
        var k: i64 = 0
        while k < elems.len() && !st.throwing {
            if hasMap {
                var margs: Vec<JSValue> = Vec.new()
                margs.push(cloneValue(elems[k]))
                margs.push(JSValue.Number(k as f64))
                arrPush(st, arr, callValue(gProg, argVals[1], margs, JSValue.Undefined, st))
            } else {
                arrPush(st, arr, cloneValue(elems[k]))
            }
            k = k + 1
        }
        popTemp(st)
        return JSValue.Obj(arr)
    }
    if id == NATIVE_TCP_LISTEN {
        var port: i64 = 0
        if argVals.len() > 0 {
            port = toNum(argVals[0]) as i64
        }
        match TcpListener.bind(port as u16) {
            Result.Ok(l) => {
                st.listeners.push(l)
                return JSValue.Number((st.listeners.len() - 1) as f64)
            }
            Result.Err(_e) => {
                return JSValue.Number(0.0 - 1.0)
            }
        }
    }
    if id == NATIVE_TCP_ACCEPT {
        // Nonblocking by default: a blocking accept parks the event-loop task on
        // the listener, which stalls timers, microtasks and fetch servicing until
        // the NEXT connection arrives — with R1 activations that wedged every
        // request whose completion needed the loop (the cold-fetch hang). The
        // second argument opts back into the blocking accept; serveHttpOnce sets
        // it only when the loop is verifiably idle.
        var idx: i64 = 0
        if argVals.len() > 0 {
            idx = toNum(argVals[0]) as i64
        }
        var mayBlock = false
        if argVals.len() > 1 {
            mayBlock = truthy(argVals[1])
        }
        if idx < 0 || idx >= st.listeners.len() {
            return JSValue.Number(0.0 - 1.0)
        }
        if mayBlock {
            match st.listeners[idx].accept() {
                Result.Ok(conn) => {
                    st.conns.push(conn)
                    st.connOpen.push(true)
