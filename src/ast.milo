// AST node types plus the Prog arena that owns them. Recursive child links are
// typed IDs into Prog's flat Vecs; index families migrate independently so an
// expression slot cannot be confused with a statement slot. The evaluator
// matches arena slots in place (match prog.exprs[i] borrows the payloads);
// getExpr/getStmt clone a node
// out by index for the few callers that mutate prog while inspecting a node
// (parser lvalue rewriting) — cloning per visit in the evaluator was the
// dominant interpreter cost. addExpr/addStmt append and return the matching ID.

pub enum Expr {
    Num(f64),
    StrLit(string),
    // a BigInt literal (123n) — the canonical decimal string
    BigIntLit(string),
    BoolLit(bool),
    NullLit,
    UndefLit,
    Ident(string),
    Bin(string, ExprId, ExprId),
    Un(string, ExprId),
    Assign(string, ExprId),
    Call(ExprId, ArgListId),
    Member(ExprId, string),
    FuncExpr(i64),
    // one hole of an untagged template literal. It exists as its own node
    // because a template converts its holes with the STRING ToPrimitive hint,
    // and the `"" + x` chain this used to desugar to takes the DEFAULT one —
    // observable for any object with both valueOf and toString (a Date, or
    // anything with Symbol.toPrimitive, which sees the wrong hint name).
    ToStrHole(ExprId),
    // object literal: index into prog.objLits (a list of key/value-expr pairs)
    ObjLit(ObjLitId),
    // computed member read: obj[keyExpr]
    Index(ExprId, ExprId),
    // property write: obj, keyExpr, valExpr — backs both obj.x = v and obj[k] = v
    SetMember(ExprId, ExprId, ExprId),
    // array literal: index into prog.arrLits (a list of element-expr indices)
    ArrLit(ArrLitId),
    // the strings array a tagged template hands its tag function: cooked chunks
    // first, then the un-escaped chunks that become its `raw` property. Both
    // lists always have the same length. Libraries detect tagged-template usage
    // by looking for `raw` (prisma's $executeRaw rejects the call without it),
    // so a plain ArrLit is not enough.
    TemplateStrings(ArrLitId, ArrLitId),
    // new Ctor(args): constructor expr, arg-list index
    New(ExprId, ArgListId),
    // ++/-- on an lvalue: target expr, isIncrement, isPrefix
    Update(ExprId, bool, bool),
    // x op= y on an lvalue: target expr, op ("+","-","*","/","%"), rhs expr
    CompoundAssign(ExprId, string, ExprId),
    // logical assignment: target, op ("&&"/"||"/"??"), rhs. Short-circuits — rhs
    // is evaluated and stored only when the op says the target needs updating.
    LogicalAssign(ExprId, string, ExprId),
    // destructuring assignment to existing targets: `[a,b] = rhs` /
    // `({a,b} = rhs)`. First index is the pattern (an ArrLit/ObjLit), second the
    // rhs. Distinct from `let [a,b] = rhs` (a declaration, handled at parse time).
    DestructAssign(ExprId, ExprId),
    // ternary c ? a : b
    Cond(ExprId, ExprId, ExprId),
    // ...expr in a call-arg or array-literal position
    Spread(ExprId),
    // the comma/sequence operator: evaluate left for effect, yield right.
    // Shows up constantly in TS-compiled CommonJS as `(0, mod.fn)(...)`.
    Comma(ExprId, ExprId),
    // /pattern/flags written literally
    RegexLit(string, string),
    // a?.b — yields undefined when the base is null/undefined
    OptMember(ExprId, string),
    // class expression: index into prog.classes
    ClassExpr(i64),
    // a?.[k] — computed sibling of OptMember
    OptIndex(ExprId, ExprId),
    // wraps the outermost expression of a postfix chain that contains a `?.`.
    // A nullish `?.` base short-circuits the ENTIRE rest of the chain to
    // undefined (a?.b.c[d]() is all-or-nothing), so the runtime sets a flag that
    // propagates up through the chain's Member/Index/Call nodes; this node is
    // where the flag is scoped and consumed.
    OptChainRoot(ExprId),
    // f?.(args) — optional call: if the callee is nullish the call is skipped and
    // the result is undefined, else it is called. (callee expr, argList index)
    OptCall(ExprId, ArgListId),
}

// Append-only expression slot. Like StmtId, this is intentionally distinct
// from every other Prog index family while retaining a one-word representation.
@derive(Eq)
pub struct ExprId {
    index: i64,
}

// Append-only block slot. Blocks own ordered statement IDs and are shared by
// function bodies, switch cases, try regions, modules, and top-level programs.
@derive(Eq)
pub struct BlockId {
    index: i64,
}

// Append-only call-argument-list slot.
@derive(Eq)
pub struct ArgListId {
    index: i64,
}

// Append-only object-literal descriptor slot.
@derive(Eq)
pub struct ObjLitId {
    index: i64,
}

// Append-only array/template-literal descriptor slot.
@derive(Eq)
pub struct ArrLitId {
    index: i64,
}

// Append-only declaration-list descriptor slot.
@derive(Eq)
pub struct DeclListId {
    index: i64,
}

// Append-only switch-case-list descriptor slot.
@derive(Eq)
pub struct SwitchId {
    index: i64,
}

// Append-only statement slot. Construction stays in addStmt so every published
// ID is in bounds for its owning Prog; optional statement links use Option.
@derive(Eq)
pub struct StmtId {
    index: i64,
}

// One key/value pair in an object literal; val is an expr index.
pub struct PropInit {
    key: string,
    val: ExprId,
    // 0 plain, 1 getter, 2 setter — accessors are installed rather than assigned
    kind: i64,
    // computed key `{ [expr]: v }`, absent for a literal key.
    keyExpr: Option<ExprId>,
}

pub enum Stmt {
    Decl(string, ExprId),
    ExprStmt(ExprId),
    If(ExprId, StmtId, Option<StmtId>),
    While(ExprId, StmtId),
    Ret(ExprId),
    Block(BlockId),
    FuncDecl(i64),
    Empty,
    // for (init; cond; update) body — cond/update remain expression indices;
    // init is optional and body is always a statement ID.
    For(Option<StmtId>, Option<ExprId>, Option<ExprId>, StmtId),
    Throw(ExprId),
    // let/var/const with one or more declarators: index into prog.declLists
    MultiDecl(DeclListId),
    // for (name in objExpr) body
    ForIn(string, ExprId, StmtId),
    // for (name of iterExpr) body; the bool is `for await`, which awaits each
    // step (and prefers Symbol.asyncIterator over Symbol.iterator)
    ForOf(string, ExprId, StmtId, bool),
    // break/continue carry their target label, "" when unlabeled
    Break(string),
    Continue(string),
    // label: stmt — a labeled statement. break/continue naming this label
    // target the statement it wraps (a loop, or a block for break).
    Labeled(string, StmtId),
    // class declaration: index into prog.classes
    ClassDecl(i64),
    // do body while (cond) — body runs before the first test
    DoWhile(StmtId, ExprId),
    // switch (discr) { ... } — index into prog.switches
    Switch(ExprId, SwitchId),
    // try block, catch-param name ("" if none), catch block idx (-1 if none),
    // finally block links are absent when the corresponding clause is omitted.
    Try(BlockId, string, Option<BlockId>, Option<BlockId>),
}

pub struct FuncDef {
    name: string,
    params: Vec<string>,
    body: BlockId,
    // arrows don't bind their own `this` (it stays lexical)
    isArrow: bool,
    // async functions wrap their return value in a resolved promise
    isAsync: bool,
    // index of a `...rest` parameter, or -1 — it collects the remaining args
    restFrom: i64,
    // `function*`: the body runs on its own green task and suspends at each
    // `yield`. Works in the runtime and, since 2026-08-15, in the engine too.
    isGenerator: bool,
}

// one declarator in a `let a = 1, b, c = 3` statement
pub struct DeclItem {
    name: string,
    init: ExprId,
    // `var` hoists to the enclosing function and has no per-iteration binding;
    // let/const do neither, so the distinction has to survive parsing
    isVar: bool,
}

// One `name() {}` inside a class body. Statics hang off the constructor, the
// rest off its prototype.
pub struct ClassMember {
    name: string,
    fnIdx: i64,
    isStatic: bool,
    // 0 plain method, 1 getter, 2 setter
    kind: i64,
    // `[expr]() {}` — evaluated in the class scope when the class is built, so
    // `*[Symbol.iterator]() {}` lands under the symbol key rather than a name.
    // None for an ordinary method, whose key is `name`.
    keyExpr: Option<ExprId>,
}

pub struct ClassDef {
    name: string,
    // unique-per-class binding name the base constructor is stored under. Two
    // classes in the same scope (very common in minified bundles, where most
    // classes are anonymous and share the name "") would otherwise both bind
    // `__super$<name>`; the second definition then makes the first class's
    // super() call resolve to the first class itself and recurse forever.
    superKey: string,
    // base class identifier, or "" — only a bare name is supported, not an
    // arbitrary expression
    superName: string,
    // constructor function index, or -1 when the class declares none
    ctorFn: i64,
    // an empty function used as the constructor when none is declared
    defaultCtor: i64,
    members: Vec<ClassMember>,
    // static field initializers (name + init expr index) applied to the
    // constructor object when the class value is built. Instance fields are not
    // here: they are injected as `this.name = init` statements into the ctor.
    staticFieldNames: Vec<string>,
    staticFieldInits: Vec<ExprId>,
}

// One `case v:` / `default:` arm. `test` is -1 for default. Bodies are separate
// blocks but fall through to the next arm unless a break intervenes.
pub struct SwitchCase {
    test: Option<ExprId>,
    body: BlockId,
}

pub struct Prog {
    exprs: Vec<Expr>,
    stmts: Vec<Stmt>,
    blocks: Vec<Vec<StmtId>>,
    argLists: Vec<Vec<ExprId>>,
    funcs: Vec<FuncDef>,
    objLits: Vec<Vec<PropInit>>,
    arrLits: Vec<Vec<Option<ExprId>>>,
    declLists: Vec<Vec<DeclItem>>,
    classes: Vec<ClassDef>,
    switches: Vec<Vec<SwitchCase>>,
}

// Create an empty program arena.
pub fn newProg(): Prog {
    return Prog {
        exprs: Vec.new(), stmts: Vec.new(), blocks: Vec.new(), argLists: Vec.new(), funcs: Vec.new(), objLits: Vec.new(), arrLits: Vec.new(), declLists: Vec.new(), classes: Vec.new(), switches: Vec.new()
    }
}

// The one program every execution shares, for the same reason gInterp exists: a
// green task's body cannot capture a `&Prog` belonging to a caller's frame, and
// an async activation outlives the call that started it. Module-scope runtime
// initialization is not supported, so this is a zero literal that main()
// overwrites once parsing is done.
pub var gProg: Prog = Prog {
    exprs: Vec.new(), stmts: Vec.new(), blocks: Vec.new(), argLists: Vec.new(), funcs: Vec.new(), objLits: Vec.new(), arrLits: Vec.new(), declLists: Vec.new(), classes: Vec.new(), switches: Vec.new()
}

fn cloneExpr(e: &Expr): Expr {
    match e {
        Expr.Num(n) => {
            return Expr.Num(n)
        }
        Expr.StrLit(s) => {
            return Expr.StrLit(s.clone())
        }
        Expr.BigIntLit(s) => {
            return Expr.BigIntLit(s.clone())
        }
        Expr.BoolLit(b) => {
            return Expr.BoolLit(b)
        }
        Expr.NullLit => {
            return Expr.NullLit
        }
        Expr.UndefLit => {
            return Expr.UndefLit
        }
        Expr.Ident(name) => {
            return Expr.Ident(name.clone())
        }
        Expr.Bin(op, a, b) => {
            return Expr.Bin(op.clone(), a, b)
        }
        Expr.Un(op, a) => {
            return Expr.Un(op.clone(), a)
        }
        Expr.Assign(name, v) => {
            return Expr.Assign(name.clone(), v)
        }
        Expr.Call(callee, argsIdx) => {
            return Expr.Call(callee, argsIdx)
        }
        Expr.Member(obj, name) => {
            return Expr.Member(obj, name.clone())
        }
        Expr.FuncExpr(f) => {
            return Expr.FuncExpr(f)
        }
        Expr.ToStrHole(e2) => {
            return Expr.ToStrHole(e2)
        }
        Expr.ObjLit(i) => {
            return Expr.ObjLit(i)
        }
        Expr.Index(obj, key) => {
            return Expr.Index(obj, key)
        }
        Expr.SetMember(obj, key, val) => {
            return Expr.SetMember(obj, key, val)
        }
        Expr.TemplateStrings(i, r) => {
            return Expr.TemplateStrings(i, r)
        }
        Expr.ArrLit(i) => {
            return Expr.ArrLit(i)
        }
        Expr.New(callee, args) => {
            return Expr.New(callee, args)
        }
        Expr.Update(target, inc, prefix) => {
            return Expr.Update(target, inc, prefix)
        }
        Expr.CompoundAssign(target, op, rhs) => {
            return Expr.CompoundAssign(target, op.clone(), rhs)
        }
        Expr.LogicalAssign(target, op, rhs) => {
            return Expr.LogicalAssign(target, op.clone(), rhs)
        }
        Expr.DestructAssign(pat, rhs) => {
            return Expr.DestructAssign(pat, rhs)
        }
        Expr.Cond(c, a, b) => {
            return Expr.Cond(c, a, b)
        }
        Expr.Spread(inner) => {
            return Expr.Spread(inner)
        }
        Expr.Comma(a, b) => {
            return Expr.Comma(a, b)
        }
        Expr.RegexLit(pat, flags) => {
            return Expr.RegexLit(pat.clone(), flags.clone())
        }
        Expr.ClassExpr(idx) => {
            return Expr.ClassExpr(idx)
        }
        Expr.OptIndex(o, k) => {
            return Expr.OptIndex(o, k)
        }
        Expr.OptMember(obj, name) => {
            return Expr.OptMember(obj, name.clone())
        }
        Expr.OptChainRoot(inner) => {
            return Expr.OptChainRoot(inner)
        }
        Expr.OptCall(callee, args) => {
            return Expr.OptCall(callee, args)
        }
    }
}

fn cloneStmt(s: &Stmt): Stmt {
    match s {
        Stmt.Decl(name, e) => {
            return Stmt.Decl(name.clone(), e)
        }
        Stmt.ExprStmt(e) => {
            return Stmt.ExprStmt(e)
        }
        Stmt.If(c, t, f) => {
            return Stmt.If(c, t, f)
        }
        Stmt.While(c, b) => {
            return Stmt.While(c, b)
        }
        Stmt.Ret(e) => {
            return Stmt.Ret(e)
        }
        Stmt.Block(b) => {
            return Stmt.Block(b)
        }
        Stmt.FuncDecl(f) => {
            return Stmt.FuncDecl(f)
        }
        Stmt.Empty => {
            return Stmt.Empty
        }
        Stmt.For(init, cond, update, body) => {
            return Stmt.For(init, cond, update, body)
        }
        Stmt.Throw(e) => {
            return Stmt.Throw(e)
        }
        Stmt.Try(tryB, param, catchB, finallyB) => {
            return Stmt.Try(tryB, param.clone(), catchB, finallyB)
        }
        Stmt.MultiDecl(listIdx) => {
            return Stmt.MultiDecl(listIdx)
        }
        Stmt.ForIn(name, objExpr, body) => {
            return Stmt.ForIn(name.clone(), objExpr, body)
        }
        Stmt.ForOf(name, objExpr, body, isAwait) => {
            return Stmt.ForOf(name.clone(), objExpr, body, isAwait)
        }
        Stmt.ClassDecl(idx) => {
            return Stmt.ClassDecl(idx)
        }
        Stmt.DoWhile(body, cond) => {
            return Stmt.DoWhile(body, cond)
        }
        Stmt.Switch(discr, idx) => {
            return Stmt.Switch(discr, idx)
        }
        Stmt.Break(label) => {
            return Stmt.Break(label.clone())
        }
        Stmt.Continue(label) => {
            return Stmt.Continue(label.clone())
        }
        Stmt.Labeled(label, body) => {
            return Stmt.Labeled(label.clone(), body)
        }
    }
}

pub fn getExpr(prog: &Prog, id: ExprId): Expr {
    return cloneExpr(prog.exprs[id.index])
}

pub fn getStmt(prog: &Prog, id: StmtId): Stmt {
    return cloneStmt(prog.stmts[id.index])
}

pub fn addExpr(prog: &mut Prog, e: Expr): ExprId {
    prog.exprs.push(e)
    return ExprId {
        index: prog.exprs.len() - 1
    }
}

pub fn addStmt(prog: &mut Prog, s: Stmt): StmtId {
    prog.stmts.push(s)
    return StmtId {
        index: prog.stmts.len() - 1
    }
}

// Append a statement list and publish its typed block ID.
pub fn addBlock(prog: &mut Prog, statements: Vec<StmtId>): BlockId {
    prog.blocks.push(statements)
    return BlockId {
        index: prog.blocks.len() - 1
    }
}

// Append an argument list and publish its typed ID.
pub fn addArgList(prog: &mut Prog, arguments: Vec<ExprId>): ArgListId {
    prog.argLists.push(arguments)
    return ArgListId {
        index: prog.argLists.len() - 1
    }
}

// Append an object-literal descriptor list and publish its typed ID.
pub fn addObjLit(prog: &mut Prog, properties: Vec<PropInit>): ObjLitId {
    prog.objLits.push(properties)
    return ObjLitId {
        index: prog.objLits.len() - 1
    }
}

// Append an array/template-literal descriptor list and publish its typed ID.
pub fn addArrLit(prog: &mut Prog, elements: Vec<Option<ExprId>>): ArrLitId {
    prog.arrLits.push(elements)
    return ArrLitId {
        index: prog.arrLits.len() - 1
    }
}

// Append a declaration descriptor list and publish its typed ID.
pub fn addDeclList(prog: &mut Prog, declarations: Vec<DeclItem>): DeclListId {
    prog.declLists.push(declarations)
    return DeclListId {
        index: prog.declLists.len() - 1
    }
}

// Append a switch-case descriptor list and publish its typed ID.
pub fn addSwitch(prog: &mut Prog, cases: Vec<SwitchCase>): SwitchId {
    prog.switches.push(cases)
    return SwitchId {
        index: prog.switches.len() - 1
    }
}
