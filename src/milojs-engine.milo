// milojs-engine — the JavaScript engine: a pure-Milo interpreter (no C++). Runs a
// raw .js file against the built-in globals (console, Math, JSON, RegExp, Error).
// No Node runtime here — that is milojs.milo, which layers a module loader and
// node-compat shims on top of this engine.
//
// Pipeline (in the imported modules):
//   lexer.milo      source text → tokens
//   ast.milo        AST node types + the index-addressed Prog arena
//   parser.milo     tokens → AST
//   value.milo      the JSValue type + JS coercion rules
//   runtime.milo    the scope arena, object heap, and mark-sweep GC
//   eval.milo       the tree-walking evaluator
//   bytecode.milo   a bytecode path for numeric `for` loops (falls back here)
//   bootstrap.milo  builds the global object once, before any user JS runs
//   builtins.milo   String and RegExp methods
//   methods.milo    Array, TypedArray, DataView, Date and Map/Set methods
//   host.milo       fetch, child processes, sqlite: host, not language
//   driver.milo     makeInterp / bootInterp / runSource (shared with the runtime)
//
// The middle five import eval.milo and eval.milo imports them back. Milo permits
// circular imports, which is what lets a leaf call the evaluator services it
// needs instead of reimplementing them.

from "std/fs" import {
    readFile
}
from "std/strconv" import {
    parseInt
}
from "std/env" import {
    Env
}
from "std/runtime" import {
    Task, schedulerCurrent
}
from "std/os" import {
    exit
}
from "std/argparse" import {
    ArgParser
}
from "std/args" import {
    args
}
from "./engine/bytecode" import {
    gVmDisabled, gVmStats, vmStatsReport, compileBody, compileFor
}
from "./engine/version" import {
    versionText
}
from "./engine/driver" import {
    makeInterp, bootInterp, describeThrown
, interpStackBytes}
from "./engine/parser" import {
    PState, parseProgram
}
from "./engine/lexer" import {
    lex
}
from "./engine/ast" import {
    Prog, gProg, BlockId, Stmt, StmtId
}
from "./runtime/modules" import {
    preloadGraph, dirOf, hasEsmSyntax, moduleIsStrict
}
from "./engine/eval" import {
    runModule, runEventLoop, hoistBlock, execBlock, anyGenParked
}

fn main(): i32 {
    // Checked before argparse: `--version` is not a positional, so parse() would
    // reject it as an unknown flag with no `file` argument.
    let argv = args()
    var ai: i64 = 1
    while ai < argv.len() {
        if argv[ai] == "--version" || argv[ai] == "-V" {
            print(versionText("milojs-engine"))
            return 0
        }
        ai = ai + 1
    }

    var parser = ArgParser.new("milojs-engine", "the milojs JavaScript engine — runs a raw .js file")
    parser.addPositional("file", "the .js file to run")
    parser.addBool("vm-audit", "", "parse the file (and its require graph), attempt to compile every function body and loop, print the ranked residue, and exit without executing anything")
    let parsed = parser.parse()
    let vmAudit = parsed.getBool("vm-audit")
    // parse() already exits on a missing required positional, so the None arm is
    // unreachable — the default keeps this a plain string rather than an unwrap panic.
    let path = parsed.getString("file") ?? ""

    let r = readFile(path)
    match r {
        Result.Ok(src) => {
            var gcStats = false
            // same knob the runtime honours, so the GC-stress pass reaches the
            // engine binary too
            var gcThreshold: i64 = 1024
            if let Option.Some(tv) = Env.get("MILOJS_GC_THRESHOLD") {
                if let Option.Some(n) = parseInt(tv) {
                    if n > 0 {
                        gcThreshold = n
                    }
                }
            }
            if let Option.Some(_v) = Env.get("MILOJS_GC_STATS") {
                gcStats = true
            }
            // Headroom multiple over the live set between collections. The
            // runtime has honoured this for a while; the engine hardcoded 2,
            // which meant the GC-stress pass could never squeeze the engine
            // binary harder than live*2 no matter what MILOJS_GC_THRESHOLD said,
            // because collect() resets the trigger to max(floor, live*growth).
            var gcGrowth: i64 = 2
            // 0 is allowed and is the only setting that really collects at
            // every safepoint: the trigger is max(floor, live*growth), so any
            // positive growth scales with the live set and thins out as the heap
            // grows. AGENTS.md claimed MILOJS_GC_THRESHOLD=1 collected on every
            // allocation; it never did.
            if let Option.Some(gv) = Env.get("MILOJS_GC_GROWTH") {
                if let Option.Some(n) = parseInt(gv) {
                    if n >= 0 {
                        gcGrowth = n
                    }
                }
            }
            // Force every expression through the tree-walking evaluator. The
            // fixture suite is run both ways and the outputs must match, which is
            // what stops a compiled opcode from quietly disagreeing with the
            // evaluator it stands in for.
            if let Option.Some(_b) = Env.get("MILOJS_NO_BYTECODE") {
                gVmDisabled = true
            }
            if let Option.Some(_vs) = Env.get("MILOJS_VM_STATS") {
                gVmStats = true
            }
            gInterp = makeInterp(gcStats, gcThreshold, gcGrowth)
            bootInterp(gInterp)
            // The prelude and the program must share one Prog: a JSValue.Func
            // carries an index into prog.funcs, so a function parsed into a
            // different Prog would index the wrong table when called. Work on
            // gProg (like milojs.milo does), not a local: natives that invoke
            // user callbacks (proxy ownKeys from Object.keys) reach the program
            // through gProg, and a local would leave it empty.
            // spec builtins that are written in JS rather than as natives; run in
            // global scope so its declarations become globals
            let preludeIdx = preloadGraph("builtin:engine-prelude", gProg, gInterp)
            if preludeIdx >= 0 {
                hoistBlock(gProg, gInterp.modBlocks[preludeIdx], gInterp, 0)
                execBlock(gProg, gInterp.modBlocks[preludeIdx], gInterp, 0)
            }
            // Temporal, in its own file because it is large and self-contained;
            // same global scope, loaded after the prelude it depends on
            let temporalIdx = preloadGraph("builtin:temporal", gProg, gInterp)
            if temporalIdx >= 0 {
                hoistBlock(gProg, gInterp.modBlocks[temporalIdx], gInterp, 0)
                execBlock(gProg, gInterp.modBlocks[temporalIdx], gInterp, 0)
            }
            if gInterp.throwing {
                eprint("milojs-engine: prelude failed: " + describeThrown(gInterp, gInterp.thrownValue))
                return 1
            }
            // Everything parsed past these marks is the user program and its
            // require graph; the preludes before them stay out of the audit.
            let auditFuncsFrom = gProg.funcs.len()
            let auditStmtsFrom = gProg.stmts.len()
            // A file with ESM imports has to run as a module: its desugared
            // require() calls need the whole graph pre-loaded. A plain script is
            // parsed straight into the shared Prog and left in global scope.
            var entryIdx: i64 = -1
            // -1 index = "no top-level block", i.e. the ESM path below
            var topBlock = BlockId { index: -1 }
            // lex once and hand the tokens to PState: `lex` takes &string, so the
            // clone was never needed, and hasEsmSyntax only borrows the tokens
            let toks = lex(src)
            if !hasEsmSyntax(toks) {
                // A plain script still runs in GLOBAL scope (so top-level decls
                // stay globals), but its require() graph has to be registered
                // first or every require fails with "module was not pre-loaded".
                // preloadGraph walks require() edges from the entry; the entry's
                // own parse here is what actually executes.
                // In audit mode the require graph is not loaded: preload parses
                // the entry a second time (doubling every body in the count) and
                // would fold shared helpers like a corpus's common/ into every
                // file's number. The audit is of THIS file's code.
                if !vmAudit {
                    let _ = preloadGraph(path.clone(), gProg, gInterp)
                }
                // require() resolves against the CURRENT module's directory, and
                // preload resolved against the entry's. Without pushing it the two
                // disagree for anything but a bare builtin: preload registers
                // <dir>/x.json while the runtime looks up x.json.
                gInterp.modDirStack.push(dirOf(path))
                gInterp.modPathStack.push(path.clone())
                // the entry is module code too when it is ESM, and module code
                // is strict without a directive
                let entryStrict = moduleIsStrict(toks, path)
                var p = PState { depth: 0, noIn: false,
                    toks: toks, pos: 0, curClass: "", privNames: Vec.new(), privOwners: Vec.new(), file: path.clone(), errored: false, eofError: false, quiet: false, strict: entryStrict
                }
                topBlock = parseProgram(p, gProg)
                // see runSource in driver.milo: a syntax error must not run, and
                // must not exit 0
                if p.errored {
                    return 1
                }
            } else {
                entryIdx = preloadGraph(path.clone(), gProg, gInterp)
                if entryIdx < 0 {
                    eprint("milojs-engine: cannot load '" + path + "'")
                    return 1
                }
            }
            // Audit mode: the corpus coverage number comes from the compiler
            // itself, not from a reimplementation of its admission rules — the
            // duplicate would drift, and the drift would be invisible. Nothing
            // executes: compile is side-effect-free apart from the stats.
            if vmAudit {
                gVmStats = true
                var fi = auditFuncsFrom
                while fi < gProg.funcs.len() {
                    let _b = compileBody(gProg, fi)
                    fi = fi + 1
                }
                var si = auditStmtsFrom
                while si < gProg.stmts.len() {
                    match gProg.stmts[si] {
                        Stmt.For(_a, _b, _c, _d) => {
                            let _l = compileFor(gProg, StmtId { index: si })
                        }
                        _ => {
                        }
                    }
                    si = si + 1
                }
                print("vm-audit: " + path)
                print(vmStatsReport())
                return 0
            }
            // Run the program on a green task rather than the process main
            // thread. A generator body IS a task that its next() caller parks
            // on, and schedulerCurrent() is null off-task — so every
            // `function*` threw "generators require the milojs runtime". The
            // runtime (milojs.milo) has always done this; the engine needs it
            // for the same reason. The prelude stays on the main thread, as it
            // does there.
            let interpTask = Task.spawnWithStack(move(): void => {
                // this task drives the event loop, so it never parks on an await
                gInterp.mainTask = schedulerCurrent()
                if topBlock.index >= 0 {
                    // top-level code has no FuncDef to carry its strictness
                    gInterp.strict = gProg.progStrict
                    hoistBlock(gProg, topBlock, gInterp, 0)
                    execBlock(gProg, topBlock, gInterp, 0)
                } else {
                    runModule(gProg, entryIdx, gInterp)
                }
                if !gInterp.throwing {
                    runEventLoop(gProg, gInterp)
                }
                // A generator consumed only partway leaves its body task parked
                // forever. The scheduler still counts it, so join() would block
                // on a final poll no event can wake. Node drops such a generator
                // and exits — report any pending error as main would, then
                // terminate rather than returning into a wedged join.
                if anyGenParked(gInterp) {
                    if gInterp.throwing {
                        eprint("Uncaught " + describeThrown(gInterp, gInterp.thrownValue))
                        exit(1)
                    }
                    exit(0)
                }
            }
            // Sized per-OS: see interpStackBytes in driver.milo for why linux gets a
            // stack big enough that the frame-count backstop always fires first and
            // darwin cannot yet.
            , interpStackBytes())
            interpTask.join()
            // Stderr, so stdout stays byte-identical to node either way.
            if gVmStats {
                eprint(vmStatsReport())
            }
            if gInterp.throwing {
                eprint("Uncaught " + describeThrown(gInterp, gInterp.thrownValue))
                return 1
            }
            return 0
        }
        Result.Err(_e) => {
            eprint("milojs-engine: cannot read '" + path + "'")
            return 1
        }
    }
}
