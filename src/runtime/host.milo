// Host bindings the evaluator reaches for but does not own: an HTTP fetch, a
// child process, a sqlite handle, a DNS-style dotted quad, a path made
// absolute. None of them are the ECMAScript language, and none belong in
// src/engine/eval.milo, which is the evaluator. `milojs-engine` links this file and
// never calls into it; only the `milojs` runtime does.

from "../engine/strutil" import {
    strSlice, jsIndexOf, jsStartsWith
}
from "../engine/value" import {
    JSValue, Native, Builtin
}
from "../engine/runtime" import {
    Interp, scopeDefine
}
// A live index into st.sqliteDbs, or -1 when the handle is closed or bogus. Every
// sqlite native funnels through this so a use-after-close is a JS-level error
// rather than a call on a freed sqlite3*.
pub fn sqliteDbIdx(st: &Interp, v: &JSValue): i64 {
    let i = toNum(v) as i64
    if i < 0 || i >= st.sqliteDbs.len() || !st.sqliteDbLive[i] {
        return 0 - 1
    }
    return i
}

pub fn sqliteStmtIdx(st: &Interp, v: &JSValue): i64 {
    let i = toNum(v) as i64
    if i < 0 || i >= st.sqliteStmts.len() || !st.sqliteStmtLive[i] {
        return 0 - 1
    }
    return i
}

// Invoke a native function/constructor. Error(msg) and new Error(msg) behave the
// same (both mint an error object), matching JS.
// Synchronous outbound HTTP/HTTPS. Milo has no coroutines and the event loop is
// drained in place on await, so a blocking request is consistent with the rest of
// the runtime (the server side blocks on accept too). Returns the raw HTTP
// response text prefixed with 'O', or 'E' + message on any failure — the JS side
// (lib/node-fetch.js) strips the sentinel and parses the response.
pub fn doHttpFetch(method: &string, url: &string, headersRaw: &string, body: &string): string {
    // parse scheme://host[:port]/path
    var rest = url.clone()
    var tls = true
    var defPort: i64 = 443
    if jsStartsWith(rest, "https://") {
        rest = strSlice(rest, 8, rest.len())
    } else if jsStartsWith(rest, "http://") {
        tls = false
        defPort = 80
        rest = strSlice(rest, 7, rest.len())
    } else {
        return "Eunsupported URL scheme: " + url.clone()
    }
    // host[:port] is up to the first '/'
    var slash = jsIndexOf(rest, "/", 0)
    var authority = rest.clone()
    var path = "/"
    if slash >= 0 {
        authority = strSlice(rest, 0, slash)
        path = strSlice(rest, slash, rest.len())
    }
    var host = authority.clone()
    var port = defPort
    let colon = jsIndexOf(authority, ":", 0)
    if colon >= 0 {
        host = strSlice(authority, 0, colon)
        let portStr = strSlice(authority, colon + 1, authority.len())
        port = toNum(JSValue.Str(portStr)) as i64
        if port <= 0 {
            port = defPort
        }
    }
    // DNS
    var ip: u32 = 0
    match resolve(host) {
        Result.Ok(a) => {
            ip = a
        }
        Result.Err(_e) => {
            return "Ecannot resolve host: " + host.clone()
        }
    }
    // build the request. HTTP/1.1 with Connection: close so the read loop ends at
    // EOF instead of needing to parse content-length/chunked to know when to stop.
    var req = method.clone() + " " + path.clone() + " HTTP/1.1\r\n"
    req = req + "Host: " + host.clone() + "\r\n"
    req = req + headersRaw.clone()
    req = req + "Connection: close\r\n"
    if body.len() > 0 {
        req = req + "Content-Length: " + i64ToStr(body.len()) + "\r\n"
    }
    req = req + "\r\n" + body.clone()

    if tls {
        match TlsStream.connect(ip, port as u16, host) {
            Result.Ok(conn) => {
                if let Result.Err(_e) = conn.send(req) {
                    return "Esend failed"
                }
                var resp = ""
                var reading = true
                while reading {
                    match conn.recv() {
                        Result.Ok(chunk) => {
                            if chunk.len() == 0 {
                                reading = false
                            } else {
                                resp = resp + chunk
                            }
                        }
                        Result.Err(_e) => {
                            reading = false
                        }
                    }
                }
                return "O" + resp
            }
            Result.Err(_e) => {
                return "ETLS connect failed to " + host.clone()
            }
        }
    }
    match TcpStream.connect(ip, port as u16) {
        Result.Ok(conn) => {
            if let Result.Err(_e) = conn.send(req) {
                return "Esend failed"
            }
            var resp = ""
            var reading = true
            while reading {
                match conn.recv() {
                    Result.Ok(chunk) => {
                        if chunk.len() == 0 {
                            reading = false
                        } else {
                            resp = resp + chunk
                        }
                    }
                    Result.Err(_e) => {
                        reading = false
                    }
                }
            }
            return "O" + resp
        }
        Result.Err(_e) => {
            return "ETCP connect failed to " + host.clone()
        }
    }
}

// require(spec) — resolved against the directory of the module the call SITE
// belongs to, which is not always the module currently running.
//
// `st.modDirStack` is dynamic: it is popped when a module body finishes. A lazy
// require inside a closure runs long after that, so it saw whoever triggered it.
// body-parser's `Object.defineProperty(exports, 'json', {get: … require('./lib/types/json')})`
// is exactly this shape, and express reaching for `bodyParser.json` resolved it
// as `node_modules/express/lib/lib/types/json` — express 4 could not load at all.
// The lexical `__dirname` binding is per module scope, so looking it up through
// the closure's own env chain names the right module.
// Make a path absolute against the process working directory. Module paths are
// stored relative internally; what escapes to JS must not be.
pub fn absolutePathOf(p: string): string {
    if p.len() > 0 && p[0] == '/' {
        return p
    }
    // a builtin module is not a filesystem path and must not acquire one
    if p.len() >= 8 && strSlice(p, 0, 8) == "builtin:" {
        return p
    }
    let base = match currentDir() {
        Result.Ok(d) => d
        Result.Err(_e) => {
            return p
        }
    }
    if p.len() == 0 {
        return base
    }
    if p == "." {
        return base
    }
    return base + "/" + p
}

// A dotted-quad host as the packed u32 TcpStream.connect wants. There is no
// resolver here, so a name that is not four numbers falls back to loopback,
// which is what "localhost" means and what every test that connects to a server
// it just started is asking for.
pub fn parseDottedQuad(host: &string): u32 {
    var parts: Vec<i64> = Vec.new()
    var cur: i64 = 0
    var digits: i64 = 0
    var i: i64 = 0
    while i < host.len() {
        let c = host[i]
        if c >= '0' && c <= '9' {
            cur = cur * 10 + (c as i64 - 48)
            digits = digits + 1
        } else if c == '.' {
            parts.push(cur)
            cur = 0
            digits = 0
        } else {
            return ip4(127 as u8, 0 as u8, 0 as u8, 1 as u8)
        }
        i = i + 1
    }
    if digits > 0 {
        parts.push(cur)
    }
    if parts.len() != 4 {
        return ip4(127 as u8, 0 as u8, 0 as u8, 1 as u8)
    }
    return ip4(parts[0] as u8, parts[1] as u8, parts[2] as u8, parts[3] as u8)
}

// Drain every queued microtask. Microtasks may enqueue more, which is correct:
// JS runs the queue to exhaustion before the next timer.
// Settle a promise and queue every reaction that was waiting on it. Settling
// twice is ignored, as in JS.
// Run threadsafe-function calls queued by an addon's own threads, then apply any
// promise settlements they made. This is the only place a foreign thread's work
// crosses into the interpreter.
// Settle any fetch whose worker thread has finished. Called from the event loop
// and from a blocked await, the same way node-api work is serviced.
// Run a child to completion off the interpreter thread and encode the result as
// one string, because that is what the pending-work channel carries. The format
// is "<status>|<output>": a status and the combined stdout/stderr, with the
// first pipe separating them so output containing pipes survives intact.
// Read to EOF then reap. Runs on the worker thread: both halves block, and the
// interpreter loop owns the OS main thread and never parks.
pub fn readChildToCompletion(child: Child): string {
    var text = ""
    var buf: [u8; 4096] = [0; 4096]
    var reading = true
    while reading {
        var n: i64 = 0
        unsafe {
            n = child.readStdout(buf as *u8, 4096)
        }
        if n <= 0 {
            reading = false
        } else {
            var bi: i64 = 0
            while bi < n {
                text.push(buf[bi])
                bi = bi + 1
            }
        }
    }
    var code: i64 = 0
    match child.wait() {
        Result.Ok(c) => {
            code = c as i64
        }
        Result.Err(_w) => {
            code = 0 - 1
        }
    }
    return i64ToStr(code) + "|" + text
}

pub fn buildChildCommand(program: string, args: Vec<string>, envPairs: Vec<string>): Command {
    var cmd = Command.new(program).args(args).stderr(Stdio.Merge)
    var ei: i64 = 0
    while ei < envPairs.len() {
        let pair = envPairs[ei].clone()
        var eq: i64 = 0 - 1
        var ci: i64 = 0
        while ci < pair.len() {
            if pair[ci] == '=' && eq < 0 {
                eq = ci
            }
            ci = ci + 1
        }
        if eq > 0 {
            let ename = pair.slice(0, eq).clone()
            let eval_ = pair.slice(eq + 1, pair.len()).clone()
            cmd = cmd.env(ename, eval_)
        }
        ei = ei + 1
    }
    return cmd
}

// The host capability surface, installed as `__`-prefixed globals for the
// JS-written runtime modules to call. This lives here, and is called only from
// src/milojs.milo, because installing it is what grants a script the ability to
// spawn processes, open files and open sockets. src/engine/bootstrap.milo used to
// install all 71, which meant `milojs-engine` and every libmilojs embedder handed
// arbitrary JS a working __spawnSync. An embedder that wants these opts in by
// calling this; the language itself never does.
pub fn installHostGlobals(st: &mut Interp) {
    scopeDefine(st, 0, "__tcpListen", JSValue.Native(Native.Fn(Builtin.TcpListen)))
    scopeDefine(st, 0, "__tcpAccept", JSValue.Native(Native.Fn(Builtin.TcpAccept)))
    scopeDefine(st, 0, "__tcpRecv", JSValue.Native(Native.Fn(Builtin.TcpRecv)))
    scopeDefine(st, 0, "__tcpSend", JSValue.Native(Native.Fn(Builtin.TcpSend)))
    scopeDefine(st, 0, "__tcpClose", JSValue.Native(Native.Fn(Builtin.TcpClose)))
    scopeDefine(st, 0, "__tcpConnect", JSValue.Native(Native.Fn(Builtin.TcpConnect)))
    scopeDefine(st, 0, "__tcpPort", JSValue.Native(Native.Fn(Builtin.TcpPort)))
    scopeDefine(st, 0, "__tcpRead", JSValue.Native(Native.Fn(Builtin.TcpRead)))
    scopeDefine(st, 0, "__spawnSync", JSValue.Native(Native.Fn(Builtin.SpawnSync)))
    scopeDefine(st, 0, "__spawnAsync", JSValue.Native(Native.Fn(Builtin.SpawnAsync)))
    scopeDefine(st, 0, "__killPid", JSValue.Native(Native.Fn(Builtin.KillPid)))
    scopeDefine(st, 0, "__exePath", JSValue.Native(Native.Fn(Builtin.ExePath)))
    scopeDefine(st, 0, "__httpFetch", JSValue.Native(Native.Fn(Builtin.HttpFetch)))
    scopeDefine(st, 0, "__sqliteOpen", JSValue.Native(Native.Fn(Builtin.SqliteOpen)))
    scopeDefine(st, 0, "__sqliteClose", JSValue.Native(Native.Fn(Builtin.SqliteClose)))
    scopeDefine(st, 0, "__sqliteExec", JSValue.Native(Native.Fn(Builtin.SqliteExec)))
    scopeDefine(st, 0, "__sqlitePrepare", JSValue.Native(Native.Fn(Builtin.SqlitePrepare)))
    scopeDefine(st, 0, "__sqliteErrmsg", JSValue.Native(Native.Fn(Builtin.SqliteErrmsg)))
    scopeDefine(st, 0, "__sqliteStep", JSValue.Native(Native.Fn(Builtin.SqliteStep)))
    scopeDefine(st, 0, "__sqliteColumnCount", JSValue.Native(Native.Fn(Builtin.SqliteColumnCount)))
    scopeDefine(st, 0, "__sqliteColumnName", JSValue.Native(Native.Fn(Builtin.SqliteColumnName)))
    scopeDefine(st, 0, "__sqliteColumnValue", JSValue.Native(Native.Fn(Builtin.SqliteColumnValue)))
    scopeDefine(st, 0, "__sqliteBind", JSValue.Native(Native.Fn(Builtin.SqliteBind)))
    scopeDefine(st, 0, "__sqliteReset", JSValue.Native(Native.Fn(Builtin.SqliteReset)))
    scopeDefine(st, 0, "__sqliteFinalize", JSValue.Native(Native.Fn(Builtin.SqliteFinalize)))
    scopeDefine(st, 0, "__sqliteChanges", JSValue.Native(Native.Fn(Builtin.SqliteChanges)))
    scopeDefine(st, 0, "__sqliteLastInsertId", JSValue.Native(Native.Fn(Builtin.SqliteLastInsertId)))
    scopeDefine(st, 0, "__sqliteBindIndex", JSValue.Native(Native.Fn(Builtin.SqliteBindIndex)))
    scopeDefine(st, 0, "__sqliteFilename", JSValue.Native(Native.Fn(Builtin.SqliteFilename)))
    scopeDefine(st, 0, "__httpRegister", JSValue.Native(Native.Fn(Builtin.HttpRegister)))
    scopeDefine(st, 0, "__httpUnregister", JSValue.Native(Native.Fn(Builtin.HttpUnregister)))
    scopeDefine(st, 0, "__writeFileSync", JSValue.Native(Native.Fn(Builtin.WriteFile)))
    scopeDefine(st, 0, "__readFileSync", JSValue.Native(Native.Fn(Builtin.ReadFileSync)))
    scopeDefine(st, 0, "__mkdirSync", JSValue.Native(Native.Fn(Builtin.Mkdir)))
    scopeDefine(st, 0, "__readdirSync", JSValue.Native(Native.Fn(Builtin.Readdir)))
    scopeDefine(st, 0, "__unlinkSync", JSValue.Native(Native.Fn(Builtin.Unlink)))
    scopeDefine(st, 0, "__rmdirSync", JSValue.Native(Native.Fn(Builtin.Rmdir)))
    scopeDefine(st, 0, "__renameSync", JSValue.Native(Native.Fn(Builtin.Rename)))
    scopeDefine(st, 0, "__isDir", JSValue.Native(Native.Fn(Builtin.IsDir)))
    scopeDefine(st, 0, "__statSync", JSValue.Native(Native.Fn(Builtin.StatInfo)))
    scopeDefine(st, 0, "__deflateRaw", JSValue.Native(Native.Fn(Builtin.DeflateRaw)))
    scopeDefine(st, 0, "__deflateGzip", JSValue.Native(Native.Fn(Builtin.DeflateGzip)))
    scopeDefine(st, 0, "__deflateZlib", JSValue.Native(Native.Fn(Builtin.DeflateZlib)))
    scopeDefine(st, 0, "__inflateRaw", JSValue.Native(Native.Fn(Builtin.InflateRaw)))
    scopeDefine(st, 0, "__inflateGzip", JSValue.Native(Native.Fn(Builtin.InflateGzip)))
    scopeDefine(st, 0, "__inflateZlib", JSValue.Native(Native.Fn(Builtin.InflateZlib)))
    scopeDefine(st, 0, "__udpBind", JSValue.Native(Native.Fn(Builtin.UdpBind)))
    scopeDefine(st, 0, "__udpSend", JSValue.Native(Native.Fn(Builtin.UdpSend)))
    scopeDefine(st, 0, "__udpRecv", JSValue.Native(Native.Fn(Builtin.UdpRecv)))
    scopeDefine(st, 0, "__udpClose", JSValue.Native(Native.Fn(Builtin.UdpClose)))
    scopeDefine(st, 0, "__udpAddress", JSValue.Native(Native.Fn(Builtin.UdpAddress)))
    scopeDefine(st, 0, "__openFlags", JSValue.Native(Native.Fn(Builtin.OpenFlags)))
    scopeDefine(st, 0, "__openSync", JSValue.Native(Native.Fn(Builtin.OpenFd)))
    scopeDefine(st, 0, "__closeSync", JSValue.Native(Native.Fn(Builtin.CloseFd)))
    scopeDefine(st, 0, "__readFdInto", JSValue.Native(Native.Fn(Builtin.ReadFdInto)))
    scopeDefine(st, 0, "__writeFdFrom", JSValue.Native(Native.Fn(Builtin.WriteFdFrom)))
    scopeDefine(st, 0, "__fsyncSync", JSValue.Native(Native.Fn(Builtin.FsyncFd)))
    scopeDefine(st, 0, "__ftruncateSync", JSValue.Native(Native.Fn(Builtin.FtruncateFd)))
    scopeDefine(st, 0, "__fchmodSync", JSValue.Native(Native.Fn(Builtin.FchmodFd)))
    scopeDefine(st, 0, "__fileSize", JSValue.Native(Native.Fn(Builtin.FileSize)))
    scopeDefine(st, 0, "__readlinkSync", JSValue.Native(Native.Fn(Builtin.Readlink)))
    scopeDefine(st, 0, "__symlinkSync", JSValue.Native(Native.Fn(Builtin.Symlink)))
    scopeDefine(st, 0, "__linkSync", JSValue.Native(Native.Fn(Builtin.Hardlink)))
    scopeDefine(st, 0, "__realpathSync", JSValue.Native(Native.Fn(Builtin.Realpath)))
    scopeDefine(st, 0, "__chmodSync", JSValue.Native(Native.Fn(Builtin.Chmod)))
    scopeDefine(st, 0, "__truncateSync", JSValue.Native(Native.Fn(Builtin.TruncateFile)))
    scopeDefine(st, 0, "__mkdtempSync", JSValue.Native(Native.Fn(Builtin.Mkdtemp)))
    scopeDefine(st, 0, "__copyFileSync", JSValue.Native(Native.Fn(Builtin.CopyFile)))
    scopeDefine(st, 0, "__fileExists", JSValue.Native(Native.Fn(Builtin.FileExists)))
    scopeDefine(st, 0, "__napiLoad", JSValue.Native(Native.Fn(Builtin.NapiLoad)))
    scopeDefine(st, 0, "__httpFetchAsync", JSValue.Native(Native.Fn(Builtin.HttpFetchAsync)))
}
