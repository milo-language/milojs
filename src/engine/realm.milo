// Realms: a set of intrinsics (every built-in constructor and prototype) and a
// global scope. Code runs in exactly one realm at a time, and Interp caches that
// realm's intrinsics in its own fields, so an intrinsic read anywhere in the
// engine is still a plain field load. Switching realm writes the cache back into
// Interp.realms and loads another realm's.
//
// NOT per realm, and deliberately so: the symbol table and the Symbol.for
// registry (the spec shares both across realms), the well-known symbols, the
// heap, the job and timer queues, and the call stack.

from "./runtime" import {
    Interp, newScope, markBuiltinGlobals, scopeLookup, scopeTryLookup, scopeAssign, scopeOwnIndex,
    scopeFindBelowGlobal, scopeDefine, newObject, objSet, pushTemp, popTemp
}
from "./value" import {
    JSValue, objHandle, truthy, cloneValue
}
from "./ast" import {
    Prog, BlockId
}
from "./bootstrap" import {
    setupGlobals
}
from "./eval" import {
    hoistBlock, execBlock, evalInOperator, getMemberDyn, setMemberDyn, definePropOf, deleteOwnKey, throwErr, nameInList
}

// The scalar half of a realm: every field Interp caches under the same name.
// saveRealm is the only code copying Interp into one of these and loadRealm the
// only code copying back. saveRealm names every field in a struct literal, so the
// compiler rejects one it forgets; tools/check-realm-fields.mjs holds loadRealm
// and the collector's markRealms to the same list.
pub struct RealmIntrinsics {
    globalScope: i64,
    // The object whose properties are this realm's global variables, or -1: see
    // identTryLookup. Cached like the rest so the check costs code in an
    // ordinary realm one field compare per global name.
    sandboxObj: i64,
    builtinGlobals: i64,
    promiseCtorObj: i64,
    stringCtorProps: i64,
    stringProtoObj: i64,
    functionProtoObj: i64,
    dateCtorProps: i64,
    dateProtoObj: i64,
    regexProtoObj: i64,
    mapProtoObj: i64,
    setProtoObj: i64,
    promiseProtoObj: i64,
    iterProtoObj: i64,
    genProtoObj: i64,
    arrayCtorObj: i64,
    objectProtoObj: i64,
    arrayProtoObj: i64,
    dataViewProtoObj: i64,
    taProtoObj: i64,
    taProtoLo: i64,
    taProtoHi: i64,
    arrayProtoPristine: bool,
    stringProtoPristine: bool,
    dateProtoPristine: bool,
    regexProtoPristine: bool,
    dataViewProtoPristine: bool,
    taProtoPristine: bool,
    objectProtoPristine: bool,
}

pub struct Realm {
    intr: RealmIntrinsics,
    // Read in place through realms[curRealm] rather than cached on Interp: a Vec
    // would be copied on every realm switch. The canonical function object of
    // each builtin (see nativeObj) and each concrete typed-array prototype.
    nativeObjs: Vec<i64>,
    taProtos: Vec<i64>,
    // The names a sandboxed realm's scripts declared with var or function. V8
    // keeps a copy of each on the real global object, so `delete` of one answers
    // false and the name still resolves; identDelete answers the same.
    sandboxVars: Vec<string>,
}

// A realm that has not been booted yet: no intrinsics, every fast-path guard
// down until setupGlobals raises it. Object.prototype's guard starts UP because
// the object it guards starts with no non-writable data property at all.
pub fn emptyRealm(globalScope: i64): Realm {
    return Realm {
        intr: RealmIntrinsics {
            globalScope: globalScope, sandboxObj: -1, builtinGlobals: 0,
            promiseCtorObj: -1, stringCtorProps: -1, stringProtoObj: -1, functionProtoObj: -1,
            dateCtorProps: -1, dateProtoObj: -1, regexProtoObj: -1, mapProtoObj: -1,
            setProtoObj: -1, promiseProtoObj: -1, iterProtoObj: -1, genProtoObj: -1,
            arrayCtorObj: -1, objectProtoObj: -1, arrayProtoObj: -1, dataViewProtoObj: -1,
            taProtoObj: -1, taProtoLo: 0, taProtoHi: -1,
            arrayProtoPristine: false, stringProtoPristine: false, dateProtoPristine: false,
            regexProtoPristine: false, dataViewProtoPristine: false, taProtoPristine: false,
            objectProtoPristine: true,
        },
        nativeObjs: Vec.new(),
        taProtos: Vec.new(),
        sandboxVars: Vec.new(),
    }
}

// Write the running realm's cached intrinsics back into its Realm record.
pub fn saveRealm(st: &mut Interp) {
    if st.curRealm >= st.realms.len() {
        return
    }
    st.realms[st.curRealm].intr = RealmIntrinsics {
        globalScope: st.globalScope,
        sandboxObj: st.sandboxObj,
        builtinGlobals: st.builtinGlobals,
        promiseCtorObj: st.promiseCtorObj,
        stringCtorProps: st.stringCtorProps,
        stringProtoObj: st.stringProtoObj,
        functionProtoObj: st.functionProtoObj,
        dateCtorProps: st.dateCtorProps,
        dateProtoObj: st.dateProtoObj,
        regexProtoObj: st.regexProtoObj,
        mapProtoObj: st.mapProtoObj,
        setProtoObj: st.setProtoObj,
        promiseProtoObj: st.promiseProtoObj,
        iterProtoObj: st.iterProtoObj,
        genProtoObj: st.genProtoObj,
        arrayCtorObj: st.arrayCtorObj,
        objectProtoObj: st.objectProtoObj,
        arrayProtoObj: st.arrayProtoObj,
        dataViewProtoObj: st.dataViewProtoObj,
        taProtoObj: st.taProtoObj,
        taProtoLo: st.taProtoLo,
        taProtoHi: st.taProtoHi,
        arrayProtoPristine: st.arrayProtoPristine,
        stringProtoPristine: st.stringProtoPristine,
        dateProtoPristine: st.dateProtoPristine,
        regexProtoPristine: st.regexProtoPristine,
        dataViewProtoPristine: st.dataViewProtoPristine,
        taProtoPristine: st.taProtoPristine,
        objectProtoPristine: st.objectProtoPristine,
    }
}

// Load realm r's intrinsics into the Interp cache. Does not save the running
// one first; enterRealm is the caller that pairs the two.
fn loadRealm(st: &mut Interp, r: i64) {
    st.globalScope = st.realms[r].intr.globalScope
    st.sandboxObj = st.realms[r].intr.sandboxObj
    st.builtinGlobals = st.realms[r].intr.builtinGlobals
    st.promiseCtorObj = st.realms[r].intr.promiseCtorObj
    st.stringCtorProps = st.realms[r].intr.stringCtorProps
    st.stringProtoObj = st.realms[r].intr.stringProtoObj
    st.functionProtoObj = st.realms[r].intr.functionProtoObj
    st.dateCtorProps = st.realms[r].intr.dateCtorProps
    st.dateProtoObj = st.realms[r].intr.dateProtoObj
    st.regexProtoObj = st.realms[r].intr.regexProtoObj
    st.mapProtoObj = st.realms[r].intr.mapProtoObj
    st.setProtoObj = st.realms[r].intr.setProtoObj
    st.promiseProtoObj = st.realms[r].intr.promiseProtoObj
    st.iterProtoObj = st.realms[r].intr.iterProtoObj
    st.genProtoObj = st.realms[r].intr.genProtoObj
    st.arrayCtorObj = st.realms[r].intr.arrayCtorObj
    st.objectProtoObj = st.realms[r].intr.objectProtoObj
    st.arrayProtoObj = st.realms[r].intr.arrayProtoObj
    st.dataViewProtoObj = st.realms[r].intr.dataViewProtoObj
    st.taProtoObj = st.realms[r].intr.taProtoObj
    st.taProtoLo = st.realms[r].intr.taProtoLo
    st.taProtoHi = st.realms[r].intr.taProtoHi
    st.arrayProtoPristine = st.realms[r].intr.arrayProtoPristine
    st.stringProtoPristine = st.realms[r].intr.stringProtoPristine
    st.dateProtoPristine = st.realms[r].intr.dateProtoPristine
    st.regexProtoPristine = st.realms[r].intr.regexProtoPristine
    st.dataViewProtoPristine = st.realms[r].intr.dataViewProtoPristine
    st.taProtoPristine = st.realms[r].intr.taProtoPristine
    st.objectProtoPristine = st.realms[r].intr.objectProtoPristine
}

// Make realm r the running one and answer the realm that was running, for the
// caller to hand back to enterRealm when it is done. Entering the running realm
// costs one compare.
pub fn enterRealm(st: &mut Interp, r: i64): i64 {
    let prev = st.curRealm
    if r == prev {
        return prev
    }
    saveRealm(&mut st)
    loadRealm(&mut st, r)
    st.curRealm = r
    return prev
}

// Register a new, empty realm whose global scope is `globalScope`, and answer
// its index. Does not enter it.
pub fn addRealm(st: &mut Interp, globalScope: i64): i64 {
    st.realms.push(emptyRealm(globalScope))
    return st.realms.len() - 1
}

// The first realm, the one every binary boots into.
pub fn bootFirstRealm(st: &mut Interp, globalScope: i64) {
    let r = addRealm(&mut st, globalScope)
    st.curRealm = r
    loadRealm(&mut st, r)
}

// The realm object `o` was allocated in.
pub fn objRealm(st: &Interp, o: i64): i64 {
    return st.objects[o].realm as i64
}

// The [[Realm]] of a callable: the realm its function object was allocated in,
// which a call has to enter. -1 for anything that is not a function object.
pub fn calleeRealm(st: &Interp, v: &JSValue): i64 {
    match v {
        JSValue.Func(_f, _e, fo) => {
            return st.objects[fo].realm as i64
        }
        JSValue.Native(_n, fo) => {
            if fo >= 0 {
                return st.objects[fo].realm as i64
            }
            return -1
        }
        JSValue.Obj(o) => {
            return st.objects[o].realm as i64
        }
        _ => {
            return -1
        }
    }
}

// Realm r's view of an intrinsic. The running realm's live value is the Interp
// cache; every other realm's is its saved record, current since it was left.
pub fn realmGlobalScope(st: &Interp, r: i64): i64 {
    if r == st.curRealm {
        return st.globalScope
    }
    return st.realms[r].intr.globalScope
}

pub fn realmBuiltinGlobals(st: &Interp, r: i64): i64 {
    if r == st.curRealm {
        return st.builtinGlobals
    }
    return st.realms[r].intr.builtinGlobals
}

pub fn realmObjectProto(st: &Interp, r: i64): i64 {
    if r == st.curRealm {
        return st.objectProtoObj
    }
    return st.realms[r].intr.objectProtoObj
}

pub fn realmFunctionProto(st: &Interp, r: i64): i64 {
    if r == st.curRealm {
        return st.functionProtoObj
    }
    return st.realms[r].intr.functionProtoObj
}

pub fn realmArrayProto(st: &Interp, r: i64): i64 {
    if r == st.curRealm {
        return st.arrayProtoObj
    }
    return st.realms[r].intr.arrayProtoObj
}

// The global scope a global object mirrors: its own realm's. A realm's global
// object may be read from code running in another realm, and must still answer
// with its own bindings.
pub fn globalScopeOfObj(st: &Interp, o: i64): i64 {
    return realmGlobalScope(st, st.objects[o].realm as i64)
}

// Is `o` some realm's %Array% (or %Promise%)? These two constructors are plain
// objects rather than natives, so call and construct recognise them by
// identity, and a cross-realm call must still find them.
pub fn isArrayCtorObj(st: &Interp, o: i64): bool {
    if o < 0 {
        return false
    }
    if o == st.arrayCtorObj {
        return true
    }
    let r = st.objects[o].realm as i64
    return r != st.curRealm && o == st.realms[r].intr.arrayCtorObj
}

pub fn isPromiseCtorObj(st: &Interp, o: i64): bool {
    if o < 0 {
        return false
    }
    if o == st.promiseCtorObj {
        return true
    }
    let r = st.objects[o].realm as i64
    return r != st.curRealm && o == st.realms[r].intr.promiseCtorObj
}

// Run one JS-written built-in block (the engine prelude, Temporal) in the
// running realm's global scope, and remember it so createRealm runs it in every
// later realm too.
pub fn runRealmPrelude(prog: &Prog, block: BlockId, st: &mut Interp) {
    st.realmPreludes.push(BlockId { index: block.index })
    let g = st.globalScope
    hoistBlock(prog, block, &mut st, g)
    execBlock(prog, block, &mut st, g)
}

// A new realm: its own global scope and global object, every built-in installed
// by the same bootstrap the first realm ran, then the same JS-written built-ins.
// Answers the realm's index, or -1 with the exception pending. The running realm
// is unchanged on return.
pub fn createRealm(prog: &Prog, st: &mut Interp): i64 {
    // registered before the bootstrap allocates anything, so the new global
    // scope is a root from the first collection the bootstrap triggers
    let g = newScope(&mut st, -1)
    let r = addRealm(&mut st, g)
    let prevRealm = enterRealm(&mut st, r)
    // the built-ins are sloppy code at their top level, as when the first realm
    // ran them, whatever the code asking for a realm is
    let savedStrict = st.strict
    st.strict = false
    setupGlobals(&mut st)
    var i: i64 = 0
    while i < st.realmPreludes.len() && !st.throwing {
        let block = BlockId { index: st.realmPreludes[i].index }
        hoistBlock(prog, block, &mut st, g)
        execBlock(prog, block, &mut st, g)
        i = i + 1
    }
    markBuiltinGlobals(&mut st)
    st.strict = savedStrict
    let _ = enterRealm(&mut st, prevRealm)
    if st.throwing {
        return -1
    }
    return r
}

// Realm r's global object: what its `globalThis` is bound to.
pub fn realmGlobalObject(st: &Interp, r: i64): JSValue {
    return scopeLookup(st, realmGlobalScope(st, r), "globalThis")
}

// ---- A realm's sandbox --------------------------------------------------------
//
// A realm may carry a SANDBOX: an object whose properties are that realm's
// global variables, which is what node:vm's contextifying does to the object
// handed to createContext. A global name resolves against the sandbox before
// the realm's own global bindings (so `{ Array: 1 }` shadows the built-in), and
// assignments to global names, and function declarations, land on the sandbox,
// where the host reads them back as plain properties. The realm's own global
// scope keeps its built-ins, its scripts' top-level let/const/class (which V8
// resolves before the global object, so the sandbox cannot shadow them), and a
// binding per declared var and function, V8's copy on the real global object:
// `var x;` alone puts nothing on the sandbox, and `delete x` answers false and
// leaves the name resolving.
//
// Everything goes through the ordinary property paths (has, get, set,
// defineProperty, delete), so a sandbox that is a Proxy or carries accessors
// behaves as it does in node: its traps and getters run. That is why this is
// not in scopeTryLookup, which cannot run JS. Code in a realm without a sandbox
// pays one field compare per global name, and code in one with a sandbox never
// runs as bytecode (the VM keeps globals in slots).

fn isSandboxVar(st: &Interp, name: &string): bool {
    return nameInList(st.realms[st.curRealm].sandboxVars, name)
}

// The realm's own top-level lexical binding of `name`, or -1. Bindings below
// builtinGlobals are the built-ins, and the declared vars are recorded; the
// rest are let, const and class.
fn realmLexicalIndex(st: &Interp, name: &string): i64 {
    let bi = scopeOwnIndex(st, st.globalScope, name)
    if bi >= st.builtinGlobals && !isSandboxVar(st, name) {
        return bi
    }
    return -1
}

fn sandboxHas(prog: &Prog, st: &mut Interp, name: &string): bool {
    let sb = st.sandboxObj
    return truthy(evalInOperator(prog, name.clone(), JSValue.Obj(sb), &mut st))
}

// Identifier resolution: scopeTryLookup, with a sandboxed realm's globals.
// Kept this small so it inlines into the evaluator's identifier arms: the
// sandbox half is out of line.
pub fn identTryLookup(prog: &Prog, st: &mut Interp, scope: i64, nameRef: &string): Option<JSValue> {
    if st.sandboxObj < 0 || nameRef == "this" {
        return scopeTryLookup(st, scope, nameRef)
    }
    return sandboxLookup(prog, &mut st, scope, nameRef)
}

fn sandboxLookup(prog: &Prog, st: &mut Interp, scope: i64, nameRef: &string): Option<JSValue> {
    // a copy: the caller's name may point into the AST, which a trap or getter
    // run below can move
    let name = nameRef.clone()
    let at = scopeFindBelowGlobal(st, scope, name)
    if at >= 0 {
        return scopeTryLookup(st, at, name)
    }
    let g = st.globalScope
    let lex = realmLexicalIndex(st, name)
    if lex >= 0 {
        return Option.Some(cloneValue(st.scopes[g].vars[lex].value))
    }
    let sb = st.sandboxObj
    let has = sandboxHas(prog, &mut st, name)
    if st.throwing {
        return Option.Some(JSValue.Undefined)
    }
    if has {
        let v = getMemberDyn(prog, sb, name, &mut st)
        // node answers the global object where the sandbox holds itself, so
        // `ctx.window = ctx` makes `window` and `this` the same object inside
        if objHandle(v) == sb {
            return Option.Some(scopeLookup(st, g, "globalThis"))
        }
        return Option.Some(v)
    }
    return scopeTryLookup(st, g, name)
}

// Identifier assignment: scopeAssign, with a sandboxed realm's globals. A name
// neither the sandbox nor the realm declares is a ReferenceError in strict code
// and a new sandbox property otherwise.
pub fn identAssign(prog: &Prog, st: &mut Interp, scope: i64, nameRef: &string, value: JSValue) {
    if st.sandboxObj < 0 {
        scopeAssign(&mut st, scope, nameRef, value)
        return
    }
    sandboxAssign(prog, &mut st, scope, nameRef, value)
}

fn sandboxAssign(prog: &Prog, st: &mut Interp, scope: i64, nameRef: &string, value: JSValue) {
    let name = nameRef.clone()
    let at = scopeFindBelowGlobal(st, scope, name)
    if at >= 0 {
        scopeAssign(&mut st, at, name, value)
        return
    }
    let g = st.globalScope
    let lex = realmLexicalIndex(st, name)
    if lex >= 0 {
        st.scopes[g].vars[lex].value = value
        return
    }
    let sb = st.sandboxObj
    let bi = scopeOwnIndex(st, g, name)
    if st.strict && bi < 0 {
        let has = sandboxHas(prog, &mut st, name)
        if st.throwing {
            return
        }
        if !has {
            let _ = throwErr(&mut st, "ReferenceError", name.clone() + " is not defined")
            return
        }
    }
    // a declared var keeps its own copy in step, which is what it still reads
    // after `delete` takes the sandbox's
    if bi >= st.builtinGlobals {
        st.scopes[g].vars[bi].value = cloneValue(value)
    }
    setMemberDyn(prog, sb, name, value, &mut st)
}

// `delete name` where the name resolves to the sandbox: the property goes, and
// the answer is false for a declared var, whose binding stays. None when the
// name is not the sandbox's, for the caller's ordinary answer.
pub fn identDelete(prog: &Prog, st: &mut Interp, scope: i64, nameRef: &string): Option<JSValue> {
    if st.sandboxObj < 0 || scopeFindBelowGlobal(st, scope, nameRef) >= 0 || realmLexicalIndex(st, nameRef) >= 0 {
        return Option.None
    }
    let name = nameRef.clone()
    let sb = st.sandboxObj
    let has = sandboxHas(prog, &mut st, name)
    if st.throwing {
        return Option.Some(JSValue.Undefined)
    }
    let declared = isSandboxVar(st, name)
    if has {
        let r = deleteOwnKey(prog, &mut st, sb, name)
        if st.throwing || !declared {
            return Option.Some(r)
        }
    }
    if declared {
        return Option.Some(JSValue.Bool(false))
    }
    return Option.None
}

// Is `scope` a sandboxed realm's global scope? Declarations hoisted there are
// declareSandboxGlobal's.
pub fn isSandboxGlobalScope(st: &Interp, scope: i64): bool {
    return st.sandboxObj >= 0 && scope == st.globalScope
}

// A top-level `var` (fnValue None) or function declaration of code running in a
// sandboxed realm: CreateGlobalVarBinding / CreateGlobalFunctionBinding. Both
// get the realm binding; a function is also defined on the sandbox, with the
// attributes node gives it, replacing whatever is there.
pub fn declareSandboxGlobal(prog: &Prog, st: &mut Interp, nameRef: &string, fnValue: Option<JSValue>) {
    let name = nameRef.clone()
    let g = st.globalScope
    if !isSandboxVar(st, name) {
        st.realms[st.curRealm].sandboxVars.push(name.clone())
    }
    var value = JSValue.Undefined
    match fnValue {
        Option.Some(fv) => {
            value = fv
        }
        Option.None => {
            if scopeOwnIndex(st, g, name) < 0 {
                scopeDefine(&mut st, g, name, JSValue.Undefined)
            }
            return
        }
    }
    scopeDefine(&mut st, g, name.clone(), cloneValue(value))
    let sb = st.sandboxObj
    let d = newObject(&mut st)
    pushTemp(&mut st, JSValue.Obj(d))
    objSet(&mut st, d, "value", cloneValue(value))
    objSet(&mut st, d, "writable", JSValue.Bool(true))
    objSet(&mut st, d, "enumerable", JSValue.Bool(true))
    objSet(&mut st, d, "configurable", JSValue.Bool(true))
    let ok = definePropOf(prog, &mut st, JSValue.Obj(sb), name, d)
    // a non-configurable property of that name refuses the full descriptor;
    // CreateGlobalFunctionBinding then writes the value alone
    if !ok && !st.throwing {
        setMemberDyn(prog, sb, name.clone(), value, &mut st)
    }
    popTemp(&mut st)
}
