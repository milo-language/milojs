// Recursive-descent parser: tokens → AST indices in Prog. Precedence climbs
// primary → postfix → unary → mul → add → rel → eq → and → or → assignment.
// It is deliberately forgiving: malformed input still terminates (unexpected
// tokens are consumed) so a bad script can't hang the parser.

from "./lexer" import {
    T_EOF, T_IDENT, T_UNDEFINED, T_ASYNC, T_AWAIT, T_YIELD, T_LET, T_STR, T_NUM, tokenName, T_SEMI,
    T_RBRACE, T_TEMPLATE_BEGIN, T_TEMPLATE_CHUNK, T_TEMPLATE_END, T_SPREAD, T_LBRACE, T_LPAREN,
    T_LBRACKET, T_RBRACKET, T_RPAREN, T_ARROW, T_COMMA, T_COLON, T_EQ, T_IMPORT, T_BIGINT, T_TRUE,
    T_FALSE, T_NULL, T_SUPER, T_CLASS, T_FUNCTION, T_REGEX, T_NEW, T_DOT, T_STAR, T_OPTCHAIN, T_INC,
    T_DEC, T_MINUS, T_NOT, T_TYPEOF, T_VOID, T_DELETE, T_TILDE, T_PLUS, T_STARSTAR, T_SLASH,
    T_PERCENT, T_SHL, T_SHR, T_USHR, T_LT, T_GT, T_LE, T_GE, T_INSTANCEOF, T_IN, T_EQEQ, T_NEQ,
    T_STRICTEQ, T_STRICTNEQ, T_AMP, T_CARET, T_PIPE, T_ANDAND, T_OROR, T_NULLISH, T_QUESTION,
    T_PLUSEQ, T_MINUSEQ, T_STAREQ, T_SLASHEQ, T_SHLEQ, T_SHREQ, T_USHREQ, T_AMPEQ, T_PIPEEQ,
    T_CARETEQ, T_STARSTAREQ, T_PERCENTEQ, T_ANDANDEQ, T_OROREQ, T_NULLISHEQ, T_VAR, T_CONST, T_DO,
    T_WHILE, T_SWITCH, T_CASE, T_DEFAULT, T_IF, T_ELSE, T_FOR, T_BREAK, T_CONTINUE, T_THROW, T_WITH,
    T_TRY, T_CATCH, T_FINALLY, T_RETURN, T_EXTENDS, T_EXPORT,
    Token
}
from "./ast" import {
    addExpr, Expr, addArrLit, addArgList, DeclItem, addStmt, Stmt, addBlock, FuncDef, addDeclList,
    PropInit, addObjLit, getExpr, SwitchCase, addSwitch, ClassDef, ClassMember,
    ArgListId, ArrLitId, BlockId, ExprId, ObjLitId, Prog, StmtId
}
from "./value" import {
    i64ToStr, numToStr
}

pub struct PState {
    toks: Vec<Token>,
    pos: i64,
    // source path, so a parse error names the module it came from
    file: string,
    // enclosing class name while parsing a class body, so `super(...)` can be
    // rewritten to a call of that class's recorded base constructor
    curClass: string,
    // Every private name in scope, innermost class last, with the class key that
    // declared it. A nested class body can still reach the outer class's `#x`,
    // so mangling `#x` with the innermost class alone was wrong; this is what
    // says which class a given `#x` belongs to.
    privNames: Vec<string>,
    privOwners: Vec<string>,
    // the parser never stops at a bad token, so one mistake cascades into a
    // string of confusing follow-on errors. Only the first is worth showing.
    errored: bool,
    // set when the first error was hitting end-of-input rather than a wrong
    // token — the REPL reads that as "incomplete", not "broken", and asks for
    // another line instead of reporting a syntax error
    eofError: bool,
    // suppress diagnostics entirely; the REPL parses each line once speculatively
    // just to classify it, and that probe must stay silent
    quiet: bool,
    // inside strict code. A strict function called with no receiver keeps `this`
    // undefined instead of taking globalThis, which is the whole reason the flag
    // exists: the spec's own built-in setters rely on that to reject a nullish
    // receiver. Strictness is inherited — a function nested in strict code is
    // strict whether or not it repeats the directive.
    strict: bool,
    // Expression-nesting depth, so `[[[[...]]]]` fails with a parse error rather
    // than a SIGBUS. The descent is not bounded by anything else; measured, this
    // engine bus-errored at about 5330 levels on an 8 MB stack.
    depth: i64,
    // The grammar has a NoIn variant of Expression, used in exactly one place:
    // the initializer of a for-statement head, where a bare `in` belongs to the
    // for-in form rather than to the expression. Without it `for (var k = 2 in o)`
    // parsed `2 in o` as a relational expression and then found `)` where it
    // wanted `;`.
    noIn: bool,
}

// Deepest expression nesting the parser accepts. Set ABOVE node's own limits
// (measured 3621 parsing, 2791 parsing-and-evaluating on the same machine) so
// nothing node accepts is rejected here, and well below where this parser's
// native recursion faults (~5330). The gap is what absorbs a smaller stack
// elsewhere.
let PARSE_DEPTH_LIMIT: i64 = 4000


fn peekKind(p: &PState): i32 {
    if p.pos < p.toks.len() {
        return p.toks[p.pos].kind
    }
    return T_EOF
}

fn advance(p: &mut PState) {
    p.pos = p.pos + 1
}

// Can the current token serve as a property name? Identifiers and any keyword
// (obj.catch / obj.default / obj.function are all legal JS), but not literals.
// Tokens that get their own kind in the lexer but are NOT reserved words: they
// are legal binding names in ordinary (sloppy) script code. `var undefined` is
// the one that mattered — get-intrinsic, a dependency of a large fraction of
// npm, opens with `var undefined;`, and a parse error is fatal, so express-free
// apps died on their first require.
//
// This is only consulted where a NAME is expected (declarator, parameter,
// function name, catch parameter). In expression position `await` and `yield`
// keep their operator meaning, which is the same context rule the spec uses.
fn isBindingName(p: &PState): bool {
    if p.pos >= p.toks.len() {
        return false
    }
    let k = p.toks[p.pos].kind
    return k == T_IDENT || k == T_UNDEFINED || k == T_ASYNC || k == T_AWAIT || k == T_YIELD || k == T_LET
}

fn isBindingNameAt(p: &PState, at: i64): bool {
    if at >= p.toks.len() {
        return false
    }
    let k = p.toks[at].kind
    return k == T_IDENT || k == T_UNDEFINED || k == T_ASYNC || k == T_AWAIT || k == T_YIELD || k == T_LET
}

fn isPropName(p: &PState): bool {
    if p.pos >= p.toks.len() {
        return false
    }
    let k = p.toks[p.pos].kind
    if k == T_STR || k == T_NUM {
        return false
    }
    return p.toks[p.pos].text.len() > 0
}

// Human-readable text for a token, for diagnostics.
fn tokenDesc(p: &PState, i: i64): string {
    if i < 0 || i >= p.toks.len() {
        return "end of input"
    }
    if p.toks[i].text.len() > 0 {
        return "'" + p.toks[i].text.clone() + "'"
    }
    return tokenName(p.toks[i].kind)
}

// The offending token with a couple on each side, so an error points at
// recognisable source text rather than a bare token index.
// A wide window matters more than a line number: the files this fails on are
// minified into a few enormous lines, so "line 3" locates nothing. Twelve tokens
// either side is usually enough to grep the construct out of the bundle.
fn tokenContext(p: &PState): string {
    var out = ""
    var i = p.pos - 12
    while i <= p.pos + 12 {
        if i >= 0 && i < p.toks.len() {
            if i == p.pos {
                out = out + " >>" + tokenDesc(p, i) + "<<"
            } else {
                out = out + " " + tokenDesc(p, i)
            }
        }
        i = i + 1
    }
    return out
}

// Consume `kind` if present; parser is forgiving (bad input still terminates).
// Only the first mismatch of a parse is reported: with no error recovery, every
// later `expect` is reacting to the same original mistake.
fn expect(p: &mut PState, kind: i32) {
    if peekKind(p) == kind {
        advance(&mut p)
        return
    }
    if p.errored {
        return
    }
    p.errored = true
    if peekKind(p) == T_EOF {
        p.eofError = true
    }
    if !p.quiet {
        eprint("milojs: " + p.file + ": expected " + tokenName(kind) + ", found " + tokenDesc(p, p.pos) + "\n  " + tokenContext(p))
    }
}

// Is the parser at a point where a statement may legally end? JS accepts an
// explicit `;`, the `}` closing the enclosing block, end of input, or a line
// break before the next token (automatic semicolon insertion). Anything else
// means the statement ran into a token that does not belong to it.
fn atStatementEnd(p: &PState): bool {
    let k = peekKind(p)
    if k == T_SEMI || k == T_RBRACE || k == T_EOF {
        return true
    }
    if p.pos < p.toks.len() {
        return p.toks[p.pos].nlBefore
    }
    return true
}

// Report a token that has no business continuing the current statement.
fn expectStatementEnd(p: &mut PState) {
    if atStatementEnd(p) {
        return
    }
    if p.errored {
        return
    }
    p.errored = true
    if !p.quiet {
        eprint("milojs: " + p.file + ": unexpected " + tokenDesc(p, p.pos) + " after declaration\n  " + tokenContext(p))
    }
}

// A template literal desugars to string concatenation, starting from a string
// chunk so the whole chain coerces to string: `a${x}b` → "a" + x + "b".
fn parseTemplate(p: &mut PState, prog: &mut Prog): ExprId {
    expect(&mut p, T_TEMPLATE_BEGIN)
    var first = ""
    if peekKind(p) == T_TEMPLATE_CHUNK {
        first = p.toks[p.pos].text.clone()
        advance(&mut p)
    }
    var result = addExpr(&mut prog, Expr.StrLit(first))
    while peekKind(p) != T_TEMPLATE_END && peekKind(p) != T_EOF {
        // A substitution takes a full Expression, comma operator included:
        // `${a, b}` evaluates a then yields b. parseExpr stops at a comma (see
        // parseCommaSeq), so using it here made the `,` look like the start of a
        // second hole and the template failed to parse.
        let e = parseCommaSeq(&mut p, &mut prog)
        // NOT a bare `+`: a hole converts with the string hint (see ToStrHole)
        let hole = addExpr(&mut prog, Expr.ToStrHole(e))
        result = addExpr(&mut prog, Expr.Bin("+", result, hole))
        if peekKind(p) == T_TEMPLATE_CHUNK {
            let chunk = p.toks[p.pos].text.clone()
            advance(&mut p)
            let cs = addExpr(&mut prog, Expr.StrLit(chunk))
            result = addExpr(&mut prog, Expr.Bin("+", result, cs))
        }
    }
    if peekKind(p) == T_TEMPLATE_END {
        advance(&mut p)
    }
    return result
}

// `tag`a${x}b`` calls tag(["a","b"], x). The strings array is built as an array
// literal and the hole expressions become the remaining arguments. A parallel
// list of the same chunks un-escaped becomes the array's `raw`.
fn parseTaggedTemplate(p: &mut PState, prog: &mut Prog, tagExpr: ExprId): ExprId {
    expect(&mut p, T_TEMPLATE_BEGIN)
    var chunks: Vec<Option<ExprId>> = Vec.new()
    var raws: Vec<Option<ExprId>> = Vec.new()
    var holes: Vec<ExprId> = Vec.new()
    if peekKind(p) == T_TEMPLATE_CHUNK {
        let chunk = p.toks[p.pos].text.clone()
        let rawChunk = p.toks[p.pos].raw.clone()
        advance(&mut p)
        chunks.push(Option.Some(addExpr(&mut prog, Expr.StrLit(chunk))))
        raws.push(Option.Some(addExpr(&mut prog, Expr.StrLit(rawChunk))))
    } else {
        chunks.push(Option.Some(addExpr(&mut prog, Expr.StrLit(""))))
        raws.push(Option.Some(addExpr(&mut prog, Expr.StrLit(""))))
    }
    while peekKind(p) != T_TEMPLATE_END && peekKind(p) != T_EOF {
        holes.push(parseExpr(&mut p, &mut prog))
        if peekKind(p) == T_TEMPLATE_CHUNK {
            let chunk = p.toks[p.pos].text.clone()
            let rawChunk = p.toks[p.pos].raw.clone()
            advance(&mut p)
            chunks.push(Option.Some(addExpr(&mut prog, Expr.StrLit(chunk))))
            raws.push(Option.Some(addExpr(&mut prog, Expr.StrLit(rawChunk))))
        } else {
            chunks.push(Option.Some(addExpr(&mut prog, Expr.StrLit(""))))
            raws.push(Option.Some(addExpr(&mut prog, Expr.StrLit(""))))
        }
    }
    if peekKind(p) == T_TEMPLATE_END {
        advance(&mut p)
    }
    let chunksId = addArrLit(&mut prog, chunks)
    let rawsId = addArrLit(&mut prog, raws)
    let stringsArr = addExpr(&mut prog, Expr.TemplateStrings(chunksId, rawsId))
    var args: Vec<ExprId> = Vec.new()
    args.push(stringsArr)
    var h: i64 = 0
    while h < holes.len() {
        args.push(holes[h])
        h = h + 1
    }
    let argsId = addArgList(&mut prog, args)
    return addExpr(&mut prog, Expr.Call(tagExpr, argsId))
}

// One call-argument or array element, possibly a `...spread`.
fn parseArg(p: &mut PState, prog: &mut Prog): ExprId {
    if peekKind(p) == T_SPREAD {
        advance(&mut p)
        let e = parseExpr(&mut p, &mut prog)
        return addExpr(&mut prog, Expr.Spread(e))
    }
    return parseExpr(&mut p, &mut prog)
}

// Build an arrow function from its parameter list; the caller has consumed `=>`.
// Body is a block `{ }` or a single expression (implicit return). isArrow=true so
// it doesn't bind its own `this`.
fn makeArrow(p: &mut PState, prog: &mut Prog, params: Vec<string>, isAsync: bool, prelude: Vec<DeclItem>, mkRestFrom: i64, startAt: i64): ExprId {
    let aSaved = p.strict
    if bodyIsStrict(p) {
        p.strict = true
    }
    var body: Option<BlockId> = Option.None
    if peekKind(p) == T_LBRACE {
        body = Option.Some(parseBraceBlock(&mut p, &mut prog))
    } else {
        let e = parseExpr(&mut p, &mut prog)
        let ret = addStmt(&mut prog, Stmt.Ret(e))
        var list: Vec<StmtId> = Vec.new()
        list.push(ret)
        body = Option.Some(addBlock(&mut prog, list))
    }
    if prelude.len() > 0 {
        let unpack = declsToStmt(&mut prog, prelude)
        prependStmt(&mut prog, body!, unpack)
    }
    prog.funcs.push(FuncDef {
        name: "", params: params, body: body!, paramPrelude: Option.None, isArrow: true, isAsync: isAsync, restFrom: mkRestFrom, isGenerator: false, isStrict: p.strict, isMethod: false, isClassCtor: false, srcStart: startAt, srcEnd: p.toks[p.pos - 1].end, file: p.file.clone()
    }
    )
    p.strict = aSaved
    let f = prog.funcs.len() - 1
    return addExpr(&mut prog, Expr.FuncExpr(f))
}

// Try to read `( id, id, ... ) =>` starting at a '('. On success, consumes
// through `=>` and returns true with params in `out`. On failure, restores the
// position so the caller can parse a normal parenthesized expression.
fn looksLikeArrow(p: &PState): bool {
    // token-only scan to the matching ')' — a real parse would allocate AST
    // nodes that a rollback couldn't reclaim
    var i = p.pos + 1
    var depth: i64 = 0
    while i < p.toks.len() {
        let k = p.toks[i].kind
        if k == T_LPAREN || k == T_LBRACKET || k == T_LBRACE {
            depth = depth + 1
        } else if k == T_RBRACKET || k == T_RBRACE {
            depth = depth - 1
        } else if k == T_RPAREN {
            if depth == 0 {
                return i + 1 < p.toks.len() && p.toks[i + 1].kind == T_ARROW
            }
            depth = depth - 1
        }
        i = i + 1
    }
    return false
}

// Consume `( params ) =>`, which looksLikeArrow has already confirmed.
fn parseArrowHead(p: &mut PState, prog: &mut Prog, params: &mut Vec<string>, prelude: &mut Vec<DeclItem>): i64 {
    var rest: i64 = -1
    expect(&mut p, T_LPAREN)
    while peekKind(p) != T_RPAREN && peekKind(p) != T_EOF {
        if parseParam(&mut p, &mut prog, &mut params, &mut prelude) {
            rest = params.len() - 1
        }
        if peekKind(p) == T_COMMA {
            advance(&mut p)
        }
    }
    expect(&mut p, T_RPAREN)
    expect(&mut p, T_ARROW)
    return rest
}

// `x = <default>` in a pattern: JS only substitutes on undefined. This compares
// loosely, so an explicit null also takes the default — a small deviation.
// A pattern default applies ONLY to undefined. `==` also matches null, so
// `const [a = 7] = [null]` bound 7 where the spec binds null — a silent wrong
// value, not an error.
fn withDefault(prog: &mut Prog, valExpr: ExprId, dflt: ExprId): ExprId {
    let undef = addExpr(&mut prog, Expr.UndefLit)
    let cond = addExpr(&mut prog, Expr.Bin("===", valExpr, undef))
    return addExpr(&mut prog, Expr.Cond(cond, dflt, valExpr))
}

// Destructuring is desugared at parse time into a flat list of declarators that
// read out of `srcName`. Nested patterns bind an intermediate temp and recurse;
// the temp name is keyed on token position so it can't collide.
fn patternDecls(p: &mut PState, prog: &mut Prog, srcName: string, out: &mut Vec<DeclItem>) {
    if peekKind(p) == T_LBRACE {
        advance(&mut p)
        // An EMPTY object pattern still performs RequireObjectCoercible on its
        // source, and it binds nothing — so there is no member read to raise the
        // TypeError that `const {} = null` owes. Emit the check explicitly for
        // that case only; a pattern with at least one key throws on its first
        // read, and paying for a call on every destructure would be waste.
        let startLen = out.len()
        var seenKeys: Vec<string> = Vec.new()
        while peekKind(p) != T_RBRACE && peekKind(p) != T_EOF {
            // { a, ...rest } — rest takes every own key not already bound
            if peekKind(p) == T_SPREAD {
                advance(&mut p)
                let restName = p.toks[p.pos].text.clone()
                advance(&mut p)
                let srcIdx = addExpr(&mut prog, Expr.Ident(srcName.clone()))
                var keyEls: Vec<Option<ExprId>> = Vec.new()
                var ki: i64 = 0
                while ki < seenKeys.len() {
                    keyEls.push(Option.Some(addExpr(&mut prog, Expr.StrLit(seenKeys[ki].clone()))))
                    ki = ki + 1
                }
                let keyElsId = addArrLit(&mut prog, keyEls)
                let keysArr = addExpr(&mut prog, Expr.ArrLit(keyElsId))
                var restArgs: Vec<ExprId> = Vec.new()
                restArgs.push(srcIdx)
                restArgs.push(keysArr)
                let restArgsId = addArgList(&mut prog, restArgs)
                let callee = addExpr(&mut prog, Expr.Ident("__objRest"))
                out.push(DeclItem {
                    name: restName, init: addExpr(&mut prog, Expr.Call(callee, restArgsId)), isVar: false
                }
                )
                if peekKind(p) == T_COMMA {
                    advance(&mut p)
                }
            } else {
                var key = ""
                if isPropName(p) || peekKind(p) == T_STR {
                    key = p.toks[p.pos].text.clone()
                }
                seenKeys.push(key.clone())
                advance(&mut p)
                let srcIdx = addExpr(&mut prog, Expr.Ident(srcName.clone()))
                var valExpr = addExpr(&mut prog, Expr.Member(srcIdx, key.clone()))
                var target = key.clone()
                var nested = false
                if peekKind(p) == T_COLON {
                    advance(&mut p)
                    if peekKind(p) == T_LBRACE || peekKind(p) == T_LBRACKET {
                        nested = true
                        let tmp = "__d" + i64ToStr(p.pos)
                        // the sub-pattern's declarators are gathered separately
                        // so a default on the sub-pattern itself
                        // (`{b: {c} = {c: 2}}`) can be applied to the temp
                        // before the unpacking reads it — the `=` only appears
                        // after the closing brace this recursion consumes
                        var inner: Vec<DeclItem> = Vec.new()
                        patternDecls(&mut p, &mut prog, tmp.clone(), &mut inner)
                        var initExpr = valExpr
                        if peekKind(p) == T_EQ {
                            advance(&mut p)
                            let dflt = parseExpr(&mut p, &mut prog)
                            initExpr = withDefault(&mut prog, initExpr, dflt)
                        }
                        out.push(DeclItem {
                            name: tmp.clone(), init: initExpr, isVar: false
                        }
                        )
                        var di: i64 = 0
                        while di < inner.len() {
                            out.push(DeclItem {
                                name: inner[di].name.clone(), init: inner[di].init, isVar: inner[di].isVar
                            }
                            )
                            di = di + 1
                        }
                    } else {
                        target = p.toks[p.pos].text.clone()
                        advance(&mut p)
                    }
                }
                if !nested {
                    if peekKind(p) == T_EQ {
                        advance(&mut p)
                        let dflt = parseExpr(&mut p, &mut prog)
                        // an ANONYMOUS default takes the binding's name:
                        // `const { a = () => {} } = {}` gives a.name === "a"
                        inferFuncName(&mut prog, dflt, target)
                        valExpr = withDefault(&mut prog, valExpr, dflt)
                    }
                    out.push(DeclItem {
                        name: target, init: valExpr, isVar: false
                    }
                    )
                }
                if peekKind(p) == T_COMMA {
                    advance(&mut p)
                }
            }
        }
        expect(&mut p, T_RBRACE)
        if out.len() == startLen {
            var rqArgs: Vec<ExprId> = Vec.new()
            rqArgs.push(addExpr(&mut prog, Expr.Ident(srcName.clone())))
            let rqArgsId = addArgList(&mut prog, rqArgs)
            let rqCallee = addExpr(&mut prog, Expr.Ident("__reqObj"))
            out.push(DeclItem {
                name: "__rq" + i64ToStr(p.pos), init: addExpr(&mut prog, Expr.Call(rqCallee, rqArgsId)), isVar: false
            }
            )
        }
        return
    }
    // An array pattern must STEP the iterator, once per element, and close it
    // when the pattern is shorter than the sequence. The old desugaring bound a
    // temp to `[...src]` and indexed that, which drains the iterator completely
    // and never calls return() — so early exit was unobservable and a next()
    // that threw on element 3 surfaced even when the pattern only wanted 2.
    let readName = srcName.clone() + "$it"
    var items: Vec<DeclItem> = Vec.new()
    var sawRest = false
    expect(&mut p, T_LBRACKET)
    var i: i64 = 0
    while peekKind(p) != T_RBRACKET && peekKind(p) != T_EOF {
        if peekKind(p) == T_COMMA {
            // elision: [, x] skips a slot
            advance(&mut p)
            i = i + 1
        } else if peekKind(p) == T_SPREAD {
            // [a, ...rest] — rest is everything from this position on
            sawRest = true
            advance(&mut p)
            let srcIdx = addExpr(&mut prog, Expr.Ident(readName.clone()))
            var sliceArgs: Vec<ExprId> = Vec.new()
            sliceArgs.push(addExpr(&mut prog, Expr.Num(i as f64)))
            let sliceArgsId = addArgList(&mut prog, sliceArgs)
            let callee = addExpr(&mut prog, Expr.Member(srcIdx, "slice"))
            let restInit = addExpr(&mut prog, Expr.Call(callee, sliceArgsId))
            // The rest target is a BindingPattern, not only an identifier:
            // `[...[a, b]]` and `[...{length}]` bind out of the array the rest
            // collected. Reading a bare token here treated `{length}` as the
            // binding NAME, so the length of the rest array was never observed.
            if peekKind(p) == T_LBRACE || peekKind(p) == T_LBRACKET {
                let tmp = "__d" + i64ToStr(p.pos)
                var inner: Vec<DeclItem> = Vec.new()
                patternDecls(&mut p, &mut prog, tmp.clone(), &mut inner)
                items.push(DeclItem {
                    name: tmp.clone(), init: restInit, isVar: false
                }
                )
                var ri: i64 = 0
                while ri < inner.len() {
                    items.push(DeclItem {
                        name: inner[ri].name.clone(), init: inner[ri].init, isVar: inner[ri].isVar
                    }
                    )
                    ri = ri + 1
                }
            } else {
                let restName = p.toks[p.pos].text.clone()
                advance(&mut p)
                items.push(DeclItem {
                    name: restName, init: restInit, isVar: false
                }
                )
            }
            if peekKind(p) == T_COMMA {
                advance(&mut p)
            }
        } else {
            let srcIdx = addExpr(&mut prog, Expr.Ident(readName.clone()))
            let idxE = addExpr(&mut prog, Expr.Num(i as f64))
            var valExpr = addExpr(&mut prog, Expr.Index(srcIdx, idxE))
            if peekKind(p) == T_LBRACE || peekKind(p) == T_LBRACKET {
                let tmp = "__d" + i64ToStr(p.pos)
                // same two-phase split as the object case: `[[x] = [9]]` puts the
                // default after the sub-pattern's closing bracket
                var inner: Vec<DeclItem> = Vec.new()
                patternDecls(&mut p, &mut prog, tmp.clone(), &mut inner)
                var initExpr = valExpr
                if peekKind(p) == T_EQ {
                    advance(&mut p)
                    let dflt = parseExpr(&mut p, &mut prog)
                    initExpr = withDefault(&mut prog, initExpr, dflt)
                }
                items.push(DeclItem {
                    name: tmp.clone(), init: initExpr, isVar: false
                }
                )
                var di: i64 = 0
                while di < inner.len() {
                    items.push(DeclItem {
                        name: inner[di].name.clone(), init: inner[di].init, isVar: inner[di].isVar
                    }
                    )
                    di = di + 1
                }
            } else {
                let name = p.toks[p.pos].text.clone()
                advance(&mut p)
                if peekKind(p) == T_EQ {
                    advance(&mut p)
                    let dflt = parseExpr(&mut p, &mut prog)
                    inferFuncName(&mut prog, dflt, name)
                    valExpr = withDefault(&mut prog, valExpr, dflt)
                }
                items.push(DeclItem {
                    name: name, init: valExpr, isVar: false
                }
                )
            }
            i = i + 1
            if peekKind(p) == T_COMMA {
                advance(&mut p)
            }
        }
    }
    expect(&mut p, T_RBRACKET)
    // the stepping binding must come BEFORE the element reads it feeds
    var stepArgs: Vec<ExprId> = Vec.new()
    stepArgs.push(addExpr(&mut prog, Expr.Ident(srcName.clone())))
    stepArgs.push(addExpr(&mut prog, Expr.Num(i as f64)))
    stepArgs.push(addExpr(&mut prog, Expr.BoolLit(sawRest)))
    let stepArgsId = addArgList(&mut prog, stepArgs)
    let stepCallee = addExpr(&mut prog, Expr.Ident("__iterSteps"))
    out.push(DeclItem {
        name: readName.clone(), init: addExpr(&mut prog, Expr.Call(stepCallee, stepArgsId)), isVar: false
    }
    )
    var ii: i64 = 0
    while ii < items.len() {
        out.push(DeclItem {
            name: items[ii].name.clone(), init: items[ii].init, isVar: items[ii].isVar
        }
        )
        ii = ii + 1
    }
}

// Parse one parameter. A destructuring pattern becomes a synthetic parameter
// name plus declarators that unpack it at the top of the body.
fn parseParam(p: &mut PState, prog: &mut Prog, params: &mut Vec<string>, prelude: &mut Vec<DeclItem>): bool {
    if peekKind(p) == T_LBRACE || peekKind(p) == T_LBRACKET {
        let tmp = "__a" + i64ToStr(p.pos)
        params.push(tmp.clone())
        // the pattern's decls are gathered separately so a default on the
        // WHOLE pattern (`function f({a, ...r} = {}, n)`) can be spliced in
        // ahead of them — it has to run before the unpacking reads the temp.
        // Leaving the `= {}` unparsed also swallowed the following parameter,
        // so `n` arrived undefined.
        var inner: Vec<DeclItem> = Vec.new()
        patternDecls(&mut p, &mut prog, tmp.clone(), &mut inner)
        if peekKind(p) == T_EQ {
            advance(&mut p)
            let dflt = parseExpr(&mut p, &mut prog)
            let src = addExpr(&mut prog, Expr.Ident(tmp.clone()))
            prelude.push(DeclItem {
                name: tmp.clone(), init: withDefault(&mut prog, src, dflt), isVar: false
            }
            )
        }
        var di: i64 = 0
        while di < inner.len() {
            prelude.push(DeclItem {
                name: inner[di].name.clone(), init: inner[di].init, isVar: inner[di].isVar
            }
            )
            di = di + 1
        }
        return false
    }
    var isRest = false
    if peekKind(p) == T_SPREAD {
        advance(&mut p)
        isRest = true
    }
    if isBindingName(p) {
        let name = p.toks[p.pos].text.clone()
        advance(&mut p)
        if peekKind(p) == T_EQ {
            advance(&mut p)
            let dflt = parseExpr(&mut p, &mut prog)
            // a PARAMETER default infers the parameter's name too
            inferFuncName(&mut prog, dflt, name)
            let src = addExpr(&mut prog, Expr.Ident(name.clone()))
            prelude.push(DeclItem {
                name: name.clone(), init: withDefault(&mut prog, src, dflt), isVar: false
            }
            )
        }
        params.push(name)
        return isRest
    }
    advance(&mut p)
    return false
}

// `a = 1, b = 2` in a for-init or for-update. parseExpr deliberately stops at a
// comma (declarator lists need that), so sequences are stitched up here.
fn parseCommaSeq(p: &mut PState, prog: &mut Prog): ExprId {
    var e = parseExpr(&mut p, &mut prog)
    while peekKind(p) == T_COMMA {
        advance(&mut p)
        let right = parseExpr(&mut p, &mut prog)
        e = addExpr(&mut prog, Expr.Comma(e, right))
    }
    return e
}

fn isPatternStart(p: &PState): bool {
    let k = peekKind(p)
    return k == T_LBRACE || k == T_LBRACKET
}

// Wrap desugared declarators into one statement.
fn declsToStmt(prog: &mut Prog, items: Vec<DeclItem>): StmtId {
    let declarationsId = addDeclList(&mut prog, items)
    return addStmt(&mut prog, Stmt.MultiDecl(declarationsId))
}

// Put a statement at the front of an already-parsed block (used to unpack
// destructured parameters and for-of bindings before the body runs).
fn prependStmt(prog: &mut Prog, blockId: BlockId, stmtIdx: StmtId) {
    var merged: Vec<StmtId> = Vec.new()
    merged.push(stmtIdx)
    var i: i64 = 0
    while i < prog.blocks[blockId.index].len() {
        merged.push(prog.blocks[blockId.index][i])
        i = i + 1
    }
    prog.blocks[blockId.index] = merged
}

fn parsePrimary(p: &mut PState, prog: &mut Prog): ExprId {
    let k = peekKind(p)
    // where an arrow would begin if this turns out to be one: at the parameter
    // list, or at `async` for an async arrow. Captured before any of the arrow
    // shapes below consume anything.
    let arrowStart = p.toks[p.pos].at
    // dynamic import("m") → ImportCall(Promise.resolve(require("m"))). The module
    // graph is
    // discovered and parsed before anything runs, so the load itself is already
    // done by this point and the only thing left is to hand it back as a
    // promise. A computed specifier therefore fails the same way a computed
    // require does — see modules.milo.
    if k == T_IMPORT && p.pos + 1 < p.toks.len() && p.toks[p.pos + 1].kind == T_LPAREN {
        advance(&mut p)
        advance(&mut p)
        let spec = parseExpr(&mut p, &mut prog)
        // import(spec, options,): __importOptions in the prelude applies the
        // spec's checks (an object, whose `with` is an object) and the result is
        // dropped, since the loader has no import attributes to hand it to; a
        // trailing comma is allowed after either.
        var options: i64 = -1
        if peekKind(p) == T_COMMA {
            advance(&mut p)
            if peekKind(p) != T_RPAREN {
                options = parseExpr(&mut p, &mut prog).index
                if peekKind(p) == T_COMMA {
                    advance(&mut p)
                }
            }
        }
        if peekKind(p) == T_RPAREN {
            advance(&mut p)
        }
        // ToString(specifier) with the string hint, synchronously, so an object
        // specifier's toString runs and a symbol rejects; require alone would
        // have asked for "[object Object]".
        let specCallee = addExpr(&mut prog, Expr.Ident("__importSpec"))
        var specArgs: Vec<ExprId> = Vec.new()
        specArgs.push(spec)
        let specStr = addExpr(&mut prog, Expr.Call(specCallee, addArgList(&mut prog, specArgs)))
        let reqCallee = addExpr(&mut prog, Expr.Ident("require"))
        var reqArgs: Vec<ExprId> = Vec.new()
        reqArgs.push(specStr)
        let loaded = addExpr(&mut prog, Expr.Call(reqCallee, addArgList(&mut prog, reqArgs)))
        let promise = addExpr(&mut prog, Expr.Ident("Promise"))
        let resolve = addExpr(&mut prog, Expr.Member(promise, "resolve"))
        var pArgs: Vec<ExprId> = Vec.new()
        pArgs.push(loaded)
        let resolved = addExpr(&mut prog, Expr.Call(resolve, addArgList(&mut prog, pArgs)))
        // one microtask hop: node's loader settles a successful import() later
        // than a rejection from argument validation, and fixtures pin that order.
        // The load itself is still synchronous, so specifier evaluation and any
        // ToString side effect happen where the spec puts them.
        let thenFn = addExpr(&mut prog, Expr.Member(resolved, "then"))
        var thenArgs: Vec<ExprId> = Vec.new()
        thenArgs.push(addExpr(&mut prog, Expr.Ident("__importSettle")))
        var call = addExpr(&mut prog, Expr.Call(thenFn, addArgList(&mut prog, thenArgs)))
        if options >= 0 {
            let checkCallee = addExpr(&mut prog, Expr.Ident("__importOptions"))
            var checkArgs: Vec<ExprId> = Vec.new()
            checkArgs.push(ExprId { index: options })
            let check = addExpr(&mut prog, Expr.Call(checkCallee, addArgList(&mut prog, checkArgs)))
            call = addExpr(&mut prog, Expr.Comma(check, call))
        }
        return addExpr(&mut prog, Expr.ImportCall(call))
    }
    if k == T_NUM {
        let v = p.toks[p.pos].num
        advance(&mut p)
        return addExpr(&mut prog, Expr.Num(v))
    }
    if k == T_BIGINT {
        let s = p.toks[p.pos].text.clone()
        advance(&mut p)
        return addExpr(&mut prog, Expr.BigIntLit(s))
    }
    if k == T_STR {
        let s = p.toks[p.pos].text.clone()
        advance(&mut p)
        return addExpr(&mut prog, Expr.StrLit(s))
    }
    if k == T_TRUE {
        advance(&mut p)
        return addExpr(&mut prog, Expr.BoolLit(true))
    }
    if k == T_FALSE {
        advance(&mut p)
        return addExpr(&mut prog, Expr.BoolLit(false))
    }
    if k == T_NULL {
        advance(&mut p)
        return addExpr(&mut prog, Expr.NullLit)
    }
    if k == T_UNDEFINED {
        advance(&mut p)
        return addExpr(&mut prog, Expr.UndefLit)
    }
    if k == T_IDENT {
        let name = p.toks[p.pos].text.clone()
        // single-parameter arrow: x => body
        if p.pos + 1 < p.toks.len() && p.toks[p.pos + 1].kind == T_ARROW {
            advance(&mut p)
            advance(&mut p)
            var ap: Vec<string> = Vec.new()
            ap.push(name)
            var noPrelude: Vec<DeclItem> = Vec.new()
            return makeArrow(&mut p, &mut prog, ap, false, noPrelude, -1, arrowStart)
        }
        advance(&mut p)
        // `#x in o` — the only place a private name appears as a bare primary
        return addExpr(&mut prog, Expr.Ident(privName(p, name)))
    }
    if k == T_LPAREN {
        if looksLikeArrow(p) {
            var arrowParams: Vec<string> = Vec.new()
            var arrowPrelude: Vec<DeclItem> = Vec.new()
            let arrowRest = parseArrowHead(&mut p, &mut prog, &mut arrowParams, &mut arrowPrelude)
            return makeArrow(&mut p, &mut prog, arrowParams, false, arrowPrelude, arrowRest, arrowStart)
        }
        advance(&mut p)
        var e = parseExpr(&mut p, &mut prog)
        // comma/sequence operator inside parens: (a, b) yields b
        while peekKind(p) == T_COMMA {
            advance(&mut p)
            let right = parseExpr(&mut p, &mut prog)
            e = addExpr(&mut prog, Expr.Comma(e, right))
        }
        expect(&mut p, T_RPAREN)
        return e
    }
    if k == T_SUPER {
        advance(&mut p)
        return addExpr(&mut prog, Expr.Ident("__super$" + p.curClass))
    }
    if k == T_CLASS {
        // class expression: `const C = class { ... }`
        let c = parseClass(&mut p, &mut prog)
        return addExpr(&mut prog, Expr.ClassExpr(c))
    }
    if k == T_FUNCTION {
        let f = parseFunction(&mut p, &mut prog, false)
        return addExpr(&mut prog, Expr.FuncExpr(f))
    }
    if k == T_ASYNC && p.pos + 1 < p.toks.len() {
        let nk = p.toks[p.pos + 1].kind
        if nk == T_FUNCTION {
            advance(&mut p)
            let f = parseFunction(&mut p, &mut prog, true)
            return addExpr(&mut prog, Expr.FuncExpr(f))
        }
        if nk == T_IDENT && p.pos + 2 < p.toks.len() && p.toks[p.pos + 2].kind == T_ARROW {
            advance(&mut p)
            let pname = p.toks[p.pos].text.clone()
            advance(&mut p)
            advance(&mut p)
            var ap1: Vec<string> = Vec.new()
            ap1.push(pname)
            var noPrelude1: Vec<DeclItem> = Vec.new()
            return makeArrow(&mut p, &mut prog, ap1, true, noPrelude1, -1, arrowStart)
        }
        if nk == T_LPAREN {
            advance(&mut p)
            if looksLikeArrow(p) {
                var aparams: Vec<string> = Vec.new()
                var aprelude: Vec<DeclItem> = Vec.new()
                let arest = parseArrowHead(&mut p, &mut prog, &mut aparams, &mut aprelude)
                return makeArrow(&mut p, &mut prog, aparams, true, aprelude, arest, arrowStart)
            }
            // not an arrow after all — `async` was a plain identifier call
            p.pos = p.pos - 1
        }
    }
    if k == T_LBRACE {
        return parseObjectLiteral(&mut p, &mut prog)
    }
    if k == T_LBRACKET {
        return parseArrayLiteral(&mut p, &mut prog)
    }
    if k == T_TEMPLATE_BEGIN {
        return parseTemplate(&mut p, &mut prog)
    }
    if k == T_REGEX {
        // token text is "pattern\nflags"
        let raw = p.toks[p.pos].text.clone()
        advance(&mut p)
        var cut = raw.len()
        var i: i64 = 0
        var found = false
        while i < raw.len() && !found {
            if raw[i] == 10 as u8 {
                cut = i
                found = true
            }
            i = i + 1
        }
        var pat = String.withCapacity(cut)
        var j: i64 = 0
        while j < cut {
            pat.push(raw[j])
            j = j + 1
        }
        var flags = String.withCapacity(4)
        var f = cut + 1
        while f < raw.len() {
            flags.push(raw[f])
            f = f + 1
        }
        return addExpr(&mut prog, Expr.RegexLit(pat, flags))
    }
    if k == T_NEW && p.pos + 2 < p.toks.len() && p.toks[p.pos + 1].kind == T_DOT {
        // new.target — the constructor an invocation was made with, or undefined
        advance(&mut p)
        advance(&mut p)
        if peekKind(p) == T_IDENT {
            advance(&mut p)
        }
        return addExpr(&mut prog, Expr.Ident("new.target"))
    }
    if k == T_NEW {
        return parseNew(&mut p, &mut prog)
    }
    // `async`, `let`, `await` and `yield` are contextual keywords with their own
    // token kinds. Where their operator form does not apply, they are ordinary
    // identifier references: `typeof async`, `let + 1`. This used to fall into
    // the silent-undefined case below, which happened to answer correctly for
    // `typeof async` and wrongly for everything else.
    if k == T_ASYNC || k == T_LET || k == T_AWAIT || k == T_YIELD {
        let nm = p.toks[p.pos].text.clone()
        advance(&mut p)
        return addExpr(&mut prog, Expr.Ident(nm))
    }
    // A token that cannot start an expression. This used to be swallowed
    // silently and answered `undefined`, which is why the parser ACCEPTED input
    // that is not a program: `var =`, `1 +`, `}` and `()=>` all ran off the end
    // here, and `atStatementEnd` then treats EOF as a legal statement end. The
    // token is still consumed so parsing makes progress and recovery reports as
    // much as it can, but the parse is now marked failed.
    if !p.errored {
        p.errored = true
        if k == T_EOF {
            p.eofError = true
        }
        if !p.quiet {
            eprint("milojs: " + p.file + ": expected an expression, found " + tokenDesc(p, p.pos) + "\n  " + tokenContext(p))
        }
    }
    if k != T_EOF {
        advance(&mut p)
    }
    return addExpr(&mut prog, Expr.UndefLit)
}

// new Ctor(args) — the constructor may be a member chain (new a.b.C()). The arg
// list is parsed here; a following postfix chain (new C().x) is left to the caller.
fn parseNew(p: &mut PState, prog: &mut Prog): ExprId {
    expect(&mut p, T_NEW)
    var callee = parsePrimary(&mut p, &mut prog)
    // `new` takes a whole MemberExpression as its callee, which means BOTH
    // access forms. Only `.name` was accepted, so `new g[name]()` parsed as
    // `new g` and reported "value is not a constructor" against the container
    // rather than constructing what the key names. Indexing a table of
    // constructors is how which-typed-array, and anything else that iterates a
    // list of global names, builds its instances.
    while peekKind(p) == T_DOT || peekKind(p) == T_LBRACKET {
        if peekKind(p) == T_DOT {
            advance(&mut p)
            var name = ""
            if peekKind(p) == T_IDENT {
                name = p.toks[p.pos].text.clone()
                advance(&mut p)
            }
            callee = addExpr(&mut prog, Expr.Member(callee, name))
        } else {
            advance(&mut p)
            // see parsePostfix: a computed key takes a full Expression
            let key = parseCommaSeq(&mut p, &mut prog)
            expect(&mut p, T_RBRACKET)
            callee = addExpr(&mut prog, Expr.Index(callee, key))
        }
    }
    var argIdxs: Vec<ExprId> = Vec.new()
    if peekKind(p) == T_LPAREN {
        advance(&mut p)
        if peekKind(p) != T_RPAREN {
            argIdxs.push(parseArg(&mut p, &mut prog))
            while peekKind(p) == T_COMMA {
                advance(&mut p)
                // a trailing comma before `)` is legal (ES2017) and every
                // formatter emits one on a multi-line call, so this was a parse
                // error on ordinary prettier-formatted source
                if peekKind(p) == T_RPAREN {
                    break
                }
                argIdxs.push(parseArg(&mut p, &mut prog))
            }
        }
        expect(&mut p, T_RPAREN)
    }
    let listId = addArgList(&mut prog, argIdxs)
    return addExpr(&mut prog, Expr.New(callee, listId))
}

// [ expr, expr, ... ] — element expressions, trailing comma tolerated
fn parseArrayLiteral(p: &mut PState, prog: &mut Prog): ExprId {
    expect(&mut p, T_LBRACKET)
    var elems: Vec<Option<ExprId>> = Vec.new()
    while peekKind(p) != T_RBRACKET && peekKind(p) != T_EOF {
        if peekKind(p) == T_COMMA {
            // elision [1, , 3]: a HOLE, recorded as sentinel -1 (a real slot in
            // length terms, but `in`/hasOwnProperty/keys say absent)
            elems.push(Option.None)
            advance(&mut p)
        } else {
            elems.push(Option.Some(parseArg(&mut p, &mut prog)))
            if peekKind(p) == T_COMMA {
                advance(&mut p)
            }
        }
    }
    expect(&mut p, T_RBRACKET)
    let literalId = addArrLit(&mut prog, elems)
    return addExpr(&mut prog, Expr.ArrLit(literalId))
}

// { key: expr, key: expr, ... } — keys are identifiers or string literals
fn parseObjectLiteral(p: &mut PState, prog: &mut Prog): ExprId {
    expect(&mut p, T_LBRACE)
    var props: Vec<PropInit> = Vec.new()
    while peekKind(p) != T_RBRACE && peekKind(p) != T_EOF {
        if peekKind(p) == T_SPREAD {
            // `{ ...src, k: v }` — recorded with the reserved key "..." and
            // expanded at eval time, in source order so later keys win
            advance(&mut p)
            let se = parseExpr(&mut p, &mut prog)
            props.push(PropInit {
                key: "...", val: se, kind: 0, keyExpr: Option.None, isProtoSetter: false
            }
            )
            if peekKind(p) == T_COMMA {
                advance(&mut p)
            }
        } else {
            var key = ""
            var sawColon = false
            var keyExpr: Option<ExprId> = Option.None
            var isMethodGen = false
            // `{ *gen() {} }` / `{ *[Symbol.iterator]() {} }` — the star comes
            // BEFORE the key. Checking for it only after the key had the key
            // parser consume the star as an unrecognised token, leaving the
            // method nameless.
            let methodStartAt = p.toks[p.pos].at
            if peekKind(p) == T_STAR {
                advance(&mut p)
                isMethodGen = true
            }
            var accessorKind: i64 = 0
            // `get name() {}` / `set name(v) {}` — only an accessor when a name
            // and parameter list follow, since `get` is a valid property name too
            if (peekKind(p) == T_IDENT && (p.toks[p.pos].text == "get" || p.toks[p.pos].text == "set")) && p.pos + 1 < p.toks.len() && p.toks[p.pos + 1].kind != T_COLON && p.toks[p.pos + 1].kind != T_COMMA && p.toks[p.pos + 1].kind != T_RBRACE && p.toks[p.pos + 1].kind != T_LPAREN {
                if p.toks[p.pos].text == "get" {
                    accessorKind = 1
                } else {
                    accessorKind = 2
                }
                advance(&mut p)
            }
            var isMethodAsync = false
            // `async foo() {}` — `async` is only a modifier when a method name follows
            if peekKind(p) == T_ASYNC && p.pos + 1 < p.toks.len() && p.toks[p.pos + 1].kind != T_COLON && p.toks[p.pos + 1].kind != T_COMMA && p.toks[p.pos + 1].kind != T_RBRACE && p.toks[p.pos + 1].kind != T_LPAREN {
                isMethodAsync = true
                advance(&mut p)
                // `async *gen() {}` puts the star after the modifier
                if peekKind(p) == T_STAR {
                    advance(&mut p)
                    isMethodGen = true
                }
            }
            // `{ [expr]: v }` — the key is evaluated at construction time.
            // This runs AFTER the get/set/async/star modifiers, not before:
            // with it first, `{ get [k]() {} }` never reached the accessor
            // check, the key parser then hit `[` as an unrecognised token and
            // dropped it, and the method came out nameless.
            if peekKind(p) == T_LBRACKET {
                advance(&mut p)
                keyExpr = Option.Some(parseExpr(&mut p, &mut prog))
                expect(&mut p, T_RBRACKET)
            }
            if keyExpr is Option.None {
                if peekKind(p) == T_NUM {
                    // a numeric property key `{ 2: v }` — its key is ToString(num)
                    // ("2", "10", "1.5"), not the token's (empty) text
                    key = numToStr(p.toks[p.pos].num)
                    advance(&mut p)
                } else if isPropName(p) || peekKind(p) == T_STR {
                    key = p.toks[p.pos].text.clone()
                    advance(&mut p)
                } else {
                    // unrecognised key token — drop it rather than spin
                    advance(&mut p)
                }
            }
            // shorthand `{ req, ip }` is `{ req: req, ip: ip }`
            var valIdx: Option<ExprId> = Option.None
            if peekKind(p) == T_LPAREN {
                // method shorthand `{ foo(a) { ... } }` — a plain function-valued prop
                advance(&mut p)
                var mparams: Vec<string> = Vec.new()
                var mprelude: Vec<DeclItem> = Vec.new()
                var mrest: i64 = -1
                while peekKind(p) != T_RPAREN && peekKind(p) != T_EOF {
                    if parseParam(&mut p, &mut prog, &mut mparams, &mut mprelude) {
                        mrest = mparams.len() - 1
                    }
                    if peekKind(p) == T_COMMA {
                        advance(&mut p)
                    }
                }
                expect(&mut p, T_RPAREN)
                let mSaved = p.strict
                if bodyIsStrict(p) {
                    p.strict = true
                }
                let mbody = parseBraceBlock(&mut p, &mut prog)
                var mParamPrelude: Option<StmtId> = Option.None
                if mprelude.len() > 0 {
                    let munpack = declsToStmt(&mut prog, mprelude)
                    if isMethodGen {
                        mParamPrelude = Option.Some(munpack)
                    } else {
                        prependStmt(&mut prog, mbody, munpack)
                    }
                }
                prog.funcs.push(FuncDef {
                    name: key.clone(), params: mparams, body: mbody, paramPrelude: mParamPrelude, isArrow: false, isAsync: isMethodAsync, restFrom: mrest, isGenerator: isMethodGen, isStrict: p.strict, isMethod: true, isClassCtor: false, srcStart: methodStartAt, srcEnd: p.toks[p.pos - 1].end, file: p.file.clone()
                }
                )
                p.strict = mSaved
                valIdx = Option.Some(addExpr(&mut prog, Expr.FuncExpr(prog.funcs.len() - 1)))
            } else if peekKind(p) == T_COLON {
                advance(&mut p)
                sawColon = true
                valIdx = Option.Some(parseExpr(&mut p, &mut prog))
                // `{ handler: () => {} }` — the anonymous value takes the key name
                inferFuncName(&mut prog, valIdx!, key)
            } else if peekKind(p) == T_EQ {
                // shorthand with default, only meaningful in a destructuring
                // pattern: `{ g = 10 }` — record it as `g = default` so
                // destructuring applies the default when the key is missing
                advance(&mut p)
                let defExpr = parseTernary(&mut p, &mut prog)
                valIdx = Option.Some(addExpr(&mut prog, Expr.Assign(key.clone(), defExpr)))
            } else {
                valIdx = Option.Some(addExpr(&mut prog, Expr.Ident(key.clone())))
            }
            let protoSetter = sawColon && accessorKind == 0 && key == "__proto__" && keyExpr.isNone()
            props.push(PropInit {
                key: key, val: valIdx!, kind: accessorKind, keyExpr: keyExpr, isProtoSetter: protoSetter
            }
            )
            if peekKind(p) == T_COMMA {
                advance(&mut p)
            }
        }
    }
    expect(&mut p, T_RBRACE)
    let literalId = addObjLit(&mut prog, props)
    return addExpr(&mut prog, Expr.ObjLit(literalId))
}

fn parsePostfix(p: &mut PState, prog: &mut Prog): ExprId {
    var e = parsePrimary(&mut p, &mut prog)
    var go = true
    var sawOpt = false
    while go {
        let k = peekKind(p)
        if k == T_LPAREN {
            advance(&mut p)
            var argIdxs: Vec<ExprId> = Vec.new()
            if peekKind(p) != T_RPAREN {
                argIdxs.push(parseArg(&mut p, &mut prog))
                while peekKind(p) == T_COMMA {
                    advance(&mut p)
                    if peekKind(p) == T_RPAREN {
                        break
                    }
                    argIdxs.push(parseArg(&mut p, &mut prog))
                }
            }
            expect(&mut p, T_RPAREN)
            let listId = addArgList(&mut prog, argIdxs)
            e = addExpr(&mut prog, Expr.Call(e, listId))
        } else if k == T_DOT {
            advance(&mut p)
            var name = ""
            // property names may be reserved words: obj.catch, obj.default,
            // obj.function, obj.delete. Keyword tokens still carry their text.
            if isPropName(p) {
                name = privName(p, p.toks[p.pos].text)
                advance(&mut p)
            }
            e = addExpr(&mut prog, Expr.Member(e, name))
        } else if k == T_OPTCHAIN {
            advance(&mut p)
            sawOpt = true
            if peekKind(p) == T_LPAREN {
                // f?.(args) — optional call
                advance(&mut p)
                var callArgs: Vec<ExprId> = Vec.new()
                if peekKind(p) != T_RPAREN {
                    callArgs.push(parseArg(&mut p, &mut prog))
                    while peekKind(p) == T_COMMA {
                        advance(&mut p)
                        if peekKind(p) == T_RPAREN {
                            break
                        }
                        callArgs.push(parseArg(&mut p, &mut prog))
                    }
                }
                expect(&mut p, T_RPAREN)
                let callListId = addArgList(&mut prog, callArgs)
                e = addExpr(&mut prog, Expr.OptCall(e, callListId))
            } else if peekKind(p) == T_LBRACKET {
                // a?.[k]
                advance(&mut p)
                let keyIdx = parseExpr(&mut p, &mut prog)
                expect(&mut p, T_RBRACKET)
                e = addExpr(&mut prog, Expr.OptIndex(e, keyIdx))
            } else {
                var name = ""
                if isPropName(p) {
                    name = p.toks[p.pos].text.clone()
                    advance(&mut p)
                }
                e = addExpr(&mut prog, Expr.OptMember(e, name))
            }
        } else if k == T_TEMPLATE_BEGIN {
            e = parseTaggedTemplate(&mut p, &mut prog, e)
        } else if k == T_LBRACKET {
            advance(&mut p)
            // The index is an Expression, comma operator included: `a[0, 1, 2]`
            // evaluates the sequence and indexes by the LAST value. parseExpr
            // stops at a comma, so this used to be a parse error.
            let keyIdx = parseCommaSeq(&mut p, &mut prog)
            expect(&mut p, T_RBRACKET)
            e = addExpr(&mut prog, Expr.Index(e, keyIdx))
        } else {
            go = false
        }
    }
    // a chain with any `?.` link is wrapped so a nullish base short-circuits the
    // whole chain (a?.b.c()) to undefined rather than only its own access
    if sawOpt {
        e = addExpr(&mut prog, Expr.OptChainRoot(e))
    }
    // postfix ++/-- binds to the completed postfix expression, applies once
    let pk = peekKind(p)
    if pk == T_INC {
        advance(&mut p)
        e = addExpr(&mut prog, Expr.Update(e, true, false))
    } else if pk == T_DEC {
        advance(&mut p)
        e = addExpr(&mut prog, Expr.Update(e, false, false))
    }
    return e
}

fn parseUnary(p: &mut PState, prog: &mut Prog): ExprId {
    let k = peekKind(p)
    if k == T_MINUS {
        advance(&mut p)
        let e = parseUnary(&mut p, &mut prog)
        return addExpr(&mut prog, Expr.Un("-", e))
    }
    if k == T_NOT {
        advance(&mut p)
        let e = parseUnary(&mut p, &mut prog)
        return addExpr(&mut prog, Expr.Un("!", e))
    }
    if k == T_TYPEOF {
        advance(&mut p)
        let e = parseUnary(&mut p, &mut prog)
        return addExpr(&mut prog, Expr.Un("typeof", e))
    }
    if k == T_VOID {
        advance(&mut p)
        let e = parseUnary(&mut p, &mut prog)
        return addExpr(&mut prog, Expr.Un("void", e))
    }
    if k == T_DELETE {
        advance(&mut p)
        let e = parseUnary(&mut p, &mut prog)
        return addExpr(&mut prog, Expr.Un("delete", e))
    }
    if k == T_AWAIT {
        advance(&mut p)
        let e = parseUnary(&mut p, &mut prog)
        return addExpr(&mut prog, Expr.Un("await", e))
    }
    if k == T_TILDE {
        advance(&mut p)
        let e = parseUnary(&mut p, &mut prog)
        return addExpr(&mut prog, Expr.Un("~", e))
    }
    if k == T_PLUS {
        advance(&mut p)
        let e = parseUnary(&mut p, &mut prog)
        return addExpr(&mut prog, Expr.Un("+", e))
    }
    if k == T_INC {
        advance(&mut p)
        let e = parseUnary(&mut p, &mut prog)
        return addExpr(&mut prog, Expr.Update(e, true, true))
    }
    if k == T_DEC {
        advance(&mut p)
        let e = parseUnary(&mut p, &mut prog)
        return addExpr(&mut prog, Expr.Update(e, false, true))
    }
    return parsePostfix(&mut p, &mut prog)
}

// `**` binds tighter than `*` and is RIGHT-associative: 2 * 3 ** 2 is 18, not 36,
// and 2 ** 3 ** 2 is 2 ** 9, not 8 ** 2. Parsed as its own level above the
// multiplicative operators, with the right operand recursing here so the chain
// nests to the right.
fn parseExp(p: &mut PState, prog: &mut Prog): ExprId {
    let left = parseUnary(&mut p, &mut prog)
    if peekKind(p) == T_STARSTAR {
        advance(&mut p)
        let right = parseExp(&mut p, &mut prog)
        return addExpr(&mut prog, Expr.Bin("**", left, right))
    }
    return left
}

fn parseMul(p: &mut PState, prog: &mut Prog): ExprId {
    var left = parseExp(&mut p, &mut prog)
    var go = true
    while go {
        let k = peekKind(p)
        if k == T_STAR || k == T_SLASH || k == T_PERCENT {
            advance(&mut p)
            var op = "*"
            if k == T_SLASH {
                op = "/"
            } else if k == T_PERCENT {
                op = "%"
            }
            let right = parseExp(&mut p, &mut prog)
            left = addExpr(&mut prog, Expr.Bin(op, left, right))
        } else {
            go = false
        }
    }
    return left
}

fn parseAdd(p: &mut PState, prog: &mut Prog): ExprId {
    var left = parseMul(&mut p, &mut prog)
    var go = true
    while go {
        let k = peekKind(p)
        if k == T_PLUS || k == T_MINUS {
            advance(&mut p)
            var op = "+"
            if k == T_MINUS {
                op = "-"
            }
            let right = parseMul(&mut p, &mut prog)
            left = addExpr(&mut prog, Expr.Bin(op, left, right))
        } else {
            go = false
        }
    }
    return left
}

fn parseShift(p: &mut PState, prog: &mut Prog): ExprId {
    var left = parseAdd(&mut p, &mut prog)
    var go = true
    while go {
        let k = peekKind(p)
        if k == T_SHL || k == T_SHR || k == T_USHR {
            advance(&mut p)
            var op = "<<"
            if k == T_SHR {
                op = ">>"
            } else if k == T_USHR {
                op = ">>>"
            }
            let right = parseAdd(&mut p, &mut prog)
            left = addExpr(&mut prog, Expr.Bin(op, left, right))
        } else {
            go = false
        }
    }
    return left
}

fn parseRel(p: &mut PState, prog: &mut Prog): ExprId {
    var left = parseShift(&mut p, &mut prog)
    var go = true
    while go {
        let k = peekKind(p)
        if k == T_LT || k == T_GT || k == T_LE || k == T_GE {
            advance(&mut p)
            var op = "<"
            if k == T_GT {
                op = ">"
            } else if k == T_LE {
                op = "<="
            } else if k == T_GE {
                op = ">="
            }
            let right = parseShift(&mut p, &mut prog)
            left = addExpr(&mut prog, Expr.Bin(op, left, right))
        } else if k == T_INSTANCEOF {
            advance(&mut p)
            let right = parseShift(&mut p, &mut prog)
            left = addExpr(&mut prog, Expr.Bin("instanceof", left, right))
        } else if k == T_IN && !p.noIn {
            advance(&mut p)
            let right = parseShift(&mut p, &mut prog)
            left = addExpr(&mut prog, Expr.Bin("in", left, right))
        } else {
            go = false
        }
    }
    return left
}

fn parseEq(p: &mut PState, prog: &mut Prog): ExprId {
    var left = parseRel(&mut p, &mut prog)
    var go = true
    while go {
        let k = peekKind(p)
        if k == T_EQEQ || k == T_NEQ || k == T_STRICTEQ || k == T_STRICTNEQ {
            advance(&mut p)
            var op = "=="
            if k == T_NEQ {
                op = "!="
            } else if k == T_STRICTEQ {
                op = "==="
            } else if k == T_STRICTNEQ {
                op = "!=="
            }
            let right = parseRel(&mut p, &mut prog)
            left = addExpr(&mut prog, Expr.Bin(op, left, right))
        } else {
            go = false
        }
    }
    return left
}

fn parseBitAnd(p: &mut PState, prog: &mut Prog): ExprId {
    var left = parseEq(&mut p, &mut prog)
    while peekKind(p) == T_AMP {
        advance(&mut p)
        let right = parseEq(&mut p, &mut prog)
        left = addExpr(&mut prog, Expr.Bin("&", left, right))
    }
    return left
}

fn parseBitXor(p: &mut PState, prog: &mut Prog): ExprId {
    var left = parseBitAnd(&mut p, &mut prog)
    while peekKind(p) == T_CARET {
        advance(&mut p)
        let right = parseBitAnd(&mut p, &mut prog)
        left = addExpr(&mut prog, Expr.Bin("^", left, right))
    }
    return left
}

fn parseBitOr(p: &mut PState, prog: &mut Prog): ExprId {
    var left = parseBitXor(&mut p, &mut prog)
    while peekKind(p) == T_PIPE {
        advance(&mut p)
        let right = parseBitXor(&mut p, &mut prog)
        left = addExpr(&mut prog, Expr.Bin("|", left, right))
    }
    return left
}

fn parseAnd(p: &mut PState, prog: &mut Prog): ExprId {
    var left = parseBitOr(&mut p, &mut prog)
    while peekKind(p) == T_ANDAND {
        advance(&mut p)
        let right = parseBitOr(&mut p, &mut prog)
        left = addExpr(&mut prog, Expr.Bin("&&", left, right))
    }
    return left
}

fn parseOr(p: &mut PState, prog: &mut Prog): ExprId {
    var left = parseAnd(&mut p, &mut prog)
    var going = true
    while going {
        if peekKind(p) == T_OROR {
            advance(&mut p)
            let right = parseAnd(&mut p, &mut prog)
            left = addExpr(&mut prog, Expr.Bin("||", left, right))
        } else if peekKind(p) == T_NULLISH {
            advance(&mut p)
            let right = parseAnd(&mut p, &mut prog)
            left = addExpr(&mut prog, Expr.Bin("??", left, right))
        } else {
            going = false
        }
    }
    return left
}

// c ? a : b — sits between the logical operators and assignment
fn parseTernary(p: &mut PState, prog: &mut Prog): ExprId {
    let cond = parseOr(&mut p, &mut prog)
    if peekKind(p) == T_QUESTION {
        advance(&mut p)
        let a = parseExpr(&mut p, &mut prog)
        expect(&mut p, T_COLON)
        let b = parseExpr(&mut p, &mut prog)
        return addExpr(&mut prog, Expr.Cond(cond, a, b))
    }
    return cond
}

fn compoundOp(k: i32): string {
    if k == T_PLUSEQ {
        return "+"
    }
    if k == T_MINUSEQ {
        return "-"
    }
    if k == T_STAREQ {
        return "*"
    }
    if k == T_SLASHEQ {
        return "/"
    }
    if k == T_SHLEQ {
        return "<<"
    }
    if k == T_SHREQ {
        return ">>"
    }
    if k == T_USHREQ {
        return ">>>"
    }
    if k == T_AMPEQ {
        return "&"
    }
    if k == T_PIPEEQ {
        return "|"
    }
    if k == T_CARETEQ {
        return "^"
    }
    if k == T_STARSTAREQ {
        return "**"
    }
    return "%"
}

// Depth-guarded wrapper. Every recursive path through an expression comes back
// here (an array element, a call argument, a parenthesised subexpression), so one
// counter on this function bounds the whole descent, and one increment/decrement
// pair keeps it off the many return paths inside the body.
fn parseExpr(p: &mut PState, prog: &mut Prog): ExprId {
    p.depth = p.depth + 1
    if p.depth > PARSE_DEPTH_LIMIT {
        p.depth = p.depth - 1
        if !p.errored {
            p.errored = true
            if !p.quiet {
                eprint($"milojs: {p.file}: expression nests deeper than {PARSE_DEPTH_LIMIT} levels")
            }
        }
        // Jump to EOF. Returning a placeholder without consuming input leaves the
        // unconsumed `[`s in front of every enclosing loop, and the parser spins
        // forever instead of finishing — which is how the first version of this
        // guard turned a crash into a hang. Every loop in the parser terminates
        // at EOF, so this is the one move that unwinds all of them at once.
        p.pos = p.toks.len()
        return addExpr(&mut prog, Expr.UndefLit)
    }
    let r = parseExprInner(&mut p, &mut prog)
    p.depth = p.depth - 1
    return r
}

fn parseExprInner(p: &mut PState, prog: &mut Prog): ExprId {
    // `yield` binds looser than everything but the comma operator, so it belongs
    // here rather than with the unary operators: `yield a + b` yields the sum.
    // Parsed but not executable — calling a generator throws first (eval.milo),
    // so this exists to let generator-containing files parse at all.
    if peekKind(p) == T_YIELD {
        advance(&mut p)
        var op = "yield"
        if peekKind(p) == T_STAR {
            advance(&mut p)
            op = "yield*"
        }
        // operandless `yield` — the next token closes the expression
        let k2 = peekKind(p)
        if k2 == T_SEMI || k2 == T_RPAREN || k2 == T_RBRACE || k2 == T_RBRACKET || k2 == T_COMMA || k2 == T_COLON || k2 == T_EOF {
            return addExpr(&mut prog, Expr.Un(op, addExpr(&mut prog, Expr.UndefLit)))
        }
        let arg = parseExpr(&mut p, &mut prog)
        return addExpr(&mut prog, Expr.Un(op, arg))
    }
    let left = parseTernary(&mut p, &mut prog)
    let k = peekKind(p)
    if k == T_EQ {
        advance(&mut p)
        let rhs = parseExpr(&mut p, &mut prog)
        let leftNode = getExpr(prog, left)
        match leftNode {
            Expr.Ident(name) => {
                // `z = function () {}` infers z as the name, the same as a
                // declaration does; only assignment to a plain identifier
                inferFuncName(&mut prog, rhs, name)
                return addExpr(&mut prog, Expr.Assign(name, rhs))
            }
            Expr.Member(objIdx, name) => {
                // obj.x = v  →  synthesize the string key "x"
                let keyIdx = addExpr(&mut prog, Expr.StrLit(name))
                return addExpr(&mut prog, Expr.SetMember(objIdx, keyIdx, rhs))
            }
            Expr.Index(objIdx, keyIdx) => {
                return addExpr(&mut prog, Expr.SetMember(objIdx, keyIdx, rhs))
            }
            Expr.ArrLit(_li) => {
                // array destructuring assignment: [a, b] = rhs
                return addExpr(&mut prog, Expr.DestructAssign(left, rhs))
            }
            Expr.ObjLit(_li) => {
                // object destructuring assignment: ({a, b} = rhs)
                return addExpr(&mut prog, Expr.DestructAssign(left, rhs))
            }
            _ => {
                // non-lvalue assignment target: evaluate rhs, drop the target
                return rhs
            }
        }
    }
    if k == T_PLUSEQ || k == T_MINUSEQ || k == T_STAREQ || k == T_SLASHEQ || k == T_PERCENTEQ || k == T_SHLEQ || k == T_SHREQ || k == T_USHREQ || k == T_AMPEQ || k == T_PIPEEQ || k == T_CARETEQ || k == T_STARSTAREQ {
        advance(&mut p)
        let op = compoundOp(k)
        let rhs = parseExpr(&mut p, &mut prog)
        return addExpr(&mut prog, Expr.CompoundAssign(left, op, rhs))
    }
    if k == T_ANDANDEQ || k == T_OROREQ || k == T_NULLISHEQ {
        advance(&mut p)
        var lop = "&&"
        if k == T_OROREQ {
            lop = "||"
        } else if k == T_NULLISHEQ {
            lop = "??"
        }
        let rhs = parseExpr(&mut p, &mut prog)
        return addExpr(&mut prog, Expr.LogicalAssign(left, lop, rhs))
    }
    return left
}

// function [name] ( params ) { body } — returns index into prog.funcs
// JS NamedEvaluation: `const f = () => {}` gives the arrow the name "f". The
// binding name is known statically, so set it on the anonymous FuncDef at parse
// time — no per-instance runtime name slot needed. Only anonymous functions are
// affected; a named function expression keeps its own name.
// A private name belongs to ONE class. Stored as a plain `#x` property, two
// classes that both declare `#x` shared a key: `#x in b` answered true for an
// instance of the other class, and a bundle where `#x` is ubiquitous could read
// across class boundaries. The class's unique super key makes it per-class.
fn privName(p: &PState, name: &string): string {
    if name.len() > 0 && name[0] == '#' && p.curClass.len() > 0 {
        // innermost declaration wins; an unknown name can only be a reference to
        // the class being parsed, so the current class stays the fallback
        var i: i64 = p.privNames.len() - 1
        while i >= 0 {
            if p.privNames[i] == name {
                return name.clone() + "@" + p.privOwners[i].clone()
            }
            i = i - 1
        }
        return name.clone() + "@" + p.curClass.clone()
    }
    return name.clone()
}

// Collect the private names this class body declares, before any of its members
// are parsed, so a method that mentions `#x` ahead of `#x`'s own declaration
// still resolves to it. `p.pos` is just past the class's `{`; only depth-1
// tokens count, and `o.#x` / `#x in o` are uses rather than declarations.
fn scanPrivateDecls(p: &mut PState, owner: &string) {
    var depth: i64 = 0
    var i: i64 = p.pos
    while i < p.toks.len() {
        let k = p.toks[i].kind
        if k == T_LBRACE || k == T_LBRACKET || k == T_LPAREN {
            depth = depth + 1
        } else if k == T_RBRACE || k == T_RBRACKET || k == T_RPAREN {
            if depth == 0 {
                return
            }
            depth = depth - 1
        } else if depth == 0 && p.toks[i].text.len() > 0 && p.toks[i].text[0] == '#' {
            let prevDot = i > 0 && p.toks[i - 1].kind == T_DOT
            let nextIn = i + 1 < p.toks.len() && p.toks[i + 1].kind == T_IN
            if !prevDot && !nextIn {
                p.privNames.push(p.toks[i].text.clone())
                p.privOwners.push(owner.clone())
            }
        }
        i = i + 1
    }
}

fn inferFuncName(prog: &mut Prog, initId: ExprId, name: &string) {
    if name.len() == 0 {
        return
    }
    match prog.exprs[initId.index] {
        Expr.FuncExpr(f) => {
            if prog.funcs[f].name.len() == 0 {
                prog.funcs[f].name = name.clone()
            }
        }
        // an anonymous CLASS takes the binding's name too: `const A = class {}`
        // gives A.name === "A", and so does a destructuring default
        Expr.ClassExpr(ci) => {
            if prog.classes[ci].name.len() == 0 {
                prog.classes[ci].name = name.clone()
                let dc = prog.classes[ci].defaultCtor
                if dc >= 0 && prog.funcs[dc].name.len() == 0 {
                    prog.funcs[dc].name = name.clone()
                }
                let cf = prog.classes[ci].ctorFn
                if cf >= 0 && prog.funcs[cf].name.len() == 0 {
                    prog.funcs[cf].name = name.clone()
                }
            }
        }
        _ => {
        }
    }
}

fn parseFunction(p: &mut PState, prog: &mut Prog, isAsync: bool): i64 {
    // `async` was consumed by the caller, and node's toString includes it
    var fnStartPos = p.pos
    if isAsync && fnStartPos > 0 {
        fnStartPos = fnStartPos - 1
    }
    let fnStartAt = p.toks[fnStartPos].at
    expect(&mut p, T_FUNCTION)
    // generator star: parsed so the surrounding module loads. Generators need
    // suspension, which the engine cannot do, so calling one throws.
    var isGenerator = false
    if peekKind(p) == T_STAR {
        advance(&mut p)
        isGenerator = true
    }
    var name = ""
    if isBindingName(p) {
        name = p.toks[p.pos].text.clone()
        advance(&mut p)
    }
    expect(&mut p, T_LPAREN)
    var params: Vec<string> = Vec.new()
    var prelude: Vec<DeclItem> = Vec.new()
    var restFrom: i64 = -1
    while peekKind(p) != T_RPAREN && peekKind(p) != T_EOF {
        if parseParam(&mut p, &mut prog, &mut params, &mut prelude) {
            restFrom = params.len() - 1
        }
        if peekKind(p) == T_COMMA {
            advance(&mut p)
        }
    }
    expect(&mut p, T_RPAREN)
    let fSaved = p.strict
    if bodyIsStrict(p) {
        p.strict = true
    }
    let body = parseBraceBlock(&mut p, &mut prog)
    // A generator binds its parameters when CALLED. Recording the unpack instead
    // of prepending it is what lets makeGenerator run it there; see FuncDef.
    var paramPrelude: Option<StmtId> = Option.None
    if prelude.len() > 0 {
        let unpack = declsToStmt(&mut prog, prelude)
        if isGenerator {
            paramPrelude = Option.Some(unpack)
        } else {
            prependStmt(&mut prog, body, unpack)
        }
    }
    prog.funcs.push(FuncDef {
        name: name, params: params, body: body, paramPrelude: paramPrelude, isArrow: false, isAsync: isAsync, restFrom: restFrom, isGenerator: isGenerator, isStrict: p.strict, isMethod: false, isClassCtor: false, srcStart: fnStartAt, srcEnd: p.toks[p.pos - 1].end, file: p.file.clone()
    }
    )
    p.strict = fSaved
    return prog.funcs.len() - 1
}

// { stmt* } — returns index into prog.blocks
// A block, or the program, may not declare the same name twice when either
// declaration is lexical: `let x; let x;` and `let x; var x;` are both early
// SyntaxErrors, and node reports them before running a single statement. Only
// the statements at THIS level are examined — a nested block has its own list
// and is checked when it is parsed — which is what keeps `for (let i…)` in two
// sibling loops from colliding. A `var` or a function declaration is not
// lexical, so redeclaring one is left alone.
fn checkDupDecls(p: &mut PState, prog: &Prog, list: &Vec<StmtId>) {
    if p.errored {
        return
    }
    var names: Vec<string> = Vec.new()
    var lexical: Vec<bool> = Vec.new()
    var si: i64 = 0
    while si < list.len() {
        var declName = ""
        var isLex = false
        var many = -1
        match prog.stmts[list[si].index] {
            Stmt.MultiDecl(d) => {
                many = d.index
            }
            Stmt.ClassDecl(c) => {
                declName = prog.classes[c].name.clone()
                isLex = true
            }
            Stmt.FuncDecl(f) => {
                declName = prog.funcs[f].name.clone()
                isLex = false
            }
            _ => {
            }
        }
        var pending: Vec<string> = Vec.new()
        var pendingLex: Vec<bool> = Vec.new()
        if many >= 0 {
            var di: i64 = 0
            while di < prog.declLists[many].len() {
                let nm = prog.declLists[many][di].name.clone()
                if nm.len() > 0 && !isSyntheticTemp(nm) {
                    pending.push(nm)
                    pendingLex.push(!prog.declLists[many][di].isVar)
                }
                di = di + 1
            }
        } else if declName.len() > 0 {
            pending.push(declName)
            pendingLex.push(isLex)
        }
        var pi: i64 = 0
        while pi < pending.len() {
            var ni: i64 = 0
            while ni < names.len() {
                if names[ni] == pending[pi] && (lexical[ni] || pendingLex[pi]) {
                    if !p.errored {
                        p.errored = true
                        if !p.quiet {
                            eprint("milojs: " + p.file + ": Identifier '" + pending[pi].clone() + "' has already been declared\n")
                        }
                    }
                    return
                }
                ni = ni + 1
            }
            names.push(pending[pi].clone())
            lexical.push(pendingLex[pi])
            pi = pi + 1
        }
        si = si + 1
    }
}

fn parseBraceBlock(p: &mut PState, prog: &mut Prog): BlockId {
    expect(&mut p, T_LBRACE)
    var list: Vec<StmtId> = Vec.new()
    while peekKind(p) != T_RBRACE && peekKind(p) != T_EOF {
        list.push(parseStmt(&mut p, &mut prog))
    }
    expect(&mut p, T_RBRACE)
    checkDupDecls(&mut p, prog, list)
    return addBlock(&mut prog, list)
}

fn parseStmt(p: &mut PState, prog: &mut Prog): StmtId {
    // `var`, not `let`: the `await using` case below re-reads the kind after
    // consuming the `await`.
    var k = peekKind(p)
    if k == T_SEMI {
        advance(&mut p)
        return addStmt(&mut prog, Stmt.Empty)
    }
    // `label: stmt`. At statement position an identifier followed by a colon is
    // unambiguously a label — no other statement starts that way (object
    // literals and the ternary colon are expression-internal).
    if k == T_IDENT && p.pos + 1 < p.toks.len() && p.toks[p.pos + 1].kind == T_COLON {
        let lname = p.toks[p.pos].text.clone()
        advance(&mut p)
        advance(&mut p)
        let body = parseStmt(&mut p, &mut prog)
        return addStmt(&mut prog, Stmt.Labeled(lname, body))
    }
    // `await using x = expr`: the async form. Parsed here so the whole construct
    // reaches the same declaration path; the ASYNC part of disposal is handled at
    // dispose time by awaiting a thenable result, which needs no marker on the AST.
    if k == T_AWAIT && p.pos + 2 < p.toks.len() && p.toks[p.pos + 1].kind == T_IDENT
        && p.toks[p.pos + 1].text == "using" && p.toks[p.pos + 2].kind == T_IDENT {
        advance(&mut p)
        k = peekKind(p)
    }
    // `using x = expr` (ES2026 explicit resource management). CONTEXTUAL: this is a
    // declaration only when a plain identifier follows on the SAME line, so `using`
    // stays usable as an ordinary variable name and `using\n x` remains two
    // statements under ASI. Binding patterns are not permitted by the grammar, and
    // an initializer is required.
    if k == T_IDENT && p.toks[p.pos].text == "using" && p.pos + 1 < p.toks.len()
        && p.toks[p.pos + 1].kind == T_IDENT && !p.toks[p.pos + 1].nlBefore {
        advance(&mut p)
        var uItems: Vec<DeclItem> = Vec.new()
        var uMore = true
        while uMore && !p.errored {
            let uName = p.toks[p.pos].text.clone()
            expect(&mut p, T_IDENT)
            expect(&mut p, T_EQ)
            let uInit = parseExpr(&mut p, &mut prog)
            uItems.push(DeclItem {
                name: uName, init: uInit, isVar: false
            }
            )
            if peekKind(p) == T_COMMA {
                advance(&mut p)
            } else {
                uMore = false
            }
        }
        expectStatementEnd(&mut p)
        if peekKind(p) == T_SEMI {
            advance(&mut p)
        }
        let uList = addDeclList(&mut prog, uItems)
        return addStmt(&mut prog, Stmt.UsingDecl(uList))
    }
    if k == T_LET || k == T_VAR || k == T_CONST {
        let declaredVar = k == T_VAR
        advance(&mut p)
        var items: Vec<DeclItem> = Vec.new()
        var more = true
        while more {
            if isPatternStart(p) {
                // `const { a, b } = expr` — bind the initializer to a temp, then
                // let the desugared declarators read out of it
                let save = p.pos
                // An ARRAY pattern binds by iteration, not by index: `const [a, b]
                // = gen` must drive gen's [Symbol.iterator]. The declarators below
                // read `__dN[0]`, `__dN[1]`, so the temp is bound to `[...expr]` —
                // spread is the iteration protocol this engine already implements.
                // Object patterns read by key and must NOT be wrapped.
                let isArrayPattern = peekKind(p) == T_LBRACKET
                var pat: Vec<DeclItem> = Vec.new()
                let tmp = "__d" + i64ToStr(save)
                patternDecls(&mut p, &mut prog, tmp.clone(), &mut pat)
                var tinit: Option<ExprId> = Option.None
                if peekKind(p) == T_EQ {
                    advance(&mut p)
                    var initE = parseExpr(&mut p, &mut prog)
                    // no spread wrapper any more: __iterSteps drives the
                    // iterator itself, so the temp holds the raw source
                    tinit = Option.Some(initE)
                } else {
                    tinit = Option.Some(addExpr(&mut prog, Expr.UndefLit))
                }
                items.push(DeclItem {
                    name: tmp, init: tinit!, isVar: declaredVar
                }
                )
                var pi: i64 = 0
                while pi < pat.len() {
                    items.push(DeclItem {
                        name: pat[pi].name.clone(), init: pat[pi].init, isVar: declaredVar
                    }
                    )
                    pi = pi + 1
                }
                if peekKind(p) == T_COMMA {
                    advance(&mut p)
                } else {
                    more = false
                }
            } else {
                var name = ""
                if isBindingName(p) {
                    name = p.toks[p.pos].text.clone()
                    advance(&mut p)
                }
                var init: Option<ExprId> = Option.None
                if peekKind(p) == T_EQ {
                    advance(&mut p)
                    // parseExpr stops at ',' (no comma operator), so each declarator's
                    // initializer parses independently
                    init = Option.Some(parseExpr(&mut p, &mut prog))
                    // `const bar = () => {}` / `= function(){}` — an anonymous
                    // function expression inherits the binding name (JS NamedEvaluation)
                    inferFuncName(&mut prog, init!, name)
                }
                if init is Option.None {
                    init = Option.Some(addExpr(&mut prog, Expr.UndefLit))
                }
                items.push(DeclItem {
                    name: name, init: init!, isVar: declaredVar
                }
                )
                if peekKind(p) == T_COMMA {
                    advance(&mut p)
                } else {
                    more = false
                }
            }
        }
        expectStatementEnd(&mut p)
        if peekKind(p) == T_SEMI {
            advance(&mut p)
        }
        let declarationsId = addDeclList(&mut prog, items)
        return addStmt(&mut prog, Stmt.MultiDecl(declarationsId))
    }
    if k == T_IMPORT && p.pos + 1 < p.toks.len() && p.toks[p.pos + 1].kind != T_LPAREN {
        return parseImport(&mut p, &mut prog)
    }
    if k == T_FUNCTION {
        // in statement position a name is mandatory; without this the missing
        // name surfaces as a confusing complaint about the `(` that follows
        // `function* name()` puts the star between the keyword and the name
        var nameAt = p.pos + 1
        if nameAt < p.toks.len() && p.toks[nameAt].kind == T_STAR {
            nameAt = nameAt + 1
        }
        if nameAt < p.toks.len() && !isBindingNameAt(p, nameAt) && !p.errored {
            p.errored = true
            if !p.quiet {
                eprint("milojs: " + p.file + ": function statements require a name")
            }
        }
        let f = parseFunction(&mut p, &mut prog, false)
        return addStmt(&mut prog, Stmt.FuncDecl(f))
    }
    if k == T_CLASS {
        let c = parseClass(&mut p, &mut prog)
        return addStmt(&mut prog, Stmt.ClassDecl(c))
    }
    if k == T_DO {
        advance(&mut p)
        let body = parseStmt(&mut p, &mut prog)
        expect(&mut p, T_WHILE)
        expect(&mut p, T_LPAREN)
        let cond = parseCommaSeq(&mut p, &mut prog)
        expect(&mut p, T_RPAREN)
        if peekKind(p) == T_SEMI {
            advance(&mut p)
        }
        return addStmt(&mut prog, Stmt.DoWhile(body, cond))
    }
    if k == T_SWITCH {
        advance(&mut p)
        expect(&mut p, T_LPAREN)
        let discr = parseCommaSeq(&mut p, &mut prog)
        expect(&mut p, T_RPAREN)
        expect(&mut p, T_LBRACE)
        var cases: Vec<SwitchCase> = Vec.new()
        while peekKind(p) != T_RBRACE && peekKind(p) != T_EOF {
            var test: Option<ExprId> = Option.None
            if peekKind(p) == T_CASE {
                advance(&mut p)
                test = Option.Some(parseExpr(&mut p, &mut prog))
            } else if peekKind(p) == T_DEFAULT {
                advance(&mut p)
            } else {
                // stray token inside the switch body — drop it rather than spin
                advance(&mut p)
            }
            if peekKind(p) == T_COLON {
                advance(&mut p)
            }
            var stmts: Vec<StmtId> = Vec.new()
            while peekKind(p) != T_CASE && peekKind(p) != T_DEFAULT && peekKind(p) != T_RBRACE && peekKind(p) != T_EOF {
                stmts.push(parseStmt(&mut p, &mut prog))
            }
            let caseBody = addBlock(&mut prog, stmts)
            cases.push(SwitchCase {
                test: test, body: caseBody
            }
            )
        }
        expect(&mut p, T_RBRACE)
        let switchId = addSwitch(&mut prog, cases)
        return addStmt(&mut prog, Stmt.Switch(discr, switchId))
    }
    if k == T_ASYNC && p.pos + 1 < p.toks.len() && p.toks[p.pos + 1].kind == T_FUNCTION {
        advance(&mut p)
        let f = parseFunction(&mut p, &mut prog, true)
        return addStmt(&mut prog, Stmt.FuncDecl(f))
    }
    if k == T_IF {
        advance(&mut p)
        expect(&mut p, T_LPAREN)
        // the grammar here is Expression, which INCLUDES the comma operator:
        // minified code leans on `if (x = f(x), !cond)` to fold a statement into
        // the test. parseExpr stops at the comma and the paren never closes.
        let cond = parseCommaSeq(&mut p, &mut prog)
        expect(&mut p, T_RPAREN)
        let thenS = parseStmt(&mut p, &mut prog)
        var elseS: Option<StmtId> = Option.None
        if peekKind(p) == T_ELSE {
            advance(&mut p)
            elseS = Option.Some(parseStmt(&mut p, &mut prog))
        }
        return addStmt(&mut prog, Stmt.If(cond, thenS, elseS))
    }
    if k == T_WHILE {
        advance(&mut p)
        expect(&mut p, T_LPAREN)
        let cond = parseCommaSeq(&mut p, &mut prog)
        expect(&mut p, T_RPAREN)
        let body = parseStmt(&mut p, &mut prog)
        return addStmt(&mut prog, Stmt.While(cond, body))
    }
    if k == T_FOR {
        advance(&mut p)
        // `for await (x of it)` — only legal in an async context, which the
        // parser does not track, so it is accepted anywhere and the evaluator
        // decides what awaiting means
        var isForAwait = false
        if peekKind(p) == T_AWAIT {
            advance(&mut p)
            isForAwait = true
        }
        expect(&mut p, T_LPAREN)
        // for (x in obj) — look ahead past an optional declarator keyword for
        // `IDENT in`; if it isn't there, rewind and parse a C-style for
        let savedPos = p.pos
        var forInName = ""
        // `of` is not a reserved word in JS — it lexes as an identifier, so
        // for-of is detected by text, unlike for-in's real T_IN keyword
        var isOf = false
        // How a for-in/for-of head binds its name: 0 none (plain assignment to an
        // existing variable), 1 `var`, 2 `let`/`const`. See Stmt.ForIn.
        var sawVarKw = false
        var bindKind: i64 = 0
        // `for (using x of it)`: binds per iteration like `let` AND disposes at the
        // end of each pass, which is kind 3. Guarded against `for (using of xs)`,
        // where `using` is the loop variable and `of` the keyword: that needs the
        // name after `using` to be something other than `of`.
        if peekKind(p) == T_IDENT && p.toks[p.pos].text == "using" && p.pos + 1 < p.toks.len()
            && p.toks[p.pos + 1].kind == T_IDENT && p.toks[p.pos + 1].text != "of" {
            bindKind = 3
            advance(&mut p)
        }
        if bindKind == 0 && (peekKind(p) == T_VAR || peekKind(p) == T_LET || peekKind(p) == T_CONST) {
            sawVarKw = peekKind(p) == T_VAR
            if sawVarKw {
                bindKind = 1
            } else {
                bindKind = 2
            }
            advance(&mut p)
        }
        if isPatternStart(p) {
            // for (const [k, v] of pairs) — iterate into a temp, then unpack it
            // into a block wrapped around the body
            let tmp = "__f" + i64ToStr(p.pos)
            var pat: Vec<DeclItem> = Vec.new()
            patternDecls(&mut p, &mut prog, tmp.clone(), &mut pat)
            var patIsOf = false
            var patIsForInOf = false
            if peekKind(p) == T_IN {
                advance(&mut p)
                patIsForInOf = true
            } else if peekKind(p) == T_IDENT && p.toks[p.pos].text == "of" {
                advance(&mut p)
                patIsOf = true
                patIsForInOf = true
            }
            // A pattern head is NOT necessarily for-in/of: `for (const {x:[y]} = o; ...)`
            // is an ordinary C-style loop whose init happens to destructure. This
            // branch used to parse the object expression unconditionally and choke
            // on the `=`. Rewind and let the C-style path below handle it, which
            // already knows how to parse a destructuring declaration.
            if !patIsForInOf {
                p.pos = savedPos
            }
            if patIsForInOf {
            let objExpr = parseExpr(&mut p, &mut prog)
            expect(&mut p, T_RPAREN)
            let inner = parseStmt(&mut p, &mut prog)
            let unpack = declsToStmt(&mut prog, pat)
            var wrapped: Vec<StmtId> = Vec.new()
            wrapped.push(unpack)
            wrapped.push(inner)
            let wrappedBlock = addBlock(&mut prog, wrapped)
            let body = addStmt(&mut prog, Stmt.Block(wrappedBlock))
            if patIsOf {
                return addStmt(&mut prog, Stmt.ForOf(tmp, objExpr, body, isForAwait, 2))
            }
            return addStmt(&mut prog, Stmt.ForIn(tmp, objExpr, body, 2))
            }
        }
        // Annex B `for (var k = 2 in obj)`: legal in sloppy code, and quickjs's
        // test_loop.js depends on it. The initializer really does run, so it is
        // kept rather than discarded; it is only unobservable because the first
        // key overwrites it, and over an EMPTY object the variable keeps it.
        var forInInit: Option<ExprId> = Option.None
        if peekKind(p) == T_IDENT {
            let cand = p.toks[p.pos].text.clone()
            advance(&mut p)
            if sawVarKw && peekKind(p) == T_EQ {
                advance(&mut p)
                let savedNoIn = p.noIn
                p.noIn = true
                forInInit = Option.Some(parseExpr(&mut p, &mut prog))
                p.noIn = savedNoIn
            }
            if peekKind(p) == T_IN {
                forInName = cand
            } else if peekKind(p) == T_IDENT && p.toks[p.pos].text == "of" {
                forInName = cand
                isOf = true
            }
        }
        if forInName.len() > 0 {
            advance(&mut p)
            // for-IN takes a full Expression, so `for (x in null, obj)` is legal;
            // for-OF takes an AssignmentExpression and stops at the comma.
            var objExpr = parseExpr(&mut p, &mut prog)
            if !isOf {
                while peekKind(p) == T_COMMA {
                    advance(&mut p)
                    let rhs = parseExpr(&mut p, &mut prog)
                    objExpr = addExpr(&mut prog, Expr.Comma(objExpr, rhs))
                }
            }
            expect(&mut p, T_RPAREN)
            let body = parseStmt(&mut p, &mut prog)
            if isOf {
                return addStmt(&mut prog, Stmt.ForOf(forInName, objExpr, body, isForAwait, bindKind))
            }
            let loop = addStmt(&mut prog, Stmt.ForIn(forInName.clone(), objExpr, body, bindKind))
            if let Option.Some(initExpr) = forInInit {
                // `{ var k = INIT; for (k in obj) BODY }`
                var initItems: Vec<DeclItem> = Vec.new()
                initItems.push(DeclItem {
                    name: forInName.clone(), init: initExpr, isVar: true
                }
                )
                var seq: Vec<StmtId> = Vec.new()
                seq.push(declsToStmt(&mut prog, initItems))
                seq.push(loop)
                let seqBlock = addBlock(&mut prog, seq)
                return addStmt(&mut prog, Stmt.Block(seqBlock))
            }
            return loop
        }
        p.pos = savedPos
        // for (a.x in obj) / for (arr[0] of it): the head is an assignment
        // TARGET, not a binding. Only a bare identifier was ever recognised, so
        // every member or index target failed to parse and took the C-style path
        // down with it. parsePostfix is the right parser here because it stops
        // before `in`, which parseExpr would swallow as a binary operator.
        //
        // Desugared rather than given its own AST node, using the same temp
        // shape the destructuring case above already uses:
        //   for (a.x in obj) BODY   ==>   for (__t in obj) { a.x = __t; BODY }
        let headK = peekKind(p)
        if headK != T_SEMI && headK != T_VAR && headK != T_LET && headK != T_CONST {
            let lvStart = p.pos
            // The parser's `errored` flag is sticky and suppresses every later
            // diagnostic, so a SPECULATIVE parse must not be able to set it.
            let lvSavedErr = p.errored
            let lvSavedEof = p.eofError
            let lvTarget = parsePostfix(&mut p, &mut prog)
            var lvIsOf = false
            var lvMatched = false
            if peekKind(p) == T_IN {
                lvMatched = true
            } else if peekKind(p) == T_IDENT && p.toks[p.pos].text == "of" {
                lvMatched = true
                lvIsOf = true
            }
            if lvMatched && !p.errored {
                advance(&mut p)
                let lvObj = parseExpr(&mut p, &mut prog)
                expect(&mut p, T_RPAREN)
                let lvBody = parseStmt(&mut p, &mut prog)
                let lvTmp = "__fl" + i64ToStr(lvStart)
                let lvRead = addExpr(&mut prog, Expr.Ident(lvTmp.clone()))
                // getExpr clones the node out: building the assignment appends to
                // the same arena being inspected.
                var lvAssign: Option<ExprId> = Option.None
                match getExpr(prog, lvTarget) {
                    Expr.Member(lvObjE, lvName) => {
                        let lvKey = addExpr(&mut prog, Expr.StrLit(lvName.clone()))
                        lvAssign = Option.Some(addExpr(&mut prog, Expr.SetMember(lvObjE, lvKey, lvRead)))
                    }
                    Expr.Index(lvObjE, lvKeyE) => {
                        lvAssign = Option.Some(addExpr(&mut prog, Expr.SetMember(lvObjE, lvKeyE, lvRead)))
                    }
                    Expr.Ident(lvName) => {
                        lvAssign = Option.Some(addExpr(&mut prog, Expr.Assign(lvName.clone(), lvRead)))
                    }
                    _ => {
                    }
                }
                if let Option.Some(lvSet) = lvAssign {
                    var lvSeq: Vec<StmtId> = Vec.new()
                    lvSeq.push(addStmt(&mut prog, Stmt.ExprStmt(lvSet)))
                    lvSeq.push(lvBody)
                    let lvBlockId = addBlock(&mut prog, lvSeq)
                    let lvWrapped = addStmt(&mut prog, Stmt.Block(lvBlockId))
                    if lvIsOf {
                        return addStmt(&mut prog, Stmt.ForOf(lvTmp, lvObj, lvWrapped, isForAwait, 2))
                    }
                    return addStmt(&mut prog, Stmt.ForIn(lvTmp, lvObj, lvWrapped, 2))
                }
            }
            p.pos = lvStart
            p.errored = lvSavedErr
            p.eofError = lvSavedEof
        }
        // init clause (consumes its own terminating ;)
        var init: Option<StmtId> = Option.None
        if peekKind(p) == T_SEMI {
            advance(&mut p)
        } else if peekKind(p) == T_LET || peekKind(p) == T_VAR || peekKind(p) == T_CONST
            || (peekKind(p) == T_IDENT && p.toks[p.pos].text == "using" && p.pos + 1 < p.toks.len()
                && p.toks[p.pos + 1].kind == T_IDENT && p.toks[p.pos + 1].text != "of") {
            // `using` is legal here too: `for (using x = res; cond; step)` holds the
            // resource for the whole loop and releases it when the loop ends.
            // parseStmt already knows the declaration form.
            init = Option.Some(parseStmt(&mut p, &mut prog))
        } else {
            let ie = parseCommaSeq(&mut p, &mut prog)
            init = Option.Some(addStmt(&mut prog, Stmt.ExprStmt(ie)))
            expect(&mut p, T_SEMI)
        }
        var cond: Option<ExprId> = Option.None
        if peekKind(p) != T_SEMI {
            // the test is an Expression too: `for (;a, b;)` is legal
            cond = Option.Some(parseCommaSeq(&mut p, &mut prog))
        }
        expect(&mut p, T_SEMI)
        var update: Option<ExprId> = Option.None
        if peekKind(p) != T_RPAREN {
            update = Option.Some(parseCommaSeq(&mut p, &mut prog))
        }
        expect(&mut p, T_RPAREN)
        let body = parseStmt(&mut p, &mut prog)
        return addStmt(&mut prog, Stmt.For(init, cond, update, body))
    }
    if k == T_BREAK {
        advance(&mut p)
        // `break label` — the label is only a label if it is on the SAME line.
        // Without that check, proxy-addr's
        //     if (!trust(addrs[i], i)) continue
        //     addrs.length = i + 1
        // took `addrs` as the label and then choked on the `.`, silently
        // mangling the function body.
        var blabel = ""
        if peekKind(p) == T_IDENT && !p.toks[p.pos].nlBefore {
            blabel = p.toks[p.pos].text.clone()
            advance(&mut p)
        }
        if peekKind(p) == T_SEMI {
            advance(&mut p)
        }
        return addStmt(&mut prog, Stmt.Break(blabel))
    }
    if k == T_CONTINUE {
        advance(&mut p)
        var clabel = ""
        if peekKind(p) == T_IDENT && !p.toks[p.pos].nlBefore {
            clabel = p.toks[p.pos].text.clone()
            advance(&mut p)
        }
        if peekKind(p) == T_SEMI {
            advance(&mut p)
        }
        return addStmt(&mut prog, Stmt.Continue(clabel))
    }
    if k == T_THROW {
        advance(&mut p)
        // `throw e.code = x, e` throws e — the comma operator is part of the
        // thrown Expression, not a statement separator (same rule as `return`).
        // Stopping at the comma threw the assignment's value instead, so prisma
        // errors arrived as the bare clientVersion string.
        let e = parseCommaSeq(&mut p, &mut prog)
        if peekKind(p) == T_SEMI {
            advance(&mut p)
        }
        return addStmt(&mut prog, Stmt.Throw(e))
    }
    if k == T_WITH {
        advance(&mut p)
        // strict code forbids it outright, and the tests check that it is an EARLY
        // error rather than a runtime one
        if p.strict {
            if !p.errored {
                p.errored = true
                if !p.quiet {
                    eprint("milojs: " + p.file + ": Strict mode code may not include a with statement\n")
                }
            }
        }
        expect(&mut p, T_LPAREN)
        let withObjE = parseExpr(&mut p, &mut prog)
        expect(&mut p, T_RPAREN)
        let withBody = parseStmt(&mut p, &mut prog)
        return addStmt(&mut prog, Stmt.With(withObjE, withBody))
    }
    if k == T_TRY {
        advance(&mut p)
        let tryB = parseBraceBlock(&mut p, &mut prog)
        var param = ""
        var catchB: Option<BlockId> = Option.None
        if peekKind(p) == T_CATCH {
            advance(&mut p)
            // A destructuring catch parameter, `catch ([a, b])` or `catch ({x})`.
            // Stmt.Try stores the parameter as a NAME, so a pattern cannot be
            // represented there; it is desugared instead, the way the for-of head
            // already is: bind the caught value to a temp and unpack it in a
            // declaration prepended to the catch block.
            var catchPat: Vec<DeclItem> = Vec.new()
            var catchDestructures = false
            if peekKind(p) == T_LPAREN {
                advance(&mut p)
                if isPatternStart(p) {
                    let ctmp = "__c" + i64ToStr(p.pos)
                    patternDecls(&mut p, &mut prog, ctmp.clone(), &mut catchPat)
                    param = ctmp
                    catchDestructures = true
                } else if isBindingName(p) {
                    param = p.toks[p.pos].text.clone()
                    advance(&mut p)
                }
                expect(&mut p, T_RPAREN)
            }
            let cbody = parseBraceBlock(&mut p, &mut prog)
            if catchDestructures {
                var cseq: Vec<StmtId> = Vec.new()
                cseq.push(declsToStmt(&mut prog, catchPat))
                cseq.push(addStmt(&mut prog, Stmt.Block(cbody)))
                catchB = Option.Some(addBlock(&mut prog, cseq))
            } else {
                catchB = Option.Some(cbody)
            }
        }
        var finallyB: Option<BlockId> = Option.None
        if peekKind(p) == T_FINALLY {
            advance(&mut p)
            finallyB = Option.Some(parseBraceBlock(&mut p, &mut prog))
        }
        return addStmt(&mut prog, Stmt.Try(tryB, param, catchB, finallyB))
    }
    if k == T_RETURN {
        advance(&mut p)
        var e: Option<ExprId> = Option.None
        let nk = peekKind(p)
        // ASI: a line break after `return` ends the statement, so
        // `return\n  value` returns undefined. Without this the next line is
        // swallowed as the returned expression.
        var retNl = false
        if p.pos < p.toks.len() && p.toks[p.pos].nlBefore {
            retNl = true
        }
        if nk != T_SEMI && nk != T_RBRACE && nk != T_EOF && !retNl {
            // `return a(), b` returns b — the comma operator is part of the
            // returned Expression, not a statement separator.
            e = Option.Some(parseCommaSeq(&mut p, &mut prog))
        }
        if e is Option.None {
            e = Option.Some(addExpr(&mut prog, Expr.UndefLit))
        }
        if peekKind(p) == T_SEMI {
            advance(&mut p)
        }
        return addStmt(&mut prog, Stmt.Ret(e!))
    }
    if k == T_LBRACE {
        let b = parseBraceBlock(&mut p, &mut prog)
        return addStmt(&mut prog, Stmt.Block(b))
    }
    // An ExpressionStatement is a full Expression, comma operator included.
    // Minified bundles chain whole statements this way: `f(3), i = 0;`
    let e = parseCommaSeq(&mut p, &mut prog)
    if peekKind(p) == T_SEMI {
        advance(&mut p)
    } else {
        // Nothing checked that the expression actually ENDED here, so `a b c`
        // parsed as `a` and then started over, silently dropping `b c`. ASI
        // still applies: atStatementEnd accepts `}`, EOF and a newline before
        // the next token.
        expectStatementEnd(&mut p)
    }
    return addStmt(&mut prog, Stmt.ExprStmt(e))
}

// class Name [extends Base] { [static] [async] name(params) { body } ... }
//
// Fields (instance and static), getters, setters, private members, computed
// keys, generator methods and `static { }` blocks all parse. The comment here
// used to say fields and getters were unsupported and that a getter parsed as a
// method; that stopped being true and nothing forced it to be revisited, which
// is the quietest kind of wrong doc: it under-claims, so nobody hits a bug, they
// just avoid a feature that works.
// `get`, `set` and `async` are CONTEXTUAL keywords. Inside a class body they
// introduce an accessor or a modifier only when a key can still follow. When the
// next token ends the member (`;`, `}`) or starts an initializer (`=`), the word
// is the field's own name: `class P { get; set = () => 1; }` declares fields
// called "get" and "set". Previously the parser committed to an accessor on
// seeing the word and then failed on the `=`, which is 28 of the QuickJS cases.
fn classWordIsFieldName(p: &PState): bool {
    if p.pos + 1 >= p.toks.len() {
        return true
    }
    let k = p.toks[p.pos + 1].kind
    return k == T_EQ || k == T_SEMI || k == T_RBRACE
}

fn parseClass(p: &mut PState, prog: &mut Prog): i64 {
    // `C.toString()` is the whole class text, so the span is recorded on the
    // constructor FuncDef — declared or synthesised — since that is the function
    // value a class becomes. is-callable rejects a class by regex-matching
    // /^\s*class\b/ against exactly this text.
    let classStartAt = p.toks[p.pos].at
    // a class body is ALWAYS strict, directive or not
    let classSaved = p.strict
    p.strict = true
    expect(&mut p, T_CLASS)
    var name = ""
    if peekKind(p) == T_IDENT {
        name = p.toks[p.pos].text.clone()
        advance(&mut p)
    }
    // the slot is reserved before the body is parsed so the class has a unique
    // index to key its super binding on while `super(...)` is being rewritten
    prog.classes.push(ClassDef {
        name: "", superKey: "", superName: "", superExpr: -1, ctorFn: -1, defaultCtor: -1, members: Vec.new(), staticFieldNames: Vec.new(), staticFieldInits: Vec.new(), staticFieldKeys: Vec.new()
    }
    )
    let classIdx = prog.classes.len() - 1
    let superKey = name.clone() + "$" + i64ToStr(classIdx)
    let savedClass = p.curClass.clone()
    p.curClass = superKey.clone()
    var superName = ""
    var superExpr: i64 = -1
    if peekKind(p) == T_EXTENDS {
        advance(&mut p)
        if peekKind(p) == T_IDENT && p.pos + 1 < p.toks.len() && p.toks[p.pos + 1].kind == T_LBRACE {
            superName = p.toks[p.pos].text.clone()
            advance(&mut p)
        } else {
            // ClassHeritage is a LeftHandSideExpression: `extends Mixin(Base)`,
            // `extends f().Base`, `extends null`, `extends class {}`. It used to
            // be skipped to the body, which silently made the class a base.
            superExpr = parsePostfix(&mut p, &mut prog).index
            superName = "__heritage$" + superKey.clone()
        }
    }
    expect(&mut p, T_LBRACE)
    let savedPrivDepth = p.privNames.len()
    scanPrivateDecls(&mut p, superKey)
    var ctorFn: i64 = -1
    var members: Vec<ClassMember> = Vec.new()
    // instance-field init statements (this.name = init), in declaration order,
    // and static-field (name, init) pairs collected while scanning the body
    var fieldStmts: Vec<StmtId> = Vec.new()
    var staticFieldNames: Vec<string> = Vec.new()
    var staticFieldKeys: Vec<Option<ExprId>> = Vec.new()
    var staticFieldInits: Vec<ExprId> = Vec.new()
    while peekKind(p) != T_RBRACE && peekKind(p) != T_EOF {
        if peekKind(p) == T_SEMI {
            advance(&mut p)
        } else {
            var isStatic = false
            var isAsyncM = false
            // node's toString for a class METHOD starts at the method name, not
            // at `static`; the static block form starts at `static`.
            let sbStartAt = p.toks[p.pos].at
            var cmStartAt = p.toks[p.pos].at
            // `static` is contextual in the same way (see classWordIsFieldName):
            // `static() {}` is a METHOD NAMED static, and `static = 1` a field
            // named static, neither of them a modifier.
            if peekKind(p) == T_IDENT && p.toks[p.pos].text == "static" && p.pos + 1 < p.toks.len() && p.toks[p.pos + 1].kind != T_LPAREN && !classWordIsFieldName(p) {
                isStatic = true
                advance(&mut p)
                cmStartAt = p.toks[p.pos].at
            }
            if isStatic && peekKind(p) == T_LBRACE {
                // `static { ... }` (ES2022). It was not parsed at all, and a
                // parse error is fatal — one static block anywhere killed the
                // whole file, not just the class. Modelled as a static field
                // with an EMPTY name whose initializer is a function; the class
                // builder calls it with `this` = the class and stores nothing.
                var sbParams: Vec<string> = Vec.new()
                let sbSaved = p.strict
                if bodyIsStrict(p) {
                    p.strict = true
                }
                let sbBody = parseBraceBlock(&mut p, &mut prog)
                prog.funcs.push(FuncDef {
                    name: "", params: sbParams, body: sbBody, paramPrelude: Option.None, isArrow: false, isAsync: false, restFrom: -1, isGenerator: false, isStrict: p.strict, isMethod: false, isClassCtor: false, srcStart: sbStartAt, srcEnd: p.toks[p.pos - 1].end, file: p.file.clone()
                }
                )
                p.strict = sbSaved
                staticFieldNames.push("")
                staticFieldInits.push(addExpr(&mut prog, Expr.FuncExpr(prog.funcs.len() - 1)))
                // the three vectors are parallel; a static block has no key
                staticFieldKeys.push(Option.None)
                continue
            }
            if peekKind(p) == T_ASYNC && p.pos + 1 < p.toks.len() && p.toks[p.pos + 1].kind != T_LPAREN && !classWordIsFieldName(p) {
                isAsyncM = true
                advance(&mut p)
            }
            var memberKind: i64 = 0
            if (peekKind(p) == T_IDENT && (p.toks[p.pos].text == "get" || p.toks[p.pos].text == "set")) && p.pos + 1 < p.toks.len() && p.toks[p.pos + 1].kind != T_LPAREN && !classWordIsFieldName(p) {
                if p.toks[p.pos].text == "get" {
                    memberKind = 1
                } else {
                    memberKind = 2
                }
                advance(&mut p)
            }
            // `*gen() {}` — the star precedes the key, and the method it makes
            // is a generator. It used to be consumed and dropped, so every class
            // generator method compiled to a plain function that ran its body to
            // completion and returned undefined.
            var isStarM = false
            if peekKind(p) == T_STAR {
                advance(&mut p)
                isStarM = true
            }
            var mname = ""
            var mkeyExpr: Option<ExprId> = Option.None
            // `[expr]() {}` — a computed key, the form `[Symbol.iterator]` takes
            if peekKind(p) == T_LBRACKET {
                advance(&mut p)
                mkeyExpr = Option.Some(parseExpr(&mut p, &mut prog))
                expect(&mut p, T_RBRACKET)
            } else {
                if isPropName(p) || peekKind(p) == T_STR {
                    mname = privName(p, p.toks[p.pos].text)
                }
                advance(&mut p)
            }
            if peekKind(p) == T_LPAREN {
                advance(&mut p)
                var mparams: Vec<string> = Vec.new()
                var mprelude: Vec<DeclItem> = Vec.new()
                var mrest: i64 = -1
                while peekKind(p) != T_RPAREN && peekKind(p) != T_EOF {
                    if parseParam(&mut p, &mut prog, &mut mparams, &mut mprelude) {
                        mrest = mparams.len() - 1
                    }
                    if peekKind(p) == T_COMMA {
                        advance(&mut p)
                    }
                }
                expect(&mut p, T_RPAREN)
                let mSaved = p.strict
                if bodyIsStrict(p) {
                    p.strict = true
                }
                let mbody = parseBraceBlock(&mut p, &mut prog)
                var cmParamPrelude: Option<StmtId> = Option.None
                if mprelude.len() > 0 {
                    let munpack = declsToStmt(&mut prog, mprelude)
                    if isStarM {
                        cmParamPrelude = Option.Some(munpack)
                    } else {
                        prependStmt(&mut prog, mbody, munpack)
                    }
                }
                prog.funcs.push(FuncDef {
                    name: mname.clone(), params: mparams, body: mbody, paramPrelude: cmParamPrelude, isArrow: false, isAsync: isAsyncM, restFrom: mrest, isGenerator: isStarM, isStrict: p.strict, isMethod: true, isClassCtor: false, srcStart: cmStartAt, srcEnd: p.toks[p.pos - 1].end, file: p.file.clone()
                }
                )
                p.strict = mSaved
                let fidx = prog.funcs.len() - 1
                if mname == "constructor" && !isStatic {
                    // the class CONSTRUCTOR is a class member syntactically but
                    // is the one that `new` must reach
                    prog.funcs[fidx].isMethod = false
                    prog.funcs[fidx].isClassCtor = true
                    // The class VALUE is this FuncDef, so its `name` is what
                    // `C.name` and `new C().constructor.name` report. Left as the
                    // member name, every class that declared a constructor
                    // answered "constructor" -- which is most of them, and it is
                    // how DOMException came out named "constructor". A class with
                    // no name keeps the empty one so the binding-name inference
                    // that already handles `const E = class {}` still applies.
                    if name.len() > 0 {
                        prog.funcs[fidx].name = name.clone()
                    } else {
                        prog.funcs[fidx].name = ""
                    }
                    ctorFn = fidx
                } else {
                    members.push(ClassMember {
                        name: mname, fnIdx: fidx, isStatic: isStatic, kind: memberKind, keyExpr: mkeyExpr
                    }
                    )
                }
            } else {
                // a class field `name = init` (or bare `name;`). Instance fields
                // become `this.name = init` in the constructor; static fields are
                // applied to the constructor object at class-build time.
                var initE = addExpr(&mut prog, Expr.UndefLit)
                if peekKind(p) == T_EQ {
                    advance(&mut p)
                    initE = parseExpr(&mut p, &mut prog)
                }
                if peekKind(p) == T_SEMI {
                    advance(&mut p)
                }
                if isStatic {
                    staticFieldNames.push(mname.clone())
                    staticFieldInits.push(initE)
                    staticFieldKeys.push(mkeyExpr)
                } else {
                    let thisE = addExpr(&mut prog, Expr.Ident("this"))
                    // `[expr] = init` — the computed key was parsed but then
                    // thrown away here, so every computed field was installed
                    // under the empty string and read back as undefined.
                    //
                    // Known divergence: the spec evaluates a computed key ONCE,
                    // when the class is defined. This re-evaluates it per
                    // construction, which is only observable for a key
                    // expression with side effects.
                    var keyE = addExpr(&mut prog, Expr.StrLit(mname.clone()))
                    if let Option.Some(ke) = mkeyExpr {
                        keyE = ke
                    }
                    let setE = addExpr(&mut prog, Expr.SetMember(thisE, keyE, initE))
                    fieldStmts.push(addStmt(&mut prog, Stmt.ExprStmt(setE)))
                }
            }
        }
    }
    expect(&mut p, T_RBRACE)
    p.curClass = savedClass
    // this class's private names leave scope with its body
    while p.privNames.len() > savedPrivDepth {
        let _ = p.privNames.pop()
        let _ = p.privOwners.pop()
    }
    // Inject instance-field initializers into a DECLARED constructor: prepend in
    // reverse so they run in declaration order at the top of the ctor. (milojs
    // binds `this` for the whole ctor, so this is fine even ahead of a super()
    // call in a derived ctor.) The default-ctor case is handled below, after the
    // super() forwarding call, so fields init after super as the spec requires.
    if ctorFn >= 0 && fieldStmts.len() > 0 {
        var fi = fieldStmts.len() - 1
        while fi >= 0 {
            prependStmt(&mut prog, prog.funcs[ctorFn].body, fieldStmts[fi])
            fi = fi - 1
        }
    }
    // a class with no constructor still needs a callable function to be the
    // class value. For a derived class the default constructor forwards to the
    // parent: `constructor(...args) { super(...args) }`. Without this, a subclass
    // that only inherits (ZodString extends ZodType) never runs the base
    // constructor and its instance fields (this._def) stay unset.
    var defaultBody: Vec<StmtId> = Vec.new()
    if superName.len() > 0 {
        let superRef = addExpr(&mut prog, Expr.Ident("__super$" + superKey.clone()))
        let argsRef = addExpr(&mut prog, Expr.Ident("arguments"))
        let spread = addExpr(&mut prog, Expr.Spread(argsRef))
        var callArgs: Vec<ExprId> = Vec.new()
        callArgs.push(spread)
        let callArgsId = addArgList(&mut prog, callArgs)
        let superCall = addExpr(&mut prog, Expr.Call(superRef, callArgsId))
        defaultBody.push(addStmt(&mut prog, Stmt.ExprStmt(superCall)))
    }
    // no declared ctor: the instance-field inits ARE (most of) the ctor body,
    // appended after any super() forwarding call
    if ctorFn < 0 {
        var fj: i64 = 0
        while fj < fieldStmts.len() {
            defaultBody.push(fieldStmts[fj])
            fj = fj + 1
        }
    }
    let defaultBlock = addBlock(&mut prog, defaultBody)
    var noParams: Vec<string> = Vec.new()
    prog.funcs.push(FuncDef {
        name: name.clone(), params: noParams, body: defaultBlock, paramPrelude: Option.None, isArrow: false, isAsync: false, restFrom: -1, isGenerator: false, isStrict: p.strict, isMethod: false, isClassCtor: false, srcStart: 0, srcEnd: 0, file: p.file.clone()
    }
    )
    let defaultCtor = prog.funcs.len() - 1
    prog.funcs[defaultCtor].isClassCtor = true
    let classEndAt = p.toks[p.pos - 1].end
    prog.funcs[defaultCtor].srcStart = classStartAt
    prog.funcs[defaultCtor].srcEnd = classEndAt
    if ctorFn >= 0 {
        prog.funcs[ctorFn].srcStart = classStartAt
        prog.funcs[ctorFn].srcEnd = classEndAt
    }
    p.strict = classSaved
    prog.classes[classIdx] = ClassDef {
        name: name, superKey: superKey, superName: superName, superExpr: superExpr, ctorFn: ctorFn, defaultCtor: defaultCtor, members: members, staticFieldNames: staticFieldNames, staticFieldInits: staticFieldInits, staticFieldKeys: staticFieldKeys
    }
    return classIdx
}

// require("<spec>") as an expression.
fn requireCall(prog: &mut Prog, spec: string): ExprId {
    let callee = addExpr(&mut prog, Expr.Ident("require"))
    var args: Vec<ExprId> = Vec.new()
    args.push(addExpr(&mut prog, Expr.StrLit(spec)))
    let argsId = addArgList(&mut prog, args)
    return addExpr(&mut prog, Expr.Call(callee, argsId))
}

// The interop read for a default import: `ns.__esModule ? ns.default : ns`.
// A module lowered from ESM source marks itself (see parseProgram), so its
// `export default` is found under `.default`; a real CommonJS module has no
// marker and `import fs from "fs"` has to yield module.exports itself. This is
// the same heuristic Babel and tsc emit for the same reason.
fn defaultInterop(prog: &mut Prog, tmp: &string): ExprId {
    let flagBase = addExpr(&mut prog, Expr.Ident(tmp.clone()))
    let flag = addExpr(&mut prog, Expr.Member(flagBase, "__esModule"))
    let hitBase = addExpr(&mut prog, Expr.Ident(tmp.clone()))
    let hit = addExpr(&mut prog, Expr.Member(hitBase, "default"))
    let miss = addExpr(&mut prog, Expr.Ident(tmp.clone()))
    return addExpr(&mut prog, Expr.Cond(flag, hit, miss))
}

// ESM `import` desugared onto the CommonJS loader:
//
//   import { a, b as c } from "m"   →   const __esm_N = require("m"),
//                                             a = __esm_N.a, c = __esm_N.b
//   import d, { a } from "m"        →   const __esm_N = require("m"),
//                                             d = <default interop>, a = __esm_N.a
//   import * as ns from "m"         →   const ns = require("m")
//   import "m"                      →   const __esm_N = require("m")
//
// One MultiDecl covers every form, which keeps this a single statement and so
// avoids threading extra statements out of parseStmt.
fn parseImport(p: &mut PState, prog: &mut Prog): StmtId {
    advance(&mut p)
    var items: Vec<DeclItem> = Vec.new()
    // unique per import so two imports in one file can't collide
    let tmp = "__esm_" + i64ToStr(prog.exprs.len())

    // import "m" — side effect only
    if peekKind(p) == T_STR {
        let spec = p.toks[p.pos].text.clone()
        advance(&mut p)
        if peekKind(p) == T_SEMI {
            advance(&mut p)
        }
        items.push(DeclItem {
            name: tmp, init: requireCall(&mut prog, spec), isVar: false
        }
        )
        let declarationsId = addDeclList(&mut prog, items)
        return addStmt(&mut prog, Stmt.MultiDecl(declarationsId))
    }

    // import * as ns from "m"
    var nsName = ""
    var defName = ""
    var named: Vec<string> = Vec.new()
    var locals: Vec<string> = Vec.new()
    // import d from "m" / import d, { a } from "m" / import d, * as ns from "m"
    if peekKind(p) == T_IDENT && p.toks[p.pos].text != "from" {
        defName = p.toks[p.pos].text.clone()
        advance(&mut p)
        if peekKind(p) == T_COMMA {
            advance(&mut p)
        }
    }
    if peekKind(p) == T_STAR {
        advance(&mut p)
        if peekKind(p) == T_IDENT && p.toks[p.pos].text == "as" {
            advance(&mut p)
        }
        nsName = p.toks[p.pos].text.clone()
        advance(&mut p)
    } else if peekKind(p) == T_LBRACE {
        advance(&mut p)
        while peekKind(p) != T_RBRACE && peekKind(p) != T_EOF {
            // `import { "string-name" as x }` — the imported name may be a string
            let imported = p.toks[p.pos].text.clone()
            advance(&mut p)
            var local = imported.clone()
            if peekKind(p) == T_IDENT && p.toks[p.pos].text == "as" {
                advance(&mut p)
                local = p.toks[p.pos].text.clone()
                advance(&mut p)
            }
            named.push(imported)
            locals.push(local)
            if peekKind(p) == T_COMMA {
                advance(&mut p)
            }
        }
        if peekKind(p) == T_RBRACE {
            advance(&mut p)
        }
    }

    // `from`
    if peekKind(p) == T_IDENT && p.toks[p.pos].text == "from" {
        advance(&mut p)
    }
    var spec = ""
    if peekKind(p) == T_STR {
        spec = p.toks[p.pos].text.clone()
        advance(&mut p)
    }
    if peekKind(p) == T_SEMI {
        advance(&mut p)
    }

    // one require per import statement, bound to a temp that every clause of
    // this import then reads — `import d, * as ns from "m"` must not load twice
    items.push(DeclItem {
        name: tmp.clone(), init: requireCall(&mut prog, spec), isVar: false
    }
    )
    if nsName.len() > 0 {
        items.push(DeclItem {
            name: nsName, init: addExpr(&mut prog, Expr.Ident(tmp.clone())), isVar: false
        }
        )
    }
    if defName.len() > 0 {
        items.push(DeclItem {
            name: defName, init: defaultInterop(&mut prog, tmp), isVar: false
        }
        )
    }
    var i: i64 = 0
    while i < named.len() {
        // index rather than member access, so string-named imports work
        let base = addExpr(&mut prog, Expr.Ident(tmp.clone()))
        let key = addExpr(&mut prog, Expr.StrLit(named[i].clone()))
        items.push(DeclItem {
            name: locals[i].clone(), init: addExpr(&mut prog, Expr.Index(base, key)), isVar: false
        }
        )
        i = i + 1
    }
    let declarationsId = addDeclList(&mut prog, items)
    return addStmt(&mut prog, Stmt.MultiDecl(declarationsId))
}

// Destructuring lowers to a hidden temp plus one declarator per bound name
// (`__d12`, `__a3`, `__f7`). Those temps are declarators like any other, so
// `export const { a, b } = obj` would otherwise export them alongside a and b.
fn isSyntheticTemp(name: &string): bool {
    if name.len() < 3 || name[0] != '_' || name[1] != '_' {
        return false
    }
    if name[2] != 'd' && name[2] != 'a' && name[2] != 'f' {
        return false
    }
    var i: i64 = 3
    while i < name.len() {
        // the array-pattern iterator temp is "__d<n>$it": everything from the
        // '$' on is a suffix on the same synthetic name, and missing that made
        // `export const [a] = xs` export the iterator temp alongside `a`
        if name[i] == '$' {
            return i > 3
        }
        if name[i] < '0' || name[i] > '9' {
            return false
        }
        i = i + 1
    }
    return name.len() > 3
}

// `exports.name = local` as a statement — the desugaring target for every
// `export` form.
fn exportAssign(prog: &mut Prog, name: string, local: string): StmtId {
    let obj = addExpr(&mut prog, Expr.Ident("exports"))
    let key = addExpr(&mut prog, Expr.StrLit(name))
    let val = addExpr(&mut prog, Expr.Ident(local))
    return addStmt(&mut prog, Stmt.ExprStmt(addExpr(&mut prog, Expr.SetMember(obj, key, val))))
}

// ESM `export` is only legal at the top level, so it is handled here rather than
// in parseStmt: the declaration is parsed normally and the matching
// `exports.x = x` statements are appended to the same statement list. Bindings
// are therefore snapshots, not ESM live bindings — see docs/milojs-quickjs-plan.md.
fn parseExport(p: &mut PState, prog: &mut Prog, list: &mut Vec<StmtId>) {
    advance(&mut p)
    let k = peekKind(p)

    // export default <expr>  →  exports.default = <expr>
    if k == T_DEFAULT {
        advance(&mut p)
        let obj = addExpr(&mut prog, Expr.Ident("exports"))
        let key = addExpr(&mut prog, Expr.StrLit("default"))
        let val = parseExpr(&mut p, &mut prog)
        list.push(addStmt(&mut prog, Stmt.ExprStmt(addExpr(&mut prog, Expr.SetMember(obj, key, val)))))
        if peekKind(p) == T_SEMI {
            advance(&mut p)
        }
        return
    }

    // export * from "m"  →  __esmStar(exports, require("m"))
    //
    // The helper copies own keys except `default`, which `export *` does not
    // re-export. It lives in the engine prelude because the copy loop has to run
    // at module-eval time, when the source module's exports object exists.
    if k == T_STAR {
        advance(&mut p)
        if peekKind(p) == T_IDENT && p.toks[p.pos].text == "from" {
            advance(&mut p)
        }
        var starSpec = ""
        if peekKind(p) == T_STR {
            starSpec = p.toks[p.pos].text.clone()
            advance(&mut p)
        }
        if peekKind(p) == T_SEMI {
            advance(&mut p)
        }
        let callee = addExpr(&mut prog, Expr.Ident("__esmStar"))
        var sargs: Vec<ExprId> = Vec.new()
        sargs.push(addExpr(&mut prog, Expr.Ident("exports")))
        sargs.push(requireCall(&mut prog, starSpec))
        let sargsId = addArgList(&mut prog, sargs)
        list.push(addStmt(&mut prog, Stmt.ExprStmt(addExpr(&mut prog, Expr.Call(callee, sargsId)))))
        return
    }

    // export { a, b as c }        →  exports.a = a; exports.c = b
    // export { a } from "m"       →  exports.a = require("m").a
    if k == T_LBRACE {
        advance(&mut p)
        var reLocals: Vec<string> = Vec.new()
        var reNames: Vec<string> = Vec.new()
        while peekKind(p) != T_RBRACE && peekKind(p) != T_EOF {
            var local = p.toks[p.pos].text.clone()
            advance(&mut p)
            var exported = local.clone()
            if peekKind(p) == T_IDENT && p.toks[p.pos].text == "as" {
                advance(&mut p)
                exported = p.toks[p.pos].text.clone()
                advance(&mut p)
            }
            reLocals.push(local)
            reNames.push(exported)
            if peekKind(p) == T_COMMA {
                advance(&mut p)
            }
        }
        if peekKind(p) == T_RBRACE {
            advance(&mut p)
        }
        var reSpec = ""
        if peekKind(p) == T_IDENT && p.toks[p.pos].text == "from" {
            advance(&mut p)
            if peekKind(p) == T_STR {
                reSpec = p.toks[p.pos].text.clone()
                advance(&mut p)
            }
        }
        if peekKind(p) == T_SEMI {
            advance(&mut p)
        }
        var ri: i64 = 0
        if reSpec.len() > 0 {
            // re-export: the names are the source module's, not local bindings,
            // so read them off one shared require temp
            let tmp = "__esm_" + i64ToStr(prog.exprs.len())
            var items: Vec<DeclItem> = Vec.new()
            items.push(DeclItem {
                name: tmp.clone(), init: requireCall(&mut prog, reSpec), isVar: false
            }
            )
            list.push(addStmt(&mut prog, Stmt.MultiDecl(addDeclList(&mut prog, items))))
            while ri < reNames.len() {
                let obj = addExpr(&mut prog, Expr.Ident("exports"))
                let key = addExpr(&mut prog, Expr.StrLit(reNames[ri].clone()))
                let base = addExpr(&mut prog, Expr.Ident(tmp.clone()))
                let srcKey = addExpr(&mut prog, Expr.StrLit(reLocals[ri].clone()))
                let val = addExpr(&mut prog, Expr.Index(base, srcKey))
                list.push(addStmt(&mut prog, Stmt.ExprStmt(addExpr(&mut prog, Expr.SetMember(obj, key, val)))))
                ri = ri + 1
            }
        } else {
            while ri < reNames.len() {
                list.push(exportAssign(&mut prog, reNames[ri].clone(), reLocals[ri].clone()))
                ri = ri + 1
            }
        }
        return
    }

    // export <decl> — emit the declaration, then export every name it bound
    let s = parseStmt(&mut p, &mut prog)
    list.push(s)
    match prog.stmts[s.index] {
        Stmt.FuncDecl(f) => {
            let n = prog.funcs[f].name.clone()
            if n.len() > 0 {
                list.push(exportAssign(&mut prog, n.clone(), n))
            }
        }
        Stmt.ClassDecl(c) => {
            let n = prog.classes[c].name.clone()
            if n.len() > 0 {
                list.push(exportAssign(&mut prog, n.clone(), n))
            }
        }
        Stmt.MultiDecl(d) => {
            var i: i64 = 0
            while i < prog.declLists[d.index].len() {
                let n = prog.declLists[d.index][i].name.clone()
                if n.len() > 0 && !isSyntheticTemp(n) {
                    list.push(exportAssign(&mut prog, n.clone(), n))
                }
                i = i + 1
            }
        }
        _ => {
        }
    }
}

// A "use strict" directive at the head of a function BODY. Checked by peeking
// rather than by inspecting the parsed block, because the flag has to be set
// before the body is parsed: every FuncDef built inside it inherits it.
fn bodyIsStrict(p: &PState): bool {
    if p.pos + 1 >= p.toks.len() {
        return false
    }
    if p.toks[p.pos].kind != T_LBRACE {
        return false
    }
    return p.toks[p.pos + 1].kind == T_STR && p.toks[p.pos + 1].text == "use strict"
}

// The same directive at the head of a MODULE, where there is no brace.
fn programIsStrict(p: &PState): bool {
    if p.toks.len() == 0 {
        return false
    }
    return p.toks[0].kind == T_STR && p.toks[0].text == "use strict"
}

pub fn parseProgram(p: &mut PState, prog: &mut Prog): BlockId {
    // Assigned, not OR-ed: every module parse goes through here, and the LAST
    // parse is the entry program whose strictness the driver reads.
    // OR, not assign: a module body is strict code with no directive at all, and
    // the caller has already set p.strict for one. Assigning here dropped it and
    // every function in an ESM module parsed sloppy.
    prog.progStrict = programIsStrict(p) || p.strict
    if prog.progStrict {
        p.strict = true
    }
    var list: Vec<StmtId> = Vec.new()
    var sawExport = false
    while peekKind(p) != T_EOF {
        if peekKind(p) == T_EXPORT {
            sawExport = true
            parseExport(&mut p, &mut prog, &mut list)
        } else {
            list.push(parseStmt(&mut p, &mut prog))
        }
    }
    checkDupDecls(&mut p, prog, list)
    if sawExport {
        // `__esmMark(exports)` first, so that a circular import observes the
        // marker even mid-initialization. It is what tells a default import to
        // read `.default` instead of taking module.exports whole; see
        // defaultInterop.
        let callee = addExpr(&mut prog, Expr.Ident("__esmMark"))
        var margs: Vec<ExprId> = Vec.new()
        margs.push(addExpr(&mut prog, Expr.Ident("exports")))
        var marked: Vec<StmtId> = Vec.new()
        marked.push(addStmt(&mut prog, Stmt.ExprStmt(addExpr(&mut prog, Expr.Call(callee, addArgList(&mut prog, margs))))))
        var mi: i64 = 0
        while mi < list.len() {
            marked.push(list[mi])
            mi = mi + 1
        }
        return addBlock(&mut prog, marked)
    }
    return addBlock(&mut prog, list)
}
