// Build identity, in milo's shape: `<bin> <semver> (<build>)`.
//
// `.version` carries only the BUILD half. It is committed as "dev" so a plain
// `milo build` works in a fresh checkout, and is overwritten just before the
// compile by whoever knows the commit: release CI writes "<sha> <date>",
// tools/dev.sh writes "dev <sha>" and restores it afterwards. Without it a
// binary from the rolling `latest` tag cannot say what it is, which makes bug
// reports unattributable.
let MILOJS_VERSION: string = "0.1.0"

// `bin` names the binary asking: both ship from the same release tarball, so a
// bug report has to say which one it came from.
fn versionLine(bin: &string): string {
    return bin.clone() + " " + MILOJS_VERSION + " (" + @embedFile("../../.version").trim() + ")"
}

pub fn versionText(bin: &string): string {
    return versionLine(bin) + "\nhttps://github.com/milo-language/milojs/releases — rolling `latest`; re-run the install command to update"
}
