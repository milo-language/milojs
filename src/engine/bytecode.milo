// A bytecode path for numeric `for` loops. This is an EXPERIMENT, not the VM:
// it exists to price a dispatch loop against the tree walker on identical work
// before anyone commits to rewriting the evaluator.
//
// The repo's own paired benches already showed that every mechanism-level fix
// is worth 1.2-1.8x (localRead 462x vs deepRead 570x isolates the scope-chain
// walk; propFew 653x vs propMany 768x isolates the property scan). What they
// cannot price is the tree walk itself. This can.
//
// Scope: a `for` statement whose init, condition, update and body mention only
// numbers, arithmetic, comparisons, `if`, `while` and nested blocks. No calls,
// no property access, no strings, no closures, no break/continue/return/throw.
// Anything else compiles to None and the tree walker runs the loop exactly as
// before, so no conformance number can move.
//
// The subset allocates nothing, so no value on this stack is ever a heap value:
// the collector cannot see this stack and does not need to. That is the only
// reason a partial VM is safe to run ahead of the rooting work in
// docs/milojs-arena-safety.md.
//
// MEASURED, so the next step is not guessed at: converting this stack and its
// locals to `Vec<JSValue>`, changing nothing else, costs 2x (emptyLoop 18->38ms,
// arith 38->78ms, numRead 38->78ms, localRead and deepRead 18->28ms). A real VM
// has to carry boxed values, so the ~12x this shows over the tree walker is
// really ~6x once it does, and that 2x comes back only from the value
// representation (NaN-boxing, or unboxed local slots), not from more opcodes.
// The number is a lower bound: that experiment kept the numeric-only subset, so
// it paid for boxing but not for the per-operand type check and slow path a
// general VM also needs.
//
// It also means skipping the per-statement `maybeGc` safepoint is not a
// deferral but a no-op: `maybeGc` collects on `allocSinceGc >= gcThreshold`, and
// a compiled loop never allocates, so the counter it reads cannot move while
// one runs. There is no interrupt or deadline check riding on that safepoint.

from "./ast" import {
    Prog, Expr, Stmt, ExprId, StmtId, BlockId
}
from "./value" import {
    JSValue
}
from "./runtime" import {
    Interp, scopeTryLookup, scopeAssign
}

// An enum rather than integer opcodes so the dispatch `match` lowers to a jump
// table. (Checked: milo compiles a 200-arm match on a dense enum to an offset
// table plus one indirect branch.)
enum Op {
    Const,
    Load,
    Store,
    Add,
    Sub,
    Mul,
    Div,
    Mod,
    Neg,
    Lt,
    Gt,
    Le,
    Ge,
    Eq,
    Ne,
    Jmp,
    Jmpf,
    Pop,
    // Leave the chunk with the value on top of the stack as the function's
    // result. Only a body chunk may contain one: a loop chunk that swallowed a
    // `return` would run the loop and then carry on past it.
    Ret,
    Halt,
}

pub struct Chunk {
    ops: Vec<Op>,
    args: Vec<i64>,
    consts: Vec<f64>,
    // slot -> the name it stands for. Outer slots are seeded from the enclosing
    // scope on entry and written back on exit; slots the loop declares itself
    // are neither, because nothing outside can observe them.
    slotNames: Vec<string>,
    slotOuter: Vec<bool>,
}

struct Comp {
    ops: Vec<Op>,
    args: Vec<i64>,
    consts: Vec<f64>,
    slotNames: Vec<string>,
    slotOuter: Vec<bool>,
    ok: bool,
    // A `return` compiles only for a whole function body. compileFor leaves this
    // false, so a loop containing one is rejected rather than silently losing it.
    allowRet: bool,
}

fn emitOp(c: &mut Comp, op: Op, a: i64): i64 {
    let at = c.ops.len()
    c.ops.push(op)
    c.args.push(a)
    return at
}

fn constSlot(c: &mut Comp, v: f64): i64 {
    var i: i64 = 0
    while i < c.consts.len() {
        if c.consts[i] == v {
            return i
        }
        i = i + 1
    }
    c.consts.push(v)
    return c.consts.len() - 1
}

// Find the slot for `name`, adding one if this is its first mention. `declared`
// marks a name the loop itself binds, which is what makes it not-outer.
fn slotOf(c: &mut Comp, name: &string, declared: bool): i64 {
    var i: i64 = 0
    while i < c.slotNames.len() {
        if c.slotNames[i] == name {
            return i
        }
        i = i + 1
    }
    c.slotNames.push(name.clone())
    c.slotOuter.push(!declared)
    return c.slotNames.len() - 1
}

fn binOpFor(op: &string): Op {
    if op == "+" {
        return Op.Add
    }
    if op == "-" {
        return Op.Sub
    }
    if op == "*" {
        return Op.Mul
    }
    if op == "/" {
        return Op.Div
    }
    if op == "%" {
        return Op.Mod
    }
    if op == "<" {
        return Op.Lt
    }
    if op == ">" {
        return Op.Gt
    }
    if op == "<=" {
        return Op.Le
    }
    if op == ">=" {
        return Op.Ge
    }
    if op == "===" {
        return Op.Eq
    }
    if op == "!==" {
        return Op.Ne
    }
    return Op.Halt
}

// Compile one expression, leaving its value on the stack. Sets c.ok false for
// anything outside the subset; callers keep walking but the result is discarded.
fn compExpr(prog: &Prog, c: &mut Comp, id: ExprId) {
    if !c.ok {
        return
    }
    match prog.exprs[id.index] {
        Expr.Num(n) => {
            let k = constSlot(c, n)
            emitOp(c, Op.Const, k)
        }
        Expr.Ident(name) => {
            let s = slotOf(c, name, false)
            emitOp(c, Op.Load, s)
        }
        Expr.Bin(op, a, b) => {
            let o = binOpFor(op)
            match o {
                Op.Halt => {
                    c.ok = false
                }
                _ => {
                    compExpr(prog, c, a)
                    compExpr(prog, c, b)
                    emitOp(c, o, 0)
                }
            }
        }
        Expr.Un(op, a) => {
            if op == "-" {
                compExpr(prog, c, a)
                emitOp(c, Op.Neg, 0)
            } else {
                c.ok = false
            }
        }
        Expr.Assign(name, rhs) => {
            compExpr(prog, c, rhs)
            let s = slotOf(c, name, false)
            emitOp(c, Op.Store, s)
            emitOp(c, Op.Load, s)
        }
        Expr.CompoundAssign(target, op, rhs) => {
            match prog.exprs[target.index] {
                Expr.Ident(name) => {
                    let s = slotOf(c, name, false)
                    emitOp(c, Op.Load, s)
                    compExpr(prog, c, rhs)
                    let o = binOpFor(op)
                    match o {
                        Op.Halt => {
                            c.ok = false
                        }
                        _ => {
                            emitOp(c, o, 0)
                            emitOp(c, Op.Store, s)
                            emitOp(c, Op.Load, s)
                        }
                    }
                }
                _ => {
                    c.ok = false
                }
            }
        }
        Expr.Update(target, isInc, isPrefix) => {
            match prog.exprs[target.index] {
                Expr.Ident(name) => {
                    let s = slotOf(c, name, false)
                    let one = constSlot(c, 1.0)
                    if isPrefix {
                        emitOp(c, Op.Load, s)
                        emitOp(c, Op.Const, one)
                        if isInc {
                            emitOp(c, Op.Add, 0)
                        } else {
                            emitOp(c, Op.Sub, 0)
                        }
                        emitOp(c, Op.Store, s)
                        emitOp(c, Op.Load, s)
                    } else {
                        emitOp(c, Op.Load, s)
                        emitOp(c, Op.Load, s)
                        emitOp(c, Op.Const, one)
                        if isInc {
                            emitOp(c, Op.Add, 0)
                        } else {
                            emitOp(c, Op.Sub, 0)
                        }
                        emitOp(c, Op.Store, s)
                    }
                }
                _ => {
                    c.ok = false
                }
            }
        }
        _ => {
            c.ok = false
        }
    }
}

fn compStmt(prog: &Prog, c: &mut Comp, id: StmtId) {
    if !c.ok {
        return
    }
    match prog.stmts[id.index] {
        Stmt.Empty => {
        }
        Stmt.ExprStmt(e) => {
            compExpr(prog, c, e)
            emitOp(c, Op.Pop, 0)
        }
        Stmt.Block(b) => {
            var i: i64 = 0
            while i < prog.blocks[b.index].len() {
                compStmt(prog, c, prog.blocks[b.index][i])
                i = i + 1
            }
        }
        Stmt.MultiDecl(listIdx) => {
            var i: i64 = 0
            while i < prog.declLists[listIdx.index].len() {
                // `var` escapes the loop to the enclosing function scope, so a
                // slot that is never written back would lose it. Rejected rather
                // than handled: the subset does not need it.
                if prog.declLists[listIdx.index][i].isVar {
                    c.ok = false
                    return
                }
                compExpr(prog, c, prog.declLists[listIdx.index][i].init)
                let s = slotOf(c, prog.declLists[listIdx.index][i].name, true)
                emitOp(c, Op.Store, s)
                i = i + 1
            }
        }
        Stmt.If(cond, then, els) => {
            compExpr(prog, c, cond)
            let jf = emitOp(c, Op.Jmpf, 0)
            compStmt(prog, c, then)
            match els {
                Option.Some(e) => {
                    let jend = emitOp(c, Op.Jmp, 0)
                    c.args[jf] = c.ops.len()
                    compStmt(prog, c, e)
                    c.args[jend] = c.ops.len()
                }
                Option.None => {
                    c.args[jf] = c.ops.len()
                }
            }
        }
        Stmt.Ret(e) => {
            if !c.allowRet {
                c.ok = false
                return
            }
            compExpr(prog, c, e)
            emitOp(c, Op.Ret, 0)
        }
        Stmt.While(cond, body) => {
            let top = c.ops.len()
            compExpr(prog, c, cond)
            let jf = emitOp(c, Op.Jmpf, 0)
            compStmt(prog, c, body)
            emitOp(c, Op.Jmp, top)
            c.args[jf] = c.ops.len()
        }
        _ => {
            c.ok = false
        }
    }
}

// Compile a `for` statement, or answer None when any part of it falls outside
// the subset.
pub fn compileFor(prog: &Prog, id: StmtId): Option<Chunk> {
    match prog.stmts[id.index] {
        Stmt.For(init, cond, update, body) => {
            var c = Comp {
                ops: Vec.new(), args: Vec.new(), consts: Vec.new(),
                slotNames: Vec.new(), slotOuter: Vec.new(), ok: true, allowRet: false,
            }
            if let Option.Some(s) = init {
                compStmt(prog, c, s)
            }
            let top = c.ops.len()
            match cond {
                Option.Some(e) => {
                    compExpr(prog, c, e)
                }
                Option.None => {
                    let k = constSlot(c, 1.0)
                    emitOp(c, Op.Const, k)
                }
            }
            let jf = emitOp(c, Op.Jmpf, 0)
            compStmt(prog, c, body)
            if let Option.Some(e) = update {
                compExpr(prog, c, e)
                emitOp(c, Op.Pop, 0)
            }
            emitOp(c, Op.Jmp, top)
            c.args[jf] = c.ops.len()
            emitOp(c, Op.Halt, 0)
            if !c.ok {
                return Option.None
            }
            return Option.Some(Chunk {
                ops: c.ops, args: c.args, consts: c.consts,
                slotNames: c.slotNames, slotOuter: c.slotOuter,
            })
        }
        _ => {
            return Option.None
        }
    }
}

fn boolNum(b: bool): JSValue {
    if b {
        return JSValue.Number(1.0)
    }
    return JSValue.Number(0.0)
}

// The compiled subset only ever produces numbers, so a non-number can only come
// from a seeding bug. 0.0 keeps the loop total rather than adding a branch per
// operand.
fn vmNum(st: &Interp, at: i64): f64 {
    match st.vmStack[at] {
        JSValue.Number(n) => {
            return n
        }
        _ => {
            return 0.0
        }
    }
}

// Write one slot, growing the stack the first time that depth is reached.
fn vmSet(st: &mut Interp, at: i64, v: JSValue) {
    while st.vmStack.len() <= at {
        st.vmStack.push(JSValue.Undefined)
    }
    st.vmStack[at] = v
}

fn vmPush(st: &mut Interp, v: JSValue) {
    let at = st.vmSp
    vmSet(st, at, v)
    st.vmSp = at + 1
}

// Run a compiled loop. Answers false without touching anything when an outer
// name the loop reads is missing or is not a number, in which case the caller
// must run the tree walker instead.
// Answers None when the chunk cannot run and the caller must fall back to the
// tree walker; that decision is made before any side effect. Otherwise answers
// the value the body returned, or Undefined for a loop chunk and for a body that
// fell off its end.
pub fn runChunk(ch: &Chunk, st: &mut Interp, scope: i64): Option<JSValue> {
    let nslots = ch.slotNames.len()
    let base = st.vmSp

    // Seed the frame's locals. An outer name that is missing, or is bound to
    // anything but a number, means this chunk cannot run: the caller falls back
    // to the tree walker, and nothing has been written yet.
    var i: i64 = 0
    while i < nslots {
        var seed = JSValue.Number(0.0)
        if ch.slotOuter[i] {
            match scopeTryLookup(st, scope, ch.slotNames[i]) {
                Option.Some(v) => {
                    match v {
                        JSValue.Number(n) => {
                            seed = JSValue.Number(n)
                        }
                        _ => {
                            st.vmSp = base
                            return Option.None
                        }
                    }
                }
                Option.None => {
                    st.vmSp = base
                    return Option.None
                }
            }
        }
        vmPush(st, seed)
        i = i + 1
    }

    // Reserve the frame's whole operand range up front and root it once, rather
    // than restating vmSp after every instruction. Sound because no op in this
    // subset allocates, so no collect can land mid-loop, and every reserved slot
    // holds a number, so rooting a slot the loop is not using costs nothing.
    // A widened subset that can allocate must go back to an exact vmSp at each
    // op that can collect, or clear the slots above the live top.
    var need: i64 = 0
    var d: i64 = 0
    while d < ch.ops.len() {
        match ch.ops[d] {
            Op.Const => {
                need = need + 1
            }
            Op.Load => {
                need = need + 1
            }
            _ => {
            }
        }
        d = d + 1
    }
    var reserved: i64 = 0
    while reserved < need {
        vmPush(st, JSValue.Number(0.0))
        reserved = reserved + 1
    }

    var retVal = JSValue.Undefined
    var sp = base + nslots
    var pc: i64 = 0
    while pc < ch.ops.len() {
        let a = ch.args[pc]
        match ch.ops[pc] {
            Op.Const => {
                vmSet(st, sp, JSValue.Number(ch.consts[a]))
                sp = sp + 1
                pc = pc + 1
            }
            Op.Load => {
                vmSet(st, sp, JSValue.Number(vmNum(st, base + a)))
                sp = sp + 1
                pc = pc + 1
            }
            Op.Store => {
                sp = sp - 1
                let v = vmNum(st, sp)
                st.vmStack[base + a] = JSValue.Number(v)
                pc = pc + 1
            }
            Op.Add => {
                sp = sp - 1
                let v = vmNum(st, sp - 1) + vmNum(st, sp)
                st.vmStack[sp - 1] = JSValue.Number(v)
                pc = pc + 1
            }
            Op.Sub => {
                sp = sp - 1
                let v = vmNum(st, sp - 1) - vmNum(st, sp)
                st.vmStack[sp - 1] = JSValue.Number(v)
                pc = pc + 1
            }
            Op.Mul => {
                sp = sp - 1
                let v = vmNum(st, sp - 1) * vmNum(st, sp)
                st.vmStack[sp - 1] = JSValue.Number(v)
                pc = pc + 1
            }
            Op.Div => {
                sp = sp - 1
                let v = vmNum(st, sp - 1) / vmNum(st, sp)
                st.vmStack[sp - 1] = JSValue.Number(v)
                pc = pc + 1
            }
            Op.Mod => {
                sp = sp - 1
                let v = vmNum(st, sp - 1) % vmNum(st, sp)
                st.vmStack[sp - 1] = JSValue.Number(v)
                pc = pc + 1
            }
            Op.Neg => {
                let v = -vmNum(st, sp - 1)
                st.vmStack[sp - 1] = JSValue.Number(v)
                pc = pc + 1
            }
            Op.Lt => {
                sp = sp - 1
                let r = vmNum(st, sp - 1) < vmNum(st, sp)
                st.vmStack[sp - 1] = boolNum(r)
                pc = pc + 1
            }
            Op.Gt => {
                sp = sp - 1
                let r = vmNum(st, sp - 1) > vmNum(st, sp)
                st.vmStack[sp - 1] = boolNum(r)
                pc = pc + 1
            }
            Op.Le => {
                sp = sp - 1
                let r = vmNum(st, sp - 1) <= vmNum(st, sp)
                st.vmStack[sp - 1] = boolNum(r)
                pc = pc + 1
            }
            Op.Ge => {
                sp = sp - 1
                let r = vmNum(st, sp - 1) >= vmNum(st, sp)
                st.vmStack[sp - 1] = boolNum(r)
                pc = pc + 1
            }
            Op.Eq => {
                sp = sp - 1
                let r = vmNum(st, sp - 1) == vmNum(st, sp)
                st.vmStack[sp - 1] = boolNum(r)
                pc = pc + 1
            }
            Op.Ne => {
                sp = sp - 1
                let r = vmNum(st, sp - 1) != vmNum(st, sp)
                st.vmStack[sp - 1] = boolNum(r)
                pc = pc + 1
            }
            Op.Jmp => {
                pc = a
            }
            Op.Jmpf => {
                sp = sp - 1
                if vmNum(st, sp) == 0.0 {
                    pc = a
                } else {
                    pc = pc + 1
                }
            }
            Op.Pop => {
                sp = sp - 1
                pc = pc + 1
            }
            Op.Ret => {
                sp = sp - 1
                retVal = JSValue.Number(vmNum(st, sp))
                pc = ch.ops.len()
            }
            Op.Halt => {
                pc = ch.ops.len()
            }
        }
    }

    var k: i64 = 0
    while k < nslots {
        if ch.slotOuter[k] {
            let v = vmNum(st, base + k)
            scopeAssign(st, scope, ch.slotNames[k], JSValue.Number(v))
        }
        k = k + 1
    }
    // Drop the whole frame in one move: everything at or above vmSp is dead and
    // collect stops marking there.
    st.vmSp = base
    return Option.Some(retVal)
}

// One compiled chunk per `for` statement, keyed by its StmtId index.
// gLoopIdx[i] is 0 before the statement has been looked at, -1 once it has been
// rejected, and chunk index + 1 once it compiled.
var gLoopChunks: Vec<Chunk> = Vec.new()
var gLoopIdx: Vec<i64> = Vec.new()

// Run this `for` through the compiled path, or answer false to say the tree
// walker still has to run it. Compilation happens once per statement.
pub fn tryRunFor(prog: &Prog, id: StmtId, st: &mut Interp, scope: i64): bool {
    while gLoopIdx.len() <= id.index {
        gLoopIdx.push(0)
    }
    var slot = gLoopIdx[id.index]
    if slot == 0 {
        match compileFor(prog, id) {
            Option.Some(ch) => {
                gLoopChunks.push(ch)
                slot = gLoopChunks.len()
            }
            Option.None => {
                slot = -1
            }
        }
        gLoopIdx[id.index] = slot
    }
    if slot < 0 {
        return false
    }
    if let Option.Some(_v) = runChunk(gLoopChunks[slot - 1], st, scope) {
        return true
    }
    return false
}


// One compiled chunk per function body, keyed by its index in prog.funcs. Same
// three states as gLoopIdx.
var gBodyChunks: Vec<Chunk> = Vec.new()
var gBodyIdx: Vec<i64> = Vec.new()

// Compile a whole function body, or answer None. Worth far more than the `for`
// hook it sits beside: node's test/parallel has 618 loops and 21,617 function
// bodies, and the same numeric subset covers 8.6% of the bodies against 1.0% of
// the loops.
//
// Generators and async bodies are rejected outright. Their control flow leaves
// and re-enters the body, which a chunk that runs to completion cannot express.
// So is a paramPrelude, which is the desugaring of destructured and defaulted
// parameters and is a statement the caller runs, not part of the body.
pub fn compileBody(prog: &Prog, fIdx: i64): Option<Chunk> {
    if prog.funcs[fIdx].isGenerator || prog.funcs[fIdx].isAsync {
        return Option.None
    }
    if let Option.Some(_p) = prog.funcs[fIdx].paramPrelude {
        return Option.None
    }
    var c = Comp {
        ops: Vec.new(), args: Vec.new(), consts: Vec.new(),
        slotNames: Vec.new(), slotOuter: Vec.new(), ok: true, allowRet: true,
    }
    let body = prog.funcs[fIdx].body
    var i: i64 = 0
    while i < prog.blocks[body.index].len() {
        compStmt(prog, c, prog.blocks[body.index][i])
        i = i + 1
    }
    emitOp(c, Op.Halt, 0)
    if !c.ok {
        return Option.None
    }
    return Option.Some(Chunk {
        ops: c.ops, args: c.args, consts: c.consts,
        slotNames: c.slotNames, slotOuter: c.slotOuter,
    })
}

// Run this function body as bytecode, or answer None to say the tree walker
// still has to run it. Compilation happens once per function.
pub fn tryRunBody(prog: &Prog, fIdx: i64, st: &mut Interp, scope: i64): Option<JSValue> {
    while gBodyIdx.len() <= fIdx {
        gBodyIdx.push(0)
    }
    var slot = gBodyIdx[fIdx]
    if slot == 0 {
        match compileBody(prog, fIdx) {
            Option.Some(ch) => {
                gBodyChunks.push(ch)
                slot = gBodyChunks.len()
            }
            Option.None => {
                slot = -1
            }
        }
        gBodyIdx[fIdx] = slot
    }
    if slot < 0 {
        return Option.None
    }
    return runChunk(gBodyChunks[slot - 1], st, scope)
}

// Drop every cached chunk. The cache is keyed by an index into the program
// arena, so a fresh program reusing those indices would otherwise run another
// statement's code.
pub fn resetLoopCache() {
    gLoopChunks.clear()
    gLoopIdx.clear()
    gBodyChunks.clear()
    gBodyIdx.clear()
}
