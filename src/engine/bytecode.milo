// A bytecode path for numeric `for` loops. This is an EXPERIMENT, not the VM:
// it exists to price a dispatch loop against the tree walker on identical work
// before anyone commits to rewriting the evaluator.
//
// The repo's own paired benches already showed that every mechanism-level fix
// is worth 1.2-1.8x (localRead 462x vs deepRead 570x isolates the scope-chain
// walk; propFew 653x vs propMany 768x isolates the property scan). What they
// cannot price is the tree walk itself. This can.
//
// Scope: a `for` statement, or a whole function body, built from numbers,
// strings, locals, arithmetic, comparisons, `if`, `while`, `return`, property
// reads and writes, object literals, and calls of a plain identifier. Anything
// else compiles to None and the tree walker runs it exactly as before.
//
// THE STACK IS A GC ROOT, and only up to `st.vmSp`: `collect` marks 0..vmSp and
// nothing above it. So every op that can allocate (or that can re-enter the
// evaluator, which can allocate) must publish its EXACT live top into st.vmSp
// first. Anything left above vmSp is swept, and the symptom is an intermittent
// wrong answer rather than a crash. Run the fixtures under
// MILOJS_GC_THRESHOLD=1 after touching any op that calls out.
//
// CALLS STAY INSIDE THE DISPATCH LOOP. A compiled callee gets a VmFrame and
// `pc = 0` in the same runChunk invocation, because runChunk's own native frame
// is large: routing each compiled call back out through callValue ->
// callFunctionBody -> runChunk collapsed recursion depth from 2156 frames to 1.
// A callee that does not compile (a native, a generator, an async or bound
// function, a proxy) still costs one native round trip through callPlainValue,
// which is what the tree walker pays for every call anyway.
//
// MEASURED, so the next step is not guessed at: converting this stack and its
// locals to `Vec<JSValue>`, changing nothing else, costs 2x (emptyLoop 18->38ms,
// arith 38->78ms, numRead 38->78ms, localRead and deepRead 18->28ms). A real VM
// has to carry boxed values, so the ~12x this shows over the tree walker is
// really ~6x once it does, and that 2x comes back only from the value
// representation (NaN-boxing, or unboxed local slots), not from more opcodes.
// The number is a lower bound: that experiment kept the numeric-only subset, so
// it paid for boxing but not for the per-operand type check and slow path a
// general VM also needs.
//
// The VM's one `maybeGc` safepoint is Op.Call, because a call is where a
// compiled program allocates: a scope and an `arguments` array per frame. There
// is none per op and none per loop iteration, so a compiled loop that allocates
// runs to its end before the heap is looked at. Nothing else rides on the
// safepoint: no interrupt, no deadline check.

from "./ast" import {
    Prog, Expr, Stmt, ExprId, StmtId, BlockId
}
from "./value" import {
    JSValue, cloneValue, truthy
}
from "./runtime" import {
    Interp, scopeTryLookup, scopeAssign, newObject, pushActive, popActive,
    maybeGc
}
from "./eval" import {
    evalBinValues, toNumProg, toNumArg, memberOfValue, setMemberOfValue,
    bindActivationScope, callGuardTripped, callPlainValue, isPlainCallable,
    throwNotAFunction, isSuperName
}

// An enum rather than integer opcodes so the dispatch `match` lowers to a jump
// table. (Checked: milo compiles a 200-arm match on a dense enum to an offset
// table plus one indirect branch.)
enum Op {
    Const,
    // push strs[a]
    Str,
    Load,
    Store,
    Add,
    Sub,
    Mul,
    Div,
    Mod,
    Neg,
    Lt,
    Gt,
    Le,
    Ge,
    Eq,
    Ne,
    Jmp,
    Jmpf,
    // Read strs[a] off the value on top, REPLACING it with the property. Used
    // for a plain `o.x`.
    GetMem,
    // Write strs[a]. Stack is [receiver, value]; both are replaced by the value,
    // because an assignment is an expression whose result is what was assigned.
    SetMem,
    // A fresh `{}`. It goes straight onto the frame, so it is rooted from the
    // instant it exists: nothing allocates between newObject and the store.
    NewObj,
    // Copy the top of the stack. Only used to keep an object literal's receiver
    // under each property write.
    Dup,
    Pop,
    // Call the value at [top - argc] with the argc values above it, replacing
    // all of them with the result. See the arg packing in compExpr.
    Call,
    // Leave the chunk with the value on top of the stack as the function's
    // result. Only a body chunk may contain one: a loop chunk that swallowed a
    // `return` would run the loop and then carry on past it.
    Ret,
    Halt,
}

pub struct Chunk {
    ops: Vec<Op>,
    args: Vec<i64>,
    consts: Vec<f64>,
    strs: Vec<string>,
    // slot -> the name it stands for. Outer slots are seeded from the enclosing
    // scope on entry and written back on exit; slots the loop declares itself
    // are neither, because nothing outside can observe them.
    slotNames: Vec<string>,
    slotOuter: Vec<bool>,
    // Slots this chunk ever STORES to. An outer slot it only reads still holds
    // what the scope holds, so flushing it back is a no-op that costs a
    // scope-chain walk per call (and, over a `with`, a spurious setter call).
    slotWritten: Vec<bool>,
    // High-water mark of the operand area above the slots, counted once at
    // compile time. Every call used to rescan the whole op array for it.
    need: i64,
    // Does the body name `arguments`? If not, the activation does not have to
    // build one. See bindActivationScope.
    usesArguments: bool,
}

struct Comp {
    ops: Vec<Op>,
    args: Vec<i64>,
    consts: Vec<f64>,
    strs: Vec<string>,
    slotNames: Vec<string>,
    slotOuter: Vec<bool>,
    ok: bool,
    // A `return` compiles only for a whole function body. compileFor leaves this
    // false, so a loop containing one is rejected rather than silently losing it.
    allowRet: bool,
}

fn emitOp(c: &mut Comp, op: Op, a: i64): i64 {
    let at = c.ops.len()
    c.ops.push(op)
    c.args.push(a)
    return at
}

fn strSlot(c: &mut Comp, v: &string): i64 {
    var i: i64 = 0
    while i < c.strs.len() {
        if c.strs[i] == v {
            return i
        }
        i = i + 1
    }
    c.strs.push(v.clone())
    return c.strs.len() - 1
}

fn constSlot(c: &mut Comp, v: f64): i64 {
    var i: i64 = 0
    while i < c.consts.len() {
        if c.consts[i] == v {
            return i
        }
        i = i + 1
    }
    c.consts.push(v)
    return c.consts.len() - 1
}

// Find the slot for `name`, adding one if this is its first mention. `declared`
// marks a name the chunk itself binds, which is what makes it not-outer.
fn slotOf(c: &mut Comp, name: &string, declared: bool): i64 {
    var i: i64 = 0
    while i < c.slotNames.len() {
        if c.slotNames[i] == name {
            return i
        }
        i = i + 1
    }
    c.slotNames.push(name.clone())
    c.slotOuter.push(!declared)
    return c.slotNames.len() - 1
}

// A DECLARATION of a name that already has a slot. Slots are per NAME and a
// chunk has no block scopes, so the second binding would write the first one's
// storage: `let b = 1; { let b = 5; } return b` answered 5. Two bindings need
// two slots, which this compiler cannot express, so the chunk is rejected.
fn declareSlot(c: &mut Comp, name: &string): i64 {
    var i: i64 = 0
    while i < c.slotNames.len() {
        if c.slotNames[i] == name {
            c.ok = false
            return i
        }
        i = i + 1
    }
    c.slotNames.push(name.clone())
    c.slotOuter.push(false)
    return c.slotNames.len() - 1
}

// The JS spelling of an arithmetic/relational opcode, for the general path.
fn opSpelling(o: Op): string {
    match o {
        Op.Add => { return "+" }
        Op.Sub => { return "-" }
        Op.Mul => { return "*" }
        Op.Div => { return "/" }
        Op.Mod => { return "%" }
        Op.Lt => { return "<" }
        Op.Gt => { return ">" }
        Op.Le => { return "<=" }
        Op.Ge => { return ">=" }
        Op.Eq => { return "===" }
        Op.Ne => { return "!==" }
        _ => { return "" }
    }
}

fn binOpFor(op: &string): Op {
    if op == "+" {
        return Op.Add
    }
    if op == "-" {
        return Op.Sub
    }
    if op == "*" {
        return Op.Mul
    }
    if op == "/" {
        return Op.Div
    }
    if op == "%" {
        return Op.Mod
    }
    if op == "<" {
        return Op.Lt
    }
    if op == ">" {
        return Op.Gt
    }
    if op == "<=" {
        return Op.Le
    }
    if op == ">=" {
        return Op.Ge
    }
    if op == "===" {
        return Op.Eq
    }
    if op == "!==" {
        return Op.Ne
    }
    return Op.Halt
}

// Compile one expression, leaving its value on the stack. Sets c.ok false for
// anything outside the subset; callers keep walking but the result is discarded.
fn compExpr(prog: &Prog, c: &mut Comp, id: ExprId) {
    if !c.ok {
        return
    }
    match prog.exprs[id.index] {
        Expr.Num(n) => {
            let k = constSlot(c, n)
            emitOp(c, Op.Const, k)
        }
        Expr.StrLit(v) => {
            let k = strSlot(c, v)
            emitOp(c, Op.Str, k)
        }
        Expr.Ident(name) => {
            let s = slotOf(c, name, false)
            emitOp(c, Op.Load, s)
        }
        Expr.Member(objIdx, name) => {
            compExpr(prog, c, objIdx)
            let k = strSlot(c, name)
            emitOp(c, Op.GetMem, k)
        }
        Expr.ObjLit(litIdx) => {
            // Plain data properties with literal keys only. A computed key needs
            // its own evaluation order, and a getter/setter is installed rather
            // than assigned; both reject the chunk instead of being half-right.
            var i: i64 = 0
            while i < prog.objLits[litIdx.index].len() {
                if prog.objLits[litIdx.index][i].kind > 0 {
                    c.ok = false
                    return
                }
                if let Option.Some(_ke) = prog.objLits[litIdx.index][i].keyExpr {
                    c.ok = false
                    return
                }
                i = i + 1
            }
            emitOp(c, Op.NewObj, 0)
            var j: i64 = 0
            while j < prog.objLits[litIdx.index].len() {
                emitOp(c, Op.Dup, 0)
                compExpr(prog, c, prog.objLits[litIdx.index][j].val)
                let k = strSlot(c, prog.objLits[litIdx.index][j].key)
                emitOp(c, Op.SetMem, k)
                emitOp(c, Op.Pop, 0)
                j = j + 1
            }
        }
        Expr.SetMember(objIdx, keyIdx, valIdx) => {
            // Only a STATIC key (`o.x = v`). A computed one (`o[k] = v`) has to
            // ToString the key expression, which is another evaluation order to
            // get right; it is not here yet.
            match prog.exprs[keyIdx.index] {
                Expr.StrLit(key) => {
                    compExpr(prog, c, objIdx)
                    compExpr(prog, c, valIdx)
                    let k = strSlot(c, key)
                    emitOp(c, Op.SetMem, k)
                }
                _ => {
                    c.ok = false
                }
            }
        }
        // `f(x)` only: a PLAIN identifier callee, where `this` genuinely is
        // undefined. A method call `o.m(x)` is deliberately absent: callValue
        // DROPS thisVal for a JSValue.Native (it forwards to callNativeProg,
        // which takes no receiver), so `h.call(o, "a")` answered undefined, and
        // routing natives through callBuiltinByName instead is not equivalent:
        // that is one branch of callMember's per-object-kind dispatch, and using
        // it generally broke Reflect.apply. Method calls need callValue to carry
        // `this` to natives first.
        Expr.Call(calleeId, argsIdx) => {
            match prog.exprs[calleeId.index] {
                Expr.Ident(name) => {
                    // Three identifiers are not ordinary calls at all: evalCall
                    // gives direct `eval` the CALLER's scope, resolves `require`
                    // against the running module, and threads `this` explicitly
                    // through a desugared `super(...)`.
                    if name == "eval" || name == "require" || isSuperName(name) {
                        c.ok = false
                        return
                    }
                    let argc = prog.argLists[argsIdx.index].len()
                    // The arg word packs the count into 8 bits (see below).
                    if argc > 255 {
                        c.ok = false
                        return
                    }
                    let cs = slotOf(c, name, false)
                    emitOp(c, Op.Load, cs)
                    var ai: i64 = 0
                    while ai < argc {
                        // a spread argument is an Expr.Spread, which lands in the
                        // reject-everything-else arm below
                        compExpr(prog, c, prog.argLists[argsIdx.index][ai])
                        ai = ai + 1
                    }
                    // One arg word, two operands: the low 8 bits are the argument
                    // count and the rest is the strs slot holding the callee's
                    // NAME, which only the "x is not a function" TypeError needs.
                    // A Chunk carries one i64 per op, and a second array for a
                    // field two opcodes use would cost every op a word.
                    let ns = strSlot(c, name)
                    emitOp(c, Op.Call, argc + ns * 256)
                }
                _ => {
                    c.ok = false
                }
            }
        }
        Expr.Bin(op, a, b) => {
            let o = binOpFor(op)
            match o {
                Op.Halt => {
                    c.ok = false
                }
                _ => {
                    compExpr(prog, c, a)
                    compExpr(prog, c, b)
                    emitOp(c, o, 0)
                }
            }
        }
        Expr.Un(op, a) => {
            if op == "-" {
                compExpr(prog, c, a)
                emitOp(c, Op.Neg, 0)
            } else {
                c.ok = false
            }
        }
        Expr.Assign(name, rhs) => {
            compExpr(prog, c, rhs)
            let s = slotOf(c, name, false)
            emitOp(c, Op.Store, s)
            emitOp(c, Op.Load, s)
        }
        Expr.CompoundAssign(target, op, rhs) => {
            match prog.exprs[target.index] {
                Expr.Ident(name) => {
                    let s = slotOf(c, name, false)
                    emitOp(c, Op.Load, s)
                    compExpr(prog, c, rhs)
                    let o = binOpFor(op)
                    match o {
                        Op.Halt => {
                            c.ok = false
                        }
                        _ => {
                            emitOp(c, o, 0)
                            emitOp(c, Op.Store, s)
                            emitOp(c, Op.Load, s)
                        }
                    }
                }
                _ => {
                    c.ok = false
                }
            }
        }
        Expr.Update(target, isInc, isPrefix) => {
            match prog.exprs[target.index] {
                Expr.Ident(name) => {
                    let s = slotOf(c, name, false)
                    let one = constSlot(c, 1.0)
                    if isPrefix {
                        emitOp(c, Op.Load, s)
                        emitOp(c, Op.Const, one)
                        if isInc {
                            emitOp(c, Op.Add, 0)
                        } else {
                            emitOp(c, Op.Sub, 0)
                        }
                        emitOp(c, Op.Store, s)
                        emitOp(c, Op.Load, s)
                    } else {
                        emitOp(c, Op.Load, s)
                        emitOp(c, Op.Load, s)
                        emitOp(c, Op.Const, one)
                        if isInc {
                            emitOp(c, Op.Add, 0)
                        } else {
                            emitOp(c, Op.Sub, 0)
                        }
                        emitOp(c, Op.Store, s)
                    }
                }
                _ => {
                    c.ok = false
                }
            }
        }
        _ => {
            c.ok = false
        }
    }
}

fn compStmt(prog: &Prog, c: &mut Comp, id: StmtId) {
    if !c.ok {
        return
    }
    match prog.stmts[id.index] {
        Stmt.Empty => {
        }
        Stmt.ExprStmt(e) => {
            compExpr(prog, c, e)
            emitOp(c, Op.Pop, 0)
        }
        Stmt.Block(b) => {
            var i: i64 = 0
            while i < prog.blocks[b.index].len() {
                compStmt(prog, c, prog.blocks[b.index][i])
                i = i + 1
            }
        }
        Stmt.MultiDecl(listIdx) => {
            var i: i64 = 0
            while i < prog.declLists[listIdx.index].len() {
                // `var` escapes the loop to the enclosing function scope, so a
                // slot that is never written back would lose it. Rejected rather
                // than handled: the subset does not need it.
                if prog.declLists[listIdx.index][i].isVar {
                    c.ok = false
                    return
                }
                compExpr(prog, c, prog.declLists[listIdx.index][i].init)
                let s = declareSlot(c, prog.declLists[listIdx.index][i].name)
                emitOp(c, Op.Store, s)
                i = i + 1
            }
        }
        Stmt.If(cond, then, els) => {
            compExpr(prog, c, cond)
            let jf = emitOp(c, Op.Jmpf, 0)
            compStmt(prog, c, then)
            match els {
                Option.Some(e) => {
                    let jend = emitOp(c, Op.Jmp, 0)
                    c.args[jf] = c.ops.len()
                    compStmt(prog, c, e)
                    c.args[jend] = c.ops.len()
                }
                Option.None => {
                    c.args[jf] = c.ops.len()
                }
            }
        }
        Stmt.Ret(e) => {
            if !c.allowRet {
                c.ok = false
                return
            }
            compExpr(prog, c, e)
            emitOp(c, Op.Ret, 0)
        }
        Stmt.While(cond, body) => {
            let top = c.ops.len()
            compExpr(prog, c, cond)
            let jf = emitOp(c, Op.Jmpf, 0)
            compStmt(prog, c, body)
            emitOp(c, Op.Jmp, top)
            c.args[jf] = c.ops.len()
        }
        _ => {
            c.ok = false
        }
    }
}

// High-water mark of the operand area, counted once per chunk. Every op that
// pushes counts; the ones that pop are not subtracted, so this is an upper bound
// rather than a simulation of the stack.
fn operandNeed(c: &Comp): i64 {
    var need: i64 = 0
    var d: i64 = 0
    while d < c.ops.len() {
        match c.ops[d] {
            Op.Const => {
                need = need + 1
            }
            Op.Load => {
                need = need + 1
            }
            Op.Str => {
                need = need + 1
            }
            Op.NewObj => {
                need = need + 1
            }
            Op.Dup => {
                need = need + 1
            }
            _ => {
            }
        }
        d = d + 1
    }
    return need
}

// Which slots the chunk stores to, read off the emitted code so no emit site can
// forget to record it.
fn writtenSlots(c: &Comp): Vec<bool> {
    var w: Vec<bool> = Vec.new()
    while w.len() < c.slotNames.len() {
        w.push(false)
    }
    var d: i64 = 0
    while d < c.ops.len() {
        match c.ops[d] {
            Op.Store => {
                w[c.args[d]] = true
            }
            _ => {
            }
        }
        d = d + 1
    }
    return w
}

fn namesArguments(c: &Comp): bool {
    var i: i64 = 0
    while i < c.slotNames.len() {
        if c.slotNames[i] == "arguments" {
            return true
        }
        i = i + 1
    }
    return false
}

// Compile a `for` statement, or answer None when any part of it falls outside
// the subset.
pub fn compileFor(prog: &Prog, id: StmtId): Option<Chunk> {
    match prog.stmts[id.index] {
        Stmt.For(init, cond, update, body) => {
            var c = Comp {
                ops: Vec.new(), args: Vec.new(), consts: Vec.new(), strs: Vec.new(),
                slotNames: Vec.new(), slotOuter: Vec.new(), ok: true, allowRet: false,
            }
            if let Option.Some(s) = init {
                compStmt(prog, c, s)
            }
            let top = c.ops.len()
            match cond {
                Option.Some(e) => {
                    compExpr(prog, c, e)
                }
                Option.None => {
                    let k = constSlot(c, 1.0)
                    emitOp(c, Op.Const, k)
                }
            }
            let jf = emitOp(c, Op.Jmpf, 0)
            compStmt(prog, c, body)
            if let Option.Some(e) = update {
                compExpr(prog, c, e)
                emitOp(c, Op.Pop, 0)
            }
            emitOp(c, Op.Jmp, top)
            c.args[jf] = c.ops.len()
            emitOp(c, Op.Halt, 0)
            if !c.ok {
                return Option.None
            }
            let need = operandNeed(c)
            let written = writtenSlots(c)
            let usesArgs = namesArguments(c)
            return Option.Some(Chunk {
                ops: c.ops, args: c.args, consts: c.consts, strs: c.strs,
                slotNames: c.slotNames, slotOuter: c.slotOuter,
                slotWritten: written, need: need, usesArguments: usesArgs,
            })
        }
        _ => {
            return Option.None
        }
    }
}

fn isNumberAt(st: &Interp, at: i64): bool {
    if let JSValue.Number(_n) = st.vmStack[at] {
        return true
    }
    return false
}

fn bothNumbers(st: &Interp, x: i64, y: i64): bool {
    return isNumberAt(st, x) && isNumberAt(st, y)
}

// A comparison yields a JS boolean, not 1/0. It only ever fed a conditional jump
// while the stack was numeric, so the difference was invisible; once a result can
// be stored or returned, `x === y` handing back 1 instead of true is observable
// (test262's Array callback tests assign a comparison to an outer variable and
// check it against `true`).
fn boolVal(b: bool): JSValue {
    return JSValue.Bool(b)
}

// The compiled subset only ever produces numbers, so a non-number can only come
// from a seeding bug. 0.0 keeps the loop total rather than adding a branch per
// operand.
// Only ever called behind an isNumberAt guard; the 0.0 arm is unreachable and
// exists because the match must be total.
fn vmNum(st: &Interp, at: i64): f64 {
    match st.vmStack[at] {
        JSValue.Number(n) => {
            return n
        }
        _ => {
            return 0.0
        }
    }
}

// Write one slot, growing the stack the first time that depth is reached.
fn vmSet(st: &mut Interp, at: i64, v: JSValue) {
    while st.vmStack.len() <= at {
        st.vmStack.push(JSValue.Undefined)
    }
    st.vmStack[at] = v
}

// One suspended VM frame: everything the caller needs to carry on once the
// callee returns. The caller's Chunk travels beside it in `frameChunks` rather
// than as an index into gChunks, because compiling a callee PUSHES onto gChunks:
// a &Chunk into that vector would be left dangling mid-dispatch, which showed up
// as ch.args reading length 0 (see tryRunFor).
struct VmFrame {
    pc: i64,
    base: i64,
    // The caller slot the result lands in. It held the callee value, so the
    // caller's operand top on resume is one past it.
    resSlot: i64,
    scope: i64,
    strict: bool,
}

// Publish every outer slot back into the scope it came from. A frame keeps free
// names in slots, so nothing it has written is visible to a callee (or to the
// tree walker) until this runs.
fn vmFlushOuter(st: &mut Interp, ch: &Chunk, base: i64, scope: i64) {
    var k: i64 = 0
    while k < ch.slotNames.len() {
        if ch.slotOuter[k] && ch.slotWritten[k] {
            scopeAssign(st, scope, ch.slotNames[k], cloneValue(st.vmStack[base + k]))
        }
        k = k + 1
    }
}

// Re-read every outer slot after a call. The callee can assign a name this frame
// is holding in a slot; without this the frame would keep reading its pre-call
// snapshot and then flush that stale value back over the callee's write. A name
// that has stopped resolving (a deleted global) keeps its slot rather than
// inventing a ReferenceError the tree walker would raise at the read.
fn vmSeedOuter(st: &mut Interp, ch: &Chunk, base: i64, scope: i64) {
    var k: i64 = 0
    while k < ch.slotNames.len() {
        if ch.slotOuter[k] {
            if let Option.Some(v) = scopeTryLookup(st, scope, ch.slotNames[k]) {
                st.vmStack[base + k] = v
            }
        }
        k = k + 1
    }
}

// Lay a frame's slots down at `at`. Answers false when an outer name has no
// binding anywhere, which means this chunk cannot run: only the tree walker can
// raise that ReferenceError. Nothing has been written when it answers false.
//
// Takes the chunk by INDEX and re-reads gChunks per access on purpose: a scope
// chain with a `with` over a proxy turns a lookup into a JS call, which can
// compile another body and reallocate gChunks under a held &Chunk.
fn vmSeedFrame(st: &mut Interp, cid: i64, at: i64, scope: i64): bool {
    var i: i64 = 0
    while i < gChunks[cid].slotNames.len() {
        if gChunks[cid].slotOuter[i] {
            match scopeTryLookup(st, scope, gChunks[cid].slotNames[i]) {
                Option.Some(v) => {
                    vmSet(st, at + i, v)
                }
                Option.None => {
                    return false
                }
            }
        } else {
            vmSet(st, at + i, JSValue.Undefined)
        }
        i = i + 1
    }
    // Give the operand area real values and count it into the rooted range: a
    // number costs the collector nothing to mark, and every op that can collect
    // still republishes its own exact top before it does.
    var r: i64 = 0
    while r < gChunks[cid].need {
        vmSet(st, at + gChunks[cid].slotNames.len() + r, JSValue.Number(0.0))
        r = r + 1
    }
    st.vmSp = at + gChunks[cid].slotNames.len() + gChunks[cid].need
    return true
}

// Run a compiled chunk, and every compiled chunk it calls, in ONE dispatch loop.
// Answers None when the chunk cannot run and the caller must fall back to the
// tree walker; that decision is made before any side effect. Otherwise answers
// the value the body returned, or Undefined for a loop chunk and for a body that
// fell off its end.
pub fn runChunk(prog: &Prog, cid: i64, st: &mut Interp, scope: i64): Option<JSValue> {
    // Owned copy of the ACTIVE chunk, for the reallocation reason in VmFrame.
    var ch = gChunks[cid]
    let base0 = st.vmSp
    var base = base0
    var curScope = scope
    if !vmSeedFrame(st, cid, base, curScope) {
        st.vmSp = base0
        return Option.None
    }

    var frames: Vec<VmFrame> = Vec.new()
    var frameChunks: Vec<Chunk> = Vec.new()
    // Chunk index of a callee entered by the op just dispatched, or -1.
    var pendingCid: i64 = -1
    var retVal = JSValue.Undefined
    var sp = base + ch.slotNames.len()
    var pc: i64 = 0
    var done = false
    var flushedOnThrow = false
    while !done {
        // Set by Ret and Halt: this frame is finished and the one under it (if
        // any) resumes.
        var leaving = false
        // Set when a CALLEE left the exception pending, which decides whether
        // this frame's slots are flushed on the way out (see below).
        var threwInCallee = false
        // Every chunk ends in Halt and no jump target is past it, so this cannot
        // fire; it keeps a compiler bug from indexing off the end of the array.
        if pc >= ch.ops.len() || pc < 0 {
            pc = ch.ops.len() - 1
        }
        let a = ch.args[pc]
        match ch.ops[pc] {
            Op.Const => {
                vmSet(st, sp, JSValue.Number(ch.consts[a]))
                sp = sp + 1
                pc = pc + 1
            }
            Op.Str => {
                vmSet(st, sp, JSValue.Str(ch.strs[a].clone()))
                sp = sp + 1
                pc = pc + 1
            }
            Op.Load => {
                vmSet(st, sp, cloneValue(st.vmStack[base + a]))
                sp = sp + 1
                pc = pc + 1
            }
            Op.Store => {
                sp = sp - 1
                st.vmStack[base + a] = cloneValue(st.vmStack[sp])
                pc = pc + 1
            }
            Op.Add => {
                sp = sp - 1
                if bothNumbers(st, sp - 1, sp) {
                    let v = vmNum(st, sp - 1) + vmNum(st, sp)
                    st.vmStack[sp - 1] = JSValue.Number(v)
                } else {
                    st.vmSp = sp + 1
                    let x = cloneValue(st.vmStack[sp - 1])
                    let y = cloneValue(st.vmStack[sp])
                    st.vmStack[sp - 1] = evalBinValues(prog, opSpelling(Op.Add), x, y, st)
                    st.vmSp = sp
                }
                pc = pc + 1
            }
            Op.Sub => {
                sp = sp - 1
                if bothNumbers(st, sp - 1, sp) {
                    let v = vmNum(st, sp - 1) - vmNum(st, sp)
                    st.vmStack[sp - 1] = JSValue.Number(v)
                } else {
                    st.vmSp = sp + 1
                    let x = cloneValue(st.vmStack[sp - 1])
                    let y = cloneValue(st.vmStack[sp])
                    st.vmStack[sp - 1] = evalBinValues(prog, opSpelling(Op.Sub), x, y, st)
                    st.vmSp = sp
                }
                pc = pc + 1
            }
            Op.Mul => {
                sp = sp - 1
                if bothNumbers(st, sp - 1, sp) {
                    let v = vmNum(st, sp - 1) * vmNum(st, sp)
                    st.vmStack[sp - 1] = JSValue.Number(v)
                } else {
                    st.vmSp = sp + 1
                    let x = cloneValue(st.vmStack[sp - 1])
                    let y = cloneValue(st.vmStack[sp])
                    st.vmStack[sp - 1] = evalBinValues(prog, opSpelling(Op.Mul), x, y, st)
                    st.vmSp = sp
                }
                pc = pc + 1
            }
            Op.Div => {
                sp = sp - 1
                if bothNumbers(st, sp - 1, sp) {
                    let v = vmNum(st, sp - 1) / vmNum(st, sp)
                    st.vmStack[sp - 1] = JSValue.Number(v)
                } else {
                    st.vmSp = sp + 1
                    let x = cloneValue(st.vmStack[sp - 1])
                    let y = cloneValue(st.vmStack[sp])
                    st.vmStack[sp - 1] = evalBinValues(prog, opSpelling(Op.Div), x, y, st)
                    st.vmSp = sp
                }
                pc = pc + 1
            }
            Op.Mod => {
                sp = sp - 1
                if bothNumbers(st, sp - 1, sp) {
                    let v = vmNum(st, sp - 1) % vmNum(st, sp)
                    st.vmStack[sp - 1] = JSValue.Number(v)
                } else {
                    st.vmSp = sp + 1
                    let x = cloneValue(st.vmStack[sp - 1])
                    let y = cloneValue(st.vmStack[sp])
                    st.vmStack[sp - 1] = evalBinValues(prog, opSpelling(Op.Mod), x, y, st)
                    st.vmSp = sp
                }
                pc = pc + 1
            }
            Op.Neg => {
                if isNumberAt(st, sp - 1) {
                    let v = -vmNum(st, sp - 1)
                    st.vmStack[sp - 1] = JSValue.Number(v)
                } else {
                    st.vmSp = sp
                    let x = cloneValue(st.vmStack[sp - 1])
                    // toNumArg, not toNumProg: unary minus on a Symbol is a
                    // TypeError, and toNumProg answers NaN because loose equality
                    // reaches it too (`Symbol() == 1` is false, not a throw). The
                    // evaluator's own `-` arm has this guard; the compiled path
                    // bypassed it and `-Symbol()` quietly produced NaN.
                    let n = toNumArg(prog, x, st)
                    st.vmStack[sp - 1] = JSValue.Number(-n)
                }
                pc = pc + 1
            }
            Op.Lt => {
                sp = sp - 1
                if bothNumbers(st, sp - 1, sp) {
                    let r = vmNum(st, sp - 1) < vmNum(st, sp)
                    st.vmStack[sp - 1] = boolVal(r)
                } else {
                    st.vmSp = sp + 1
                    let x = cloneValue(st.vmStack[sp - 1])
                    let y = cloneValue(st.vmStack[sp])
                    st.vmStack[sp - 1] = evalBinValues(prog, opSpelling(Op.Lt), x, y, st)
                    st.vmSp = sp
                }
                pc = pc + 1
            }
            Op.Gt => {
                sp = sp - 1
                if bothNumbers(st, sp - 1, sp) {
                    let r = vmNum(st, sp - 1) > vmNum(st, sp)
                    st.vmStack[sp - 1] = boolVal(r)
                } else {
                    st.vmSp = sp + 1
                    let x = cloneValue(st.vmStack[sp - 1])
                    let y = cloneValue(st.vmStack[sp])
                    st.vmStack[sp - 1] = evalBinValues(prog, opSpelling(Op.Gt), x, y, st)
                    st.vmSp = sp
                }
                pc = pc + 1
            }
            Op.Le => {
                sp = sp - 1
                if bothNumbers(st, sp - 1, sp) {
                    let r = vmNum(st, sp - 1) <= vmNum(st, sp)
                    st.vmStack[sp - 1] = boolVal(r)
                } else {
                    st.vmSp = sp + 1
                    let x = cloneValue(st.vmStack[sp - 1])
                    let y = cloneValue(st.vmStack[sp])
                    st.vmStack[sp - 1] = evalBinValues(prog, opSpelling(Op.Le), x, y, st)
                    st.vmSp = sp
                }
                pc = pc + 1
            }
            Op.Ge => {
                sp = sp - 1
                if bothNumbers(st, sp - 1, sp) {
                    let r = vmNum(st, sp - 1) >= vmNum(st, sp)
                    st.vmStack[sp - 1] = boolVal(r)
                } else {
                    st.vmSp = sp + 1
                    let x = cloneValue(st.vmStack[sp - 1])
                    let y = cloneValue(st.vmStack[sp])
                    st.vmStack[sp - 1] = evalBinValues(prog, opSpelling(Op.Ge), x, y, st)
                    st.vmSp = sp
                }
                pc = pc + 1
            }
            Op.Eq => {
                sp = sp - 1
                if bothNumbers(st, sp - 1, sp) {
                    let r = vmNum(st, sp - 1) == vmNum(st, sp)
                    st.vmStack[sp - 1] = boolVal(r)
                } else {
                    st.vmSp = sp + 1
                    let x = cloneValue(st.vmStack[sp - 1])
                    let y = cloneValue(st.vmStack[sp])
                    st.vmStack[sp - 1] = evalBinValues(prog, opSpelling(Op.Eq), x, y, st)
                    st.vmSp = sp
                }
                pc = pc + 1
            }
            Op.Ne => {
                sp = sp - 1
                if bothNumbers(st, sp - 1, sp) {
                    let r = vmNum(st, sp - 1) != vmNum(st, sp)
                    st.vmStack[sp - 1] = boolVal(r)
                } else {
                    st.vmSp = sp + 1
                    let x = cloneValue(st.vmStack[sp - 1])
                    let y = cloneValue(st.vmStack[sp])
                    st.vmStack[sp - 1] = evalBinValues(prog, opSpelling(Op.Ne), x, y, st)
                    st.vmSp = sp
                }
                pc = pc + 1
            }
            Op.Jmp => {
                pc = a
            }
            Op.Jmpf => {
                sp = sp - 1
                if truthy(st.vmStack[sp]) {
                    pc = pc + 1
                } else {
                    pc = a
                }
            }
            Op.GetMem => {
                st.vmSp = sp
                let recv = cloneValue(st.vmStack[sp - 1])
                st.vmStack[sp - 1] = memberOfValue(prog, recv, ch.strs[a], st)
                pc = pc + 1
            }
            Op.SetMem => {
                sp = sp - 1
                st.vmSp = sp + 1
                let v = cloneValue(st.vmStack[sp])
                let ov = cloneValue(st.vmStack[sp - 1])
                st.vmStack[sp - 1] = setMemberOfValue(prog, ov, ch.strs[a].clone(), v, st)
                pc = pc + 1
            }
            Op.NewObj => {
                st.vmSp = sp
                let o = newObject(st)
                vmSet(st, sp, JSValue.Obj(o))
                sp = sp + 1
                st.vmSp = sp
                pc = pc + 1
            }
            Op.Dup => {
                vmSet(st, sp, cloneValue(st.vmStack[sp - 1]))
                sp = sp + 1
                pc = pc + 1
            }
            Op.Pop => {
                sp = sp - 1
                pc = pc + 1
            }
            Op.Call => {
                let argc = a % 256
                let nameSlot = a / 256
                let calleeSlot = sp - argc - 1
                // Publish the exact live top BEFORE anything that can allocate:
                // collect marks 0..vmSp and nothing above it, and the callee
                // value and every argument sit below this.
                st.vmSp = sp
                // The VM's safepoint, and the only one it has. The tree walker
                // takes one per statement; a compiled frame allocates a scope and
                // an `arguments` array per call, so a call is where a compiled
                // program's allocation happens. It also gives MILOJS_GC_THRESHOLD=1
                // reach into this path: without it the frame stack was never once
                // marked mid-dispatch under the GC-stress pass.
                maybeGc(st)
                let calleeVal = cloneValue(st.vmStack[calleeSlot])
                var argVals: Vec<JSValue> = Vec.new()
                var ai: i64 = 0
                while ai < argc {
                    argVals.push(cloneValue(st.vmStack[calleeSlot + 1 + ai]))
                    ai = ai + 1
                }
                // Whatever this frame is holding in its slots has to be in the
                // scope chain before the callee resolves a single free name.
                vmFlushOuter(st, ch, base, curScope)
                var handled = false
                if let JSValue.Func(fIdx, envIdx) = calleeVal {
                    let cid2 = bodyChunkOf(prog, fIdx)
                    // A CLASS constructor takes the slow path even when its body
                    // compiles: callFunction is where "cannot be invoked without
                    // 'new'" is raised, and an empty constructor body compiles, so
                    // a frame here would run it and answer undefined instead.
                    if cid2 >= 0 && !prog.funcs[fIdx].isClassCtor {
                        handled = true
                        // The same guard callFunctionBody applies. A frame here
                        // costs no native stack, so the depth counter is the only
                        // half of it that can fire.
                        if callGuardTripped(st) {
                            threwInCallee = true
                        } else {
                            // Everything callFunctionBody does for an ordinary
                            // call, minus the parts the subset rules out:
                            // hoistBlock (a compiled body has no `var` and no
                            // function declaration) and runDisposals (no `using`).
                            st.suppressAsyncSpawn = false
                            st.suppressGenSpawn = false
                            st.callDepth = st.callDepth + 1
                            let callScope = bindActivationScope(prog, fIdx, envIdx, argVals, JSValue.Undefined, st, gChunks[cid2].usesArguments)
                            pushActive(st, callScope)
                            // The callee's frame goes ABOVE this one's operands,
                            // so every live value in every frame stays below vmSp
                            // and stays marked.
                            if vmSeedFrame(st, cid2, sp, callScope) {
                                st.fnFileStack.push(prog.funcs[fIdx].file.clone())
                                frames.push(VmFrame {
                                    pc: pc + 1, base: base, resSlot: calleeSlot,
                                    scope: curScope, strict: st.strict,
                                })
                                // Strictness belongs to the function being
                                // entered, not to its caller.
                                st.strict = prog.funcs[fIdx].isStrict
                                base = sp
                                sp = base + gChunks[cid2].slotNames.len()
                                curScope = callScope
                                pc = 0
                                pendingCid = cid2
                            } else {
                                // A free name the callee reads is bound nowhere:
                                // only the tree walker raises that ReferenceError.
                                // Undo the activation and take the slow path.
                                popActive(st)
                                st.callDepth = st.callDepth - 1
                                handled = false
                            }
                        }
                    }
                }
                if !handled && !st.throwing {
                    // A native, a generator, an async or bound function, a proxy,
                    // or a body outside the subset: one native round trip, which
                    // is what the tree walker pays for every call it makes.
                    if isPlainCallable(st, calleeVal) {
                        let res = callPlainValue(prog, calleeVal, argVals, st)
                        sp = calleeSlot + 1
                        st.vmSp = sp
                        vmSet(st, calleeSlot, res)
                        vmSeedOuter(st, ch, base, curScope)
                        threwInCallee = st.throwing
                    } else {
                        throwNotAFunction(st, ch.strs[nameSlot])
                    }
                    pc = pc + 1
                }
            }
            Op.Ret => {
                sp = sp - 1
                retVal = cloneValue(st.vmStack[sp])
                leaving = true
            }
            Op.Halt => {
                retVal = JSValue.Undefined
                leaving = true
            }
        }
        // Switching the active chunk happens out here: `ch` cannot be moved out
        // from under the match that is reading its opcode.
        if pendingCid >= 0 {
            frameChunks.push(ch)
            ch = gChunks[pendingCid]
            pendingCid = -1
        }
        if st.throwing {
            // A throw stops the chunk where it stands, and every frame it stands
            // on. Side effects up to here have happened, which is what the tree
            // walker would also have done.
            //
            // The frame whose own op threw still flushes: its writes since its
            // last call live only in its slots. A frame whose CALLEE threw must
            // NOT: it flushed immediately before that call, so flushing again
            // would put a stale snapshot back over whatever the callee wrote
            // before it threw.
            if !threwInCallee {
                vmFlushOuter(st, ch, base, curScope)
            }
            flushedOnThrow = true
            while frames.len() > 0 {
                popActive(st)
                st.callDepth = st.callDepth - 1
                let _f = st.fnFileStack.pop()
                let fr = frames.pop()!
                st.strict = fr.strict
                ch = frameChunks.pop()!
                base = fr.base
                curScope = fr.scope
            }
            retVal = JSValue.Undefined
            done = true
        } else if leaving {
            if frames.len() == 0 {
                done = true
            } else {
                // The callee is finished: publish its writes, drop its
                // activation, and resume the caller with the result in the slot
                // the callee value occupied.
                vmFlushOuter(st, ch, base, curScope)
                popActive(st)
                st.callDepth = st.callDepth - 1
                let _f = st.fnFileStack.pop()
                let fr = frames.pop()!
                st.strict = fr.strict
                ch = frameChunks.pop()!
                base = fr.base
                curScope = fr.scope
                pc = fr.pc
                sp = fr.resSlot + 1
                st.vmStack[fr.resSlot] = retVal
                retVal = JSValue.Undefined
                st.vmSp = sp
                vmSeedOuter(st, ch, base, curScope)
            }
        }
    }

    if !flushedOnThrow {
        vmFlushOuter(st, ch, base, curScope)
    }
    // Drop the whole frame in one move: everything at or above vmSp is dead and
    // collect stops marking there.
    st.vmSp = base0
    return Option.Some(retVal)
}

// Set from MILOJS_NO_BYTECODE by the entry points. With it on, every expression
// runs through the tree-walking evaluator instead of a compiled chunk, which
// makes the two paths a DIFFERENTIAL PAIR: the whole fixture suite must produce
// byte-identical output either way. The compiler exists to be faster, not
// different, and an opcode that skips a guard the evaluator applies is exactly
// the bug this catches -- `-Symbol()` answered NaN through Op.Neg instead of
// throwing, because the fallback called toNumProg where the evaluator's own arm
// calls toNumArg. That shipped to main and only a fixture written for an
// unrelated reason caught it.
pub var gVmDisabled: bool = false

// Every compiled chunk, loop and body alike, in one store. One store rather than
// two because a frame refers to its chunk by index and the two kinds call each
// other: a loop chunk can contain a call, and a body chunk can contain a loop.
var gChunks: Vec<Chunk> = Vec.new()

// gLoopIdx[i] is 0 before that `for` statement has been looked at, -1 once it has
// been rejected, and chunk index + 1 once it compiled.
var gLoopIdx: Vec<i64> = Vec.new()

// Run this `for` through the compiled path, or answer false to say the tree
// walker still has to run it. Compilation happens once per statement.
pub fn tryRunFor(prog: &Prog, id: StmtId, st: &mut Interp, scope: i64): bool {
    if gVmDisabled {
        return false
    }
    while gLoopIdx.len() <= id.index {
        gLoopIdx.push(0)
    }
    var slot = gLoopIdx[id.index]
    if slot == 0 {
        match compileFor(prog, id) {
            Option.Some(ch) => {
                gChunks.push(ch)
                slot = gChunks.len()
            }
            Option.None => {
                slot = -1
            }
        }
        gLoopIdx[id.index] = slot
    }
    if slot < 0 {
        return false
    }
    if let Option.Some(_v) = runChunk(prog, slot - 1, st, scope) {
        return true
    }
    return false
}


// One compiled chunk per function body, keyed by its index in prog.funcs. Same
// three states as gLoopIdx.
var gBodyIdx: Vec<i64> = Vec.new()

// Compile a whole function body, or answer None. Worth far more than the `for`
// hook it sits beside: node's test/parallel has 618 loops and 21,617 function
// bodies, and the same numeric subset covers 8.6% of the bodies against 1.0% of
// the loops.
//
// Generators and async bodies are rejected outright. Their control flow leaves
// and re-enters the body, which a chunk that runs to completion cannot express.
// So is a paramPrelude, which is the desugaring of destructured and defaulted
// parameters and is a statement the caller runs, not part of the body.
pub fn compileBody(prog: &Prog, fIdx: i64): Option<Chunk> {
    if prog.funcs[fIdx].isGenerator || prog.funcs[fIdx].isAsync {
        return Option.None
    }
    if let Option.Some(_p) = prog.funcs[fIdx].paramPrelude {
        return Option.None
    }
    var c = Comp {
        ops: Vec.new(), args: Vec.new(), consts: Vec.new(), strs: Vec.new(),
        slotNames: Vec.new(), slotOuter: Vec.new(), ok: true, allowRet: true,
    }
    let body = prog.funcs[fIdx].body
    var i: i64 = 0
    while i < prog.blocks[body.index].len() {
        compStmt(prog, c, prog.blocks[body.index][i])
        i = i + 1
    }
    emitOp(c, Op.Halt, 0)
    if !c.ok {
        return Option.None
    }
    let need = operandNeed(c)
    let written = writtenSlots(c)
    let usesArgs = namesArguments(c)
    return Option.Some(Chunk {
        ops: c.ops, args: c.args, consts: c.consts, strs: c.strs,
        slotNames: c.slotNames, slotOuter: c.slotOuter,
        slotWritten: written, need: need, usesArguments: usesArgs,
    })
}

// The chunk index for this function's body, or -1 if its body does not compile.
// Compilation happens once per function, and the answer is cached either way.
// This is also the single point MILOJS_NO_BYTECODE turns the VM off at: with no
// chunk index there is no frame for the evaluator to enter and none for the VM's
// own Op.Call to enter either.
pub fn bodyChunkOf(prog: &Prog, fIdx: i64): i64 {
    if gVmDisabled {
        return -1
    }
    if fIdx < 0 || fIdx >= prog.funcs.len() {
        return -1
    }
    while gBodyIdx.len() <= fIdx {
        gBodyIdx.push(0)
    }
    var slot = gBodyIdx[fIdx]
    if slot == 0 {
        match compileBody(prog, fIdx) {
            Option.Some(ch) => {
                gChunks.push(ch)
                slot = gChunks.len()
            }
            Option.None => {
                slot = -1
            }
        }
        gBodyIdx[fIdx] = slot
    }
    if slot < 0 {
        return -1
    }
    return slot - 1
}

// Does this chunk name `arguments`? The activation an ordinary call builds can
// skip materialising one when it does not.
pub fn chunkUsesArguments(cid: i64): bool {
    return gChunks[cid].usesArguments
}

// Drop every cached chunk. The cache is keyed by an index into the program
// arena, so a fresh program reusing those indices would otherwise run another
// statement's code.
pub fn resetLoopCache() {
    gChunks.clear()
    gLoopIdx.clear()
    gBodyIdx.clear()
}
