// Pure UTF-16-aware string helpers, and the only contract-bearing code in the
// engine that a prover can actually see.
//
// They live apart from src/engine/builtins.milo for a mechanical reason, not a
// tidiness one: `milo prove` loads a module TWICE when the file it is given sits
// in a subdirectory and takes part in an import cycle, so proving builtins.milo
// (which imports ./eval, which imports it back) reported a duplicate
// `builtins_2$clampIndex` and refuted a strSlice loop invariant that is not
// false. This file imports nothing from the project, so there is no cycle and
// the prover sees one copy. Keep it that way: an import of ./eval here silently
// takes the contract gate back down.

// Normalize a possibly-negative slice index to [0, len], JS-style. The postcondition is the
// safety contract every caller relies on: the returned index is always in bounds for a
// buffer of `len`, so `s[clampIndex(..)]` up to (not including) `len` can never read OOB.
pub fn clampIndex(idx: i64, len: i64): i64
requires len >= 0
ensures result >= 0 && result <= len
{
    var i = idx
    if i < 0 {
        i = len + i
    }
    if i < 0 {
        i = 0
    }
    if i > len {
        i = len
    }
    return i
}

pub fn strSlice(s: &string, start: i64, end: i64): string {
    let len = s.len()
    let a = clampIndex(start, len)
    let b = clampIndex(end, len)
    var out = String.withCapacity(0)
    var i = a
    while i < b
    invariant
    i >= 0 && i <= len
    {
        out.push(s[i])
        i = i + 1
    }
    return out
}

// First index of `sub` in `s` at or after `start`, or -1. (`from` is a reserved keyword.)
pub fn jsIndexOf(s: &string, sub: &string, start: i64): i64 {
    let n = s.len()
    let m = sub.len()
    if m == 0 {
        if start > n {
            return n
        }
        if start < 0 {
            return 0
        }
        return start
    }
    var i = start
    if i < 0 {
        i = 0
    }
    while i + m <= n
    invariant
    i >= 0
    {
        var j: i64 = 0
        var matched = true
        while j < m
        invariant
        j >= 0 && j <= m
        {
            // safe: i+j < i+m <= n = s.len(), and j < m = sub.len()
            if s[i + j] != sub[j] {
                matched = false
                j = m
            } else {
                j = j + 1
            }
        }
        if matched {
            return i
        }
        i = i + 1
    }
    return -1
}

pub fn jsStartsWith(s: &string, sub: &string): bool {
    let m = sub.len()
    if m > s.len() {
        return false
    }
    var j: i64 = 0
    while j < m
    invariant
    j >= 0 && j <= m
    {
        if s[j] != sub[j] {
            return false
        }
        j = j + 1
    }
    return true
}

pub fn jsEndsWith(s: &string, sub: &string): bool {
    let n = s.len()
    let m = sub.len()
    if m > n {
        return false
    }
    var j: i64 = 0
    while j < m
    invariant
    j >= 0 && j <= m
    {
        // safe: m <= n guarded above, so n-m >= 0 and n-m+j < n = s.len()
        if s[n - m + j] != sub[j] {
            return false
        }
        j = j + 1
    }
    return true
}
