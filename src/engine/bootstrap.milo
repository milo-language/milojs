// Building the global object: every built-in constructor, prototype and method
// the engine installs before a single line of user JS runs. It is a bootstrap,
// not an evaluator, and it was the largest thing in src/engine/eval.milo that runs
// exactly once.
//
// The `length` each built-in carries is looked up from the tables that stay in
// eval.milo, because the call paths there need them too.

from "./value" import {
    JSValue, Builtin, Native
}
from "./runtime" import {
    Interp
}
from "./eval" import {
    arityLookup, builtinArityOn, builtinCtorArity, builtinStaticArity, ctorArityData, dateProtoMethodNames, getMember, makeBoundMethod, makeBoundMethodOn, nativeErrorName, staticArityData, symIteratorKey, symToPrimitiveKey, symToStringTagKey, BRAND_BIGINT, BRAND_BOOLEAN, BRAND_CALLABLE, BRAND_DATE, BRAND_MAP, BRAND_NUMBER, BRAND_SET, BRAND_PROMISE, BRAND_REGEXP, BRAND_STRING, BRAND_STRING_GENERIC, BRAND_SYMBOL
}

// A bound method that first checks its receiver really is of `brand`. See
// JSObjExtra.boundBrand for why the buffer family needs this and Array does not.
fn makeBrandedMethod(st: &mut Interp, name: string, brand: i64): JSValue {
    let v = makeBoundMethod(&mut st, JSValue.Undefined, name)
    let h = objHandle(v)
    st.objExtras[st.objects[h].extra].boundBrand = brand
    return v
}

// A prototype method whose receiver must carry the matching internal slot. The
// spec brand-checks exactly these: the wrapper prototypes' valueOf/toString, and
// every Date getter. The rest of String.prototype is generic (it ToStrings any
// receiver), so branding it would break Array.prototype.map.call("abc", f) and
// the uncurry-this idiom that depends on the same genericity.
// String.prototype, Number.prototype and Boolean.prototype are themselves
// WRAPPER objects in the spec, holding "" , 0 and false. Not a curiosity:
// `String.prototype + ""` is "" precisely because the prototype has a
// [[StringData]] slot, and the brand checks above would otherwise reject the
// prototype as a receiver for its own valueOf. Symbol.prototype,
// BigInt.prototype and Date.prototype are ORDINARY objects by contrast, and
// node throws for their branded methods called on themselves.
fn boxProtoItself(st: &mut Interp, proto: i64, v: JSValue) {
    let _ = ensureExtra(&mut st, proto)
    st.objExtras[st.objects[proto].extra].boxed = v
}

fn brandProtoMethods(st: &mut Interp, proto: i64, brand: i64, names: &Vec<string>) {
    var i: i64 = 0
    while i < names.len() {
        objSet(&mut st, proto, names[i].clone(), makeBrandedMethod(&mut st, names[i].clone(), brand))
        objSetNonEnumerable(&mut st, proto, names[i])
        i = i + 1
    }
}

// Give the Error family real prototype objects. They are natives, so before
// this `TypeError.prototype` was undefined and `TypeError.prototype.constructor`
// threw — a common branch in library code, and the single largest failure
// bucket in the test262 sweep.
//
// The objects live in each native's property bag (getNativeProps), which the
// collector already walks, so they need no new GC root. Subtype prototypes chain
// to Error.prototype the way the spec says, which is what makes
// `Object.getPrototypeOf(TypeError.prototype) === Error.prototype` hold.
// Every typed-array method name, as a list. isTypedArrayMethodName is the
// predicate over the same set; both have to move together.
fn typedArrayMethodNames(): Vec<string> {
    var v: Vec<string> = Vec.new()
    v.push("fill")
    v.push("set")
    v.push("subarray")
    v.push("slice")
    v.push("at")
    v.push("indexOf")
    v.push("includes")
    v.push("join")
    v.push("toString")
    v.push("forEach")
    v.push("map")
    v.push("filter")
    v.push("reduce")
    v.push("reduceRight")
    v.push("find")
    v.push("findIndex")
    v.push("findLast")
    v.push("findLastIndex")
    v.push("some")
    v.push("every")
    v.push("reverse")
    v.push("sort")
    v.push("with")
    v.push("copyWithin")
    v.push("lastIndexOf")
    v.push("keys")
    v.push("values")
    v.push("entries")
    v.push("toReversed")
    v.push("toSorted")
    v.push("toLocaleString")
    // %TypedArray%.prototype[Symbol.iterator] is the same function as .values
    v.push(symIteratorKey())
    return v
}

// %TypedArray%, the intrinsic that every concrete typed-array constructor
// inherits from, plus a real `prototype` object for each of them.
//
// Typed arrays were pure name dispatch here: `Int8Array.prototype` was
// undefined and the methods existed only as a whitelist checked on the property
// path. test262's testTypedArray.js harness opens with
// `var TypedArray = Object.getPrototypeOf(Int8Array)` and then reads
// TypedArray.prototype for nearly every assertion, so the whole
// built-ins/TypedArray tree — 1446 cases — died on "cannot read property of
// undefined" before running a line of its own.
//
// The methods go on as UNBOUND bound-methods, exactly as Array.prototype does:
// the call site's receiver wins, which is what makes the generic
// `TypedArray.prototype.map.call(ta, fn)` idiom resolve.
fn setupTypedArrayProtos(st: &mut Interp) {
    let taProto = newObject(&mut st)
    st.objects[taProto].proto = st.objectProtoObj
    let names = typedArrayMethodNames()
    var i: i64 = 0
    while i < names.len() {
        objSet(&mut st, taProto, names[i].clone(), makeBrandedMethod(&mut st, names[i].clone(), 1))
        objSetNonEnumerable(&mut st, taProto, names[i])
        i = i + 1
    }
    // length/byteLength/byteOffset/buffer are ACCESSORS on %TypedArray%.prototype,
    // not data properties on each view. Reading one off a non-view is a
    // TypeError, which the brand gives for free.
    var taAcc: Vec<string> = Vec.new()
    taAcc.push("length")
    taAcc.push("byteLength")
    taAcc.push("byteOffset")
    taAcc.push("buffer")
    var taGet: Vec<string> = Vec.new()
    taGet.push("__taLength")
    taGet.push("__taByteLength")
    taGet.push("__taByteOffset")
    taGet.push("__taBuffer")
    var ai: i64 = 0
    while ai < taAcc.len() {
        let g = makeBrandedMethod(&mut st, taGet[ai].clone(), 1)
        objDefineAccessor(&mut st, taProto, taAcc[ai].clone(), g, JSValue.Undefined)
        objSetNonEnumerable(&mut st, taProto, taAcc[ai])
        ai = ai + 1
    }
    let taCtor = newObject(&mut st)
    st.objects[taCtor].isFunctionLike = true
    objSet(&mut st, taCtor, "prototype", JSValue.Obj(taProto))
    objSetNonEnumerable(&mut st, taCtor, "prototype")
    objSet(&mut st, taCtor, "name", JSValue.Str("TypedArray"))
    objSetNonEnumerable(&mut st, taCtor, "name")
    objSet(&mut st, taProto, "constructor", JSValue.Obj(taCtor))
    objSetNonEnumerable(&mut st, taProto, "constructor")

    var tk: i64 = 0
    while tk <= TA_MAX {
        let sub = newObject(&mut st)
        st.objects[sub].proto = taProto
        objSet(&mut st, sub, "constructor", JSValue.Native(Native.TypedArrayCtor(tk)))
        objSetNonEnumerable(&mut st, sub, "constructor")
        // BYTES_PER_ELEMENT is { writable: false, enumerable: false,
        // configurable: false } on both the constructor and its prototype;
        // objSet left it writable and configurable, so every test262 case that
        // verifies the descriptor failed regardless of the value.
        objSetFrozenOwn(&mut st, sub, "BYTES_PER_ELEMENT", JSValue.Number(taWidth(tk) as f64), false)
        let bag = getNativeProps(&mut st, Native.TypedArrayCtor(tk))
        objDefineProtoAttr(&mut st, bag, "prototype", JSValue.Obj(sub))
        objSetFrozenOwn(&mut st, bag, "BYTES_PER_ELEMENT", JSValue.Number(taWidth(tk) as f64), false)
        objSetBuiltinAttr(&mut st, bag, "name", JSValue.Str(taName(tk)))
        // the constructor's own length: (buffer, byteOffset, length)
        objSetBuiltinAttr(&mut st, bag, "length", JSValue.Number(3.0))
        // this is what makes Object.getPrototypeOf(Int8Array) === %TypedArray%:
        // getPrototypeOf reads the proto of the native's property bag
        st.objects[bag].proto = taCtor
        tk = tk + 1
    }
}

// ArrayBuffer.prototype and DataView.prototype, for the same reason as
// %TypedArray% above: both were undefined, and testTypedArray.js opens its
// resizable-buffer section with `if (ArrayBuffer.prototype.resize)` — reading a
// property of undefined, which threw before any test in the tree ran.
fn setupBufferProtos(st: &mut Interp) {
    let abProto = newObject(&mut st)
    st.objects[abProto].proto = st.objectProtoObj
    var abNames: Vec<string> = Vec.new()
    abNames.push("slice")
    abNames.push("resize")
    abNames.push("transfer")
    var i: i64 = 0
    while i < abNames.len() {
        objSet(&mut st, abProto, abNames[i].clone(), makeBrandedMethod(&mut st, abNames[i].clone(), 2))
        objSetNonEnumerable(&mut st, abProto, abNames[i])
        i = i + 1
    }
    // byteLength is an ACCESSOR on ArrayBuffer.prototype, not a data property on
    // the instance. is-array-buffer keys on exactly that descriptor: with it
    // missing, the package's fallback answered true for EVERY object, and
    // deep-equal then wrapped a plain array in `new Uint8Array(a)` and recursed
    // on it for ever. That is what made deep-equal, and so tape's deepEqual,
    // unusable — a missing getter, three packages away.
    let abLenGetter = makeBrandedMethod(&mut st, "__abByteLength", 2)
    objDefineAccessor(&mut st, abProto, "byteLength", abLenGetter, JSValue.Undefined)
    objSetNonEnumerable(&mut st, abProto, "byteLength")
    objSet(&mut st, abProto, "constructor", JSValue.Native(Native.Fn(Builtin.ArrayBuffer)))
    objSetNonEnumerable(&mut st, abProto, "constructor")
    let abBag = getNativeProps(&mut st, Native.Fn(Builtin.ArrayBuffer))
    objSet(&mut st, abBag, "isView", JSValue.Native(Native.Fn(Builtin.ArrayBufferIsView)))
    objSetNonEnumerable(&mut st, abBag, "isView")
    objDefineProtoAttr(&mut st, abBag, "prototype", JSValue.Obj(abProto))

    let dvProto = newObject(&mut st)
    st.objects[dvProto].proto = st.objectProtoObj
    var dvNames: Vec<string> = Vec.new()
    dvNames.push("getInt8")
    dvNames.push("getUint8")
    dvNames.push("getInt16")
    dvNames.push("getUint16")
    dvNames.push("getInt32")
    dvNames.push("getUint32")
    dvNames.push("getFloat32")
    dvNames.push("getFloat64")
    dvNames.push("setInt8")
    dvNames.push("setUint8")
    dvNames.push("setInt16")
    dvNames.push("setUint16")
    dvNames.push("setInt32")
    dvNames.push("setUint32")
    dvNames.push("setFloat32")
    dvNames.push("setFloat64")
    var d: i64 = 0
    while d < dvNames.len() {
        objSet(&mut st, dvProto, dvNames[d].clone(), makeBrandedMethod(&mut st, dvNames[d].clone(), 3))
        objSetNonEnumerable(&mut st, dvProto, dvNames[d])
        d = d + 1
    }
    // buffer/byteLength/byteOffset are accessors here too, and reading one off
    // anything that is not a DataView is a TypeError.
    var dvAcc: Vec<string> = Vec.new()
    dvAcc.push("buffer")
    dvAcc.push("byteLength")
    dvAcc.push("byteOffset")
    var dvGet: Vec<string> = Vec.new()
    dvGet.push("__dvBuffer")
    dvGet.push("__dvByteLength")
    dvGet.push("__dvByteOffset")
    var dq: i64 = 0
    while dq < dvAcc.len() {
        let dg = makeBrandedMethod(&mut st, dvGet[dq].clone(), 3)
        objDefineAccessor(&mut st, dvProto, dvAcc[dq].clone(), dg, JSValue.Undefined)
        objSetNonEnumerable(&mut st, dvProto, dvAcc[dq])
        dq = dq + 1
    }
    objSet(&mut st, dvProto, "constructor", JSValue.Native(Native.Fn(Builtin.DataView)))
    objSetNonEnumerable(&mut st, dvProto, "constructor")
    let dvBag = getNativeProps(&mut st, Native.Fn(Builtin.DataView))
    objDefineProtoAttr(&mut st, dvBag, "prototype", JSValue.Obj(dvProto))
}

// Build a prototype object for a native constructor: the named methods as
// bound-method values (the call site's receiver wins), a `constructor` back
// link, and the object hung off the native's property bag as `prototype`.
// Returns the prototype handle.
//
// Number, Boolean, Symbol, BigInt, Map, Set and Promise had NO prototype object
// at all — `Number.prototype` read as undefined — which is the same gap the
// buffer family, Date and RegExp each turned out to have. Anything that starts
// from the prototype (every test262 property-descriptor case, and the common
// `Map.prototype.get.call(m, k)` idiom) failed before doing anything.
fn buildNativeProto(st: &mut Interp, nativeId: Builtin, names: &Vec<string>): i64 {
    let proto = newObject(&mut st)
    st.objects[proto].proto = st.objectProtoObj
    // the receiver is Undefined for a prototype method, so the brand cannot be
    // read off it; the constructor id names it instead
    var host = ""
    if nativeId == Builtin.Map {
        host = "Map"
    }
    // Every Map/Set prototype method brand-checks its receiver against the
    // internal slot rather than coercing it, so `Set.prototype.clear.call(0)` is
    // a TypeError. Without a brand these methods accepted any receiver and did
    // nothing, which reads as a successful call.
    var brand: i64 = 0
    if nativeId == Builtin.Map {
        brand = BRAND_MAP
    } else if nativeId == Builtin.Set {
        brand = BRAND_SET
    } else if nativeId == Builtin.Promise {
        brand = BRAND_PROMISE
    } else if nativeId == Builtin.RegExp {
        brand = BRAND_REGEXP
    }
    var i: i64 = 0
    while i < names.len() {
        let m = makeBoundMethodOn(&mut st, JSValue.Undefined, names[i].clone(), host.clone())
        if brand != 0 {
            st.objExtras[st.objects[objHandle(m)].extra].boundBrand = brand
        }
        objSet(&mut st, proto, names[i].clone(), m)
        objSetNonEnumerable(&mut st, proto, names[i])
        i = i + 1
    }
    objSet(&mut st, proto, "constructor", JSValue.Native(Native.Fn(nativeId)))
    objSetNonEnumerable(&mut st, proto, "constructor")
    let bag = getNativeProps(&mut st, Native.Fn(nativeId))
    objDefineProtoAttr(&mut st, bag, "prototype", JSValue.Obj(proto))
    return proto
}

fn setupRemainingProtos(st: &mut Interp) {
    var bigNames: Vec<string> = Vec.new()
    bigNames.push("toString")
    bigNames.push("valueOf")
    bigNames.push("toLocaleString")
    let gp = buildNativeProto(&mut st, Builtin.BigInt, bigNames)
    var vt: Vec<string> = Vec.new()
    vt.push("valueOf")
    vt.push("toString")
    brandProtoMethods(&mut st, gp, BRAND_BIGINT, vt)

    // Number / Boolean / BigInt / Symbol: primitives, so nothing links these as
    // an instance proto — they exist so the prototype itself is reachable.
    var numNames: Vec<string> = Vec.new()
    numNames.push("toString")
    numNames.push("valueOf")
    numNames.push("toFixed")
    numNames.push("toPrecision")
    numNames.push("toExponential")
    numNames.push("toLocaleString")
    let np = buildNativeProto(&mut st, Builtin.Number, numNames)
    var numBrand: Vec<string> = Vec.new()
    numBrand.push("valueOf")
    numBrand.push("toString")
    numBrand.push("toFixed")
    numBrand.push("toPrecision")
    numBrand.push("toExponential")
    brandProtoMethods(&mut st, np, BRAND_NUMBER, numBrand)
    boxProtoItself(&mut st, np, JSValue.Number(0.0))

    var boolNames: Vec<string> = Vec.new()
    boolNames.push("toString")
    boolNames.push("valueOf")
    let bp = buildNativeProto(&mut st, Builtin.Boolean, boolNames)
    var boolBrand: Vec<string> = Vec.new()
    boolBrand.push("valueOf")
    boolBrand.push("toString")
    brandProtoMethods(&mut st, bp, BRAND_BOOLEAN, boolBrand)
    boxProtoItself(&mut st, bp, JSValue.Bool(false))

    var symNames: Vec<string> = Vec.new()
    symNames.push("toString")
    symNames.push("valueOf")
    let sp = buildNativeProto(&mut st, Builtin.Symbol, symNames)
    var symBrand: Vec<string> = Vec.new()
    symBrand.push("valueOf")
    symBrand.push("toString")
    brandProtoMethods(&mut st, sp, BRAND_SYMBOL, symBrand)

    // Map and Set share one method list here because they share a dispatcher;
    // only the names each actually answers are listed per side.
    var mapNames: Vec<string> = Vec.new()
    mapNames.push("get")
    mapNames.push("set")
    mapNames.push("has")
    mapNames.push("delete")
    mapNames.push("clear")
    mapNames.push("forEach")
    mapNames.push("keys")
    mapNames.push("values")
    mapNames.push("entries")
    st.mapProtoObj = buildNativeProto(&mut st, Builtin.Map, mapNames)
    // size is an accessor on Map.prototype/Set.prototype, and was answered by an
    // ad-hoc read on the instance instead — so the prototype carried no
    // descriptor for it and `Map.prototype.size` off a non-Map read as
    // undefined rather than throwing.
    let mapSizeGetter = makeBrandedMethod(&mut st, "__mapSize", BRAND_MAP)
    objDefineAccessor(&mut st, st.mapProtoObj, "size", mapSizeGetter, JSValue.Undefined)
    objSetNonEnumerable(&mut st, st.mapProtoObj, "size")

    var setNames: Vec<string> = Vec.new()
    setNames.push("add")
    setNames.push("has")
    setNames.push("delete")
    setNames.push("clear")
    setNames.push("forEach")
    setNames.push("keys")
    setNames.push("values")
    setNames.push("entries")
    setNames.push("union")
    setNames.push("intersection")
    setNames.push("difference")
    setNames.push("symmetricDifference")
    setNames.push("isSubsetOf")
    setNames.push("isSupersetOf")
    setNames.push("isDisjointFrom")
    st.setProtoObj = buildNativeProto(&mut st, Builtin.Set, setNames)
    let setSizeGetter = makeBrandedMethod(&mut st, "__setSize", BRAND_SET)
    objDefineAccessor(&mut st, st.setProtoObj, "size", setSizeGetter, JSValue.Undefined)
    objSetNonEnumerable(&mut st, st.setProtoObj, "size")

    var promNames: Vec<string> = Vec.new()
    promNames.push("then")
    promNames.push("catch")
    promNames.push("finally")
    st.promiseProtoObj = buildNativeProto(&mut st, Builtin.Promise, promNames)
    // Symbol.species is an accessor returning `this` on every constructor that
    // derives new objects from an existing one. ArraySpeciesCreate and friends
    // read it, and test262 checks the descriptor directly; it was absent
    // everywhere, so the read answered undefined.
    var speciesBags: Vec<i64> = Vec.new()
    speciesBags.push(getNativeProps(&mut st, Native.Fn(Builtin.ArrayBuffer)))
    speciesBags.push(getNativeProps(&mut st, Native.Fn(Builtin.Map)))
    speciesBags.push(getNativeProps(&mut st, Native.Fn(Builtin.Set)))
    speciesBags.push(getNativeProps(&mut st, Native.Fn(Builtin.RegExp)))
    if st.promiseCtorObj >= 0 {
        speciesBags.push(st.promiseCtorObj)
    }
    var sb: i64 = 0
    while sb < speciesBags.len() {
        let sg = makeBoundMethod(&mut st, JSValue.Undefined, "__speciesSelf")
        objDefineAccessor(&mut st, speciesBags[sb], symSpeciesKey(), sg, JSValue.Undefined)
        objSetNonEnumerable(&mut st, speciesBags[sb], symSpeciesKey())
        sb = sb + 1
    }
    // Promise's global binding is a plain OBJECT, not a JSValue.Native, so the
    // prototype hung off the Builtin.Promise bag is unreachable from it — hang it
    // on the constructor object too. This runs after setupGlobals built that
    // object, which is why the link is made here rather than there.
    if st.promiseCtorObj >= 0 {
        objDefineProtoAttr(&mut st, st.promiseCtorObj, "prototype", JSValue.Obj(st.promiseProtoObj))
        objSet(&mut st, st.promiseProtoObj, "constructor", JSValue.Obj(st.promiseCtorObj))
        objSetNonEnumerable(&mut st, st.promiseProtoObj, "constructor")
    }
}

fn setupRegexProto(st: &mut Interp) {
    let rp = newObject(&mut st)
    st.objects[rp].proto = st.objectProtoObj
    var names: Vec<string> = Vec.new()
    names.push("exec")
    names.push("test")
    names.push("__regexpToString")
    names.push("compile")
    // String.prototype.match/replace/search/split are the real implementations
    // here; these delegate to them, which is the direction the spec runs in
    // reverse. Having them at all is what lets code feature-detect a regex.
    names.push("@@sym:Symbol.match:0")
    names.push("@@sym:Symbol.matchAll:0")
    names.push("@@sym:Symbol.replace:0")
    names.push("@@sym:Symbol.search:0")
    names.push("@@sym:Symbol.split:0")
    var i: i64 = 0
    while i < names.len() {
        // Branded, so `RegExp.prototype.exec.call({})` is the TypeError the spec
        // requires rather than a call that quietly answers undefined. The RegExp
        // prototype is built here rather than through buildNativeProto, so it did
        // not pick up the brand the Map and Set prototypes get.
        let rm = makeBoundMethod(&mut st, JSValue.Undefined, names[i].clone())
        // toString is the exception: it is GENERIC, reading `source` and `flags`
        // off whatever object it is given, so `RegExp.prototype.toString.call({
        // source: "x", flags: "y" })` is "/x/y" and not a TypeError. Branding it
        // with the rest broke that.
        if names[i] != "__regexpToString" {
            st.objExtras[st.objects[objHandle(rm)].extra].boundBrand = BRAND_REGEXP
        }
        // installed under its real name; the internal one only selects the
        // generic implementation in callBuiltinByName
        var installAs = names[i].clone()
        if installAs == "__regexpToString" {
            installAs = "toString"
        }
        objSet(&mut st, rp, installAs.clone(), rm)
        objSetNonEnumerable(&mut st, rp, installAs)
        i = i + 1
    }
    // The flag family is an ACCESSOR on the prototype in the spec, while this
    // engine keeps them as own data properties on each instance. Both can hold:
    // the getter is registered under an internal name, so an instance's own
    // property still wins on a normal read and only a read through the prototype
    // itself reaches the accessor.
    var flagNames: Vec<string> = Vec.new()
    flagNames.push("source")
    flagNames.push("flags")
    flagNames.push("global")
    flagNames.push("ignoreCase")
    flagNames.push("multiline")
    flagNames.push("sticky")
    flagNames.push("unicode")
    flagNames.push("unicodeSets")
    flagNames.push("dotAll")
    flagNames.push("hasIndices")
    var f: i64 = 0
    while f < flagNames.len() {
        let getter = makeBoundMethod(&mut st, JSValue.Undefined, "__reGet_" + flagNames[f].clone())
        st.objExtras[st.objects[objHandle(getter)].extra].boundBrand = BRAND_REGEXP
        objDefineAccessor(&mut st, rp, flagNames[f].clone(), getter, JSValue.Undefined)
        objSetNonEnumerable(&mut st, rp, flagNames[f])
        f = f + 1
    }
    objSet(&mut st, rp, "constructor", JSValue.Native(Native.Fn(Builtin.RegExp)))
    objSetNonEnumerable(&mut st, rp, "constructor")
    let rbag = getNativeProps(&mut st, Native.Fn(Builtin.RegExp))
    objDefineProtoAttr(&mut st, rbag, "prototype", JSValue.Obj(rp))
    st.regexProtoObj = rp
}

fn setupErrorProtos(st: &mut Interp) {
    let errorProto = newObject(&mut st)
    objSet(&mut st, errorProto, "name", JSValue.Str("Error"))
    objSet(&mut st, errorProto, "message", JSValue.Str(""))
    objSet(&mut st, errorProto, "constructor", JSValue.Native(Native.Fn(Builtin.Error)))
    // Under its own internal name, because Error.prototype.toString applies to
    // ANY object -- `Error.prototype.toString.call({})` is "Error", not the
    // object type tag. Installed as plain "toString" it was indistinguishable
    // from Object.prototype.toString once the receiver was not an Error.
    objSet(&mut st, errorProto, "toString", makeBoundMethod(&mut st, JSValue.Undefined, "__errorToString"))
    for ep in ["name", "message", "constructor", "toString"] {
        objSetNonEnumerable(&mut st, errorProto, ep)
    }
    let errBag = getNativeProps(&mut st, Native.Fn(Builtin.Error))
    objSet(&mut st, errBag, "prototype", JSValue.Obj(errorProto))
    st.objects[errorProto].proto = st.objectProtoObj

    setupOneErrorProto(&mut st, Builtin.TypeError, errorProto)
    setupOneErrorProto(&mut st, Builtin.RangeError, errorProto)
    setupOneErrorProto(&mut st, Builtin.SyntaxError, errorProto)
    setupOneErrorProto(&mut st, Builtin.ReferenceError, errorProto)
    setupOneErrorProto(&mut st, Builtin.EvalError, errorProto)
    setupOneErrorProto(&mut st, Builtin.UriError, errorProto)
}

fn setupOneErrorProto(st: &mut Interp, eid: Builtin, errorProto: i64) {
    let sub = newObject(&mut st)
    objSet(&mut st, sub, "name", JSValue.Str(nativeErrorName(eid)))
    objSet(&mut st, sub, "message", JSValue.Str(""))
    objSet(&mut st, sub, "constructor", JSValue.Native(Native.Fn(eid)))
    for sp in ["name", "message", "constructor"] {
        objSetNonEnumerable(&mut st, sub, sp)
    }
    st.objects[sub].proto = errorProto
    let bag = getNativeProps(&mut st, Native.Fn(eid))
    objSet(&mut st, bag, "prototype", JSValue.Obj(sub))
}

// Give every native reachable as a method of `owner` its own `name`, derived
// from the key it is registered under. A native's properties live in a bag of
// their own (getNativeProps), so there is nowhere to put a name at the ~145
// individual registration sites; one pass per namespace covers them all.
fn nameNativesOf(st: &mut Interp, owner: i64) {
    var i: i64 = 0
    while i < st.objects[owner].props.len() {
        let key = st.objects[owner].props[i].key.clone()
        let v = cloneValue(st.objects[owner].props[i].value)
        if let JSValue.Native(nid) = v {
            let bag = getNativeProps(&mut st, nid)
            objDefineBuiltinAttr(&mut st, bag, "length", JSValue.Number(builtinStaticArity(key) as f64))
            objDefineBuiltinAttr(&mut st, bag, "name", JSValue.Str(key))
        }
        i = i + 1
    }
}

pub // A global built-in constructor's own `name` and `length`. They are bound with

// scopeDefine rather than hung off a namespace object, so nameNativesOf never
// reaches them and `Date.length` / `Array.name` were undefined.
fn nameGlobalCtor(st: &mut Interp, gname: string, nid: Builtin) {
    let bag = getNativeProps(&mut st, Native.Fn(nid))
    objDefineBuiltinAttr(&mut st, bag, "length", JSValue.Number(builtinCtorArity(gname) as f64))
    objDefineBuiltinAttr(&mut st, bag, "name", JSValue.Str(gname))
}

pub fn setupGlobals(st: &mut Interp) {
    scopeDefine(&mut st, 0, "Error", JSValue.Native(Native.Fn(Builtin.Error)))
    nameGlobalCtor(&mut st, "Error", Builtin.Error)
    scopeDefine(&mut st, 0, "TypeError", JSValue.Native(Native.Fn(Builtin.TypeError)))
    nameGlobalCtor(&mut st, "TypeError", Builtin.TypeError)
    scopeDefine(&mut st, 0, "RangeError", JSValue.Native(Native.Fn(Builtin.RangeError)))
    nameGlobalCtor(&mut st, "RangeError", Builtin.RangeError)
    scopeDefine(&mut st, 0, "SyntaxError", JSValue.Native(Native.Fn(Builtin.SyntaxError)))
    nameGlobalCtor(&mut st, "SyntaxError", Builtin.SyntaxError)
    scopeDefine(&mut st, 0, "ReferenceError", JSValue.Native(Native.Fn(Builtin.ReferenceError)))
    nameGlobalCtor(&mut st, "ReferenceError", Builtin.ReferenceError)
    scopeDefine(&mut st, 0, "EvalError", JSValue.Native(Native.Fn(Builtin.EvalError)))
    nameGlobalCtor(&mut st, "EvalError", Builtin.EvalError)
    scopeDefine(&mut st, 0, "URIError", JSValue.Native(Native.Fn(Builtin.UriError)))
    nameGlobalCtor(&mut st, "URIError", Builtin.UriError)
    scopeDefine(&mut st, 0, "eval", JSValue.Native(Native.Fn(Builtin.Eval)))
    nameGlobalCtor(&mut st, "eval", Builtin.Eval)
    // JSON is a plain object whose methods are native functions
    let json = newObject(&mut st)
    objSet(&mut st, json, "stringify", JSValue.Native(Native.Fn(Builtin.JsonStringify)))
    objSet(&mut st, json, "parse", JSValue.Native(Native.Fn(Builtin.JsonParse)))
    nameNativesOf(&mut st, json)
    scopeDefine(&mut st, 0, "JSON", JSValue.Obj(json))
    // Math likewise: native-fn methods + numeric constants
    let math = newObject(&mut st)
    objSet(&mut st, math, "floor", JSValue.Native(Native.Fn(Builtin.MathFloor)))
    objSet(&mut st, math, "ceil", JSValue.Native(Native.Fn(Builtin.MathCeil)))
    objSet(&mut st, math, "round", JSValue.Native(Native.Fn(Builtin.MathRound)))
    objSet(&mut st, math, "trunc", JSValue.Native(Native.Fn(Builtin.MathTrunc)))
    objSet(&mut st, math, "abs", JSValue.Native(Native.Fn(Builtin.MathAbs)))
    objSet(&mut st, math, "sign", JSValue.Native(Native.Fn(Builtin.MathSign)))
    objSet(&mut st, math, "sqrt", JSValue.Native(Native.Fn(Builtin.MathSqrt)))
    objSet(&mut st, math, "pow", JSValue.Native(Native.Fn(Builtin.MathPow)))
    objSet(&mut st, math, "min", JSValue.Native(Native.Fn(Builtin.MathMin)))
    objSet(&mut st, math, "max", JSValue.Native(Native.Fn(Builtin.MathMax)))
    objSet(&mut st, math, "random", JSValue.Native(Native.Fn(Builtin.MathRandom)))
    objSet(&mut st, math, "exp", JSValue.Native(Native.Fn(Builtin.MathExp)))
    objSet(&mut st, math, "log", JSValue.Native(Native.Fn(Builtin.MathLog)))
    objSet(&mut st, math, "log2", JSValue.Native(Native.Fn(Builtin.MathLog2)))
    objSet(&mut st, math, "log10", JSValue.Native(Native.Fn(Builtin.MathLog10)))
    objSet(&mut st, math, "sin", JSValue.Native(Native.Fn(Builtin.MathSin)))
    objSet(&mut st, math, "cos", JSValue.Native(Native.Fn(Builtin.MathCos)))
    objSet(&mut st, math, "tan", JSValue.Native(Native.Fn(Builtin.MathTan)))
    objSet(&mut st, math, "asin", JSValue.Native(Native.Fn(Builtin.MathAsin)))
    objSet(&mut st, math, "acos", JSValue.Native(Native.Fn(Builtin.MathAcos)))
    objSet(&mut st, math, "atan", JSValue.Native(Native.Fn(Builtin.MathAtan)))
    objSet(&mut st, math, "atan2", JSValue.Native(Native.Fn(Builtin.MathAtan2)))
    objSet(&mut st, math, "LN2", JSValue.Number(0.6931471805599453))
    objSet(&mut st, math, "LN10", JSValue.Number(2.302585092994046))
    objSet(&mut st, math, "LOG2E", JSValue.Number(1.4426950408889634))
    objSet(&mut st, math, "LOG10E", JSValue.Number(0.4342944819032518))
    objSet(&mut st, math, "SQRT2", JSValue.Number(1.4142135623730951))
    objSet(&mut st, math, "SQRT1_2", JSValue.Number(0.7071067811865476))
    objSet(&mut st, math, "PI", JSValue.Number(3.141592653589793))
    objSet(&mut st, math, "E", JSValue.Number(2.718281828459045))
    nameNativesOf(&mut st, math)
    // every own property of Math is non-enumerable, and its CONSTANTS are also
    // non-writable and non-configurable. test262 has a prop-desc.js per member.
    var mki: i64 = 0
    while mki < st.objects[math].props.len() {
        st.objects[math].props[mki].enumerable = false
        mki = mki + 1
    }
    for mc in ["PI", "E", "LN2", "LN10", "LOG2E", "LOG10E", "SQRT2", "SQRT1_2"] {
        let ci = objOwnIndex(st, math, mc)
        if ci >= 0 {
            st.objects[math].props[ci].writable = false
            st.objects[math].props[ci].configurable = false
        }
    }
    scopeDefine(&mut st, 0, "Math", JSValue.Obj(math))
    scopeDefine(&mut st, 0, "RegExp", JSValue.Native(Native.Fn(Builtin.RegExp)))
    nameGlobalCtor(&mut st, "RegExp", Builtin.RegExp)
    let promiseCtor = newObject(&mut st)
    nameNativesOf(&mut st, promiseCtor)
    // Array and Promise are constructor OBJECTS here, not Natives, so the
    // native naming pass never reached them and both lacked own `length` and
    // `name`. get-intrinsic resolves %Array.length% and reports "base intrinsic
    // exists, but the property is not available" without them, which is where
    // call-bound stops.
    objDefineBuiltinAttr(&mut st, promiseCtor, "length", JSValue.Number(1.0))
    objDefineBuiltinAttr(&mut st, promiseCtor, "name", JSValue.Str("Promise"))
    // Marked like arrayCtor: without it `typeof Promise` answered "object" and
    // Promise did not report as a constructor.
    st.objects[promiseCtor].isFunctionLike = true
    st.promiseCtorObj = promiseCtor
    objSet(&mut st, promiseCtor, "resolve", JSValue.Native(Native.Fn(Builtin.PromiseResolve)))
    objSet(&mut st, promiseCtor, "reject", JSValue.Native(Native.Fn(Builtin.PromiseReject)))
    scopeDefine(&mut st, 0, "Promise", JSValue.Obj(promiseCtor))
    // Object's statics live in the property bag that belongs to the native id,
    // so reading `Object.keys` as a value and calling `Object.keys(o)` both go
    // through the same place. A standalone object would only serve the call path.
    let objectCtor = getNativeProps(&mut st, Native.Fn(Builtin.ObjectCtor))
    objSet(&mut st, objectCtor, "defineProperty", JSValue.Native(Native.Fn(Builtin.ObjectDefineProperty)))
    objSet(&mut st, objectCtor, "keys", JSValue.Native(Native.Fn(Builtin.ObjectKeys)))
    objSet(&mut st, objectCtor, "assign", JSValue.Native(Native.Fn(Builtin.ObjectAssign)))
    objSet(&mut st, objectCtor, "values", JSValue.Native(Native.Fn(Builtin.ObjectValues)))
    objSet(&mut st, objectCtor, "entries", JSValue.Native(Native.Fn(Builtin.ObjectEntries)))
    objSet(&mut st, objectCtor, "freeze", JSValue.Native(Native.Fn(Builtin.ObjectFreeze)))
    objSet(&mut st, objectCtor, "isFrozen", JSValue.Native(Native.Fn(Builtin.ObjectIsFrozen)))
    objSet(&mut st, objectCtor, "preventExtensions", JSValue.Native(Native.Fn(Builtin.ObjectPreventExt)))
    objSet(&mut st, objectCtor, "isExtensible", JSValue.Native(Native.Fn(Builtin.ObjectIsExt)))
    objSet(&mut st, objectCtor, "seal", JSValue.Native(Native.Fn(Builtin.ObjectSeal)))
    objSet(&mut st, objectCtor, "isSealed", JSValue.Native(Native.Fn(Builtin.ObjectIsSealed)))
    objSet(&mut st, objectCtor, "create", JSValue.Native(Native.Fn(Builtin.ObjectCreate)))
    objSet(&mut st, objectCtor, "getPrototypeOf", JSValue.Native(Native.Fn(Builtin.ObjectGetProto)))
    objSet(&mut st, objectCtor, "setPrototypeOf", JSValue.Native(Native.Fn(Builtin.ObjectSetProto)))
    objSet(&mut st, objectCtor, "getOwnPropertyDescriptor", JSValue.Native(Native.Fn(Builtin.ObjectGetOwnPropDesc)))
    objSet(&mut st, objectCtor, "getOwnPropertyDescriptors", JSValue.Native(Native.Fn(Builtin.ObjectGetOwnPropDescs)))
    objSet(&mut st, objectCtor, "defineProperties", JSValue.Native(Native.Fn(Builtin.ObjectDefineProperties)))
    objSet(&mut st, objectCtor, "getOwnPropertyNames", JSValue.Native(Native.Fn(Builtin.ObjectGetOwnPropNames)))
    objSet(&mut st, objectCtor, "getOwnPropertySymbols", JSValue.Native(Native.Fn(Builtin.ObjectGetOwnPropSymbols)))
    objSet(&mut st, objectCtor, "is", JSValue.Native(Native.Fn(Builtin.ObjectIs)))
    objSet(&mut st, objectCtor, "hasOwn", JSValue.Native(Native.Fn(Builtin.ObjectHasOwn)))
    let objectProto = newObject(&mut st)
    objSet(&mut st, objectProto, "hasOwnProperty", makeBoundMethod(&mut st, JSValue.Undefined, "hasOwnProperty"))
    // Object.prototype.toString.call(x) is the standard type-detection idiom
    // bound under a private name, not "toString": dispatching by the plain name
    // sent Object.prototype.toString.call(x) into x's OWN toString (a function
    // printed its source, a regex returned undefined), which broke the
    // `Object.prototype.toString.call(o).slice(8, -1)` type-tag idiom.
    objSet(&mut st, objectProto, "toString", makeBoundMethod(&mut st, JSValue.Undefined, "@@objProtoToString"))
    objSet(&mut st, objectProto, "valueOf", makeBoundMethod(&mut st, JSValue.Undefined, "valueOf"))
    objSet(&mut st, objectProto, "isPrototypeOf", makeBoundMethod(&mut st, JSValue.Undefined, "isPrototypeOf"))
    objSet(&mut st, objectProto, "propertyIsEnumerable", makeBoundMethod(&mut st, JSValue.Undefined, "propertyIsEnumerable"))
    // Object.prototype's own methods are non-enumerable. Nothing had it in a
    // for-in reachable chain before (a plain object is not linked to it here),
    // so the omission stayed invisible until String wrappers arrived and listed
    // hasOwnProperty/toString/valueOf/isPrototypeOf among a string's indices.
    for opm in ["hasOwnProperty", "toString", "valueOf", "isPrototypeOf", "propertyIsEnumerable"] {
        objSetNonEnumerable(&mut st, objectProto, opm)
    }
    objSet(&mut st, objectCtor, "prototype", JSValue.Obj(objectProto))
    st.objectProtoObj = objectProto
    // after objectProtoObj exists: Error.prototype chains to it
    setupErrorProtos(&mut st)
    setupTypedArrayProtos(&mut st)
    setupBufferProtos(&mut st)
    setupRegexProto(&mut st)
    setupRemainingProtos(&mut st)
    // Object is itself an object, so it carries the Object.prototype methods.
    // Code borrows them from the constructor — `Object.hasOwnProperty.call(o, k)`
    // is a common way to avoid a shadowed own property — and the native's bag
    // does not inherit, so they are installed explicitly.
    objSet(&mut st, objectCtor, "hasOwnProperty", makeBoundMethod(&mut st, JSValue.Undefined, "hasOwnProperty"))
    objSet(&mut st, objectCtor, "isPrototypeOf", makeBoundMethod(&mut st, JSValue.Undefined, "isPrototypeOf"))
    objSet(&mut st, objectCtor, "propertyIsEnumerable", makeBoundMethod(&mut st, JSValue.Undefined, "propertyIsEnumerable"))
    objSet(&mut st, objectCtor, "toString", makeBoundMethod(&mut st, JSValue.Undefined, "@@objProtoToString"))
    objSet(&mut st, objectCtor, "valueOf", makeBoundMethod(&mut st, JSValue.Undefined, "valueOf"))
    nameNativesOf(&mut st, objectCtor)
    scopeDefine(&mut st, 0, "Object", JSValue.Native(Native.Fn(Builtin.ObjectCtor)))
    nameGlobalCtor(&mut st, "Object", Builtin.ObjectCtor)
    scopeDefine(&mut st, 0, "Number", JSValue.Native(Native.Fn(Builtin.Number)))
    nameGlobalCtor(&mut st, "Number", Builtin.Number)
    scopeDefine(&mut st, 0, "BigInt", JSValue.Native(Native.Fn(Builtin.BigInt)))
    nameGlobalCtor(&mut st, "BigInt", Builtin.BigInt)
    let stringCtorObj = getNativeProps(&mut st, Native.Fn(Builtin.String))
    objSet(&mut st, stringCtorObj, "fromCharCode", JSValue.Native(Native.Fn(Builtin.StringFromCharCode)))
    objSet(&mut st, stringCtorObj, "fromCodePoint", JSValue.Native(Native.Fn(Builtin.StringFromCodePoint)))
    objSet(&mut st, stringCtorObj, "raw", JSValue.Native(Native.Fn(Builtin.StringRaw)))
    // String.prototype methods as bound-method values, so
    // String.prototype.replace.call(str, ...) — the qs module's pattern — works
    let stringProto = newObject(&mut st)
    for sm in strProtoMethodNames() {
        // trimLeft/trimRight are the SAME function objects as trimStart/trimEnd,
        // not lookalikes: annexB defines them as aliases, so identity and .name
        // both have to come from the ES method
        var mname = sm.clone()
        if sm == "trimLeft" {
            mname = "trimStart"
        }
        if sm == "trimRight" {
            mname = "trimEnd"
        }
        if mname == sm {
            objSet(&mut st, stringProto, sm.clone(), makeBrandedMethod(&mut st, sm.clone(), BRAND_STRING_GENERIC))
        } else {
            objSet(&mut st, stringProto, sm.clone(), getMember(st, stringProto, mname))
        }
        objSetNonEnumerable(&mut st, stringProto, sm)
    }
    var strBrand: Vec<string> = Vec.new()
    strBrand.push("valueOf")
    strBrand.push("toString")
    brandProtoMethods(&mut st, stringProto, BRAND_STRING, strBrand)
    boxProtoItself(&mut st, stringProto, JSValue.Str(""))
    objSetFrozenOwn(&mut st, stringProto, "length", JSValue.Number(0.0), false)
    objSet(&mut st, stringProto, "constructor", JSValue.Native(Native.Fn(Builtin.String)))
    objSetNonEnumerable(&mut st, stringProto, "constructor")
    st.objects[stringProto].proto = objectProto
    objSet(&mut st, stringCtorObj, "prototype", JSValue.Obj(stringProto))
    nameNativesOf(&mut st, stringCtorObj)
    st.stringCtorProps = stringCtorObj
    st.stringProtoObj = stringProto
    st.stringProtoPristine = true
    scopeDefine(&mut st, 0, "String", JSValue.Native(Native.Fn(Builtin.String)))
    nameGlobalCtor(&mut st, "String", Builtin.String)
    scopeDefine(&mut st, 0, "Boolean", JSValue.Native(Native.Fn(Builtin.Boolean)))
    nameGlobalCtor(&mut st, "Boolean", Builtin.Boolean)
    scopeDefine(&mut st, 0, "NaN", JSValue.Number(jsNan()))
    scopeDefine(&mut st, 0, "Infinity", JSValue.Number(jsInfinity()))
    scopeDefine(&mut st, 0, "isNaN", JSValue.Native(Native.Fn(Builtin.IsNan)))
    scopeDefine(&mut st, 0, "gc", JSValue.Native(Native.Fn(Builtin.Gc)))
    scopeDefine(&mut st, 0, "isFinite", JSValue.Native(Native.Fn(Builtin.IsFinite)))
    scopeDefine(&mut st, 0, "parseInt", JSValue.Native(Native.Fn(Builtin.ParseInt)))
    scopeDefine(&mut st, 0, "parseFloat", JSValue.Native(Native.Fn(Builtin.ParseFloat)))
    // The shared iterator prototype. The prelude installs the helper methods
    // (map/filter/take/...) onto this one object; every iterator the engine
    // builds points its proto here, so helpers work on array iterators too.
    let iterProto = newObject(&mut st)
    // %IteratorPrototype% inherits from Object.prototype. The link was missing,
    // so the array-iterator chain was one shorter than node's and
    // getPrototypeOf three deep answered null. Invisible until Reflect started
    // rejecting a non-object argument, which is what a null third link is.
    st.objects[iterProto].proto = st.objectProtoObj
    st.iterProtoObj = iterProto
    scopeDefine(&mut st, 0, "__iteratorProto", JSValue.Obj(iterProto))
    // globalThis: a real object whose properties ARE the global bindings
    let globalObj = newObject(&mut st)
    st.objects[globalObj].isGlobal = true
    scopeDefine(&mut st, 0, "globalThis", JSValue.Obj(globalObj))
    scopeDefine(&mut st, 0, "Symbol", JSValue.Native(Native.Fn(Builtin.Symbol)))
    nameGlobalCtor(&mut st, "Symbol", Builtin.Symbol)
    let symbolCtorObj = getNativeProps(&mut st, Native.Fn(Builtin.Symbol))
    objSet(&mut st, symbolCtorObj, "iterator", JSValue.Str(symIteratorKey()))
    // other well-known symbols — interned keys like @@iterator, counter 0
    objSet(&mut st, symbolCtorObj, "asyncIterator", JSValue.Str("@@sym:Symbol.asyncIterator:0"))
    objSet(&mut st, symbolCtorObj, "toPrimitive", JSValue.Str(symToPrimitiveKey()))
    objSet(&mut st, symbolCtorObj, "toStringTag", JSValue.Str(symToStringTagKey()))
    objSet(&mut st, symbolCtorObj, "hasInstance", JSValue.Str("@@sym:Symbol.hasInstance:0"))
    // the regex protocol symbols, which RegExp.prototype implements
    objSet(&mut st, symbolCtorObj, "match", JSValue.Str("@@sym:Symbol.match:0"))
    objSet(&mut st, symbolCtorObj, "matchAll", JSValue.Str("@@sym:Symbol.matchAll:0"))
    objSet(&mut st, symbolCtorObj, "replace", JSValue.Str("@@sym:Symbol.replace:0"))
    objSet(&mut st, symbolCtorObj, "search", JSValue.Str("@@sym:Symbol.search:0"))
    objSet(&mut st, symbolCtorObj, "split", JSValue.Str("@@sym:Symbol.split:0"))
    objSet(&mut st, symbolCtorObj, "species", JSValue.Str(symSpeciesKey()))
    objSet(&mut st, symbolCtorObj, "isConcatSpreadable", JSValue.Str(symConcatSpreadableKey()))
    objSet(&mut st, symbolCtorObj, "unscopables", JSValue.Str("@@sym:Symbol.unscopables:0"))
    objSet(&mut st, symbolCtorObj, "dispose", JSValue.Str("@@sym:Symbol.dispose:0"))
    objSet(&mut st, symbolCtorObj, "asyncDispose", JSValue.Str("@@sym:Symbol.asyncDispose:0"))
    let dateCtorObj = getNativeProps(&mut st, Native.Fn(Builtin.Date))
    objSet(&mut st, dateCtorObj, "now", JSValue.Native(Native.Fn(Builtin.DateNow)))
    objSet(&mut st, dateCtorObj, "UTC", JSValue.Native(Native.Fn(Builtin.DateUtc)))
    objSet(&mut st, dateCtorObj, "parse", JSValue.Native(Native.Fn(Builtin.DateParse)))
    // Date.prototype methods as bound-method values, so
    // Date.prototype.toISOString.call(d) — qs's pattern — works
    let dateProto = newObject(&mut st)
    for dm in dateProtoMethodNames() {
        objSet(&mut st, dateProto, dm.clone(), makeBrandedMethod(&mut st, dm.clone(), BRAND_DATE))
        objSetNonEnumerable(&mut st, dateProto, dm)
    }
    // Date.prototype[@@toPrimitive]: the one built-in that prefers "string" for a
    // default hint, which is why `date + ""` concatenates the text while
    // `date - 0` is numeric. Its absence made `d[Symbol.toPrimitive]("number")`
    // undefined -- code that calls it explicitly, and any polyfill checking for
    // it, saw a Date as having no primitive conversion at all.
    objSet(&mut st, dateProto, symToPrimitiveKey(), makeBrandedMethod(&mut st, "__dateToPrimitive", BRAND_DATE))
    objSetNonEnumerable(&mut st, dateProto, symToPrimitiveKey())
    objDefineProtoAttr(&mut st, dateCtorObj, "prototype", JSValue.Obj(dateProto))
    objSet(&mut st, dateProto, "constructor", JSValue.Native(Native.Fn(Builtin.Date)))
    objSetNonEnumerable(&mut st, dateProto, "constructor")
    st.objects[dateProto].proto = st.objectProtoObj
    nameNativesOf(&mut st, dateCtorObj)
    // after nameNativesOf, which would otherwise overwrite it: Date.parse is the
    // one static whose name collides across namespaces (JSON.parse is 2), and
    // builtinStaticArity is keyed by name alone
    objDefineBuiltinAttr(&mut st, getNativeProps(&mut st, Native.Fn(Builtin.DateParse)), "length", JSValue.Number(1.0))
    st.dateProtoObj = dateProto
    st.dateCtorProps = dateCtorObj
    scopeDefine(&mut st, 0, "Date", JSValue.Native(Native.Fn(Builtin.Date)))
    nameGlobalCtor(&mut st, "Date", Builtin.Date)
    // Function.prototype.{call,apply,bind} are bound-method values: invoking
    // .call on them re-targets to whatever function is passed as the receiver,
    // which is how Function.prototype.apply.call(fn, ...) resolves
    let functionProto = newObject(&mut st)
    // All three require a callable `this`: `Function.prototype.bind.call({})` is
    // a TypeError, not a bind of nothing. toString below already said so; these
    // three did not, so they answered undefined for a receiver they could not
    // possibly bind.
    objSet(&mut st, functionProto, "call", makeBrandedMethod(&mut st, "call", BRAND_CALLABLE))
    objSet(&mut st, functionProto, "apply", makeBrandedMethod(&mut st, "apply", BRAND_CALLABLE))
    objSet(&mut st, functionProto, "bind", makeBrandedMethod(&mut st, "bind", BRAND_CALLABLE))
    // lodash and friends compare functions by source text via
    // Function.prototype.toString.call(fn)
    objSet(&mut st, functionProto, "toString", makeBrandedMethod(&mut st, "toString", BRAND_CALLABLE))
    st.objects[functionProto].isFunctionLike = true
    // Function is a Native rather than a plain object so that CALLING it reaches
    // callNativeProg; as an object it was only ever a namespace holding
    // .prototype, and `Function("return 1")` reported "Function is not a
    // function".
    // Function.prototype is itself a function of no arguments and no name, and
    // it owns both properties: `delete f.name` has to fall through to the empty
    // string here rather than to undefined
    objDefineBuiltinAttr(&mut st, functionProto, "name", JSValue.Str(""))
    objDefineBuiltinAttr(&mut st, functionProto, "length", JSValue.Number(0.0))
    st.functionProtoObj = functionProto
    let functionCtorBag = getNativeProps(&mut st, Native.Fn(Builtin.FunctionCtor))
    objDefineProtoAttr(&mut st, functionCtorBag, "prototype", JSValue.Obj(functionProto))
    objSet(&mut st, functionProto, "constructor", JSValue.Native(Native.Fn(Builtin.FunctionCtor)))
    objSetNonEnumerable(&mut st, functionProto, "constructor")
    scopeDefine(&mut st, 0, "Function", JSValue.Native(Native.Fn(Builtin.FunctionCtor)))
    nameGlobalCtor(&mut st, "Function", Builtin.FunctionCtor)
    scopeDefine(&mut st, 0, "setTimeout", JSValue.Native(Native.Fn(Builtin.SetTimeout)))
    scopeDefine(&mut st, 0, "setInterval", JSValue.Native(Native.Fn(Builtin.SetInterval)))
    scopeDefine(&mut st, 0, "clearTimeout", JSValue.Native(Native.Fn(Builtin.ClearTimer)))
    scopeDefine(&mut st, 0, "clearInterval", JSValue.Native(Native.Fn(Builtin.ClearTimer)))
    scopeDefine(&mut st, 0, "clearImmediate", JSValue.Native(Native.Fn(Builtin.ClearTimer)))
    scopeDefine(&mut st, 0, "setImmediate", JSValue.Native(Native.Fn(Builtin.SetImmediate)))
    scopeDefine(&mut st, 0, "queueMicrotask", JSValue.Native(Native.Fn(Builtin.QueueMicrotaskJs)))
    // not a JS global in node; lib/util.js reads it off globalThis so util.inspect
    // and console.log render identically
    scopeDefine(&mut st, 0, "__inspect", JSValue.Native(Native.Fn(Builtin.Inspect)))
    scopeDefine(&mut st, 0, "__isConstructor", JSValue.Native(Native.Fn(Builtin.IsConstructor)))
    scopeDefine(&mut st, 0, "__markNotConstructor", JSValue.Native(Native.Fn(Builtin.MarkNotCtor)))
    // The raw "wrap a value in a resolved promise" primitive, exposed under its
    // own name so the prelude can build the public Promise.resolve on top of it.
    // Capturing `Promise.resolve` from JS does not work: reading a method off a
    // native constructor yields a late-bound dispatcher that looks the name up
    // again at call time, so a wrapper calling the captured value re-entered
    // itself forever.
    scopeDefine(&mut st, 0, "__promiseResolveValue", JSValue.Native(Native.Fn(Builtin.PromiseResolve)))
    scopeDefine(&mut st, 0, "encodeURIComponent", JSValue.Native(Native.Fn(Builtin.EncodeUriComponent)))
    scopeDefine(&mut st, 0, "decodeURIComponent", JSValue.Native(Native.Fn(Builtin.DecodeUriComponent)))
    scopeDefine(&mut st, 0, "encodeURI", JSValue.Native(Native.Fn(Builtin.EncodeUri)))
    scopeDefine(&mut st, 0, "decodeURI", JSValue.Native(Native.Fn(Builtin.DecodeUri)))
    scopeDefine(&mut st, 0, "ArrayBuffer", JSValue.Native(Native.Fn(Builtin.ArrayBuffer)))
    nameGlobalCtor(&mut st, "ArrayBuffer", Builtin.ArrayBuffer)
    scopeDefine(&mut st, 0, "DataView", JSValue.Native(Native.Fn(Builtin.DataView)))
    nameGlobalCtor(&mut st, "DataView", Builtin.DataView)
    var tk: i64 = 0
    while tk <= TA_MAX {
        scopeDefine(&mut st, 0, taName(tk), JSValue.Native(Native.TypedArrayCtor(tk)))
        tk = tk + 1
    }
    scopeDefine(&mut st, 0, "Map", JSValue.Native(Native.Fn(Builtin.Map)))
    nameGlobalCtor(&mut st, "Map", Builtin.Map)
    scopeDefine(&mut st, 0, "WeakMap", JSValue.Native(Native.Fn(Builtin.Map)))
    scopeDefine(&mut st, 0, "Set", JSValue.Native(Native.Fn(Builtin.Set)))
    nameGlobalCtor(&mut st, "Set", Builtin.Set)
    scopeDefine(&mut st, 0, "WeakSet", JSValue.Native(Native.Fn(Builtin.Set)))
    // Array.prototype.<m> as a bound-method value, so the ES5 idiom
    // Array.prototype.slice.call(arguments) resolves
    let arrayProto = newObject(&mut st)
    // Every whitelisted method, not a hand-picked few: each is generic in ES, so
    // Array.prototype.<m>.call(arrayLike) has to resolve for all of them. The
    // bound `this` is left unset so the call site's receiver wins (see
    // isBoundThisSet).
    // Non-enumerable, which matters now that arrays link this as a real proto:
    // `for (k in [1,2])` and Object.keys must yield indices only, not 36 methods.
    var apm: i64 = 0
    let apNames = arrayMethodNames()
    while apm < apNames.len() {
        objSet(&mut st, arrayProto, apNames[apm].clone(), makeBoundMethod(&mut st, JSValue.Undefined, apNames[apm].clone()))
        objSetNonEnumerable(&mut st, arrayProto, apNames[apm])
        apm = apm + 1
    }
    // Array.prototype[Symbol.iterator] IS Array.prototype.values, as a real
    // property rather than something synthesised per instance. Synthesising it
    // meant `delete Array.prototype[Symbol.iterator]` had no effect at all and
    // the two were not the same function, which test262 checks directly and
    // which every iteration test that removes the method depends on.
    objSet(&mut st, arrayProto, symIteratorKey(), objGet(st, arrayProto, "values"))
    objSetNonEnumerable(&mut st, arrayProto, symIteratorKey())
    let arrayCtor = newObject(&mut st)
    st.objects[arrayCtor].isFunctionLike = true
    objSet(&mut st, arrayCtor, "prototype", JSValue.Obj(arrayProto))
    objSet(&mut st, arrayCtor, "name", JSValue.Str("Array"))
    nameNativesOf(&mut st, arrayCtor)
    objDefineBuiltinAttr(&mut st, arrayCtor, "length", JSValue.Number(1.0))
    objDefineBuiltinAttr(&mut st, arrayCtor, "name", JSValue.Str("Array"))
    st.arrayCtorObj = arrayCtor
    st.arrayProtoObj = arrayProto
    // Array's species accessor goes on here rather than with the others: the
    // constructor object does not exist yet when that block runs.
    let arrSpecies = makeBoundMethod(&mut st, JSValue.Undefined, "__speciesSelf")
    objDefineAccessor(&mut st, arrayCtor, symSpeciesKey(), arrSpecies, JSValue.Undefined)
    objSetNonEnumerable(&mut st, arrayCtor, symSpeciesKey())
    // Set only now that setup has finished writing the methods in, so the setup
    // writes themselves do not count as a user touch.
    st.arrayProtoPristine = true
    objSet(&mut st, arrayCtor, "isArray", JSValue.Native(Native.Fn(Builtin.ArrayIsArray)))
    objSet(&mut st, arrayCtor, "from", JSValue.Native(Native.Fn(Builtin.ArrayFrom)))
    scopeDefine(&mut st, 0, "Array", JSValue.Obj(arrayCtor))
    scopeDefine(&mut st, 0, "__callFrames", JSValue.Native(Native.Fn(Builtin.CallFrames)))
    scopeDefine(&mut st, 0, "__byteLength", JSValue.Native(Native.Fn(Builtin.ByteLength)))
    let consoleObj = newObject(&mut st)
    objSet(&mut st, consoleObj, "log", JSValue.Native(Native.Fn(Builtin.ConsoleLog)))
    objSet(&mut st, consoleObj, "info", JSValue.Native(Native.Fn(Builtin.ConsoleLog)))
    objSet(&mut st, consoleObj, "debug", JSValue.Native(Native.Fn(Builtin.ConsoleLog)))
    objSet(&mut st, consoleObj, "trace", JSValue.Native(Native.Fn(Builtin.ConsoleLog)))
    objSet(&mut st, consoleObj, "dir", JSValue.Native(Native.Fn(Builtin.ConsoleLog)))
    objSet(&mut st, consoleObj, "warn", JSValue.Native(Native.Fn(Builtin.ConsoleError)))
    objSet(&mut st, consoleObj, "error", JSValue.Native(Native.Fn(Builtin.ConsoleError)))
    scopeDefine(&mut st, 0, "console", JSValue.Obj(consoleObj))
    scopeDefine(&mut st, 0, "Proxy", JSValue.Native(Native.Fn(Builtin.Proxy)))
    nameGlobalCtor(&mut st, "Proxy", Builtin.Proxy)
    let proxyBag = getNativeProps(&mut st, Native.Fn(Builtin.Proxy))
    // Proxy.revocable is writable, unlike the `length`/`name` that
    // objDefineBuiltinAttr installs, so its attributes are set by hand
    objSet(&mut st, proxyBag, "revocable", JSValue.Native(Native.Fn(Builtin.ProxyRevocable)))
    objSetNonEnumerable(&mut st, proxyBag, "revocable")
    let revocableBag = getNativeProps(&mut st, Native.Fn(Builtin.ProxyRevocable))
    objDefineBuiltinAttr(&mut st, revocableBag, "length", JSValue.Number(2.0))
    objDefineBuiltinAttr(&mut st, revocableBag, "name", JSValue.Str("revocable"))
    scopeDefine(&mut st, 0, "__reflectDefineProperty", JSValue.Native(Native.Fn(Builtin.ReflectDefineProp)))
    scopeDefine(&mut st, 0, "__reflectSet", JSValue.Native(Native.Fn(Builtin.ReflectSet)))
    scopeDefine(&mut st, 0, "__reflectGet", JSValue.Native(Native.Fn(Builtin.ReflectGet)))
    scopeDefine(&mut st, 0, "__reflectSetPrototypeOf", JSValue.Native(Native.Fn(Builtin.ReflectSetProto)))
    scopeDefine(&mut st, 0, "__reflectDelete", JSValue.Native(Native.Fn(Builtin.ReflectDelete)))
    scopeDefine(&mut st, 0, "__reflectPreventExtensions", JSValue.Native(Native.Fn(Builtin.ReflectPreventExt)))
    scopeDefine(&mut st, 0, "__construct", JSValue.Native(Native.Fn(Builtin.ReflectConstruct)))
    scopeDefine(&mut st, 0, "__reflectOwnKeys", JSValue.Native(Native.Fn(Builtin.ReflectOwnKeys)))
}

pub fn symSpeciesKey(): string {
    return "@@sym:Symbol.species:0"
}

pub fn symConcatSpreadableKey(): string {
    return "@@sym:Symbol.isConcatSpreadable:0"
}

fn strProtoMethodNames(): Vec<string> {
    var out: Vec<string> = Vec.new()
    out.push("replace")
    out.push("split")
    out.push("slice")
    out.push("substring")
    out.push("substr")
    out.push("indexOf")
    out.push("lastIndexOf")
    out.push("charAt")
    out.push("charCodeAt")
    out.push("toUpperCase")
    out.push("toLowerCase")
    out.push("toLocaleUpperCase")
    out.push("toLocaleLowerCase")
    out.push("isWellFormed")
    out.push("toWellFormed")
    // These dispatched by name but were absent from the prototype, so
    // `typeof "".matchAll` was "undefined" and every test262 case that starts
    // from String.prototype failed before calling anything: matchAll was 0/25
    // for that reason alone, not for 25 defects.
    out.push("codePointAt")
    out.push("at")
    out.push("replaceAll")
    out.push("localeCompare")
    out.push("normalize")
    out.push("matchAll")
    out.push("trim")
    out.push("trimStart")
    out.push("trimEnd")
    out.push("startsWith")
    out.push("endsWith")
    out.push("includes")
    out.push("repeat")
    out.push("padStart")
    out.push("padEnd")
    out.push("concat")
    out.push("match")
    out.push("search")
    out.push("toString")
    out.push("valueOf")
    out.push("trimLeft")
    out.push("trimRight")
    // annexB's HTML methods; implemented in stringMethod
    out.push("anchor")
    out.push("big")
    out.push("blink")
    out.push("bold")
    out.push("fixed")
    out.push("fontcolor")
    out.push("fontsize")
    out.push("italics")
    out.push("link")
    out.push("small")
    out.push("strike")
    out.push("sub")
    out.push("sup")
    return out
}

fn arrayMethodNames(): Vec<string> {
    var v: Vec<string> = Vec.new()
    v.push("map")
    v.push("filter")
    v.push("forEach")
    v.push("reduce")
    v.push("join")
    v.push("indexOf")
    v.push("includes")
    v.push("slice")
    v.push("reverse")
    v.push("concat")
    v.push("push")
    v.push("pop")
    v.push("find")
    v.push("findIndex")
    v.push("some")
    v.push("every")
    v.push("shift")
    v.push("unshift")
    v.push("splice")
    v.push("sort")
    v.push("lastIndexOf")
    v.push("flat")
    v.push("fill")
    v.push("at")
    v.push("findLast")
    v.push("findLastIndex")
    v.push("copyWithin")
    v.push("reduceRight")
    v.push("flatMap")
    v.push("values")
    v.push("keys")
    v.push("entries")
    v.push("with")
    v.push("toReversed")
    v.push("toSorted")
    v.push("toSpliced")
    v.push("toString")
    return v
}
