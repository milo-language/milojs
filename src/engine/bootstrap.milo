    v.push("shift")
    v.push("unshift")
    v.push("splice")
    v.push("sort")
    v.push("lastIndexOf")
    v.push("flat")
    v.push("fill")
    v.push("at")
    v.push("findLast")
    v.push("findLastIndex")
    v.push("copyWithin")
    v.push("reduceRight")
    v.push("flatMap")
    v.push("values")
    v.push("keys")
