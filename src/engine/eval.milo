        let arr = newArray(&mut st)
        pushTemp(&mut st, JSValue.Obj(arr))
        let keys = ownKeysOf(gProg, &mut st, argVals[0])
        if st.throwing {
            popTemp(&mut st)
            return JSValue.Undefined
        }
        var ki: i64 = 0
        while ki < keys.len() {
            arrPush(&mut st, arr, propKeyValue(keys[ki]))
            ki = ki + 1
        }
        popTemp(&mut st)
        return JSValue.Obj(arr)
    }
    if id == Builtin.ReflectConstruct {
        var cargs: Vec<JSValue> = Vec.new()
        if argVals.len() > 1 {
            applyArgsInto(gProg, &mut st, argVals[1], &mut cargs)
            if st.throwing {
                return JSValue.Undefined
            }
        }
        var nt = cloneValue(argVals[0])
        if argVals.len() > 2 {
            nt = cloneValue(argVals[2])
        }
        return constructValue(gProg, &mut st, argVals[0], cargs, nt)
    }
    if id == Builtin.ReflectGet {
        // ToPropertyKey runs a user toString, and it runs BEFORE the read
        let key = toStrProg(gProg, argVals[1], &mut st)
        if st.throwing {
            return JSValue.Undefined
        }
        var receiver = cloneValue(argVals[0])
        if argVals.len() > 2 {
            receiver = cloneValue(argVals[2])
        }
        return reflectGet(gProg, &mut st, argVals[0], key, receiver)
    }
    if id == Builtin.ReflectSet {
        let key = toStrProg(gProg, argVals[1], &mut st)
        if st.throwing {
            return JSValue.Undefined
        }
        var v = JSValue.Undefined
        if argVals.len() > 2 {
            v = cloneValue(argVals[2])
        }
        var receiver = cloneValue(argVals[0])
        if argVals.len() > 3 {
            receiver = cloneValue(argVals[3])
        }
        return JSValue.Bool(reflectSet(gProg, &mut st, argVals[0], key, v, receiver))
    }
    if id == Builtin.ProxyRevocable {
        let pv = makeProxy(&mut st, argVals)
        if st.throwing {
            return JSValue.Undefined
        }
        let out = newObject(&mut st)
        pushTemp(&mut st, JSValue.Obj(out))
        objSet(&mut st, out, "proxy", cloneValue(pv))
        objSet(&mut st, out, "revoke", makeRevokeFn(&mut st, objHandle(pv)))
        popTemp(&mut st)
        return JSValue.Obj(out)
    }
    if id == Builtin.ConsoleLog || id == Builtin.ConsoleError {
        var line = ""
        var j: i64 = 0
        while j < argVals.len() {
            if j > 0 {
                line = line + " "
            }
            line = line + inspectTop(st, argVals[j])
            j = j + 1
        }
        // console.error and console.warn belong on STDERR. Both went to stdout,
        // so any program whose output is piped or parsed got its diagnostics
        // mixed into its data, and 2>/dev/null hid nothing.
        if id == Builtin.ConsoleError {
            eprint(line)
        } else {
            print(line)
            // fflush(NULL) rather than the `flush` builtin: std/deflate has a
            // module-private `flush`, and milo's single program-wide namespace
            // rebinds the bare name to it the moment the compressor is imported.
            unsafe {
                fflush(0 as *u8)
            }
        }
        return JSValue.Undefined
    }
    if id == Builtin.NapiLoad {
        if argVals.len() == 0 {
            return JSValue.Undefined
        }
        match napiLoadAddon(toStr(argVals[0])) {
            Result.Ok(v) => {
                return v
            }
            Result.Err(e) => {
                let eo = newObject(&mut st)
                st.objects[eo].isError = true
                objSet(&mut st, eo, "name", JSValue.Str("Error"))
                objSet(&mut st, eo, "message", JSValue.Str(e))
                st.throwing = true
                st.thrownValue = JSValue.Obj(eo)
                return JSValue.Undefined
            }
        }
    }
    if id == Builtin.ByteLength {
        if argVals.len() == 0 {
            return JSValue.Number(0.0)
        }
        return JSValue.Number(toStr(argVals[0]).len() as f64)
    }
    if id == Builtin.ObjectIs {
        if argVals.len() < 2 {
            return JSValue.Bool(argVals.len() == 0 || isUndefinedValue(argVals[0]))
        }
        return JSValue.Bool(sameValue(argVals[0], argVals[1]))
    }
    if id == Builtin.ObjectHasOwn {
        if argVals.len() < 2 {
            return JSValue.Bool(false)
        }
        let o = objHandle(argVals[0])
        if o < 0 {
            return JSValue.Bool(false)
        }
        let key = toStr(argVals[1])
        // mirrors hasOwnProperty: own named prop, or a real (non-hole) array index
        return JSValue.Bool(objOwnIndex(st, o, key) >= 0 || (st.objects[o].isArray && asArrayIndex(key) >= 0 && asArrayIndex(key) < arrLen(st, o) && !arrIsHole(st, o, asArrayIndex(key))))
    }
    if id == Builtin.ObjectIsSealed {
        if argVals.len() > 0 {
            let h = propertyBagOf(&mut st, argVals[0])
            if h >= 0 {
                return JSValue.Bool(st.objects[h].sealed || st.objects[h].frozen)
            }
        }
        return JSValue.Bool(true)
    }
    if id == Builtin.ObjectIsFrozen {
        if argVals.len() > 0 {
            let fh = propertyBagOf(&mut st, argVals[0])
            if fh >= 0 {
                return JSValue.Bool(st.objects[fh].frozen)
            }
            // primitives are frozen by definition
            return JSValue.Bool(true)
        }
        return JSValue.Bool(true)
    }
    if id == Builtin.ObjectValues || id == Builtin.ObjectEntries {
        // ToObject rejects null and undefined before any key walk. These
        // answered an empty array instead, so Object.keys(undefined) was [] and
        // a typo that produced undefined read as "an object with no keys".
        if argVals.len() == 0 || isNullish(argVals[0]) {
            return throwErr(&mut st, "TypeError", "Cannot convert undefined or null to object")
        }
        let wantPairs = id == Builtin.ObjectEntries
        let arr = newArray(&mut st)
        if argVals.len() > 0 {
            pushTemp(&mut st, JSValue.Obj(arr))
            // a string enumerates as its characters, keyed by index
            if let JSValue.Str(sv) = cloneValue(argVals[0]) {
                var si: i64 = 0
                let slen = utf16Length(sv)
                while si < slen {
                    let ch = JSValue.Str(strSlice(sv, si, si + 1))
                    if wantPairs {
                        let spair = newArray(&mut st)
                        pushTemp(&mut st, JSValue.Obj(spair))
                        arrPush(&mut st, spair, JSValue.Str(i64ToStr(si)))
                        arrPush(&mut st, spair, ch)
                        popTemp(&mut st)
                        arrPush(&mut st, arr, JSValue.Obj(spair))
                    } else {
                        arrPush(&mut st, arr, ch)
                    }
                    si = si + 1
                }
            }
            if let JSValue.Obj(o) = cloneValue(argVals[0]) {
                if st.objects[o].isProxy {
                    let pkeys = ownEnumerableKeys(gProg, &mut st, argVals[0])
                    var pi: i64 = 0
                    while pi < pkeys.len() && !st.throwing {
                        let pk = pkeys[pi].clone()
                        pi = pi + 1
                        let pv = getMemberDyn(gProg, o, pk.clone(), &mut st)
                        if wantPairs {
                            let ppair = newArray(&mut st)
                            pushTemp(&mut st, JSValue.Obj(ppair))
                            arrPush(&mut st, ppair, JSValue.Str(pk))
                            arrPush(&mut st, ppair, pv)
                            popTemp(&mut st)
                            arrPush(&mut st, arr, JSValue.Obj(ppair))
                        } else {
                            arrPush(&mut st, arr, pv)
                        }
                    }
                    popTemp(&mut st)
                    return JSValue.Obj(arr)
                }
                // One walk for the keys, then Get() per key: the spec's
                // EnumerableOwnPropertyNames followed by Get, which is also what
                // makes an own accessor run.
                var vEnum: Vec<bool> = Vec.new()
                var vProp: Vec<i64> = Vec.new()
                let vKeys = ownStringKeys(st, o, &mut vEnum, &mut vProp)
                var vi: i64 = 0
                while vi < vKeys.len() && !st.throwing {
                    if !vEnum[vi] {
                        vi = vi + 1
                        continue
                    }
                    let vkey = vKeys[vi].clone()
                    let vpi = vProp[vi]
                    vi = vi + 1
                    // A plain data property answers from its slot; only an
                    // accessor (or a key that is not in the property table at all,
                    // i.e. an array element or typed-array index) needs a real
                    // [[Get]].
                    var vval = JSValue.Undefined
                    if vpi >= 0 && !propIsAccessor(st, o, vpi) {
                        vval = cloneValue(st.objects[o].props[vpi].value)
                    } else {
                        vval = getMemberDyn(gProg, o, vkey.clone(), &mut st)
                    }
                    if st.throwing {
                        continue
                    }
                    if wantPairs {
                        let vpair = newArray(&mut st)
                        pushTemp(&mut st, JSValue.Obj(vpair))
                        arrPush(&mut st, vpair, JSValue.Str(vkey))
                        arrPush(&mut st, vpair, vval)
                        popTemp(&mut st)
                        arrPush(&mut st, arr, JSValue.Obj(vpair))
                    } else {
                        arrPush(&mut st, arr, vval)
                    }
                }
            }
            popTemp(&mut st)
        }
        return JSValue.Obj(arr)
    }
    if id == Builtin.ObjectKeys {
        // ToObject rejects null and undefined before any key walk. These
        // answered an empty array instead, so Object.keys(undefined) was [] and
        // a typo that produced undefined read as "an object with no keys".
        if argVals.len() == 0 || isNullish(argVals[0]) {
            return throwErr(&mut st, "TypeError", "Cannot convert undefined or null to object")
        }
        let arr = newArray(&mut st)
        if argVals.len() > 0 {
            pushTemp(&mut st, JSValue.Obj(arr))
            // A string exposes its character indices; any other primitive has no
            // own keys. Neither has a property bag, and indexing the heap with
            // the -1 that stands for "none" crashed the engine outright.
            if let JSValue.Str(sv) = cloneValue(argVals[0]) {
                var si: i64 = 0
                let slen = utf16Length(sv)
                while si < slen {
                    arrPush(&mut st, arr, JSValue.Str(i64ToStr(si)))
                    si = si + 1
                }
            }
            let keysBag = propertyBagOf(&mut st, argVals[0])
            if let JSValue.Obj(o) = JSValue.Obj(keysBag) {
                if keysBag < 0 {
                    popTemp(&mut st)
                    return JSValue.Obj(arr)
                }
                if st.objects[o].isProxy {
                    // ownKeys/getOwnPropertyDescriptor traps decide, not
                    // the proxy object's (empty) own bag
                    let pk = proxyOwnEnumKeys(gProg, &mut st, o)
                    var i: i64 = 0
                    while i < pk.len() {
                        arrPush(&mut st, arr, JSValue.Str(pk[i].clone()))
                        i = i + 1
                    }
                    popTemp(&mut st)
                    return JSValue.Obj(arr)
                }
                // one walk, shared with getOwnPropertyNames / for-in / values
                var kEnum: Vec<bool> = Vec.new()
                var kProp: Vec<i64> = Vec.new()
                let kKeys = ownStringKeys(st, o, &mut kEnum, &mut kProp)
                var ki: i64 = 0
                while ki < kKeys.len() {
                    if kEnum[ki] {
                        arrPush(&mut st, arr, JSValue.Str(kKeys[ki].clone()))
                    }
                    ki = ki + 1
                }
            }
            popTemp(&mut st)
        }
        return JSValue.Obj(arr)
    }
    if id == Builtin.ObjectAssign {
        if argVals.len() == 0 {
            // no target at all is the same as an undefined one
            return throwErr(&mut st, "TypeError", "Cannot convert undefined or null to object")
        }
        // ToObject on the target: nullish is a TypeError, and a PRIMITIVE is
        // boxed rather than handed back unchanged — `typeof Object.assign(1, {})`
        // is "object".
        if isNullish(argVals[0]) {
            return throwErr(&mut st, "TypeError", "Cannot convert undefined or null to object")
        }
        var target = cloneValue(argVals[0])
        if propertyBagOf(&mut st, target) < 0 {
            target = makeWrapper(&mut st, argVals[0])
        }
        let t = propertyBagOf(&mut st, target)
        if t < 0 {
            return target
        }
        // `target` is reachable only from this frame, and the proxy branch below
        // allocates a descriptor object per key, so a collection mid-copy freed it
        // and handed its slot to the next allocation: the descriptor's own keys
        // (value/writable/enumerable/configurable) turned up in the result under
        // MILOJS_GC_THRESHOLD=1. Latent before that branch existed, because only an
        // accessor source allocated at all.
        pushTemp(&mut st, cloneValue(target))
        var s: i64 = 1
        while s < argVals.len() {
            var srcVal = cloneValue(argVals[s])
            // a STRING source contributes its index properties: the spec runs
            // ToObject on each non-nullish source, and only a boxed string has
            // enumerable own keys to copy
            if propertyBagOf(&mut st, srcVal) < 0 && !isNullish(srcVal) {
                srcVal = makeWrapper(&mut st, argVals[s])
            }
            let src = propertyBagOf(&mut st, srcVal)
            if src >= 0 && st.objects[src].isProxy {
                let akeys = ownEnumerableKeys(gProg, &mut st, srcVal)
                var ai: i64 = 0
                while ai < akeys.len() && !st.throwing {
                    let ak = akeys[ai].clone()
                    ai = ai + 1
                    let av = getMemberDyn(gProg, src, ak.clone(), &mut st)
                    if !st.throwing {
                        pushTemp(&mut st, cloneValue(av))
                        setMemberDyn(gProg, t, ak, av, &mut st)
                        popTemp(&mut st)
                    }
                }
            } else if src >= 0 {
                // A typed array source contributes its indices, which live in the
                // buffer rather than the property table.
                if !st.objects[src].isDataView && taCurrentLen(st, src) > 0 {
                    let tl = taCurrentLen(st, src)
                    var tv: i64 = 0
                    while tv < tl && !st.throwing {
                        setMemberDyn(gProg, t, i64ToStr(tv), taElemValue(st, src, tv), &mut st)
                        tv = tv + 1
                    }
                }
                let order = enumOrder(st, src)
                var oi: i64 = 0
                while oi < order.len() {
                    let k = order[oi]
                    oi = oi + 1
                    if st.objects[src].props[k].enumerable {
                        let key = st.objects[src].props[k].key.clone()
                        // invoke a getter rather than copying its unused value slot
                        // (gProg: natives reach user code through the global program)
                        var v = JSValue.Undefined
                        if propIsAccessor(st, src, k) {
                            v = getMemberDyn(gProg, src, key, &mut st)
                        } else {
                            v = cloneValue(st.objects[src].props[k].value)
                        }
                        assignInto(&mut st, t, key, v)
                        if st.throwing {
                            return JSValue.Undefined
                        }
                    }
                }
                // CopyDataProperties covers own enumerable SYMBOL keys as well,
                // and enumOrder deliberately omits them (it drives Object.keys
                // and for-in, which must not see one). Walk the props again for
                // that half.
                var sy: i64 = 0
                while sy < st.objects[src].props.len() {
                    if isSymbolKey(st.objects[src].props[sy].key) && st.objects[src].props[sy].enumerable {
                        let skey = st.objects[src].props[sy].key.clone()
                        var sv2 = JSValue.Undefined
                        if propIsAccessor(st, src, sy) {
                            sv2 = getMemberDyn(gProg, src, skey, &mut st)
                        } else {
                            sv2 = cloneValue(st.objects[src].props[sy].value)
                        }
                        if st.throwing {
                            return JSValue.Undefined
                        }
                        assignInto(&mut st, t, skey, sv2)
                        if st.throwing {
                            return JSValue.Undefined
                        }
                    }
                    sy = sy + 1
                }
                // enumerable elements come across too (assign from an array)
                var e: i64 = 0
                while e < st.objects[src].elems.len() {
                    let ev = cloneValue(st.objects[src].elems[e])
                    assignInto(&mut st, t, i64ToStr(e), ev)
                    if st.throwing {
                        return JSValue.Undefined
                    }
                    e = e + 1
                }
            }
            s = s + 1
        }
        popTemp(&mut st)
        return target
    }
    return JSValue.Undefined
}

// One Object.assign write. The spec's step is Set(to, key, value, THROW), and
// setMemberDyn only throws in strict code — so a copy onto a frozen or
// non-writable target was silently dropped and Object.assign reported success.
// Borrowing the strict flag for the duration is what makes that write throw;
// assign's obligation does not depend on the caller's mode.
fn assignInto(st: &mut Interp, t: i64, key: string, v: JSValue) {
    let wasStrict = st.strict
    st.strict = true
    setMemberDyn(gProg, t, key, v, &mut st)
    st.strict = wasStrict
}

// The property bag a value carries, or -1. A function's own properties live in
// its statics bag, not in an object slot, so Object.assign has to look there for
// both its target and its sources — prisma's debug module is a function on both
// sides of `Object.assign(fn, otherFn)`.
// The prototype object index for object `h`, or -1 (null). milojs fakes the
// prototype chain — a plain `{}` has proto -1 and inherits Object.prototype
// methods by dispatch — so getPrototypeOf / `__proto__` / `constructor` resolve
// the right singleton by type here rather than reading a real link.
fn protoOfHandle(st: &Interp, h: i64): i64 {
    if h < 0 {
        return -1
    }
    // an explicit null prototype inherits nothing, not even Object.prototype
    if st.objects[h].protoNull {
        return -1
    }
    // Object.prototype is the top of the chain; its own proto is null
    if h == st.objectProtoObj {
        return -1
    }
    // an explicit link (user `new F()`, Object.create, setPrototypeOf) wins
    if st.objects[h].proto >= 0 {
        return st.objects[h].proto
    }
    if st.objects[h].isArray && st.arrayProtoObj >= 0 {
        return st.arrayProtoObj
    }
    // A CALLABLE object inherits Function.prototype, not Object.prototype. Without
    // this `Array.constructor` was undefined and
    // `Object.getPrototypeOf(Array) === Function.prototype` was false, which is
    // what get-intrinsic checks when resolving `%Array.constructor%`.
    if st.objects[h].isFunctionLike && st.functionProtoObj >= 0 && h != st.functionProtoObj {
        return st.functionProtoObj
    }
    // functions, errors and plain objects fall back to Object.prototype
    // (Function.prototype / Error.prototype are not distinct singletons here)
    return st.objectProtoObj
}

// The `constructor` for a builtin object, when the (faked) prototype chain has
// none. Returns Undefined for anything without a well-defined builtin
// constructor here, so a real (user) constructor resolved through the chain is
// never overridden — this is only ever consulted as a fallback.
fn builtinConstructorOf(st: &Interp, o: i64): JSValue {
    if o == st.objectProtoObj {
        return JSValue.Native(Native.Fn(Builtin.ObjectCtor))
    }
    if o == st.arrayProtoObj && st.arrayCtorObj >= 0 {
        return JSValue.Obj(st.arrayCtorObj)
    }
    if st.objects[o].isError {
        // the specific constructor named by the error's `name` (TypeError, …)
        let nm = getMember(st, o, "name")
        if let JSValue.Str(s) = nm {
            if scopeHasOwn(st, 0, s) {
                return scopeLookup(st, 0, s)
            }
        }
        if scopeHasOwn(st, 0, "Error") {
            return scopeLookup(st, 0, "Error")
        }
        return JSValue.Undefined
    }
    if st.objects[o].isArray && st.arrayCtorObj >= 0 {
        return JSValue.Obj(st.arrayCtorObj)
    }
    // a genuinely plain object → Object; special builtins without a dedicated
    // constructor here (Map/Set/Date/typed-array/proxy/promise/function…) are
    // left Undefined rather than mis-reported as Object
    if !st.objects[o].isMap && !st.objects[o].isSet && !st.objects[o].isDate && !st.objects[o].isProxy && !st.objects[o].isArrayBuffer && st.objExtras[st.objects[o].extra].taBuf < 0 && !st.objects[o].isGenerator && st.objects[o].promiseState < 0 && !st.objects[o].isFunctionLike && !st.objects[o].isBound {
        return JSValue.Native(Native.Fn(Builtin.ObjectCtor))
    }
    return JSValue.Undefined
}

// Math.* in one native family. Two groups because the transcendentals were
// added after the original set.
fn isMathBuiltin(id: Builtin): bool {
    return id == Builtin.MathFloor || id == Builtin.MathCeil || id == Builtin.MathRound
        || id == Builtin.MathTrunc || id == Builtin.MathAbs || id == Builtin.MathSign
        || id == Builtin.MathSqrt || id == Builtin.MathPow || id == Builtin.MathMin
        || id == Builtin.MathMax || id == Builtin.MathRandom
        || id == Builtin.MathExp || id == Builtin.MathLog || id == Builtin.MathSin
        || id == Builtin.MathCos || id == Builtin.MathTan || id == Builtin.MathAsin
        || id == Builtin.MathAcos || id == Builtin.MathAtan || id == Builtin.MathAtan2
        || id == Builtin.MathLog2 || id == Builtin.MathLog10
}

fn mathNative(id: Builtin, args: &Vec<JSValue>, st: &mut Interp): JSValue {
    if id == Builtin.MathRandom {
        let next = mjNextRandom(st.rngState)
        st.rngState = next
        var bits = next
        if bits < 0 {
            bits = -bits
        }
        let m = bits % 9007199254740992
        return JSValue.Number((m as f64) / 9007199254740992.0)
    }
    if id == Builtin.MathMin {
        if args.len() == 0 {
            return JSValue.Number(jsInf())
        }
        var m = toNum(args[0])
        var i: i64 = 0
        while i < args.len() {
            let v = toNum(args[i])
            if !(v == v) {
                return JSValue.Number(jsNan())
            }
            if v < m {
                m = v
            }
            i = i + 1
        }
        return JSValue.Number(m)
    }
    if id == Builtin.MathMax {
        if args.len() == 0 {
            return JSValue.Number(0.0 - jsInf())
        }
        var m = toNum(args[0])
        var i: i64 = 0
        while i < args.len() {
            let v = toNum(args[i])
            if !(v == v) {
                return JSValue.Number(jsNan())
            }
            if v > m {
                m = v
            }
            i = i + 1
        }
        return JSValue.Number(m)
    }
    var x = 0.0
    if args.len() > 0 {
        x = toNum(args[0])
    }
    if id == Builtin.MathFloor {
        return JSValue.Number(mjFloor(x))
    }
    if id == Builtin.MathCeil {
        return JSValue.Number(mjCeil(x))
    }
    if id == Builtin.MathRound {
        return JSValue.Number(mjRound(x))
    }
    if id == Builtin.MathTrunc {
        return JSValue.Number(mjTrunc(x))
    }
    if id == Builtin.MathAbs {
        return JSValue.Number(mjAbs(x))
    }
    if id == Builtin.MathSign {
        return JSValue.Number(mjSign(x))
    }
    if id == Builtin.MathExp {
        return JSValue.Number(Math.exp(x))
    }
    // std's mathLog* carry `requires x > 0.0`; JS defines the whole domain
    // (ECMA-262 21.3.2.20-22: log(+-0) is -Infinity, log(x < 0) is NaN). Handle the
    // non-positive cases here rather than calling out of contract — a contract
    // violation aborts under --debug, and only survives -O2 because the check is
    // compiled out and libc happens to return the right value.
    if id == Builtin.MathLog || id == Builtin.MathLog2 || id == Builtin.MathLog10 {
        if x < 0.0 {
            return JSValue.Number(jsNan())
        }
        if x == 0.0 {
            return JSValue.Number(0.0 - jsInf())
        }
        if id == Builtin.MathLog {
            return JSValue.Number(Math.log(x))
        }
        if id == Builtin.MathLog2 {
            return JSValue.Number(Math.log2(x))
        }
        return JSValue.Number(Math.log10(x))
    }
    if id == Builtin.MathSin {
        return JSValue.Number(Math.sin(x))
    }
    if id == Builtin.MathCos {
        return JSValue.Number(Math.cos(x))
    }
    if id == Builtin.MathTan {
        return JSValue.Number(Math.tan(x))
    }
    if id == Builtin.MathAsin {
        return JSValue.Number(Math.atan2(x, Math.sqrt(1.0 - x * x)))
    }
    if id == Builtin.MathAcos {
        return JSValue.Number(Math.atan2(Math.sqrt(1.0 - x * x), x))
    }
    if id == Builtin.MathAtan {
        return JSValue.Number(Math.atan2(x, 1.0))
    }
    if id == Builtin.MathAtan2 {
        var y2 = 0.0
        if args.len() > 1 {
            y2 = toNum(args[1])
        }
        return JSValue.Number(Math.atan2(x, y2))
    }
    if id == Builtin.MathSqrt {
        return JSValue.Number(Math.sqrt(x))
    }
    if id == Builtin.MathPow {
        var y = 0.0
        if args.len() > 1 {
            y = toNum(args[1])
        }
        return JSValue.Number(Math.pow(x, y))
    }
    return JSValue.Undefined
}

// Define `key` on `o` from a descriptor object `d`, applying get/set or value
// AND the enumerable/configurable/writable attributes (each defaulting to false
// when omitted, per Object.defineProperty). Shared by defineProperty,
// defineProperties, and Object.create's second argument — all three previously
// dropped the attributes for accessors, and the latter two for data props too.
// A descriptor is PARTIAL: every field it omits keeps whatever the property
// already had, and an absent field on a NEW property takes the spec's default of
// false/undefined. Treating omission as "false" overwrote the value with
// undefined on `defineProperty(o, "x", { enumerable: false })`, so narrowing one
// attribute silently destroyed the property's contents.
// An ARRAY's own index and `length` properties are not Prop entries: the elements
// live in `elems`/`logicalLen` and `length` is derived. So every descriptor
// operation used to miss them entirely — `getOwnPropertyDescriptor([7], "0")` threw,
// `defineProperty([], "0", …)` wrote a property the array never showed, and
// `defineProperty(a, "length", …)` did nothing at all.
//
// Returns the descriptor object, or -1 when the key is not an own array key.
fn arrayOwnDescriptor(st: &mut Interp, o: i64, key: &string): i64 {
    if !st.objects[o].isArray {
        return -1
    }
    if key.clone() == "length" {
        let d = newObject(&mut st)
        pushTemp(&mut st, JSValue.Obj(d))
        objSet(&mut st, d, "value", JSValue.Number(arrLen(st, o) as f64))
        objSet(&mut st, d, "writable", JSValue.Bool(!st.objects[o].lengthNonWritable))
        // length is never enumerable and never configurable
        objSet(&mut st, d, "enumerable", JSValue.Bool(false))
        objSet(&mut st, d, "configurable", JSValue.Bool(false))
        popTemp(&mut st)
        return d
    }
    let ai = asArrayIndex(key)
    if ai < 0 || ai >= arrLen(st, o) || arrIsHole(st, o, ai) {
        return -1
    }
    // An index that has a real Prop entry — an accessor, or a sparse far element —
    // keeps its own attributes, so the ordinary descriptor path answers for it.
    // Building a data descriptor from arrGet here silently converted a getter into
    // its (undefined) slot value.
    if objOwnIndex(st, o, key) >= 0 {
        return -1
    }
    let d = newObject(&mut st)
    pushTemp(&mut st, JSValue.Obj(d))
    objSet(&mut st, d, "value", arrGet(st, o, ai))
    // a frozen array's elements are read-only; a sealed one keeps them writable
    objSet(&mut st, d, "writable", JSValue.Bool(!st.objects[o].frozen))
    objSet(&mut st, d, "enumerable", JSValue.Bool(true))
    objSet(&mut st, d, "configurable", JSValue.Bool(!st.objects[o].frozen && !st.objects[o].sealed))
    popTemp(&mut st)
    return d
}

// defineProperty for an array's `length` or an index. Answers false when the
// definition must be rejected (the caller raises the TypeError), true when handled,
// and leaves `handled` false when the key is not an array key at all.
struct ArrayDefineResult {
    handled: bool,
    ok: bool,
}

fn arrayDefineOwn(prog: &Prog, st: &mut Interp, o: i64, key: &string, d: i64): ArrayDefineResult {
    // Copied out of the AST before anything below can re-enter the
    // interpreter and move the program storage this reference points into.
    let keyCopy = key.clone()
    let notMine = ArrayDefineResult { handled: false, ok: true }
    if !st.objects[o].isArray {
        return notMine
    }
    if keyCopy.clone() == "length" {
        if objHasInChain(st, d, "get") || objHasInChain(st, d, "set") {
            // length cannot become an accessor
            return ArrayDefineResult { handled: true, ok: false }
        }
        if objHasInChain(st, d, "enumerable") && truthy(getMember(st, d, "enumerable")) {
            return ArrayDefineResult { handled: true, ok: false }
        }
        if objHasInChain(st, d, "configurable") && truthy(getMember(st, d, "configurable")) {
            return ArrayDefineResult { handled: true, ok: false }
        }
        if objHasInChain(st, d, "value") {
            let raw = toNumProg(prog, getMember(st, d, "value"), &mut st)
            let want = raw as i64
            // an array length must be an exact non-negative uint32
            if raw != raw || raw < 0.0 || raw > 4294967295.0 || (want as f64) != raw {
                st.throwing = true
                st.thrownValue = makeError(&mut st, "RangeError", "Invalid array length")
                return ArrayDefineResult { handled: true, ok: true }
            }
            if st.objects[o].lengthNonWritable && want != arrLen(st, o) {
                return ArrayDefineResult { handled: true, ok: false }
            }
            setArrayLength(&mut st, o, want)
        }
        if objHasInChain(st, d, "writable") && !truthy(getMember(st, d, "writable")) {
            st.objects[o].lengthNonWritable = true
        }
        return ArrayDefineResult { handled: true, ok: true }
    }
    let ai = asArrayIndex(keyCopy)
    if ai < 0 {
        return notMine
    }
    // An ACCESSOR at an index cannot live in the element vector. Let it fall through
    // to the ordinary property path, but grow `length` the way the spec does — the
    // index becomes an own property either way.
    if objHasInChain(st, d, "get") || objHasInChain(st, d, "set") {
        if ai >= arrLen(st, o) {
            if st.objects[o].lengthNonWritable {
                return ArrayDefineResult { handled: true, ok: false }
            }
            setArrayLength(&mut st, o, ai + 1)
        }
        return notMine
    }
    if ai >= arrLen(st, o) {
        if st.objects[o].lengthNonWritable || st.objects[o].noExtend || st.objects[o].sealed || st.objects[o].frozen {
            return ArrayDefineResult { handled: true, ok: false }
        }
        setArrayLength(&mut st, o, ai + 1)
    } else if st.objects[o].frozen {
        return ArrayDefineResult { handled: true, ok: false }
    }
    // The element vector stores VALUES, with no room for attributes, so a
    // descriptor that turns one off cannot be represented there: writable:false
    // on an index was accepted and silently dropped, and the element stayed
    // writable. Move the index into an ordinary property instead, the same
    // escape the accessor case above takes, and hole the element so there is one
    // source of truth. Carrying the current value across first is what keeps a
    // descriptor that names only attributes from blanking the element, and it
    // also makes the ordinary path see the property as pre-existing, so the
    // attributes it does not name keep an element's defaults rather than
    // dropping to false.
    let turnsOffAttr = (objHasInChain(st, d, "writable") && !truthy(getMember(st, d, "writable")))
        || (objHasInChain(st, d, "enumerable") && !truthy(getMember(st, d, "enumerable")))
        || (objHasInChain(st, d, "configurable") && !truthy(getMember(st, d, "configurable")))
    if turnsOffAttr {
        if ai < arrLen(st, o) && !arrIsHole(st, o, ai) {
            let cur = arrGet(st, o, ai)
            objSet(&mut st, o, keyCopy.clone(), cur)
            st.objects[o].holes.push(ai)
        }
        return notMine
    }
    if objHasInChain(st, d, "value") {
        arrSet(&mut st, o, ai, getMember(st, d, "value"))
    } else if arrIsHole(st, o, ai) {
        arrSet(&mut st, o, ai, JSValue.Undefined)
    }
    return ArrayDefineResult { handled: true, ok: true }
}

fn applyDescriptor(st: &mut Interp, o: i64, key: &string, d: i64) {
    if !applyDescriptorQuiet(&mut st, o, key, d) && !st.throwing {
        st.throwing = true
        st.thrownValue = makeError(&mut st, "TypeError", "Cannot redefine property: " + key.clone())
    }
}

// Answers false for a rejected definition instead of throwing, so
// Reflect.defineProperty can report it as `false`. A RangeError from an invalid
// array length is a real throw in both spellings and still propagates.
fn applyDescriptorQuiet(st: &mut Interp, o: i64, key: &string, d: i64): bool {
    // Copied out of the AST before anything below can re-enter the
    // interpreter and move the program storage this reference points into.
    let keyCopy = key.clone()
    // An array's indices and `length` are not Prop entries — arrayDefineOwn owns
    // them. It reports `handled: false` for any other keyCopy so the ordinary path
    // below still runs, and `ok: false` when the definition must be rejected.
    let ar = arrayDefineOwn(gProg, &mut st, o, keyCopy, d)
    if ar.handled {
        return ar.ok
    }
    let existed = objOwnIndex(st, o, keyCopy) >= 0
    // objSet/objDefineAccessor write through the ordinary property path, which
    // resets the attributes to a plain data property's defaults. Redefining an
    // existing property must keep whatever the descriptor does not name, so the
    // old attributes are captured here and put back below.
    var prevEnum = false
    var prevConf = false
    var prevWrit = false
    if existed {
        let pi = objOwnIndex(st, o, keyCopy)
        prevEnum = st.objects[o].props[pi].enumerable
        prevConf = st.objects[o].props[pi].configurable
        prevWrit = st.objects[o].props[pi].writable
    }
    let hasGet = objHasInChain(st, d, "get")
    let hasSet = objHasInChain(st, d, "set")
    let hasValue = objHasInChain(st, d, "value")
    if hasGet || hasSet {
        objDefineAccessor(&mut st, o, keyCopy.clone(), getMember(st, d, "get"), getMember(st, d, "set"))
    } else if hasValue {
        objSet(&mut st, o, keyCopy.clone(), getMember(st, d, "value"))
    } else if !existed {
        // a new property with no value named at all is undefined
        objSet(&mut st, o, keyCopy.clone(), JSValue.Undefined)
    }
    let at = objOwnIndex(st, o, keyCopy)
    if at >= 0 {
        if objHasInChain(st, d, "enumerable") {
            st.objects[o].props[at].enumerable = truthy(getMember(st, d, "enumerable"))
        } else {
            st.objects[o].props[at].enumerable = existed && prevEnum
        }
        if objHasInChain(st, d, "configurable") {
            st.objects[o].props[at].configurable = truthy(getMember(st, d, "configurable"))
        } else {
            st.objects[o].props[at].configurable = existed && prevConf
        }
        if objHasInChain(st, d, "writable") {
            st.objects[o].props[at].writable = truthy(getMember(st, d, "writable"))
        } else {
            st.objects[o].props[at].writable = existed && prevWrit
        }
    }
    return true
}

// Build a property-descriptor object { value, writable | get, set }+enumerable+
// configurable for own property `idx` of `h`. Shared by getOwnPropertyDescriptor
// and getOwnPropertyDescriptors.
fn buildPropDescriptor(st: &mut Interp, h: i64, idx: i64): i64 {
    let isAcc = propIsAccessor(st, h, idx)
    let pv = cloneValue(st.objects[h].props[idx].value)
    let pg = accGetter(st, st.objects[h].props[idx].acc)
    let ps = accSetter(st, st.objects[h].props[idx].acc)
    let d = newObject(&mut st)
    pushTemp(&mut st, JSValue.Obj(d))
    if isAcc {
        objSet(&mut st, d, "get", pg)
        objSet(&mut st, d, "set", ps)
    } else {
        objSet(&mut st, d, "value", pv)
        objSet(&mut st, d, "writable", JSValue.Bool(st.objects[h].props[idx].writable))
    }
    objSet(&mut st, d, "enumerable", JSValue.Bool(st.objects[h].props[idx].enumerable))
    objSet(&mut st, d, "configurable", JSValue.Bool(st.objects[h].props[idx].configurable))
    popTemp(&mut st)
    return d
}

// s.match(re): with the g flag, an array of all matched substrings (or null);
// otherwise the first match array (whole + groups) or null.
// Encode a single Unicode code point to UTF-8 (milojs's string encoding).
fn codePointToUtf8(cp: i64): string {
    var out = String.withCapacity(4)
    if cp < 128 {
        out.push(cp as u8)
    } else if cp < 2048 {
        out.push((192 | (cp >> 6)) as u8)
        out.push((128 | (cp & 63)) as u8)
    } else if cp < 65536 {
        out.push((224 | (cp >> 12)) as u8)
        out.push((128 | ((cp >> 6) & 63)) as u8)
        out.push((128 | (cp & 63)) as u8)
    } else {
        out.push((240 | (cp >> 18)) as u8)
        out.push((128 | ((cp >> 12) & 63)) as u8)
        out.push((128 | ((cp >> 6) & 63)) as u8)
        out.push((128 | (cp & 63)) as u8)
    }
    return out
}

// Execute a pre-loaded module in a fresh CommonJS scope and cache its exports.
// A module already loading (a require cycle) returns its partial exports, which
// is what Node does.
pub fn runModule(prog: &Prog, idx: i64, st: &mut Interp): JSValue {
    if st.modState[idx] == 2 {
        return cloneValue(st.modExports[idx])
    }
    if st.modState[idx] == 1 {
        return cloneValue(st.modExports[idx])
    }
    st.modState[idx] = 1
    let path = st.modPaths[idx].clone()
    let dir = dirOf(path)

    let modScope = newScope(&mut st, 0)
    pushActive(&mut st, modScope)
    let moduleObj = newObject(&mut st)
    let exportsObj = newObject(&mut st)
    objSet(&mut st, moduleObj, "exports", JSValue.Obj(exportsObj))
    scopeDefine(&mut st, modScope, "module", JSValue.Obj(moduleObj))
    scopeDefine(&mut st, modScope, "exports", JSValue.Obj(exportsObj))
    // a CommonJS module's top-level `this` is its exports object
    scopeDefine(&mut st, modScope, "this", JSValue.Obj(exportsObj))
    // node guarantees these are ABSOLUTE, and packages build paths from them:
    // `bindings` joins its candidate addon paths onto the module root it derives
    // from __filename, so a relative one made every candidate resolve against
    // the wrong directory and no addon could ever be found.
    scopeDefine(&mut st, modScope, "__filename", JSValue.Str(absolutePathOf(path.clone())))
    scopeDefine(&mut st, modScope, "__dirname", JSValue.Str(absolutePathOf(dir.clone())))
    // `require` as a value, bound to THIS module's directory
    scopeDefine(&mut st, modScope, "require", makeBoundMethod(&mut st, JSValue.Str(dir.clone()), "__require"))
    // publish partial exports up front so a cycle sees something
    st.modExports[idx] = JSValue.Obj(exportsObj)

    st.modDirStack.push(dir)
    st.modPathStack.push(st.modPaths[idx].clone())
    let blk = st.modBlocks[idx]
    // Module code is STRICT code when the module is ESM or opts in, and the
    // enclosing module's strictness must not leak into it either way — a sloppy
    // CommonJS file required from an ESM one stays sloppy.
    let savedStrict = st.strict
    if idx < st.modStrict.len() {
        st.strict = st.modStrict[idx]
    } else {
        st.strict = false
    }
    // a module body is function-like: its vars and function declarations hoist
    // to the module scope
    hoistBlock(prog, blk, &mut st, modScope)
    execBlock(prog, blk, &mut st, modScope)
    st.strict = savedStrict
    let _ = st.modDirStack.pop()
    let _p = st.modPathStack.pop()
    popActive(&mut st)

    // module.exports may have been reassigned wholesale
    let finalExports = getMember(st, moduleObj, "exports")
    st.modExports[idx] = cloneValue(finalExports)
    st.modState[idx] = 2
    return finalExports
}

fn requireModule(prog: &Prog, spec: &string, st: &mut Interp, scope: i64): JSValue {
    var dir = ""
    if scope >= 0 && scopeHas(st, scope, "__dirname") {
        dir = toStr(scopeLookup(st, scope, "__dirname"))
    }
    if dir.len() == 0 && st.modDirStack.len() > 0 {
        dir = st.modDirStack[st.modDirStack.len() - 1].clone()
    }
    return requireModuleFrom(prog, spec, &mut st, dir)
}

// `require` reached as a VALUE rather than a call. It was only ever handled at
// the call site by name, so `typeof require` was "undefined" and passing it
// around threw: `bindings` does
//     const requireFunc = typeof __non_webpack_require__ === 'function' ? __non_webpack_require__ : require;
// and every addon loader is built on that. Each module scope now binds its own

// node's MODULE_NOT_FOUND, message and code. Packages probe for optional
// dependencies with try/catch and branch on `e.code`, not on the message, so an
// error without the code reads as present-but-broken instead of absent.
fn throwModuleNotFound(st: &mut Interp, spec: &string) {
    st.throwing = true
    let err = makeError(&mut st, "Error", "Cannot find module '" + spec + "'")
    let eo = objHandle(err)
    if eo >= 0 {
        objSet(&mut st, eo, "code", JSValue.Str("MODULE_NOT_FOUND"))
    }
    st.thrownValue = err
}

fn requireModuleFrom(prog: &Prog, spec: &string, st: &mut Interp, dirIn: string): JSValue {
    let dir = relativizeToCwd(dirIn)
    // A .node file is a shared library, not JS: it never goes through the module
    // pre-loader, so it is dlopened here. prisma reaches its query engine this
    // way (require(<abs>/libquery_engine.node)).
    if hasNodeAddonExt(spec) {
        var addonPath = spec.clone()
        if spec[0] != '/' && dir.len() > 0 {
            addonPath = dir + "/" + spec
        }
        let cached = findNapiAddon(st, addonPath)
        if let Option.Some(v) = cached {
            return v
        }
        match napiLoadAddon(addonPath) {
            Result.Ok(v) => {
                st.napiAddonPaths.push(addonPath)
                st.napiAddonExports.push(cloneValue(v))
                return v
            }
            Result.Err(e) => {
                return throwErr(&mut st, "Error", e)
            }
        }
    }
    let path = resolveSpec(dir, spec)
    if path.len() == 0 {
        // relative and node_modules specifiers resolve; what lands here is a node
        // builtin (path/fs/http/...) which still needs a shim module
        // node throws MODULE_NOT_FOUND; packages rely on that to probe for
        // optional dependencies with try/catch. Returning undefined instead made
        // the failure surface later as a confusing "undefined is not a function".
        // The probe reads `e.code`, not the message, so the code has to be on the
        // error or every optional dependency looks present-but-broken rather
        // than absent.
        throwModuleNotFound(&mut st, spec)
        return JSValue.Undefined
    }
    var idx = findModule(st, path)
    if idx < 0 {
        // The preload walk only follows require("literal"), so a computed
        // specifier — require(name) over a list, which is how every package that
        // feature-detects core modules works — lands here with the module never
        // registered. Load it now. An embedder calling milojs_eval on a string
        // never had a walk at all and reaches this the same way.
        idx = loadModuleLazily(path.clone(), &mut st)
    }
    if idx < 0 {
        // Nothing to load: the path does not resolve to readable source, which is
        // MODULE_NOT_FOUND from the program's side. It used to print "was not
        // pre-loaded" to the HOST's stderr and hand back undefined, so an
        // embedder saw STATUS_OK for a require that never ran.
        throwModuleNotFound(&mut st, spec)
        return JSValue.Undefined
    }
    return runModule(prog, idx, &mut st)
}

// OrdinaryHasInstance against a NATIVE constructor: walk the object's prototype
// chain looking for that constructor's `prototype`. The internal-kind checks in
// instanceOf are shortcuts for the common case; this is the general rule they
// stand in for, and the only thing that recognises a subclass instance.
fn nativeProtoChainHas(st: &Interp, o: i64, n: &Native): bool {
    let bag = nativePropsOf(st, n)
    if bag < 0 {
        return false
    }
    let target = objHandle(objGet(st, bag, "prototype"))
    if target < 0 {
        return false
    }
    var p = st.objects[o].proto
    while p >= 0 {
        if p == target {
            return true
        }
        p = st.objects[p].proto
    }
    return false
}

// `o instanceof <native constructor>`. Split out of instanceOf so the built-in
// shortcuts can match on the constructor's variant.
fn nativeInstanceOf(st: &Interp, o: i64, nv: &Native): bool {
    match nv {
        Native.Fn(id) => {
            // Almost every object inherits from Object.prototype — but not one
            // with a null prototype, and `{ __proto__: null }` can build one, so
            // answering true unconditionally made `x instanceof Object` true for
            // exactly the objects it must reject.
            if id == Builtin.ObjectCtor {
                return inheritsObjectProto(st, o)
            }
            // the built-in exotic constructors are recognised by the object's
            // internal kind (Date/Map/Set/RegExp/ArrayBuffer are Native values,
            // so `x instanceof Date` reaches here)
            if id == Builtin.Date && st.objects[o].isDate {
                return true
            }
            // a wrapper is an instance of the constructor that boxed it
            if id == Builtin.String || id == Builtin.Number || id == Builtin.Boolean {
                match st.objExtras[st.objects[o].extra].boxed {
                    JSValue.Str(_ws) => {
                        return id == Builtin.String
                    }
                    JSValue.Number(_wn) => {
                        return id == Builtin.Number
                    }
                    JSValue.Bool(_wb) => {
                        return id == Builtin.Boolean
                    }
                    _ => {
                        return false
                    }
                }
            }
            if id == Builtin.Map && st.objects[o].isMap {
                return true
            }
            if id == Builtin.Set && st.objects[o].isSet {
                return true
            }
            if id == Builtin.RegExp && st.objExtras[st.objects[o].extra].regexId >= 0 {
                return true
            }
            if id == Builtin.ArrayBuffer && st.objects[o].isArrayBuffer {
                return true
            }
        }
        Native.TypedArrayCtor(kind) => {
            // a typed-array view instanceof its exact kind (Uint8Array,
            // Float64Array, …): a view has taBuf >= 0 and its taKind is the
            // constructor's kind
            if st.objExtras[st.objects[o].extra].taBuf >= 0 && !st.objects[o].isDataView && st.objExtras[st.objects[o].extra].taKind == kind {
                return true
            }
            return nativeProtoChainHas(st, o, nv)
        }
        Native.Resolver(_promise, _isReject) => {
        }
    }
    if !st.objects[o].isError {
        // The internal-kind shortcuts above are exactly that: a SUBCLASS instance
        // carries the right prototype chain but not the base's internal slot, so
        // `new (class extends Map {})() instanceof Map` answered false. Fall back
        // to OrdinaryHasInstance, which is what the shortcuts stand in for.
        return nativeProtoChainHas(st, o, nv)
    }
    if nativeEq(nv, Native.Fn(Builtin.Error)) {
        return true
    }
    // getMember, not objGet: this read the OWN `name` property, which stopped
    // identifying anything the moment errors stopped carrying one. node reports
    // only `stack` (and `message`, when passed) as own properties of an Error;
    // `name` lives on each subtype's prototype, so the lookup has to walk the
    // chain that already links them.
    let nm = getMember(st, o, "name")
    if toStr(nm) == nativeErrorNameOf(nv) {
        return true
    }
    return nativeProtoChainHas(st, o, nv)
}

fn instanceOf(st: &Interp, val: &JSValue, ctor: &JSValue): bool {
    // `f instanceof Function` for a plain function value: functions are not Objs
    // here, so the object walk below never saw them and answered false.
    if let JSValue.Native(cid) = ctor {
        if nativeEq(cid, Native.Fn(Builtin.FunctionCtor)) {
            return isCallableIn(st, val)
        }
        // ...and `f instanceof Object` for the same reason: a function value is
        // not a JSValue.Obj here, so the object walk below never sees one, and
        // its chain runs Function.prototype -> Object.prototype either way.
        if nativeEq(cid, Native.Fn(Builtin.ObjectCtor)) && isCallableIn(st, val) {
            return true
        }
    }
    match val {
        JSValue.Obj(o) => {
            match ctor {
                JSValue.Func(_fIdx, _e, fo) => {
                    // a subclass instance is also an instance of every base, so
                    // walk the prototype chain: Dog.prototype's proto is
                    // Animal.prototype (linked by instantiateClass). A function
                    // whose `prototype` was never materialised cannot be in
                    // anyone's chain, so reading it without creating it is exact.
                    let target = objHandle(objGet(st, fo, "prototype"))
                    if target >= 0 {
                        var p = st.objects[o].proto
                        while p >= 0 {
                            if p == target {
                                return true
                            }
                            p = st.objects[p].proto
                        }
                    }
                    return false
                }
                JSValue.Native(nv) => {
                    return nativeInstanceOf(st, o, nv)
                }
                JSValue.Obj(c) => {
                    // Array is an object constructor (JSValue.Obj), not a Native,
                    // so `[] instanceof Array` reaches here — match by the array flag
                    if c == st.arrayCtorObj && st.objects[o].isArray {
                        return true
                    }
                    // Promise's constructor is an Obj too; a promise is recognised
                    // by its settlement-state slot
                    if st.promiseCtorObj >= 0 && c == st.promiseCtorObj && st.objects[o].promiseState >= 0 {
                        return true
                    }
                    // The general rule the two shortcuts above stand in for: the
                    // constructor's `prototype` somewhere in the object's chain.
                    // A subclass instance reaches its base only this way, and the
                    // walk compared against the CONSTRUCTOR object rather than its
                    // prototype, so `class A extends Array {}` never matched.
                    let ctorProto = objHandle(objGet(st, c, "prototype"))
                    var p = st.objects[o].proto
                    while p >= 0 {
                        if p == c || (ctorProto >= 0 && p == ctorProto) {
                            return true
                        }
                        p = st.objects[p].proto
                    }
                    return false
                }
                _ => {
                    return false
                }
            }
        }
        _ => {
            return false
        }
    }
}

pub fn typedArrayProtoFor(st: &mut Interp, kind: i64): i64 {
    let bag = getNativeProps(&mut st, Native.TypedArrayCtor(kind))
    return objHandle(objGet(st, bag, "prototype"))
}

pub fn arrayBufferProto(st: &mut Interp): i64 {
    return objHandle(objGet(st, getNativeProps(&mut st, Native.Fn(Builtin.ArrayBuffer)), "prototype"))
}

// The prototype object a freshly constructed error of this kind should link to,
// or -1 before setupErrorProtos has run (makeError is reachable during startup).
fn errorProtoFor(st: &mut Interp, nativeId: Builtin): i64 {
    let bag = getNativeProps(&mut st, Native.Fn(nativeId))
    return objHandle(objGet(st, bag, "prototype"))
}

// typeof: never throws, even for an unbound name (scopeLookup returns undefined).
fn typeofStr(v: &JSValue): string {
    match v {
        JSValue.Undefined => {
            return "undefined"
        }
        JSValue.Null => {
            return "object"
        }
        JSValue.Bool(_b) => {
            return "boolean"
        }
        JSValue.Number(_n) => {
            return "number"
        }
        JSValue.Str(_s) => {
            return "string"
        }
        JSValue.BigInt(_s) => {
            return "bigint"
        }
        JSValue.Sym(_id) => {
            return "symbol"
        }
        JSValue.Func(_f, _e, _fo) => {
            return "function"
        }
        JSValue.Obj(_o) => {
            return "object"
        }
        JSValue.Native(_id) => {
            return "function"
        }
    }
}

pub fn isBigIntVal(v: &JSValue): bool {
    match v {
        JSValue.BigInt(_s) => {
            return true
        }
        _ => {
            return false
        }
    }
}

fn isStrVal(v: &JSValue): bool {
    match v {
        JSValue.Str(_s) => {
            return true
        }
        _ => {
            return false
        }
    }
}

// the decimal string of a BigInt, or "" for anything else
pub fn bigStrOf(v: &JSValue): string {
    match v {
        JSValue.BigInt(s) => {
            return s.clone()
        }
        _ => {
            return ""
        }
    }
}

// Binary operators where at least one operand is a BigInt. Arithmetic requires
// BOTH to be BigInt (JS throws on a mix); comparison and == coerce across types;
// === defers to the value-equality rule; bitwise on BigInt is not implemented and
// throws rather than returning a silently-wrong (double-based) answer.
fn evalBigIntBin(op: &string, va: JSValue, vb: JSValue, st: &mut Interp): JSValue {
    let aBig = isBigIntVal(va)
    let bBig = isBigIntVal(vb)
    // `+` with a string operand concatenates (BigInt stringifies without the `n`)
    if op == "+" && (isStrVal(va) || isStrVal(vb)) {
        return JSValue.Str(toStr(va) + toStr(vb))
    }
    if op == "===" {
        return JSValue.Bool(jsStrictEquals(va, vb))
    }
    if op == "!==" {
        return JSValue.Bool(!jsStrictEquals(va, vb))
    }
    // arithmetic: both operands must be BigInt
    if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || op == "**" {
        if !(aBig && bBig) {
            return throwErr(&mut st, "TypeError", "Cannot mix BigInt and other types, use explicit conversions")
        }
        let sa = bigStrOf(va)
        let sb = bigStrOf(vb)
        if op == "+" {
            return JSValue.BigInt(bnAdd(sa, sb))
        }
        if op == "-" {
            return JSValue.BigInt(bnSub(sa, sb))
        }
        if op == "*" {
            return JSValue.BigInt(bnMul(sa, sb))
        }
        if op == "/" {
            if sb == "0" {
                return throwErr(&mut st, "RangeError", "Division by zero")
            }
            return JSValue.BigInt(bnDiv(sa, sb))
        }
        if op == "%" {
            if sb == "0" {
                return throwErr(&mut st, "RangeError", "Division by zero")
            }
            return JSValue.BigInt(bnMod(sa, sb))
        }
        // op == "**"
        if sb.len() > 0 && sb[0] == '-' {
            return throwErr(&mut st, "RangeError", "Exponent must be non-negative")
        }
        return JSValue.BigInt(bnPow(sa, sb))
    }
    // comparison + loose equality: mixing is allowed. Both BigInt compare exactly;
    // a BigInt vs Number/String comparison goes through f64 (lossy only past 2^53).
    if op == "<" || op == ">" || op == "<=" || op == ">=" || op == "==" || op == "!=" {
        var c: i64 = 0
        if aBig && bBig {
            c = bnCmp(bigStrOf(va), bigStrOf(vb))
        } else {
            let na = toNum(va)
            let nb = toNum(vb)
            if na < nb {
                c = -1
            } else if na > nb {
                c = 1
            } else {
                c = 0
            }
        }
        if op == "<" {
            return JSValue.Bool(c < 0)
        }
        if op == ">" {
            return JSValue.Bool(c > 0)
        }
        if op == "<=" {
            return JSValue.Bool(c <= 0)
        }
        if op == ">=" {
            return JSValue.Bool(c >= 0)
        }
        if op == "==" {
            return JSValue.Bool(c == 0)
        }
        return JSValue.Bool(c != 0)
    }
    // &, |, ^, <<, >> on BigInt. Both operands must be BigInt (like arithmetic).
    if op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" || op == ">>>" {
        if !(aBig && bBig) {
            return throwErr(&mut st, "TypeError", "Cannot mix BigInt and other types, use explicit conversions")
        }
        let sa = bigStrOf(va)
        let sb = bigStrOf(vb)
        if op == "<<" {
            return JSValue.BigInt(bnShl(sa, sb))
        }
        if op == ">>" {
            return JSValue.BigInt(bnShr(sa, sb))
        }
        if op == ">>>" {
            // JS: BigInts are signed, `>>>` has no meaning → TypeError
            return throwErr(&mut st, "TypeError", "BigInts have no unsigned right shift, use >> instead")
        }
        var opc: u8 = '&'
        if op == "|" {
            opc = '|'
        } else if op == "^" {
            opc = '^'
        }
        return JSValue.BigInt(bnBitwise(opc, sa, sb))
    }
    return throwErr(&mut st, "TypeError", "BigInt operation not supported")
}

// Binary evaluation is separated from the full expression dispatcher because a
// tree-walk keeps this frame live while evaluating either operand. Keeping only
// binary locals here prevents rare expression arms from inflating every
// recursive JavaScript call's native stack usage.
// Whether a `==` operand takes part in the object-to-primitive conversion.
// Null and Undefined never do: they compare equal to each other and to nothing
// else, so a loose comparison against them must not run user code.
fn isEqCoercible(v: &JSValue): bool {
    match v {
        JSValue.Null => {
            return false
        }
        JSValue.Undefined => {
            return false
        }
        _ => {
            return true
        }
    }
}

fn evalBinaryExpr(prog: &Prog, op: &string, a: ExprId, b: ExprId, st: &mut Interp, scope: i64): JSValue {
    if op == "&&" {
        let va = evalExpr(prog, a, &mut st, scope)
        if !truthy(va) {
            return va
        }
        return evalExpr(prog, b, &mut st, scope)
    }
    if op == "||" {
        let va = evalExpr(prog, a, &mut st, scope)
        if truthy(va) {
            return va
        }
        return evalExpr(prog, b, &mut st, scope)
    }
    if op == "??" {
        let va = evalExpr(prog, a, &mut st, scope)
        match va {
            JSValue.Null => {
                return evalExpr(prog, b, &mut st, scope)
            }
            JSValue.Undefined => {
                return evalExpr(prog, b, &mut st, scope)
            }
            _ => {
                return va
            }
        }
    }
    if op == "in" {
        // `#x in o` — the ergonomic brand check. The left side is a private NAME,
        // not an expression: evaluating it as an identifier is a ReferenceError,
        // which is what this used to do. Private names are stored as ordinary
        // own properties keyed with the leading '#', so presence is the answer.
        if let Expr.Ident(pn) = prog.exprs[a.index] {
            if pn.len() > 0 && pn[0] == '#' {
                let ov0 = evalExpr(prog, b, &mut st, scope)
                // a class VALUE is a Func here, and `#s in C` for a private
                // static asks about it
                let oh = propertyBagOf(&mut st, ov0)
                if oh < 0 {
                    // the right side of `in` must be an object, private name
                    // or not
                    return throwErr(&mut st, "TypeError", "Cannot use 'in' operator to search for '" + pn.clone() + "' in " + toStr(ov0))
                }
                // private METHODS are installed on the prototype rather
                // than per instance, so the brand is "somewhere on this
                // object's own chain" — a different class's instance has a
                // different mangled key and still answers false
                var ph = oh
                while ph >= 0 {
                    if objOwnIndex(st, ph, pn) >= 0 {
                        return JSValue.Bool(true)
                    }
                    ph = st.objects[ph].proto
                }
                return JSValue.Bool(false)
            }
        }
        let kv = evalExpr(prog, a, &mut st, scope)
        let ov = evalExpr(prog, b, &mut st, scope)
        return evalInOperator(prog, toStr(kv), ov, &mut st)
    }
    if op == "instanceof" {
        let lv = evalExpr(prog, a, &mut st, scope)
        pushTemp(&mut st, cloneValue(lv))
        let rv = evalExpr(prog, b, &mut st, scope)
        popTemp(&mut st)
        return JSValue.Bool(instanceOf(st, lv, rv))
    }
    let va = evalExpr(prog, a, &mut st, scope)
    pushTemp(&mut st, cloneValue(va))
    let vb = evalExpr(prog, b, &mut st, scope)
    popTemp(&mut st)
    if isBigIntVal(va) || isBigIntVal(vb) {
        return evalBigIntBin(op, va, vb, &mut st)
    }
    // `==` between an object and a primitive converts the OBJECT side, which is
    // how `new String("a") == "a"` is true while `===` stays false. Two objects
    // still compare by reference, so this fires only on a mixed pair.
    // ...but ONLY against a Number/String/BigInt/Symbol. `obj == null` and
    // `obj == undefined` are false by definition, with no conversion at all, so
    // converting there calls valueOf on an object whose valueOf may legitimately
    // throw: `Date.prototype != null` is the null-guard get-intrinsic opens with.
    if (op == "==" || op == "!=") && (objHandle(va) >= 0) != (objHandle(vb) >= 0) && isEqCoercible(va) && isEqCoercible(vb) {
        pushTemp(&mut st, cloneValue(va))
        pushTemp(&mut st, cloneValue(vb))
        var ea = cloneValue(va)
        var eb = cloneValue(vb)
        if objHandle(va) >= 0 {
            ea = toPrimitiveDefault(prog, va, &mut st)
        } else {
            eb = toPrimitiveDefault(prog, vb, &mut st)
        }
        popTemp(&mut st)
        popTemp(&mut st)
        if st.throwing {
            return JSValue.Undefined
        }
        return evalBin(op, ea, eb)
    }
    // A SYMBOL has no implicit conversion: ToString and ToNumber of one both
    // throw. Equality compares without converting and stays allowed.
    if (isSymbolValue(va) || isSymbolValue(vb)) && op != "===" && op != "!==" && op != "==" && op != "!=" {
        return symbolOperandError(&mut st, op)
    }
    let coerces = op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || op == "**" || op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" || op == ">>>" || op == "<" || op == ">" || op == "<=" || op == ">="
    if coerces && (objHandle(va) >= 0 || objHandle(vb) >= 0 || funcHandle(va) >= 0 || funcHandle(vb) >= 0 || isNativeValue(va) || isNativeValue(vb)) {
        pushTemp(&mut st, cloneValue(va))
        pushTemp(&mut st, cloneValue(vb))
        var pa = JSValue.Undefined
        var pb = JSValue.Undefined
        if op == "+" {
            pa = toPrimitiveDefault(prog, va, &mut st)
            pushTemp(&mut st, cloneValue(pa))
            pb = toPrimitiveDefault(prog, vb, &mut st)
            popTemp(&mut st)
        } else {
            pa = toPrimitiveNumber(prog, va, &mut st)
            pushTemp(&mut st, cloneValue(pa))
            pb = toPrimitiveNumber(prog, vb, &mut st)
            popTemp(&mut st)
        }
        popTemp(&mut st)
        popTemp(&mut st)
        // a symbol WRAPPER reaches its symbol only through ToPrimitive
        if isSymbolValue(pa) || isSymbolValue(pb) {
            return symbolOperandError(&mut st, op)
        }
        return evalBin(op, pa, pb)
    }
    return evalBin(op, va, vb)
}

// `+` converts a symbol operand with ToString, every other operator with
// ToNumber; node words the TypeError after whichever one it was.
fn symbolOperandError(st: &mut Interp, op: &string): JSValue {
    if op == "+" {
        return throwErr(&mut st, "TypeError", "Cannot convert a Symbol value to a string")
    }
    return throwErr(&mut st, "TypeError", "Cannot convert a Symbol value to a number")
}

// Hot recursive nodes bypass the full dispatcher. The fallback contains large
// await/literal/construction arms whose locals otherwise reserve stack space on
// every simple call, even when those arms are not selected.
// Assignment and update live in their own functions so the FRONT dispatcher can
// reach them without entering evalExprFallback. That matters for size, not
// tidiness: evalExprFallback reserves about 11.9 KB of stack per call
// (`sub sp, sp, #0x2, lsl #12` plus `#0xdf0`) against evalExpr's ~800 bytes, and
// `x = ...` / `x++` are among the most frequent nodes in any loop. Routing them
// through the big frame cost both time and recursion depth.
fn evalAssignExpr(prog: &Prog, name: &string, e: ExprId, st: &mut Interp, scope: i64): JSValue {
    let v = evalExpr(prog, e, &mut st, scope)
    scopeAssign(&mut st, scope, name, cloneValue(v))
    return v
}

fn evalUpdateExpr(prog: &Prog, targetIdx: ExprId, isInc: bool, isPrefix: bool, st: &mut Interp, scope: i64): JSValue {
        let old = readLValue(prog, targetIdx, &mut st, scope)
        // a BigInt counter increments by 1n and stays a BigInt (x++ on 5n
        // must yield 5n / store 6n, not coerce through f64)
        if isBigIntVal(old) {
            var op = "+"
            if !isInc {
                op = "-"
            }
            let updated = evalBigIntBin(op, cloneValue(old), JSValue.BigInt("1"), &mut st)
            writeLValue(prog, targetIdx, &mut st, scope, cloneValue(updated))
            if isPrefix {
                return updated
            }
            return old
        }
        let oldNum = toNum(old)
        var newNum = oldNum + 1.0
        if !isInc {
            newNum = oldNum - 1.0
        }
        writeLValue(prog, targetIdx, &mut st, scope, JSValue.Number(newNum))
        if isPrefix {
            return JSValue.Number(newNum)
        }
        // postfix yields the numeric value before the update (JS coerces)
        return JSValue.Number(oldNum)
}

// Property read (`o.x`) and computed read (`o[k]`) are extracted from
// evalExprFallback for the same reason as assignment: they are among the most
// frequent nodes in real code, and reaching them through the fallback charged
// each one that function's multi-kilobyte frame. Their own arms were also the
// two largest in it, so moving them out shrinks the frame every REMAINING
// fallback node pays too.
// The value-level half of a property read: everything after the object
// expression has been evaluated. Split out of evalMemberExpr so the bytecode VM
// reads a property through the same primitive-receiver rules (a number's
// __proto__, a string's length, a boxed wrapper) instead of a second copy.
pub fn memberOfValue(prog: &Prog, ov: JSValue, name: &string, st: &mut Interp): JSValue {
    match ov {
        JSValue.Obj(o) => {
            return getMemberDyn(prog, o, name, &mut st)
        }
        JSValue.Number(_nv) => {
            if name == "__proto__" {
                let npp = primitiveProtoHandle(&mut st, ov)
                if npp >= 0 {
                    return JSValue.Obj(npp)
                }
            }
            // number primitives answer these by dispatch; without this a
            // read yields undefined, which breaks feature detection
            if isPrimitiveMethodName(name) {
                return makeBoundMethod(&mut st, cloneValue(ov), name.clone())
            }
            return JSValue.Undefined
        }
        JSValue.Bool(_bv) => {
            if name == "__proto__" {
                let bpp = primitiveProtoHandle(&mut st, ov)
                if bpp >= 0 {
                    return JSValue.Obj(bpp)
                }
            }
            if isPrimitiveMethodName(name) {
                return makeBoundMethod(&mut st, cloneValue(ov), name.clone())
            }
            return JSValue.Undefined
        }
        JSValue.Str(s) => {
            if name == "__proto__" {
                let sp = primitiveProtoHandle(&mut st, JSValue.Str(s.clone()))
                if sp >= 0 {
                    return JSValue.Obj(sp)
                }
            }
            return stringPrimitiveMember(&mut st, s, name)
        }
        JSValue.Sym(sid) => {
            return symbolPrimitiveMember(&mut st, sid, name)
        }
        JSValue.Func(_fIdx, _fe, _fo) => {
            // `fn.constructor === Function`: functions are not objects in
            // this value model, so nothing linked them to Function.
            if name == "constructor" {
                let statics1 = propertyBagOf(&mut st, ov)
                if objOwnIndex(st, statics1, name) < 0 {
                    return JSValue.Native(Native.Fn(Builtin.FunctionCtor))
                }
            }
            // fn.call / fn.apply / fn.bind as VALUES. They already work
            // when invoked directly; this is the extraction form real
            // bundles use (var slice = Array.prototype.slice; slice.call).
            if name == "call" || name == "apply" || name == "bind" {
                let statics0 = propertyBagOf(&mut st, ov)
                if objOwnIndex(st, statics0, name) < 0 {
                    return makeBoundMethod(&mut st, cloneValue(ov), name.clone())
                }
            }
            // through the bag, so a REDEFINED length/name is honoured:
            // these are ordinary own properties now, and reading them
            // from the FuncDef ignored any defineProperty on them
            if name == "length" || name == "name" {
                let nbag = propertyBagOf(&mut st, ov)
                let ni = objOwnIndex(st, nbag, name)
                if ni >= 0 {
                    return cloneValue(st.objects[nbag].props[ni].value)
                }
                // deleted: the read continues up the chain to
                // Function.prototype, whose name is "" and length 0
                if st.functionProtoObj >= 0 {
                    return getMember(st, st.functionProtoObj, name)
                }
            }
            // propertyBagOf, not the raw function object: this is the lookup
            // a borrowed `fn.hasOwnProperty("name")` ends up querying, and it
            // has to see the materialised name/length/prototype
            let statics = propertyBagOf(&mut st, ov)
            // getMemberDyn, not getMember: a `static get v()` is stored on
            // the statics object as an accessor, and the plain read never
            // invoked it — every static getter returned undefined
            return getMemberDyn(prog, statics, name, &mut st)
        }
        JSValue.Native(nid) => {
            let bag = getNativeProps(&mut st, nid)
            if name == "name" && objOwnIndex(st, bag, "name") < 0 {
                let nn = nativeCtorName(nid)
                if nn.len() > 0 {
                    return JSValue.Str(nn)
                }
            }
            return getMember(st, bag, name)
        }
        JSValue.Null => {
            return throwNullMember(&mut st, name, "null")
        }
        JSValue.Undefined => {
            return throwNullMember(&mut st, name, "undefined")
        }
        _ => {
            return JSValue.Undefined
        }
    }
}

fn evalMemberExpr(prog: &Prog, objIdx: ExprId, name: &string, st: &mut Interp, scope: i64): JSValue {
        let ov = evalExpr(prog, objIdx, &mut st, scope)
        // An object expression that THREW leaves ov undefined, and reading a
        // property off it then raised "cannot read property 'x' of
        // undefined" — replacing the real exception with a bogus TypeError.
        // `boom().length` reported the TypeError, not what boom() threw.
        if st.throwing {
            return JSValue.Undefined
        }
        // a preceding `?.` in this chain short-circuited: the whole chain,
        // including this member access, is undefined
        if st.optShort {
            return JSValue.Undefined
        }
        // A throw while evaluating the OBJECT must propagate. Without this
        // the failed subexpression read as `undefined` and the property read
        // replaced the real error with "cannot read property 'x' of
        // undefined" — `Temporal.Instant.from(bad).ns` reported a TypeError
        // where the parser had raised a RangeError.
        if st.throwing {
            return JSValue.Undefined
        }
        return memberOfValue(prog, ov, name, &mut st)
}

fn evalIndexExpr(prog: &Prog, objIdx: ExprId, keyIdx: ExprId, st: &mut Interp, scope: i64): JSValue {
        let ov = evalExpr(prog, objIdx, &mut st, scope)
        // see the Member arm: a throw in the object expression must not be
        // overwritten by an index read against undefined
        if st.throwing {
            return JSValue.Undefined
        }
        // a preceding `?.` short-circuited this chain
        if st.optShort {
            return JSValue.Undefined
        }
        // same as the Member case: a throw in the object expression is the
        // real error and must not be masked by the property read
        if st.throwing {
            return JSValue.Undefined
        }
        // the key expression can run user code and collect the base
        pushTemp(&mut st, cloneValue(ov))
        let kv = evalExpr(prog, keyIdx, &mut st, scope)
        popTemp(&mut st)
        if st.throwing {
            return JSValue.Undefined
        }
        let key = toPropertyKey(st, kv)
        match ov {
            JSValue.Obj(o) => {
                // buf[i] indexes a Buffer's bytes (it is a plain object, not a
                // Uint8Array, so the numeric property is not otherwise present)
                let bidx = asArrayIndex(key)
                if bidx >= 0 {
                    let nv = bufferNativeViewHandle(st, o)
                    if nv >= 0 {
                        return nativeBufferGet(st, nv, bidx)
                    }
                    let bh = bufferBytesHandle(st, o)
                    if bh >= 0 {
                        return arrGet(st, bh, bidx)
                    }
                }
                return getMemberDyn(prog, o, key, &mut st)
            }
            JSValue.Func(_fIdx, _fe, _fo) => {
                // computed read of a property assigned onto a function, e.g.
                // statuses[404] after statuses[code] = message
                let statics = propertyBagOf(&mut st, ov)
                if (key == "call" || key == "apply" || key == "bind") && objOwnIndex(st, statics, key) < 0 {
                    return makeBoundMethod(&mut st, cloneValue(ov), key.clone())
                }
                // getMemberDyn, like the dotted form: a computed read must
                // reach static accessors and the inherited Object.prototype
                // methods too, not just what is literally in the bag
                return getMemberDyn(prog, statics, key, &mut st)
            }
            JSValue.Native(nid) => {
                let bag = getNativeProps(&mut st, nid)
                if (key == "call" || key == "apply" || key == "bind") && objOwnIndex(st, bag, key) < 0 {
                    return makeBoundMethod(&mut st, JSValue.Native(nid), key.clone())
                }
                if key == "name" && objOwnIndex(st, bag, "name") < 0 {
                    let nn = nativeCtorName(nid)
                    if nn.len() > 0 {
                        return JSValue.Str(nn)
                    }
                }
                return getMember(st, bag, key)
            }
            JSValue.Sym(sid) => {
                return symbolPrimitiveMember(&mut st, sid, key)
            }
            JSValue.Str(s) => {
                // s["slice"] is the METHOD, not s[NaN] — asArrayIndex rejects
                // non-numeric keys, which toNum would have coerced to 0
                if asArrayIndex(key) < 0 {
                    return stringPrimitiveMember(&mut st, s, key)
                }
                // s[i] → the i-th UTF-16 code unit as a string (charAt
                // semantics), or undefined out of range — not a raw byte
                let i = toNum(kv) as i64
                if i >= 0 && i < utf16Length(s) {
                    return JSValue.Str(utf16Slice(s, i, i + 1))
                }
                return JSValue.Undefined
            }
            JSValue.Null => {
                return throwNullMember(&mut st, key, "null")
            }
            JSValue.Undefined => {
                return throwNullMember(&mut st, key, "undefined")
            }
            _ => {
                return JSValue.Undefined
            }
        }
}

fn evalMemberNode(prog: &Prog, id: ExprId, st: &mut Interp, scope: i64): JSValue {
    if let Expr.Member(objIdx, name) = prog.exprs[id.index] {
        return evalMemberExpr(prog, objIdx, name, &mut st, scope)
    }
    // Unreachable: evalExpr only calls this after matching Member. Falling through
    // to the full dispatcher rather than answering undefined keeps a future
    // mis-wiring a slowdown instead of a wrong value.
    return evalExprFallback(prog, id, &mut st, scope)
}

fn evalIndexNode(prog: &Prog, id: ExprId, st: &mut Interp, scope: i64): JSValue {
    if let Expr.Index(objIdx, keyIdx) = prog.exprs[id.index] {
        return evalIndexExpr(prog, objIdx, keyIdx, &mut st, scope)
    }
    // Unreachable: evalExpr only calls this after matching Index. Falling through
    // to the full dispatcher rather than answering undefined keeps a future
    // mis-wiring a slowdown instead of a wrong value.
    return evalExprFallback(prog, id, &mut st, scope)
}

// The three largest arms of evalExprFallback, lifted out of it. Dispatch is
// unchanged; the FRAME is the point. A function reserves the sum of every arm's
// locals, so the biggest arms set the entry price every OTHER node routed through
// the fallback pays. These three were chosen because the front dispatcher already
// handles Bin directly and Un/New are not on any hot path, so none of them gains
// a call it did not already make. ObjLit and SetMember were tried here too and
// REVERTED: both are reached only through the fallback, so extracting them added
// a real call to a hot node and cost 3-5% on objChurn for no further depth.
//
// Effect: fallback frame 9264 -> ~2.9 KB, and max nested-expression depth roughly
// triples (see docs/backlog.md).
// The value-level half of a property WRITE: everything after the object, key and
// value have been evaluated. Split out of the Expr.SetMember arm for the same
// reason as memberOfValue and evalBinValues — the bytecode VM must hit the
// Buffer/typed-array fast paths and the setter rules, not a second copy of them.
pub fn setMemberOfValue(prog: &Prog, ov: JSValue, key: string, v: JSValue, st: &mut Interp): JSValue {
    match ov {
        JSValue.Obj(o) => {
            // buf[i] = n writes the byte (masked to 0-255) into the
            // Buffer's backing array, matching Uint8Array assignment
            let bwidx = asArrayIndex(key)
            if bwidx >= 0 {
                let nv = bufferNativeViewHandle(st, o)
                if nv >= 0 && nativeBufferSet(&mut st, nv, bwidx, toNum(v)) {
                    return cloneValue(v)
                }
                let bh = bufferBytesHandle(st, o)
                if bh >= 0 && bwidx < st.objects[bh].elems.len() {
                    let byte = (toNum(v) as i64) & 255
                    st.objects[bh].elems[bwidx] = JSValue.Number(byte as f64)
                    return cloneValue(v)
                }
            }
            setMemberDyn(prog, o, key, cloneValue(v), &mut st)
        }
        JSValue.Native(nid) => {
            // assigning onto a builtin constructor, e.g.
            // Error.captureStackTrace = fn. setMemberDyn, not objSet, so
            // a non-writable property (every built-in `prototype`) drops
            // the write instead of silently replacing itself.
            let bag = getNativeProps(&mut st, nid)
            setMemberDyn(prog, bag, key, cloneValue(v), &mut st)
        }
        JSValue.Func(_sf, _senv, _sfo) => {
            // `prototype` is an ordinary own property of the function object,
            // so `Child.prototype = Object.create(Parent.prototype)` is a plain
            // write. setMemberDyn, not objSet: a `static set x(v)` accessor has
            // to be invoked, and objSet would replace it with a data property.
            let statics = propertyBagOf(&mut st, ov)
            setMemberDyn(prog, statics, key, cloneValue(v), &mut st)
        }
        _ => {
            // A primitive receiver has nowhere to put the property: the spec
            // creates a wrapper, fails to define on it, and in STRICT mode
            // reports that failure. Sloppy mode drops the write, which is what
            // this did for both modes.
            if st.strict {
                return throwErr(&mut st, "TypeError", "Cannot create property '" + key.clone() + "' on " + typeofStr(ov) + " '" + toStr(cloneValue(ov)) + "'")
            }
        }
    }
    return v
}

// The value-level half of a binary operator: everything after both operands
// have been evaluated. Split out of evalBinArm so the bytecode VM runs the same
// semantics rather than a second copy of them — a duplicated implementation of
// ToPrimitive ordering is exactly the kind that drifts and is then wrong in one
// place only.
pub fn evalBinValues(prog: &Prog, op: &string, va: JSValue, vb: JSValue, st: &mut Interp): JSValue {
    // `in` and `instanceof` first: they are object-protocol operators (proxy
    // has-trap, prototype walk), not coercing arithmetic, and they used to live
    // ONLY in the AST-level arms — the compiled path routed them here and got
    // evalBin's numeric fallback, so `"a" in proxy` skipped the has trap. The
    // AST arms call the same two helpers; this is now the single value-level home.
    if op == "in" {
        return evalInOperator(prog, toStr(va), vb, &mut st)
    }
    if op == "instanceof" {
        return JSValue.Bool(instanceOf(st, va, vb))
    }
    // a BigInt operand takes a dedicated path: arbitrary-precision math,
    // its own mixing rules (BigInt + Number throws), and value equality
    if isBigIntVal(va) || isBigIntVal(vb) {
        return evalBigIntBin(op, va, vb, &mut st)
    }
    // `==`/`!=` between an object and a coercible primitive converts the OBJECT
    // side (the rule that makes `new String("a") == "a"` true). This block was
    // only in evalBinArm, which is exactly the drift the split-out comment
    // below warns about: the compiled path answered false where the walker
    // coerced or threw.
    if (op == "==" || op == "!=") && (objHandle(va) >= 0) != (objHandle(vb) >= 0) && isEqCoercible(va) && isEqCoercible(vb) {
        pushTemp(&mut st, cloneValue(va))
        pushTemp(&mut st, cloneValue(vb))
        var eqa = cloneValue(va)
        var eqb = cloneValue(vb)
        if objHandle(va) >= 0 {
            eqa = toPrimitiveDefault(prog, va, &mut st)
        } else {
            eqb = toPrimitiveDefault(prog, vb, &mut st)
        }
        popTemp(&mut st)
        popTemp(&mut st)
        if st.throwing {
            return JSValue.Undefined
        }
        return evalBin(op, eqa, eqb)
    }
    // arithmetic/relational operators on an object operand need
    // interp-aware ToPrimitive (a Date valueOf's to its ms, arrays join,
    // objects call valueOf/toString). evalBin is a pure function with no
    // interp access, so do the coercion here. Gated on an object operand
    // to keep the hot number/string path free of overhead. Equality
    // (==/!=/===/!==) is excluded — it has its own object rules.
    // A SYMBOL has no implicit conversion: ToString and ToNumber of one both
    // throw. Equality compares without converting and stays allowed.
    if (isSymbolValue(va) || isSymbolValue(vb)) && op != "===" && op != "!==" && op != "==" && op != "!=" {
        return symbolOperandError(&mut st, op)
    }
    let coerces = op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || op == "**" || op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" || op == ">>>" || op == "<" || op == ">" || op == "<=" || op == ">="
    if coerces && (objHandle(va) >= 0 || objHandle(vb) >= 0 || funcHandle(va) >= 0 || funcHandle(vb) >= 0 || isNativeValue(va) || isNativeValue(vb)) {
        pushTemp(&mut st, cloneValue(va))
        pushTemp(&mut st, cloneValue(vb))
        // `+` uses the default hint (Date -> string); the arithmetic and
        // relational operators use the number hint (Date -> epoch ms).
        // Each operand coerced once, so a side-effecting valueOf runs once.
        var pa = JSValue.Undefined
        var pb = JSValue.Undefined
        if op == "+" {
            pa = toPrimitiveDefault(prog, va, &mut st)
            pushTemp(&mut st, cloneValue(pa))
            pb = toPrimitiveDefault(prog, vb, &mut st)
            popTemp(&mut st)
        } else {
            pa = toPrimitiveNumber(prog, va, &mut st)
            pushTemp(&mut st, cloneValue(pa))
            pb = toPrimitiveNumber(prog, vb, &mut st)
            popTemp(&mut st)
        }
        popTemp(&mut st)
        popTemp(&mut st)
        // a symbol WRAPPER reaches its symbol only through ToPrimitive
        if isSymbolValue(pa) || isSymbolValue(pb) {
            return symbolOperandError(&mut st, op)
        }
        return evalBin(op, pa, pb)
    }
    return evalBin(op, va, vb)
}

fn evalBinArm(prog: &Prog, op: &string, a: ExprId, b: ExprId, st: &mut Interp, scope: i64): JSValue {
        // && and || short-circuit and yield the operand value, JS-style
        if op == "&&" {
            let va = evalExpr(prog, a, &mut st, scope)
            if !truthy(va) {
                return va
            }
            return evalExpr(prog, b, &mut st, scope)
        }
        if op == "||" {
            let va = evalExpr(prog, a, &mut st, scope)
            if truthy(va) {
                return va
            }
            return evalExpr(prog, b, &mut st, scope)
        }
        if op == "??" {
            // nullish coalescing: only null/undefined fall through
            let va = evalExpr(prog, a, &mut st, scope)
            match va {
                JSValue.Null => {
                    return evalExpr(prog, b, &mut st, scope)
                }
                JSValue.Undefined => {
                    return evalExpr(prog, b, &mut st, scope)
                }
                _ => {
                    return va
                }
            }
        }
        if op == "in" {
            let kv = evalExpr(prog, a, &mut st, scope)
            let ov = evalExpr(prog, b, &mut st, scope)
            return evalInOperator(prog, toStr(kv), ov, &mut st)
        }
        if op == "instanceof" {
            let lv = evalExpr(prog, a, &mut st, scope)
            pushTemp(&mut st, cloneValue(lv))
            let rv = evalExpr(prog, b, &mut st, scope)
            popTemp(&mut st)
            return JSValue.Bool(instanceOf(st, lv, rv))
        }
        let va = evalExpr(prog, a, &mut st, scope)
        // evaluating the right operand can run user code and collect
        pushTemp(&mut st, cloneValue(va))
        let vb = evalExpr(prog, b, &mut st, scope)
        popTemp(&mut st)
        return evalBinValues(prog, op, va, vb, &mut st)
}

// Which unary operator this is, as a value rather than a borrow. `op` points
// INTO prog.exprs, and evaluating the operand can require() a module into that
// same shared Prog, which moves the storage — so the operator has to be decided
// before the operand runs, never compared after it.
//
// This is tools/ast-ref-allow.txt's `fn evalUnArm:op` entry, and it was not
// theoretical. `typeof process.getBuiltinModule('fs')` answered `false` about
// one run in six: the require moved the AST, every comparison against the
// dangling string failed, and the function fell out to its `!` fallback — so
// `typeof` returned a boolean, which it cannot otherwise ever do.
// The unary operators, as a value rather than a borrow into the AST.
enum UnOp {
    // Not is first because it is also the fallback: evalUnArm has always
    // treated an operator it does not recognise as `!`.
    Not,
    Neg,
    Plus,
    BitNot,
    TypeOf,
    Void,
    Await,
    Yield,
    YieldStar,
    Delete,
}

fn unOpOf(op: &string): UnOp {
    if op == "-" {
        return UnOp.Neg
    }
    if op == "+" {
        return UnOp.Plus
    }
    if op == "~" {
        return UnOp.BitNot
    }
    if op == "typeof" {
        return UnOp.TypeOf
    }
    if op == "void" {
        return UnOp.Void
    }
    if op == "await" {
        return UnOp.Await
    }
    if op == "yield" {
        return UnOp.Yield
    }
    if op == "yield*" {
        return UnOp.YieldStar
    }
    if op == "delete" {
        return UnOp.Delete
    }
    return UnOp.Not
}

fn evalUnArm(prog: &Prog, op: &string, a: ExprId, st: &mut Interp, scope: i64): JSValue {
        let code = unOpOf(op)
        // delete needs the unevaluated target, not its value
        if code == UnOp.Delete {
            return evalDelete(prog, a, &mut st, scope)
        }
        // typeof is the one context where an undeclared name is legal
        if code == UnOp.TypeOf {
            if let Expr.Ident(iname) = prog.exprs[a.index] {
                if iname != "this" && !scopeHas(st, scope, iname) {
                    return JSValue.Str("undefined")
                }
            }
        }
        // evalExpr can re-enter the parser (require, Function) and move the
        // AST arena; `op` borrows into it, so the delegation below must read a
        // copy taken before the re-entry — this is the evalUnArm:op entry in
        // tools/ast-ref-allow.txt's history, not a hypothetical.
        let opCopy = op.clone()
        let va = evalExpr(prog, a, &mut st, scope)
        if code == UnOp.Await {
            return awaitValue(prog, va, &mut st)
        }
        if code == UnOp.Yield {
            return genYield(va, &mut st)
        }
        if code == UnOp.YieldStar {
            // Delegate: drive the operand's iterator, re-yielding each value to
            // our own consumer. The value of `yield* it` is the inner
            // iterator's return value (the value carried by its {done:true}).
            let vh = objHandle(va)
            var last = JSValue.Undefined
            if vh >= 0 && st.objects[vh].isGenerator {
                // inner generator: drive genResume directly (its next/throw/
                // return are native methods, not stored properties)
                var guard: i64 = 0
                // how to resume the inner on the next turn: 0 next, 1 throw,
                // 2 return — mirrors what our own consumer did to US
                var mode: i64 = 0
                var sendVal = JSValue.Undefined
                while !st.throwing && guard < 100000000 {
                    guard = guard + 1
                    var nA: Vec<JSValue> = Vec.new()
                    nA.push(cloneValue(sendVal))
                    let step = genResume(vh, nA, mode, &mut st)
                    let sh = objHandle(step)
                    if st.throwing || sh < 0 {
                        // the inner did not handle it (or has no record left);
                        // the completion keeps unwinding through us
                        guard = 100000000
                    } else if truthy(getMemberDyn(prog, sh, "done", &mut st)) {
                        last = getMemberDyn(prog, sh, "value", &mut st)
                        if mode == 2 {
                            // the inner finished closing — pick our own
                            // return-unwind back up where it was interrupted
                            st.throwing = true
                            st.genReturning = true
                            st.thrownValue = cloneValue(last)
                        }
                        guard = 100000000
                    } else {
                        let v = getMemberDyn(prog, sh, "value", &mut st)
                        if st.throwing {
                            // the value getter threw: do NOT hand the
                            // undefined it left behind to our consumer
                            guard = 100000000
                            continue
                        }
                        let sent = genYield(v, &mut st)
                        mode = 0
                        sendVal = cloneValue(sent)
                        if st.throwing {
                            // Our consumer called throw()/return() while we
                            // were parked in this delegation. yield* hands the
                            // completion to the INNER iterator first, so its
                            // own catch/finally runs; whatever the inner then
                            // does is what continues outward. Without this the
                            // inner generator stayed parked and its finally
                            // never ran.
                            mode = 1
                            if st.genReturning {
                                mode = 2
                            }
                            sendVal = cloneValue(st.thrownValue)
                            st.throwing = false
                            st.genReturning = false
                            st.thrownValue = JSValue.Undefined
                        }
                    }
                }
                return last
            }
            // any other iterable: resolve [Symbol.iterator] and drive next().
            // Guarded on vh: a primitive (`yield* "hi"`) has handle -1, and
            // getMemberDyn indexed st.objects with it and trapped.
            var iter = cloneValue(va)
            if vh >= 0 {
                let itFn = getMemberDyn(prog, vh, symIteratorKey(), &mut st)
                if isCallableIn(st, itFn) {
                    var noArgs: Vec<JSValue> = Vec.new()
                    iter = callValue(prog, itFn, noArgs, cloneValue(va), &mut st)
                }
            }
            var drove = false
            let ih = objHandle(iter)
            if ih >= 0 && isCallableIn(st, getMemberDyn(prog, ih, "next", &mut st)) {
                drove = true
                pushTemp(&mut st, cloneValue(iter))
                var guard2: i64 = 0
                // same completion forwarding as the generator branch above,
                // through the iterator's own next/throw/return properties
                var mode2: i64 = 0
                var sendVal2 = JSValue.Undefined
                while !st.throwing && guard2 < 100000000 {
                    guard2 = guard2 + 1
                    var mname = "next"
                    if mode2 == 1 {
                        mname = "throw"
                    }
                    if mode2 == 2 {
                        mname = "return"
                    }
                    let stepFn = getMemberDyn(prog, objHandle(iter), mname, &mut st)
                    if !isCallableIn(st, stepFn) {
                        // the iterator does not implement this completion, so
                        // there is nothing to close — resume our own unwind
                        if mode2 == 1 {
                            st.throwing = true
                            st.thrownValue = cloneValue(sendVal2)
                        } else if mode2 == 2 {
                            st.throwing = true
                            st.genReturning = true
                            st.thrownValue = cloneValue(sendVal2)
                        }
                        guard2 = 100000000
                    } else {
                        var nArgs: Vec<JSValue> = Vec.new()
                        nArgs.push(cloneValue(sendVal2))
                        let step = callValue(prog, stepFn, nArgs, cloneValue(iter), &mut st)
                        let sh = objHandle(step)
                        if !st.throwing && sh < 0 {
                            // An iterator's next() MUST answer an object. A
                            // primitive is a TypeError, not a quiet end of
                            // iteration — `yield*` over `{ next() { return 5 } }`
                            // stopped silently instead of throwing.
                            st.throwing = true
                            st.thrownValue = makeError(&mut st, "TypeError", "iterator result " + toStr(step) + " is not an object")
                        }
                        if st.throwing || sh < 0 {
                            guard2 = 100000000
                        } else if truthy(getMemberDyn(prog, sh, "done", &mut st)) {
                            last = getMemberDyn(prog, sh, "value", &mut st)
                            if mode2 == 2 {
                                st.throwing = true
                                st.genReturning = true
                                st.thrownValue = cloneValue(last)
                            }
                            guard2 = 100000000
                        } else {
                            let v = getMemberDyn(prog, sh, "value", &mut st)
                            if st.throwing {
                                guard2 = 100000000
                                continue
                            }
                            let sent = genYield(v, &mut st)
                            mode2 = 0
                            sendVal2 = cloneValue(sent)
                            if st.throwing {
                                mode2 = 1
                                if st.genReturning {
                                    mode2 = 2
                                }
                                sendVal2 = cloneValue(st.thrownValue)
                                st.throwing = false
                                st.genReturning = false
                                st.thrownValue = JSValue.Undefined
                            }
                        }
                    }
                }
                popTemp(&mut st)
            }
            if !drove {
                // A string, or a native Map/Set: neither exposes a `next`
                // through the prototype chain yet, so the loop above cannot
                // drive them and `yield* new Set(...)` silently yielded
                // nothing. spreadInto already knows every built-in iterable,
                // so borrow it. Eager, unlike the loop above — only
                // observable for an infinite inner iterator, which none of
                // these shapes can be. Their completion value is undefined,
                // so `last` correctly stays Undefined.
                var items: Vec<JSValue> = Vec.new()
                let spreadBase = st.tempRoots.len()
                spreadInto(prog, &mut items, cloneValue(va), &mut st)
                // hold the values in a rooted array: genYield parks this task,
                // and a collect while it is parked would sweep anything the
                // plain Vec is the only reference to
                let hold = newArray(&mut st)
                var hi: i64 = 0
                while hi < items.len() {
                    arrPush(&mut st, hold, cloneValue(items[hi]))
                    hi = hi + 1
                }
                truncateTemps(&mut st, spreadBase)
                pushTemp(&mut st, JSValue.Obj(hold))
                var k: i64 = 0
                while !st.throwing && k < arrLen(st, hold) {
                    let _sent = genYield(arrGet(st, hold, k), &mut st)
                    k = k + 1
                }
                popTemp(&mut st)
            }
            return last
        }
        return evalUnValue(prog, opCopy, va, &mut st)
}

// The unary operators on an already-evaluated VALUE: everything evalUnArm does
// after its operand is in hand, minus the suspension/delete/typeof-ident cases
// the caller owns. The compiled path (Op.UnSlow) calls this directly, so both
// paths share one implementation of coercion order.
pub fn evalUnValue(prog: &Prog, op: &string, va: JSValue, st: &mut Interp): JSValue {
        let code = unOpOf(op)
        // The numeric unary operators coerce, and ToNumber of a SYMBOL throws.
        // `typeof` and `void` do not convert.
        if isSymbolValue(va) && (code == UnOp.Neg || code == UnOp.Plus || code == UnOp.BitNot) {
            return throwErr(&mut st, "TypeError", "Cannot convert a Symbol value to a number")
        }
        if code == UnOp.Neg {
            // BigInt negation stays a BigInt; unary + on a BigInt throws in JS
            if isBigIntVal(va) {
                return JSValue.BigInt(bnNeg(bigStrOf(va)))
            }
            // negate, don't subtract from zero: 0.0 - 0.0 is +0, so `-0`
            // lost its sign and Object.is(0, -0) came out true
            //
            // ToNumber of an OBJECT runs ToPrimitive first, which can call
            // valueOf/toString/@@toPrimitive. `toNum` cannot (it has no Prog to
            // re-enter user code with) and answers NaN, so `-[1]` was NaN where
            // it should be -1. The compiled Op.Neg got this right and the
            // evaluator did not, which is how the two disagreed.
            if objHandle(va) >= 0 {
                return JSValue.Number(-toNumProg(prog, va, &mut st))
            }
            return JSValue.Number(-toNum(va))
        }
        if code == UnOp.BitNot && isBigIntVal(va) {
            // ~x on a BigInt is -(x+1); exact and cheap without full bitwise
            return JSValue.BigInt(bnSub(bnNeg(bigStrOf(va)), "1"))
        }
        if code == UnOp.TypeOf {
            // a bind() result is an object internally but a function to JS
            let th = objHandle(va)
            if th >= 0 && (st.objects[th].isBound || st.objects[th].isFunctionLike) {
                return JSValue.Str("function")
            }
            return JSValue.Str(typeofStr(va))
        }
        if code == UnOp.Void {
            return JSValue.Undefined
        }
        if code == UnOp.Plus {
            // ToNumber of a BigInt is a TypeError -- unary plus is the one
            // arithmetic operator BigInt does not support, precisely so that
            // `+x` cannot silently lose precision. Answering the numeric value
            // did exactly what the rule exists to prevent.
            if isBigIntVal(va) {
                return throwErr(&mut st, "TypeError", "Cannot convert a BigInt value to a number")
            }
            // unary plus is ToNumber, which ToPrimitive(number)s an object
            // first (so +new Date(0) is its epoch ms, not NaN)
            if objHandle(va) >= 0 {
                return JSValue.Number(toNumProg(prog, va, &mut st))
            }
            return JSValue.Number(toNum(va))
        }
        if code == UnOp.BitNot {
            // ToInt32 goes through ToNumber, so an object is ToPrimitive'd first:
            // `~[1]` is -2, not -1. toInt32 alone read the object as 0.
            if objHandle(va) >= 0 {
                let pn = toNumProg(prog, va, &mut st)
                if st.throwing {
                    return JSValue.Undefined
                }
                let rp = (0 - toInt32(JSValue.Number(pn))) - 1
                return JSValue.Number(rp as f64)
            }
            let r = (0 - toInt32(va)) - 1
            return JSValue.Number(r as f64)
        }
        return JSValue.Bool(!truthy(va))
}

fn evalNewArm(prog: &Prog, calleeIdx: ExprId, argsIdx: ArgListId, st: &mut Interp, scope: i64): JSValue {
    // scoped roots: the receiver and every argument evalArgs pushes stay alive
    // for the whole call, and the arms need not balance their pops (see evalArgs)
    let base = st.tempRoots.len()
    let r = evalNewArms(prog, calleeIdx, argsIdx, &mut st, scope)
    truncateTemps(&mut st, base)
    return r
}

fn evalNewArms(prog: &Prog, calleeIdx: ExprId, argsIdx: ArgListId, st: &mut Interp, scope: i64): JSValue {
        let calleeVal = evalExpr(prog, calleeIdx, &mut st, scope)
        // a throw while resolving the constructor expression must propagate:
        // continuing here replaced the real error with "value is not a
        // constructor", which pointed at the wrong line entirely
        if st.throwing {
            return JSValue.Undefined
        }
        // `new Promise(executor)` runs its executor immediately with a
        // resolve/reject pair bound to the new promise. Handled here rather
        // than in callNative because the executor is a user function and
        // needs the program to run.
        let ah = objHandle(calleeVal)
        if ah >= 0 && st.arrayCtorObj >= 0 && ah == st.arrayCtorObj {
            let argVals = evalArgs(prog, argsIdx, &mut st, scope)
            // An argument expression that threw ABORTS the call: without this the
            // callee still ran with the arguments evaluated so far, so
            // `arr.push(boom())` pushed a value and a Promise executor's
            // `resolve(boom())` settled the promise with undefined.
            if st.throwing {
                return JSValue.Undefined
            }
            return makeArrayFromCtor(&mut st, argVals)
        }
        let ph = objHandle(calleeVal)
        if ph >= 0 && isPromiseCtor(st, ph) {
            let argVals = evalArgs(prog, argsIdx, &mut st, scope)
            // An argument expression that threw ABORTS the call: without this the
            // callee still ran with the arguments evaluated so far, so
            // `arr.push(boom())` pushed a value and a Promise executor's
            // `resolve(boom())` settled the promise with undefined.
            if st.throwing {
                return JSValue.Undefined
            }
            return constructPromise(prog, &mut st, argVals)
        }
        match calleeVal {
            JSValue.Func(_fIdx, _envIdx, _fo) => {
                // arrows and methods are NOT constructors. `new` on one is a
                // TypeError, and every one of them used to build an object
                // and run the body against it instead.
                // valueIsConstructor rather than the isArrow/isMethod pair
                // this used to test inline: generators, async functions and
                // anything __markNotConstructor recorded are equally not
                // constructors, and Reflect.construct already rejected all
                // of them while `new` on the same value quietly succeeded.
                if !valueIsConstructor(prog, st, calleeVal) {
                    return throwErr(&mut st, "TypeError", describeCallee(prog, calleeIdx) + " is not a constructor")
                }
                pushTemp(&mut st, cloneValue(calleeVal))
                let argVals = evalArgs(prog, argsIdx, &mut st, scope)
                // An argument expression that threw ABORTS the call: without this the
                // callee still ran with the arguments evaluated so far, so
                // `arr.push(boom())` pushed a value and a Promise executor's
                // `resolve(boom())` settled the promise with undefined.
                if st.throwing {
                    return JSValue.Undefined
                }
                // link the instance to the constructor's prototype (for
                // shared methods and instanceof)
                let proto = funcPrototypeObj(&mut st, calleeVal)
                let obj = newObject(&mut st)
                st.objects[obj].proto = proto
                pushTemp(&mut st, JSValue.Obj(obj))
                st.newTarget = cloneValue(calleeVal)
                let result = callFunction(prog, calleeVal, argVals, JSValue.Obj(obj), &mut st)
                st.newTarget = JSValue.Undefined
                popTemp(&mut st)
                popTemp(&mut st)
                // A constructor that returns an object OR a function replaces
                // the new instance. express's Router is a factory that returns
                // an inner function; discarding it yielded an empty object.
                if objHandle(result) >= 0 || funcHandle(result) >= 0 {
                    return result
                }
                return JSValue.Obj(obj)
            }
            JSValue.Native(nativeId) => {
                if !nativeIsConstructor(nativeId) {
                    return throwErr(&mut st, "TypeError", describeCallee(prog, calleeIdx) + " is not a constructor")
                }
                let argVals = evalArgs(prog, argsIdx, &mut st, scope)
                // An argument expression that threw ABORTS the call: without this the
                // callee still ran with the arguments evaluated so far, so
                // `arr.push(boom())` pushed a value and a Promise executor's
                // `resolve(boom())` settled the promise with undefined.
                if st.throwing {
                    return JSValue.Undefined
                }
                // Called as a function these three coerce; called with `new`
                // they BOX. Ignoring `new` made `new Boolean(false)` falsy
                // and `typeof new String("")` report "string".
                if nativeEq(nativeId, Native.Fn(Builtin.String)) || nativeEq(nativeId, Native.Fn(Builtin.Number)) || nativeEq(nativeId, Native.Fn(Builtin.Boolean)) {
                    let prim = callNativeProg(prog, nativeId, argVals, &mut st)
                    if st.throwing {
                        return JSValue.Undefined
                    }
                    return makeWrapper(&mut st, prim)
                }
                return callNativeProg(prog, nativeId, argVals, &mut st)
            }
            JSValue.Obj(co) => {
                if st.objects[co].isProxy {
                    let argVals = evalArgs(prog, argsIdx, &mut st, scope)
                    // An argument expression that threw ABORTS the call: without this the
                    // callee still ran with the arguments evaluated so far, so
                    // `arr.push(boom())` pushed a value and a Promise executor's
                    // `resolve(boom())` settled the promise with undefined.
                    if st.throwing {
                        return JSValue.Undefined
                    }
                    // newTarget is the proxy itself for a plain `new p()`
                    return constructValue(prog, &mut st, JSValue.Obj(co), argVals, JSValue.Obj(co))
                }
                // a class defined by a node-api addon (napi_define_class): build
                // the instance here and link its prototype, then let the addon's
                // constructor callback populate it — typically via napi_wrap.
                // `new` on a bind() result constructs the TARGET, with the
                // pre-bound arguments in front and the bound `this` ignored
                // — the spec's [[Construct]] on a bound function. It fell
                // through to "value is not a constructor".
                if st.objects[co].isBound {
                    // a BUILT-IN method value (Array.prototype.map, JSON.parse
                    // read off its namespace) is bound but is not a
                    // constructor. A genuine bind() RESULT is, when its
                    // target is, and that is the case just below.
                    if st.objExtras[st.objects[co].extra].boundMethod.len() > 0 {
                        return throwErr(&mut st, "TypeError", describeCallee(prog, calleeIdx) + " is not a constructor")
                    }
                    // Binding does not MAKE something constructable: an arrow, a
                    // method or a generator is still not a constructor after
                    // `.bind(null)`, and `new (arrow.bind(null))()` built an
                    // object and ran the arrow against it.
                    if !valueIsConstructor(prog, st, JSValue.Obj(co)) {
                        return throwErr(&mut st, "TypeError", describeCallee(prog, calleeIdx) + " is not a constructor")
                    }
                    let bex = st.objects[co].extra
                    let btarget = cloneValue(st.objExtras[bex].boundTarget)
                    let callArgs = evalArgs(prog, argsIdx, &mut st, scope)
                    // An argument expression that threw ABORTS the call: without this the
                    // callee still ran with the arguments evaluated so far, so
                    // `arr.push(boom())` pushed a value and a Promise executor's
                    // `resolve(boom())` settled the promise with undefined.
                    if st.throwing {
                        return JSValue.Undefined
                    }
                    var nargs: Vec<JSValue> = Vec.new()
                    var bj: i64 = 0
                    while bj < st.objExtras[bex].boundArgs.len() {
                        nargs.push(cloneValue(st.objExtras[bex].boundArgs[bj]))
                        bj = bj + 1
                    }
                    var cj: i64 = 0
                    while cj < callArgs.len() {
                        nargs.push(cloneValue(callArgs[cj]))
                        cj = cj + 1
                    }
                    if funcHandle(btarget) >= 0 {
                        let bproto = funcPrototypeObj(&mut st, btarget)
                        let binst = newObject(&mut st)
                        st.objects[binst].proto = bproto
                        pushTemp(&mut st, JSValue.Obj(binst))
                        st.newTarget = cloneValue(btarget)
                        let bres = callFunction(prog, btarget, nargs, JSValue.Obj(binst), &mut st)
                        st.newTarget = JSValue.Undefined
                        popTemp(&mut st)
                        if objHandle(bres) >= 0 || funcHandle(bres) >= 0 {
                            return bres
                        }
                        return JSValue.Obj(binst)
                    }
                    return callValue(prog, btarget, nargs, JSValue.Undefined, &mut st)
                }
                if st.objExtras[st.objects[co].extra].napiFn >= 0 {
                    let argVals = evalArgs(prog, argsIdx, &mut st, scope)
                    // An argument expression that threw ABORTS the call: without this the
                    // callee still ran with the arguments evaluated so far, so
                    // `arr.push(boom())` pushed a value and a Promise executor's
                    // `resolve(boom())` settled the promise with undefined.
                    if st.throwing {
                        return JSValue.Undefined
                    }
                    let inst = newObject(&mut st)
                    if let JSValue.Obj(pr) = objGet(st, co, "prototype") {
                        st.objects[inst].proto = pr
                    }
                    pushTemp(&mut st, JSValue.Obj(inst))
                    let r = napiInvoke(st.objExtras[st.objects[co].extra].napiFn, argVals, JSValue.Obj(inst))
                    popTemp(&mut st)
                    match r {
                        JSValue.Obj(ro) => {
                            return JSValue.Obj(ro)
                        }
                        _ => {
                            return JSValue.Obj(inst)
                        }
                    }
                }
                return throwErr(&mut st, "TypeError", "value is not a constructor")
            }
            _ => {
                return throwErr(&mut st, "TypeError", "value is not a constructor")
            }
        }
}

pub fn evalExpr(prog: &Prog, id: ExprId, st: &mut Interp, scope: i64): JSValue {
    if st.throwing {
        return JSValue.Undefined
    }
    match prog.exprs[id.index] {
        Expr.Num(n) => {
            return JSValue.Number(n)
        }
        Expr.StrLit(s) => {
            return JSValue.Str(s.clone())
        }
        Expr.BigIntLit(s) => {
            return JSValue.BigInt(bigNormalizeDec(s))
        }
        Expr.BoolLit(b) => {
            return JSValue.Bool(b)
        }
        Expr.NullLit => {
            return JSValue.Null
        }
        Expr.UndefLit => {
            return JSValue.Undefined
        }
        Expr.Ident(name) => {
            match scopeTryLookup(st, scope, name) {
                Option.Some(v) => {
                    return v
                }
                Option.None => {
                    if name == "this" {
                        // no enclosing function or module bound one: script
                        // code's `this` is the global object, as is an arrow's
                        // at top level
                        return scopeLookup(st, 0, "globalThis")
                    }
                    return throwErr(&mut st, "ReferenceError", name.clone() + " is not defined")
                }
            }
        }
        Expr.Bin(op, a, b) => {
            return evalBinaryExpr(prog, op, a, b, &mut st, scope)
        }
        Expr.Call(callee, argsIdx) => {
            return evalCall(prog, callee, argsIdx, &mut st, scope)
        }
        Expr.Assign(name, e) => {
            return evalAssignExpr(prog, name, e, &mut st, scope)
        }
        Expr.Update(targetIdx, isInc, isPrefix) => {
            return evalUpdateExpr(prog, targetIdx, isInc, isPrefix, &mut st, scope)
        }
        // Payloads are deliberately NOT bound here: giving the front dispatcher
        // slots for a string and two ids grew its own frame from 128 to 736
        // bytes, which every expression paid. The helper re-matches instead.
        Expr.Member(_o, _n) => {
            return evalMemberNode(prog, id, &mut st, scope)
        }
        Expr.Index(_o, _k) => {
            return evalIndexNode(prog, id, &mut st, scope)
        }
        _ => {
    return evalExprFallback(prog, id, &mut st, scope)
        }
    }
}

// The call half of f?.(args), a scoped-root call boundary like evalCall.
fn callOptional(prog: &Prog, calleeVal: JSValue, argsIdx: ArgListId, st: &mut Interp, scope: i64): JSValue {
    let base = st.tempRoots.len()
    rootIfHeap(&mut st, calleeVal)
    let argVals = evalArgs(prog, argsIdx, &mut st, scope)
    var r = JSValue.Undefined
    // An argument expression that threw ABORTS the call
    if !st.throwing {
        r = callValue(prog, calleeVal, argVals, JSValue.Undefined, &mut st)
    }
    truncateTemps(&mut st, base)
    return r
}

fn evalExprFallback(prog: &Prog, id: ExprId, st: &mut Interp, scope: i64): JSValue {
    // an exception is unwinding — stop evaluating, produce a placeholder
    if st.throwing {
        return JSValue.Undefined
    }
    // match the arena slot in place — cloning the node (and its string payloads)
    // per visit was the dominant interpreter cost
    match prog.exprs[id.index] {
        Expr.Num(n) => {
            return JSValue.Number(n)
        }
        Expr.StrLit(s) => {
            return JSValue.Str(s.clone())
        }
        Expr.BigIntLit(s) => {
            return JSValue.BigInt(bigNormalizeDec(s))
        }
        Expr.BoolLit(b) => {
            return JSValue.Bool(b)
        }
        Expr.NullLit => {
            return JSValue.Null
        }
        Expr.UndefLit => {
            return JSValue.Undefined
        }
        Expr.Ident(name) => {
            match scopeTryLookup(st, scope, name) {
                Option.Some(v) => {
                    return v
                }
                Option.None => {
                    // reading an undeclared identifier is a ReferenceError in JS;
                    // without this a typo just evaluates to undefined and the
                    // failure surfaces somewhere else entirely
                    // `this` is never a ReferenceError — unbound at module top
                    // level it is simply undefined, and CommonJS code reads it
                    // freely
                    if name != "this" {
                        st.throwing = true
                        st.thrownValue = makeError(&mut st, "ReferenceError", name.clone() + " is not defined")
                    }
                    return JSValue.Undefined
                }
            }
        }
        Expr.Bin(op, a, b) => {
            return evalBinArm(prog, op, a, b, &mut st, scope)
        }
        Expr.Un(op, a) => {
            return evalUnArm(prog, op, a, &mut st, scope)
        }
        Expr.ImportCall(inner) => {
            return evalImportCall(prog, inner, &mut st, scope)
        }
        Expr.Assign(name, e) => {
            return evalAssignExpr(prog, name, e, &mut st, scope)
        }
        Expr.Call(callee, argsIdx) => {
            return evalCall(prog, callee, argsIdx, &mut st, scope)
        }
        Expr.Member(objIdx, name) => {
            return evalMemberExpr(prog, objIdx, name, &mut st, scope)
        }
        Expr.Index(objIdx, keyIdx) => {
            return evalIndexExpr(prog, objIdx, keyIdx, &mut st, scope)
        }
        Expr.SetMember(objIdx, keyIdx, valIdx) => {
            let ov = evalExpr(prog, objIdx, &mut st, scope)
            // both key and value can run user code, so the target stays rooted
            // across both — else obj[f()] = g() writes into a reused slot
            pushTemp(&mut st, cloneValue(ov))
            let kv = evalExpr(prog, keyIdx, &mut st, scope)
            let key = toPropertyKey(st, kv)
            let v = evalExpr(prog, valIdx, &mut st, scope)
            popTemp(&mut st)
            return setMemberOfValue(prog, ov, key, v, &mut st)
        }
        Expr.ClassExpr(classIdx) => {
            return instantiateClass(prog, classIdx, &mut st, scope)
        }
        Expr.ObjLit(litIdx) => {
            let obj = newObject(&mut st)
            // root the part-built object so a GC while evaluating later property
            // values (a value may be a call) can't reclaim it
            pushTemp(&mut st, JSValue.Obj(obj))
            var i: i64 = 0
            let n = prog.objLits[litIdx.index].len()
            while i < n {
                var key = prog.objLits[litIdx.index][i].key.clone()
                if let Option.Some(keyExprId) = prog.objLits[litIdx.index][i].keyExpr {
                    key = toPropertyKey(st, evalExpr(prog, keyExprId, &mut st, scope))
                }
                let valIdx = prog.objLits[litIdx.index][i].val
                let v = evalExpr(prog, valIdx, &mut st, scope)
                let propKind = prog.objLits[litIdx.index][i].kind
                if propKind > 0 {
                    // a getter and setter for the same key share one property
                    let existing = objOwnIndex(st, obj, key)
                    var g = JSValue.Undefined
                    var sfn = JSValue.Undefined
                    if existing >= 0 && propIsAccessor(st, obj, existing) {
                        g = accGetter(st, st.objects[obj].props[existing].acc)
                        sfn = accSetter(st, st.objects[obj].props[existing].acc)
                    }
                    if propKind == 1 {
                        g = v
                    } else {
                        sfn = v
                    }
                    objDefineAccessor(&mut st, obj, key, g, sfn)
                } else if key == "..." {
                    let src = objHandle(v)
                    if src >= 0 && st.objects[src].isProxy {
                        let skeys = ownEnumerableKeys(prog, &mut st, v)
                        var si: i64 = 0
                        while si < skeys.len() && !st.throwing {
                            let sk = skeys[si].clone()
                            si = si + 1
                            let sv2 = getMemberDyn(prog, src, sk.clone(), &mut st)
                            if !st.throwing {
                                objSet(&mut st, obj, sk, sv2)
                            }
                        }
                    } else if src >= 0 {
                        if st.objects[src].isArray {
                            var e: i64 = 0
                            let ne = arrLen(st, src)
                            while e < ne {
                                // a HOLE is the absence of a property, so spreading
                                // a sparse array must not invent keys for it:
                                // `{...[1,,,4]}` is {0:1, 3:4}, not four keys.
                                if !arrIsHole(st, src, e) {
                                    objSet(&mut st, obj, i64ToStr(e), arrGet(st, src, e))
                                }
                                e = e + 1
                            }
                        }
                        if !st.objects[src].isDataView && taCurrentLen(st, src) > 0 {
                            let stl = taCurrentLen(st, src)
                            var stv: i64 = 0
                            while stv < stl {
                                objSet(&mut st, obj, i64ToStr(stv), taElemValue(st, src, stv))
                                stv = stv + 1
                            }
                        }
                        let order = enumOrder(st, src)
                        var oi: i64 = 0
                        while oi < order.len() {
                            let k = order[oi]
                            oi = oi + 1
                            if !st.objects[src].props[k].enumerable {
                                continue
                            }
                            let pk = st.objects[src].props[k].key.clone()
                            // spread copies the VALUE of an accessor, so invoke the
                            // getter rather than copying the (unused) value slot
                            var pv = JSValue.Undefined
                            if propIsAccessor(st, src, k) {
                                pv = getMemberDyn(prog, src, pk, &mut st)
                            } else {
                                pv = cloneValue(st.objects[src].props[k].value)
                            }
                            objSet(&mut st, obj, pk, pv)
                        }
                        // CopyDataProperties takes the enumerable SYMBOL keys
                        // too, after the strings; enumOrder leaves them out
                        var sy: i64 = 0
                        while sy < st.objects[src].props.len() && !st.throwing {
                            if isSymbolKey(st.objects[src].props[sy].key) && st.objects[src].props[sy].enumerable {
                                let syk = st.objects[src].props[sy].key.clone()
                                var syv = JSValue.Undefined
                                if propIsAccessor(st, src, sy) {
                                    syv = getMemberDyn(prog, src, syk.clone(), &mut st)
                                } else {
                                    syv = cloneValue(st.objects[src].props[sy].value)
                                }
                                objSet(&mut st, obj, syk, syv)
                            }
                            sy = sy + 1
                        }
                    }
                } else if prog.objLits[litIdx.index][i].isProtoSetter {
                    // `{ __proto__: v }` SETS the prototype. A value that is
                    // neither an object nor null is ignored — not an error, and
                    // not a property either. This used to define an own
                    // "__proto__" property, so `{ __proto__: null }` produced an
                    // ordinary object with a stray enumerable key, which is what
                    // querystring.parse needs to answer for "__proto__=1".
                    // Same two cases as the `o.__proto__ = v` setter above, and
                    // protoNull is the part that matters: proto = -1 alone means
                    // "the default Object.prototype", not "no prototype".
                    if isNullValue(v) {
                        st.objects[obj].proto = -1
                        st.objects[obj].protoNull = true
                    } else {
                        let np = propertyBagOf(&mut st, v)
                        if np >= 0 {
                            st.objects[obj].proto = np
                            st.objects[obj].protoNull = false
                        }
                    }
                } else {
                    objSet(&mut st, obj, key, v)
                }
                i = i + 1
            }
            popTemp(&mut st)
            return JSValue.Obj(obj)
        }

        Expr.ToStrHole(inner) => {
            let hv = evalExpr(prog, inner, &mut st, scope)
            if st.throwing {
                return JSValue.Undefined
            }
            // String(sym) is legal, `${sym}` is not: the template's implicit
            // ToString has no symbol case, so it throws where String() does not
            return JSValue.Str(toStrArg(prog, hv, &mut st))
        }
        Expr.TemplateStrings(litIdx, rawIdx) => {
            // cooked chunks, plus the parallel un-escaped chunks as `raw`
            let arr = newArray(&mut st)
            pushTemp(&mut st, JSValue.Obj(arr))
            let rawArr = newArray(&mut st)
            pushTemp(&mut st, JSValue.Obj(rawArr))
            var ti: i64 = 0
            while ti < prog.arrLits[litIdx.index].len() {
                let v = evalExpr(prog, prog.arrLits[litIdx.index][ti]!, &mut st, scope)
                arrPush(&mut st, arr, v)
                let rv = evalExpr(prog, prog.arrLits[rawIdx.index][ti]!, &mut st, scope)
                arrPush(&mut st, rawArr, rv)
                ti = ti + 1
            }
            objSet(&mut st, arr, "raw", JSValue.Obj(rawArr))
            popTemp(&mut st)
            popTemp(&mut st)
            return JSValue.Obj(arr)
        }
        Expr.ArrLit(litIdx) => {
            let arr = newArray(&mut st)
            // root the part-built array so a GC while evaluating later elements
            // (an element may be a call) can't reclaim it
            pushTemp(&mut st, JSValue.Obj(arr))
            var i: i64 = 0
            let n = prog.arrLits[litIdx.index].len()
            while i < n {
                match prog.arrLits[litIdx.index][i] {
                    Option.None => {
                    let at = arrLen(st, arr)
                    arrPush(&mut st, arr, JSValue.Undefined)
                    arrMarkHole(&mut st, arr, at)
                    }
                    Option.Some(elemIdx) => {
                    match prog.exprs[elemIdx.index] {
                        Expr.Spread(inner) => {
                        let sv = evalExpr(prog, inner, &mut st, scope)
                        var tmp: Vec<JSValue> = Vec.new()
                        let tmpBase = st.tempRoots.len()
                        rootIfHeap(&mut st, sv)
                        spreadInto(prog, &mut tmp, sv, &mut st)
                        var t: i64 = 0
                        while t < tmp.len() {
                            arrPush(&mut st, arr, cloneValue(tmp[t]))
                            t = t + 1
                        }
                        truncateTemps(&mut st, tmpBase)
                    }
                        _ => {
                            let v = evalExpr(prog, elemIdx, &mut st, scope)
                            arrPush(&mut st, arr, v)
                        }
                    }
                    }
                }
                i = i + 1
            }
            popTemp(&mut st)
            return JSValue.Obj(arr)
        }
        Expr.New(calleeIdx, argsIdx) => {
            return evalNewArm(prog, calleeIdx, argsIdx, &mut st, scope)
        }
        Expr.Update(targetIdx, isInc, isPrefix) => {
            return evalUpdateExpr(prog, targetIdx, isInc, isPrefix, &mut st, scope)
        }
        Expr.CompoundAssign(targetIdx, op, rhsIdx) => {
            let cur = readLValue(prog, targetIdx, &mut st, scope)
            pushTemp(&mut st, cloneValue(cur))
            let rhs = evalExpr(prog, rhsIdx, &mut st, scope)
            popTemp(&mut st)
            // `x += y` is `x = x + y` and must convert the same way: evalBin
            // alone has no interp access, so an object operand never reached
            // ToPrimitive and a symbol never threw — `s += ''` on a symbol
            // silently left the symbol in place where `s + ''` was a TypeError.
            let result = evalBinValues(prog, op, cloneValue(cur), cloneValue(rhs), &mut st)
            if st.throwing {
                return JSValue.Undefined
            }
            writeLValue(prog, targetIdx, &mut st, scope, cloneValue(result))
            return result
        }
        Expr.LogicalAssign(targetIdx, op, rhsIdx) => {
            // short-circuit: read the target, and only evaluate + store the rhs
            // when the operator says an update is due (a ||= b assigns only when a
            // is falsy, &&= only when truthy, ??= only when null/undefined)
            let cur = readLValue(prog, targetIdx, &mut st, scope)
            var doAssign = isNullish(cur)
            if op == "||" {
                doAssign = !truthy(cur)
            } else if op == "&&" {
                doAssign = truthy(cur)
            }
            if !doAssign {
                return cur
            }
            let rhs = evalExpr(prog, rhsIdx, &mut st, scope)
            writeLValue(prog, targetIdx, &mut st, scope, cloneValue(rhs))
            return rhs
        }
        Expr.DestructAssign(patIdx, rhsIdx) => {
            let rhs = evalExpr(prog, rhsIdx, &mut st, scope)
            // `({a} = null)` and `[a] = null` are TypeErrors: both patterns
            // convert their source before reading anything out of it
            if isNullish(rhs) {
                return throwErr(&mut st, "TypeError", "Cannot destructure '" + toStr(rhs) + "' as it is " + toStr(rhs) + ".")
            }
            pushTemp(&mut st, cloneValue(rhs))
            assignPattern(prog, patIdx, cloneValue(rhs), &mut st, scope)
            popTemp(&mut st)
            // the assignment expression evaluates to the whole rhs
            return rhs
        }
        Expr.Cond(c, a, b) => {
            let vc = evalExpr(prog, c, &mut st, scope)
            if truthy(vc) {
                return evalExpr(prog, a, &mut st, scope)
            }
            return evalExpr(prog, b, &mut st, scope)
        }
        Expr.Spread(inner) => {
            // evaluated directly only in odd positions; flattening happens in
            // evalArgs / array literals
            return evalExpr(prog, inner, &mut st, scope)
        }
        Expr.Comma(a, b) => {
            evalExpr(prog, a, &mut st, scope)
            return evalExpr(prog, b, &mut st, scope)
        }
        Expr.RegexLit(pat, flags) => {
            return makeRegex(&mut st, pat.clone(), flags.clone())
        }
        Expr.OptChainRoot(inner) => {
            // scope the short-circuit flag to this chain: a nullish `?.` link
            // anywhere inside makes the whole chain undefined, and nested chains
            // (in args) mustn't leak their own short-circuit outward
            let saved = st.optShort
            st.optShort = false
            let v = evalExpr(prog, inner, &mut st, scope)
            let shorted = st.optShort
            st.optShort = saved
            if shorted {
                return JSValue.Undefined
            }
            return v
        }
        Expr.OptCall(calleeIdx, argsIdx) => {
            // f?.(args): skip the call (result undefined) when f is nullish or an
            // earlier `?.` in the chain already short-circuited
            let calleeVal = evalExpr(prog, calleeIdx, &mut st, scope)
            if st.optShort {
                return JSValue.Undefined
            }
            if isNullish(calleeVal) {
                st.optShort = true
                return JSValue.Undefined
            }
            return callOptional(prog, calleeVal, argsIdx, &mut st, scope)
        }
        Expr.OptIndex(objIdx, keyIdx) => {
            let ov = evalExpr(prog, objIdx, &mut st, scope)
            if st.optShort {
                return JSValue.Undefined
            }
            if isNullish(ov) {
                st.optShort = true
                return JSValue.Undefined
            }
            pushTemp(&mut st, cloneValue(ov))
            let kv = evalExpr(prog, keyIdx, &mut st, scope)
            popTemp(&mut st)
            let key = toPropertyKey(st, kv)
            let o = objHandle(ov)
            if o >= 0 {
                return getMemberDyn(prog, o, key, &mut st)
            }
            // non-nullish function/native base is a property carrier too
            match ov {
                JSValue.Func(_fIdx, _fe, _fo) => {
                    let statics = propertyBagOf(&mut st, ov)
                    return getMemberDyn(prog, statics, key, &mut st)
                }
                JSValue.Native(nid) => {
                    return getMember(st, getNativeProps(&mut st, nid), key)
                }
                _ => {
                    return JSValue.Undefined
                }
            }
        }
        Expr.OptMember(objIdx, name) => {
            let ov = evalExpr(prog, objIdx, &mut st, scope)
            if st.optShort {
                return JSValue.Undefined
            }
            if isNullish(ov) {
                st.optShort = true
                return JSValue.Undefined
            }
            match ov {
                JSValue.Obj(o) => {
                    return getMemberDyn(prog, o, name, &mut st)
                }
                JSValue.Number(_nv) => {
                    if name == "__proto__" {
                        let npp = primitiveProtoHandle(&mut st, ov)
                        if npp >= 0 {
                            return JSValue.Obj(npp)
                        }
                    }
                    // number primitives answer these by dispatch; without this a
                    // read yields undefined, which breaks feature detection
                    if isPrimitiveMethodName(name) {
                        return makeBoundMethod(&mut st, cloneValue(ov), name.clone())
                    }
                    return JSValue.Undefined
                }
                JSValue.Bool(_bv) => {
                    if name == "__proto__" {
                        let bpp = primitiveProtoHandle(&mut st, ov)
                        if bpp >= 0 {
                            return JSValue.Obj(bpp)
                        }
                    }
                    if isPrimitiveMethodName(name) {
                        return makeBoundMethod(&mut st, cloneValue(ov), name.clone())
                    }
                    return JSValue.Undefined
                }
                JSValue.Str(s) => {
                    if name == "__proto__" {
                        let sp = primitiveProtoHandle(&mut st, JSValue.Str(s.clone()))
                        if sp >= 0 {
                            return JSValue.Obj(sp)
                        }
                    }
                    return stringPrimitiveMember(&mut st, s, name)
                }
                JSValue.Sym(sid) => {
                    return symbolPrimitiveMember(&mut st, sid, name)
                }
                JSValue.Func(_fIdx, _fe, _fo) => {
                    // a non-nullish function base reads like `.` does: a function
                    // is a property carrier (fn?._def, fn?.name). This was the
                    // missing case — @trpc's `procedure?._def.type`.
                    return memberOfValue(prog, cloneValue(ov), name, &mut st)
                }
                JSValue.Native(nid) => {
                    let bag = getNativeProps(&mut st, nid)
                    if name == "name" && objOwnIndex(st, bag, "name") < 0 {
                        let nn = nativeCtorName(nid)
                        if nn.len() > 0 {
                            return JSValue.Str(nn)
                        }
                    }
                    return getMember(st, bag, name)
                }
                _ => {
                    return JSValue.Undefined
                }
            }
        }
        Expr.FuncExpr(f) => {
            return makeClosure(&mut st, f, scope)
        }
    }
}

// Spread an array value's elements into `out` (a no-op for non-arrays).
// Spread any iterable: the built-ins directly, and anything carrying
// [Symbol.iterator] by driving its next(). Driving calls back into user code, so
// this needs the program and a mutable interpreter — which is why it is not the
// immutable helper it once was.
// `out` is a Milo Vec the collector cannot see, and every iterator step below
// runs user code: values already collected into it were freed and their slots
// reused (a URLSearchParams spread came back as a circular structure under
// every-allocation collection). Each pushed heap value is temp-rooted until
// the spread completes.
// The roots stay pushed on return, because the caller still holds `out`
// while it allocates the array or arguments that will own the values: the
// caller records st.tempRoots.len() before the call and truncates once the
// values are reachable from something the collector can see.
fn spreadInto(prog: &Prog, out: &mut Vec<JSValue>, v: &JSValue, st: &mut Interp) {
    spreadIntoArms(prog, &mut out, v, &mut st)
}

fn spreadIntoArms(prog: &Prog, out: &mut Vec<JSValue>, v: &JSValue, st: &mut Interp) {
    let h = objHandle(v)
    // a String wrapper iterates as its string does, by code point. Its index
    // properties would make an array-like fallback plausible, but the spec
    // reaches String.prototype[@@iterator] through the chain, and that yields
    // whole characters rather than UTF-16 units.
    // ...but an OWN Symbol.iterator on the wrapper overrides that. `Object("s")`
    // with its own iterator must yield what the override yields, not the
    // string's characters.
    if h >= 0 && isWrapperObj(st, h) && objOwnIndex(st, h, symIteratorKey()) < 0 {
        if let JSValue.Str(bs) = boxedPrimitive(st, h) {
            for cp in strCodePoints(bs) {
                out.push(JSValue.Str(cp.clone()))
            }
            return
        }
    }
    // typed arrays are iterable by element
    if h >= 0 && st.objExtras[st.objects[h].extra].taBuf >= 0 && !st.objects[h].isDataView {
        var i: i64 = 0
        while i < st.objExtras[st.objects[h].extra].taLen {
            out.push(taElemValue(st, h, i))
            i = i + 1
        }
        return
    }
    // a generator drives through genNext (its `next` is native, not a property)
    if h >= 0 && st.objects[h].isGenerator {
        var guard: i64 = 0
        while !st.throwing && guard < 100000000 {
            guard = guard + 1
            var nA: Vec<JSValue> = Vec.new()
            let step = genNext(h, nA, &mut st)
            let sh = objHandle(step)
            if sh < 0 || truthy(getMemberDyn(prog, sh, "done", &mut st)) || st.throwing {
                guard = 100000000
            } else {
                let gv = getMemberDyn(prog, sh, "value", &mut st)
                rootIfHeap(&mut st, gv)
                out.push(gv)
                if st.throwing {
                    guard = 100000000
                }
            }
        }
        return
    }
    // a Map spreads to freshly built [key, value] pairs, which needs allocation
    if h >= 0 && st.objects[h].isMap {
        var mi: i64 = 0
        while mi < st.objExtras[st.objects[h].extra].mapKeys.len() {
            let pair = newArray(&mut st)
            pushTemp(&mut st, JSValue.Obj(pair))
            arrPush(&mut st, pair, cloneValue(st.objExtras[st.objects[h].extra].mapKeys[mi]))
            arrPush(&mut st, pair, cloneValue(st.objExtras[st.objects[h].extra].mapVals[mi]))
            popTemp(&mut st)
            out.push(JSValue.Obj(pair))
            mi = mi + 1
        }
        return
    }
    if h >= 0 && !st.objects[h].isArray && !st.objects[h].isSet {
        // getMemberDyn, not getMember: a Proxy's Symbol.iterator lives behind its
        // `get` trap, and reading it raw found nothing, so spreading or for-of'ing
        // any proxy threw "not iterable" -- including a proxy of a plain array.
        let itFn = getMemberDyn(prog, h, symIteratorKey(), &mut st)
        if st.throwing {
            return
        }
        if isCallableIn(st, itFn) {
            var noArgs: Vec<JSValue> = Vec.new()
            let iter = callValue(prog, itFn, noArgs, cloneValue(v), &mut st)
            pushTemp(&mut st, cloneValue(iter))
            let ih = objHandle(iter)
            // `*[Symbol.iterator]() {}` hands back a GENERATOR, whose `next` is a
            // native method rather than a stored property, so the getMember below
            // finds nothing and the spread comes out empty. The generator branch
            // at the top of this function is exactly the driver it needs.
            if ih >= 0 && st.objects[ih].isGenerator && !st.throwing {
                spreadInto(prog, &mut out, JSValue.Obj(ih), &mut st)
                popTemp(&mut st)
                return
            }
            var guard: i64 = 0
            while ih >= 0 && !st.throwing && guard < 100000000 {
                // guard was never incremented here, so this loop had no runaway
                // protection at all
                guard = guard + 1
                let nextFn = getMember(st, ih, "next")
                if !isCallableIn(st, nextFn) {
                    // a Symbol.iterator that hands back something without a
                    // callable `next` is a TypeError, not an empty result
                    st.throwing = true
                    st.thrownValue = makeError(&mut st, "TypeError", "iterator.next is not a function")
                    guard = 100000000
                } else {
                    var nArgs: Vec<JSValue> = Vec.new()
                    let step = callValue(prog, nextFn, nArgs, cloneValue(iter), &mut st)
                    let sh = objHandle(step)
                    // getMemberDyn, not getMember: an iterator result may expose
                    // `done`/`value` as GETTERS, and the plain read never invoked
                    // them — a getter that throws (test262's
                    // set-iterator-value-failure) left done reading false for
                    // ever and the loop spun until the process was killed
                    if sh < 0 && !st.throwing {
                        // next() must return an OBJECT; anything else is a
                        // TypeError rather than a quiet end of iteration
                        st.throwing = true
                        st.thrownValue = makeError(&mut st, "TypeError", "Iterator result " + toStr(step) + " is not an object")
                        guard = 100000000
                    } else if sh < 0 || truthy(getMemberDyn(prog, sh, "done", &mut st)) || st.throwing {
                        guard = 100000000
                    } else {
                        let iv = getMemberDyn(prog, sh, "value", &mut st)
                        rootIfHeap(&mut st, iv)
                        out.push(iv)
                        if st.throwing {
                            guard = 100000000
                        }
                    }
                }
            }
            popTemp(&mut st)
            return
        }
    }
    // Anything left is NOT iterable, and spreading it is a TypeError rather than
    // a silent no-op. `[...5]`, `[...{}]` and `[...null]` all throw in JS, and
    // array DESTRUCTURING is desugared to `[...expr]`, so `const [a] = 5`
    // answering undefined was the same defect seen from the other end.
    // a FUNCTION carrying a Symbol.iterator is iterable: functions are not Objs
    // in this value model, so the iterator walk above never saw them
    if funcHandle(v) >= 0 {
        let fbag = propertyBagOf(&mut st, v)
        if fbag >= 0 {
            let fit = getMember(st, fbag, symIteratorKey())
            if isCallableIn(st, fit) {
                var fNoArgs: Vec<JSValue> = Vec.new()
                let fIter = callValue(prog, fit, fNoArgs, cloneValue(v), &mut st)
                if !st.throwing {
                    spreadInto(prog, &mut out, fIter, &mut st)
                }
                return
            }
        }
    }
    if !isSpreadable(st, v) {
        st.throwing = true
        st.thrownValue = makeError(&mut st, "TypeError", spreadErrText(v))
        return
    }
    spreadBuiltin(prog, &mut out, v, &mut st)
}

// What spreadBuiltin can actually walk, plus the objects the iterator path above
// already returned for.
fn isSpreadable(st: &Interp, v: &JSValue): bool {
    match v {
        JSValue.Str(_s) => {
            return true
        }
        JSValue.Obj(o) => {
            return st.objects[o].isArray || st.objects[o].isSet || st.objects[o].isMap
        }
        _ => {
            return false
        }
    }
}

fn spreadErrText(v: &JSValue): string {
    match v {
        JSValue.Undefined => {
            return "undefined is not iterable"
        }
        JSValue.Null => {
            return "null is not iterable"
        }
        _ => {
            return toStr(v) + " is not iterable"
        }
    }
}

// A rooted array holding everything `v` iterates, or `v` unchanged when it is not
// a user iterable. The index-reading consumers (array destructuring, the Map/Set
// constructors) answer undefined for an object that has only [Symbol.iterator]
// and no indexed properties, so they materialize through here first.
//
// Divergence: the spec pulls exactly as many elements as the consumer needs, so
// an infinite iterator destructures fine there and spins here. Every eager path
// in this engine has that shape today (Array.from, spread); a lazy pull needs an
// element-count-limited driver, which spreadInto has no argument for.
fn iterableToArray(prog: &Prog, v: &JSValue, st: &mut Interp): JSValue {
    // A STRING is iterable, by code point, and this returned it unchanged because
    // it is not an object: `new Set("aab")` came out empty where node gives
    // ["a","b"]. spreadInto already knows how to walk one, which is why `[..."ab"]`
    // worked while the Set constructor did not.
    if let JSValue.Str(sv) = v {
        var chars: Vec<JSValue> = Vec.new()
        let charsBase = st.tempRoots.len()
        spreadInto(prog, &mut chars, cloneValue(v), &mut st)
        let sarr = newArray(&mut st)
        pushTemp(&mut st, JSValue.Obj(sarr))
        var ci: i64 = 0
        while ci < chars.len() {
            arrPush(&mut st, sarr, cloneValue(chars[ci]))
            ci = ci + 1
        }
        truncateTemps(&mut st, charsBase)
        return JSValue.Obj(sarr)
    }
    let h = objHandle(v)
    if h < 0 || st.objects[h].isArray {
        return cloneValue(v)
    }
    let drivable = st.objects[h].isGenerator || st.objects[h].isMap || st.objects[h].isSet
        || st.objects[h].isProxy
        || isCallableIn(st, getMember(st, h, symIteratorKey()))
    if !drivable {
        return cloneValue(v)
    }
    var items: Vec<JSValue> = Vec.new()
    let itemsBase = st.tempRoots.len()
    spreadInto(prog, &mut items, cloneValue(v), &mut st)
    let arr = newArray(&mut st)
    pushTemp(&mut st, JSValue.Obj(arr))
    var i: i64 = 0
    while i < items.len() {
        arrPush(&mut st, arr, cloneValue(items[i]))
        i = i + 1
    }
    truncateTemps(&mut st, itemsBase)
    return JSValue.Obj(arr)
}

fn spreadBuiltin(prog: &Prog, out: &mut Vec<JSValue>, v: &JSValue, st: &mut Interp) {
    match v {
        JSValue.Obj(o) => {
            if st.objects[o].isArray {
                var k: i64 = 0
                let m = arrLen(st, o)
                while k < m {
                    out.push(arrGetDyn(prog, o, k, &mut st))
                    k = k + 1
                }
            } else if st.objects[o].isSet {
                var k: i64 = 0
                while k < st.objExtras[st.objects[o].extra].mapKeys.len() {
                    out.push(cloneValue(st.objExtras[st.objects[o].extra].mapKeys[k]))
                    k = k + 1
                }
            }
        }
        JSValue.Str(s) => {
            // [..."café"] is ["c","a","f","é"] — code points, not UTF-8 bytes
            for cp in strCodePoints(s) {
                out.push(JSValue.Str(cp.clone()))
            }
        }
        _ => {
        }
    }
}

// `out` is a plain Milo local, invisible to the collector, but evaluating a later
// argument can run user code and therefore collect — so each finished argument is
// temp-rooted until the whole list is built. Without this, f([1,2], g()) can see
// the array swept and its slot reused while g() runs.
fn evalArgs(prog: &Prog, argsIdx: ArgListId, st: &mut Interp, scope: i64): Vec<JSValue> {
    var out: Vec<JSValue> = Vec.new()
    var j: i64 = 0
    let n = prog.argLists[argsIdx.index].len()
    while j < n {
        let eIdx = prog.argLists[argsIdx.index][j]
        match prog.exprs[eIdx.index] {
            Expr.Spread(inner) => {
                let v = evalExpr(prog, inner, &mut st, scope)
                rootIfHeap(&mut st, v)
                let before = out.len()
                spreadInto(prog, &mut out, v, &mut st)
                // the elements an iterator produced are reachable from nothing
                // but `out` once the source is done with
                var si = before
                while si < out.len() {
                    rootIfHeap(&mut st, out[si])
                    si = si + 1
                }
            }
            _ => {
                let v = evalExpr(prog, eIdx, &mut st, scope)
                rootIfHeap(&mut st, v)
                out.push(v)
            }
        }
        j = j + 1
    }
    // The roots stay PUSHED. A native holds `out` as a Milo Vec the collector
    // cannot see, and runs user code (a proxy trap, a callback, a getter) that
    // allocates; releasing here handed an argument's slot to the trap's own
    // argument list. The call boundary (callMember, evalCall, evalNewArm,
    // OptCall) records the temp-stack depth on entry and truncates back to it
    // on exit, which is also what makes every throw path inside the arms
    // balanced without each one popping.
    return out
}

// Root `v` only if the collector could free something through it: an object
// handle, a closure's scope, or a resolver's promise (the arms of markValue).
// A string or number is Milo-owned, and cloning a string just to root nothing
// cost strRead 20% when every receiver was pushed.
fn rootIfHeap(st: &mut Interp, v: &JSValue) {
    match v {
        JSValue.Obj(_o) => {
            pushTemp(&mut st, cloneValue(v))
        }
        JSValue.Func(_f, _e, _fo) => {
            pushTemp(&mut st, cloneValue(v))
        }
        JSValue.Native(_n) => {
            pushTemp(&mut st, cloneValue(v))
        }
        _ => {
        }
    }
}

// Drop every temp root pushed since `base`: the scoped-root discipline of the
// call boundaries, see evalArgs.
fn truncateTemps(st: &mut Interp, base: i64) {
    while st.tempRoots.len() > base {
        popTemp(&mut st)
    }
}

fn spaces(n: i64): string {
    var s = ""
    var i: i64 = 0
    while i < n {
        s = s + " "
        i = i + 1
    }
    return s
}

// console.log's value rendering, reproducing node's `util.inspect` defaults
// (depth 2, breakLength 80, compact 3) rather than bun's. The algorithm is
// node's: render every entry, then decide layout — one line when the entries
// fit inside breakLength, otherwise one per line at the parent indent + 2 with
// NO trailing comma. Arrays of more than six entries are first laid out in
// columns by inspectGroupArray, exactly as node's groupArrayElements does.
//
// Why mirror node this closely: every .expected in tests/ is a byte-exact node
// capture, so any divergence here is a divergence in 17 fixtures at once.
fn inspBreakLength(): i64 {
    return 80
}


fn mjInspectHexUpper(v: i64): u8 {
    if v < 10 {
        return ('0' as i64 + v) as u8
    }
    return ('A' as i64 + (v - 10)) as u8
}

// node's strEscape: a nested string is single-quoted, switching to double when
// it contains a single quote and no double, and to a backtick when it contains
// both. Control characters become \n / \t / \r / \b / \f or \xNN (upper-case
// hex, as node's escape table spells it).
fn inspectQuoteStr(s: &string): string {
    var hasSingle = false
    var hasDouble = false
    var hasBack = false
    var i: i64 = 0
    while i < s.len() {
        let c = s[i]
        if c == 39 as u8 {
            hasSingle = true
        }
        if c == 34 as u8 {
            hasDouble = true
        }
        if c == 96 as u8 {
            hasBack = true
        }
        i = i + 1
    }
    var q = 39 as u8
    if hasSingle {
        if !hasDouble {
            q = 34 as u8
        } else if !hasBack {
            q = 96 as u8
        }
    }
    var out = String.withCapacity(s.len() + 2)
    out.push(q)
    var k: i64 = 0
    while k < s.len() {
        let c = s[k]
        if c == q || c == 92 as u8 {
            out.push(92 as u8)
            out.push(c)
        } else if c == 10 as u8 {
            out.push(92 as u8)
            out.push('n')
        } else if c == 9 as u8 {
            out.push(92 as u8)
            out.push('t')
        } else if c == 13 as u8 {
            out.push(92 as u8)
            out.push('r')
        } else if c == 8 as u8 {
            out.push(92 as u8)
            out.push('b')
        } else if c == 12 as u8 {
            out.push(92 as u8)
            out.push('f')
        } else if c < 32 as u8 || c == 127 as u8 {
            out.push(92 as u8)
            out.push('x')
            out.push(mjInspectHexUpper(((c as i64) >> 4) & 15))
            out.push(mjInspectHexUpper((c as i64) & 15))
        } else {
            out.push(c)
        }
        k = k + 1
    }
    out.push(q)
    return out
}

// node leaves a key bare only when it matches /^[a-zA-Z_][a-zA-Z_0-9]*$/ — note
// that `$` is NOT in that set, so `{ $x: 1 }` prints as `{ '$x': 1 }`.
fn inspectKeyStr(st: &Interp, k: &string): string {
    // node 25 prints a symbol key bare, `{ Symbol(a): 1 }`, with no brackets
    let sid = symIdOfKey(k)
    if sid >= 0 {
        return symbolDisplay(st, sid)
    }
    var ok = k.len() > 0
    var i: i64 = 0
    while i < k.len() {
        let c = k[i]
        let alpha = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == 95 as u8
        let digit = c >= '0' && c <= '9'
        if !alpha && !(digit && i > 0) {
            ok = false
        }
        i = i + 1
    }
    if ok {
        return k.clone()
    }
    return inspectQuoteStr(k)
}

fn strHasNewline(s: &string): bool {
    var i: i64 = 0
    while i < s.len() {
        if s[i] == 10 as u8 {
            return true
        }
        i = i + 1
    }
    return false
}

fn mjPadLeft(s: &string, width: i64): string {
    if s.len() >= width {
        return s.clone()
    }
    return spaces(width - s.len()) + s
}

fn mjPadRight(s: &string, width: i64): string {
    if s.len() >= width {
        return s.clone()
    }
    return s + spaces(width - s.len())
}

// node's reduceToSingleString. `base` is the prefix an exotic object carries
// ("Map(1)", "Set(2)"); `grouped` says the entries already went through the
// column layout, which node treats as a hard "do not put this on one line"
// (its `entries === output.length` guard).
fn inspectJoin(parts: &Vec<string>, open: &string, close: &string, base: &string, indentLvl: i64, grouped: bool): string {
    var pre = ""
    if base.len() > 0 {
        pre = base + " "
    }
    if parts.len() == 0 {
        return pre + open + close
    }
    let n = parts.len()
    // node: start = entries + indentationLvl + braces[0].length + base.length + 10
    let start = n + indentLvl + open.len() + base.len() + 10
    var total = n + start
    var fits = !grouped
    if total + n > inspBreakLength() {
        fits = false
    }
    var i: i64 = 0
    while i < n {
        total = total + parts[i].len()
        if total > inspBreakLength() {
            fits = false
        }
        if strHasNewline(parts[i]) {
            fits = false
        }
        i = i + 1
    }
    if fits {
        var out = pre + open + " "
        i = 0
        while i < n {
            if i > 0 {
                out = out + ", "
            }
            out = out + parts[i]
            i = i + 1
        }
        return out + " " + close
    }
    let ind = spaces(indentLvl)
    var out = pre + open + "\n"
    i = 0
    while i < n {
        out = out + ind + "  " + parts[i]
        // node emits no trailing comma on the last entry
        if i + 1 < n {
            out = out + ","
        }
        out = out + "\n"
        i = i + 1
    }
    return out + ind + close
}

// node's groupArrayElements: an array of more than six entries is laid out in
// columns rather than one-per-line. Returns the original parts unchanged when
// the shape does not qualify (entries too wide, or too uneven in width).
// `allNumeric` selects right-alignment, as node does for number/bigint arrays.
fn inspectGroupArray(parts: &Vec<string>, indentLvl: i64, allNumeric: bool): Vec<string> {
    let outputLength = parts.len()
    let separatorSpace: i64 = 2
    var totalLength: i64 = 0
    var maxLength: i64 = 0
    var dataLen: Vec<i64> = Vec.new()
    var i: i64 = 0
    while i < outputLength {
        let len = parts[i].len()
        dataLen.push(len)
        totalLength = totalLength + len + separatorSpace
        if maxLength < len {
            maxLength = len
        }
        i = i + 1
    }
    let actualMax = maxLength + separatorSpace
    // at least three entries must fit side by side, and one entry must not
    // dwarf the rest — otherwise the padding between short entries is enormous
    let evenEnough = ((totalLength as f64) / (actualMax as f64)) > 5.0 || maxLength <= 6
    if !(actualMax * 3 + indentLvl < inspBreakLength() && evenEnough) {
        var same: Vec<string> = Vec.new()
        var c: i64 = 0
        while c < outputLength {
            same.push(parts[c].clone())
            c = c + 1
        }
        return same
    }
    let approxCharHeights = 2.5
    let averageBias = Math.sqrt((actualMax as f64) - (totalLength as f64) / (outputLength as f64))
    var biasedMax = (actualMax as f64) - 3.0 - averageBias
    if biasedMax < 1.0 {
        biasedMax = 1.0
    }
    var columns = Math.round(Math.sqrt(approxCharHeights * biasedMax * (outputLength as f64)) / biasedMax) as i64
    let byWidth = (inspBreakLength() - indentLvl) / actualMax
    if columns > byWidth {
        columns = byWidth
    }
    // node caps at ctx.compact * 4 (12) and at 15
    if columns > 12 {
        columns = 12
    }
    if columns > 15 {
        columns = 15
    }
    if columns <= 1 {
        var same: Vec<string> = Vec.new()
        var c: i64 = 0
        while c < outputLength {
            same.push(parts[c].clone())
            c = c + 1
        }
        return same
    }
    var maxLineLength: Vec<i64> = Vec.new()
    var col: i64 = 0
    while col < columns {
        var lineLength: i64 = 0
        var j = col
        while j < outputLength {
            if dataLen[j] > lineLength {
                lineLength = dataLen[j]
            }
            j = j + columns
        }
        maxLineLength.push(lineLength + separatorSpace)
        col = col + 1
    }
    var rows: Vec<string> = Vec.new()
    var r: i64 = 0
    while r < outputLength {
        var maxJ = r + columns
        if maxJ > outputLength {
            maxJ = outputLength
        }
        var str = ""
        var j = r
        while j < maxJ - 1 {
            let width = maxLineLength[j - r]
            let cell = parts[j] + ", "
            if allNumeric {
                str = str + mjPadLeft(cell, width)
            } else {
                str = str + mjPadRight(cell, width)
            }
            j = j + 1
        }
        if allNumeric {
            str = str + mjPadLeft(parts[j], maxLineLength[j - r] - separatorSpace)
        } else {
            str = str + parts[j]
        }
        rows.push(str)
        r = r + columns
    }
    return rows
}

// A number renders through toStr except for -0, which JS stringifies as "0" but
// node's inspect shows as -0.
fn inspectNum(n: f64): string {
    if n == 0.0 && (1.0 / n) < 0.0 {
        return "-0"
    }
    return toStr(JSValue.Number(n))
}

fn inspectFuncLabel(name: &string): string {
    if name.len() == 0 {
        return "[Function (anonymous)]"
    }
    return "[Function: " + name + "]"
}

// node distinguishes a class from a function: `[class Foo]`, `[class (anonymous)]`.
fn inspectFuncLabelAt(fidx: i64): string {
    if fidx >= 0 && fidx < gProg.funcs.len() && gProg.funcs[fidx].isClassCtor {
        if gProg.funcs[fidx].name.len() == 0 {
            return "[class (anonymous)]"
        }
        return "[class " + gProg.funcs[fidx].name.clone() + "]"
    }
    if fidx >= 0 && fidx < gProg.funcs.len() {
        return inspectFuncLabel(gProg.funcs[fidx].name)
    }
    return "[Function (anonymous)]"
}

// A value as it appears INSIDE a container: strings are quoted, unlike the
// top-level form (see inspectTop).
// Pass one of the cycle marking: record every object reachable from `o` that is
// referenced by something BELOW it, i.e. that closes a cycle. Order of discovery
// is the order node numbers them, so the index here plus one is the *N.
fn findCircularTargets(st: &Interp, o: i64, stack: &mut Vec<i64>, targets: &mut Vec<i64>) {
    var si: i64 = 0
    while si < stack.len() {
        if stack[si] == o {
            var ti: i64 = 0
            var known = false
            while ti < targets.len() {
                if targets[ti] == o {
                    known = true
                }
                ti = ti + 1
            }
            if !known {
                targets.push(o)
            }
            return
        }
        si = si + 1
    }
    stack.push(o)
    var ei: i64 = 0
    while ei < st.objects[o].elems.len() {
        let ev = cloneValue(st.objects[o].elems[ei])
        let eh = objHandle(ev)
        if eh >= 0 {
            findCircularTargets(st, eh, &mut stack, &mut targets)
        }
        ei = ei + 1
    }
    var pi: i64 = 0
    while pi < st.objects[o].props.len() {
        if st.objects[o].props[pi].enumerable {
            let pv = cloneValue(st.objects[o].props[pi].value)
            let ph = objHandle(pv)
            if ph >= 0 {
                findCircularTargets(st, ph, &mut stack, &mut targets)
            }
        }
        pi = pi + 1
    }
    // Map/Set entries are NOT props or elems: they live in the side table, so a
    // walk over props alone missed `m.set("k", m)` entirely and the back edge
    // printed as [Circular *0] with no matching <ref *1>.
    if st.objects[o].isMap || st.objects[o].isSet {
        var mi: i64 = 0
        while mi < st.objExtras[st.objects[o].extra].mapKeys.len() {
            let kh = objHandle(st.objExtras[st.objects[o].extra].mapKeys[mi])
            if kh >= 0 {
                findCircularTargets(st, kh, &mut stack, &mut targets)
            }
            if st.objects[o].isMap {
                let vh2 = objHandle(st.objExtras[st.objects[o].extra].mapVals[mi])
                if vh2 >= 0 {
                    findCircularTargets(st, vh2, &mut stack, &mut targets)
                }
            }
            mi = mi + 1
        }
    }
    let _popped = stack.pop()
}

// The 1-based marker for `o`, or 0 when it is not a cycle target.
fn circularMarkOf(targets: &Vec<i64>, o: i64): i64 {
    var i: i64 = 0
    while i < targets.len() {
        if targets[i] == o {
            return i + 1
        }
        i = i + 1
    }
    return 0
}

fn inspectInner(st: &Interp, v: &JSValue, depth: i64, indentLvl: i64, stack: &mut Vec<i64>, targets: &Vec<i64>): string {
    match v {
        JSValue.Str(s) => {
            return inspectQuoteStr(s)
        }
        JSValue.Sym(id) => {
            return symbolDisplay(st, id)
        }
        JSValue.Number(n) => {
            return inspectNum(n)
        }
        JSValue.BigInt(s) => {
            // console.log shows a BigInt with the trailing `n` (String() does not)
            return s + "n"
        }
        JSValue.Func(fidx, _env, _fo) => {
            return inspectFuncLabelAt(fidx)
        }
        JSValue.Obj(o) => {
            return inspectObj(st, o, depth, indentLvl, &mut stack, targets)
        }
        _ => {
            return toStr(v)
        }
    }
}

fn inspectArr(st: &Interp, o: i64, depth: i64, indentLvl: i64, stack: &mut Vec<i64>, targets: &Vec<i64>): string {
    if depth > st.inspectMaxDepth {
        return "[Array]"
    }
    // arrLen, not elems.len(): an index stored past the element vector lives in
    // the property table (`const a = [1]; a[3] = 4`), and stopping at the vector
    // printed `[ 1 ]` for an array whose length is 4.
    let n = arrLen(st, o)
    if n == 0 {
        return "[]"
    }
    var parts: Vec<string> = Vec.new()
    var allNumeric = true
    var i: i64 = 0
    while i < n {
        if arrIsHole(st, o, i) {
            // node collapses a run of holes into one "<N empty items>" entry
            // (singular for a run of one), rather than printing undefined
            var run: i64 = 0
            while i + run < n && arrIsHole(st, o, i + run) {
                run = run + 1
            }
            var unit = " empty items>"
            if run == 1 {
                unit = " empty item>"
            }
            parts.push("<" + run.toString() + unit)
            allNumeric = false
            i = i + run
            continue
        }
        // a separate clone for the match: matching moves the value, and the
        // element is still needed for the render below
        // arrGet, not elems[i]: an index past the element vector is a property
        // (arrIsHole already knows to look there), and indexing the vector
        // directly aborted the process on `const a = [1]; a[3] = 4`.
        let probe = arrGet(st, o, i)
        match probe {
            JSValue.Number(_x) => {
            }
            JSValue.BigInt(_b) => {
            }
            _ => {
                allNumeric = false
            }
        }
        let v = arrGet(st, o, i)
        parts.push(inspectInner(st, v, depth + 1, indentLvl + 2, &mut stack, targets))
        i = i + 1
    }
    var grouped = false
    if n > 6 {
        let rows = inspectGroupArray(parts, indentLvl, allNumeric)
        if rows.len() != parts.len() {
            grouped = true
            parts = rows
        }
    }
    return inspectJoin(parts, "[", "]", "", indentLvl, grouped)
}

fn objIsoOrTag(st: &Interp, o: i64): string {
    return isoFromMillis(st.objExtras[st.objects[o].extra].dateMs)
}

fn inspectMapSet(st: &Interp, o: i64, depth: i64, indentLvl: i64, stack: &mut Vec<i64>, targets: &Vec<i64>): string {
    let keys = st.objExtras[st.objects[o].extra].mapKeys.len()
    var base = "Set(" + keys.toString() + ")"
    if st.objects[o].isMap {
        base = "Map(" + keys.toString() + ")"
    }
    if depth > st.inspectMaxDepth {
        if st.objects[o].isMap {
            return "[Map]"
        }
        return "[Set]"
    }
    var parts: Vec<string> = Vec.new()
    var i: i64 = 0
    while i < keys {
        let k = cloneValue(st.objExtras[st.objects[o].extra].mapKeys[i])
        if st.objects[o].isMap {
            let val = cloneValue(st.objExtras[st.objects[o].extra].mapVals[i])
            parts.push(inspectInner(st, k, depth + 1, indentLvl + 2, &mut stack, targets) + " => " + inspectInner(st, val, depth + 1, indentLvl + 2, &mut stack, targets))
        } else {
            parts.push(inspectInner(st, k, depth + 1, indentLvl + 2, &mut stack, targets))
        }
        i = i + 1
    }
    return inspectJoin(parts, "{", "}", base, indentLvl, false)
}

// Wrapper so the body below can keep its several return paths: the stack has to be
// popped exactly once however it leaves. A back edge prints `[Circular *N]`; the
// first (outermost) writing of a cycle target carries the `<ref *N>` prefix.
fn inspectObj(st: &Interp, o: i64, depth: i64, indentLvl: i64, stack: &mut Vec<i64>, targets: &Vec<i64>): string {
    var si: i64 = 0
    while si < stack.len() {
        if stack[si] == o {
            return "[Circular *" + i64ToStr(circularMarkOf(targets, o)) + "]"
        }
        si = si + 1
    }
    stack.push(o)
    let body = inspectObjBody(st, o, depth, indentLvl, &mut stack, targets)
    let _popped = stack.pop()
    let mark = circularMarkOf(targets, o)
    if mark > 0 {
        return "<ref *" + i64ToStr(mark) + "> " + body
    }
    return body
}

fn inspectObjBody(st: &Interp, o: i64, depth: i64, indentLvl: i64, stack: &mut Vec<i64>, targets: &Vec<i64>): string {
    if st.objects[o].isArray {
        return inspectArr(st, o, depth, indentLvl, &mut stack, targets)
    }
    // an Error prints as "Name: message [\n stack]", like node's console
    if st.objects[o].isError {
        let ename = toStr(getMember(st, o, "name"))
        let emsg = toStr(getMember(st, o, "message"))
        let estack = getMember(st, o, "stack")
        var head = ename.clone()
        if emsg.len() > 0 {
            head = ename + ": " + emsg
        }
        // console.log(error) prints the stack, which already begins with the
        // "Name: message" header (node appends the trace after it); fall back to
        // the header when there is no stack
        if let JSValue.Str(sv) = estack {
            if sv.len() > 0 {
                return sv
            }
        }
        return head
    }
    if st.objects[o].isDate {
        return objIsoOrTag(st, o)
    }
    // a RegExp shows as its literal, not as its property bag
    if st.objExtras[st.objects[o].extra].regexId >= 0 {
        return "/" + toStr(objGet(st, o, "source")) + "/" + toStr(objGet(st, o, "flags"))
    }
    if st.objects[o].isMap || st.objects[o].isSet {
        return inspectMapSet(st, o, depth, indentLvl, &mut stack, targets)
    }
    // node cannot enumerate a weak collection either, so it prints no entries
    let wk = st.objExtras[st.objects[o].extra].weakKind
    if wk != 0 {
        var wname = "WeakSet"
        if wk == 1 {
            wname = "WeakMap"
        }
        if depth > st.inspectMaxDepth {
            return "[" + wname + "]"
        }
        return wname + " { <items unknown> }"
    }
    if st.objects[o].isFunctionLike {
        return inspectFuncLabel(toStr(objGet(st, o, "name")))
    }
    // A typed array prints its kind, its length and its elements:
    // `Uint8Array(3) [ 1, 2, 3 ]`. Without this it fell through to the property
    // walk below, which sees nothing (the elements are in the buffer) and printed
    // `{}` -- for the value a debugger prints most often.
    if st.objExtras[st.objects[o].extra].taBuf >= 0 && !st.objects[o].isDataView {
        let tkind = st.objExtras[st.objects[o].extra].taKind
        let tlen = taCurrentLen(st, o)
        if depth > st.inspectMaxDepth {
            return "[" + taName(tkind) + "]"
        }
        var tparts: Vec<string> = Vec.new()
        var ti: i64 = 0
        while ti < tlen {
            tparts.push(inspectInner(st, taElemValue(st, o, ti), depth + 1, indentLvl + 2, &mut stack, targets))
            ti = ti + 1
        }
        let thead = taName(tkind) + "(" + i64ToStr(tlen) + ") "
        if tparts.len() == 0 {
            return thead + "[]"
        }
        return thead + inspectJoin(tparts, "[", "]", "", indentLvl, false)
    }
    if st.objects[o].isArrayBuffer {
        let bytes = st.objExtras[st.objects[o].extra].bytes.len()
        var hex = ""
        var bi: i64 = 0
        while bi < bytes {
            if bi > 0 {
                hex = hex + " "
            }
            let bv = st.objExtras[st.objects[o].extra].bytes[bi]
            hex.push(mjInspectHexUpper((bv as i64) / 16))
            hex.push(mjInspectHexUpper((bv as i64) % 16))
            bi = bi + 1
        }
        return "ArrayBuffer { [Uint8Contents]: <" + hex + ">, [byteLength]: " + i64ToStr(bytes) + " }"
    }
    // `Promise { 1 }` / `Promise { <pending> }` / `Promise { <rejected> ... }`
    if st.objects[o].promiseState >= 0 {
        if st.objects[o].promiseState == 0 {
            return "Promise { <pending> }"
        }
        let pv = cloneValue(st.objExtras[st.objects[o].extra].promiseValue)
        let shown = inspectInner(st, pv, depth + 1, indentLvl + 2, &mut stack, targets)
        if st.objects[o].promiseState == 2 {
            return "Promise { <rejected> " + shown + " }"
        }
        return "Promise { " + shown + " }"
    }
    // node inspects a proxy as its TARGET: the handler is not part of the value
    // the program is looking at.
    if st.objects[o].isProxy {
        let pt = objHandle(st.objExtras[st.objects[o].extra].proxyTarget)
        if pt >= 0 {
            return inspectObj(st, pt, depth, indentLvl, &mut stack, targets)
        }
    }
    // a primitive wrapper prints what it wraps, not its index properties:
    // Object("hi") is `[String: 'hi']`, not `{ '0': 'h', '1': 'i' }`
    if isWrapperObj(st, o) {
        let prim = boxedPrimitive(st, o)
        match prim {
            JSValue.Str(ws) => {
                return "[String: " + inspectQuoteStr(ws) + "]"
            }
            JSValue.Sym(wid) => {
                return "[Symbol: " + symbolDisplay(st, wid) + "]"
            }
            JSValue.Number(wn) => {
                return "[Number: " + numToStr(wn) + "]"
            }
            JSValue.Bool(wb) => {
                if wb {
                    return "[Boolean: true]"
                }
                return "[Boolean: false]"
            }
            _ => {
            }
        }
    }
    if depth > st.inspectMaxDepth {
        return "[Object]"
    }
    // An object with no prototype is not an ordinary object and node says so
    // before printing its properties: `Object.create(null)` is
    // `[Object: null prototype] {}`. The distinction matters because such an
    // object has no toString, so every other way of showing it fails.
    var nullProtoTag = ""
    if st.objects[o].protoNull {
        nullProtoTag = "[Object: null prototype] "
    }
    var parts: Vec<string> = Vec.new()
    // two passes: node lists the symbol keys after every string key
    var pass: i64 = 0
    while pass < 2 {
        var i: i64 = 0
        while i < st.objects[o].props.len() {
            if st.objects[o].props[i].enumerable && isSymbolKey(st.objects[o].props[i].key) == (pass == 1) {
                let key = st.objects[o].props[i].key.clone()
                let val = cloneValue(st.objects[o].props[i].value)
                parts.push(inspectKeyStr(st, key) + ": " + inspectInner(st, val, depth + 1, indentLvl + 2, &mut stack, targets))
            }
            i = i + 1
        }
        pass = pass + 1
    }
    if parts.len() == 0 {
        return nullProtoTag + "{}"
    }
    return nullProtoTag + inspectJoin(parts, "{", "}", "", indentLvl, false)
}

pub fn inspectTop(st: &Interp, v: &JSValue): string {
    match v {
        JSValue.Obj(o) => {
            // Two passes, because the `<ref *N>` marker belongs on the object that
            // is referenced BACK to, and that is only known once the whole graph
            // has been walked. The first pass collects those objects; the second
            // formats, printing `[Circular *N]` at a back-edge and prefixing the
            // target where it is first written out.
            var targets: Vec<i64> = Vec.new()
            var findStack: Vec<i64> = Vec.new()
            findCircularTargets(st, o, &mut findStack, &mut targets)
            var stack: Vec<i64> = Vec.new()
            return inspectObj(st, o, 0, 0, &mut stack, targets)
        }
        JSValue.Number(n) => {
            return inspectNum(n)
        }
        JSValue.BigInt(s) => {
            return s + "n"
        }
        JSValue.Func(fidx, _env, _fo) => {
            return inspectFuncLabelAt(fidx)
        }
        JSValue.Str(s) => {
            // a bare string logs unquoted (console.log("hi") → hi)
            return s.clone()
        }
        JSValue.Sym(id) => {
            return symbolDisplay(st, id)
        }
        _ => {
            return toStr(v)
        }
    }
}

// Invoke a Milo-level JS function: a fresh scope off the closure's captured env,
// with `this` and the parameters bound, then run the body. argVals is consumed.

// Records the called function's source file for the duration of the call, so a
// V8-style stack trace can name the file each frame belongs to. Wrapping rather
// than editing callFunctionBody's many early returns keeps the push and pop
// paired without touching its control flow.
pub fn callFunction(prog: &Prog, callee: &JSValue, argVals: Vec<JSValue>, thisVal: JSValue, st: &mut Interp): JSValue {
    let fIdx = funcHandle(callee)
    // A class constructor may only be reached through `new` (or a super() call,
    // which goes through the construct path and so has a new.target). Calling one
    // as a plain function silently ran its body and returned undefined, which is
    // the opposite of the error every other engine raises -- and quiet, so the
    // caller carried on with an undefined it never checked.
    if fIdx >= 0 && fIdx < prog.funcs.len() && prog.funcs[fIdx].isClassCtor {
        if isUndefinedValue(st.newTarget) {
            return throwErr(&mut st, "TypeError", "Class constructor " + prog.funcs[fIdx].name.clone() + " cannot be invoked without 'new'")
        }
    }
    if fIdx >= 0 && fIdx < prog.funcs.len() {
        st.fnFileStack.push(prog.funcs[fIdx].file.clone())
    } else {
        st.fnFileStack.push("")
    }
    // Strictness is a property of the function being entered, not of the caller:
    // a sloppy function called from strict code is still sloppy, and vice versa.
    let savedStrict = st.strict
    if fIdx >= 0 && fIdx < prog.funcs.len() {
        st.strict = prog.funcs[fIdx].isStrict
    }
    let r = callFunctionBody(prog, callee, argVals, thisVal, &mut st)
    st.strict = savedStrict
    let _popped = st.fnFileStack.pop()
    return r
}

// One activation's scope: `this`, `new.target`, the self-name of a named function
// expression, the declared parameters, and `arguments`. Split out of
// callFunctionBody because makeGenerator needs exactly the same bindings — the
// spec performs FunctionDeclarationInstantiation when a generator is CALLED, not
// at its first next() — and two copies of this would drift.
//
// Does NOT pushActive: the caller decides how the scope is rooted. A plain call
// roots it on the dynamic stack; a generator roots it through Interp.genScope,
// because the scope outlives the call that created it.
// `wantArguments` is false only for a call whose body is COMPILED and never
// names `arguments`. Building it is an array object plus a copy of every
// argument, per call, and a compiled body cannot reach it any other way: every
// identifier it mentions is a chunk slot, and the subset has no closure, no
// `with` and no direct eval to smuggle a reference out of the frame.
pub fn bindActivationScope(prog: &Prog, callee: &JSValue, argVals: &Vec<JSValue>, thisVal: &JSValue, st: &mut Interp, wantArguments: bool): i64 {
    let fIdx = funcHandle(callee)
    let callScope = newScope(&mut st, funcEnv(callee))
    // arrows have no own `this` — it stays lexical (resolved up the scope chain)
    if !prog.funcs[fIdx].isArrow {
        // A non-strict function called with no receiver gets globalThis, not
        // undefined. That is OrdinaryCallBindThis, and it is what
        // `Function("return this")()` — the standard global probe, and the core
        // of every UMD wrapper — depends on.
        var boundThisVal = cloneValue(thisVal)
        if !prog.funcs[fIdx].isStrict && isNullish(boundThisVal) {
            // sloppy mode substitutes globalThis for BOTH undefined and null:
            // `f.call(null)` and `f()` bind the same receiver
            if scopeHas(st, 0, "globalThis") {
                boundThisVal = scopeLookup(st, 0, "globalThis")
            }
        }
        scopeDefine(&mut st, callScope, "this", boundThisVal)
        // new.target is the constructor this frame was invoked with, or
        // undefined for a plain call
        scopeDefine(&mut st, callScope, "new.target", cloneValue(st.newTarget))
        // A named function EXPRESSION can refer to itself by name from inside its
        // own body, even though the name is not bound in the enclosing scope.
        // A method, getter or setter must NOT: its name is a property key, not a
        // binding, and installing one shadows any same-named variable the body
        // meant to read. `let v = 5; ({ get v() { return v; } }).v` returned the
        // getter function instead of 5, and the setter form silently wrote to the
        // shadow instead of the variable. node's own test harness hit this —
        // `common.localhostIPv4` is a getter over a module-level
        // `let localhostIPv4`, so every test using it connected to a host named
        // "[Function: localhostIPv4]" and hung.
        let selfName = prog.funcs[fIdx].name.clone()
        if selfName.len() > 0 && !prog.funcs[fIdx].isMethod {
            scopeDefine(&mut st, callScope, selfName, cloneValue(callee))
        }
    }
    var j: i64 = 0
    let nParams = prog.funcs[fIdx].params.len()
    let restFrom = prog.funcs[fIdx].restFrom
    while j < nParams {
        let pName = prog.funcs[fIdx].params[j].clone()
        if j == restFrom {
            let rest = newArray(&mut st)
            var r = j
            while r < argVals.len() {
                arrPush(&mut st, rest, cloneValue(argVals[r]))
                r = r + 1
            }
            scopeDefine(&mut st, callScope, pName, JSValue.Obj(rest))
        } else {
            var v = JSValue.Undefined
            if j < argVals.len() {
                v = cloneValue(argVals[j])
            }
            scopeDefine(&mut st, callScope, pName, v)
        }
        j = j + 1
    }
    // `arguments` — ES5 libraries lean on it for variadics (path.join etc).
    // Arrows don't get their own, matching JS.
    if !prog.funcs[fIdx].isArrow && wantArguments {
        let argsArr = newArray(&mut st)
        var ai: i64 = 0
        while ai < argVals.len() {
            arrPush(&mut st, argsArr, cloneValue(argVals[ai]))
            ai = ai + 1
        }
        st.objects[argsArr].isArguments = true
        scopeDefine(&mut st, callScope, "arguments", JSValue.Obj(argsArr))
    }
    return callScope
}

// The recursion guard every JS call has to pass, shared with the VM's own call
// opcode (src/engine/bytecode.milo) so the two cannot drift into two different
// ceilings. Answers true having ALREADY set the pending RangeError.
//
// Without this, runaway recursion exhausts the native stack and the process dies
// with no JS-level error, and express's error middleware expects a catchable
// RangeError instead.
// stackHeadroom() is the guard that actually protects the stack: it measures the
// task we are standing on, so it is right on the 256 MB interpreter task and on
// an 8 MB generator body alike. callDepthLimit is a backstop set to node's
// observable ceiling (~10k frames) so scripts that probe recursion depth see a
// comparable number; whichever fires first wins. A call the VM keeps in its own
// frames spends no native stack at all, so there the counter is the only one of
// the two that can fire.
pub fn callGuardTripped(st: &mut Interp): bool {
    let head = stackHeadroom()
    if st.callDepth >= st.callDepthLimit || (head >= 0 && head < stackReserveBytes()) {
        st.throwing = true
        st.thrownValue = makeError(&mut st, "RangeError", "Maximum call stack size exceeded")
        return true
    }
    return false
}

fn callFunctionBody(prog: &Prog, callee: &JSValue, argVals: Vec<JSValue>, thisVal: JSValue, st: &mut Interp): JSValue {
    let fIdx = funcHandle(callee)
    // See funcCallTicks in runtime.milo: the VM watches this to know user code ran.
    st.funcCallTicks = st.funcCallTicks + 1
    // R1: an async call runs its body on its own activation and returns at that
    // body's first await. Cleared immediately so a nested async call spawns.
    let alreadyOnActivation = st.suppressAsyncSpawn
    st.suppressAsyncSpawn = false
    // An `async function*` is a generator first: calling it returns an async
    // generator OBJECT, not a promise. Its body still awaits — that works
    // because the body runs on its own green task, which is all parkOnPromise
    // needs. Checked before the activation spawn, which would otherwise swallow
    // it and hand back a promise with no next().
    if prog.funcs[fIdx].isAsync && prog.funcs[fIdx].isGenerator && !st.suppressGenSpawn {
        st.suppressAsyncSpawn = false
        return makeGenerator(callee, argVals, thisVal, true, &mut st)
    }
    if prog.funcs[fIdx].isAsync && !alreadyOnActivation {
        let caller = schedulerCurrent()
        if caller as i64 != 0 {
            return spawnActivation(callee, argVals, thisVal, &mut st, caller)
        }
    }
    if callGuardTripped(&mut st) {
        return JSValue.Undefined
    }
    let genBody = st.suppressGenSpawn
    st.suppressGenSpawn = false
    if prog.funcs[fIdx].isGenerator && !genBody {
        return makeGenerator(callee, argVals, thisVal, false, &mut st)
    }
    st.callDepth = st.callDepth + 1
    // Whether this body runs as bytecode is decided BEFORE the frame is built,
    // because it decides how much of the frame is needed: a compiled body has no
    // `var` and no nested function declaration to hoist, and usually no
    // `arguments` to materialise.
    let cid = bodyChunkOf(prog, fIdx)
    let callScope = bindActivationScope(prog, callee, argVals, thisVal, &mut st, cid < 0 || chunkUsesArguments(cid))
    // root the frame across the whole call so a GC inside the body (or a nested
    // call) can't reclaim it
    pushActive(&mut st, callScope)
    let body = prog.funcs[fIdx].body
    // A body that is entirely within the compiled subset runs as bytecode
    // instead (src/engine/bytecode.milo). runChunk answers None for a chunk whose
    // free names are not all bound at entry, and it decides that before any side
    // effect, so the tree walker can still run the body from the top.
    var flow = Flow.Normal
    var walked = true
    if cid >= 0 && chunkIsNumeric(cid) {
        // The raw-f64 lane: same None-before-side-effects contract as runChunk.
        match runChunkNumeric(prog, cid, &mut st, callScope) {
            Option.Some(rv) => {
                flow = Flow.Ret(rv)
                walked = false
            }
            Option.None => {
            }
        }
    }
    if walked && cid >= 0 {
        match runChunk(prog, cid, &mut st, callScope) {
            Option.Some(rv) => {
                flow = Flow.Ret(rv)
                walked = false
            }
            Option.None => {
            }
        }
    }
    if walked {
        // `var`s and nested function declarations belong to the whole call frame
        hoistBlock(prog, body, &mut st, callScope)
        flow = execBlock(prog, body, &mut st, callScope)
    }
    // a function BODY is a lexical scope too: `using` in it releases here
    runDisposals(prog, &mut st, callScope)
    popActive(&mut st)
    st.callDepth = st.callDepth - 1
    var result = JSValue.Undefined
    if let Flow.Ret(v) = flow {
        result = v
    }
    // Not for an async GENERATOR body: its completion is delivered through the
    // generator protocol (genFinish), so wrapping the return in a promise made
    // `return v` surface as {value: Promise, done: true}, and wrapping a throw
    // hid it from genFinish entirely.
    if prog.funcs[fIdx].isAsync && !prog.funcs[fIdx].isGenerator {
        // an async body that threw yields a rejected promise instead of
        // propagating the throw to its (synchronous) caller
        if st.throwing {
            let err = cloneValue(st.thrownValue)
            st.throwing = false
            st.thrownValue = JSValue.Undefined
            return JSValue.Obj(newPromise(&mut st, 2, err))
        }
        // already-promise results are adopted rather than double-wrapped
        let ro = objHandle(result)
        if ro >= 0 && isPromise(st, ro) {
            return result
        }
        return JSValue.Obj(newPromise(&mut st, 1, result))
    }
    return result
}

// Function.prototype.call/apply keeps a method-dispatch frame live around the
// ordinary JS call. Charge that extra native frame to the recursion budget so a
// recursive adapter path cannot reach the C stack before callFunction's guard.
fn callFunctionViaMethod(prog: &Prog, callee: &JSValue, argVals: Vec<JSValue>, thisVal: JSValue, st: &mut Interp): JSValue {
    st.callDepth = st.callDepth + 1
    let result = callFunction(prog, callee, argVals, thisVal, &mut st)
    st.callDepth = st.callDepth - 1
    return result
}

// Invoke any callable JSValue (user function or native).
// Build a class: the constructor becomes the class value, instance methods go on
// its prototype, statics on its own property bag. `extends` chains the prototype
// so instances inherit the base's methods, and records the base constructor
// under __super$<Name> so super(...) can find it.
// Native-stack headroom in bytes on the green task this call is running on, or
// -1 off-task. The recursion guard used to be a fixed frame count, which cannot
// be right for both stacks the engine uses at once: the main interpreter task
// carries a 256 MB stack (~25k JS frames) while every generator and async body
// gets 8 MB (~1.5k). A single number was either a spurious RangeError at 104
// frames on the big stack or a silent overflow crash on a small one. Measuring
// the stack we are actually standing on is right on either.
fn stackHeadroom(): i64 {
    let me = schedulerCurrent()
    if me as i64 == 0 {
        return -1
    }
    unsafe {
        var probe: i64 = 0
        let sp = probe.addrOf() as *u8 as i64
        let base = rtReadI64(me, tStack())
        return sp - (base + guardPageSize())
    }
}

// Slack left below the guard so that raising the RangeError and unwinding out of
// the recursion do not themselves run off the end of the stack.
fn stackReserveBytes(): i64 {
    return 524288
}

// Best-effort name for a callee expression, so "is not a function" says which
// one. Diagnostics only.
fn describeCallee(prog: &Prog, calleeId: ExprId): string {
    match prog.exprs[calleeId.index] {
        Expr.Ident(n) => {
            return n.clone()
        }
        Expr.Member(_o, n) => {
            return "." + n.clone()
        }
        Expr.OptMember(_o, n) => {
            return "?." + n.clone()
        }
        Expr.OptIndex(_o, _k) => {
            return "?.[]"
        }
        Expr.RegexLit(pat, flags) => {
            return "/" + pat.clone() + "/" + flags.clone()
        }
        Expr.ObjLit(_l) => {
            return "{}"
        }
        Expr.ArrLit(_l) => {
            return "[]"
        }
        Expr.Num(n) => {
            return numToStr(n)
        }
        _ => {
            return "value"
        }
    }
}

// ProxyCreate, shared by `new Proxy(t, h)` and Proxy.revocable(t, h).
fn makeProxy(st: &mut Interp, argVals: &Vec<JSValue>): JSValue {
    if argVals.len() < 2 {
        return throwErr(&mut st, "TypeError", "Cannot create proxy with a non-object as target or handler")
    }
    let t = cloneValue(argVals[0])
    let h = cloneValue(argVals[1])
    // a function target is legal and common — `new Proxy(fn, {apply})`
    if (objHandle(t) < 0 && !isCallable(t)) || objHandle(h) < 0 {
        return throwErr(&mut st, "TypeError", "Cannot create proxy with a non-object as target or handler")
    }
    let callable = isCallableIn(st, t)
    let o = newObject(&mut st)
    st.anyProxy = true
    st.objects[o].isProxy = true
    let ex = ensureExtra(&mut st, o)
    st.objExtras[ex].proxyTarget = t
    st.objExtras[ex].proxyHandler = h
    // a proxy over a callable must itself report as callable. Decided once, at
    // creation: a revoked target still leaves `typeof proxy` as "function".
    st.objects[o].isFunctionLike = callable
    return JSValue.Obj(o)
}

// Proxy.revocable's revoke function. A bound-method object rather than a
// native, because a native parameterised by the proxy handle would need a
// property bag keyed by that id and the bag table is a vector indexed by id.
// Bound methods also happen to be exactly what the spec asks for here: callable,
// never constructable, and carrying no `prototype` own property.
fn makeRevokeFn(st: &mut Interp, proxyObj: i64): JSValue {
    let bo = newObject(&mut st)
    st.objects[bo].isBound = true
    let ex = ensureExtra(&mut st, bo)
    st.objExtras[ex].boundThis = JSValue.Obj(proxyObj)
    st.objExtras[ex].boundMethod = "__proxyRevoke"
    objDefineBuiltinAttr(&mut st, bo, "length", JSValue.Number(0.0))
    // the revoker is anonymous: its `name` is the empty string, not "revoke"
    objDefineBuiltinAttr(&mut st, bo, "name", JSValue.Str(""))
    return JSValue.Obj(bo)
}

// A revoked proxy has both its target and handler cleared, and every internal
// method on it must throw rather than forward. A live proxy's handler is always
// an object, so its absence is what records the revocation.
fn proxyRevoked(st: &Interp, o: i64): bool {
    return objHandle(st.objExtras[st.objects[o].extra].proxyHandler) < 0
}

// IsArray per the spec: a Proxy is an array when its TARGET is, following the
// chain through nested proxies. Reading `isArray` off the proxy object itself
// answered false for every proxied array, which is not a cosmetic difference:
// Array.isArray, JSON.stringify's array form, join/toString and concat's
// spreadable check all branch on it, so `[...new Proxy([1,2,3], {})]` and
// `JSON.stringify(proxiedArray)` produced object-shaped results.
pub fn valueIsArrayLike(st: &Interp, v: &JSValue): bool {
    var h = objHandle(v)
    var guard: i64 = 0
    while h >= 0 && guard < 1000 {
        guard = guard + 1
        if st.objects[h].isProxy {
            h = objHandle(st.objExtras[st.objects[h].extra].proxyTarget)
            continue
        }
        return st.objects[h].isArray && !st.objects[h].isArguments
    }
    return false
}

fn proxyTargetOf(st: &Interp, o: i64): JSValue {
    return cloneValue(st.objExtras[st.objects[o].extra].proxyTarget)
}

fn proxyHandlerOf(st: &Interp, o: i64): JSValue {
    return cloneValue(st.objExtras[st.objects[o].extra].proxyHandler)
}

// GetMethod for a proxy trap. undefined and null both mean "no trap"; any other
// non-callable value is a TypeError. Reading the handler property raw let every
// caller silently fall through to the target instead, which is the difference
// between `new Proxy(t, {get: 1})` throwing and quietly behaving like `t`.
// Callers must check st.throwing before using the result.
fn proxyTrapChecked(prog: &Prog, st: &mut Interp, o: i64, name: &string): JSValue {
    // Copied out of the AST before anything below can re-enter the
    // interpreter and move the program storage this reference points into.
    let nameCopy = name.clone()
    if proxyRevoked(st, o) {
        return throwErr(&mut st, "TypeError", "Cannot perform '" + nameCopy.clone() + "' on a proxy that has been revoked")
    }
    let h = objHandle(st.objExtras[st.objects[o].extra].proxyHandler)
    // the handler may itself be a proxy, so this read has to go through the
    // dynamic member path rather than reading its slots
    let t = getMemberDyn(prog, h, nameCopy, &mut st)
    if st.throwing {
        return JSValue.Undefined
    }
    if isNullish(t) {
        return JSValue.Undefined
    }
    if !isCallableIn(st, t) {
        return throwErr(&mut st, "TypeError", "'" + nameCopy.clone() + "' trap must be a function")
    }
    return t
}

// Invoke a proxy trap with the handler as `this`, which is the receiver every
// trap is called with.
fn callTrap(prog: &Prog, st: &mut Interp, o: i64, trap: &JSValue, args: Vec<JSValue>): JSValue {
    return callValue(prog, trap, args, proxyHandlerOf(st, o), &mut st)
}

// CompletePropertyDescriptor. A getOwnPropertyDescriptor trap may answer a
// partial descriptor, but what Object.getOwnPropertyDescriptor hands back must
// still carry every field, in node's field order.
fn completeDescriptor(prog: &Prog, st: &mut Interp, dh: i64): JSValue {
    let isAcc = objHasInChain(st, dh, "get") || objHasInChain(st, dh, "set")
    let out = newObject(&mut st)
    pushTemp(&mut st, JSValue.Obj(out))
    if isAcc {
        objSet(&mut st, out, "get", getMemberDyn(prog, dh, "get", &mut st))
        objSet(&mut st, out, "set", getMemberDyn(prog, dh, "set", &mut st))
    } else {
        objSet(&mut st, out, "value", getMemberDyn(prog, dh, "value", &mut st))
        objSet(&mut st, out, "writable", JSValue.Bool(truthy(getMemberDyn(prog, dh, "writable", &mut st))))
    }
    objSet(&mut st, out, "enumerable", JSValue.Bool(truthy(getMemberDyn(prog, dh, "enumerable", &mut st))))
    objSet(&mut st, out, "configurable", JSValue.Bool(truthy(getMemberDyn(prog, dh, "configurable", &mut st))))
    popTemp(&mut st)
    return JSValue.Obj(out)
}

fn vecHasStr(v: &Vec<string>, s: &string): bool {
    var i: i64 = 0
    while i < v.len() {
        if v[i] == s {
            return true
        }
        i = i + 1
    }
    return false
}

// IsCompatiblePropertyDescriptor: may `d` be applied over the existing
// descriptor `tdh`? Both are descriptor OBJECTS here, which is why this cannot
// reuse descRejectReason — that one answers about a live property slot.
fn descCompatible(st: &mut Interp, extensible: bool, d: i64, tdh: i64): bool {
    if tdh < 0 {
        return extensible
    }
    if truthy(getMember(st, tdh, "configurable")) {
        return true
    }
    if objHasInChain(st, d, "configurable") && truthy(getMember(st, d, "configurable")) {
        return false
    }
    if objHasInChain(st, d, "enumerable") && truthy(getMember(st, d, "enumerable")) != truthy(getMember(st, tdh, "enumerable")) {
        return false
    }
    let dAcc = objHasInChain(st, d, "get") || objHasInChain(st, d, "set")
    let tAcc = objHasInChain(st, tdh, "get") || objHasInChain(st, tdh, "set")
    let dData = objHasInChain(st, d, "value") || objHasInChain(st, d, "writable")
    // a non-configurable property cannot change kind
    if dAcc && !tAcc {
        return false
    }
    if dData && tAcc {
        return false
    }
    if tAcc {
        if objHasInChain(st, d, "get") && !jsStrictEquals(getMember(st, d, "get"), getMember(st, tdh, "get")) {
            return false
        }
        if objHasInChain(st, d, "set") && !jsStrictEquals(getMember(st, d, "set"), getMember(st, tdh, "set")) {
            return false
        }
        return true
    }
    if !truthy(getMember(st, tdh, "writable")) {
        if objHasInChain(st, d, "writable") && truthy(getMember(st, d, "writable")) {
            return false
        }
        if objHasInChain(st, d, "value") && !sameValue(getMember(st, d, "value"), getMember(st, tdh, "value")) {
            return false
        }
    }
    return true
}

// ToPropertyDescriptor. The fields are READ, so an accessor on the descriptor
// object runs — once, before anything is defined, in the spec's field order.
// Consulting the raw descriptor at each use instead ran such a getter several
// times over, and missed it entirely when it was inherited.
fn toPropertyDescriptor(prog: &Prog, st: &mut Interp, dh: i64): i64 {
    let out = newObject(&mut st)
    pushTemp(&mut st, JSValue.Obj(out))
    for f in ["enumerable", "configurable", "value", "writable", "get", "set"] {
        if objHasInChain(st, dh, f) {
            let v = getMemberDyn(prog, dh, f, &mut st)
            if st.throwing {
                popTemp(&mut st)
                return out
            }
            objSet(&mut st, out, f.clone(), v)
        }
    }
    popTemp(&mut st)
    return out
}

// ── the object internal methods, over any value ──────────────────────────────
//
// Each pair below is one ordinary implementation plus one dispatcher. The
// dispatcher is what every caller should use: it routes a proxy through the
// matching trap and, when the handler defines no trap, forwards to the target
// by calling ITSELF — so a proxy whose target is another proxy still consults
// the inner proxy's traps instead of reading its raw slots.

fn ordinaryGetOwnPropDesc(st: &mut Interp, v: &JSValue, key: &string): JSValue {
    let h = propertyBagOf(&mut st, v)
    if h < 0 {
        return JSValue.Undefined
    }
    let ad = arrayOwnDescriptor(&mut st, h, key)
    if ad >= 0 {
        return JSValue.Obj(ad)
    }
    let idx = objOwnIndex(st, h, key)
    if idx < 0 {
        // a top-level binding is a property of the global object even though
        // it lives in scope 0; it is writable and enumerable but, like a
        // `var` declaration, not configurable
        if st.objects[h].isGlobal {
            var bi = scopeOwnIndex(st, 0, key)
            if key == "undefined" {
                // a literal, not a binding, but an own frozen property of the
                // global object all the same
                bi = 0
            }
            if bi >= 0 {
                // a builtin global is writable, non-enumerable, configurable;
                // the three value constants are frozen; the program's own
                // `var`s are writable, enumerable, non-configurable
                let builtin = bi < st.builtinGlobals
                let frozen = key == "NaN" || key == "Infinity" || key == "undefined"
                let gd = newObject(&mut st)
                pushTemp(&mut st, JSValue.Obj(gd))
                objSet(&mut st, gd, "value", scopeLookup(st, 0, key))
                objSet(&mut st, gd, "writable", JSValue.Bool(!frozen))
                objSet(&mut st, gd, "enumerable", JSValue.Bool(!builtin))
                objSet(&mut st, gd, "configurable", JSValue.Bool(builtin && !frozen))
                popTemp(&mut st)
                return JSValue.Obj(gd)
            }
        }
        return JSValue.Undefined
    }
    return JSValue.Obj(buildPropDescriptor(&mut st, h, idx))
}

// EnumerableOwnPropertyNames: the own STRING keys that are enumerable, in spec
// order. A Proxy has no own properties of its own, so every caller that walked
// `enumOrder` over the object's prop table saw nothing and Object.values,
// Object.entries, Object.assign and `{...proxy}` all came back empty. This goes
// through the ownKeys and getOwnPropertyDescriptor traps instead.
pub fn ownEnumerableKeys(prog: &Prog, st: &mut Interp, v: &JSValue): Vec<string> {
    var out: Vec<string> = Vec.new()
    let keys = ownKeysOf(prog, &mut st, v)
    var i: i64 = 0
    while i < keys.len() && !st.throwing {
        let k = keys[i].clone()
        i = i + 1
        if isSymbolKey(k) || isPrivateKey(k) {
            continue
        }
        let d = getOwnPropDescOf(prog, &mut st, v, k.clone())
        let dh = objHandle(d)
        if dh >= 0 {
            // The descriptor is a freshly allocated object reachable only from
            // this frame. Under MILOJS_GC_THRESHOLD=1 a collection between the
            // allocation and the read freed it and handed its slot to the next
            // allocation, so Object.assign over a proxy copied the DESCRIPTOR's
            // own keys (value/writable/enumerable/configurable) into the result.
            pushTemp(&mut st, JSValue.Obj(dh))
            let isEnum = truthy(getMember(st, dh, "enumerable"))
            popTemp(&mut st)
            if isEnum {
                out.push(k)
            }
        }
    }
    return out
}

pub fn getOwnPropDescOf(prog: &Prog, st: &mut Interp, v: &JSValue, key: &string): JSValue {
    let o = objHandle(v)
    if o >= 0 && st.objects[o].isProxy {
        let trap = proxyTrapChecked(prog, &mut st, o, "getOwnPropertyDescriptor")
        if st.throwing {
            return JSValue.Undefined
        }
        let target = proxyTargetOf(st, o)
        if isUndefinedValue(trap) {
            return getOwnPropDescOf(prog, &mut st, target, key)
        }
        var args: Vec<JSValue> = Vec.new()
        args.push(cloneValue(target))
        args.push(propKeyValue(key))
        let r = callTrap(prog, &mut st, o, trap, args)
        if st.throwing {
            return JSValue.Undefined
        }
        let rh = objHandle(r)
        if rh < 0 {
            if !isUndefinedValue(r) {
                return throwErr(&mut st, "TypeError", "'getOwnPropertyDescriptor' on proxy: trap returned neither object nor undefined")
            }
            // the target cannot lose a non-configurable own property behind the
            // proxy's back, nor gain the absence of one it cannot delete
            let td = getOwnPropDescOf(prog, &mut st, target, key)
            if st.throwing {
                return JSValue.Undefined
            }
            let tdh = objHandle(td)
            if tdh >= 0 && !truthy(getMember(st, tdh, "configurable")) {
                return throwErr(&mut st, "TypeError", "'getOwnPropertyDescriptor' on proxy: trap returned undefined for property '" + key.clone() + "' which is non-configurable in the proxy target")
            }
            if tdh >= 0 && !isExtensibleOf(prog, &mut st, target) {
                return throwErr(&mut st, "TypeError", "'getOwnPropertyDescriptor' on proxy: trap returned undefined for property '" + key.clone() + "' which exists in the non-extensible proxy target")
            }
            return JSValue.Undefined
        }
        let done = completeDescriptor(prog, &mut st, rh)
        if st.throwing {
            return JSValue.Undefined
        }
        let dh = objHandle(done)
        if !truthy(getMember(st, dh, "configurable")) {
            let td = getOwnPropDescOf(prog, &mut st, target, key)
            if st.throwing {
                return JSValue.Undefined
            }
            let tdh = objHandle(td)
            if tdh < 0 || truthy(getMember(st, tdh, "configurable")) {
                return throwErr(&mut st, "TypeError", "'getOwnPropertyDescriptor' on proxy: trap reported non-configurability for property '" + key.clone() + "' which is either non-existent or configurable in the proxy target")
            }
        }
        return done
    }
    return ordinaryGetOwnPropDesc(&mut st, v, key)
}

fn ordinaryGetProto(st: &mut Interp, v: &JSValue): JSValue {
    // A function's prototype is Function.prototype. Its property BAG is an
    // ordinary object linked to Object.prototype, so asking the bag answered
    // Object.prototype for every function value. A bag with a DELIBERATE
    // proto still wins — `Object.getPrototypeOf(Int8Array)` is the
    // %TypedArray% intrinsic, and test262's whole TypedArray tree opens with
    // exactly that read.
    if isCallableIn(st, v) && st.functionProtoObj >= 0 {
        var bagProto: i64 = -1
        let bh0 = propertyBagOf(&mut st, v)
        if bh0 >= 0 {
            bagProto = protoOfHandle(st, bh0)
        }
        if bagProto < 0 || bagProto == st.objectProtoObj {
            return JSValue.Obj(st.functionProtoObj)
        }
    }
    let h = propertyBagOf(&mut st, v)
    if h < 0 {
        let pp = primitiveProtoHandle(&mut st, v)
        if pp >= 0 {
            return JSValue.Obj(pp)
        }
        return JSValue.Null
    }
    let p = protoOfHandle(st, h)
    if p >= 0 {
        return JSValue.Obj(p)
    }
    return JSValue.Null
}

pub fn getProtoOf(prog: &Prog, st: &mut Interp, v: &JSValue): JSValue {
    let o = objHandle(v)
    if o >= 0 && st.objects[o].isProxy {
        let trap = proxyTrapChecked(prog, &mut st, o, "getPrototypeOf")
        if st.throwing {
            return JSValue.Undefined
        }
        let target = proxyTargetOf(st, o)
        if isUndefinedValue(trap) {
            return getProtoOf(prog, &mut st, target)
        }
        var args: Vec<JSValue> = Vec.new()
        args.push(cloneValue(target))
        let r = callTrap(prog, &mut st, o, trap, args)
        if st.throwing {
            return JSValue.Undefined
        }
        if !isObjectValue(&mut st, r) && !isNullValue(r) {
            return throwErr(&mut st, "TypeError", "'getPrototypeOf' on proxy: trap returned neither object nor null")
        }
        // a non-extensible target's prototype is fixed, so the trap may not
        // report a different one
        if !isExtensibleOf(prog, &mut st, target) {
            if st.throwing {
                return JSValue.Undefined
            }
            let tp = getProtoOf(prog, &mut st, target)
            if st.throwing {
                return JSValue.Undefined
            }
            if !jsStrictEquals(r, tp) {
                return throwErr(&mut st, "TypeError", "'getPrototypeOf' on proxy: proxy target is non-extensible but the trap did not return its actual prototype")
            }
        }
        return r
    }
    return ordinaryGetProto(&mut st, v)
}

// The ordinary [[SetPrototypeOf]], reported as a boolean. The spec's rejection
// cases are `false` here rather than a throw, because Reflect.setPrototypeOf
// has to report them as false while a Test262Error raised by user code inside
// a trap still has to propagate; Object.setPrototypeOf turns the false back
// into its TypeError.
fn ordinarySetProto(st: &mut Interp, v: &JSValue, proto: &JSValue): bool {
    let h = propertyBagOf(&mut st, v)
    if h < 0 {
        return true
    }
    let p = propertyBagOf(&mut st, proto)
    // %Object.prototype% is an immutable prototype exotic object: its
    // [[Prototype]] is already null and setting it to anything else is
    // rejected, not a silent no-op. Nothing else in the language has this rule,
    // which is why it is stated here rather than as a flag.
    if h == st.objectProtoObj {
        return p < 0
    }
    // an object that has had preventExtensions/freeze/seal applied to it cannot
    // have its prototype replaced either
    if st.objects[h].noExtend || st.objects[h].frozen {
        // setting the prototype it already has is still legal. protoOfHandle,
        // not the raw slot: an object that never had one explicitly set stores
        // -1 and inherits Object.prototype, which is what the caller reads back
        // from getPrototypeOf and hands straight back here.
        return p == protoOfHandle(st, h)
    }
    // a prototype chain may not become a cycle
    var walk = p
    while walk >= 0 {
        if walk == h {
            return false
        }
        // a proxy in the chain makes the walk unbounded: the spec stops there
        // and accepts the assignment
        if st.objects[walk].isProxy {
            walk = -1
        } else {
            walk = protoOfHandle(st, walk)
        }
    }
    st.objects[h].proto = p
    // setPrototypeOf(o, null) must sever the chain, not fall back to the
    // default Object.prototype that proto == -1 means
    st.objects[h].protoNull = p < 0
    return true
}

pub fn setProtoOf(prog: &Prog, st: &mut Interp, v: &JSValue, proto: &JSValue): bool {
    let o = objHandle(v)
    if o >= 0 && st.objects[o].isProxy {
        let trap = proxyTrapChecked(prog, &mut st, o, "setPrototypeOf")
        if st.throwing {
            return false
        }
        let target = proxyTargetOf(st, o)
        if isUndefinedValue(trap) {
            return setProtoOf(prog, &mut st, target, proto)
        }
        var args: Vec<JSValue> = Vec.new()
        args.push(cloneValue(target))
        args.push(cloneValue(proto))
        let r = callTrap(prog, &mut st, o, trap, args)
        if st.throwing {
            return false
        }
        if !truthy(r) {
            return false
        }
        if !isExtensibleOf(prog, &mut st, target) {
            if st.throwing {
                return false
            }
            let tp = getProtoOf(prog, &mut st, target)
            if st.throwing {
                return false
            }
            if !jsStrictEquals(proto, tp) {
                let _t = throwErr(&mut st, "TypeError", "'setPrototypeOf' on proxy: trap returned truish for setting a new prototype on the non-extensible proxy target")
                return false
            }
        }
        return true
    }
    return ordinarySetProto(&mut st, v, proto)
}

pub fn isExtensibleOf(prog: &Prog, st: &mut Interp, v: &JSValue): bool {
    let o = objHandle(v)
    if o >= 0 && st.objects[o].isProxy {
        let trap = proxyTrapChecked(prog, &mut st, o, "isExtensible")
        if st.throwing {
            return false
        }
        let target = proxyTargetOf(st, o)
        if isUndefinedValue(trap) {
            return isExtensibleOf(prog, &mut st, target)
        }
        var args: Vec<JSValue> = Vec.new()
        args.push(cloneValue(target))
        let r = callTrap(prog, &mut st, o, trap, args)
        if st.throwing {
            return false
        }
        let want = isExtensibleOf(prog, &mut st, target)
        if st.throwing {
            return false
        }
        // extensibility is not something a proxy may lie about
        if truthy(r) != want {
            let _t = throwErr(&mut st, "TypeError", "'isExtensible' on proxy: trap result does not reflect extensibility of proxy target")
            return false
        }
        return want
    }
    // a function is an ordinary extensible object; objHandle answers -1 for
    // one, so every builtin used to report itself non-extensible
    let h = propertyBagOf(&mut st, v)
    if h >= 0 {
        return !st.objects[h].noExtend && !st.objects[h].frozen
    }
    // primitives are never extensible
    return false
}

pub fn preventExtOf(prog: &Prog, st: &mut Interp, v: &JSValue, seal: bool): bool {
    let o = objHandle(v)
    if o >= 0 && st.objects[o].isProxy {
        let trap = proxyTrapChecked(prog, &mut st, o, "preventExtensions")
        if st.throwing {
            return false
        }
        let target = proxyTargetOf(st, o)
        if isUndefinedValue(trap) {
            return preventExtOf(prog, &mut st, target, seal)
        }
        var args: Vec<JSValue> = Vec.new()
        args.push(cloneValue(target))
        let r = callTrap(prog, &mut st, o, trap, args)
        if st.throwing {
            return false
        }
        if !truthy(r) {
            return false
        }
        if isExtensibleOf(prog, &mut st, target) {
            if st.throwing {
                return false
            }
            let _t = throwErr(&mut st, "TypeError", "'preventExtensions' on proxy: trap returned truish but the proxy target is extensible")
            return false
        }
        return true
    }
    let h = propertyBagOf(&mut st, v)
    if h >= 0 {
        st.objects[h].noExtend = true
        if seal {
            st.objects[h].sealed = true
            // Sealing makes every existing property non-configurable and leaves
            // writability alone; the per-property stamp is what
            // getOwnPropertyDescriptor reports. See the note in FREEZE.
            var si: i64 = 0
            while si < st.objects[h].props.len() {
                st.objects[h].props[si].configurable = false
                si = si + 1
            }
        }
    }
    return true
}

// The ordinary [[DefineOwnProperty]], reported as a boolean for the same reason
// ordinarySetProto is: a rejected definition must surface as `false` from
// Reflect.defineProperty. A RangeError from an invalid array length is a real
// throw in both spellings and still propagates.
fn ordinaryDefineOwn(st: &mut Interp, v: &JSValue, key: &string, d: i64): bool {
    let o = propertyBagOf(&mut st, v)
    if o < 0 {
        return false
    }
    let reason = descRejectReason(&mut st, o, key, d)
    if st.throwing {
        return false
    }
    if reason.len() > 0 {
        return false
    }
    return applyDescriptorQuiet(&mut st, o, key, d)
}

pub fn definePropOf(prog: &Prog, st: &mut Interp, v: &JSValue, key: &string, d: i64): bool {
    let o = objHandle(v)
    if o >= 0 && st.objects[o].isProxy {
        let trap = proxyTrapChecked(prog, &mut st, o, "defineProperty")
        if st.throwing {
            return false
        }
        let target = proxyTargetOf(st, o)
        if isUndefinedValue(trap) {
            return definePropOf(prog, &mut st, target, key, d)
        }
        var args: Vec<JSValue> = Vec.new()
        args.push(cloneValue(target))
        args.push(propKeyValue(key))
        args.push(JSValue.Obj(d))
        let r = callTrap(prog, &mut st, o, trap, args)
        if st.throwing {
            return false
        }
        if !truthy(r) {
            return false
        }
        // a trap that reported success may not have left the target in a state
        // the definition could not legally have produced
        let td = getOwnPropDescOf(prog, &mut st, target, key)
        if st.throwing {
            return false
        }
        let tdh = objHandle(td)
        let ext = isExtensibleOf(prog, &mut st, target)
        if st.throwing {
            return false
        }
        let settingConfigFalse = objHasInChain(st, d, "configurable") && !truthy(getMember(st, d, "configurable"))
        var bad = false
        if tdh < 0 {
            bad = !ext || settingConfigFalse
        } else {
            bad = !descCompatible(&mut st, ext, d, tdh)
            if !bad && settingConfigFalse && truthy(getMember(st, tdh, "configurable")) {
                bad = true
            }
            if !bad && !truthy(getMember(st, tdh, "configurable")) && objHasInChain(st, tdh, "writable") && truthy(getMember(st, tdh, "writable")) && objHasInChain(st, d, "writable") && !truthy(getMember(st, d, "writable")) {
                bad = true
            }
        }
        if bad {
            let _t = throwErr(&mut st, "TypeError", "'defineProperty' on proxy: trap returned truish for property '" + key.clone() + "' which is either non-existent or configurable in the proxy target")
            return false
        }
        return true
    }
    return ordinaryDefineOwn(&mut st, v, key, d)
}

// A get trap may not disagree with a target property the target cannot change:
// a non-configurable non-writable data property has to be reported by value, and
// a non-configurable accessor with no getter has to be reported as undefined.
fn checkProxyGetResult(prog: &Prog, st: &mut Interp, target: &JSValue, key: &string, r: &JSValue) {
    // Copied out of the AST before anything below can re-enter the
    // interpreter and move the program storage this reference points into.
    let keyCopy = key.clone()
    let td = getOwnPropDescOf(prog, &mut st, target, keyCopy)
    if st.throwing {
        return
    }
    let tdh = objHandle(td)
    if tdh < 0 || truthy(getMember(st, tdh, "configurable")) {
        return
    }
    if objHasInChain(st, tdh, "get") {
        if isUndefinedValue(getMember(st, tdh, "get")) && !isUndefinedValue(r) {
            let _t = throwErr(&mut st, "TypeError", "'get' on proxy: property '" + keyCopy.clone() + "' is a non-configurable accessor property on the proxy target and does not have a getter function, but the trap did not return 'undefined'")
        }
        return
    }
    if !truthy(getMember(st, tdh, "writable")) && !sameValue(r, getMember(st, tdh, "value")) {
        let _t = throwErr(&mut st, "TypeError", "'get' on proxy: property '" + keyCopy.clone() + "' is a read-only and non-configurable data property on the proxy target but the proxy did not return its actual value")
    }
}

// The mirror for a set trap that reported success: a target property that
// cannot be written may not be reported as written.
fn checkProxySetResult(prog: &Prog, st: &mut Interp, target: &JSValue, key: &string, v: &JSValue) {
    // Copied out of the AST before anything below can re-enter the
    // interpreter and move the program storage this reference points into.
    let keyCopy = key.clone()
    let td = getOwnPropDescOf(prog, &mut st, target, keyCopy)
    if st.throwing {
        return
    }
    let tdh = objHandle(td)
    if tdh < 0 || truthy(getMember(st, tdh, "configurable")) {
        return
    }
    if objHasInChain(st, tdh, "set") {
        if isUndefinedValue(getMember(st, tdh, "set")) {
            let _t = throwErr(&mut st, "TypeError", "'set' on proxy: trap returned truish for property '" + keyCopy.clone() + "' which exists in the proxy target as a non-configurable and non-writable accessor property without a setter")
        }
        return
    }
    if objHasInChain(st, tdh, "get") {
        return
    }
    if !truthy(getMember(st, tdh, "writable")) && !sameValue(v, getMember(st, tdh, "value")) {
        let _t = throwErr(&mut st, "TypeError", "'set' on proxy: trap returned truish for property '" + keyCopy.clone() + "' which exists in the proxy target as a non-configurable and non-writable data property with a different value")
    }
}

// `new Promise(executor)`. Shared by the `new` path and by [[Construct]] with an
// explicit newTarget, which reaches the constructor through Reflect.construct.
fn constructPromise(prog: &Prog, st: &mut Interp, argVals: &Vec<JSValue>): JSValue {
    // `new Promise(1)` is a TypeError before the promise exists: the executor is
    // validated first, so a non-callable one produced a permanently pending
    // promise instead of throwing.
    if argVals.len() == 0 || !isCallableIn(st, argVals[0]) {
        return throwErr(&mut st, "TypeError", "Promise resolver is not a function")
    }
    let pr = newPromise(&mut st, 0, JSValue.Undefined)
    pushTemp(&mut st, JSValue.Obj(pr))
    var exArgs: Vec<JSValue> = Vec.new()
    exArgs.push(JSValue.Native(Native.Resolver(pr, false)))
    exArgs.push(JSValue.Native(Native.Resolver(pr, true)))
    let _ = callValue(prog, argVals[0], exArgs, JSValue.Undefined, &mut st)
    if st.throwing {
        let err = cloneValue(st.thrownValue)
        st.throwing = false
        st.thrownValue = JSValue.Undefined
        if st.objects[pr].promiseState == 0 {
            st.objects[pr].promiseState = 2
            st.objExtras[st.objects[pr].extra].promiseValue = err
        }
    }
    popTemp(&mut st)
    return JSValue.Obj(pr)
}

// The [[Prototype]] a differing newTarget imposes, or -1 for "use the
// constructor's own". Reading `newTarget.prototype` can run a getter, so WHEN it
// happens is observable and each caller below picks its own moment.
fn newTargetProto(prog: &Prog, st: &mut Interp, ctor: &JSValue, newTarget: &JSValue): i64 {
    if jsStrictEquals(ctor, newTarget) {
        return -1
    }
    let ntBag = propertyBagOf(&mut st, newTarget)
    if ntBag < 0 {
        return -1
    }
    return objHandle(getMemberDyn(prog, ntBag, "prototype", &mut st))
}

fn adoptBuiltinSlots(st: &mut Interp, dst: i64, src: i64) {
    st.objects[dst].isMap = st.objects[src].isMap
    st.objects[dst].isSet = st.objects[src].isSet
    st.objects[dst].isDate = st.objects[src].isDate
    st.objects[dst].isArrayBuffer = st.objects[src].isArrayBuffer
    st.objects[dst].isDataView = st.objects[src].isDataView
    st.objects[dst].isError = st.objects[src].isError
    st.objects[dst].promiseState = st.objects[src].promiseState
    // An Array subclass instance IS an array exotic object: Array.isArray must
    // answer true and `new A(3)` must give it length 3. The elements move with
    // the flag, since the base constructor is where they were built.
    if st.objects[src].isArray {
        st.objects[dst].isArray = true
        st.objects[dst].elems = replace(st.objects[src].elems, Vec.new())
    }
    let de = ensureExtra(&mut st, dst)
    let se = st.objects[src].extra
    st.objExtras[de].mapKeys = cloneValueVec(st.objExtras[se].mapKeys)
    st.objExtras[de].mapVals = cloneValueVec(st.objExtras[se].mapVals)
    st.objExtras[de].weakKind = st.objExtras[se].weakKind
    st.objExtras[de].promiseValue = cloneValue(st.objExtras[se].promiseValue)
    st.objExtras[de].boxed = cloneValue(st.objExtras[se].boxed)
    st.objExtras[de].regexId = st.objExtras[se].regexId
    // A regex keeps source/flags/lastIndex as own data properties here, so a
    // `class R extends RegExp` instance needs them moved too: without them its
    // flags read as undefined and every spec algorithm saw a non-global regex.
    if st.objExtras[se].regexId >= 0 {
        var rp: i64 = 0
        while rp < st.objects[src].props.len() {
            let pk = st.objects[src].props[rp].key.clone()
            if objOwnIndex(st, dst, pk) < 0 && st.objects[src].props[rp].acc.isNone() {
                objSet(&mut st, dst, pk.clone(), cloneValue(st.objects[src].props[rp].value))
                let di = objOwnIndex(st, dst, pk)
                st.objects[dst].props[di].writable = st.objects[src].props[rp].writable
                st.objects[dst].props[di].enumerable = st.objects[src].props[rp].enumerable
                st.objects[dst].props[di].configurable = st.objects[src].props[rp].configurable
            }
            rp = rp + 1
        }
    }
    st.objExtras[de].taBuf = st.objExtras[se].taBuf
    st.objExtras[de].taKind = st.objExtras[se].taKind
    st.objExtras[de].taOffset = st.objExtras[se].taOffset
    st.objExtras[de].taLen = st.objExtras[se].taLen
    st.objExtras[de].taTracking = st.objExtras[se].taTracking
    st.objExtras[de].abMaxLen = st.objExtras[se].abMaxLen
    // A promise's pending reactions belong to the object that will be handed to
    // user code, so they move with the state rather than being left behind on a
    // throwaway nothing references.
    st.objExtras[de].reactions = replace(st.objExtras[se].reactions, Vec.new())
    st.objects[src].promiseState = 0 - 1
}

// A shallow copy of a value vector, since the source object is discarded right
// after and its slots must not be shared.
fn cloneValueVec(v: &Vec<JSValue>): Vec<JSValue> {
    var out: Vec<JSValue> = Vec.new()
    var i: i64 = 0
    while i < v.len() {
        out.push(cloneValue(v[i]))
        i = i + 1
    }
    return out
}

pub fn constructValue(prog: &Prog, st: &mut Interp, ctor: &JSValue, argVals: Vec<JSValue>, newTarget: &JSValue): JSValue {
    let co = objHandle(ctor)
    if co >= 0 && st.objects[co].isProxy {
        if !valueIsConstructor(prog, st, ctor) {
            return throwErr(&mut st, "TypeError", "proxy is not a constructor")
        }
        let trap = proxyTrapChecked(prog, &mut st, co, "construct")
        if st.throwing {
            return JSValue.Undefined
        }
        let target = proxyTargetOf(st, co)
        if isUndefinedValue(trap) {
            return constructValue(prog, &mut st, target, argVals, newTarget)
        }
        let arr = newArray(&mut st)
        pushTemp(&mut st, JSValue.Obj(arr))
        var ai: i64 = 0
        while ai < argVals.len() {
            st.objects[arr].elems.push(cloneValue(argVals[ai]))
            ai = ai + 1
        }
        var targs: Vec<JSValue> = Vec.new()
        targs.push(cloneValue(target))
        targs.push(JSValue.Obj(arr))
        targs.push(cloneValue(newTarget))
        let cr = callTrap(prog, &mut st, co, trap, targs)
        popTemp(&mut st)
        if st.throwing {
            return JSValue.Undefined
        }
        // a construct trap must answer an object; returning a primitive is a
        // TypeError rather than a silent `this`
        if !isObjectValue(&mut st, cr) {
            return throwErr(&mut st, "TypeError", "'construct' on proxy: trap returned non-object")
        }
        return cr
    }
    match ctor {
        JSValue.Func(_tf, _te, _tfo) => {
            // OrdinaryCreateFromConstructor takes the prototype from newTarget,
            // which is the only thing a differing newTarget changes. For an
            // ordinary function it is read BEFORE the body runs, so a `prototype`
            // getter that throws beats anything the body would have done.
            let protoFromNewTarget = newTargetProto(prog, &mut st, ctor, newTarget)
            if st.throwing {
                return JSValue.Undefined
            }
            let fproto = funcPrototypeObj(&mut st, ctor)
            let inst = newObject(&mut st)
            if protoFromNewTarget >= 0 {
                st.objects[inst].proto = protoFromNewTarget
            } else {
                st.objects[inst].proto = fproto
            }
            pushTemp(&mut st, JSValue.Obj(inst))
            let saved = cloneValue(st.newTarget)
            st.newTarget = cloneValue(newTarget)
            let res = callFunction(prog, ctor, argVals, JSValue.Obj(inst), &mut st)
            st.newTarget = saved
            popTemp(&mut st)
            match res {
                JSValue.Obj(ro) => {
                    return JSValue.Obj(ro)
                }
                _ => {
                    return JSValue.Obj(inst)
                }
            }
        }
        JSValue.Native(nid) => {
            // a builtin constructor makes its OWN instance (an Array, a Date, a
            // wrapper); handing it a fresh plain object as `this` would produce
            // an ordinary object wearing the right prototype and nothing else
            let r = callNativeProg(prog, nid, argVals, &mut st)
            if st.throwing {
                return JSValue.Undefined
            }
            var out = r
            if !isObjectValue(&mut st, out) {
                out = makeWrapper(&mut st, out)
            }
            // AFTER the builtin ran: a built-in constructor validates its
            // arguments before OrdinaryCreateFromConstructor, so
            // `Reflect.construct(Promise, [], badNewTarget)` reports the missing
            // executor rather than whatever the newTarget's `prototype` getter throws
            let protoFromNewTarget = newTargetProto(prog, &mut st, ctor, newTarget)
            if st.throwing {
                return JSValue.Undefined
            }
            let rh = objHandle(out)
            if rh >= 0 && protoFromNewTarget >= 0 {
                st.objects[rh].proto = protoFromNewTarget
            }
            return out
        }
        _ => {
        }
    }
    // Everything left is a built-in constructor object (Array, Promise, a napi
    // class). Like the Native branch above, they validate their arguments before
    // OrdinaryCreateFromConstructor, so the newTarget `prototype` read comes
    // AFTER the construction rather than before it.
    if co >= 0 && isPromiseCtor(st, co) {
        let pv = constructPromise(prog, &mut st, argVals)
        if st.throwing {
            return JSValue.Undefined
        }
        pushTemp(&mut st, cloneValue(pv))
        let pp = newTargetProto(prog, &mut st, ctor, newTarget)
        popTemp(&mut st)
        if st.throwing {
            return JSValue.Undefined
        }
        let pvh = objHandle(pv)
        if pvh >= 0 && pp >= 0 {
            st.objects[pvh].proto = pp
        }
        return pv
    }
    if co >= 0 && co == st.arrayCtorObj {
        let av = makeArrayFromCtor(&mut st, argVals)
        pushTemp(&mut st, cloneValue(av))
        let ap = newTargetProto(prog, &mut st, ctor, newTarget)
        popTemp(&mut st)
        if st.throwing {
            return JSValue.Undefined
        }
        let ah = objHandle(av)
        if ah >= 0 && ap >= 0 {
            st.objects[ah].proto = ap
        }
        return av
    }
    let inst = newObject(&mut st)
    let th = propertyBagOf(&mut st, ctor)
    if th >= 0 {
        if let JSValue.Obj(pr) = getMemberDyn(prog, th, "prototype", &mut st) {
            st.objects[inst].proto = pr
        }
    }
    if st.throwing {
        return JSValue.Undefined
    }
    pushTemp(&mut st, JSValue.Obj(inst))
    let saved = cloneValue(st.newTarget)
    st.newTarget = cloneValue(newTarget)
    let cr = callValue(prog, ctor, argVals, JSValue.Obj(inst), &mut st)
    st.newTarget = saved
    var out = JSValue.Obj(inst)
    if let JSValue.Obj(ro) = cr {
        out = JSValue.Obj(ro)
    }
    popTemp(&mut st)
    if st.throwing {
        return JSValue.Undefined
    }
    pushTemp(&mut st, cloneValue(out))
    let protoFromNewTarget = newTargetProto(prog, &mut st, ctor, newTarget)
    popTemp(&mut st)
    if st.throwing {
        return JSValue.Undefined
    }
    let oh = objHandle(out)
    if oh >= 0 && protoFromNewTarget >= 0 {
        st.objects[oh].proto = protoFromNewTarget
    }
    return out
}

// Reflect.get's third argument: the receiver a getter runs with. Plain member
// access always passes the object it read through, so this cannot go through
// getMemberDyn — the whole point of the argument is to differ from the target.
fn reflectGet(prog: &Prog, st: &mut Interp, target: &JSValue, key: &string, receiver: &JSValue): JSValue {
    // Copied out of the AST before anything below can re-enter the
    // interpreter and move the program storage this reference points into.
    let keyCopy = key.clone()
    let o = objHandle(target)
    if o >= 0 && st.objects[o].isProxy {
        let trap = proxyTrapChecked(prog, &mut st, o, "get")
        if st.throwing {
            return JSValue.Undefined
        }
        let tv = proxyTargetOf(st, o)
        if isUndefinedValue(trap) {
            return reflectGet(prog, &mut st, tv, keyCopy, receiver)
        }
        var args: Vec<JSValue> = Vec.new()
        args.push(cloneValue(tv))
        args.push(propKeyValue(keyCopy))
        args.push(cloneValue(receiver))
        let r = callTrap(prog, &mut st, o, trap, args)
        if st.throwing {
            return JSValue.Undefined
        }
        checkProxyGetResult(prog, &mut st, tv, keyCopy, r)
        if st.throwing {
            return JSValue.Undefined
        }
        return r
    }
    var cur = propertyBagOf(&mut st, target)
    while cur >= 0 {
        let pi = objOwnIndex(st, cur, keyCopy)
        if pi >= 0 {
            if propIsAccessor(st, cur, pi) {
                let getter = accGetter(st, st.objects[cur].props[pi].acc)
                if !isCallableIn(st, getter) {
                    return JSValue.Undefined
                }
                var gargs: Vec<JSValue> = Vec.new()
                return callValue(prog, getter, gargs, cloneValue(receiver), &mut st)
            }
            return cloneValue(st.objects[cur].props[pi].value)
        }
        cur = protoOfHandle(st, cur)
    }
    // no ordinary property found: the exotic reads (a string's length, a
    // builtin method) still live behind the member path
    let bag = propertyBagOf(&mut st, target)
    if bag >= 0 {
        return getMemberDyn(prog, bag, keyCopy, &mut st)
    }
    return JSValue.Undefined
}

// Reflect.set. Two things plain assignment cannot express: the write lands on
// `receiver` rather than on the target, and a rejected write is reported as
// `false` instead of being silently dropped or thrown.
fn reflectSet(prog: &Prog, st: &mut Interp, target: &JSValue, key: &string, v: &JSValue, receiver: &JSValue): bool {
    // Copied out of the AST before anything below can re-enter the
    // interpreter and move the program storage this reference points into.
    let keyCopy = key.clone()
    let o = objHandle(target)
    if o >= 0 && st.objects[o].isProxy {
        let trap = proxyTrapChecked(prog, &mut st, o, "set")
        if st.throwing {
            return false
        }
        let tv = proxyTargetOf(st, o)
        if isUndefinedValue(trap) {
            return reflectSet(prog, &mut st, tv, keyCopy, v, receiver)
        }
        var args: Vec<JSValue> = Vec.new()
        args.push(cloneValue(tv))
        args.push(propKeyValue(keyCopy))
        args.push(cloneValue(v))
        args.push(cloneValue(receiver))
        let r = callTrap(prog, &mut st, o, trap, args)
        if st.throwing {
            return false
        }
        if !truthy(r) {
            return false
        }
        checkProxySetResult(prog, &mut st, tv, keyCopy, v)
        return !st.throwing
    }
    var cur = propertyBagOf(&mut st, target)
    while cur >= 0 {
        let pi = objOwnIndex(st, cur, keyCopy)
        if pi >= 0 {
            if propIsAccessor(st, cur, pi) {
                let setter = accSetter(st, st.objects[cur].props[pi].acc)
                if !isCallableIn(st, setter) {
                    return false
                }
                var sargs: Vec<JSValue> = Vec.new()
                sargs.push(cloneValue(v))
                let _r = callValue(prog, setter, sargs, cloneValue(receiver), &mut st)
                return !st.throwing
            }
            if !st.objects[cur].props[pi].writable || st.objects[cur].frozen {
                return false
            }
            // a data property found on the chain does NOT get written in place:
            // the write always lands on the receiver as its own property
            cur = -1
        } else {
            cur = protoOfHandle(st, cur)
        }
    }
    let rh = propertyBagOf(&mut st, receiver)
    if rh < 0 {
        return false
    }
    // A proxy receiver takes the write as a [[DefineOwnProperty]], not as
    // another [[Set]]: re-entering [[Set]] here would loop forever whenever the
    // receiver is the proxy the write started from.
    if st.objects[rh].isProxy {
        let ed = getOwnPropDescOf(prog, &mut st, receiver, keyCopy)
        if st.throwing {
            return false
        }
        let edh = objHandle(ed)
        if edh >= 0 {
            if objHasInChain(st, edh, "get") || objHasInChain(st, edh, "set") {
                return false
            }
            if !truthy(getMember(st, edh, "writable")) {
                return false
            }
        }
        let nd = newObject(&mut st)
        pushTemp(&mut st, JSValue.Obj(nd))
        objSet(&mut st, nd, "value", cloneValue(v))
        if edh < 0 {
            objSet(&mut st, nd, "writable", JSValue.Bool(true))
            objSet(&mut st, nd, "enumerable", JSValue.Bool(true))
            objSet(&mut st, nd, "configurable", JSValue.Bool(true))
        }
        popTemp(&mut st)
        return definePropOf(prog, &mut st, receiver, keyCopy, nd)
    }
    if st.objects[rh].frozen {
        return false
    }
    let ri = objOwnIndex(st, rh, keyCopy)
    if ri >= 0 {
        if propIsAccessor(st, rh, ri) || !st.objects[rh].props[ri].writable {
            return false
        }
    } else if st.objects[rh].noExtend || st.objects[rh].sealed {
        // the array fast path below still has to honour non-extensibility
        if !(st.objects[rh].isArray && asArrayIndex(keyCopy) >= 0 && asArrayIndex(keyCopy) < arrLen(st, rh)) {
            return false
        }
    }
    if st.objects[rh].isArray {
        let ai = asArrayIndex(keyCopy)
        if ai >= 0 {
            arrSet(&mut st, rh, ai, cloneValue(v))
            return true
        }
    }
    setMemberDyn(prog, rh, keyCopy.clone(), cloneValue(v), &mut st)
    return !st.throwing
}

// [[OwnPropertyKeys]] over any value, as raw keys — symbols included, in the
// symKey spelling they are stored under. A proxy consults its ownKeys trap
// and with no trap forwards to its target, which may itself be a proxy.
// The ONE answer to "which own string keys does this object have, and which of
// them are enumerable", in [[OwnPropertyKeys]] order: integer indices first, then
// `length` for an array, then the remaining string properties in insertion order.
//
// It exists because that question was answered independently in five places --
// ownKeysOf, Object.keys, Object.values/entries, for-in, and (through for-in) the
// JS-level JSON.stringify -- each with its own idea of which representations
// carry keys. When typed arrays grew index enumeration, four of the five were
// still wrong, in four different ways. A new representation should have to be
// taught this once.
//
// Reads `st` only: no descriptors are built, no getters run, nothing is allocated
// on the JS heap. That is what lets the hot callers (Object.keys, for-in) use it.
// `enumOut` and `propOut` are filled in step with the returned keys: `propOut` is
// the key's index in the object's property table, or -1 when the key came from
// the element vector or a typed array's buffer. Callers need that to avoid
// re-deriving it -- for-in wants only the keys the property table cannot hold,
// and Object.values wants to read a data property's slot directly rather than
// going through a full [[Get]]. Without it both paid a lookup per key and
// enumeration ran 40% slower.
pub fn ownStringKeys(st: &Interp, h: i64, enumOut: &mut Vec<bool>, propOut: &mut Vec<i64>): Vec<string> {
    var out: Vec<string> = Vec.new()
    if h < 0 {
        return out
    }
    if st.objects[h].isArray {
        var e: i64 = 0
        while e < arrLen(st, h) {
            if !arrIsHole(st, h, e) {
                let ekey = i64ToStr(e)
                // An index can be in the element vector AND the property table at
                // once (`const a = [1]; a[3] = 4`). It is emitted here, in index
                // order, but it must still REPORT its property-table slot: for-in
                // takes the property keys from its own chain walk, and without
                // this the key came out twice. Only looked up when the array has
                // any properties at all, which most do not.
                var eprop: i64 = -1
                if st.objects[h].props.len() > 0 {
                    eprop = objOwnIndex(st, h, ekey.clone())
                }
                out.push(ekey)
                enumOut.push(true)
                propOut.push(eprop)
            }
            e = e + 1
        }
        // `length` is an own property of an array and is NOT enumerable, so it
        // belongs in getOwnPropertyNames and nowhere else.
        out.push("length")
        enumOut.push(false)
        propOut.push(-1)
    }
    // A typed array's indices live in the buffer rather than the property table.
    // There is no `length` among them: that is an accessor on the prototype.
    if !st.objects[h].isDataView {
        let tlen = taCurrentLen(st, h)
        var te: i64 = 0
        while te < tlen {
            out.push(i64ToStr(te))
            enumOut.push(true)
            propOut.push(-1)
            te = te + 1
        }
    }
    let order = enumOrder(st, h)
    var oi: i64 = 0
    while oi < order.len() {
        let k = order[oi]
        oi = oi + 1
        let pkey = st.objects[h].props[k].key.clone()
        // An index of a SPARSE array can live in BOTH the element vector and the
        // property table -- `const a = [1]; a[3] = 4` leaves 3 in each -- and the
        // element loop above already emitted it. Only checked for a key that looks
        // like an index, so an ordinary object pays nothing.
        if st.objects[h].isArray && asArrayIndex(pkey) >= 0 && vecHasStr(out, pkey) {
            continue
        }
        out.push(pkey)
        enumOut.push(st.objects[h].props[k].enumerable)
        propOut.push(k)
    }
    return out
}

pub fn ownKeysOf(prog: &Prog, st: &mut Interp, v: &JSValue): Vec<string> {
    var out: Vec<string> = Vec.new()
    let o = objHandle(v)
    if o >= 0 && st.objects[o].isProxy {
        let trap = proxyTrapChecked(prog, &mut st, o, "ownKeys")
        if st.throwing {
            return out
        }
        let target = proxyTargetOf(st, o)
        if isUndefinedValue(trap) {
            return ownKeysOf(prog, &mut st, target)
        }
        var args: Vec<JSValue> = Vec.new()
        args.push(cloneValue(target))
        let res = callTrap(prog, &mut st, o, trap, args)
        if st.throwing {
            return out
        }
        let rh = objHandle(res)
        if rh < 0 || !st.objects[rh].isArray {
            let _t = throwErr(&mut st, "TypeError", "CreateListFromArrayLike called on non-object")
            return out
        }
        var i: i64 = 0
        while i < arrLen(st, rh) {
            let kv = arrGet(st, rh, i)
            match cloneValue(kv) {
                JSValue.Str(s) => {
                    out.push(s)
                }
                JSValue.Sym(sid) => {
                    out.push(symKey(sid))
                }
                _ => {
                    let _t = throwErr(&mut st, "TypeError", "'ownKeys' on proxy: trap result must contain only string and symbol keys")
                    return out
                }
            }
            i = i + 1
        }
        var di: i64 = 0
        while di < out.len() {
            var dj = di + 1
            while dj < out.len() {
                if out[di] == out[dj] {
                    let _t = throwErr(&mut st, "TypeError", "'ownKeys' on proxy: trap returned duplicate entries")
                    return out
                }
                dj = dj + 1
            }
            di = di + 1
        }
        // the trap may not hide a key the target cannot lose, nor invent one a
        // non-extensible target cannot gain
        let tkeys = ownKeysOf(prog, &mut st, target)
        if st.throwing {
            return out
        }
        let ext = isExtensibleOf(prog, &mut st, target)
        if st.throwing {
            return out
        }
        var ki: i64 = 0
        while ki < tkeys.len() {
            var required = !ext
            if !required {
                let td = getOwnPropDescOf(prog, &mut st, target, tkeys[ki])
                if st.throwing {
                    return out
                }
                let tdh = objHandle(td)
                required = tdh >= 0 && !truthy(getMember(st, tdh, "configurable"))
            }
            if required && !vecHasStr(out, tkeys[ki]) {
                let _t = throwErr(&mut st, "TypeError", "'ownKeys' on proxy: trap result did not include '" + tkeys[ki].clone() + "'")
                return out
            }
            ki = ki + 1
        }
        if !ext {
            var oi2: i64 = 0
            while oi2 < out.len() {
                if !vecHasStr(tkeys, out[oi2]) {
                    let _t = throwErr(&mut st, "TypeError", "'ownKeys' on proxy: trap returned extra keys but the proxy target is non-extensible")
                    return out
                }
                oi2 = oi2 + 1
            }
        }
        return out
    }
    let h = propertyBagOf(&mut st, v)
    if h >= 0 {
        var keyEnum: Vec<bool> = Vec.new()
        var keyProp: Vec<i64> = Vec.new()
        let skeys = ownStringKeys(st, h, &mut keyEnum, &mut keyProp)
        var si: i64 = 0
        while si < skeys.len() {
            out.push(skeys[si].clone())
            si = si + 1
        }
        // enumOrder deliberately skips symbol keys; [[OwnPropertyKeys]] lists
        // them, after every string key
        var pi: i64 = 0
        while pi < st.objects[h].props.len() {
            let k = st.objects[h].props[pi].key.clone()
            if isSymbolKey(k) {
                out.push(k)
            }
            pi = pi + 1
        }
    }
    return out
}

// Enumerable own string keys of a proxy: the ownKeys trap supplies the list,
// then each key is kept only if its descriptor (getOwnPropertyDescriptor trap,
// falling back to the target's own descriptor) says enumerable. Missing ownKeys
// forwards to the target. Feeds for-in and Object.keys.
fn proxyOwnEnumKeys(prog: &Prog, st: &mut Interp, o: i64): Vec<string> {
    var out: Vec<string> = Vec.new()
    let self = JSValue.Obj(o)
    let keyList = ownKeysOf(prog, &mut st, self)
    if st.throwing {
        return out
    }
    var i: i64 = 0
    while i < keyList.len() {
        if !isSymbolKey(keyList[i]) {
            let d = getOwnPropDescOf(prog, &mut st, self, keyList[i])
            if st.throwing {
                return out
            }
            let dh = objHandle(d)
            if dh >= 0 && truthy(getMember(st, dh, "enumerable")) {
                out.push(keyList[i].clone())
            }
        }
        i = i + 1
    }
    return out
}

// Raise `kind` with `msg` and yield undefined, the shape every throwing arm
// returns. A JS throw travels on st.throwing/st.thrownValue, not on a Result,
// so this is the one spelling of "set the flag and bail".
pub fn throwErr(st: &mut Interp, kind: string, msg: string): JSValue {
    st.throwing = true
    st.thrownValue = makeError(&mut st, kind, msg)
    return JSValue.Undefined
}

pub fn makeError(st: &mut Interp, kind: string, msg: string): JSValue {
    let o = newObject(&mut st)
    st.objects[o].isError = true
    // the prototype set below supplies `name`; an own one would show up in
    // Object.getOwnPropertyNames, where node reports only stack and message
    objSet(&mut st, o, "message", JSValue.Str(msg.clone()))
    // a string stack (headed "Name: message") so a caught runtime error's .stack
    // is a string, like a constructed Error's — no real backtrace available
    var stackHead = kind.clone()
    if msg.len() > 0 {
        stackHead = stackHead + ": " + msg
    }
    objSet(&mut st, o, "stack", JSValue.Str(stackHead + errorStackFrames(st)))
    // same prototype a constructed error of this kind gets, so a caught runtime
    // TypeError answers e.constructor and getPrototypeOf the way a thrown one does
    let ep = errorProtoFor(&mut st, errorCtorIdFor(kind))
    if ep >= 0 {
        st.objects[o].proto = ep
    }
    objSetNonEnumerable(&mut st, o, "message")
    objSetNonEnumerable(&mut st, o, "stack")
    return JSValue.Obj(o)
}

pub fn isSymbolValue(v: &JSValue): bool {
    return symIdOf(v) >= 0
}

// The symbol id of v, or -1 when v is not a symbol.
pub fn symIdOf(v: &JSValue): i64 {
    match v {
        JSValue.Sym(id) => {
            return id
        }
        _ => {
            return -1
        }
    }
}

// A Symbol.prototype method applied to the primitive `id`. valueOf and
// @@toPrimitive answer the symbol itself; that is what makes `obj[Object(sym)]`
// the symbol's own key rather than its display string.
fn isSymbolMethodName(name: &string): bool {
    return name == "toString" || name == "valueOf" || name == "description" || name == symToPrimitiveKey()
}

fn symbolMethod(st: &mut Interp, id: i64, name: &string): JSValue {
    if name == "toString" {
        return JSValue.Str(symbolDisplay(st, id))
    }
    if name == "valueOf" || name == symToPrimitiveKey() {
        return JSValue.Sym(id)
    }
    if name == "description" {
        return symDescValue(st, id)
    }
    return JSValue.Undefined
}

// ToPropertyKey for a computed member key. A primitive WRAPPER unwraps, which is
// what makes `o[Object(sym)]` the symbol's own key; any other object still
// takes toStr's "[object Object]" without running a user toString (see
// docs/backlog.md).
pub fn toPropertyKey(st: &Interp, v: &JSValue): string {
    let h = objHandle(v)
    if h >= 0 && isWrapperObj(st, h) {
        return toStr(boxedPrimitive(st, h))
    }
    return toStr(v)
}

// SetFunctionName's spelling of a property key: a symbol-keyed method is named
// "[desc]", or "" for a symbol with no description.
pub fn keyFunctionName(st: &Interp, key: &string): string {
    let id = symIdOfKey(key)
    if id < 0 {
        return key.clone()
    }
    if !st.symHasDesc[id] {
        return ""
    }
    return "[" + st.symDescs[id] + "]"
}

fn symAsyncIteratorKey(): string {
    return symKey(WK_ASYNC_ITERATOR)
}

pub fn symIteratorKey(): string {
    return symKey(WK_ITERATOR)
}

pub fn symToPrimitiveKey(): string {
    return symKey(WK_TO_PRIMITIVE)
}

pub fn symToStringTagKey(): string {
    return symKey(WK_TO_STRING_TAG)
}

fn serviceFetches(st: &mut Interp) {
    var i: i64 = 0
    while i < st.fetches.len() {
        var done = false
        var payload = ""
        if let Option.Some(v) = st.fetches[i].chan.tryRecv() {
            payload = v
            done = true
        }
        if done {
            let p = st.fetches[i].promise
            st.fetches.remove(i)
            settlePromise(&mut st, p, 1, JSValue.Str(payload))
        } else {
            i = i + 1
        }
    }
}

fn hasPendingFetches(st: &Interp): bool {
    return st.fetches.len() > 0
}

fn napiServiceTsfn(st: &mut Interp) {
    if !napiHasTsfn() {
        return
    }
    var q = napiPollTsfn()
    var i: i64 = 0
    while i < q.len() {
        let _r = napiRunTsfnCall(q[i])
        i = i + 1
    }
    napiDrainSettlements(&mut st)
}

// Apply promise settlements an addon requested while it held control.
fn napiDrainSettlements(st: &mut Interp) {
    var q = napiTakePending()
    var i: i64 = 0
    while i < q.len() {
        settlePromise(&mut st, q[i].promise, q[i].state, cloneValue(q[i].value))
        i = i + 1
    }
}

// Let the caller of this activation continue. Called at the activation's first
// suspension point, and at completion if it never suspends — an async call
// returns once its body reaches the first await, not when the body finishes.
fn releaseCreatorOnce(st: &mut Interp) {
    let me = schedulerCurrent()
    if me as i64 == 0 {
        return
    }
    var i: i64 = 0
    while i < st.actTask.len() {
        if st.actTask[i] as i64 == me as i64 {
            if !st.actNotified[i] {
                st.actNotified[i] = true
                schedulerUnpark(st.actCreator[i])
            }
            return
        }
        i = i + 1
    }
}

fn endActivation(st: &mut Interp) {
    let me = schedulerCurrent()
    if me as i64 == 0 {
        return
    }
    var i: i64 = 0
    while i < st.actTask.len() {
        if st.actTask[i] as i64 == me as i64 {
            st.actTask.remove(i)
            st.actCreator.remove(i)
            st.actNotified.remove(i)
            st.actFn.remove(i)
            st.actArgs.remove(i)
            st.actThis.remove(i)
            st.actPromise.remove(i)
            return
        }
        i = i + 1
    }
}

// R1: run an async body on its own green task and hand the caller a pending
// promise as soon as that body reaches its first await.
//
// The caller parks straight after spawning. Tasks are cooperative and only one
// runs at a time, so the body cannot start before that park — there is no race
// between spawning and waiting.
fn spawnActivation(callee: &JSValue, argVals: Vec<JSValue>, thisVal: JSValue, st: &mut Interp, caller: *u8): JSValue {
    let p = newPromise(&mut st, 0, JSValue.Undefined)
    var rootedArgs: Vec<JSValue> = Vec.new()
    var ri: i64 = 0
    while ri < argVals.len() {
        rootedArgs.push(cloneValue(argVals[ri]))
        ri = ri + 1
    }
    let rootedThis = cloneValue(thisVal)
    var args = argVals
    let taskCallee = cloneValue(callee)
    let body = Task.spawnWithStack(move(): void => {
        // gProg/gInterp rather than captured references: a task body cannot hold
        // a borrow from the frame that spawned it (docs/proposal-task-shared-state.md)
        gInterp.suppressAsyncSpawn = true
        let r = callFunction(gProg, taskCallee, args, thisVal, &mut gInterp)
        if gInterp.throwing {
            let err = cloneValue(gInterp.thrownValue)
            gInterp.throwing = false
            gInterp.thrownValue = JSValue.Undefined
            settlePromise(&mut gInterp, p, 2, err)
        } else {
            let ro = objHandle(r)
            if ro >= 0 && isPromise(gInterp, ro) {
                let rs = gInterp.objects[ro].promiseState
                if rs == 0 {
                    // The body returned a still-pending promise (e.g. `return
                    // fetchData(url).then(...)`). Reading its state now settles the
                    // activation's promise with `pending`, which is a no-op — the
                    // caller's await then hangs forever. Instead adopt it: a
                    // reaction with non-callable handlers passes the returned
                    // promise's eventual settlement straight through to `p`.
                    gInterp.objExtras[gInterp.objects[ro].extra].reactions.push(Reaction {
                        onFulfilled: JSValue.Undefined, onRejected: JSValue.Undefined, derived: p, isFinally: false
                    }
                    )
                } else {
                    // the inner promise's settlement is forwarded to the
                    // activation promise, so it is handled — clear it from the
                    // unhandled set (a throwing async body wraps its rejection in
                    // a fresh newPromise(2) that was flagged unhandled at birth;
                    // without this a caught `await asyncThatThrows()` printed a
                    // spurious "unhandled promise rejection")
                    if rs == 2 {
                        markRejectHandled(&mut gInterp, ro)
                    }
                    settlePromise(&mut gInterp, p, rs, cloneValue(gInterp.objExtras[gInterp.objects[ro].extra].promiseValue))
                }
            } else {
                settlePromise(&mut gInterp, p, 1, r)
            }
        }
        // a body that never awaited still has to let its caller go
        releaseCreatorOnce(&mut gInterp)
        endActivation(&mut gInterp)
    }
    , 8388608)
    st.actTask.push(body.raw())
    st.actCreator.push(caller)
    st.actNotified.push(false)
    st.actFn.push(cloneValue(callee))
    st.actArgs.push(rootedArgs)
    st.actThis.push(rootedThis)
    st.actPromise.push(p)
    // Root the activation's promise across the park: until this task resumes
    // and its caller binds the returned value, `p` is held only by native
    // locals and the body closure — neither is a GC root — so a collect while
    // the body runs sweeps it and recycles the slot. Observed as awaits
    // resolving with foreign values ("json is not a function") or never
    // (reaction list wiped on reuse) under concurrent fetches. Pushed before
    // saveExecCtx so it rides in the suspended ctx that collect marks.
    pushTemp(&mut st, JSValue.Obj(p))
    // the body runs while this task is parked; it unparks us at its first await
    let ctx = saveExecCtx(&mut st)
    st.suspended.push(ctx)
    st.suspendedTask.push(caller)
    schedulerPark()
    resumeExecCtx(&mut st, caller)
    popTemp(&mut st)
    return JSValue.Obj(p)
}

// Take back the execution belonging to `task`, wherever it sits in the parked
// set. Parks and wakes interleave, so position says nothing about ownership.
pub fn resumeExecCtx(st: &mut Interp, task: *u8) {
    var i: i64 = 0
    while i < st.suspendedTask.len() {
        if st.suspendedTask[i] as i64 == task as i64 {
            let back = st.suspended.remove(i)
            st.suspendedTask.remove(i)
            restoreExecCtx(&mut st, back)
            return
        }
        i = i + 1
    }
}

// R2 of docs/milojs-async-suspension.md. Park the running activation until
// `p` settles. Only legal off the main task: the main task runs the event loop,
// so parking it would stop the timers and off-thread servicing that settle
// promises in the first place — that path still drains in place.
//
// Returns false when parking is not possible, so the caller can fall back.
// A settled `await` still yields to the microtask queue in node (the continuation
// is queued as a microtask). Run the microtasks pending RIGHT NOW — a snapshot,
// so ones they queue run after this await, matching node — inline: no park, so
// the activation's own ExecCtx (tempRoots/active scopes) stays live in the Interp
// and rooted (the reverted R1a attempt bypassed that by yielding the task). Only
// on an activation task; the main event-loop task drains microtasks itself.
fn awaitYieldMicrotasks(prog: &Prog, st: &mut Interp) {
    let me = schedulerCurrent()
    if me as i64 == 0 || me as i64 == st.mainTask as i64 {
        return
    }
    let snap = st.microtasks.len()
    if snap > 0 {
        drainMicrotasks(prog, &mut st, snap)
    }
}

pub fn parkOnPromise(st: &mut Interp, p: i64): bool {
    let me = schedulerCurrent()
    if me as i64 == 0 || me as i64 == st.mainTask as i64 {
        return false
    }
    // Already settled: there is nothing to wait for, and parking would be
    // permanent — the wake happens at settle time, which has passed.
    if st.objects[p].promiseState != 0 {
        return true
    }
    // reaching an await is what makes the async call return to its caller
    releaseCreatorOnce(&mut st)
    st.awaitPromise.push(p)
    st.awaitTask.push(me)
    // the activation's execution leaves the Interp with it; whoever runs next
    // starts clean, and collect keeps these roots alive (R6, R7)
    let ctx = saveExecCtx(&mut st)
    st.suspended.push(ctx)
    st.suspendedTask.push(me)
    schedulerPark()
    // Resumed: take back OUR execution, found by task identity. Taking the last
    // entry instead hands this activation someone else's state — its pops then
    // unroot that activation's scopes and the collector sweeps frames that are
    // still live, which surfaces later as an identifier that no longer resolves.
    resumeExecCtx(&mut st, me)
    return true
}

// ── generators ──────────────────────────────────────────────────────────────
// A `function*` call returns a generator object whose body runs on its own green
// task, reusing the async-suspension machinery: `yield` and `next()` hand control
// back and forth via schedulerPark/Unpark + the ExecCtx save/restore that the
// `suspended` set already does. The body task is spawned LAZILY on the first
// next(), which is what keeps a fresh generator paused — calling a gen* runs no
// user code. Because each generator body has its own dedicated task, `yield`
// finds its generator by schedulerCurrent()==genTask; no per-task current-gen
// stack is needed even for nested generators (a design simplification over
// docs/milojs-generators.md, which assumed a shared task).

// True if any generator has been started but not run to completion, so its body
// task is parked forever. Such a task keeps the scheduler's task count > 0, which
// would block main's final -1 poll and hang the process at exit — Node instead
// drops an unfinished generator, so the entry point exits directly when this holds.
pub fn anyGenParked(st: &Interp): bool {
    var i: i64 = 0
    while i < st.genObj.len() {
        if st.genStarted[i] && !st.genDone[i] {
            return true
        }
        i = i + 1
    }
    return false
}

// Drop a completed generator's record. Left in place, its stale body-task
// pointer would collide with a future generator whose freshly-spawned task
// reuses the same freed address — genIndexOfTask would then resolve `yield` to
// the wrong (dead) record and write the yielded value into the wrong slot, so
// the real consumer reads a stale value. Object indices of removed generators
// are free to be recycled since collect no longer marks them.
fn removeGen(st: &mut Interp, gi: i64) {
    st.genObj.remove(gi)
    st.genFn.remove(gi)
    st.genTask.remove(gi)
    st.genEnv.remove(gi)
    st.genScope.remove(gi)
    st.genArgs.remove(gi)
    st.genThis.remove(gi)
    st.genYielded.remove(gi)
    st.genSent.remove(gi)
    st.genAsync.remove(gi)
    st.genResumeMode.remove(gi)
    st.genDone.remove(gi)
    st.genThrew.remove(gi)
    st.genErr.remove(gi)
    st.genCaller.remove(gi)
    st.genStarted.remove(gi)
}

// Index of the gen* record for gen object `o`, or -1.
fn genIndexOf(st: &Interp, o: i64): i64 {
    var i: i64 = 0
    while i < st.genObj.len() {
        if st.genObj[i] == o {
            return i
        }
        i = i + 1
    }
    return -1
}

// Index of the gen* record whose body task is `task`, or -1 — how `yield`
// resolves which generator it belongs to.
fn genIndexOfTask(st: &Interp, task: *u8): i64 {
    var i: i64 = 0
    while i < st.genTask.len() {
        if st.genTask[i] as i64 == task as i64 {
            return i
        }
        i = i + 1
    }
    return -1
}

// Build a `{ value, done }` iterator-result object.
fn iterResult(st: &mut Interp, value: JSValue, done: bool): JSValue {
    let r = newObject(&mut st)
    pushTemp(&mut st, JSValue.Obj(r))
    objSet(&mut st, r, "value", value)
    objSet(&mut st, r, "done", JSValue.Bool(done))
    popTemp(&mut st)
    return JSValue.Obj(r)
}

// Called when a generator body finishes (return or fell off the end). Records the
// return value (or the thrown error), marks it done, and hands control back to
// whoever is inside next(). Runs on the generator's own task.
fn genFinish(st: &mut Interp, gi: i64, r: JSValue) {
    if st.genReturning {
        // the body unwound from a gen.return(v): complete with v, not as a throw
        st.genYielded[gi] = cloneValue(st.thrownValue)
        st.genReturning = false
        st.throwing = false
        st.thrownValue = JSValue.Undefined
        st.genDone[gi] = true
        schedulerUnpark(st.genCaller[gi])
        return
    }
    if st.throwing {
        st.genThrew[gi] = true
        st.genErr[gi] = cloneValue(st.thrownValue)
        st.throwing = false
        st.thrownValue = JSValue.Undefined
        st.genYielded[gi] = JSValue.Undefined
    } else {
        st.genYielded[gi] = cloneValue(r)
    }
    st.genDone[gi] = true
    // hand control back to the next() caller; this task then returns and ends
    schedulerUnpark(st.genCaller[gi])
}

// Create a generator object for a `function*` call. Does NOT run the body — that
// starts on the first next(). Registers the gen* record and returns the object.
// %GeneratorPrototype%, created on first use. It holds nothing but the
// @@toStringTag: `next`/`throw`/`return` are synthesised per generator object and
// resolved before any chain walk. Its own proto is %IteratorPrototype%, which is
// what puts the iterator helpers on every generator.
//
// It exists as a separate level rather than linking straight to
// %IteratorPrototype% because that one tags itself "Iterator", and a generator
// must report "Generator" — util.types.isGeneratorObject reads exactly that.
fn generatorProtoHandle(st: &mut Interp): i64 {
    if st.genProtoObj >= 0 {
        return st.genProtoObj
    }
    let gp = newObject(&mut st)
    // published before the objSet below, which can allocate and collect: until
    // this assignment nothing reaches gp, and collect() marks the field
    st.genProtoObj = gp
    if st.iterProtoObj >= 0 {
        st.objects[gp].proto = st.iterProtoObj
    }
    objSet(&mut st, gp, symToStringTagKey(), JSValue.Str("Generator"))
    objSetNonEnumerable(&mut st, gp, symToStringTagKey())
    return gp
}

fn makeGenerator(callee: &JSValue, argVals: Vec<JSValue>, thisVal: JSValue, isAsync: bool, st: &mut Interp): JSValue {
    let fIdx = funcHandle(callee)
    let envIdx = funcEnv(callee)
    let g = newObject(&mut st)
    st.objects[g].isGenerator = true
    st.objects[g].isAsyncGenerator = isAsync
    // A generator object inherits from its function's `.prototype`, which in turn
    // inherits from %IteratorPrototype% — where the iterator helpers (map, filter,
    // take, drop, flatMap, reduce, toArray, forEach, some, every, find) live.
    // Without the link a generator object had no prototype at all, so
    // `gen().map(f)` was undefined while `[].values().map(f)` worked: every other
    // iterator in the engine already reaches that prototype.
    // A `prototype` that is not an object (reassigned by the program) falls
    // back to %GeneratorPrototype%, as OrdinaryCreateFromConstructor says.
    let gproto = funcPrototypeObj(&mut st, callee)
    if gproto >= 0 {
        st.objects[g].proto = gproto
    } else {
        st.objects[g].proto = generatorProtoHandle(&mut st)
    }
    var rootedArgs: Vec<JSValue> = Vec.new()
    var ri: i64 = 0
    while ri < argVals.len() {
        rootedArgs.push(cloneValue(argVals[ri]))
        ri = ri + 1
    }
    st.genObj.push(g)
    st.genFn.push(fIdx)
    st.genTask.push(0 as *u8)
    st.genEnv.push(envIdx)
    // -1 for now, filled in below. Every parallel array has to be complete before
    // any user code runs: binding the parameters can evaluate a default that
    // creates ANOTHER generator, and that one appends its own entries. Pushing the
    // scope after that call would interleave the two generators' rows.
    st.genScope.push(-1)
    st.genArgs.push(rootedArgs)
    st.genThis.push(cloneValue(thisVal))
    st.genYielded.push(JSValue.Undefined)
    st.genSent.push(JSValue.Undefined)
    st.genAsync.push(isAsync)
    st.genResumeMode.push(0)
    st.genDone.push(false)
    st.genThrew.push(false)
    st.genErr.push(JSValue.Undefined)
    st.genCaller.push(0 as *u8)
    st.genStarted.push(false)
    let gi = st.genObj.len() - 1
    // Bind parameters NOW. The spec's FunctionDeclarationInstantiation runs when a
    // generator is CALLED, so a destructuring failure
    // (`function* f([[x]] = [null]) {}` then `f()`) throws at `f()`, and a
    // parameter default's side effects happen there too — not at the first next(),
    // which is where desugaring them into a body prologue put both.
    //
    // The generator object is rooted across this: a default expression runs user
    // code, which can allocate and collect, and nothing else refers to `g` yet.
    pushTemp(&mut st, JSValue.Obj(g))
    let gscope = bindActivationScope(gProg, callee, argVals, thisVal, &mut st, true)
    st.genScope[gi] = gscope
    if let Option.Some(unpack) = gProg.funcs[fIdx].paramPrelude {
        pushActive(&mut st, gscope)
        let _f = execStmt(gProg, unpack, &mut st, gscope)
        popActive(&mut st)
    }
    popTemp(&mut st)
    return JSValue.Obj(g)
}

// Run a generator's BODY in the activation scope makeGenerator already built.
// callFunction cannot serve here: it would create a SECOND scope and re-bind the
// declared parameters, and for a generator the prelude that unpacks the
// destructured ones is no longer in the body — it ran at the call. The body would
// see those names unbound.
fn runGeneratorBody(prog: &Prog, fIdx: i64, scope: i64, st: &mut Interp): JSValue {
    // The spawner sets these so the body does not spawn a second generator or a
    // second activation for itself. callFunctionBody used to clear them on entry;
    // running the body directly has to do it here, or the flags stay set and the
    // NEXT `gen()` anywhere runs its body inline and returns undefined instead of
    // a generator object.
    st.suppressGenSpawn = false
    st.suppressAsyncSpawn = false
    st.fnFileStack.push(prog.funcs[fIdx].file.clone())
    let savedStrict = st.strict
    st.strict = prog.funcs[fIdx].isStrict
    pushActive(&mut st, scope)
    let bodyBlock = prog.funcs[fIdx].body
    hoistBlock(prog, bodyBlock, &mut st, scope)
    let flow = execBlock(prog, bodyBlock, &mut st, scope)
    runDisposals(prog, &mut st, scope)
    popActive(&mut st)
    st.strict = savedStrict
    let _popped = st.fnFileStack.pop()
    var result = JSValue.Undefined
    if let Flow.Ret(v) = flow {
        result = v
    }
    return result
}

// gen.next(v): drive the generator one step. Spawns the body task on the first
// call. Parks the caller and runs the body until its next `yield`, `return`, or
// throw, then returns `{ value, done }`. If the body threw, the error is
// re-raised at this next() site.
// What next/throw/return yield for a generator with no body left to run.
fn genCompletedResult(arg0: &JSValue, mode: i64, st: &mut Interp): JSValue {
    if mode == 1 {
        // throw() on a completed generator raises at the CALLER — there is no
        // body left that could catch it
        st.throwing = true
        st.thrownValue = cloneValue(arg0)
        return JSValue.Undefined
    }
    if mode == 2 {
        return iterResult(&mut st, cloneValue(arg0), true)
    }
    return iterResult(&mut st, JSValue.Undefined, true)
}

fn genNext(o: i64, args: Vec<JSValue>, st: &mut Interp): JSValue {
    return genResume(o, args, 0, &mut st)
}

// The async-generator wrapper: same drive, but the step comes back as a promise
// (rejected if the body threw), because next/throw/return on an async generator
// are promise-returning.
//
// Divergence from node, deliberate for now: node returns a PENDING promise and
// runs the body afterwards, whereas this drives the body to its next yield
// first and hands back an already-settled promise. Values and ordering within
// the generator are identical; what differs is interleaving with other work
// queued between the next() call and its await.
fn genResumeAsync(o: i64, args: Vec<JSValue>, mode: i64, st: &mut Interp): JSValue {
    let step = genResume(o, args, mode, &mut st)
    if st.throwing {
        let err = cloneValue(st.thrownValue)
        st.throwing = false
        st.thrownValue = JSValue.Undefined
        let rej = newPromise(&mut st, 2, err)
        markRejectHandled(&mut st, rej)
        return JSValue.Obj(rej)
    }
    return JSValue.Obj(newPromise(&mut st, 1, step))
}

// gen.next(v) / gen.throw(e) / gen.return(v), by `mode` (0/1/2). All three drive
// the same parked body; they differ only in how it resumes from its `yield`.
fn genResume(o: i64, args: Vec<JSValue>, mode: i64, st: &mut Interp): JSValue {
    var arg0 = JSValue.Undefined
    if args.len() > 0 {
        arg0 = cloneValue(args[0])
    }
    let gi = genIndexOf(st, o)
    if gi < 0 {
        // No record: a completed generator whose record was reclaimed (calling
        // next() on a done generator yields {done:true} forever in JS), or a
        // genuinely non-generator receiver.
        if o >= 0 && st.objects[o].isGenerator {
            return genCompletedResult(arg0, mode, &mut st)
        }
        return throwErr(&mut st, "TypeError", "not a generator")
    }
    // Never started, or already finished: neither throw() nor return() runs any
    // of the body — there is no `yield` parked to resume from. throw() raises at
    // the caller and return(v) completes with v, both leaving the generator done.
    if st.genDone[gi] || (mode != 0 && !st.genStarted[gi]) {
        st.genDone[gi] = true
        removeGen(&mut st, gi)
        return genCompletedResult(arg0, mode, &mut st)
    }
    let caller = schedulerCurrent()
    if caller as i64 == 0 {
        // no green task to drive the body (engine main thread) — generators need
        // the runtime's task scheduler; see the R1b note in the suspension doc
        return throwErr(&mut st, "TypeError", "generators require the milojs runtime (not the engine)")
    }
    st.genSent[gi] = cloneValue(arg0)
    st.genResumeMode[gi] = mode
    st.genCaller[gi] = caller
    var justSpawned = false
    if !st.genStarted[gi] {
        st.genStarted[gi] = true
        justSpawned = true
        let fIdx = st.genFn[gi]
        let bodyScope = st.genScope[gi]
        let genObjIdx = o
        let body = Task.spawnWithStack(move(): void => {
            // gProg/gInterp: a task body cannot borrow from the spawning frame.
            // Run the function* body (not another makeGenerator) — see callFunction.
            gInterp.suppressGenSpawn = true
            // an async generator's body is already ON a task; without this the
            // isAsync branch would spawn an activation and hand back a promise
            gInterp.suppressAsyncSpawn = true
            let r = runGeneratorBody(gProg, fIdx, bodyScope, &mut gInterp)
            let fgi = genIndexOf(gInterp, genObjIdx)
            if fgi >= 0 {
                genFinish(&mut gInterp, fgi, r)
            }
        }
        , 8388608)
        st.genTask[gi] = body.raw()
    }
    // Root the gen object across the park: its record vectors reference it, but
    // the caller may hold it only in a temp the save/restore does not cover.
    pushTemp(&mut st, JSValue.Obj(o))
    let ctx = saveExecCtx(&mut st)
    st.suspended.push(ctx)
    st.suspendedTask.push(caller)
    // A just-spawned body task is already runnable; parking the caller hands it
    // control (mirrors spawnActivation). Only a body parked at a prior yield
    // needs an explicit unpark to become runnable again.
    if !justSpawned {
        schedulerUnpark(st.genTask[gi])
    }
    schedulerPark()
    resumeExecCtx(&mut st, caller)
    popTemp(&mut st)
    // re-read the record: a nested generator could have shuffled the vectors
    let gj = genIndexOf(st, o)
    if gj < 0 {
        return iterResult(&mut st, JSValue.Undefined, true)
    }
    if st.genThrew[gj] {
        st.throwing = true
        st.thrownValue = cloneValue(st.genErr[gj])
        // the body ended (by throwing); its record is dead
        removeGen(&mut st, gj)
        return JSValue.Undefined
    }
    let done = st.genDone[gj]
    let yielded = cloneValue(st.genYielded[gj])
    // the body ran off the end / returned; drop the record so its stale task
    // pointer cannot collide with a future generator's reused task address
    if done {
        removeGen(&mut st, gj)
    }
    return iterResult(&mut st, yielded, done)
}


// `await v`, factored out of the Unary branch so `for await (… of …)` can reuse
// it verbatim rather than growing a second, drifting copy of the thenable
// unwrapping, the activation park, and the main-task drain.
pub fn awaitValue(prog: &Prog, va: &JSValue, st: &mut Interp): JSValue {
            var awaited = cloneValue(va)
            // Resolution is recursive: a thenable may resolve with another
            // thenable, and each one has to be unwrapped in turn. The bound
            // is a runaway guard — a self-resolving chain would spin here.
            var rounds: i64 = 0
            while rounds < 1000 {
                rounds = rounds + 1
                // `await thenable` adopts it: the spec resolves the awaited value
                // through Promise.resolve, which calls .then on anything that has
                // one. prisma's query builders return a PrismaPromise (a plain
                // object with .then), and without this `await model.findMany()`
                // handed the builder itself back instead of the rows.
                let th = objHandle(awaited)
                if th >= 0 && !isPromise(st, th) {
                    let thenFn = getMemberDyn(prog, th, "then", &mut st)
                    if isCallableIn(st, thenFn) {
                        let adopted = newPromise(&mut st, 0, JSValue.Undefined)
                        pushTemp(&mut st, JSValue.Obj(adopted))
                        var thenArgs: Vec<JSValue> = Vec.new()
                        thenArgs.push(JSValue.Native(Native.Resolver(adopted, false)))
                        thenArgs.push(JSValue.Native(Native.Resolver(adopted, true)))
                        let _tr = callValue(prog, thenFn, thenArgs, JSValue.Obj(th), &mut st)
                        popTemp(&mut st)
                        if st.throwing {
                            return JSValue.Undefined
                        }
                        awaited = JSValue.Obj(adopted)
                    }
                }
                let po = objHandle(awaited)
                if po >= 0 && isPromise(st, po) {
                    let ps = st.objects[po].promiseState
                    let pv = cloneValue(st.objExtras[st.objects[po].extra].promiseValue)
                    if ps == 2 {
                        // Root the promise across the drain. `await
                        // Promise.reject(new Error(...))` awaits a TEMPORARY:
                        // the only reference is this frame's local, and locals
                        // are not a GC root set, so a collection inside the
                        // drain swept the promise and the error with it and the
                        // catch block saw a bare object with no message.
                        pushTemp(&mut st, JSValue.Obj(po))
                        awaitYieldMicrotasks(prog, &mut st)
                        popTemp(&mut st)
                        markRejectHandled(&mut st, po)
                        st.throwing = true
                        st.thrownValue = pv
                        return JSValue.Undefined
                    }
                    if ps == 1 {
                        // already settled — but with a thenable, which the
                        // loop above still has to unwrap
                        let fh = objHandle(pv)
                        var fnested = false
                        if fh >= 0 && !isPromise(st, fh) {
                            let fthen = getMemberDyn(prog, fh, "then", &mut st)
                            if isCallableIn(st, fthen) {
                                fnested = true
                            }
                        }
                        if !fnested {
                            // same temporary-promise hazard as the reject arm
                            pushTemp(&mut st, JSValue.Obj(po))
                            awaitYieldMicrotasks(prog, &mut st)
                            popTemp(&mut st)
                            return pv
                        }
                        awaited = pv
                    } else {
                        // Pending. On an activation task this suspends properly:
                        // the task parks and the settle wakes it, so other
                        // activations and the event loop keep running (R2).
                        //
                        // Root the awaited promise for the whole park: the temp
                        // rides in the saved ExecCtx that collect marks. Without
                        // this the promise (often an activation's own promise,
                        // referenced from nothing else) was swept mid-park — its
                        // settle then hit a recycled slot and was silently
                        // dropped, wedging the awaiter forever. Worse, the old
                        // popTemp here had NO matching push, so each park stole
                        // an unrelated live temp root from the resumed
                        // activation — that unrooted objects at random under
                        // concurrent fetches ("json is not a function").
                        pushTemp(&mut st, JSValue.Obj(po))
                        if parkOnPromise(&mut st, po) {
                            let ps2 = st.objects[po].promiseState
                            let pv2 = cloneValue(st.objExtras[st.objects[po].extra].promiseValue)
                            if ps2 == 2 {
                                popTemp(&mut st)
                                markRejectHandled(&mut st, po)
                                st.throwing = true
                                st.thrownValue = pv2
                                return JSValue.Undefined
                            }
                            if ps2 == 1 {
                                popTemp(&mut st)
                                return pv2
                            }
                            // still pending (spurious wake): keep the temp and
                            // fall through to the drain, which pops on exit
                        }
                        // On the main task there is nowhere to suspend to — it
                        // runs the event loop — so the loop is drained in place
                        // until the promise settles. Ordering therefore differs from
                        // real JS — work queued *after* this await can run before the
                        // awaiting function resumes — but the value flow is correct.
                        // If nothing is runnable the await can never complete, which
                        // is a deadlock and is reported as one.
                        // (the temp root pushed above stays live for the drain: the
                        // promise may be a temporary reachable from nothing while
                        // the drain runs user code)
                        // Budget: an unrelated interval keeps the loop runnable
                        // forever, so "nothing runnable" alone cannot detect a stuck
                        // await — the tahoeroads bundle hung silently for exactly
                        // this reason (its 2s interval kept feeding the drain).
                        // Node abandons the continuation instead; without coroutines
                        // the honest alternative is a loud error after a deadline.
                        let awaitDeadline = (epochMillis() as f64) + st.awaitBudgetMs
                        var spins: i64 = 0
                        while st.objects[po].promiseState == 0 && !st.throwing {
                            // Service off-thread work on EVERY iteration, not
                            // only when no timer is runnable: an app with a
                            // live interval always has a timer to run, so a
                            // response delivered by a worker thread was never
                            // picked up and the await ran out its budget.
                            serviceFetches(&mut st)
                            if (epochMillis() as f64) > awaitDeadline {
                                popTemp(&mut st)
                                return throwErr(&mut st, "TypeError", "await did not settle within budget — likely a promise nothing will ever resolve")
                            }
                            if st.microtasks.len() > 0 {
                                drainMicrotasks(prog, &mut st, 1000000)
                            } else {
                                compactTimers(&mut st)
                                // Only timers that are ALREADY due: runOneTimer
                                // sleeps until the earliest timer fires, which is
                                // right for an idle event loop but not here. A
                                // blocked await is waiting on a worker thread or
                                // an addon that can answer at any moment, so
                                // sleeping through a far-future timer made the
                                // await take that timer's delay — a request that
                                // fetched in a second took 32s behind a 30s cache
                                // timer.
                                if !runDueTimer(prog, &mut st) {
                                    // A node-api addon settles from its own threads,
                                    // so there is no timer or microtask to run while
                                    // it works — this await is waiting on exactly
                                    // that. Without it, `await engine.connect()`
                                    // (prisma's query engine) was reported as an
                                    // unsettleable promise the moment it was made.
                                    napiServiceTsfn(&mut st)
                                    serviceFetches(&mut st)
                                    if hasPendingFetches(st) {
                                        napiWaitBriefly()
                                    } else if napiMayDeliver() {
                                        napiWaitBriefly()
                                    } else if earliestTimer(st) >= 0 {
                                        // A timer will fire eventually — very
                                        // likely the one that settles this await.
                                        // Wait in slices rather than sleeping to
                                        // its due time, so a worker thread or an
                                        // addon that answers sooner is still
                                        // picked up promptly.
                                        napiWaitBriefly()
                                    } else if st.microtasks.len() == 0 {
                                        popTemp(&mut st)
                                        return throwErr(&mut st, "TypeError", "await on a promise that can never settle (no pending work)")
                                    }
                                }
                            }
                            spins = spins + 1
                        }
                        popTemp(&mut st)
                        if st.throwing {
                            return JSValue.Undefined
                        }
                        let settled = st.objects[po].promiseState
                        let sv = cloneValue(st.objExtras[st.objects[po].extra].promiseValue)
                        if settled == 2 {
                            markRejectHandled(&mut st, po)
                            st.throwing = true
                            st.thrownValue = sv
                            return JSValue.Undefined
                        }
                        // resolved with another thenable: unwrap it too
                        let sh = objHandle(sv)
                        var nested = false
                        if sh >= 0 && !isPromise(st, sh) {
                            let nthen = getMemberDyn(prog, sh, "then", &mut st)
                            if isCallableIn(st, nthen) {
                                nested = true
                            }
                        }
                        if !nested {
                            return sv
                        }
                        awaited = sv
                    }
                } else {
                    // await of a non-thenable value: still yields a microtask tick
                    awaitYieldMicrotasks(prog, &mut st)
                    return awaited
                }

            }
            return awaited
}
// The `yield e` expression, evaluated on a generator's body task. `handed` is the
// already-evaluated operand. Hands it out, parks the body, and on resume returns
// the value the next() caller passed in.
fn genYield(handed: JSValue, st: &mut Interp): JSValue {
    return genYieldProg(gProg, handed, &mut st)
}

fn genYieldProg(prog: &Prog, handed: JSValue, st: &mut Interp): JSValue {
    let me = schedulerCurrent()
    let gi = genIndexOfTask(st, me)
    if gi < 0 {
        // `yield` outside any generator body — not reachable through the parser,
        // which only emits it inside a function*, but fail soft rather than wedge
        return JSValue.Undefined
    }
    // AsyncGeneratorYield AWAITS the operand before handing it out. Yielding a
    // rejected promise must therefore reject the promise the awaiting next()
    // returned; handing the promise out raw resolved next() with it instead, and
    // the rejection surfaced later as an unhandled rejection with no connection to
    // the call that caused it.
    var toHand = cloneValue(handed)
    if st.genAsync[gi] {
        toHand = awaitValue(prog, toHand, &mut st)
        if st.throwing {
            // the await rejected: the generator body sees it as a throw at the
            // yield, which is what propagates it to next()
            return JSValue.Undefined
        }
    }
    st.genYielded[gi] = cloneValue(toHand)
    st.genDone[gi] = false
    // root the gen object across the park, like genNext does
    pushTemp(&mut st, JSValue.Obj(st.genObj[gi]))
    let ctx = saveExecCtx(&mut st)
    st.suspended.push(ctx)
    st.suspendedTask.push(me)
    schedulerUnpark(st.genCaller[gi])
    schedulerPark()
    resumeExecCtx(&mut st, me)
    popTemp(&mut st)
    let gj = genIndexOfTask(st, me)
    if gj < 0 {
        return JSValue.Undefined
    }
    let mode = st.genResumeMode[gj]
    st.genResumeMode[gj] = 0
    if mode == 1 {
        // gen.throw(e): raise at the yield, so the body's own try/catch sees it
        st.throwing = true
        st.thrownValue = cloneValue(st.genSent[gj])
        return JSValue.Undefined
    }
    if mode == 2 {
        // gen.return(v): unwind on the throw machinery so every enclosing
        // `finally` runs, with genReturning set so no `catch` intercepts it.
        // genFinish turns it back into a normal completion carrying v.
        st.throwing = true
        st.genReturning = true
        st.thrownValue = cloneValue(st.genSent[gj])
        return JSValue.Undefined
    }
    return cloneValue(st.genSent[gj])
}

// Wake every activation waiting on `p`, in the order they began awaiting (R3).
fn wakeAwaiters(st: &mut Interp, p: i64) {
    var i: i64 = 0
    while i < st.awaitPromise.len() {
        if st.awaitPromise[i] == p {
            let t = st.awaitTask[i]
            st.awaitPromise.remove(i)
            st.awaitTask.remove(i)
            schedulerUnpark(t)
        } else {
            i = i + 1
        }
    }
}

// `import(x)` is specified to always return a promise: a specifier that fails to
// resolve rejects, it does not throw out of the expression. The parser desugars
// the call to Promise.resolve(require(x)), which threw synchronously the moment
// require did, so `import(missing).catch(...)` never reached its handler and the
// throw escaped to the caller instead. Catch the sync throw here and hand back
// the rejection the caller is entitled to.
fn evalImportCall(prog: &Prog, inner: ExprId, st: &mut Interp, scope: i64): JSValue {
    let v = evalExpr(prog, inner, &mut st, scope)
    if st.throwing {
        let err = cloneValue(st.thrownValue)
        st.throwing = false
        st.thrownValue = JSValue.Undefined
        return JSValue.Obj(newPromise(&mut st, 2, err))
    }
    return v
}

pub fn settlePromise(st: &mut Interp, p: i64, state: i64, value: JSValue) {
    if p < 0 || !isPromise(st, p) {
        return
    }
    if st.objects[p].promiseState != 0 {
        return
    }
    st.objects[p].promiseState = state
    st.objExtras[st.objects[p].extra].promiseValue = cloneValue(value)
    // an activation parked in `await p` IS a handler — the rejection is delivered
    // to it (to catch, or to re-reject its own promise). Capture that before
    // wakeAwaiters clears the registry, or Promise.any-style rejections that are
    // awaited-and-caught get falsely reported as unhandled.
    var hadAwaiter = false
    var ai: i64 = 0
    while ai < st.awaitPromise.len() {
        if st.awaitPromise[ai] == p {
            hadAwaiter = true
            ai = st.awaitPromise.len()
        } else {
            ai = ai + 1
        }
    }
    // wake activations parked on this promise before running reactions (R2/R3)
    wakeAwaiters(&mut st, p)
    if state == 2 && st.objExtras[st.objects[p].extra].reactions.len() == 0 && !hadAwaiter {
        // nobody is waiting on this rejection; report it when the loop idles
        // unless a .catch attaches first
        st.unhandledRejects.push(p)
    }
    var i: i64 = 0
    while i < st.objExtras[st.objects[p].extra].reactions.len() {
        var handler = cloneValue(st.objExtras[st.objects[p].extra].reactions[i].onFulfilled)
        if state == 2 {
            handler = cloneValue(st.objExtras[st.objects[p].extra].reactions[i].onRejected)
        }
        st.microtasks.push(Microtask {
            cb: handler, arg: cloneValue(value), derived: st.objExtras[st.objects[p].extra].reactions[i].derived, passthroughReject: state == 2, isFinally: st.objExtras[st.objects[p].extra].reactions[i].isFinally, noArgs: false
        }
        )
        i = i + 1
    }
    st.objExtras[st.objects[p].extra].reactions = Vec.new()
}

// Awaiting or attaching a handler to a rejected promise counts as handling it,
// so drop it from the unhandled-rejection set reported at loop end. (Without this,
// `try { await Promise.reject(e) } catch {}` still printed a spurious unhandled
// rejection — GC-masked, since a collected promise slot was skipped at reporting.)
fn markRejectHandled(st: &mut Interp, p: i64) {
    var kept: Vec<i64> = Vec.new()
    var ki: i64 = 0
    while ki < st.unhandledRejects.len() {
        if st.unhandledRejects[ki] != p {
            kept.push(st.unhandledRejects[ki])
        }
        ki = ki + 1
    }
    st.unhandledRejects = kept
}

// The spec's ResolvePromise. The resolver native used to do only the two easy
// cases — a primitive fulfilled, a real promise adopted — and fulfilled with
// ANY other thenable instead of following it, so `new Promise(r => r({then(res)
// {res(42)}}))` handed the object itself to .then. Everything that awaits a
// non-promise thenable (and every test262 async case that self-resolves) hung on
// that.
fn resolvePromiseValue(prog: &Prog, st: &mut Interp, target: i64, v: JSValue) {
    let vh = objHandle(v)
    // Resolving a promise with ITSELF is a cycle. The spec rejects; doing nothing
    // left the promise pending forever, which is why those cases reported "no
    // completion marker" rather than a wrong value.
    if vh >= 0 && vh == target {
        let err = makeError(&mut st, "TypeError", "Chaining cycle detected for promise #<Promise>")
        settlePromise(&mut st, target, 2, err)
        return
    }
    if vh < 0 {
        settlePromise(&mut st, target, 1, v)
        return
    }
    if isPromise(st, vh) {
        adoptPromise(&mut st, target, vh)
        return
    }
    // Reading `.then` is part of resolution, so a getter that throws rejects the
    // promise rather than propagating out of resolve().
    let thenFn = getMemberDyn(prog, vh, "then", &mut st)
    if st.throwing {
        let err = cloneValue(st.thrownValue)
        st.throwing = false
        st.thrownValue = JSValue.Undefined
        settlePromise(&mut st, target, 2, err)
        return
    }
    if !isCallableIn(st, thenFn) {
        settlePromise(&mut st, target, 1, v)
        return
    }
    // The CALL is a job, not part of resolve(). __thenJob (engine-prelude) is the
    // wrapper; it takes the four values as one array because a microtask with no
    // derived promise calls its callback with exactly one argument.
    let job = scopeLookup(st, 0, "__thenJob")
    if !isCallableIn(st, job) {
        // No prelude (a bare embedding evaluating source before it loads): fall
        // back to calling then inline. Wrong tick, right state.
        var inlineArgs: Vec<JSValue> = Vec.new()
        inlineArgs.push(JSValue.Native(Native.Resolver(target, false)))
        inlineArgs.push(JSValue.Native(Native.Resolver(target, true)))
        let _ = callValue(prog, thenFn, inlineArgs, cloneValue(v), &mut st)
        if st.throwing {
            let err2 = cloneValue(st.thrownValue)
            st.throwing = false
            st.thrownValue = JSValue.Undefined
            settlePromise(&mut st, target, 2, err2)
        }
        return
    }
    // The job gets a FRESH resolver pair, as the spec's
    // NewPromiseResolveThenableJob does: `target`'s own pair has already fired
    // (that is what queued this job), so handing the thenable those functions
    // would hit the already-resolved guard and the promise would never settle.
    // A pending inner promise that `target` follows is that fresh pair.
    let inner = newPromise(&mut st, 0, JSValue.Undefined)
    pushTemp(&mut st, JSValue.Obj(inner))
    adoptPromise(&mut st, target, inner)
    let box = newArray(&mut st)
    pushTemp(&mut st, JSValue.Obj(box))
    arrPush(&mut st, box, cloneValue(v))
    arrPush(&mut st, box, cloneValue(thenFn))
    arrPush(&mut st, box, JSValue.Native(Native.Resolver(inner, false)))
    arrPush(&mut st, box, JSValue.Native(Native.Resolver(inner, true)))
    popTemp(&mut st)
    popTemp(&mut st)
    st.microtasks.push(Microtask {
        cb: cloneValue(job), arg: JSValue.Obj(box), derived: -1, passthroughReject: false, isFinally: false, noArgs: false
    }
    )
}

// Make `derived` follow `source`: settle now if it already has, else register.
fn adoptPromise(st: &mut Interp, derived: i64, source: i64) {
    let state = st.objects[source].promiseState
    if state == 2 {
        // the derived promise now observes the source's rejection
        var kept: Vec<i64> = Vec.new()
        var ki: i64 = 0
        while ki < st.unhandledRejects.len() {
            if st.unhandledRejects[ki] != source {
                kept.push(st.unhandledRejects[ki])
            }
            ki = ki + 1
        }
        st.unhandledRejects = kept
    }
    if state == 0 {
        st.objExtras[st.objects[source].extra].reactions.push(Reaction {
            onFulfilled: JSValue.Undefined, onRejected: JSValue.Undefined, derived: derived, isFinally: false
        }
        )
        return
    }
    settlePromise(&mut st, derived, state, cloneValue(st.objExtras[st.objects[source].extra].promiseValue))
}

fn describeThrownValue(st: &Interp, v: &JSValue): string {
    let h = objHandle(v)
    if h >= 0 && st.objects[h].isError {
        return toStr(getMember(st, h, "name")) + ": " + toStr(getMember(st, h, "message"))
    }
    return toStr(v)
}

// Node reports (and by default dies on) rejections nothing handles; silently
// dropping them turned a thrown await-deadline error into an invisible hang.
fn reportUnhandledRejections(st: &mut Interp) {
    var i: i64 = 0
    while i < st.unhandledRejects.len() {
        let p = st.unhandledRejects[i]
        if isPromise(st, p) && st.objects[p].promiseState == 2 {
            let v = cloneValue(st.objExtras[st.objects[p].extra].promiseValue)
            eprint("Unhandled promise rejection: " + describeThrownValue(st, v))
            st.hadUnhandledRejection = true
        }
        i = i + 1
    }
    st.unhandledRejects = Vec.new()
}

// Run queued microtasks. `limit` caps how many are processed (also the runaway
// guard); pass a large value to drain the whole queue. A bounded limit lets an
// `await` run exactly the microtasks pending at the await point — matching node,
// which queues the await continuation as a microtask, so microtasks queued
// before it run first and ones they queue run after.
fn drainMicrotasks(prog: &Prog, st: &mut Interp, limit: i64) {
    var guard: i64 = 0
    while st.microtasks.len() > 0 && guard < limit {
        let task = cloneValue(st.microtasks[0].cb)
        let arg = cloneValue(st.microtasks[0].arg)
        let derived = st.microtasks[0].derived
        let passthrough = st.microtasks[0].passthroughReject
        let isFinallyTask = st.microtasks[0].isFinally
        let noArgsTask = st.microtasks[0].noArgs
        var rest: Vec<Microtask> = Vec.new()
        var i: i64 = 1
        while i < st.microtasks.len() {
            rest.push(Microtask {
                cb: cloneValue(st.microtasks[i].cb), arg: cloneValue(st.microtasks[i].arg), derived: st.microtasks[i].derived, passthroughReject: st.microtasks[i].passthroughReject, isFinally: st.microtasks[i].isFinally, noArgs: st.microtasks[i].noArgs
            }
            )
            i = i + 1
        }
        st.microtasks = rest
        if derived < 0 {
            pushTemp(&mut st, cloneValue(task))
            var args: Vec<JSValue> = Vec.new()
            if !noArgsTask {
                args.push(arg)
            }
            let _ = callValue(prog, task, args, JSValue.Undefined, &mut st)
            popTemp(&mut st)
            if st.throwing {
                // Same rule as a timer callback, INCLUDING the escape hatch: an
                // uncaughtException listener is node's one documented way to
                // survive this, and it was honoured for timers only. A throw
                // from a microtask or a nextTick callback killed the process
                // outright however many listeners were registered.
                if !dispatchUncaught(prog, &mut st) {
                    eprint("Uncaught " + describeThrownValue(st, st.thrownValue))
                    exit(1)
                }
            }
        } else if !isCallable(task) {
            // no handler for this state: the value flows to the derived promise
            var passState: i64 = 1
            if passthrough {
                passState = 2
            }
            settlePromise(&mut st, derived, passState, arg)
        } else {
            // The queue entry has already been popped, so it no longer roots
            // anything: the handler, the settlement value and the derived promise
            // must all be rooted across the call, which runs user code and can
            // collect. Omitting the handler let a collection free the scope it
            // captured, and it resumed with its closure variables gone.
            pushTemp(&mut st, cloneValue(task))
            pushTemp(&mut st, cloneValue(arg))
            pushTemp(&mut st, JSValue.Obj(derived))
            var args: Vec<JSValue> = Vec.new()
            args.push(cloneValue(arg))
            let r = callValue(prog, task, args, JSValue.Undefined, &mut st)
            popTemp(&mut st)
            popTemp(&mut st)
            popTemp(&mut st)
            if st.throwing {
                let err = cloneValue(st.thrownValue)
                st.throwing = false
                st.thrownValue = JSValue.Undefined
                settlePromise(&mut st, derived, 2, err)
            } else if isFinallyTask {
                // finally: the handler's value is discarded, the original
                // settlement (including a rejection) continues down the chain
                var origState: i64 = 1
                if passthrough {
                    origState = 2
                }
                settlePromise(&mut st, derived, origState, arg)
            } else {
                let rp = objHandle(r)
                if rp >= 0 && isPromise(st, rp) {
                    // adopt the returned promise's eventual state
                    adoptPromise(&mut st, derived, rp)
                } else {
                    settlePromise(&mut st, derived, 1, r)
                }
            }
        }
        guard = guard + 1
    }
}

// Index of the earliest active timer, or -1 when none remain.
fn earliestTimer(st: &Interp): i64 {
    var best: i64 = -1
    var i: i64 = 0
    while i < st.timers.len() {
        if st.timers[i].active {
            if best < 0 || st.timers[i].dueMs < st.timers[best].dueMs {
                best = i
            }
        }
        i = i + 1
    }
    return best
}

// Index of the earliest active timer that is still ref'd, or -1. Only these
// justify keeping the loop alive; runOneTimer and runDueTimer still fire an
// unref'd timer that is due while the loop is alive for another reason.
fn earliestRefedTimer(st: &Interp): i64 {
    var best: i64 = -1
    var i: i64 = 0
    while i < st.timers.len() {
        if st.timers[i].active && st.timers[i].refed {
            if best < 0 || st.timers[i].dueMs < st.timers[best].dueMs {
                best = i
            }
        }
        i = i + 1
    }
    return best
}

// Run one due timer, sleeping until it is due. Returns false when there is
// nothing left to run.
fn runOneTimer(prog: &Prog, st: &mut Interp): bool {
    let idx = earliestTimer(st)
    if idx < 0 {
        return false
    }
    let nowMs = epochMillis() as f64
    let due = st.timers[idx].dueMs
    if due > nowMs {
        sleepMs((due - nowMs) as i64)
    }
    let cb = cloneValue(st.timers[idx].cb)
    var args: Vec<JSValue> = Vec.new()
    var ai: i64 = 0
    while ai < st.timers[idx].args.len() {
        args.push(cloneValue(st.timers[idx].args[ai]))
        ai = ai + 1
    }
    if st.timers[idx].intervalMs > 0.0 {
        st.timers[idx].dueMs = (epochMillis() as f64) + st.timers[idx].intervalMs
    } else {
        st.timers[idx].active = false
    }
    let _ = callValue(prog, cb, args, JSValue.Undefined, &mut st)
    if st.throwing {
        // An uncaught exception ENDS the process, as it does in node — unless the
        // program registered an uncaughtException listener, which is node's one
        // documented way to survive one. Logging it and carrying on left the loop
        // running with its work half done: a test that failed an assertion inside
        // a callback printed the failure and then hung until something killed it,
        // so the real error was reported as a timeout. Node exits 1 here, and the
        // exit code is how a harness learns anything happened at all.
        if !dispatchUncaught(prog, &mut st) {
            eprint("Uncaught " + describeThrownValue(st, st.thrownValue))
            exit(1)
        }
    }
    return true
}

// The event loop: microtasks to exhaustion, then one timer, repeat. Returns when
// nothing is left to run — which for a server with an interval never happens.
// Give any runnable activation the CPU. Returns true if one was there to run,
// so the event loop prefers a live continuation over sleeping on a timer.
fn schedulerYieldedToActivation(st: &mut Interp): bool {
    var ready = false
    var i: i64 = 0
    while i < st.actTask.len() {
        if !isParkedOnPromise(st, st.actTask[i]) {
            ready = true
        }
        i = i + 1
    }
    if ready {
        schedulerYield()
    }
    return ready
}

fn isParkedOnPromise(st: &Interp, t: *u8): bool {
    var i: i64 = 0
    while i < st.awaitTask.len() {
        if st.awaitTask[i] as i64 == t as i64 {
            return true
        }
        i = i + 1
    }
    return false
}

pub fn runEventLoop(prog: &Prog, st: &mut Interp) {
    var going = true
    while going {
        // Deliver anything an addon's worker threads queued. Runs before
        // microtasks so a settlement made off-thread is visible in this turn.
        napiServiceTsfn(&mut st)
        serviceFetches(&mut st)
        drainMicrotasks(prog, &mut st, 1000000)
        compactTimers(&mut st)
        // Order matters: run timers that are already due, then service a
        // listening server, and only sleep for a future timer when no server is
        // waiting. Sleeping first would block accept() for the whole delay — a
        // pending 9s timer made the server unreachable for 9s.
        if runDueTimer(prog, &mut st) {
            // ran one; loop round
        } else if serveHttpOnce(prog, &mut st) {
            // handled a connection
        } else if st.actTask.len() > 0 && schedulerYieldedToActivation(&mut st) {
            // An activation woken by a settle is runnable now. Yield to it before
            // sleeping on a timer: runOneTimer sleeps until the earliest timer is
            // due, so a far-future timer would otherwise fire long before an
            // activation that is ready right now.
        } else if hasPendingFetches(st) {
            // A worker thread owes us a response; sleep rather than spin a core.
            // Checked BEFORE runOneTimer: serveHttpOnce no longer swallows this
            // branch, and runOneTimer sleeps to the next due timer — behind a
            // far-future timer the fetch would sit delivered but unserviced.
            napiWaitBriefly()
        } else if napiHasPendingWork() {
            // an addon still owes us a settlement, and it will arrive on one of its
            // own threads — there is no timer or socket to wait on, so yield briefly
            // rather than spinning a core while the worker finishes.
            napiWaitBriefly()
        } else if st.httpServers.len() > 0 {
            // A listener with nothing pending, but the loop was not idle enough
            // for a blocking accept (live activations or an armed timer). Sleep a
            // slice and re-probe; due timers are caught at the top of the loop.
            sleepMs(1)
        } else if earliestRefedTimer(st) >= 0 && runOneTimer(prog, &mut st) {
            // Nothing to serve, so waiting for the next timer is correct. Only a
            // ref'd timer is worth sleeping for: with just unref'd timers left
            // the loop falls through and exits, as node does.
        } else if st.actTask.len() > 0 {
            // activations are still live; their continuations are real work, so
            // exiting here would drop them on the floor
            schedulerYield()
        } else {
            // Report only here, where the loop is genuinely out of work. A
            // rejection is "unhandled" the moment it settles with no reaction
            // and no parked awaiter, but the awaiter of `await thr()` attaches
            // only after its activation task is scheduled back in — several
            // loop turns later. Reporting at the top of every turn caught that
            // window and printed a spurious unhandled rejection for a
            // try/catch-ed await (and for Promise.allSettled).
            reportUnhandledRejections(&mut st)
            going = false
        }
    }
}

// Run a timer only if it is already due; never sleeps.
fn runDueTimer(prog: &Prog, st: &mut Interp): bool {
    let idx = earliestTimer(st)
    if idx < 0 {
        return false
    }
    if st.timers[idx].dueMs > (epochMillis() as f64) {
        return false
    }
    return runOneTimer(prog, &mut st)
}

// Ask each registered http server to accept and handle one connection. Returns
// true only when a connection was actually handled, so the event loop can tell
// a served request apart from an idle listener.
fn serveHttpOnce(prog: &Prog, st: &mut Interp): bool {
    if st.httpServers.len() == 0 {
        return false
    }
    // A blocking accept is only safe when nothing else needs the loop: any live
    // activation, in-flight fetch, queued microtask, pending addon settlement or
    // armed timer must keep being serviced, and a park on the listener stops all
    // of them until the next connection arrives. That park was the cold-fetch
    // hang: a request whose handler awaited an upstream fetch parked, the loop
    // re-entered accept, and the response sat unserviced in its channel forever.
    let mayBlock = st.httpServers.len() == 1 && st.actTask.len() == 0 && st.fetches.len() == 0 && st.microtasks.len() == 0 && earliestTimer(st) < 0 && !napiHasPendingWork()
    var handled = false
    var i: i64 = 0
    while i < st.httpServers.len() {
        let so = st.httpServers[i]
        if so >= 0 {
            let server = JSValue.Obj(so)
            var args: Vec<JSValue> = Vec.new()
            args.push(JSValue.Bool(mayBlock))
            let r = callMemberValue(prog, server, "_serveOnce", args, &mut st)
            if truthy(r) {
                handled = true
            }
            if st.throwing && !dispatchUncaught(prog, &mut st) {
                // Same rule as runOneTimer: an uncaught exception ENDS the
                // process, as it does in node. Swallowing it here left the loop
                // running with the request half handled, so an assertion that
                // failed inside a request or response callback printed its
                // message and then hung until the harness killed it — reported
                // as a timeout, with the real error buried in the output. That
                // is why http supplied 39 of 64 timeouts while the timer path,
                // which already exits, supplied none.
                eprint("Uncaught " + describeThrownValue(st, st.thrownValue))
                exit(1)
            }
        }
        i = i + 1
    }
    // A request's transient graph — the parsed body, fetched response strings
    // (each a single but often multi-MB allocation), the Request/Response objects
    // — is garbage the moment the response is sent. The alloc-COUNT GC threshold
    // barely moves for a few huge strings, so without this the heap grows
    // unbounded across requests (observed: ~30 MB/request to >1 GB). This request
    // boundary is a safe collection point: nothing is in flight on the eval stack.
    if handled {
        collect(&mut st)
    }
    return handled
}

// Call a method on an object with already-evaluated arguments.
// Give the program its chance at an uncaught exception before the process dies.
// Returns true when a process.on('uncaughtException') listener ran, which is
// node's rule for NOT exiting. Without this the interpreter exited on every
// uncaught error, including the ones a test had explicitly asked to handle.
fn dispatchUncaught(prog: &Prog, st: &mut Interp): bool {
    let handler = scopeLookup(st, 0, "__dispatchUncaught")
    match handler {
        JSValue.Func(_fIdx, _envIdx, _fo) => {
            // Cleared before re-entering JS: the callee runs on a clean frame,
            // and the flag is restored by the caller if nothing handled it.
            let thrown = cloneValue(st.thrownValue)
            st.throwing = false
            st.thrownValue = JSValue.Undefined
            var args: Vec<JSValue> = Vec.new()
            args.push(cloneValue(thrown))
            let r = callFunction(prog, handler, args, JSValue.Undefined, &mut st)
            if st.throwing {
                // The handler itself threw; that one is genuinely fatal.
                return false
            }
            if truthy(r) {
                return true
            }
            st.throwing = true
            st.thrownValue = thrown
            return false
        }
        _ => {
            return false
        }
    }
}

fn callMemberValue(prog: &Prog, recv: &JSValue, name: &string, args: Vec<JSValue>, st: &mut Interp): JSValue {
    let o = objHandle(recv)
    if o < 0 {
        return JSValue.Undefined
    }
    let m = getMemberDyn(prog, o, name, &mut st)
    return callValue(prog, m, args, cloneValue(recv), &mut st)
}

// Drop cancelled timers so the list cannot grow without bound in a long run.
fn compactTimers(st: &mut Interp) {
    var anyDead = false
    var i: i64 = 0
    while i < st.timers.len() {
        if !st.timers[i].active {
            anyDead = true
        }
        i = i + 1
    }
    if !anyDead {
        return
    }
    var live: Vec<Timer> = Vec.new()
    var j: i64 = 0
    while j < st.timers.len() {
        if st.timers[j].active {
            var args: Vec<JSValue> = Vec.new()
            var k: i64 = 0
            while k < st.timers[j].args.len() {
                args.push(cloneValue(st.timers[j].args[k]))
                k = k + 1
            }
            live.push(Timer {
                id: st.timers[j].id, dueMs: st.timers[j].dueMs, intervalMs: st.timers[j].intervalMs, cb: cloneValue(st.timers[j].cb), args: args, active: true, refed: st.timers[j].refed
            }
            )
        }
        j = j + 1
    }
    st.timers = live
}

// `delete obj.k` / `delete obj[k]` — remove an own property. Array elements
// become holes (undefined) rather than shifting, as in JS. Always returns true
// here; the non-configurable cases the spec reports false for do not arise.
// `delete proxy[key]`: the deleteProperty trap, else delete on the target.
fn proxyDelete(prog: &Prog, o: i64, key: string, st: &mut Interp): JSValue {
    let trap = proxyTrapChecked(prog, &mut st, o, "deleteProperty")
    if st.throwing {
        return JSValue.Undefined
    }
    let target = proxyTargetOf(st, o)
    if !isUndefinedValue(trap) {
        var dargs: Vec<JSValue> = Vec.new()
        dargs.push(cloneValue(target))
        dargs.push(propKeyValue(key))
        let r = callTrap(prog, &mut st, o, trap, dargs)
        if st.throwing {
            return JSValue.Undefined
        }
        if !truthy(r) {
            return JSValue.Bool(false)
        }
        // a property the target cannot actually lose may not be reported deleted
        let td = getOwnPropDescOf(prog, &mut st, target, key)
        if st.throwing {
            return JSValue.Undefined
        }
        let tdh = objHandle(td)
        if tdh >= 0 {
            if !truthy(getMember(st, tdh, "configurable")) {
                return throwErr(&mut st, "TypeError", "'deleteProperty' on proxy: trap returned truish for property '" + key.clone() + "' which is non-configurable in the proxy target")
            }
            if !isExtensibleOf(prog, &mut st, target) {
                if st.throwing {
                    return JSValue.Undefined
                }
                return throwErr(&mut st, "TypeError", "'deleteProperty' on proxy: trap returned truish for property '" + key.clone() + "' but the proxy target is non-extensible")
            }
            if st.throwing {
                return JSValue.Undefined
            }
        }
        return JSValue.Bool(true)
    }
    let th = propertyBagOf(&mut st, target)
    if th >= 0 {
        if st.objects[th].isProxy {
            return proxyDelete(prog, th, key, &mut st)
        }
        if st.objects[th].frozen || st.objects[th].sealed {
            return JSValue.Bool(false)
        }
        return JSValue.Bool(objDeleteKey(&mut st, th, key))
    }
    return JSValue.Bool(true)
}

// `delete` reaches a function's own properties as well as a plain object's:
// objHandle answers -1 for a Func, so every `delete fn.x` used to report true
// while removing nothing, and test262's isConfigurable() probe (which deletes
// and then checks hasOwnProperty) failed on every class static method.
// `delete base.k` where the base has no property bag. Only null and undefined get
// here in practice, and for those the spec's ToObject step throws a TypeError
// BEFORE any deletion is attempted; milojs answered true and deleted nothing, so
// `delete null.a` silently succeeded. Any other bagless value keeps the old
// answer, since deleting an absent property is true.
fn deleteOnNoBag(st: &mut Interp, base: &JSValue): JSValue {
    // Evaluating the base may already have thrown, and that exception wins:
    // `delete super.a` raises a ReferenceError from the base, which this would
    // otherwise overwrite with a TypeError.
    if st.throwing {
        return JSValue.Undefined
    }
    var nullish = false
    match base {
        JSValue.Undefined => {
            nullish = true
        }
        JSValue.Null => {
            nullish = true
        }
        _ => {
        }
    }
    if nullish {
        return throwErr(&mut st, "TypeError", "Cannot convert undefined or null to object")
    }
    return JSValue.Bool(true)
}

// `delete` answers false when the property refuses to go, and in STRICT mode a
// false answer is a TypeError instead. Both delete paths returned the bool and
// stopped there, so strict code deleting a non-configurable property carried on
// with the property still present and no indication.
fn deleteResult(st: &mut Interp, ok: bool, key: &string): JSValue {
    if !ok && st.strict {
        return throwErr(&mut st, "TypeError", "Cannot delete property '" + key.clone() + "' of object")
    }
    return JSValue.Bool(ok)
}

fn evalDelete(prog: &Prog, targetId: ExprId, st: &mut Interp, scope: i64): JSValue {
    match prog.exprs[targetId.index] {
        Expr.Member(objIdx, name) => {
            let ov = evalExpr(prog, objIdx, &mut st, scope)
            let o = propertyBagOf(&mut st, ov)
            if o >= 0 {
                if st.objects[o].isProxy {
                    return proxyDelete(prog, o, name.clone(), &mut st)
                }
                if st.objects[o].frozen || st.objects[o].sealed {
                    return deleteResult(&mut st, false, name)
                }
                return deleteResult(&mut st, objDeleteKey(&mut st, o, name.clone()), name)
            }
            return deleteOnNoBag(&mut st, ov)
        }
        Expr.Index(objIdx, keyIdx) => {
            let ov = evalExpr(prog, objIdx, &mut st, scope)
            pushTemp(&mut st, cloneValue(ov))
            let kv = evalExpr(prog, keyIdx, &mut st, scope)
            popTemp(&mut st)
            let key = toPropertyKey(st, kv)
            let o = propertyBagOf(&mut st, ov)
            if o >= 0 {
                if st.objects[o].isProxy {
                    return proxyDelete(prog, o, key, &mut st)
                }
                if st.objects[o].frozen || st.objects[o].sealed {
                    return deleteResult(&mut st, false, key)
                }
                return deleteResult(&mut st, objDeleteKey(&mut st, o, key.clone()), key)
            }
            return deleteOnNoBag(&mut st, ov)
        }
        _ => {
            // `delete someVariable` is not permitted on bindings; evaluate for
            // effect and report false
            let _ = evalExpr(prog, targetId, &mut st, scope)
            return JSValue.Bool(false)
        }
    }
}

// new Array(n) preallocates n holes; new Array(a, b, ...) is a literal list.
fn makeArrayFromCtor(st: &mut Interp, argVals: &Vec<JSValue>): JSValue {
    let arr = newArray(&mut st)
    if argVals.len() == 1 {
        if let JSValue.Number(n) = cloneValue(argVals[0]) {
            var i: i64 = 0
            while i < (n as i64) {
                arrPush(&mut st, arr, JSValue.Undefined)
                i = i + 1
            }
            return JSValue.Obj(arr)
        }
    }
    var k: i64 = 0
    while k < argVals.len() {
        arrPush(&mut st, arr, cloneValue(argVals[k]))
        k = k + 1
    }
    return JSValue.Obj(arr)
}

// The object that holds a value's properties: itself for an object, the statics
// bag for a function, the native bag for a builtin. Functions are property
// carriers in JS, and express builds its app by copying descriptors onto one.
// The prototype ToObject would give a primitive. Object.getPrototypeOf boxes its
// argument, so `Object.getPrototypeOf(42)` is Number.prototype, not null;
// Reflect.getPrototypeOf does NOT box and throws for the same input, and that
// difference is the whole of what get-proto and reflect.getprototypeof test.
fn primitiveProtoHandle(st: &mut Interp, v: &JSValue): i64 {
    match v {
        JSValue.Str(_sv) => {
            return st.stringProtoObj
        }
        JSValue.Sym(_sid) => {
            return nativeProtoHandle(&mut st, Builtin.Symbol)
        }
        JSValue.Number(_n) => {
            return nativeProtoHandle(&mut st, Builtin.Number)
        }
        JSValue.Bool(_b) => {
            return nativeProtoHandle(&mut st, Builtin.Boolean)
        }
        JSValue.BigInt(_g) => {
            return nativeProtoHandle(&mut st, Builtin.BigInt)
        }
        _ => {
            return -1
        }
    }
}

pub fn propertyBagOf(st: &mut Interp, v: &JSValue): i64 {
    let o = objHandle(v)
    if o >= 0 {
        return o
    }
    let f = funcHandle(v)
    if f >= 0 {
        let bag = funcObjOf(v)
        // `name` and `length` are real OWN properties of a function, and
        // test262 checks that with getOwnPropertyDescriptor rather than by
        // reading them. They were synthesised on read only, so every descriptor
        // query answered undefined. Materialised here, at the one place every
        // descriptor path goes through, with the spec's attributes:
        // { writable: false, enumerable: false, configurable: true }.
        // once only: `delete f.name` must stick, and a lazy "add it if absent"
        // check would put it straight back on the next descriptor query
        if !st.objects[bag].fnStatInit {
            st.objects[bag].fnStatInit = true
            // length before name: that is the order node reports them in from
            // Object.getOwnPropertyNames, and test262 compares the whole list.
            if objOwnIndex(st, bag, "length") < 0 {
                objDefineBuiltinAttr(&mut st, bag, "length", JSValue.Number(funcArity(gProg, f) as f64))
            }
            if objOwnIndex(st, bag, "name") < 0 {
                objDefineBuiltinAttr(&mut st, bag, "name", JSValue.Str(gProg.funcs[f].name.clone()))
            }
            // `prototype` is an ordinary OWN property, created here with the
            // rest so that reading it, describing it and listing it agree.
            // Only a CONSTRUCTOR carries one. A built-in function that is not
            // a constructor has no `prototype` own property at all, and
            // test262 asserts hasOwnProperty("prototype") === false on every
            // one of them — so this cannot simply be "every non-arrow".
            // A generator is the exception in the other direction: not a
            // constructor, but it does have a prototype (the object its
            // iterator inherits from), which inherits %GeneratorPrototype% and
            // has no `constructor` of its own.
            let isGen = gProg.funcs[f].isGenerator
            if valueIsConstructor(gProg, st, v) || isGen {
                if objOwnIndex(st, bag, "prototype") < 0 {
                    let p = newObject(&mut st)
                    if isGen {
                        st.objects[p].proto = generatorProtoHandle(&mut st)
                    } else {
                        objSet(&mut st, p, "constructor", cloneValue(v))
                        objSetNonEnumerable(&mut st, p, "constructor")
                    }
                    objDefineFnProtoAttr(&mut st, bag, "prototype", JSValue.Obj(p))
                }
            }
        }
        return bag
    }
    if let Option.Some(n) = nativeHandle(v) {
        return getNativeProps(&mut st, n)
    }
    return -1
}

// The object `new F()` links its instance to: F's own `prototype` when that is
// an object, else -1 (the default, Object.prototype), which is what
// OrdinaryCreateFromConstructor falls back to after a program assigns a
// primitive there. Materialises the property on first use.
pub fn funcPrototypeObj(st: &mut Interp, fnVal: &JSValue): i64 {
    let bag = propertyBagOf(&mut st, fnVal)
    if bag < 0 {
        return -1
    }
    return objHandle(objGet(st, bag, "prototype"))
}

// The module currently executing, for error messages. Empty at top level.

fn hasNodeAddonExt(p: &string): bool {
    let n = p.len()
    if n < 6 {
        return false
    }
    return p[n - 5] == '.' && p[n - 4] == 'n' && p[n - 3] == 'o' && p[n - 2] == 'd' && p[n - 1] == 'e'
}

// dlopen is not idempotent for addon state: a second registration would hand back
// a fresh exports object and re-run module init, so loaded addons are cached by
// path exactly like JS modules are.
fn findNapiAddon(st: &Interp, path: &string): Option<JSValue> {
    var i: i64 = 0
    while i < st.napiAddonPaths.len() {
        if st.napiAddonPaths[i] == path {
            return Option.Some(cloneValue(st.napiAddonExports[i]))
        }
        i = i + 1
    }
    return Option.None
}

// Does this object reach %Object.prototype% through its prototype chain? That
// is where the `__proto__` accessor lives, so it decides whether a `__proto__`
// read or write is the magic one or an ordinary property access.
fn inheritsObjectProto(st: &Interp, o: i64): bool {
    if st.objects[o].protoNull {
        return false
    }
    var p = st.objects[o].proto
    if p < 0 {
        // -1 with protoNull false means the default, which IS Object.prototype.
        return true
    }
    var guard: i64 = 0
    while p >= 0 && guard < 1000 {
        if p == st.objectProtoObj {
            return true
        }
        if st.objects[p].protoNull {
            return false
        }
        let next = st.objects[p].proto
        if next < 0 {
            return true
        }
        p = next
        guard = guard + 1
    }
    return false
}

pub fn isUndefinedValue(v: &JSValue): bool {
    match v {
        JSValue.Undefined => {
            return true
        }
        _ => {
            return false
        }
    }
}

fn isNullValue(v: &JSValue): bool {
    match v {
        JSValue.Null => {
            return true
        }
        _ => {
            return false
        }
    }
}

// Type(v) is Object. Functions and natives are objects too, so this is
// propertyBagOf rather than objHandle; it is -1 only for a genuine primitive.
fn isObjectValue(st: &mut Interp, v: &JSValue): bool {
    return propertyBagOf(&mut st, v) >= 0
}

// SameValue: strict equality with the two exceptions the spec carves out —
// NaN is equal to itself, and +0 is not equal to -0.
pub fn sameValue(a: &JSValue, b: &JSValue): bool {
    match a {
        JSValue.Number(x) => {
            match b {
                JSValue.Number(y) => {
                    if x != x && y != y {
                        return true
                    }
                    if x == 0.0 && y == 0.0 {
                        // 1/x distinguishes the zeroes; the sign bit is not
                        // otherwise reachable from f64 here
                        return (1.0 / x) == (1.0 / y)
                    }
                    return x == y
                }
                _ => {
                    return false
                }
            }
        }
        _ => {
            return jsStrictEquals(a, b)
        }
    }
}

fn isBoundThisSet(st: &Interp, o: i64): bool {
    match st.objExtras[st.objects[o].extra].boundThis {
        JSValue.Undefined => {
            return false
        }
        _ => {
            return true
        }
    }
}

fn stringPrimitiveMember(st: &mut Interp, value: &string, key: &string): JSValue {
    if key == "length" {
        return JSValue.Number(utf16Length(value) as f64)
    }
    // "abc"[Symbol.iterator] as a VALUE. for-of and spread over a string never
    // needed it (they walk the code points directly), so reading it answered
    // undefined until get-intrinsic tried to call it.
    if key == symIteratorKey() {
        return makeBoundMethod(&mut st, JSValue.Str(value.clone()), "__stringIterator")
    }
    if st.stringProtoObj >= 0 {
        return getMember(st, st.stringProtoObj, key)
    }
    return JSValue.Undefined
}

// A property read on a symbol primitive: `description` answers from the symbol
// table, everything else from Symbol.prototype.
fn symbolPrimitiveMember(st: &mut Interp, id: i64, key: &string): JSValue {
    if key == "description" {
        return symDescValue(st, id)
    }
    let sp = nativeProtoHandle(&mut st, Builtin.Symbol)
    if key == "__proto__" {
        return JSValue.Obj(sp)
    }
    if sp >= 0 {
        return getMember(st, sp, key)
    }
    return JSValue.Undefined
}

fn isMapSetMethodName(n: &string): bool {
    return n == "get" || n == "set" || n == "add" || n == "has" || n == "delete" || n == "clear" || n == "forEach" || n == "keys" || n == "values" || n == "entries" || n == "isSupersetOf" || n == "isSubsetOf" || n == "isDisjointFrom" || n == "union" || n == "intersection" || n == "difference" || n == "symmetricDifference"
}

// A DataView's byte length right now. One constructed without an explicit
// length tracks its buffer, so the stored taLen goes stale on every resize.
pub fn dataViewByteLen(st: &Interp, o: i64): i64 {
    let buf = st.objExtras[st.objects[o].extra].taBuf
    if buf < 0 || st.objects[buf].abDetached || taOutOfBounds(st, o) {
        return 0
    }
    if !st.objExtras[st.objects[o].extra].taTracking {
        return st.objExtras[st.objects[o].extra].taLen
    }
    var n = st.objExtras[st.objects[buf].extra].bytes.len() - st.objExtras[st.objects[o].extra].taOffset
    if n < 0 {
        n = 0
    }
    return n
}

// dateProtoMethodNames as a predicate, without building the Vec: it runs on
// every call against a Date. The first-letter filter rejects most other names
// before any string compare (every Date method starts with get/set/to/valueOf).
pub fn isDateMethodName(n: &string): bool {
    if n.len() < 6 {
        return false
    }
    let c = n[0]
    if c != 103 && c != 115 && c != 116 && c != 118 {
        return false
    }
    return n == "toString" || n == "toDateString" || n == "toTimeString" || n == "toISOString" || n == "toUTCString" || n == "toGMTString" || n == "getDate" || n == "setDate" || n == "getDay" || n == "getFullYear" || n == "setFullYear" || n == "getHours" || n == "setHours" || n == "getMilliseconds" || n == "setMilliseconds" || n == "getMinutes" || n == "setMinutes" || n == "getMonth" || n == "setMonth" || n == "getSeconds" || n == "setSeconds" || n == "getTime" || n == "setTime" || n == "getTimezoneOffset" || n == "getUTCDate" || n == "setUTCDate" || n == "getUTCDay" || n == "getUTCFullYear" || n == "setUTCFullYear" || n == "getUTCHours" || n == "setUTCHours" || n == "getUTCMilliseconds" || n == "setUTCMilliseconds" || n == "getUTCMinutes" || n == "setUTCMinutes" || n == "getUTCMonth" || n == "setUTCMonth" || n == "getUTCSeconds" || n == "setUTCSeconds" || n == "valueOf" || n == "getYear" || n == "setYear" || n == "toJSON" || n == "toLocaleString" || n == "toLocaleDateString" || n == "toLocaleTimeString"
}

pub fn dateProtoMethodNames(): Vec<string> {
    var out: Vec<string> = Vec.new()
    // the full Date.prototype surface, taken from node
    out.push("toString")
    out.push("toDateString")
    out.push("toTimeString")
    out.push("toISOString")
    out.push("toUTCString")
    out.push("toGMTString")
    out.push("getDate")
    out.push("setDate")
    out.push("getDay")
    out.push("getFullYear")
    out.push("setFullYear")
    out.push("getHours")
    out.push("setHours")
    out.push("getMilliseconds")
    out.push("setMilliseconds")
    out.push("getMinutes")
    out.push("setMinutes")
    out.push("getMonth")
    out.push("setMonth")
    out.push("getSeconds")
    out.push("setSeconds")
    out.push("getTime")
    out.push("setTime")
    out.push("getTimezoneOffset")
    out.push("getUTCDate")
    out.push("setUTCDate")
    out.push("getUTCDay")
    out.push("getUTCFullYear")
    out.push("setUTCFullYear")
    out.push("getUTCHours")
    out.push("setUTCHours")
    out.push("getUTCMilliseconds")
    out.push("setUTCMilliseconds")
    out.push("getUTCMinutes")
    out.push("setUTCMinutes")
    out.push("getUTCMonth")
    out.push("setUTCMonth")
    out.push("getUTCSeconds")
    out.push("setUTCSeconds")
    out.push("valueOf")
    out.push("getYear")
    out.push("setYear")
    out.push("toJSON")
    out.push("toLocaleString")
    out.push("toLocaleDateString")
    out.push("toLocaleTimeString")
    return out
}

// Function.prototype.length: the count of parameters before the first one with
// a default or a rest parameter. milojs does not record defaults per-param, so
// this counts declared params minus a trailing rest — enough for express, which
// only checks length === 4 to detect error-handler middleware.
fn funcArity(prog: &Prog, fIdx: i64): i64 {
    var n = prog.funcs[fIdx].params.len()
    if prog.funcs[fIdx].restFrom >= 0 {
        n = prog.funcs[fIdx].restFrom
    }
    return n
}

pub fn isSuperName(name: &string): bool {
    if name.len() < 8 {
        return false
    }
    return name[0] == '_' && name[1] == '_' && name[2] == 's' && name[3] == 'u' && name[4] == 'p' && name[5] == 'e' && name[6] == 'r' && name[7] == '$'
}

// How node names a bad heritage: a function by its source, an object as
// #<Object>, a primitive by its string.
fn classErrDisplay(prog: &Prog, st: &mut Interp, v: &JSValue): string {
    if funcHandle(v) >= 0 || isCallableIn(st, v) {
        return toStrProg(prog, v, &mut st)
    }
    if objHandle(v) >= 0 {
        return "#<Object>"
    }
    return toStr(v)
}

fn instantiateClass(prog: &Prog, classIdx: i64, st: &mut Interp, scope: i64): JSValue {
    var ctorFn = prog.classes[classIdx].ctorFn
    if ctorFn < 0 {
        // no declared constructor — reuse an empty one so the class is callable
        ctorFn = prog.classes[classIdx].defaultCtor
    }
    // A named class expression binds its own name inside the class body, in a
    // scope of its own: `X = class e { static empty() { return new e } }` — `e`
    // exists only in there, and prisma's runtime is built out of exactly this.
    // Methods and the constructor close over this scope rather than the defining
    // one; the super binding lives here too, so it can't be seen by siblings.
    let classScope = newScope(&mut st, scope)
    pushActive(&mut st, classScope)
    let classVal = makeClosure(&mut st, ctorFn, classScope)
    // An anonymous class value lives only on this frame until it is returned,
    // and the heritage, computed keys and static initialisers below all run
    // user code; the scoped root keeps its function object (and through it the
    // prototype every method is installed on) alive across them.
    let tempBase = st.tempRoots.len()
    pushTemp(&mut st, cloneValue(classVal))
    let className = prog.classes[classIdx].name.clone()
    if className.len() > 0 {
        scopeDefine(&mut st, classScope, className, cloneValue(classVal))
    }
    // Materialised before any static is installed: getOwnPropertyNames on a
    // class lists length, name, prototype first, and only then the statics.
    let ownStatics = propertyBagOf(&mut st, classVal)
    let proto = funcPrototypeObj(&mut st, classVal)
    let superName = prog.classes[classIdx].superName.clone()
    if superName.len() > 0 {
        var baseVal = JSValue.Undefined
        if prog.classes[classIdx].superExpr >= 0 {
            baseVal = evalExpr(prog, ExprId { index: prog.classes[classIdx].superExpr }, &mut st, scope)
            if st.throwing {
                truncateTemps(&mut st, tempBase)
                return JSValue.Undefined
            }
        } else {
            baseVal = scopeLookup(st, scope, superName)
        }
        // ClassDefinitionEvaluation: the heritage is null or a constructor
        // whose `prototype` is an object or null; anything else is a TypeError
        // at class creation, not at the first `new`
        if !(baseVal is JSValue.Null) {
            if !valueIsConstructor(prog, st, baseVal) {
                truncateTemps(&mut st, tempBase)
                return throwErr(&mut st, "TypeError", "Class extends value " + classErrDisplay(prog, &mut st, baseVal) + " is not a constructor or null")
            }
            let hbag = propertyBagOf(&mut st, baseVal)
            if hbag >= 0 {
                let hp = getMemberDyn(prog, hbag, "prototype", &mut st)
                if st.throwing {
                    truncateTemps(&mut st, tempBase)
                    return JSValue.Undefined
                }
                if objHandle(hp) < 0 && !(hp is JSValue.Null) && funcHandle(hp) < 0 {
                    truncateTemps(&mut st, tempBase)
                    return throwErr(&mut st, "TypeError", "Class extends value does not have valid prototype property " + toStr(hp))
                }
            }
        }
        let baseFn = funcHandle(baseVal)
        if baseVal is JSValue.Null {
            // class C extends null: C.prototype has a null [[Prototype]], and
            // the constructor keeps Function.prototype
            st.objects[proto].proto = -1
            st.objects[proto].protoNull = true
        } else if baseFn >= 0 {
            // the heritage check above admitted an object, a function or null
            let bpv = objGet(st, propertyBagOf(&mut st, baseVal), "prototype")
            if bpv is JSValue.Null {
                st.objects[proto].protoNull = true
            } else if objHandle(bpv) >= 0 {
                st.objects[proto].proto = objHandle(bpv)
            } else {
                st.objects[proto].proto = funcObjOf(bpv)
            }
            // Statics are inherited too: `class D extends B {}` makes D.staticOfB
            // resolve. Only the instance side was linked, so a static method or
            // accessor declared on the base was invisible on the subclass.
            st.objects[ownStatics].proto = funcObjOf(baseVal)
        } else {
            // A BUILT-IN base (class E extends TypeError, class A extends Array)
            // is not a user function, so funcHandle answers -1 and neither chain
            // was linked at all: `new E("x") instanceof TypeError` was false and
            // the subclass inherited neither methods nor statics. Its prototype
            // and its property bag are the two ends to hook up.
            let baseBag = propertyBagOf(&mut st, baseVal)
            if baseBag >= 0 {
                let baseProtoV = getMember(st, baseBag, "prototype")
                let baseProtoH = objHandle(baseProtoV)
                if baseProtoH >= 0 {
                    st.objects[proto].proto = baseProtoH
                }
                st.objects[ownStatics].proto = baseBag
            }
        }
        scopeDefine(&mut st, classScope, "__super$" + prog.classes[classIdx].superKey.clone(), baseVal)
    }
    var i: i64 = 0
    while i < prog.classes[classIdx].members.len() {
        var mName = prog.classes[classIdx].members[i].name.clone()
        // a computed key (`[Symbol.iterator]() {}`) is evaluated once here, in the
        // class scope, exactly as an object literal evaluates its computed keys
        if let Option.Some(keyExprId) = prog.classes[classIdx].members[i].keyExpr {
            mName = toStr(evalExpr(prog, keyExprId, &mut st, classScope))
        }
        let mFn = prog.classes[classIdx].members[i].fnIdx
        let mv = makeClosure(&mut st, mFn, classScope)
        let mKind = prog.classes[classIdx].members[i].kind
        var target = proto
        if prog.classes[classIdx].members[i].isStatic {
            target = ownStatics
        }
        if mKind > 0 {
            let existing = objOwnIndex(st, target, mName)
            var g = JSValue.Undefined
            var sfn = JSValue.Undefined
            if existing >= 0 && propIsAccessor(st, target, existing) {
                g = accGetter(st, st.objects[target].props[existing].acc)
                sfn = accSetter(st, st.objects[target].props[existing].acc)
            }
            if mKind == 1 {
                g = mv
            } else {
                sfn = mv
            }
            objDefineAccessor(&mut st, target, mName.clone(), g, sfn)
            objSetNonEnumerable(&mut st, target, mName)
        } else {
            objSet(&mut st, target, mName.clone(), mv)
            // class methods, statics and accessors are NON-enumerable. Only
            // FIELDS are enumerable, and they are installed as `this.x = ...` in
            // the constructor rather than here. Without this, `for (k in obj)`
            // over any class instance listed every method it inherits.
            objSetNonEnumerable(&mut st, target, mName)
        }
        i = i + 1
    }
    // static field initializers, evaluated in the class scope (so they can see
    // the class binding and static methods) and set on the constructor object
    var sf: i64 = 0
    while sf < prog.classes[classIdx].staticFieldNames.len() {
        var sfName = prog.classes[classIdx].staticFieldNames[sf].clone()
        // `static [expr] = init`: the key is evaluated first, and in the class
        // scope, so it can see the class binding
        if let Option.Some(keyExpr) = prog.classes[classIdx].staticFieldKeys[sf] {
            let kv = evalExpr(prog, keyExpr, &mut st, classScope)
            sfName = toStrProg(prog, kv, &mut st)
        }
        let sfInit = prog.classes[classIdx].staticFieldInits[sf]
        let statics = ownStatics
        let sfVal = evalExpr(prog, sfInit, &mut st, classScope)
        if sfName.len() == 0 {
            // a `static { }` block, not a field: run it with `this` bound to the
            // class and keep nothing
            var sbArgs: Vec<JSValue> = Vec.new()
            let _r = callValue(prog, sfVal, sbArgs, cloneValue(classVal), &mut st)
        } else {
            objSet(&mut st, statics, sfName, sfVal)
        }
        sf = sf + 1
    }
    truncateTemps(&mut st, tempBase)
    popActive(&mut st)
    return classVal
}

pub fn callValue(prog: &Prog, fnVal: &JSValue, args: Vec<JSValue>, thisVal: JSValue, st: &mut Interp): JSValue {
    match fnVal {
        JSValue.Func(_fIdx, _envIdx, _fo) => {
            return callFunction(prog, fnVal, args, thisVal, &mut st)
        }
        JSValue.Native(id) => {
            return callNativeAsFunction(prog, id, args, &mut st)
        }
        JSValue.Obj(o) => {
            if st.objects[o].isProxy {
                // a proxy over a non-callable target has no [[Call]] of its own,
                // whatever the handler defines
                if !st.objects[o].isFunctionLike {
                    return throwErr(&mut st, "TypeError", "proxy is not a function")
                }
                let trap = proxyTrapChecked(prog, &mut st, o, "apply")
                if st.throwing {
                    return JSValue.Undefined
                }
                let target = proxyTargetOf(st, o)
                if !isUndefinedValue(trap) {
                    // apply(target, thisArg, argsArray)
                    let arr = newArray(&mut st)
                    var i: i64 = 0
                    while i < args.len() {
                        st.objects[arr].elems.push(cloneValue(args[i]))
                        i = i + 1
                    }
                    var targs: Vec<JSValue> = Vec.new()
                    targs.push(cloneValue(target))
                    targs.push(cloneValue(thisVal))
                    targs.push(JSValue.Obj(arr))
                    return callTrap(prog, &mut st, o, trap, targs)
                }
                return callValue(prog, target, args, thisVal, &mut st)
            }
            // implemented by a loaded node-api addon: dispatch to its C callback
            if st.objExtras[st.objects[o].extra].napiFn >= 0 {
                let r = napiInvoke(st.objExtras[st.objects[o].extra].napiFn, args, thisVal)
                napiDrainSettlements(&mut st)
                return r
            }
            // a bind() result: the captured receiver wins over the call site's
            if st.objects[o].isBound {
                let ex = st.objects[o].extra
                if st.objExtras[ex].boundMethod.len() > 0 {
                    let mname = st.objExtras[ex].boundMethod.clone()
                    var recvV = cloneValue(st.objExtras[ex].boundThis)
                    // an unbound builtin method (Object.prototype.toString stored
                    // with no bound this) takes the call-site receiver, so
                    // ({}).toString() gets `this` = {} rather than undefined
                    if !isBoundThisSet(st, o) {
                        recvV = cloneValue(thisVal)
                    }
                    if !brandOk(&mut st, o, mname, recvV) {
                        return JSValue.Undefined
                    }
                    recvV = coerceGenericStringReceiver(prog, &mut st, o, recvV)
                    if st.throwing {
                        return JSValue.Undefined
                    }
                    return callBuiltinByName(prog, recvV, mname, args, &mut st)
                }
                let target = cloneValue(st.objExtras[ex].boundTarget)
                let boundThis = cloneValue(st.objExtras[ex].boundThis)
                var merged: Vec<JSValue> = Vec.new()
                var b: i64 = 0
                while b < st.objExtras[ex].boundArgs.len() {
                    merged.push(cloneValue(st.objExtras[ex].boundArgs[b]))
                    b = b + 1
                }
                var a: i64 = 0
                while a < args.len() {
                    merged.push(cloneValue(args[a]))
                    a = a + 1
                }
                return callValue(prog, target, merged, boundThis, &mut st)
            }
            return JSValue.Undefined
        }
        _ => {
            return JSValue.Undefined
        }
    }
}

// Node-API's synchronous callback into JavaScript. This adapter lives beside
// callValue rather than in napi.milo because the evaluator already imports the
// Node-API layer; importing the evaluator back from there would create a cycle.
@externalLinkage
pub fn napi_call_function(_env: *u8, recv: i64, func: i64, argc: i64, argv: *u8, result: *u8): i32 {
    if argc < 0 || (argc > 0 && argv as i64 == 0) {
        return NAPI_INVALID_ARG
    }
    let fnVal = napiValueOf(func)
    if !isCallableIn(gInterp, fnVal) {
        return NAPI_INVALID_ARG
    }
    var args: Vec<JSValue> = Vec.new()
    var i: i64 = 0
    while i < argc {
        var handle: i64 = 0
        unsafe {
            handle = napiLoadI64(((argv as i64) + i * 8) as *u8)
        }
        args.push(napiValueOf(handle))
        i = i + 1
    }
    let returned = callValue(gProg, fnVal, args, napiValueOf(recv), &mut gInterp)
    if gInterp.throwing {
        return NAPI_PENDING_EXCEPTION
    }
    if result as i64 != 0 {
        napiWriteHandle(result, napiHandle(returned))
    }
    return NAPI_OK
}


pub fn isoFromMillis(ms: f64): string {
    if ms != ms {
        return "Invalid Date"
    }
    // FLOOR, not truncate: for a negative epoch `(-1 / 1000) as i64` is 0, so
    // `new Date(-1).toISOString()` came out as 1970-01-01T00:00:00.999Z instead of
    // 1969-12-31T23:59:59.999Z. The millisecond remainder below already floors.
    let total = Math.floor(ms / 1000.0) as i64
    var frac = Math.mod(ms, 1000.0) as i64
    if frac < 0 {
        frac = frac + 1000
    }
    // Split into whole DAYS plus a non-negative second-of-day before asking the
    // std decomposition: fromEpoch answers a negative second for a negative
    // epoch inside the first day (-1 came back as second == -1, printing
    // "00:00:0-1"), while a day boundary decomposes correctly at any sign.
    var day = total / 86400
    if total < 0 && total != day * 86400 {
        day = day - 1
    }
    let sod = total - day * 86400
    let dt = DateTime.fromEpoch(day * 86400)
    let hh = sod / 3600
    let mm = (sod % 3600) / 60
    let ssec = sod % 60
    // A year outside 0..9999 is written in the EXTENDED form, a sign followed by
    // six digits, which is what makes the string round-trip through Date.parse.
    // A negative year got its sign from i64ToStr by accident, but a large positive
    // one came out bare (`275760-09-13...`), which parses back as NaN.
    return isoYear(dt.year as i64) + "-" + pad2(dt.month as i64) + "-" + pad2(dt.day as i64) + "T" + pad2(hh) + ":" + pad2(mm) + ":" + pad2(ssec) + "." + pad3(frac) + "Z"
}

fn isoYear(y: i64): string {
    if y >= 0 && y <= 9999 {
        var y4 = i64ToStr(y)
        while y4.len() < 4 {
            y4 = "0" + y4
        }
        return y4
    }
    var mag = y
    var sign = "+"
    if y < 0 {
        mag = -y
        sign = "-"
    }
    var out = i64ToStr(mag)
    while out.len() < 6 {
        out = "0" + out
    }
    return sign + out
}

// Dispatch a built-in Array method. `o` (the array) is temp-rooted by the caller;
// the result array and the callback are additionally rooted while callbacks run
// (a callback can allocate and collect).
// .then/.catch/.finally on an already-settled promise. Callbacks run immediately
// (no microtask queue), so ordering differs from real JS, but the value flow and
// the rejection-skips-onFulfilled rule match.
// .then/.catch/.finally. Handlers never run synchronously: they are queued as
// microtasks, so ordering matches JS instead of the old settle-in-place model.
fn promiseMethod(o: i64, name: &string, args: &Vec<JSValue>, st: &mut Interp): JSValue {
    var onFul = JSValue.Undefined
    var onRej = JSValue.Undefined
    var isFinally = false
    if name == "then" {
        if args.len() > 0 {
            onFul = cloneValue(args[0])
        }
        if args.len() > 1 {
            onRej = cloneValue(args[1])
        }
    } else if name == "catch" {
        if args.len() > 0 {
            onRej = cloneValue(args[0])
        }
    } else {
        // finally: run the callback on either path, then pass the ORIGINAL
        // settlement through — the callback's return value is discarded and a
        // rejection stays a rejection
        if args.len() > 0 {
            onFul = cloneValue(args[0])
            onRej = cloneValue(args[0])
        }
        isFinally = true
    }
    let derived = newPromise(&mut st, 0, JSValue.Undefined)
    let state = st.objects[o].promiseState
    if state == 2 {
        var ki: i64 = 0
        var kept: Vec<i64> = Vec.new()
        while ki < st.unhandledRejects.len() {
            if st.unhandledRejects[ki] != o {
                kept.push(st.unhandledRejects[ki])
            }
            ki = ki + 1
        }
        st.unhandledRejects = kept
    }
    if state == 0 {
        st.objExtras[st.objects[o].extra].reactions.push(Reaction {
            onFulfilled: onFul, onRejected: onRej, derived: derived, isFinally: isFinally
        }
        )
    } else {
        var handler = onFul
        if state == 2 {
            handler = onRej
        }
        st.microtasks.push(Microtask {
            cb: handler, arg: cloneValue(st.objExtras[st.objects[o].extra].promiseValue), derived: derived, passthroughReject: state == 2, isFinally: isFinally, noArgs: false
        }
        )
    }
    return JSValue.Obj(derived)
}

pub fn isCallable(v: &JSValue): bool {
    match v {
        JSValue.Func(_f, _e, _fo) => {
            return true
        }
        JSValue.Native(_i) => {
            return true
        }
        _ => {
            return false
        }
    }
}

// isCallable, but also true for bound-method objects (Function.prototype.bind
// results and the builtin bound methods). They are ordinary JSObjs, so the
// JSValue-only test above cannot see them — typeof already reports "function".
pub fn isCallableIn(st: &Interp, v: &JSValue): bool {
    if isCallable(v) {
        return true
    }
    let h = objHandle(v)
    if h >= 0 {
        // napiFn objects are functions implemented by a loaded addon; a proxy is
        // callable when whatever it wraps is
        if st.objects[h].isProxy {
            // decided at creation and recorded inline, so revoking a proxy over
            // a function does not change `typeof` out from under a caller
            return st.objects[h].isFunctionLike
        }
        return st.objects[h].isBound || st.objExtras[st.objects[h].extra].napiFn >= 0
    }
    return false
}

// ── generic (array-like) receivers ───────────────────────────────────────────
//
// Every Array.prototype method is *generic* in ES: the spec defines it over any
// object with a `length` and indexed properties, and over strings. But the
// natives in `arrayMethod` read `elems` directly, so they only ever worked on a
// real array — `Array.prototype.join.call({length:3, 0:"a"})` silently returned
// undefined rather than "a,,".
//
// So a non-array receiver is ADAPTED: its indexed properties are copied into a
// scratch array, the method runs on that, and the mutating methods write the
// result back. The copy is observable in exactly one place — the 3rd callback
// argument, which the spec says is the ORIGINAL object — so the scratch array
// records where it came from in `arrayLikeOrig` and `makeCbArgs` hands that out
// instead. Storing it on the scratch array rather than on Interp is what makes
// nesting work: a callback that itself calls a generic method gets its own.

// Materializing a length this large would hang long before it OOMs, and the
// spec limit (2^53-1) is not representable as an allocation. Past this the
// adapter throws instead — a loud, bounded failure beats a wedged process.
pub let ARRAY_LIKE_MAX: i64 = 1 << 24

pub fn callMember(prog: &Prog, recv: JSValue, name: &string, argsIdx: ArgListId, st: &mut Interp, scope: i64): JSValue {
    // scoped roots: the receiver and every argument evalArgs pushes stay alive
    // for the whole call, and the arms need not balance their pops (see evalArgs)
    let base = st.tempRoots.len()
    rootIfHeap(&mut st, recv)
    let r = callMemberArms(prog, recv, name, argsIdx, &mut st, scope)
    truncateTemps(&mut st, base)
    return r
}

fn callMemberArms(prog: &Prog, recv: JSValue, name: &string, argsIdx: ArgListId, st: &mut Interp, scope: i64): JSValue {
    // A SYMBOL-keyed member resolves through the ordinary property machinery and
    // is then called with the receiver, rather than being routed by the built-in
    // kind dispatch below -- that dispatch is keyed on ordinary method names and
    // answered undefined for `d[Symbol.toPrimitive]("number")`, dropping both the
    // method and its `this`. Only symbol keys take this path, so nothing that
    // works today changes route.
    if isSymbolKey(name) && objHandle(recv) >= 0 {
        let symM = getMemberDyn(prog, objHandle(recv), name.clone(), &mut st)
        if st.throwing {
            return JSValue.Undefined
        }
        if isCallableIn(st, symM) {
            rootIfHeap(&mut st, symM)
            let symArgs = evalArgs(prog, argsIdx, &mut st, scope)
            if st.throwing {
                return JSValue.Undefined
            }
            return callValue(prog, symM, symArgs, cloneValue(recv), &mut st)
        }
    }
    // Methods every primitive answers to. JS boxes the receiver for these; here
    // they are answered directly, which covers the cases real code uses.
    if name == "toString" || name == "valueOf" || name == "toFixed" || name == "toPrecision" || name == "toExponential" || name == "toLocaleString" {
        // null and undefined are NOT primitives that box: there is nothing to
        // read the method off, so this is the same TypeError that plain property
        // access already raised. The fast path below only asked "not an object
        // and not a function", which both of them satisfy, so `(null).toString()`
        // answered "null" where node throws.
        match recv {
            JSValue.Null => {
                return throwErr(&mut st, "TypeError", "Cannot read properties of null (reading '" + name.clone() + "')")
            }
            JSValue.Undefined => {
                return throwErr(&mut st, "TypeError", "Cannot read properties of undefined (reading '" + name.clone() + "')")
            }
            _ => {
            }
        }
        var useDirectPrimitive = objHandle(recv) < 0 && funcHandle(recv) < 0
        match recv {
            JSValue.Str(_) => {
                useDirectPrimitive = useDirectPrimitive && st.stringProtoPristine
            }
            // a Native is not a primitive: `Math.max.toString()` is
            // "function max() { [native code] }", and this fast path answered
            // the bare word "function" for it
            JSValue.Native(_) => {
                useDirectPrimitive = false
            }
            _ => {
            }
        }
        if useDirectPrimitive {
            let argVals = evalArgs(prog, argsIdx, &mut st, scope)
            // An argument expression that threw ABORTS the call: without this the
            // callee still ran with the arguments evaluated so far, so
            // `arr.push(boom())` pushed a value and a Promise executor's
            // `resolve(boom())` settled the promise with undefined.
            if st.throwing {
                return JSValue.Undefined
            }
            return primitiveMethodProg(prog, name, recv, argVals, &mut st)
        }
    }
    match recv {
        JSValue.Str(s) => {
            let argVals = evalArgs(prog, argsIdx, &mut st, scope)
            // An argument expression that threw ABORTS the call: without this the
            // callee still ran with the arguments evaluated so far, so
