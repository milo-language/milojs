fn arityData(): string {
    return "UTC:7,__defineGetter__:2,__defineSetter__:2,__lookupGetter__:1,__lookupSetter__:1,abs:1,acos:1,acosh:1,add:1,all:1,allSettled:1,anchor:1,any:1,apply:2,asin:1,asinh:1,assign:2,at:1,atan:1,atan2:2,atanh:1,big:0,bind:1,blink:0,bold:0,call:1,catch:1,cbrt:1,ceil:1,charAt:1,charCodeAt:1,clear:0,clz32:1,codePointAt:1,compile:2,concat:1,construct:2,copyWithin:2,cos:1,cosh:1,create:2,defineProperties:2,defineProperty:3,delete:1,deleteProperty:2,difference:1,endsWith:1,entries:0,every:1,exec:1,exp:1,expm1:1,f16round:1,fill:1,filter:1,finally:1,find:1,findIndex:1,findLast:1,findLastIndex:1,fixed:0,flat:0,flatMap:1,floor:1,fontcolor:1,fontsize:1,forEach:1,freeze:1,from:1,fromAsync:1,fromCharCode:1,fromCodePoint:1,fromEntries:1,fround:1,get:1,getBigInt64:1,getBigUint64:1,getDate:0,getDay:0,getFloat16:1,getFloat32:1,getFloat64:1,getFullYear:0,getHours:0,getInt16:1,getInt32:1,getInt8:1,getMilliseconds:0,getMinutes:0,getMonth:0,getOwnPropertyDescriptor:2,getOwnPropertyDescriptors:1,getOwnPropertyNames:1,getOwnPropertySymbols:1,getPrototypeOf:1,getSeconds:0,getTime:0,getTimezoneOffset:0,getUTCDate:0,getUTCDay:0,getUTCFullYear:0,getUTCHours:0,getUTCMilliseconds:0,getUTCMinutes:0,getUTCMonth:0,getUTCSeconds:0,getUint16:1,getUint32:1,getUint8:1,getYear:0,groupBy:2,has:1,hasOwn:2,hasOwnProperty:1,hypot:2,imul:2,includes:1,indexOf:1,intersection:1,is:2,isArray:1,isDisjointFrom:1,isExtensible:1,isFinite:1,isFrozen:1,isInteger:1,isNaN:1,isPrototypeOf:1,isRawJSON:1,isSafeInteger:1,isSealed:1,isSubsetOf:1,isSupersetOf:1,isView:1,isWellFormed:0,italics:0,join:1,keys:0,lastIndexOf:1,link:1,localeCompare:1,log:1,log10:1,log1p:1,log2:1,map:1,match:1,matchAll:1,max:2,min:2,normalize:0,now:0,of:0,ownKeys:1,padEnd:1,padStart:1,parse:2,parseFloat:1,parseInt:2,pop:0,pow:2,preventExtensions:1,propertyIsEnumerable:1,push:1,race:1,random:0,raw:1,rawJSON:1,reduce:1,reduceRight:1,reject:1,repeat:1,replace:2,replaceAll:2,resize:1,resolve:1,reverse:0,round:1,seal:1,search:1,set:1,setBigInt64:2,s