fn arityData(): string {
    return "UTC:7,__defineGetter__:2,__defineSetter__:2,__lookupGetter__:1,__lookupSetter__:1,abs:1,acos:1,acosh:1,add:1,all:1,allSettled:1,anchor:1,any:1,apply:2,asin:1,asinh:1,assign:2,at:1,atan:1,atan2:2,atanh:1,big:0,bind:1,blink:0,bold:0,call:1,catch:1,cbrt:1,ceil:1,charAt:1,charCodeAt:1,clear:0,clz32:1,codePointAt:1,compile:2,concat:1,construct:2,copyWithin:2,cos:1,cosh:1,create:2,defineProperties:2,defineProperty:3,delete:1,deleteProperty:2,difference:1,endsWith:1,entries:0,every:1,exec:1,exp:1,expm1:1,f16round:1,fill:1,filter:1,finally:1,find:1,findIndex:1,findLast:1,findLastIndex:1,fixed:0,flat:0,flatMap:1,floor:1,fontcolor:1,fontsize:1,forEach:1,freeze:1,from:1,fromAsync:1,fromCharCode:1,fromCodePoint:1,fromEntries:1,fround:1,get:1,getBigInt64:1,getBigUint64:1,getDate:0,getDay:0,getFloat16:1,getFloat32:1,getFloat64:1,getFullYear:0,getHours:0,getInt16:1,getInt32:1,getInt8:1,getMilliseconds:0,getMinutes:0,getMonth:0,getOwnPropertyDescriptor:2,getOwnPropertyDescriptors:1,getOwnPropertyNames:1,getOwnPropertySymbols:1,getPrototypeOf:1,getSeconds:0,getTime:0,getTimezoneOffset:0,getUTCDate:0,getUTCDay:0,getUTCFullYear:0,getUTCHours:0,getUTCMilliseconds:0,getUTCMinutes:0,getUTCMonth:0,getUTCSeconds:0,getUint16:1,getUint32:1,getUint8:1,getYear:0,groupBy:2,has:1,hasOwn:2,hasOwnProperty:1,hypot:2,imul:2,includes:1,indexOf:1,intersection:1,is:2,isArray:1,isDisjointFrom:1,isExtensible:1,isFinite:1,isFrozen:1,isInteger:1,isNaN:1,isPrototypeOf:1,isRawJSON:1,isSafeInteger:1,isSealed:1,isSubsetOf:1,isSupersetOf:1,isView:1,isWellFormed:0,italics:0,join:1,keys:0,lastIndexOf:1,link:1,localeCompare:1,log:1,log10:1,log1p:1,log2:1,map:1,match:1,matchAll:1,max:2,min:2,normalize:0,now:0,of:0,ownKeys:1,padEnd:1,padStart:1,parse:2,parseFloat:1,parseInt:2,pop:0,pow:2,preventExtensions:1,propertyIsEnumerable:1,push:1,race:1,random:0,raw:1,rawJSON:1,reduce:1,reduceRight:1,reject:1,repeat:1,replace:2,replaceAll:2,resize:1,resolve:1,reverse:0,round:1,seal:1,search:1,set:1,setBigInt64:2,setBigUint64:2,setDate:1,setFloat16:2,setFloat32:2,setFloat64:2,setFullYear:3,setHours:4,setInt16:2,setInt32:2,setInt8:2,setMilliseconds:1,setMinutes:3,setMonth:2,setPrototypeOf:2,setSeconds:2,setTime:1,setUTCDate:1,setUTCFullYear:3,setUTCHours:4,setUTCMilliseconds:1,setUTCMinutes:3,setUTCMonth:2,setUTCSeconds:2,setUint16:2,setUint32:2,setUint8:2,setYear:1,shift:0,sign:1,sin:1,sinh:1,slice:2,small:0,some:1,sort:1,splice:2,split:2,sqrt:1,startsWith:1,strike:0,stringify:3,sub:0,subarray:2,substr:2,substring:2,sup:0,symmetricDifference:1,tan:1,tanh:1,test:1,then:2,toDateString:0,toExponential:1,toFixed:1,toGMTString:0,toISOString:0,toJSON:1,toLocaleDateString:0,toLocaleLowerCase:0,toLocaleString:0,toLocaleTimeString:0,toLocaleUpperCase:0,toLowerCase:0,toPrecision:1,toReversed:0,toSorted:1,toSpliced:2,toString:0,toTimeString:0,toUTCString:0,toUpperCase:0,toWellFormed:0,transfer:0,transferToFixedLength:0,trim:0,trimEnd:0,trimLeft:0,trimRight:0,trimStart:0,trunc:1,try:1,union:1,unshift:1,valueOf:0,values:0,with:2,withResolvers:0"
}


// Find `name` in "n:a,n:a,..." and answer its arity, or 0 when it is absent
// (which is what every one of these tables returned for an unlisted name).
//
// A scan rather than a HashMap: a global map cannot be initialized in the
// embeddable build, which is compiled with --no-entry and so runs no global
// initializers. At a few hundred boot-time lookups over 4KB the scan does not
// show up, and it keeps these three fns stateless.
pub fn arityLookup(data: &string, name: &string): i64 {
    let n = data.len()
    let m = name.len()
    var i: i64 = 0
    while i < n {
        var k: i64 = 0
        while k < m && i + k < n && data[i + k] == name[k] {
            k = k + 1
        }
        if k == m && i + k < n && data[i + k] == ':' {
            var j = i + k + 1
            var neg = false
            if j < n && data[j] == '-' {
                neg = true
                j = j + 1
            }
            var v: i64 = 0
            while j < n && data[j] != ',' {
                v = v * 10 + (data[j] - '0') as i64
                j = j + 1
            }
            if neg {
                return -v
            }
            return v
        }
        while i < n && data[i] != ',' {
            i = i + 1
        }
        i = i + 1
    }
    return 0
}

pub fn builtinCtorArity(n: &string): i64 {
    return arityLookup(ctorArityData(), n)
}

pub fn builtinStaticArity(n: &string): i64 {
    return arityLookup(staticArityData(), n)
}

fn builtinArity(n: &string): i64 {
    return arityLookup(arityData(), n)
}

// A few method NAMES are shared by builtins whose arities differ, so a table
// keyed by the name alone is necessarily wrong for one of them. `set` is the
// live case: Map.prototype.set and WeakMap.prototype.set take (key, value) and
// report 2, while %TypedArray%.prototype.set takes (array, offset) and reports
// 1. builtinArity holds the TypedArray value, so the host is passed in at the
// sites that know it rather than the constant being flipped (which would only
// move the failure onto TypedArray).
pub fn builtinArityOn(host: &string, n: &string): i64 {
    if n == "set" && (host == "Map" || host == "WeakMap") {
        return 2
    }
    // the symbol-keyed built-in methods, which a name table cannot spell
    let wk = symIdOfKey(n)
    if wk >= 0 {
        if wk == WK_REPLACE || wk == WK_SPLIT {
            return 2
        }
        if wk == WK_ITERATOR || wk == WK_ASYNC_ITERATOR {
            return 0
        }
        return 1
    }
    return builtinArity(n)
}

// The host brand a receiver belongs to, for builtinArityOn. Only the brands
// that take part in an arity conflict need naming; everything else is "".
fn hostBrandOf(st: &Interp, recv: &JSValue): string {
    let h = objHandle(recv)
    if h < 0 {
        return ""
    }
    if st.objects[h].isMap {
        return "Map"
    }
    return ""
}

pub fn makeBoundMethod(st: &mut Interp, recv: JSValue, name: string): JSValue {
    let host = hostBrandOf(st, recv)
    return makeBoundMethodOn(&mut st, recv, name, host)
}

// A bind() result carries its own `length` — the target's, less the pre-bound
// arguments, floored at 0 — and `name`, which is "bound " prefixed to the
// target's. Both were absent, so a wrapper that preserves arity by reading
// fn.length off a bound function got undefined; function-bind asserts each.
fn finishBind(prog: &Prog, st: &mut Interp, bo: i64, target: &JSValue, nBound: i64) {
    var arity: i64 = 0
    var nm = ""
    match target {
        JSValue.Func(tf, _te, _fo) => {
            arity = funcArity(prog, tf)
            nm = prog.funcs[tf].name.clone()
        }
        JSValue.Obj(to) => {
            arity = toNum(getMember(st, to, "length")) as i64
            nm = toStr(getMember(st, to, "name"))
        }
        JSValue.Native(tn) => {
            let bag = getNativeProps(&mut st, tn)
            arity = toNum(getMember(st, bag, "length")) as i64
            nm = toStr(getMember(st, bag, "name"))
        }
        _ => {
        }
    }
    var len = arity - nBound
    if len < 0 {
        len = 0
    }
    objDefineBuiltinAttr(&mut st, bo, "length", JSValue.Number(len as f64))
    objDefineBuiltinAttr(&mut st, bo, "name", JSValue.Str("bound " + nm))
}

pub fn makeBoundMethodOn(st: &mut Interp, recv: JSValue, name: string, host: string): JSValue {
    let bo = newObject(&mut st)
    st.objects[bo].isBound = true
    let ex = ensureExtra(&mut st, bo)
    st.objExtras[ex].boundThis = recv
    st.objExtras[ex].boundMethod = name.clone()
    // every built-in function has own `name` and `length` — test262 checks one
    // of each per method, with verifyProperty, so they must be real own
    // properties with the spec's attributes and not synthesised on read
    objDefineBuiltinAttr(&mut st, bo, "length", JSValue.Number(builtinArityOn(host, name) as f64))
    objDefineBuiltinAttr(&mut st, bo, "name", JSValue.Str(keyFunctionName(st, name)))
    return JSValue.Obj(bo)
}

// An array iterator: a plain object holding the source array plus a cursor, with
// `next` and `[Symbol.iterator]` as bound builtin methods. Built this way because
// a native has no per-instance state and JSValue has nowhere to carry a cursor.
// kind: 0 values, 1 keys, 2 entries.
// An array iterator over a string's CODE POINTS: the same yields node's string
// iterator produces, and the object shape callers walk. Shared by the two string
// dispatch sites — the extracted-then-called form and the direct
// `"ab"[Symbol.iterator]()` form take different paths and both need it.
fn makeStringIterator(st: &mut Interp, sv: &string): JSValue {
    let cps = newArray(&mut st)
    pushTemp(&mut st, JSValue.Obj(cps))
    for cp in strCodePoints(sv) {
        arrPush(&mut st, cps, JSValue.Str(cp.clone()))
    }
    let itv = makeArrayIterator(&mut st, cps, 0)
    popTemp(&mut st)
    return itv
}

pub fn makeArrayIterator(st: &mut Interp, arr: i64, kind: i64): JSValue {
    let it = newObject(&mut st)
    pushTemp(&mut st, JSValue.Obj(it))
    objSet(&mut st, it, "__ai_arr", JSValue.Obj(arr))
    objSet(&mut st, it, "__ai_i", JSValue.Number(0.0))
    objSet(&mut st, it, "__ai_kind", JSValue.Number(kind as f64))
    let nextFn = makeBoundMethod(&mut st, JSValue.Obj(it), "__arrayIterNext")
    objSet(&mut st, it, "next", nextFn)
    let selfFn = makeBoundMethod(&mut st, JSValue.Obj(it), "__arrayIterSelf")
    objSet(&mut st, it, symIteratorKey(), selfFn)
    if st.iterProtoObj >= 0 {
        st.objects[it].proto = st.iterProtoObj
    }
    popTemp(&mut st)
    return JSValue.Obj(it)
}

// new <T>Array(n | buffer | array) — allocates its own buffer except when handed
// an existing ArrayBuffer, which it views in place (mutations are shared).
// A view whose backing buffer has been detached (ArrayBuffer.prototype.transfer,
// or the test262 host hook). The spec makes such a view behave as a zero-length
// one for length/byteLength/byteOffset, undefined for every index, and a
// TypeError from every %TypedArray%.prototype method.
pub fn taIsDetached(st: &Interp, o: i64): bool {
    let buf = st.objExtras[st.objects[o].extra].taBuf
    if buf < 0 {
        return false
    }
    return st.objects[buf].abDetached
}

// A fixed-length view whose window no longer fits its buffer. Only a RESIZABLE
// buffer can shrink under a view, and the spec then treats the view as out of
// bounds: its length reads 0, its elements read undefined, and every prototype
// method throws (ValidateTypedArray). A tracking view is never out of bounds by
// length — it just gets shorter — but its OFFSET can fall off the end.
pub fn taOutOfBounds(st: &Interp, o: i64): bool {
    let buf = st.objExtras[st.objects[o].extra].taBuf
    if buf < 0 || st.objects[buf].abDetached {
        return false
    }
    let have = st.objExtras[st.objects[buf].extra].bytes.len()
    let off = st.objExtras[st.objects[o].extra].taOffset
    if st.objExtras[st.objects[o].extra].taTracking {
        return off > have
    }
    var w = 1
    if !st.objects[o].isDataView {
        w = taWidth(st.objExtras[st.objects[o].extra].taKind)
    }
    return off + st.objExtras[st.objects[o].extra].taLen * w > have
}

// The view's element count RIGHT NOW. A tracking view over a resizable buffer
// answers a different number after every resize, so nothing may read the stored
// taLen directly.
// CanonicalNumericIndexString: a key whose ToString(ToNumber(key)) is the key
// itself. On a typed array such a key is handled by the integer-index path even
// when it is not a valid index, and an invalid one is DROPPED rather than stored:
// `u8["1.5"] = 5` and `u8[-1] = 5` must leave no property behind. Without this
// they became ordinary properties, so they read back and turned up in
// Object.keys, which no real array index ever does.
pub fn isCanonicalNumericKey(key: &string): bool {
    if key.len() == 0 {
        return false
    }
    // "-0" is the one canonical form ToString does not reproduce
    if key == "-0" {
        return true
    }
    let n = toNum(JSValue.Str(key.clone()))
    return numToStr(n) == key.clone()
}

pub fn taCurrentLen(st: &Interp, o: i64): i64 {
    let buf = st.objExtras[st.objects[o].extra].taBuf
    if buf < 0 || st.objects[buf].abDetached || taOutOfBounds(st, o) {
        return 0
    }
    if !st.objExtras[st.objects[o].extra].taTracking {
        return st.objExtras[st.objects[o].extra].taLen
    }
    let w = taWidth(st.objExtras[st.objects[o].extra].taKind)
    var n = (st.objExtras[st.objects[buf].extra].bytes.len() - st.objExtras[st.objects[o].extra].taOffset) / w
    if n < 0 {
        n = 0
    }
    return n
}

pub fn makeTypedArray(prog: &Prog, st: &mut Interp, kind: i64, args: &Vec<JSValue>): JSValue {
    let w = taWidth(kind)
    var bufH: i64 = -1
    var viewOffset: i64 = 0
    var len: i64 = 0
    var tracks = false
    var seed: Vec<f64> = Vec.new()
    if args.len() > 0 {
        let h = objHandle(args[0])
        if h >= 0 && st.objects[h].isArrayBuffer {
            bufH = h
            // new T(buffer, byteOffset, length) — a window into the buffer, not
            // necessarily the whole thing
            // ToIndex on the byte offset: a symbol is a TypeError and a
            // negative value a RangeError. Clamping to 0 accepted both and built
            // a view at offset 0, so every one of these cases read as success.
            var boff: i64 = 0
            if args.len() > 1 && !isUndefinedValue(args[1]) {
                let rawOff = toNumProg(prog, args[1], &mut st)
                if st.throwing {
                    return JSValue.Undefined
                }
                if rawOff == rawOff && (rawOff < 0.0 || rawOff > 9007199254740991.0) {
                    return throwErr(&mut st, "RangeError", "Invalid typed array offset")
                }
                boff = numToIndex(rawOff)
                if boff < 0 {
                    boff = 0
                }
            }
            // The offset must land on an element boundary, and the window must
            // fit inside the buffer.
            let bufLen = st.objExtras[st.objects[h].extra].bytes.len()
            if boff % w != 0 || boff > bufLen {
                return throwErr(&mut st, "RangeError", "start offset of " + taName(kind) + " should be a multiple of " + i64ToStr(w))
            }
            // With no explicit length the view spans the rest of the buffer, so
            // the buffer itself has to divide evenly into elements.
            if (args.len() <= 2 || isUndefinedValue(args[2])) && bufLen % w != 0 {
                return throwErr(&mut st, "RangeError", "byte length of " + taName(kind) + " should be a multiple of " + i64ToStr(w))
            }
            let avail = st.objExtras[st.objects[h].extra].bytes.len() - boff
            var count = avail / w
            if count < 0 {
                count = 0
            }
            if args.len() > 2 && !isUndefinedValue(args[2]) {
                let want = numToIndex(toNumProg(prog, args[2], &mut st))
                // A window that runs past the end of the buffer is a RangeError.
                // Clamping it instead handed back a SHORTER view than asked for,
                // so the caller saw a successful construction of the wrong size.
                if want < 0 || boff + want * w > st.objExtras[st.objects[h].extra].bytes.len() {
                    return throwErr(&mut st, "RangeError", "Invalid typed array length")
                }
                count = want
            }
            viewOffset = boff
            len = count
            // A third argument fixes the length; without one (or with an
            // explicit undefined) the view tracks the buffer.
            tracks = args.len() <= 2 || isUndefinedValue(args[2])
        } else if h >= 0 && st.objects[h].isArray {
            var i: i64 = 0
            while i < arrLen(st, h) {
                seed.push(toNum(arrGet(st, h, i)))
                i = i + 1
            }
            len = seed.len()
        } else if h >= 0 && st.objExtras[st.objects[h].extra].taBuf >= 0 {
            // from another typed array: copy the element values
            var i: i64 = 0
            while i < st.objExtras[st.objects[h].extra].taLen {
                seed.push(taElem(st, h, i))
                i = i + 1
            }
            len = seed.len()
        } else if h >= 0 {
            // any other OBJECT: the spec takes the iterable path when it has
            // Symbol.iterator (a Set, a generator, and here a Buffer) and the
            // array-like path otherwise (`length` plus indexed reads). Neither
            // existed — every such argument fell through to the length branch,
            // where toNum of an object is NaN, so `new Uint8Array(buf)` came
            // back EMPTY rather than throwing.
            // same drivability test iterableToArray itself uses — a Set/Map
            // carries no Symbol.iterator PROPERTY, so probing for one alone
            // would send `new Uint8Array(new Set([1,2,3]))` down the array-like
            // path and produce an empty view
            let drivable = st.objects[h].isGenerator || st.objects[h].isMap
                || st.objects[h].isSet || st.objects[h].isProxy
                || isCallableIn(st, getMember(st, h, symIteratorKey()))
            var srcH: i64 = -1
            if drivable {
                let arr = iterableToArray(prog, cloneValue(args[0]), &mut st)
                srcH = objHandle(arr)
            }
            if srcH >= 0 {
                pushTemp(&mut st, JSValue.Obj(srcH))
                var i: i64 = 0
                while i < arrLen(st, srcH) {
                    seed.push(toNum(arrGet(st, srcH, i)))
                    i = i + 1
                }
                popTemp(&mut st)
            } else {
                let lv = toNum(getMemberDyn(prog, h, "length", &mut st))
                var ln: i64 = 0
                if lv == lv && lv > 0.0 {
                    ln = lv as i64
                }
                var i: i64 = 0
                while i < ln {
                    seed.push(toNum(getMemberDyn(prog, h, i64ToStr(i), &mut st)))
                    i = i + 1
                }
            }
            len = seed.len()
        } else {
            // ToIndex rejects a negative or non-integral length with a
            // RangeError; clamping it to 0 made `new Int8Array(-1)` an empty
            // view, which reads as a successful construction.
            let rawLen = toNumProg(prog, args[0], &mut st)
            if st.throwing {
                return JSValue.Undefined
            }
            if rawLen == rawLen && (rawLen < 0.0 || rawLen > 9007199254740991.0) {
                return throwErr(&mut st, "RangeError", "Invalid typed array length: " + numToStr(rawLen))
            }
            len = numToIndex(rawLen)
            if len < 0 {
                len = 0
            }
        }
    }
    if bufH < 0 {
        let nb = newObject(&mut st)
        st.objects[nb].isArrayBuffer = true
        st.objects[nb].proto = arrayBufferProto(&mut st)
        let _e = ensureExtra(&mut st, nb)
        var b: Vec<u8> = Vec.new()
        var i: i64 = 0
        while i < len * w {
            b.push(0 as u8)
            i = i + 1
        }
        st.objExtras[st.objects[nb].extra].bytes = b
        bufH = nb
    }
    let view = newObject(&mut st)
    let _ev = ensureExtra(&mut st, view)
    st.objExtras[st.objects[view].extra].taBuf = bufH
    st.objExtras[st.objects[view].extra].taKind = kind
    st.objects[view].proto = typedArrayProtoFor(&mut st, kind)
    st.objExtras[st.objects[view].extra].taOffset = viewOffset
    st.objExtras[st.objects[view].extra].taLen = len
    st.objExtras[st.objects[view].extra].taTracking = tracks
    var k: i64 = 0
    while k < seed.len() {
        taSetElem(&mut st, view, k, seed[k])
        k = k + 1
    }
    return JSValue.Obj(view)
}

// The element as a JSValue. A BigInt-kind view yields JSValue.BigInt, and its
// elements cannot go through the f64 path at all: the range runs to 2^64 and f64
// loses integers past 2^53, so a round trip through a double would silently
// corrupt the top bits.
pub fn taElemValue(st: &Interp, view: i64, i: i64): JSValue {
    let kind = st.objExtras[st.objects[view].extra].taKind
    if !taIsBigKind(kind) {
        // Out of range, or a buffer detached since the caller read the length:
        // the element is ABSENT, which reads as undefined. taElem answers 0 for
        // both, so a callback that detached the buffer mid-iteration kept seeing
        // zeros instead of undefined for the rest of the loop. The big-int path
        // below already checked; this one did not.
        if i < 0 || i >= taCurrentLen(st, view) {
            return JSValue.Undefined
        }
        return JSValue.Number(taElem(st, view, i))
    }
    let buf = st.objExtras[st.objects[view].extra].taBuf
    if buf < 0 || i < 0 || i >= taCurrentLen(st, view) {
        return JSValue.Undefined
    }
    let at = st.objExtras[st.objects[view].extra].taOffset + i * 8
    if at < 0 || at + 8 > st.objExtras[st.objects[buf].extra].bytes.len() {
        return JSValue.Undefined
    }
    return JSValue.BigInt(taLoadBig(st.objExtras[st.objects[buf].extra].bytes, kind, at))
}

fn taSetElemValue(st: &mut Interp, view: i64, i: i64, v: &JSValue) {
    let kind = st.objExtras[st.objects[view].extra].taKind
    if !taIsBigKind(kind) {
        taSetElem(&mut st, view, i, toNum(v))
        return
    }
    let buf = st.objExtras[st.objects[view].extra].taBuf
    if buf < 0 || i < 0 || i >= taCurrentLen(st, view) {
        return
    }
    let at = st.objExtras[st.objects[view].extra].taOffset + i * 8
    if at < 0 || at + 8 > st.objExtras[st.objects[buf].extra].bytes.len() {
        return
    }
    var digits = "0"
    if let JSValue.BigInt(bs) = v {
        digits = bs.clone()
    }
    taStoreBig(&mut st.objExtras[st.objects[buf].extra].bytes, at, digits)
}

pub fn taElem(st: &Interp, view: i64, i: i64): f64 {
    let buf = st.objExtras[st.objects[view].extra].taBuf
    if buf < 0 || i < 0 || i >= taCurrentLen(st, view) {
        return 0.0
    }
    let w = taWidth(st.objExtras[st.objects[view].extra].taKind)
    let at = st.objExtras[st.objects[view].extra].taOffset + i * w
    // the backing buffer may have been resized/detached under this view (a sort
    // comparator or a length getter can do it) — out-of-range reads yield 0
    if at < 0 || at + w > st.objExtras[st.objects[buf].extra].bytes.len() {
        return 0.0
    }
    return taLoad(st.objExtras[st.objects[buf].extra].bytes, st.objExtras[st.objects[view].extra].taKind, at)
}

pub fn taSetElem(st: &mut Interp, view: i64, i: i64, v: f64) {
    let buf = st.objExtras[st.objects[view].extra].taBuf
    if buf < 0 || i < 0 || i >= taCurrentLen(st, view) {
        return
    }
    let kind = st.objExtras[st.objects[view].extra].taKind
    let w = taWidth(kind)
    let at = st.objExtras[st.objects[view].extra].taOffset + i * w
    // a resized/detached buffer drops the write rather than overflowing its bytes
    if at < 0 || at + w > st.objExtras[st.objects[buf].extra].bytes.len() {
        return
    }
    taStore(&mut st.objExtras[st.objects[buf].extra].bytes, kind, at, v)
}

// The method NAME a bound builtin value carries, or "" for anything else. Used to
// notice that a lookup came back with the very method the dispatcher is already
// handling, which would re-enter it.
fn boundMethodNameOf(st: &Interp, v: &JSValue): string {
    let h = objHandle(v)
    if h < 0 {
        return ""
    }
    if !st.objects[h].isBound {
        return ""
    }
    return st.objExtras[st.objects[h].extra].boundMethod.clone()
}

// The getters behind the accessor properties on the builtin prototypes. Each is
// installed with objDefineAccessor and a brand, so an incompatible receiver is
// rejected by brandOk before this runs; the name is the only thing left to
// dispatch on. Kept apart from callBuiltinByName because none of them takes
// arguments or needs a Prog.
//
// These were plain absent: `Object.getOwnPropertyDescriptor(Map.prototype,
// "size")` answered undefined, so anything reflecting over a builtin prototype
// (test262's propertyHelper, feature detection, util.inspect clones) saw a
// prototype with no shape at all.
fn builtinAccessorValue(st: &mut Interp, o: i64, name: &string): JSValue {
    if name == "__mapSize" || name == "__setSize" {
        return JSValue.Number(st.objExtras[st.objects[o].extra].mapKeys.len() as f64)
    }
    if name == "__taLength" {
        return JSValue.Number(taCurrentLen(st, o) as f64)
    }
    if name == "__taByteLength" {
        return JSValue.Number((taCurrentLen(st, o) * taWidth(st.objExtras[st.objects[o].extra].taKind)) as f64)
    }
    if name == "__taByteOffset" || name == "__dvByteOffset" {
        if taIsDetached(st, o) || taOutOfBounds(st, o) {
            return JSValue.Number(0.0)
        }
        return JSValue.Number(st.objExtras[st.objects[o].extra].taOffset as f64)
    }
    if name == "__taBuffer" || name == "__dvBuffer" {
        return JSValue.Obj(st.objExtras[st.objects[o].extra].taBuf)
    }
    if name == "__dvByteLength" {
        return JSValue.Number(dataViewByteLen(st, o) as f64)
    }
    return JSValue.Undefined
}

// True for the names builtinAccessorValue answers.
fn isBuiltinAccessorName(n: &string): bool {
    return n == "__speciesSelf" || n == "__mapSize" || n == "__setSize" || n == "__taLength" || n == "__taByteLength" || n == "__taByteOffset" || n == "__taBuffer" || n == "__dvByteLength" || n == "__dvByteOffset" || n == "__dvBuffer"
}

// Which RegExp.prototype symbol method a String.prototype regex operation hands
// itself to (see stringRegexProtocol).
fn stringSymbolOpKey(name: &string): string {
    if name == "match" {
        return symKey(WK_MATCH)
    }
    if name == "matchAll" {
        return symKey(WK_MATCH_ALL)
    }
    if name == "replace" || name == "replaceAll" {
        return symKey(WK_REPLACE)
    }
    if name == "search" {
        return symKey(WK_SEARCH)
    }
    if name == "split" {
        return symKey(WK_SPLIT)
    }
    return ""
}


// A real regex that can take the native paths: RegExp.prototype untouched,
// still its prototype, and no own `exec`, which every RegExpExec reads first.
pub fn regexIsPlain(st: &Interp, h: i64): bool {
    return st.regexProtoPristine && h >= 0 && st.objExtras[st.objects[h].extra].regexId >= 0
        && st.objects[h].proto == st.regexProtoObj && objOwnIndex(st, h, "exec") < 0
}

fn isRegexSymbolOpKey(n: &string): bool {
    let id = symIdOfKey(n)
    return id == WK_MATCH || id == WK_MATCH_ALL || id == WK_REPLACE || id == WK_SEARCH || id == WK_SPLIT
}

// The names callMember may send straight to regexMethod on a plain regex.
fn isRegexFastName(n: &string): bool {
    return n == "exec" || n == "test" || n == "toString" || n == "compile" || isRegexSymbolOpKey(n)
}

// RegExp.prototype.test and the @@match/@@matchAll/@@replace/@@search/@@split
// methods. A plain regex runs the native implementation; any other object
// runs the spec's algorithm, self-hosted in engine-prelude.js, which calls the
// receiver's own `exec` the way the spec's RegExpExec does. The native paths
// never read `exec`, which is exactly why they are only valid on a plain regex.
fn regexProtoOp(prog: &Prog, recv: &JSValue, name: &string, args: &Vec<JSValue>, st: &mut Interp): JSValue {
    var display = keyFunctionName(st, name)
    var implName = ""
    let id = symIdOfKey(name)
    if name == "__reTest" {
        display = "test"
        implName = "test"
    } else if id == WK_MATCH {
        implName = "match"
    } else if id == WK_MATCH_ALL {
        implName = "matchAll"
    } else if id == WK_REPLACE {
        implName = "replace"
    } else if id == WK_SEARCH {
        implName = "search"
    } else {
        implName = "split"
    }
    let h = objHandle(recv)
    if h < 0 && funcHandle(recv) < 0 {
        return throwErr(&mut st, "TypeError", "RegExp.prototype." + display + " called on incompatible receiver " + toStr(recv))
    }
    // matchAll on a non-global regex yields one match and stops, which the
    // native iterator (built for String.prototype.matchAll, where the spec
    // rejects that case) does not do.
    if regexIsPlain(st, h) && !(id == WK_MATCH_ALL && !st.regexes[st.objExtras[st.objects[h].extra].regexId].flagG) {
        if name == "__reTest" {
            return regexMethod(&mut st, h, "test", args)
        }
        return regexMethod(&mut st, h, name, args)
    }
    let spec = objHandle(scopeLookup(st, 0, "__reSpec"))
    var f = JSValue.Undefined
    if spec >= 0 {
        f = objGet(st, spec, implName)
    }
    if !isCallableIn(st, f) {
        return throwErr(&mut st, "TypeError", "RegExp.prototype." + display + " needs the engine prelude")
    }
    var fargs: Vec<JSValue> = Vec.new()
    fargs.push(cloneValue(recv))
    var i: i64 = 0
    while i < args.len() {
        fargs.push(cloneValue(args[i]))
        i = i + 1
    }
    return callValue(prog, f, fargs, JSValue.Undefined, &mut st)
}

// String.prototype.match/matchAll/replace/replaceAll/search/split, in the
// spec's direction: the argument's @@match (etc.) does the work, looked up and
// called whatever it is, and a string argument is made into a RegExp whose
// @@match is invoked. Only a plain regex, or a fresh one while RegExp.prototype
// is pristine, skips the lookup for the native implementation. None means the
// operation takes its literal-string form (replace/split with a non-regex).
fn stringRegexProtocol(prog: &Prog, st: &mut Interp, sRef: &string, nameRef: &string, args: &Vec<JSValue>): Option<JSValue> {
    // copied before anything below re-enters the interpreter: either may point
    // into AST storage that a require can move
    let sv = sRef.clone()
    let nm = nameRef.clone()
    let key = stringSymbolOpKey(nm)
    if key.len() == 0 {
        return Option.None
    }
    var arg0 = JSValue.Undefined
    if args.len() > 0 {
        arg0 = cloneValue(args[0])
    }
    let h = objHandle(arg0)
    if h >= 0 {
        if regexIsPlain(st, h) && objOwnIndex(st, h, key) < 0 {
            return Option.Some(stringRegexOp(prog, sv, nm, args, &mut st))
        }
        // replaceAll and matchAll reject a non-global regex before looking the
        // method up; IsRegExp consults @@match first, then [[RegExpMatcher]]
        if nm == "replaceAll" || nm == "matchAll" {
            let mm = getMemberDyn(prog, h, symKey(WK_MATCH), &mut st)
            if st.throwing {
                return Option.Some(JSValue.Undefined)
            }
            var isRe = st.objExtras[st.objects[h].extra].regexId >= 0
            if !isUndefinedValue(mm) {
                isRe = truthy(mm)
            }
            if isRe {
                let fl = getMemberDyn(prog, h, "flags", &mut st)
                if st.throwing {
                    return Option.Some(JSValue.Undefined)
                }
                if isNullish(fl) {
                    return Option.Some(throwErr(&mut st, "TypeError", "String.prototype." + nm.clone() + " called with a RegExp whose flags are " + toStr(fl)))
                }
                let fs = toStrProg(prog, fl, &mut st)
                if st.throwing {
                    return Option.Some(JSValue.Undefined)
                }
                if jsIndexOf(fs, "g", 0) < 0 {
                    if nm == "replaceAll" {
                        return Option.Some(throwErr(&mut st, "TypeError", "replaceAll must be called with a global RegExp"))
                    }
                    return Option.Some(throwErr(&mut st, "TypeError", "String.prototype.matchAll called with a non-global RegExp argument"))
                }
            }
        }
        pushTemp(&mut st, cloneValue(arg0))
        let m = getMemberDyn(prog, h, key, &mut st)
        popTemp(&mut st)
        if st.throwing {
            return Option.Some(JSValue.Undefined)
        }
        if !isNullish(m) {
            if !isCallableIn(st, m) {
                return Option.Some(throwErr(&mut st, "TypeError", toStr(m) + " is not a function"))
            }
            var callArgs: Vec<JSValue> = Vec.new()
            callArgs.push(JSValue.Str(sv.clone()))
            var i: i64 = 1
            while i < args.len() {
                callArgs.push(cloneValue(args[i]))
                i = i + 1
            }
            return Option.Some(callValue(prog, m, callArgs, arg0, &mut st))
        }
    }
    if nm == "match" || nm == "search" || nm == "matchAll" {
        let ra = regexArgFor(&mut st, nm, args)
        if st.regexProtoPristine {
            return Option.Some(stringRegexOp(prog, sv, nm, ra, &mut st))
        }
        let rx = cloneValue(ra[0])
        pushTemp(&mut st, cloneValue(rx))
        let rm = getMemberDyn(prog, objHandle(rx), key, &mut st)
        if st.throwing {
            popTemp(&mut st)
            return Option.Some(JSValue.Undefined)
        }
        if !isCallableIn(st, rm) {
            popTemp(&mut st)
            return Option.Some(throwErr(&mut st, "TypeError", toStr(rm) + " is not a function"))
        }
        var rArgs: Vec<JSValue> = Vec.new()
        rArgs.push(JSValue.Str(sv.clone()))
        let r = callValue(prog, rm, rArgs, rx, &mut st)
        popTemp(&mut st)
        return Option.Some(r)
    }
    return Option.None
}

pub fn callBuiltinByName(prog: &Prog, recv: &JSValue, name: &string, args: Vec<JSValue>, st: &mut Interp): JSValue {
    if name == "__reTest" || isRegexSymbolOpKey(name) {
        return regexProtoOp(prog, recv, name, args, &mut st)
    }
    // the accessor properties on the builtin prototypes; brandOk has already
    // rejected an incompatible receiver by the time this runs
    if isBuiltinAccessorName(name) {
        // get [Symbol.species] answers the RECEIVER unchanged, which may be a
        // native constructor value rather than an object handle, so it is
        // resolved before the handle conversion below.
        if name == "__speciesSelf" {
            return cloneValue(recv)
        }
        let ah = objHandle(recv)
        if ah >= 0 {
            return builtinAccessorValue(&mut st, ah, name)
        }
        return JSValue.Undefined
    }
    // RegExp.prototype.toString is GENERIC: "/" + ToString(this.source) + "/" +
    // ToString(this.flags), off any object. Installed as plain "toString" it was
    // indistinguishable from Object.prototype.toString once the receiver was not
    // a regex, and branding it instead made the generic call a TypeError.
    if name == "__regexpToString" {
        let rh = objHandle(recv)
        if rh < 0 {
            return throwErr(&mut st, "TypeError", "RegExp.prototype.toString called on non-object")
        }
        let rsrc = toStrProg(prog, getMemberDyn(prog, rh, "source", &mut st), &mut st)
        if st.throwing {
            return JSValue.Undefined
        }
        let rflags = toStrProg(prog, getMemberDyn(prog, rh, "flags", &mut st), &mut st)
        if st.throwing {
            return JSValue.Undefined
        }
        return JSValue.Str("/" + rsrc + "/" + rflags)
    }
    // Date.prototype[@@toPrimitive](hint): "number" gives the time value, and both
    // "string" and "default" give the date text -- Date is the only built-in whose
    // DEFAULT hint is string rather than number.
    if name == "__dateToPrimitive" {
        let dh = objHandle(recv)
        if dh < 0 {
            return throwErr(&mut st, "TypeError", "Date.prototype[Symbol.toPrimitive] called on non-object")
        }
        var hint = "default"
        if args.len() > 0 {
            hint = toStr(args[0])
        }
        if hint != "number" && hint != "string" && hint != "default" {
            return throwErr(&mut st, "TypeError", "Invalid hint: " + hint)
        }
        // OrdinaryToPrimitive reads valueOf/toString off the receiver, so an
        // override on Date.prototype (or an own one) is what `d - 0` calls. Only
        // a pristine date with neither shadowed may skip the lookup.
        let direct = st.dateProtoPristine && st.objects[dh].isDate && st.objects[dh].proto == st.dateProtoObj
            && objOwnIndex(st, dh, "valueOf") < 0 && objOwnIndex(st, dh, "toString") < 0
        var dargs: Vec<JSValue> = Vec.new()
        if hint == "number" {
            if direct {
                return dateMethod(&mut st, dh, "valueOf", dargs)
            }
            return ordinaryToPrimitive(prog, &mut st, dh, false)
        }
        if direct {
            return dateMethod(&mut st, dh, "toString", dargs)
        }
        return ordinaryToPrimitive(prog, &mut st, dh, true)
    }
    // Date.prototype.toJSON is generic: ToPrimitive(this, number), null for a
    // non-finite number, otherwise whatever this.toISOString() answers.
    if name == "__dateToJSON" {
        if isNullish(recv) {
            return throwErr(&mut st, "TypeError", "Date.prototype.toJSON called on null or undefined")
        }
        var jo = cloneValue(recv)
        if objHandle(jo) < 0 {
            jo = makeWrapper(&mut st, recv)
        }
        pushTemp(&mut st, cloneValue(jo))
        let tv = toPrimitiveNumber(prog, jo, &mut st)
        if st.throwing {
            popTemp(&mut st)
            return JSValue.Undefined
        }
        if let JSValue.Number(tn) = tv {
            if tn != tn || tn == 1.0 / 0.0 || tn == -1.0 / 0.0 {
                popTemp(&mut st)
                return JSValue.Null
            }
        }
        let iso = getMemberDyn(prog, objHandle(jo), "toISOString", &mut st)
        if st.throwing {
            popTemp(&mut st)
            return JSValue.Undefined
        }
        if !isCallableIn(st, iso) {
            popTemp(&mut st)
            return throwErr(&mut st, "TypeError", "toISOString is not a function")
        }
        var noArgs: Vec<JSValue> = Vec.new()
        let r = callValue(prog, iso, noArgs, jo, &mut st)
        popTemp(&mut st)
        return r
    }
    // Error.prototype.toString: `name ?? "Error"` and `message ?? ""`, read off
    // whatever receiver it was given. It is not restricted to Errors -- the spec
    // requires only an object -- so it cannot be the same "toString" every other
    // prototype installs.
    if name == "__errorToString" {
        let eh = objHandle(recv)
        if eh < 0 {
            return throwErr(&mut st, "TypeError", "Error.prototype.toString called on non-object")
        }
        let rawName = getMemberDyn(prog, eh, "name", &mut st)
        if st.throwing {
            return JSValue.Undefined
        }
        var ename = "Error"
        if !isUndefinedValue(rawName) {
            ename = toStrProg(prog, rawName, &mut st)
        }
        let rawMsg = getMemberDyn(prog, eh, "message", &mut st)
        if st.throwing {
            return JSValue.Undefined
        }
        var emsg = ""
        if !isUndefinedValue(rawMsg) {
            emsg = toStrProg(prog, rawMsg, &mut st)
        }
        if ename.len() == 0 {
            return JSValue.Str(emsg)
        }
        if emsg.len() == 0 {
            return JSValue.Str(ename)
        }
        return JSValue.Str(ename + ": " + emsg)
    }
    // the function Proxy.revocable hands back. Clearing the handler is what
    // marks the proxy revoked; a second call is a no-op that still answers
    // undefined.
    if name == "__proxyRevoke" {
        let po = objHandle(recv)
        if po >= 0 && st.objects[po].isProxy {
            let ex = st.objects[po].extra
            st.objExtras[ex].proxyTarget = JSValue.Null
            st.objExtras[ex].proxyHandler = JSValue.Null
        }
        return JSValue.Undefined
    }
    // a per-module `require` value: the receiver carries the directory it was
    // bound to, so resolution matches the module the reference came from
    if name == "__require" {
        var rspec = ""
        if args.len() > 0 {
            rspec = toStr(args[0])
        }
        return requireModuleFrom(prog, rspec, &mut st, toStr(recv))
    }
    // Object.prototype.toString applied to ANY receiver, ignoring overrides
    if name == "@@objProtoToString" {
        let o = objHandle(recv)
        if o >= 0 {
            // a user [Symbol.toStringTag] (a plain string, possibly via a getter)
            // wins over the built-in tag: class { get [Symbol.toStringTag](){…} }
            let tag = getMemberDyn(prog, o, symToStringTagKey(), &mut st)
            if let JSValue.Str(ts) = tag {
                return JSValue.Str("[object " + ts + "]")
            }
            return JSValue.Str("[object " + objectTag(st, o) + "]")
        }
        if let JSValue.Func(fi, _fe, _fo) = recv {
            return JSValue.Str("[object " + funcTag(prog, fi) + "]")
        }
        return JSValue.Str("[object " + objectTypeTag(recv) + "]")
    }
    // A primitive receiver reaching a built-in method value: this is
    // `Number.prototype.toString.call(255, 16)` and friends, which fell through
    // to the generic "[object Number]" tag above instead of dispatching.
    if isPrimitiveMethodName(name) {
        match recv {
            JSValue.Number(_pn) => {
                return primitiveMethodProg(prog, name, recv, args, &mut st)
            }
            JSValue.Bool(_pb) => {
                return primitiveMethodProg(prog, name, recv, args, &mut st)
            }
            JSValue.BigInt(_pg) => {
                return primitiveMethodProg(prog, name, recv, args, &mut st)
            }
            _ => {
            }
        }
    }
    // a Symbol.prototype method reached with a symbol WRAPPER receiver runs on
    // the symbol it wraps; only the branded names get here with one
    let rwo = objHandle(recv)
    if rwo >= 0 && isSymbolMethodName(name) && isWrapperObj(st, rwo) {
        let wsid = symIdOf(boxedPrimitive(st, rwo))
        if wsid >= 0 {
            return symbolMethod(&mut st, wsid, name)
        }
    }
    match recv {
        JSValue.Sym(sid) => {
            return symbolMethod(&mut st, sid, name)
        }
        JSValue.Str(sv) => {
            // Array.prototype.map.call("abc", f) — an array method a string does
            // NOT also define runs generically over the string's units. Names
            // both sides share (slice, indexOf, concat, at…) stay with the
            // string, which is what a bare "abc".slice() must keep doing.
            if isArrayMethod(name) && !isStringMethodName(name) {
                return arrayMethodGeneric(prog, JSValue.Str(sv.clone()), name, args, &mut st)
            }
            if let Option.Some(rr) = stringRegexProtocol(prog, &mut st, sv, name, args) {
                return rr
            }
            if name == "concat" {
                return JSValue.Str(strConcatProg(prog, sv, args, &mut st))
            }
            if name == "__stringIterator" || name == symIteratorKey() {
                return makeStringIterator(&mut st, sv)
            }
            if stringArgsNeedCoercion(name, args) {
                let ca = coercedStringArgs(prog, name, args, &mut st)
                if st.throwing {
                    return JSValue.Undefined
                }
                return stringMethod(name, sv, ca, &mut st)
            }
            return stringMethod(name, sv, args, &mut st)
        }
        JSValue.Obj(o) => {
            // .call/.apply/.bind on a BUILT-IN method value. This is the
            // uncurry-this idiom —
            //   var hop = Function.prototype.call.bind(Object.prototype.hasOwnProperty)
            // — which arrives here as receiver = the built-in, name = "call".
            // Nothing handled it, so it returned undefined. test262's
            // propertyHelper.js is built entirely out of this, so EVERY
            // verifyProperty test failed regardless of the property involved.
            // a callable proxy takes the same three the way a bound function
            // does: the receiver is the proxy, so the call re-enters its [[Call]]
            if (st.objects[o].isBound || (st.objects[o].isProxy && st.objects[o].isFunctionLike)) && (name == "call" || name == "apply" || name == "bind") {
                var uThis = JSValue.Undefined
                if args.len() > 0 {
                    uThis = cloneValue(args[0])
                }
                var uRest: Vec<JSValue> = Vec.new()
                if name == "apply" {
                    if args.len() > 1 {
                        applyArgsInto(prog, &mut st, args[1], &mut uRest)
                        // reading `length` or an index can run a getter that
                        // THROWS; without this the call went ahead with a partial
                        // argument list and left the pending throw to surface at
                        // an unrelated point later
                        if st.throwing {
                            return JSValue.Undefined
                        }
                    }
                } else {
                    var ai: i64 = 1
                    while ai < args.len() {
                        uRest.push(cloneValue(args[ai]))
                        ai = ai + 1
                    }
                }
                if name == "bind" {
                    let nb = newObject(&mut st)
                    st.objects[nb].isBound = true
                    let nex = ensureExtra(&mut st, nb)
                    st.objExtras[nex].boundTarget = JSValue.Obj(o)
                    st.objExtras[nex].boundThis = uThis
                    let nb1 = uRest.len()
                    st.objExtras[nex].boundArgs = uRest
                    finishBind(prog, &mut st, nb, JSValue.Obj(o), nb1)
                    return JSValue.Obj(nb)
                }
                return callValue(prog, JSValue.Obj(o), uRest, uThis, &mut st)
            }
            // array iterator steps: state lives in properties on the iterator
            // object itself, which is also the bound receiver
            if name == "__arrayIterNext" {
                return arrayIterNext(prog, &mut st, o)
            }
            if name == "__arrayIterSelf" {
                return JSValue.Obj(o)
            }
            if name == "__abByteLength" {
                return JSValue.Number(st.objExtras[st.objects[o].extra].bytes.len() as f64)
            }
            if st.objects[o].isArrayBuffer {
                if name == "resize" {
                    var to: i64 = 0
                    if args.len() > 0 {
                        to = numToIndex(toNumProg(prog, args[0], &mut st))
                    }
                    // only a buffer created with {maxByteLength} may resize, and
                    // only within [0, cap]
                    if st.objExtras[st.objects[o].extra].abMaxLen < 0 || to < 0 || to > st.objExtras[st.objects[o].extra].abMaxLen {
                        return throwErr(&mut st, "RangeError", "ArrayBuffer.prototype.resize: invalid length")
                    }
                    var b: Vec<u8> = Vec.new()
                    var ci: i64 = 0
                    while ci < to {
                        if ci < st.objExtras[st.objects[o].extra].bytes.len() {
                            b.push(st.objExtras[st.objects[o].extra].bytes[ci])
                        } else {
                            b.push(0 as u8)
                        }
                        ci = ci + 1
                    }
                    st.objExtras[st.objects[o].extra].bytes = b
                    return JSValue.Undefined
                }
                if name == "transfer" {
                    let nb = newObject(&mut st)
                    st.objects[nb].isArrayBuffer = true
        st.objects[nb].proto = arrayBufferProto(&mut st)
                    let _e = ensureExtra(&mut st, nb)
                    var tb: Vec<u8> = Vec.new()
                    var ti: i64 = 0
                    while ti < st.objExtras[st.objects[o].extra].bytes.len() {
                        tb.push(st.objExtras[st.objects[o].extra].bytes[ti])
                        ti = ti + 1
                    }
                    st.objExtras[st.objects[nb].extra].bytes = tb
                    st.objExtras[st.objects[nb].extra].abMaxLen = st.objExtras[st.objects[o].extra].abMaxLen
                    st.objExtras[st.objects[o].extra].bytes = Vec.new()
                    st.objects[o].abDetached = true
                    return JSValue.Obj(nb)
                }
                if name == "slice" {
                    let n = st.objExtras[st.objects[o].extra].bytes.len()
                    var a: i64 = 0
                    if args.len() > 0 {
                        a = numToIndex(toNumProg(prog, args[0], &mut st))
                    }
                    if a < 0 {
                        a = n + a
                    }
                    var e = n
                    if args.len() > 1 {
                        e = numToIndex(toNumProg(prog, args[1], &mut st))
                        if e < 0 {
                            e = n + e
                        }
                    }
                    if a < 0 {
                        a = 0
                    }
                    if e > n {
                        e = n
                    }
                    let nb = newObject(&mut st)
                    st.objects[nb].isArrayBuffer = true
        st.objects[nb].proto = arrayBufferProto(&mut st)
                    let _e = ensureExtra(&mut st, nb)
                    var b: Vec<u8> = Vec.new()
                    var i = a
                    while i < e {
                        b.push(st.objExtras[st.objects[o].extra].bytes[i])
                        i = i + 1
                    }
                    st.objExtras[st.objects[nb].extra].bytes = b
                    return JSValue.Obj(nb)
                }
            }
            // Date-specific methods dispatch here (Date.prototype.toISOString.call);
            // toString/valueOf are left to the Object.prototype type-tag logic
            // below, so Object.prototype.toString.call(date) stays [object Date]
            if st.objects[o].isDate && (isDateMethodName(name) || name == "__dateToPrimitive") {
                // `toString` and `valueOf` were excluded here, so a Date reached
                // through a bound method value — which is every generic
                // conversion, since ToPrimitive reads them off the prototype —
                // fell through to the object tag: `String(d)` and `"" + d` both
                // answered "[object Date]", and `d.valueOf.call(d)` answered the
                // ISO string instead of the epoch number.
                return dateMethodProg(prog, &mut st, o, name, args)
            }
            if st.objects[o].isMap || st.objects[o].isSet {
                return mapMethod(prog, o, name, args, &mut st)
            }
            if st.objExtras[st.objects[o].extra].weakKind != 0 && isWeakMethodName(name) {
                return weakMethod(o, name, args, &mut st)
            }
            // a bound regex/buffer/typed-array method re-dispatches through here,
            // so these must be reachable or an extracted method silently does
            // nothing (no throw, no result — the process just unwinds)
            // The flag ACCESSORS are generic in the spec (see regexMethod), so
            // they have to reach it for a receiver that is not a regex at all.
            if isRegexMethodName(name) && (st.objExtras[st.objects[o].extra].regexId >= 0 || isRegexAccessorName(name)) {
                return regexMethod(&mut st, o, name, args)
            }
            if st.objects[o].isDataView && isDataViewMethodName(name) {
                return dataViewMethod(prog, o, name, args, &mut st)
            }
            if st.objects[o].isGenerator {
                var gmode: i64 = -1
                if name == "next" {
                    gmode = 0
                } else if name == "throw" {
                    gmode = 1
                } else if name == "return" {
                    gmode = 2
                }
                if gmode >= 0 {
                    if st.objects[o].isAsyncGenerator {
                        return genResumeAsync(o, args, gmode, &mut st)
                    }
                    return genResume(o, args, gmode, &mut st)
                }
                // a generator is its own iterator: gen[Symbol.iterator]() === gen
                if name == symIteratorKey() || name == symAsyncIteratorKey() {
                    return JSValue.Obj(o)
                }
            }
            if st.objExtras[st.objects[o].extra].taBuf >= 0 && isTypedArrayMethodName(name)
                && !typedArrayOverride(st, o, name) {
                return typedArrayMethod(prog, o, name, args, &mut st)
            }
            // A Node-API Buffer's `.bytes` is an array-like native view with
            // Array.prototype in its chain. Re-looking up that same bound method
            // here recurses forever; apply the generic operation to the view.
            if nativeBufferLen(st, o) >= 0 && isArrayMethod(name) {
                return arrayMethodGeneric(prog, JSValue.Obj(o), name, args, &mut st)
            }

            if name == "hasOwnProperty" {
                var key = ""
                if args.len() > 0 {
                    key = toStr(args[0])
                }
                // a proxy's own properties are whatever its
                // getOwnPropertyDescriptor trap reports, not what its slots hold
                if st.objects[o].isProxy {
                    let pd = getOwnPropDescOf(prog, &mut st, JSValue.Obj(o), key)
                    if st.throwing {
                        return JSValue.Undefined
                    }
                    return JSValue.Bool(objHandle(pd) >= 0)
                }
                return JSValue.Bool(objHas(st, o, key) || (st.objects[o].isArray && asArrayIndex(key) >= 0 && asArrayIndex(key) < arrLen(st, o) && !arrIsHole(st, o, asArrayIndex(key))))
            }
            if name == "toString" {
                // a Symbol WRAPPER prints its description, not the object tag:
                // Symbol.prototype.toString.call(Object(sym)) is "Symbol(x)"
                if isWrapperObj(st, o) {
                    if let JSValue.Sym(wid) = boxedPrimitive(st, o) {
                        return JSValue.Str(symbolDisplay(st, wid))
                    }
                }
                // Array.prototype.toString is join(","), not the type tag. The
                // tag path is @@objProtoToString, a different name entirely.
                if st.objects[o].isArray {
                    return JSValue.Str(joinArray(&mut st, o, ","))
                }
                // A PROXY of an array reaches Array.prototype.toString the same
                // way, but its elements live behind the get trap, so joinArray
                // (which reads the object's own slots) would see nothing. The
                // generic array-method path adapts the receiver through [[Get]]
                // first, which is what the spec's join does.
                if valueIsArrayLike(st, JSValue.Obj(o)) {
                    return arrayMethodGeneric(prog, JSValue.Obj(o), "toString", args, &mut st)
                }
                // Error.prototype.toString is "Name: message", NOT the type tag —
                // this is the path String(err) and `"" + err` take through
                // ToPrimitive, and the tag made them print "[object Error]".
                // Object.prototype.toString.call(err) is unaffected: it arrives
                // under the private @@objProtoToString name.
                if st.objects[o].isError {
                    // getMember, not objGet: `name` lives on the error's
                    // prototype and `message` is an own property only when one
                    // was passed, so an own-property read reported "undefined:
                    // boom" for every error built without them
                    let en = toStr(getMember(st, o, "name"))
                    let em = toStr(getMember(st, o, "message"))
                    if em.len() > 0 {
                        return JSValue.Str(en + ": " + em)
                    }
                    return JSValue.Str(en)
                }
                if st.objects[o].isDate {
                    return JSValue.Str("[object Date]")
                }
                return JSValue.Str("[object Object]")
            }
            if name == "valueOf" {
                // a WRAPPER unwraps. `BigInt.prototype.valueOf.call(Object(42n))`
                // returning the wrapper made object-inspect recurse for ever —
                // it unwraps a boxed primitive by calling valueOf and prints
                // "Object(" around the result, so a result that is still an
                // object nests until the stack is gone.
                if isWrapperObj(st, o) {
                    return boxedPrimitive(st, o)
                }
                return JSValue.Obj(o)
            }
            if name == "isPrototypeOf" {
                if args.len() == 0 {
                    return JSValue.Bool(false)
                }
                let other = objHandle(args[0])
                if other < 0 {
                    return JSValue.Bool(false)
                }
                var pcur = st.objects[other].proto
                while pcur >= 0 {
                    if pcur == o {
                        return JSValue.Bool(true)
                    }
                    pcur = st.objects[pcur].proto
                }
                return JSValue.Bool(false)
            }
            if name == "propertyIsEnumerable" {
                var key = ""
                if args.len() > 0 {
                    key = toStr(args[0])
                }
                // a proxy's own properties are whatever its
                // getOwnPropertyDescriptor trap reports
                if st.objects[o].isProxy {
                    let pd = getOwnPropDescOf(prog, &mut st, JSValue.Obj(o), key)
                    if st.throwing {
                        return JSValue.Undefined
                    }
                    let pdh = objHandle(pd)
                    return JSValue.Bool(pdh >= 0 && truthy(getMember(st, pdh, "enumerable")))
                }
                // own AND enumerable — a non-enumerable own prop is still `false`
                let pi = objOwnIndex(st, o, key)
                return JSValue.Bool(pi >= 0 && st.objects[o].props[pi].enumerable)
            }
            if st.objects[o].isArray && isArrayMethod(name) {
                return arrayMethod(prog, o, name, args, &mut st)
            }
            let m = getMemberDyn(prog, o, name, &mut st)
            // The lookup may resolve THROUGH THE PROTOTYPE CHAIN to the same bound
            // builtin this dispatch is handling — an object whose proto is an array
            // inherits Array.prototype's methods. Calling it re-enters here with the
            // same receiver and name, so
            // `Array.prototype.forEach.call(Object.create([1,2,3]), f)` recursed
            // until the native stack died with SIGBUS. That is the shape the
            // Node-API buffer comment above warns about, reached a different way.
            //
            // A user method of the same name is a Func, not a bound builtin, so
            // `({map: f}).map()` still calls f.
            if isArrayMethod(name) && !st.objects[o].isArray && boundMethodNameOf(st, m) == name.clone() {
                return arrayMethodGeneric(prog, JSValue.Obj(o), name, args, &mut st)
            }
            // Array.prototype.<m>.call(arrayLike, …): the receiver has no such
            // method of its own, so the spec's generic definition applies. Only
            // reached when lookup came up empty, so ({map: f}).map() still calls
            // the object's own map.
            if isUndefinedValue(m) && isArrayMethod(name) {
                return arrayMethodGeneric(prog, JSValue.Obj(o), name, args, &mut st)
            }
            return callValue(prog, m, args, JSValue.Obj(o), &mut st)
        }
        JSValue.Func(bf, _benv, _bfo) => {
            if name == "toString" {
                return JSValue.Str(funcSourceText(prog, bf))
            }
            if name == "hasOwnProperty" {
                var key = ""
                if args.len() > 0 {
                    key = toStr(args[0])
                }
                // through propertyBagOf, so `name`/`length` are materialised
                // first — hasOwnProperty must agree with
                // getOwnPropertyDescriptor about what a function owns
                let statics = propertyBagOf(&mut st, recv)
                return JSValue.Bool(objOwnIndex(st, statics, key) >= 0)
            }
            // Function.prototype.apply.call(fn, thisArg, args) lands here with
            // recv = fn: re-dispatch against the function itself
            if name == "call" || name == "apply" {
                var thisArg = JSValue.Undefined
                if args.len() > 0 {
                    thisArg = cloneValue(args[0])
                }
                var rest: Vec<JSValue> = Vec.new()
                if name == "apply" {
                    if args.len() > 1 {
                        applyArgsInto(prog, &mut st, args[1], &mut rest)
                        // reading `length` or an index can run a getter that
                        // THROWS; without this the call went ahead with a partial
                        // argument list and left the pending throw to surface at
                        // an unrelated point later
                        if st.throwing {
                            return JSValue.Undefined
                        }
                    }
                } else {
                    var ai: i64 = 1
                    while ai < args.len() {
                        rest.push(cloneValue(args[ai]))
                        ai = ai + 1
                    }
                }
                return callFunctionViaMethod(prog, recv, rest, thisArg, &mut st)
            }
            if name == "bind" {
                let bo = newObject(&mut st)
                st.objects[bo].isBound = true
                var extra: Vec<JSValue> = Vec.new()
                var bi: i64 = 1
                while bi < args.len() {
                    extra.push(cloneValue(args[bi]))
                    bi = bi + 1
                }
                let ex = ensureExtra(&mut st, bo)
                st.objExtras[ex].boundTarget = cloneValue(recv)
                if args.len() > 0 {
                    st.objExtras[ex].boundThis = cloneValue(args[0])
                }
                let nb0 = extra.len()
                st.objExtras[ex].boundArgs = extra
                finishBind(prog, &mut st, bo, recv, nb0)
                return JSValue.Obj(bo)
            }
            let statics = propertyBagOf(&mut st, recv)
            let m = getMember(st, statics, name)
            if isCallable(m) {
                return callValue(prog, m, args, cloneValue(recv), &mut st)
            }
            return JSValue.Undefined
        }
        _ => {
            // .apply / .call / .bind on a native function (Math.max.apply, …).
            // recv is the function; re-dispatch it through callValue, which
            // routes a Native to callNative.
            if name == "apply" || name == "call" {
                var thisArg = JSValue.Undefined
                if args.len() > 0 {
                    thisArg = cloneValue(args[0])
                }
                var rest: Vec<JSValue> = Vec.new()
                if name == "apply" {
                    if args.len() > 1 {
                        applyArgsInto(prog, &mut st, args[1], &mut rest)
                        // reading `length` or an index can run a getter that
                        // THROWS; without this the call went ahead with a partial
                        // argument list and left the pending throw to surface at
                        // an unrelated point later
                        if st.throwing {
                            return JSValue.Undefined
                        }
                    }
                } else {
                    var ai: i64 = 1
                    while ai < args.len() {
                        rest.push(cloneValue(args[ai]))
                        ai = ai + 1
                    }
                }
                return callValue(prog, recv, rest, thisArg, &mut st)
            }
            if name == "bind" {
                let bo = newObject(&mut st)
                st.objects[bo].isBound = true
                var extra: Vec<JSValue> = Vec.new()
                var bi: i64 = 1
                while bi < args.len() {
                    extra.push(cloneValue(args[bi]))
                    bi = bi + 1
                }
                let ex = ensureExtra(&mut st, bo)
                st.objExtras[ex].boundTarget = cloneValue(recv)
                if args.len() > 0 {
                    st.objExtras[ex].boundThis = cloneValue(args[0])
                }
                let nb4 = extra.len()
                st.objExtras[ex].boundArgs = extra
                finishBind(prog, &mut st, bo, recv, nb4)
                return JSValue.Obj(bo)
            }
            if name == "toString" {
                return JSValue.Str("[object " + objectTypeTag(recv) + "]")
            }
            if name == "valueOf" {
                return cloneValue(recv)
            }
            // A native builtin is a function OBJECT: it owns `name` and
            // `length`, and test262's verifyProperty asks about them with
            // `Object.prototype.hasOwnProperty.call(Math.sqrt, "name")`. That
            // borrowed call lands here, where the primitive adapter below
            // answered the string "function" — so every name.js/length.js/
            // prop-desc.js for a native failed on the own-property check before
            // it ever looked at the value.
            if isNativeValue(recv) && (name == "hasOwnProperty" || name == "propertyIsEnumerable") {
                var nkey = ""
                if args.len() > 0 {
                    nkey = toStr(args[0])
                }
                let nbag = propertyBagOf(&mut st, cloneValue(recv))
                if nbag >= 0 {
                    let npi = objOwnIndex(st, nbag, nkey)
                    if name == "hasOwnProperty" {
                        return JSValue.Bool(npi >= 0)
                    }
                    return JSValue.Bool(npi >= 0 && st.objects[nbag].props[npi].enumerable)
                }
            }
            // Array.prototype.<m>.call(null) must throw the spec's ToObject
            // TypeError, and .call(42) must behave as an empty array — both
            // handled by the generic adapter rather than silently answering
            // undefined here
            if isArrayMethod(name) {
                return arrayMethodGeneric(prog, cloneValue(recv), name, args, &mut st)
            }
            return primitiveMethodProg(prog, name, recv, args, &mut st)
        }
    }
}

// The tag Object.prototype.toString uses for a heap-object receiver.
fn objectTag(st: &Interp, o: i64): string {
    if isWrapperObj(st, o) {
        match st.objExtras[st.objects[o].extra].boxed {
            JSValue.Str(_bs) => {
                return "String"
            }
            JSValue.Sym(_bid) => {
                return "Symbol"
            }
            JSValue.Number(_bn) => {
                return "Number"
            }
            JSValue.Bool(_bb) => {
                return "Boolean"
            }
            JSValue.BigInt(_bg) => {
                return "BigInt"
            }
            _ => {
            }
        }
    }
    if st.objects[o].isArguments {
        return "Arguments"
    }
    if st.objects[o].isArray {
        return "Array"
    }
    if st.objects[o].isError {
        return "Error"
    }
    if st.objects[o].isDate {
        return "Date"
    }
    if st.objExtras[st.objects[o].extra].regexId >= 0 {
        return "RegExp"
    }
    if st.objects[o].isMap {
        return "Map"
    }
    if st.objects[o].isSet {
        return "Set"
    }
    if st.objExtras[st.objects[o].extra].weakKind == 1 {
        return "WeakMap"
    }
    if st.objExtras[st.objects[o].extra].weakKind == 2 {
        return "WeakSet"
    }
    if st.objects[o].promiseState >= 0 {
        return "Promise"
    }
    // @@toStringTag for the buffer family: a view reports its exact kind
    // ("[object Int8Array]"), which test262 asserts throughout
    if st.objects[o].isDataView {
        return "DataView"
    }
    if st.objects[o].isArrayBuffer {
        return "ArrayBuffer"
    }
    if st.objExtras[st.objects[o].extra].taBuf >= 0 {
        return taName(st.objExtras[st.objects[o].extra].taKind)
    }
    // A generator OBJECT is not a plain object: node reports [object Generator],
    // and util.types.isGeneratorObject is built on exactly this tag.
    if st.objects[o].isAsyncGenerator {
        return "AsyncGenerator"
    }
    if st.objects[o].isGenerator {
        return "Generator"
    }
    if st.objects[o].isBound || st.objects[o].isFunctionLike {
        return "Function"
    }
    return "Object"
}

// The tag for a FUNCTION value, which needs the Prog to see whether the
// definition was async or a generator. Object.prototype.toString reports
// [object AsyncFunction] / [object GeneratorFunction] for those, and
// util.types.isAsyncFunction and isGeneratorFunction read them.
fn funcTag(prog: &Prog, fIdx: i64): string {
    if fIdx < 0 || fIdx >= prog.funcs.len() {
        return "Function"
    }
    if prog.funcs[fIdx].isAsync && prog.funcs[fIdx].isGenerator {
        return "AsyncGeneratorFunction"
    }
    if prog.funcs[fIdx].isAsync {
        return "AsyncFunction"
    }
    if prog.funcs[fIdx].isGenerator {
        return "GeneratorFunction"
    }
    return "Function"
}

// The tag Object.prototype.toString uses for a primitive receiver.
fn objectTypeTag(v: &JSValue): string {
    match v {
        JSValue.Undefined => {
            return "Undefined"
        }
        JSValue.Null => {
            return "Null"
        }
        JSValue.Bool(_b) => {
            return "Boolean"
        }
        JSValue.Number(_n) => {
            return "Number"
        }
        JSValue.Str(_s) => {
            return "String"
        }
        JSValue.Sym(_id) => {
            return "Symbol"
        }
        JSValue.Func(_f, _e, _fo) => {
            return "Function"
        }
        JSValue.Native(_n) => {
            return "Function"
        }
        _ => {
            return "Object"
        }
    }
}

pub fn setMemberDyn(prog: &Prog, o: i64, key: string, v: JSValue, st: &mut Interp) {
    // NOTE: there is deliberately no write guard here. Node throws when a
    // private member is written to an object whose class did not declare it,
    // but instance FIELDS are installed by the constructor as `this.#x = init`
    // — at which point the object does not carry the key yet, so a guard here
    // rejects every field initialiser. Distinguishing the two needs the field
    // installation to use a definition path of its own; see docs/backlog.md.
    if st.objects[o].isProxy {
        // as on the read side: a proxy has no private state of its own
        if isPrivateKey(key) {
            let _t = throwErr(&mut st, "TypeError", "Cannot write private member " + privDisplay(key) + " to an object whose class did not declare it")
            return
        }
        let trap = proxyTrapChecked(prog, &mut st, o, "set")
        if st.throwing {
            return
        }
        let target = proxyTargetOf(st, o)
        if !isUndefinedValue(trap) {
            var args: Vec<JSValue> = Vec.new()
            args.push(cloneValue(target))
            args.push(propKeyValue(key))
            args.push(cloneValue(v))
            args.push(JSValue.Obj(o))
            let r = callTrap(prog, &mut st, o, trap, args)
            if st.throwing {
                return
            }
            if truthy(r) {
                checkProxySetResult(prog, &mut st, target, key, v)
            } else if st.strict {
                throwWriteFailure(&mut st, "'set' on proxy: trap returned falsish for property '" + key.clone() + "'")
            }
            return
        }
        let th = propertyBagOf(&mut st, target)
        if th >= 0 {
            setMemberDyn(prog, th, key, v, &mut st)
        }
        return
    }
    // `o.__proto__ = X` is a setter on Object.prototype in the spec. Only the
    // READ side existed (getMemberDyn resolves it), so the write silently made
    // an ordinary own property named "__proto__" and the object kept its old
    // prototype — the ES5 inheritance idiom `Child.prototype.__proto__ = Parent.prototype`
    // did nothing at all.
    // ...but only for an object that actually INHERITS that accessor. An object
    // with a null prototype does not, so `obj.__proto__ = v` on one defines an
    // ordinary own property — which is what querystring.parse("__proto__=1")
    // has to answer, and what makes a null-prototype object safe to use as a
    // string-keyed map in the first place.
    if key == "__proto__" && inheritsObjectProto(st, o) {
        match v {
            JSValue.Null => {
                st.objects[o].proto = -1
                st.objects[o].protoNull = true
            }
            _ => {
                let np = propertyBagOf(&mut st, v)
                if np >= 0 {
                    st.objects[o].proto = np
                    st.objects[o].protoNull = false
                }
            }
        }
        return
    }
    let sfn = findSetter(st, o, key)
    if isCallable(sfn) {
        var args: Vec<JSValue> = Vec.new()
        args.push(v)
        let _ = callValue(prog, sfn, args, JSValue.Obj(o), &mut st)
        return
    }
    // a getter with no setter: writing is a silent no-op in sloppy mode, and
    // must not replace the accessor with a plain data property
    let own = objOwnIndex(st, o, key)
    if own >= 0 && propIsAccessor(st, o, own) {
        if st.strict {
            throwWriteFailure(&mut st, "Cannot set property " + key.clone() + " of #<Object> which has only a getter")
        }
        return
    }
    // A PROXY in the prototype chain owns the write, with the ORIGINAL object as
    // the receiver: `Object.create(proxy).x = 1` fires the set trap. Only when
    // the object has no own property of its own — an own one is written in place.
    if st.anyProxy && own < 0 && !(st.objects[o].isArray && asArrayIndex(key) >= 0) {
        var pw = protoOfHandle(st, o)
        while pw >= 0 {
            if st.objects[pw].isProxy {
                let _s = reflectSet(prog, &mut st, JSValue.Obj(pw), key, v, JSValue.Obj(o))
                return
            }
            pw = protoOfHandle(st, pw)
        }
    }
    setMember(&mut st, o, key, v)
}

pub fn getMember(st: &Interp, o: i64, key: &string): JSValue {
    // globalThis.x reads the global BINDING, the same as a bare `x`. getMemberDyn
    // already did this; getMember did not, so a compound assignment
    // (`globalThis.x += y`) read undefined for its own left-hand side while a
    // plain read of the same property worked.
    if st.objects[o].isGlobal && objOwnIndex(st, o, key) < 0 {
        if scopeHasOwn(st, 0, key) {
            return scopeLookup(st, 0, key)
        }
    }
    let nativeLen = nativeBufferLen(st, o)
    if nativeLen >= 0 {
        if key == "length" {
            return JSValue.Number(nativeLen as f64)
        }
        let ni = asArrayIndex(key)
        if ni >= 0 {
            return nativeBufferGet(st, o, ni)
        }
    }
    // A DataView shares taBuf/taOffset/taLen with typed arrays but is not
    // index-accessible and its byteLength is already in bytes. Handle its props
    // here and skip the typed-array element path below.
    if st.objects[o].isDataView {
        if key == "byteLength" {
            return JSValue.Number(st.objExtras[st.objects[o].extra].taLen as f64)
        }
        if key == "byteOffset" {
            return JSValue.Number(st.objExtras[st.objects[o].extra].taOffset as f64)
        }
        if key == "buffer" {
            return JSValue.Obj(st.objExtras[st.objects[o].extra].taBuf)
        }
    }
    if st.objExtras[st.objects[o].extra].taBuf >= 0 && !st.objects[o].isDataView {
        // a detached view reports zeroes rather than its stale extent, and so
        // does one whose resizable buffer shrank out from under it
        if (taIsDetached(st, o) || taOutOfBounds(st, o)) && (key == "length" || key == "byteLength" || key == "byteOffset") {
            return JSValue.Number(0.0)
        }
        if key == "length" {
            return JSValue.Number(taCurrentLen(st, o) as f64)
        }
        if key == "byteLength" {
            return JSValue.Number((taCurrentLen(st, o) * taWidth(st.objExtras[st.objects[o].extra].taKind)) as f64)
        }
        if key == "byteOffset" {
            return JSValue.Number(st.objExtras[st.objects[o].extra].taOffset as f64)
        }
        if key == "BYTES_PER_ELEMENT" {
            return JSValue.Number(taWidth(st.objExtras[st.objects[o].extra].taKind) as f64)
        }
        if key == "buffer" {
            return JSValue.Obj(st.objExtras[st.objects[o].extra].taBuf)
        }
        let ti = asArrayIndex(key)
        if ti >= 0 {
            // a detached view has no elements, so every index reads undefined
            if taIsDetached(st, o) {
                return JSValue.Undefined
            }
            if ti >= taCurrentLen(st, o) {
                return JSValue.Undefined
            }
            return taElemValue(st, o, ti)
        }
    }
    if st.objects[o].isArrayBuffer {
        if key == "byteLength" {
            return JSValue.Number(st.objExtras[st.objects[o].extra].bytes.len() as f64)
        }
        if key == "maxByteLength" {
            if st.objExtras[st.objects[o].extra].abMaxLen >= 0 {
                return JSValue.Number(st.objExtras[st.objects[o].extra].abMaxLen as f64)
            }
            return JSValue.Number(st.objExtras[st.objects[o].extra].bytes.len() as f64)
        }
        if key == "resizable" {
            return JSValue.Bool(st.objExtras[st.objects[o].extra].abMaxLen >= 0)
        }
        if key == "detached" {
            return JSValue.Bool(st.objects[o].abDetached)
        }
    }
    if st.objects[o].isArray {
        if key == "length" {
            return JSValue.Number(arrLen(st, o) as f64)
        }
        let ai = asArrayIndex(key)
        if ai >= 0 {
            return arrGet(st, o, ai)
        }
    }
    // own property first, then walk the prototype chain
    var cur = o
    while cur >= 0 {
        if objHas(st, cur, key) {
            return objGet(st, cur, key)
        }
        // An ARRAY in the chain carries `length` and its elements outside the Prop
        // list, so the ordinary `objHas` test cannot see them. Without this,
        // `Object.create([1,2,3]).length` was undefined — and every generic array
        // method over such an object therefore saw length 0 and visited nothing.
        if cur != o && st.objects[cur].isArray {
            if key.clone() == "length" {
                return JSValue.Number(arrLen(st, cur) as f64)
            }
            let inheritedIdx = asArrayIndex(key)
            if inheritedIdx >= 0 && inheritedIdx < arrLen(st, cur) && !arrIsHole(st, cur, inheritedIdx) {
                return arrGet(st, cur, inheritedIdx)
            }
        }
        // protoOfHandle, not the raw field: a plain `{}` has proto == -1 and
        // still inherits Object.prototype. Walking the raw link stopped there,
        // so anything a program added to Object.prototype was invisible —
        // `Object.prototype.x = 1; ({}).x` answered undefined.
        cur = protoOfHandle(st, cur)
    }
    return JSValue.Undefined
}

// A property write that cannot succeed. Sloppy code drops it; strict code must
// throw, and every such site funnels through here so the two modes stay in step.
fn throwWriteFailure(st: &mut Interp, msg: string) {
    st.throwing = true
    st.thrownValue = makeError(&mut st, "TypeError", msg)
}

fn setMember(st: &mut Interp, o: i64, key: string, value: JSValue) {
    if nativeBufferLen(st, o) >= 0 {
        let ni = asArrayIndex(key)
        if ni >= 0 {
            let _ = nativeBufferSet(&mut st, o, ni, toNum(value))
            return
        }
    }
    // Any write to a builtin prototype retires its fast dispatch path for the
    // rest of the run. Calls then resolve through the real chain so a replaced
    // method remains authoritative even if the original is restored later.
    if o == st.arrayProtoObj {
        st.arrayProtoPristine = false
    }
    if o == st.stringProtoObj {
        st.stringProtoPristine = false
    }
    if o == st.dateProtoObj {
        st.dateProtoPristine = false
    }
    if o == st.regexProtoObj {
        st.regexProtoPristine = false
    }
    if o == st.objectProtoObj {
        st.objectProtoPristine = false
    }
    // sloppy mode drops writes to a frozen object rather than throwing
    if st.objects[o].frozen {
        if st.strict {
            throwWriteFailure(&mut st, "Cannot assign to read only property '" + key.clone() + "' of object")
        }
        return
    }
    // A sealed or non-extensible ARRAY refuses a NEW index too. Arrays were exempted
    // wholesale here because their elements are not Prop entries, so objOwnIndex
    // never finds one — but "past the current length" is exactly the same question,
    // and without it `Object.seal([1,2]); a[2] = 3` grew the array.
    if st.objects[o].noExtend && st.objects[o].isArray {
        let newIdx = asArrayIndex(key)
        if newIdx >= arrLen(st, o) {
            if st.strict {
                throwWriteFailure(&mut st, "Cannot add property " + key.clone() + ", object is not extensible")
            }
            return
        }
    }
    // non-extensible: existing properties stay writable, new ones are refused
    if st.objects[o].noExtend && objOwnIndex(st, o, key) < 0 && !st.objects[o].isArray {
        if st.strict {
            throwWriteFailure(&mut st, "Cannot add property " + key.clone() + ", object is not extensible")
        }
        return
    }
    // a non-writable data property silently ignores assignment in sloppy mode
    let own = objOwnIndex(st, o, key)
    if own >= 0 && !propIsAccessor(st, o, own) && !st.objects[o].props[own].writable {
        if st.strict {
            throwWriteFailure(&mut st, "Cannot assign to read only property '" + key.clone() + "' of object")
        }
        return
    }
    // A non-writable data property INHERITED from the prototype blocks the write
    // too: OrdinarySetWithOwnDescriptor consults the chain first, and only creates
    // an own property when what it finds is writable. Without this the assignment
    // created an own property that SHADOWED the read-only one, so `c.k = 2` on an
    // object whose prototype has a frozen `k` answered 2 -- in sloppy mode, where
    // the write is supposed to be dropped entirely.
    // The guard is written as one condition rather than as the loop's first test
    // so the common case -- a new property on an object whose prototype is a
    // pristine Object.prototype -- costs two comparisons and never sets up the
    // walk at all. Measured: as a test inside the loop it cost 7% on objChurn.
    if own < 0 && st.objects[o].proto >= 0 && !(st.objects[o].proto == st.objectProtoObj && st.objectProtoPristine) {
        var pcur = st.objects[o].proto
        var pguard: i64 = 0
        while pcur >= 0 && pguard < 1000 {
            pguard = pguard + 1
            if pcur == st.objectProtoObj && st.objectProtoPristine {
                pguard = 1000
                continue
            }
            let pi = objOwnIndex(st, pcur, key.clone())
            if pi >= 0 {
                if !propIsAccessor(st, pcur, pi) && !st.objects[pcur].props[pi].writable {
                    if st.strict {
                        throwWriteFailure(&mut st, "Cannot assign to read only property '" + key.clone() + "' of object")
                    }
                    return
                }
                pguard = 1000
            } else {
                pcur = st.objects[pcur].proto
            }
        }
    }
    if st.objExtras[st.objects[o].extra].taBuf >= 0 && !st.objects[o].isDataView {
        let ti = asArrayIndex(key)
        if ti >= 0 {
            // a write through a detached view is dropped, not an error
            if !taIsDetached(st, o) {
                taSetElemValue(&mut st, o, ti, value)
            }
            return
        }
        // Not a valid index but still numeric ("1.5", "-1", "1e21", "NaN"): the
        // integer-indexed path owns those keys and rejects them, so the write is
        // dropped instead of becoming an ordinary property.
        if isCanonicalNumericKey(key) {
            return
        }
    }
    // globalThis.x = v defines/updates the global binding, not a detached property
    if st.objects[o].isGlobal {
        scopeDefine(&mut st, 0, key, value)
        return
    }
    if st.objects[o].isArray {
        let ai = asArrayIndex(key)
        if ai >= 0 {
            arrSet(&mut st, o, ai, value)
            return
        }
        if key == "length" {
            let rawLength = toNum(value)
            let arrayLength = rawLength as i64
            if !(rawLength == rawLength) || rawLength < 0.0 || rawLength > 4294967295.0 || (arrayLength as f64) != rawLength {
                st.throwing = true
                st.thrownValue = makeError(&mut st, "RangeError", "Invalid array length")
                return
            }
            setArrayLength(&mut st, o, arrayLength)
            return
        }
    }
    objSet(&mut st, o, key, value)
}

// One element of a value being destructured: `value[i]`. Arrays/array-likes go
// through getMember by index; a string yields its i-th character.
fn destructElement(_prog: &Prog, value: &JSValue, i: i64, st: &mut Interp): JSValue {
    let vh = objHandle(value)
    if vh >= 0 {
        return getMember(st, vh, i64ToStr(i))
    }
    if let JSValue.Str(s) = value {
        // s[i] indexes UTF-16 code units like charAt, not raw UTF-8 bytes —
        // "café"[3] is "é", not the first byte of its 2-byte encoding
        if i >= 0 && i < utf16Length(s) {
            return JSValue.Str(utf16Slice(s, i, i + 1))
        }
    }
    return JSValue.Undefined
}

// Assign `value` to a single destructuring target: a nested pattern recurses; a
// `name = default` element applies the default when value is undefined; otherwise
// the target is an ordinary lvalue (identifier / member / index).
fn assignTarget(prog: &Prog, targetId: ExprId, value: JSValue, st: &mut Interp, scope: i64) {
    match prog.exprs[targetId.index] {
        Expr.ArrLit(_li) => {
            assignPattern(prog, targetId, value, &mut st, scope)
        }
        Expr.ObjLit(_li) => {
            assignPattern(prog, targetId, value, &mut st, scope)
        }
        Expr.Assign(name, defaultIdx) => {
            var v = cloneValue(value)
            if isUndefinedValue(value) {
                v = evalExpr(prog, defaultIdx, &mut st, scope)
            }
            scopeAssign(&mut st, scope, name, cloneValue(v))
        }
        _ => {
            writeLValue(prog, targetId, &mut st, scope, cloneValue(value))
        }
    }
}

// Destructure `value` into a pattern (ArrLit / ObjLit) of existing lvalue
// targets. Handles nesting, holes, `...rest`, and `= default` elements.
fn assignPattern(prog: &Prog, patId: ExprId, value: JSValue, st: &mut Interp, scope: i64) {
    match prog.exprs[patId.index] {
        Expr.ArrLit(litIdx) => {
            // `const [a, b] = obj` reads obj[0], obj[1] — right for arrays and
            // strings, empty for an object that is iterable and nothing else.
            let items = iterableToArray(prog, value, &mut st)
            pushTemp(&mut st, cloneValue(items))
            var i: i64 = 0
            while i < prog.arrLits[litIdx.index].len() {
                match prog.arrLits[litIdx.index][i] {
                    Option.Some(e) => {
                    match prog.exprs[e.index] {
                        Expr.Spread(target) => {
                        // ...rest — the remaining elements as a fresh array
                        let rest = newArray(&mut st)
                        pushTemp(&mut st, JSValue.Obj(rest))
                        let vh = objHandle(items)
                        if vh >= 0 {
                            let vn = arrLen(st, vh)
                            var j = i
                            while j < vn {
                                arrPush(&mut st, rest, arrGet(st, vh, j))
                                j = j + 1
                            }
                        }
                        popTemp(&mut st)
                        assignTarget(prog, target, JSValue.Obj(rest), &mut st, scope)
                    }
                        _ => {
                            let ev = destructElement(prog, items, i, &mut st)
                            assignTarget(prog, e, ev, &mut st, scope)
                        }
                    }
                    }
                    Option.None => {
                        // elision: skip this position
                    }
                }
                i = i + 1
            }
            popTemp(&mut st)
        }
        Expr.ObjLit(litIdx) => {
            // An object pattern performs RequireObjectCoercible on its source
            // before reading any key. In the ASSIGNMENT form that check was
            // missing entirely: a nested `[{a}] = [null]` read nothing off the
            // null and bound undefined instead of throwing.
            if isNullish(value) {
                st.throwing = true
                st.thrownValue = makeError(&mut st, "TypeError", "Cannot destructure '" + toStr(value) + "' as it is " + toStr(value) + ".")
                return
            }
            pushTemp(&mut st, cloneValue(value))
            let vh = objHandle(value)
            var i: i64 = 0
            while i < prog.objLits[litIdx.index].len() {
                let key = prog.objLits[litIdx.index][i].key.clone()
                let target = prog.objLits[litIdx.index][i].val
                var pv = JSValue.Undefined
                if vh >= 0 {
                    pv = getMemberDyn(prog, vh, key, &mut st)
                }
                assignTarget(prog, target, pv, &mut st, scope)
                i = i + 1
            }
            popTemp(&mut st)
        }
        _ => {
            assignTarget(prog, patId, value, &mut st, scope)
        }
    }
}

// Read an assignable target (identifier / member / computed index) as a value.
// Backs ++/-- and compound assignment; the base object of a member target is
// evaluated here and again by writeLValue (harmless unless the base has side
// effects, which is rare).
fn readLValue(prog: &Prog, targetId: ExprId, st: &mut Interp, scope: i64): JSValue {
    match prog.exprs[targetId.index] {
        Expr.Ident(name) => {
            match scopeTryLookup(st, scope, name) {
                Option.Some(v) => {
                    return v
                }
                Option.None => {
                    // reading an undeclared identifier is a ReferenceError in JS;
                    // without this a typo just evaluates to undefined and the
                    // failure surfaces somewhere else entirely
                    return throwErr(&mut st, "ReferenceError", name.clone() + " is not defined")
                }
            }
        }
        Expr.Member(objIdx, name) => {
            let ov = evalExpr(prog, objIdx, &mut st, scope)
            match ov {
                JSValue.Obj(o) => {
                    return getMember(st, o, name)
                }
                JSValue.Func(_fIdx, _fe, _fo) => {
                    // a class static read as an lvalue (C.count++)
                    let statics = propertyBagOf(&mut st, ov)
                    return getMemberDyn(prog, statics, name, &mut st)
                }
                _ => {
                    return JSValue.Undefined
                }
            }
        }
        Expr.Index(objIdx, keyIdx) => {
            let ov = evalExpr(prog, objIdx, &mut st, scope)
            // the key expression can run user code and collect the base
            pushTemp(&mut st, cloneValue(ov))
            let kv = evalExpr(prog, keyIdx, &mut st, scope)
            popTemp(&mut st)
            let key = toPropertyKey(st, kv)
            match ov {
                JSValue.Obj(o) => {
                    return getMember(st, o, key)
                }
                JSValue.Func(_fIdx, _fe, _fo) => {
                    let statics = propertyBagOf(&mut st, ov)
                    return getMemberDyn(prog, statics, key, &mut st)
                }
                _ => {
                    return JSValue.Undefined
                }
            }
        }
        _ => {
            return JSValue.Undefined
        }
    }
}

fn writeLValue(prog: &Prog, targetId: ExprId, st: &mut Interp, scope: i64, value: JSValue) {
    match prog.exprs[targetId.index] {
        Expr.Ident(name) => {
            scopeAssign(&mut st, scope, name, value)
        }
        Expr.Member(objIdx, name) => {
            let ov = evalExpr(prog, objIdx, &mut st, scope)
            match ov {
                JSValue.Obj(o) => {
                    setMember(&mut st, o, name.clone(), value)
                }
                JSValue.Func(_fIdx, _fe, _fo) => {
                    // a class static written as an lvalue (C.count++)
                    let statics = propertyBagOf(&mut st, ov)
                    // setMemberDyn so a `static set x(v)` accessor is invoked;
                    // the plain set overwrote the accessor with a data property
                    setMemberDyn(prog, statics, name.clone(), value, &mut st)
                }
                _ => {
                }
            }
        }
        Expr.Index(objIdx, keyIdx) => {
            let ov = evalExpr(prog, objIdx, &mut st, scope)
            // the key expression can run user code and collect the base
            pushTemp(&mut st, cloneValue(ov))
            let kv = evalExpr(prog, keyIdx, &mut st, scope)
            popTemp(&mut st)
            let key = toPropertyKey(st, kv)
            match ov {
                JSValue.Obj(o) => {
                    setMember(&mut st, o, key, value)
                }
                JSValue.Func(_fIdx, _fe, _fo) => {
                    let statics = propertyBagOf(&mut st, ov)
                    setMemberDyn(prog, statics, key, value, &mut st)
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
}

// sqlite3_column_name is not wrapped by std/sqlite, but node:sqlite's get()/all()
// return row objects keyed by column name, so it is declared here directly. The
// libsqlite3 link flag already comes from the std/sqlite import.
extern fn sqlite3_column_name(stmt: *u8, col: i32): *u8

// Named parameters (`$id`, `:id`, `@id`) resolve to a 1-based index through this;
// also not wrapped by std/sqlite. Returns 0 for a name the statement does not use.
extern fn sqlite3_bind_parameter_index(stmt: *u8, name: *u8): i32

// The path sqlite resolved the connection to, which is what Node's
// DatabaseSync.location() reports (not the string the caller passed).
extern fn sqlite3_db_filename(db: *u8, dbName: *u8): *u8

// The `.name` of a native constructor (Object.name === "Object" etc), so
// `err.constructor.name` and similar resolve. Empty for natives that are not
// named constructors.
fn nativeCtorName(n: &Native): string {
    match n {
        Native.Fn(id) => {
            // the five original error constructors only; EvalError and URIError
            // were added later and have never answered here
            if id == Builtin.Error || id == Builtin.TypeError || id == Builtin.RangeError
                || id == Builtin.SyntaxError || id == Builtin.ReferenceError {
                return nativeErrorName(id)
            }
            if id == Builtin.ObjectCtor {
                return "Object"
            }
            if id == Builtin.Number {
                return "Number"
            }
            if id == Builtin.BigInt {
                return "BigInt"
            }
            if id == Builtin.String {
                return "String"
            }
            if id == Builtin.Boolean {
                return "Boolean"
            }
            return ""
        }
        _ => {
            // typed-array constructors and resolvers keep their name in their
            // property bag, not here
            return ""
        }
    }
}

pub fn nativeErrorName(id: Builtin): string {
    if id == Builtin.TypeError {
        return "TypeError"
    }
    if id == Builtin.RangeError {
        return "RangeError"
    }
    if id == Builtin.SyntaxError {
        return "SyntaxError"
    }
    if id == Builtin.ReferenceError {
        return "ReferenceError"
    }
    if id == Builtin.EvalError {
        return "EvalError"
    }
    if id == Builtin.UriError {
        return "URIError"
    }
    return "Error"
}

// The native error constructor `class X extends <base>` extends, if the base is
// one. Used to initialise the instance in place rather than let the base build
// and return an object of its own.
fn nativeErrorCtorOf(v: &JSValue): Option<Builtin> {
    if let Option.Some(n) = nativeHandle(v) {
        if let Native.Fn(b) = n {
            if isErrorCtor(b) {
                return Option.Some(b)
            }
        }
    }
    return Option.None
}

fn isErrorCtor(id: Builtin): bool {
    return id == Builtin.Error || id == Builtin.TypeError || id == Builtin.RangeError
        || id == Builtin.SyntaxError || id == Builtin.ReferenceError
        || id == Builtin.EvalError || id == Builtin.UriError
}

// The error name for ANY native, which is what the tail of nativeInstanceOf
// asks: a native that is not an error constructor answers "Error", the default
// nativeErrorName has always returned for one.
fn nativeErrorNameOf(n: &Native): string {
    match n {
        Native.Fn(b) => {
            return nativeErrorName(b)
        }
        _ => {
            return "Error"
        }
    }
}

// Reverse of nativeErrorName: the constructor id for a kind string, so an error
// raised internally by makeError links to the same prototype a constructed one
// does. Unknown kinds (URIError, EvalError — thrown by name but with no native
// constructor) fall back to Error.
fn errorCtorIdFor(kind: &string): Builtin {
    if kind == "TypeError" {
        return Builtin.TypeError
    }
    if kind == "RangeError" {
        return Builtin.RangeError
    }
    if kind == "SyntaxError" {
        return Builtin.SyntaxError
    }
    if kind == "ReferenceError" {
        return Builtin.ReferenceError
    }
    if kind == "EvalError" {
        return Builtin.EvalError
    }
    if kind == "URIError" {
        return Builtin.UriError
    }
    return Builtin.Error
}

// Native dispatch for the call sites that hold a Prog. callNative itself does
// not, so any native whose answer depends on re-entering user code has to be
// intercepted here — otherwise `String(obj)` reports "[object Object]" for an
// object whose toString says otherwise, while `${obj}` and `"" + obj` (both of
// which run the full ToPrimitive) disagree with it.
// The constructors that MUST be reached through `new`. Calling one as a plain
// function is a TypeError in every engine: `Map()` and `Uint8Array()` are not
// abbreviations for `new Map()`, they are mistakes, and answering an object hid
// them. The list is the spec's: everything whose [[Call]] is defined to throw.
// Date, Error, Array, Object, String, Number, Boolean, RegExp and Function all
// have a real [[Call]] and are deliberately absent.
fn nativeRequiresNew(n: &Native): bool {
    match n {
        Native.TypedArrayCtor(_k) => {
            return true
        }
        Native.Fn(b) => {
            return b == Builtin.Map || b == Builtin.Set || b == Builtin.Proxy
                || b == Builtin.WeakMap || b == Builtin.WeakSet
                || b == Builtin.DataView || b == Builtin.ArrayBuffer
        }
        _ => {
            return false
        }
    }
}

// A native invoked as a PLAIN FUNCTION, as opposed to through `new` or from the
// engine's own construction paths -- which is the distinction the guard needs and
// which callNativeProg cannot make, because both arrive there.
pub fn callNativeAsFunction(prog: &Prog, n: &Native, argVals: &Vec<JSValue>, st: &mut Interp): JSValue {
    // `Date()` without `new` is specified to ignore its arguments entirely and
    // return the CURRENT time as a string -- it is not `new Date()`. Returning a
    // Date object meant `typeof Date()` was "object" and string concatenation
    // with it went through the object's toString by accident rather than by rule.
    if nativeEq(n, Native.Fn(Builtin.Date)) {
        let nowObj = objHandle(callNativeProg(prog, n, argVals, &mut st))
        if nowObj >= 0 {
            var noArgs: Vec<JSValue> = Vec.new()
            return dateMethod(&mut st, nowObj, "toString", noArgs)
        }
        return JSValue.Str("Invalid Date")
    }
    if nativeRequiresNew(n) {
        return throwErr(&mut st, "TypeError", "Constructor " + nativeCtorName(n) + " requires 'new'")
    }
    return callNativeProg(prog, n, argVals, &mut st)
}

pub fn callNativeProg(_prog: &Prog, n: &Native, argVals: &Vec<JSValue>, st: &mut Interp): JSValue {
    if nativeEq(n, Native.Fn(Builtin.String)) && argVals.len() > 0 {
        let h = objHandle(argVals[0])
        if h >= 0 {
            // Straight to toStrProg for any object. This used to first READ
            // `toString` to decide whether to take over, and toStrProg then read
            // it again as part of ToPrimitive — so `String(obj)` triggered an
            // accessor-defined toString getter twice, and did it before
            // @@toPrimitive rather than after. The coercion is observable and
            // test262 watches it with an observer object.
            // toStrProg falls back to Object.prototype.toString for an object
            // with no own or inherited toString, which is what the probe was
            // guarding against. toStrArg, not toStrProg: a symbol wrapper
            // unwraps to a symbol there, and String() of that throws.
            return JSValue.Str(toStrArg(gProg, argVals[0], &mut st))
        }
    }
    return callNative(n, argVals, &mut st)
}

// The two payload-carrying natives answer here; everything else is one of the
// Builtin variants and goes to callBuiltin's chain.
fn callNative(n: &Native, argVals: &Vec<JSValue>, st: &mut Interp): JSValue {
    match n {
        Native.Fn(b) => {
            return callBuiltin(b, argVals, &mut st)
        }
        Native.TypedArrayCtor(kind) => {
            // Float32/Float64 store real IEEE-754 bytes via taStore's f32/f64
            // reinterpret (runtime.milo), so every kind is constructible.
            return makeTypedArray(gProg, &mut st, kind, argVals)
        }
        Native.Resolver(target, isReject) => {
            return callResolver(&mut st, target, isReject, argVals)
        }
    }
}

// One entry of new Map(iterable) / new Set(iterable). Every Map entry must be
// an OBJECT: node raises a TypeError rather than skipping it, which is what
// once made `new Map(["ab"])` answer an empty map. Its halves are read with
// [[Get]] so an accessor on index 0 runs (test262 pins that it throws), and a
// short pair is not an error: the missing half is undefined.
// Feeds new Map(src) / new Set(src) into `o`, which already carries its brand
// and prototype: the adder is read off `o` so a subclass or patched
// prototype method sees every entry.
fn mapSetFill(id: Builtin, o: i64, src: &JSValue, st: &mut Interp) {
    if isNullish(src) {
        return
    }
    var adderName = "add"
    var hostName = "Set"
    if id == Builtin.Map {
        adderName = "set"
        hostName = "Map"
    } else if id == Builtin.WeakMap {
        adderName = "set"
        hostName = "WeakMap"
    } else if id == Builtin.WeakSet {
        hostName = "WeakSet"
    }
    let adder = getMemberDyn(gProg, o, adderName, &mut st)
    if st.throwing {
        return
    }
    if !isCallableIn(st, adder) {
        st.throwing = true
        st.thrownValue = makeError(&mut st, "TypeError", "'" + toStr(adder) + "' returned for property '" + adderName + "' of object '#<" + hostName + ">' is not a function")
        return
    }
    pushTemp(&mut st, cloneValue(adder))
    let fast = isPristineAdder(st, adder, id)
    let argH = objHandle(src)
    if argH >= 0 && st.objects[argH].isArray {
        // a plain array needs no iterator protocol
        var i: i64 = 0
        while i < arrLen(st, argH) && !st.throwing {
            let e = arrGet(st, argH, i)
            mapSetAddEntry(id, o, e, adder, fast, &mut st)
            i = i + 1
        }
    } else if isStr(src) {
        let sv = toStr(src)
        let cps = strCodePoints(sv)
        var ci: i64 = 0
        while ci < cps.len() && !st.throwing {
            mapSetAddEntry(id, o, JSValue.Str(cps[ci].clone()), adder, fast, &mut st)
            ci = ci + 1
        }
    } else {
        // Drive Symbol.iterator one entry at a time. Materializing through
        // iterableToArray first hung on an iterator that never reports
        // done, because the throw that ends it comes from reading the
        // entry, and that read happened only after the whole walk.
        var itFn = JSValue.Undefined
        if argH >= 0 {
            itFn = getMemberDyn(gProg, argH, symIteratorKey(), &mut st)
        }
        if !st.throwing && !isCallableIn(st, itFn) {
            st.throwing = true
            st.thrownValue = makeError(&mut st, "TypeError", spreadErrText(src))
        }
        if !st.throwing {
            var noArgs: Vec<JSValue> = Vec.new()
            let iter = callValue(gProg, itFn, noArgs, cloneValue(src), &mut st)
            if !st.throwing {
                pushTemp(&mut st, cloneValue(iter))
                let ih = objHandle(iter)
                let isGen = ih >= 0 && st.objects[ih].isGenerator
                // a throw from next() or the done read leaves the iterator
                // to its own devices; one from the entry closes it
                var closeIt = false
                var guard: i64 = 0
                while ih >= 0 && !st.throwing && guard < 100000000 {
                    guard = guard + 1
                    var step = JSValue.Undefined
                    if isGen {
                        var nA: Vec<JSValue> = Vec.new()
                        step = genNext(ih, nA, &mut st)
                    } else {
                        let nextFn = getMember(st, ih, "next")
                        if !isCallableIn(st, nextFn) {
                            st.throwing = true
                            st.thrownValue = makeError(&mut st, "TypeError", "iterator.next is not a function")
                            break
                        }
                        var nArgs: Vec<JSValue> = Vec.new()
                        step = callValue(gProg, nextFn, nArgs, cloneValue(iter), &mut st)
                    }
                    if st.throwing {
                        break
                    }
                    let sh = objHandle(step)
                    if sh < 0 {
                        st.throwing = true
                        st.thrownValue = makeError(&mut st, "TypeError", "Iterator result " + toStr(step) + " is not an object")
                        break
                    }
                    if truthy(getMemberDyn(gProg, sh, "done", &mut st)) || st.throwing {
                        break
                    }
                    let entry = getMemberDyn(gProg, sh, "value", &mut st)
                    if st.throwing {
                        break
                    }
                    mapSetAddEntry(id, o, entry, adder, fast, &mut st)
                    if st.throwing {
                        closeIt = true
                    }
                }
                if closeIt {
                    // IteratorClose: the entry's throw wins over anything
                    // return() raises, as in node
                    pushTemp(&mut st, cloneValue(st.thrownValue))
                    st.throwing = false
                    st.thrownValue = JSValue.Undefined
                    if isGen {
                        var rArgs: Vec<JSValue> = Vec.new()
                        let _r = genResume(ih, rArgs, 2, &mut st)
                    } else {
                        let retFn = getMemberDyn(gProg, ih, "return", &mut st)
                        if !st.throwing && isCallableIn(st, retFn) {
                            var rArgs: Vec<JSValue> = Vec.new()
                            let _r = callValue(gProg, retFn, rArgs, cloneValue(iter), &mut st)
                        }
                    }
                    let savedThrow = st.tempRoots.pop()!
                    st.throwing = true
                    st.thrownValue = savedThrow
                }
                popTemp(&mut st)
            }
        }
    }
    popTemp(&mut st)
}

// `adder` is this.set / this.add read off the new instance, as the spec has
// it, so a patched Map.prototype.set sees every entry; `fast` says it is still
// the pristine native and mapPut can stand in for the call.
fn mapSetAddEntry(id: Builtin, o: i64, e: JSValue, adder: &JSValue, fast: bool, st: &mut Interp) {
    let weak = id == Builtin.WeakMap || id == Builtin.WeakSet
    if id == Builtin.Set || id == Builtin.WeakSet {
        if fast && weak {
            weakPut(&mut st, o, e, JSValue.Bool(true))
        } else if fast {
            mapPut(&mut st, o, e, JSValue.Bool(true))
        } else {
            var aArgs: Vec<JSValue> = Vec.new()
            aArgs.push(e)
            let _r = callValue(gProg, adder, aArgs, JSValue.Obj(o), &mut st)
        }
        return
    }
    let pair = objHandle(e)
    if pair < 0 {
        st.throwing = true
        st.thrownValue = makeError(&mut st, "TypeError", "Iterator value " + toStr(e) + " is not an entry object")
        return
    }
    pushTemp(&mut st, cloneValue(e))
    let pk = getMemberDyn(gProg, pair, "0", &mut st)
    if !st.throwing {
        pushTemp(&mut st, cloneValue(pk))
        let pv = getMemberDyn(gProg, pair, "1", &mut st)
        popTemp(&mut st)
        if !st.throwing {
            if fast && weak {
                weakPut(&mut st, o, pk, pv)
            } else if fast {
                mapPut(&mut st, o, pk, pv)
            } else {
                var aArgs: Vec<JSValue> = Vec.new()
                aArgs.push(pk)
                aArgs.push(pv)
                let _r = callValue(gProg, adder, aArgs, JSValue.Obj(o), &mut st)
            }
        }
    }
    popTemp(&mut st)
}

// True when `adder` is the untouched native Map.prototype.set / Set.prototype.add.
fn isPristineAdder(st: &Interp, adder: &JSValue, id: Builtin): bool {
    let h = objHandle(adder)
    if h < 0 || !st.objects[h].isBound {
        return false
    }
    let ex = st.objects[h].extra
    if id == Builtin.Map {
        return st.objExtras[ex].boundBrand == BRAND_MAP && st.objExtras[ex].boundMethod == "set"
    }
    if id == Builtin.WeakMap {
        return st.objExtras[ex].boundBrand == BRAND_WEAKMAP && st.objExtras[ex].boundMethod == "set"
    }
    if id == Builtin.WeakSet {
        return st.objExtras[ex].boundBrand == BRAND_WEAKSET && st.objExtras[ex].boundMethod == "add"
    }
    return st.objExtras[ex].boundBrand == BRAND_SET && st.objExtras[ex].boundMethod == "add"
}

// One half of a promise's resolve/reject pair. The pair fires at most once
// BETWEEN them, and the flag is set the moment either runs — not when the
// promise settles. Resolving with a thenable leaves it pending while the
// adoption job is queued, and a resolve/reject arriving in that window is
// ignored.
fn callResolver(st: &mut Interp, target: i64, isReject: bool, argVals: &Vec<JSValue>): JSValue {
    var v = JSValue.Undefined
    if argVals.len() > 0 {
        v = cloneValue(argVals[0])
    }
    if !st.objExtras[st.objects[target].extra].promiseResolved {
        st.objExtras[st.objects[target].extra].promiseResolved = true
        if isReject {
            settlePromise(&mut st, target, 2, v)
        } else {
            resolvePromiseValue(gProg, &mut st, target, v)
        }
    }
    return JSValue.Undefined
}

fn callBuiltin(id: Builtin, argVals: &Vec<JSValue>, st: &mut Interp): JSValue {
    if isErrorCtor(id) {
        let o = newObject(&mut st)
        st.objects[o].isError = true
        let ename = nativeErrorName(id)
        // NO own `name`: it lives on Error.prototype and each subtype's
        // prototype, and an own copy is directly observable —
        // Object.getOwnPropertyNames(new Error()) is ["stack"] in node and was
        // ["name","message","stack"] here. `message` is own only when one was
        // actually passed, which is the difference between `new Error()` and
        // `new Error("")`.
        var msg = ""
        var hasMsg = false
        if argVals.len() > 0 {
            match cloneValue(argVals[0]) {
                JSValue.Undefined => {
                }
                _ => {
                    msg = toStr(argVals[0])
                    hasMsg = true
                }
            }
        }
        if hasMsg {
            objSet(&mut st, o, "message", JSValue.Str(msg.clone()))
        }
        // error.stack: no real backtrace here, but a string headed "Name: message"
        // so code that reads or logs e.stack (a typeof check, express's error
        // middleware) sees a string rather than undefined
        var stackHead = ename.clone()
        if msg.len() > 0 {
            stackHead = stackHead + ": " + msg
        }
        objSet(&mut st, o, "stack", JSValue.Str(stackHead + errorStackFrames(st)))
        // new Error(msg, { cause }) — ES2022 error chaining
        if argVals.len() > 1 {
            let oh = objHandle(argVals[1])
            if oh >= 0 && objOwnIndex(st, oh, "cause") >= 0 {
                objSet(&mut st, o, "cause", cloneValue(getMember(st, oh, "cause")))
            }
        }
        // link to the real prototype so getPrototypeOf(e) === TypeError.prototype
        // and e.constructor resolve. -1 while setupGlobals is still running: an
        // error thrown during startup just gets no proto, as before.
        let ep = errorProtoFor(&mut st, id)
        if ep >= 0 {
            st.objects[o].proto = ep
        }
        objSetNonEnumerable(&mut st, o, "name")
        objSetNonEnumerable(&mut st, o, "message")
        objSetNonEnumerable(&mut st, o, "stack")
        return JSValue.Obj(o)
    }
    if id == Builtin.JsonStringify {
        if argVals.len() == 0 || mjJsonOmitted(argVals[0]) {
            // JSON.stringify(undefined) / a function is the JS value undefined
            return JSValue.Undefined
        }
        return JSValue.Str(mjStringifyVal(argVals[0], st))
    }
    if id == Builtin.JsonStringifyFast {
        if argVals.len() == 0 {
            return JSValue.Undefined
        }
        match mjStringifyFast(argVals[0], st) {
            Option.Some(text) => {
                return JSValue.Str(text)
            }
            Option.None => {
                return JSValue.Undefined
            }
        }
    }
    if id == Builtin.JsonParse {
        if argVals.len() == 0 {
            return JSValue.Undefined
        }
        let text = toStr(argVals[0])
        return mjJsonParse(text, &mut st)
    }
    if isMathBuiltin(id) {
        if id == Builtin.MathRandom {
            return mathNative(id, argVals, &mut st)
        }
        let nums = numArgsProg(gProg, argVals, &mut st)
        if st.throwing {
            return JSValue.Undefined
        }
        return mathNative(id, nums, &mut st)
    }
    if id == Builtin.Gc {
        // a real collection, not a no-op: the QuickJS GC tests call this to force
        // finalization, and a stub would make them pass without exercising anything
        collect(&mut st)
        return JSValue.Undefined
    }
    if id == Builtin.RegExp {
        var pat = ""
        var flags = ""
        if argVals.len() > 0 {
            // RegExp(re) copies re's pattern and flags rather than stringifying
            // it. ToString would have produced "[object Object]" here, so
            // `new RegExp(/x/g)` built a regex matching that literal text.
            let ph = objHandle(argVals[0])
            var copied = false
            if ph >= 0 && st.objects[ph].extra >= 0 && st.objExtras[st.objects[ph].extra].regexId >= 0 {
                pat = toStr(getMember(st, ph, "source"))
                flags = toStr(getMember(st, ph, "flags"))
                copied = true
            }
            if !copied {
                match cloneValue(argVals[0]) {
                    JSValue.Undefined => {
                    }
                    _ => {
                        pat = toStr(argVals[0])
                    }
                }
            }
        }
        // an explicit second argument overrides the copied flags, including ""
        if argVals.len() > 1 {
            match cloneValue(argVals[1]) {
                JSValue.Undefined => {
                }
                _ => {
                    flags = toStr(argVals[1])
                }
            }
        }
        return makeRegex(&mut st, pat, flags)
    }
    if id == Builtin.Number {
        if argVals.len() == 0 {
            return JSValue.Number(0.0)
        }
        // ToNumber of a SYMBOL is a TypeError, not NaN
        if isSymbolValue(argVals[0]) {
            return throwErr(&mut st, "TypeError", "Cannot convert a Symbol value to a number")
        }
        // an object coerces via ToPrimitive(number) — honouring a user
        // [Symbol.toPrimitive]/valueOf — before ToNumber; toNum alone gives NaN
        if objHandle(argVals[0]) >= 0 {
            let p = toPrimitiveNumber(gProg, argVals[0], &mut st)
            if st.throwing {
                return JSValue.Undefined
            }
            if isSymbolValue(p) {
                return throwErr(&mut st, "TypeError", "Cannot convert a Symbol value to a number")
            }
            return JSValue.Number(toNum(p))
        }
        return JSValue.Number(toNum(argVals[0]))
    }
    if id == Builtin.BigInt {
        if argVals.len() == 0 {
            return JSValue.BigInt("0")
        }
        match cloneValue(argVals[0]) {
            JSValue.BigInt(s) => {
                return JSValue.BigInt(s.clone())
            }
            JSValue.Sym(bsid) => {
                return throwErr(&mut st, "TypeError", "Cannot convert " + symbolDisplay(st, bsid) + " to a BigInt")
            }
            JSValue.Bool(b) => {
                if b {
                    return JSValue.BigInt("1")
                }
                return JSValue.BigInt("0")
            }
            JSValue.Str(s) => {
                let t = jsTrim(s)
                if isDecimalIntStr(t) {
                    return JSValue.BigInt(bigNormalizeDec(t))
                }
                // radix-prefixed strings (0x/0b/0o) parse with full precision
                if t.len() > 2 && t[0] == '0' {
                    let p = t[1]
                    if p == 'x' || p == 'X' {
                        return JSValue.BigInt(bnFromRadix(bnStrFrom(t, 2), 16))
                    }
                    if p == 'b' || p == 'B' {
                        return JSValue.BigInt(bnFromRadix(bnStrFrom(t, 2), 2))
                    }
                    if p == 'o' || p == 'O' {
                        return JSValue.BigInt(bnFromRadix(bnStrFrom(t, 2), 8))
                    }
                }
                // anything else (empty → 0n) via the numeric path
                return JSValue.BigInt(bnFromF64(strToNum(t)))
            }
            _ => {
                // BigInt(number): must be an integer (JS throws otherwise); we
                // truncate defensively rather than throw, staying non-crashing
                return JSValue.BigInt(bnFromF64(toNum(argVals[0])))
            }
        }
    }
    if id == Builtin.String {
        if argVals.len() == 0 {
            return JSValue.Str("")
        }
        // String(sym) is the one conversion the spec allows for a symbol
        // (SymbolDescriptiveString); a symbol WRAPPER still throws, below
        if let JSValue.Sym(sid) = argVals[0] {
            return JSValue.Str(symbolDisplay(st, sid))
        }
        // arrays coerce to their join, not "[object Object]"
        let a0h = objHandle(argVals[0])
        if a0h >= 0 && st.objects[a0h].isArray {
            return JSValue.Str(joinArray(&mut st, a0h, ","))
        }
        // an error coerces to "Name: message" the same way. Special-cased here
        // for the same reason arrays are: callNative has no `prog`, so it cannot
        // run the full ToPrimitive that `"" + err` goes through, and plain toStr
        // would answer "[object Object]".
        if a0h >= 0 && st.objects[a0h].isError {
            let en = toStr(objGet(st, a0h, "name"))
            let em = toStr(objGet(st, a0h, "message"))
            if em.len() > 0 {
                return JSValue.Str(en + ": " + em)
            }
            return JSValue.Str(en)
        }
        // through the Prog: String(fn) is the function's SOURCE, and a plain
        // object's user toString has to run
        return JSValue.Str(toStrArg(gProg, argVals[0], &mut st))
    }
    if id == Builtin.Boolean {
        if argVals.len() == 0 {
            return JSValue.Bool(false)
        }
        return JSValue.Bool(truthy(argVals[0]))
    }
    if id == Builtin.ReadFileSync {
        if argVals.len() == 0 {
            return JSValue.Undefined
        }
        match readFile(toStr(argVals[0])) {
            Result.Ok(txt) => {
                return JSValue.Str(txt)
            }
            Result.Err(_e) => {
                return JSValue.Undefined
            }
        }
    }
    if id == Builtin.FileExists {
        if argVals.len() == 0 {
            return JSValue.Bool(false)
        }
        match readFile(toStr(argVals[0])) {
            Result.Ok(_txt) => {
                return JSValue.Bool(true)
            }
            Result.Err(_e) => {
                return JSValue.Bool(false)
            }
        }
    }
    if id == Builtin.ObjectDefineProperty {
        // defineProperty is the other way a non-writable data property appears on
        // Object.prototype, so it retires the same fast path a plain write does.
        if argVals.len() > 0 && objHandle(argVals[0]) == st.objectProtoObj {
            st.objectProtoPristine = false
        }
        // Every one of these was silently accepted, so a call that the spec says
        // must throw returned the object unchanged and the caller carried on
        // believing the property was defined.
        if argVals.len() < 3 {
            return throwErr(&mut st, "TypeError", "Object.defineProperty called on non-object")
        }
        // NOT objHandle: a function is an object in JS but is a Func here, not
        // an Obj, so an objHandle test rejects every `defineProperty(fn, ...)`.
        // propertyBagOf answers for functions and natives too, and is -1 only
        // for a genuine primitive.
        let target = cloneValue(argVals[0])
        let key = toStr(argVals[1])
        let o = propertyBagOf(&mut st, target)
        if o < 0 {
            return throwErr(&mut st, "TypeError", "Object.defineProperty called on non-object")
        }
        let d = objHandle(argVals[2])
        if d < 0 {
            return throwErr(&mut st, "TypeError", "Property description must be an object")
        }
        if st.objects[o].isProxy {
            let pok = definePropOf(gProg, &mut st, target, key, d)
            if st.throwing {
                return JSValue.Undefined
            }
            if !pok {
                return throwErr(&mut st, "TypeError", "'defineProperty' on proxy: trap returned falsish for property '" + key + "'")
            }
            return cloneValue(target)
        }
        // the descriptor is an argument, which nothing roots across the
        // allocation toPropertyDescriptor makes; a collection there reused its
        // slot and the normalised copy read another object's fields
        pushTemp(&mut st, JSValue.Obj(d))
        let nd = toPropertyDescriptor(gProg, &mut st, d)
        if st.throwing {
            popTemp(&mut st)
            return JSValue.Undefined
        }
        pushTemp(&mut st, JSValue.Obj(nd))
        if !validDescriptor(&mut st, o, key, nd) {
            popTemp(&mut st)
            popTemp(&mut st)
            return JSValue.Undefined
        }
        applyDescriptor(&mut st, o, key, nd)
        popTemp(&mut st)
        popTemp(&mut st)
        return JSValue.Obj(o)
    }
    if id == Builtin.PromiseResolve || id == Builtin.PromiseReject {
        var v = JSValue.Undefined
        if argVals.len() > 0 {
            v = cloneValue(argVals[0])
        }
        if id == Builtin.PromiseResolve {
            // Promise.resolve(p) is p
            let h = objHandle(v)
            if h >= 0 && isPromise(st, h) {
                return v
            }
            // Anything else goes through full resolution: a thenable is FOLLOWED,
            // not wrapped. Fulfilling with the thenable made
            // `Promise.resolve({then(r){r(42)}})` deliver the object to .then.
            let np = newPromise(&mut st, 0, JSValue.Undefined)
            pushTemp(&mut st, JSValue.Obj(np))
            st.objExtras[st.objects[np].extra].promiseResolved = true
            resolvePromiseValue(gProg, &mut st, np, v)
            popTemp(&mut st)
            return JSValue.Obj(np)
        }
        return JSValue.Obj(newPromise(&mut st, 2, v))
    }
    if id == Builtin.IsNan || id == Builtin.IsFinite {
        var x = jsNan()
        if argVals.len() > 0 {
            x = toNumProg(gProg, argVals[0], &mut st)
            if st.throwing {
                return JSValue.Undefined
            }
        }
        let isNan = x != x
        if id == Builtin.IsNan {
            return JSValue.Bool(isNan)
        }
        return JSValue.Bool(!isNan && x != jsInfinity() && x != (0.0 - jsInfinity()))
    }
    if id == Builtin.ArrayIsArray {
        if argVals.len() > 0 {
            let h = objHandle(argVals[0])
            if h >= 0 {
                // the arguments object is array-SHAPED here but is not an Array
                return JSValue.Bool(valueIsArrayLike(st, argVals[0]))
            }
        }
        return JSValue.Bool(false)
    }
    if id == Builtin.ParseInt || id == Builtin.ParseFloat {
        if argVals.len() == 0 {
            return JSValue.Number(jsNan())
        }
        let text = toStrArg(gProg, argVals[0], &mut st)
        if st.throwing {
            return JSValue.Undefined
        }
        if id == Builtin.ParseFloat {
            return JSValue.Number(jsParseFloatPrefix(text))
        }
        var radix: i64 = 10
        if argVals.len() > 1 {
            let r = numToIndex(toNum(argVals[1]))
            if r >= 2 && r <= 36 {
                radix = r
            }
        }
        return JSValue.Number(jsParsePrefixNum(text, radix))
    }
    if id == Builtin.Symbol {
        // Symbol() and Symbol(undefined) have NO description, which reads back
        // as undefined; Symbol("") has the empty one
        if argVals.len() == 0 || isUndefinedValue(argVals[0]) {
            return JSValue.Sym(newSymbol(&mut st, "", false))
        }
        let desc = toStrArg(gProg, argVals[0], &mut st)
        if st.throwing {
            return JSValue.Undefined
        }
        return JSValue.Sym(newSymbol(&mut st, desc, true))
    }
    if id == Builtin.SymbolFor {
        var key = "undefined"
        if argVals.len() > 0 {
            key = toStrArg(gProg, argVals[0], &mut st)
            if st.throwing {
                return JSValue.Undefined
            }
        }
        return JSValue.Sym(symbolFor(&mut st, key))
    }
    if id == Builtin.SymbolKeyFor {
        var kid: i64 = -1
        if argVals.len() > 0 {
            kid = symIdOf(argVals[0])
        }
        if kid < 0 {
            var shown = "undefined"
            if argVals.len() > 0 {
                if objHandle(argVals[0]) >= 0 || funcHandle(argVals[0]) >= 0 {
                    shown = "#<Object>"
                } else {
                    shown = toStr(argVals[0])
                }
            }
            return throwErr(&mut st, "TypeError", shown + " is not a symbol")
        }
        return symbolKeyFor(st, kid)
    }
    if id == Builtin.ObjectDefineProperties {
        if argVals.len() < 2 {
            return JSValue.Undefined
        }
        let o = propertyBagOf(&mut st, argVals[0])
        let descs = objHandle(argVals[1])
        if o < 0 || descs < 0 {
            return throwErr(&mut st, "TypeError", "Object.defineProperties called on non-object")
        }
        if !objectDefineProperties(&mut st, o, descs) {
            return JSValue.Undefined
        }
        return JSValue.Obj(o)
    }
    if id == Builtin.WeakMap || id == Builtin.WeakSet {
        let o = newObject(&mut st)
        let wbag = getNativeProps(&mut st, Native.Fn(id))
        st.objects[o].proto = objHandle(objGet(st, wbag, "prototype"))
        let we = ensureExtra(&mut st, o)
        st.objExtras[we].weakKind = 2
        if id == Builtin.WeakMap {
            st.objExtras[we].weakKind = 1
        }
        pushTemp(&mut st, JSValue.Obj(o))
        if argVals.len() > 0 {
            mapSetFill(id, o, argVals[0], &mut st)
        }
        popTemp(&mut st)
        if st.throwing {
            return JSValue.Undefined
        }
        return JSValue.Obj(o)
    }
    if id == Builtin.Map || id == Builtin.Set {
        let o = newObject(&mut st)
        if id == Builtin.Map {
            st.objects[o].isMap = true
            if st.mapProtoObj >= 0 {
                st.objects[o].proto = st.mapProtoObj
            }
        } else {
            st.objects[o].isSet = true
            if st.setProtoObj >= 0 {
                st.objects[o].proto = st.setProtoObj
            }
        }
        // Map/Set entries live in the side table — allocate the slot up front so
        // every later mapKeys/mapVals access reaches a private extra, not the
        // shared default at index 0.
        let _me = ensureExtra(&mut st, o)
        pushTemp(&mut st, JSValue.Obj(o))
        if argVals.len() > 0 {
            mapSetFill(id, o, argVals[0], &mut st)
        }
        popTemp(&mut st)
        if st.throwing {
            return JSValue.Undefined
        }
        return JSValue.Obj(o)
    }
    if id == Builtin.ObjectGetOwnPropNames || id == Builtin.ObjectGetOwnPropSymbols {
        // Same ToObject rejection as Object.keys above.
        if argVals.len() == 0 || isNullish(argVals[0]) {
            return throwErr(&mut st, "TypeError", "Cannot convert undefined or null to object")
        }
        // Two views of the same [[OwnPropertyKeys]] list, differing only in
        // which half of it they keep.
        let wantSymbols = id == Builtin.ObjectGetOwnPropSymbols
        let arr = newArray(&mut st)
        if argVals.len() > 0 {
            pushTemp(&mut st, JSValue.Obj(arr))
            let keys = ownKeysOf(gProg, &mut st, argVals[0])
            if st.throwing {
                popTemp(&mut st)
                return JSValue.Undefined
            }
            var ki: i64 = 0
            while ki < keys.len() {
                if isSymbolKey(keys[ki]) == wantSymbols {
                    arrPush(&mut st, arr, propKeyValue(keys[ki]))
                }
                ki = ki + 1
            }
            popTemp(&mut st)
        }
        return JSValue.Obj(arr)
    }
    if id == Builtin.ArrayFrom {
        let arr = newArray(&mut st)
        pushTemp(&mut st, JSValue.Obj(arr))
        // gather the source elements, then apply the optional map function
        var elems: Vec<JSValue> = Vec.new()
        if argVals.len() > 0 {
            let h = objHandle(argVals[0])
            if h >= 0 {
                if st.objects[h].isArray {
                    var i: i64 = 0
                    while i < arrLen(st, h) {
                        elems.push(arrGetDyn(gProg, h, i, &mut st))
                        i = i + 1
                    }
                } else if st.objects[h].isSet {
                    // Array.from(set) → its values
                    var i: i64 = 0
                    while i < st.objExtras[st.objects[h].extra].mapKeys.len() {
                        elems.push(cloneValue(st.objExtras[st.objects[h].extra].mapKeys[i]))
                        i = i + 1
                    }
                } else if st.objects[h].isMap {
                    // Array.from(map) → [key, value] PAIRS, not just keys
                    var i: i64 = 0
                    while i < st.objExtras[st.objects[h].extra].mapKeys.len() {
                        let pair = newArray(&mut st)
                        pushTemp(&mut st, JSValue.Obj(pair))
                        arrPush(&mut st, pair, cloneValue(st.objExtras[st.objects[h].extra].mapKeys[i]))
                        arrPush(&mut st, pair, cloneValue(st.objExtras[st.objects[h].extra].mapVals[i]))
                        popTemp(&mut st)
                        elems.push(JSValue.Obj(pair))
                        i = i + 1
                    }
                } else {
                    let itFn = getMemberDyn(gProg, h, symIteratorKey(), &mut st)
                    if isCallableIn(st, itFn) {
                        // a real iterable (Buffer, custom [Symbol.iterator], …) —
                        // drive its iterator, exactly as spread does. Comes before
                        // the array-like path so an iterable with a length still
                        // iterates rather than index-reads.
                        spreadInto(gProg, &mut elems, JSValue.Obj(h), &mut st)
                    } else {
                        // array-like: use its `length` and index 0..length-1
                        // (covers the common Array.from({length:n}, fn) idiom)
                        let lenV = getMember(st, h, "length")
                        let len = toNum(lenV) as i64
                        var i: i64 = 0
                        while i < len {
                            elems.push(getMember(st, h, i64ToStr(i)))
                            i = i + 1
                        }
                    }
                }
            } else {
                if let JSValue.Str(sv) = cloneValue(argVals[0]) {
                    // code points, not bytes — Array.from("café") is 4 chars
                    for cp in strCodePoints(sv) {
                        elems.push(JSValue.Str(cp.clone()))
                    }
                }
            }
        }
        // optional map function (element, index) — gProg: natives reach user code
        // through the global program
        let hasMap = argVals.len() > 1 && isCallableIn(st, argVals[1])
        var k: i64 = 0
        while k < elems.len() && !st.throwing {
            if hasMap {
                var margs: Vec<JSValue> = Vec.new()
                margs.push(cloneValue(elems[k]))
                margs.push(JSValue.Number(k as f64))
                arrPush(&mut st, arr, callValue(gProg, argVals[1], margs, JSValue.Undefined, &mut st))
            } else {
                arrPush(&mut st, arr, cloneValue(elems[k]))
            }
            k = k + 1
        }
        popTemp(&mut st)
        return JSValue.Obj(arr)
    }
    if id == Builtin.TcpListen {
        var port: i64 = 0
        if argVals.len() > 0 {
            port = numToIndex(toNum(argVals[0]))
        }
        match TcpListener.bind(port as u16) {
            Result.Ok(l) => {
                st.listeners.push(l)
                return JSValue.Number((st.listeners.len() - 1) as f64)
            }
            Result.Err(_e) => {
                return JSValue.Number(0.0 - 1.0)
            }
        }
    }
    if id == Builtin.TcpAccept {
        // Nonblocking by default: a blocking accept parks the event-loop task on
        // the listener, which stalls timers, microtasks and fetch servicing until
        // the NEXT connection arrives — with R1 activations that wedged every
        // request whose completion needed the loop (the cold-fetch hang). The
        // second argument opts back into the blocking accept; serveHttpOnce sets
        // it only when the loop is verifiably idle.
        var idx: i64 = 0
        if argVals.len() > 0 {
