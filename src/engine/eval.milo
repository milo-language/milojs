enum Flow {
    Normal,
    Ret(JSValue),
    // loop control; these never escape a function boundary. The string is the
    // target label, "" when unlabeled. A loop consumes an unlabeled signal or
    // one naming its own label, and re-propagates any other so an outer labeled
    // loop can catch it.
    Break(string),
    Continue(string),
}

fn evalBin(op: &string, a: &JSValue, b: &JSValue): JSValue {
    if op == "+" {
        if isStr(a) || isStr(b) {
            return JSValue.Str(toStr(a) + toStr(b))
        }
        return JSValue.Number(toNum(a) + toNum(b))
    }
    if op == "-" {
        return JSValue.Number(toNum(a) - toNum(b))
    }
    if op == "*" {
        return JSValue.Number(toNum(a) * toNum(b))
    }
    if op == "/" {
        return JSValue.Number(toNum(a) / toNum(b))
    }
    if op == "%" {
        return JSValue.Number(Math.mod(toNum(a), toNum(b)))
    }
    if op == "**" {
        return JSValue.Number(Math.pow(toNum(a), toNum(b)))
    }
    if op == "&" {
        return JSValue.Number((toInt32(a) & toInt32(b)) as f64)
    }
    if op == "|" {
        return JSValue.Number((toInt32(a) | toInt32(b)) as f64)
    }
    if op == "^" {
        return JSValue.Number((toInt32(a) ^ toInt32(b)) as f64)
    }
    if op == "<<" || op == ">>" || op == ">>>" {
        // JS masks the shift count to 5 bits; >>> is the only unsigned one
        let sh = toUint32(b) & 31
        if op == ">>>" {
            return JSValue.Number((toUint32(a) >> sh) as f64)
        }
        let lhs = toInt32(a)
        if op == ">>" {
            return JSValue.Number((lhs >> sh) as f64)
        }
        var r = (lhs << sh) & 4294967295
        if r >= 2147483648 {
            r = r - 4294967296
        }
        return JSValue.Number(r as f64)
    }
    if op == "==" {
        return JSValue.Bool(jsEquals(a, b))
    }
    if op == "!=" {
        return JSValue.Bool(!jsEquals(a, b))
    }
    if op == "===" {
        return JSValue.Bool(jsStrictEquals(a, b))
    }
    if op == "!==" {
        return JSValue.Bool(!jsStrictEquals(a, b))
    }
    // relational: string<string is lexicographic, else numeric (NaN → false)
    if isStr(a) && isStr(b) {
        let sa = toStr(a)
        let sb = toStr(b)
        if op == "<" {
            return JSValue.Bool(strLess(sa, sb))
        }
        if op == ">" {
            return JSValue.Bool(strLess(sb, sa))
        }
        if op == "<=" {
            return JSValue.Bool(!strLess(sb, sa))
        }
        if op == ">=" {
            return JSValue.Bool(!strLess(sa, sb))
        }
    }
    let x = toNum(a)
    let y = toNum(b)
    if op == "<" {
        return JSValue.Bool(x < y)
    }
    if op == ">" {
        return JSValue.Bool(x > y)
    }
    if op == "<=" {
        return JSValue.Bool(x <= y)
    }
    if op == ">=" {
        return JSValue.Bool(x >= y)
    }
    return JSValue.Undefined
}

// Property read that understands arrays: `length` and integer indices hit the
// element vector, everything else the string-keyed props.
// Getter for `key` on `o` or anywhere up its prototype chain, else Undefined.
// Kept separate from getMember because invoking a getter needs the program and a
// mutable interpreter, which the plain reader does not have.
fn findGetter(st: &Interp, o: i64, key: &string): JSValue {
    var cur = o
    while cur >= 0 {
        let idx = objOwnIndex(st, cur, key)
        if idx >= 0 {
            if propIsAccessor(st, cur, idx) {
                return accGetter(st, st.objects[cur].props[idx].acc)
            }
            return JSValue.Undefined
        }
        cur = st.objects[cur].proto
    }
    return JSValue.Undefined
}

fn findSetter(st: &Interp, o: i64, key: &string): JSValue {
    var cur = o
    while cur >= 0 {
        let idx = objOwnIndex(st, cur, key)
        if idx >= 0 {
            if propIsAccessor(st, cur, idx) {
                return accSetter(st, st.objects[cur].props[idx].acc)
            }
            return JSValue.Undefined
        }
        cur = st.objects[cur].proto
    }
    return JSValue.Undefined
}

// Property read that honours accessors; `this` inside the getter is the object.
// Array.prototype.join / toString, prog-free so string-coercion paths (which have
// no Prog) can reuse it. Nested arrays join recursively; null/undefined render
// empty; every other element goes through toStr (plain objects -> [object Object]).
fn joinArray(st: &mut Interp, o: i64, sep: &string): string {
    var out = ""
    var i: i64 = 0
    let n = arrLen(st, o)
    while i < n {
        if i > 0 {
            out = out + sep
        }
        let e = arrGet(st, o, i)
        match e {
            JSValue.Null => {
            }
            JSValue.Undefined => {
            }
            _ => {
                let eh = objHandle(e)
                if eh >= 0 && st.objects[eh].isArray {
                    out = out + joinArray(st, eh, sep)
                } else {
                    out = out + toStr(e)
                }
            }
        }
        i = i + 1
    }
    return out
}

// JS ToPrimitive with the "default" hint (used by `+`): try valueOf, then
// toString, taking the first that yields a primitive. Arrays and plain objects
// valueOf to themselves, so toString decides — arrays join, plain objects give
// "[object Object]". A non-object value is already primitive.
// ToPrimitive with the NUMBER hint (used by arithmetic/relational operators).
// The only object whose number-hint result differs from the default here is a
// Date: default hint (used by `+`) stringifies it, number hint yields its epoch
// milliseconds. Everything else follows the same valueOf-then-toString path.
// A user-defined [Symbol.toPrimitive](hint) takes precedence over valueOf/
// toString. Returns Option.Some(primitive) when the method exists, else None so
// the caller falls through to the ordinary coercion.
fn trySymToPrimitive(prog: &Prog, h: i64, hint: &string, st: &mut Interp): Option<JSValue> {
    // Copied out of the AST before anything below can re-enter the
    // interpreter and move the program storage this reference points into.
    let hintCopy = hint.clone()
    let m = getMemberDyn(prog, h, symToPrimitiveKey(), st)
    if isCallableIn(st, m) {
        pushTemp(st, JSValue.Obj(h))
        var args: Vec<JSValue> = Vec.new()
        args.push(JSValue.Str(hintCopy.clone()))
        let r = callValue(prog, m, args, JSValue.Obj(h), st)
        popTemp(st)
        return Option.Some(r)
    }
    return Option.None
}

// `new String("a")` is an OBJECT: typeof says "object", it is truthy even for
// `new Boolean(false)`, and it is never === its primitive. Returning the
// primitive from these constructors, as this engine used to, gets all three
// wrong, and it also made `0 in Object("a")` throw, because the `in` really was
// being applied to a string. boxedPrimitive/isWrapperObj live in runtime.milo.
// The prototype object a built-in constructor hands to its instances. Held in
// the constructor's own property bag, which is where buildNativeProto put it.
fn nativeProtoHandle(st: &mut Interp, nativeId: Builtin): i64 {
    let bag = getNativeProps(st, Native.Fn(nativeId))
    return objHandle(objGet(st, bag, "prototype"))
}

// Box a primitive. A String wrapper materialises its index properties and
// length up front: the string is immutable, so there is nothing to keep in sync,
// and it makes `0 in s`, Object.keys and for-in work without a special case on
// every path that enumerates.
pub fn makeWrapper(st: &mut Interp, v: &JSValue): JSValue {
    let o = newObject(st)
    pushTemp(st, JSValue.Obj(o))
    var protoNative: Option<Builtin> = Option.None
    match v {
        JSValue.Str(sv) => {
            if isSymbolStr(sv) {
                protoNative = Option.Some(Builtin.Symbol)
            } else {
                st.objects[o].proto = st.stringProtoObj
                var idx: i64 = 0
                let cps = strCodePoints(sv)
                while idx < cps.len() {
                    // enumerable, unlike length: Object.keys(Object("ab")) is
                    // ["0","1"] and for-in visits the indices
                    objSetFrozenOwn(st, o, numToStr(idx as f64), JSValue.Str(cps[idx].clone()), true)
                    idx = idx + 1
                }
                objSetFrozenOwn(st, o, "length", JSValue.Number(utf16Length(sv) as f64), false)
            }
        }
        JSValue.Number(_n) => {
            protoNative = Option.Some(Builtin.Number)
        }
        JSValue.Bool(_b) => {
            protoNative = Option.Some(Builtin.Boolean)
        }
        JSValue.BigInt(_g) => {
            protoNative = Option.Some(Builtin.BigInt)
        }
        _ => {
        }
    }
    if let Option.Some(pn) = protoNative {
        let pr = nativeProtoHandle(st, pn)
        if pr >= 0 {
            st.objects[o].proto = pr
        }
    }
    let _ = ensureExtra(st, o)
    st.objExtras[st.objects[o].extra].boxed = cloneValue(v)
    popTemp(st)
    return JSValue.Obj(o)
}

fn toPrimitiveNumber(prog: &Prog, v: &JSValue, st: &mut Interp): JSValue {
    let bh = objHandle(v)
    if bh >= 0 && isWrapperObj(st, bh) {
        return boxedPrimitive(st, bh)
    }
    let h = objHandle(v)
    if h >= 0 {
        if let Option.Some(r) = trySymToPrimitive(prog, h, "number", st) {
            return r
        }
        if st.objects[h].isDate {
            return JSValue.Number(st.objExtras[st.objects[h].extra].dateMs)
        }
    }
    return toPrimitiveDefault(prog, v, st)
}

fn toPrimitiveDefault(prog: &Prog, v: &JSValue, st: &mut Interp): JSValue {
    // a function has no valueOf that yields a primitive, so ToPrimitive falls to
    // its toString — which is its SOURCE. `"" + fn` prints the text.
    match v {
        JSValue.Func(df, _de) => {
            return JSValue.Str(funcSourceText(prog, df))
        }
        JSValue.Native(dn) => {
            return JSValue.Str(nativeSourceText(st, dn))
        }
        _ => {
        }
    }
    let bh = objHandle(v)
    if bh >= 0 && isWrapperObj(st, bh) {
        return boxedPrimitive(st, bh)
    }
    let h = objHandle(v)
    if h < 0 {
        return cloneValue(v)
    }
    if let Option.Some(r) = trySymToPrimitive(prog, h, "default", st) {
        return r
    }
    // arrays join directly — reading their toString as a bound value does not
    // route back to the join, so short-circuit here
    if st.objects[h].isArray {
        return JSValue.Str(joinArrayProg(prog, st, h, ","))
    }
    // Date is the one built-in whose @@toPrimitive turns the DEFAULT hint into
    // the STRING one, which is why `"" + d` is the date string and not the
    // epoch number. Without this, fixing Date.prototype.valueOf to answer a
    // number (it used to answer the ISO string) would have made `d + ""` worse.
    if st.objects[h].isDate {
        return toPrimitiveString(prog, v, st)
    }
    pushTemp(st, JSValue.Obj(h))
    let vf = getMemberDyn(prog, h, "valueOf", st)
    if isCallableIn(st, vf) {
        var noA: Vec<JSValue> = Vec.new()
        let r = callValue(prog, vf, noA, JSValue.Obj(h), st)
        if objHandle(r) < 0 && funcHandle(r) < 0 {
            popTemp(st)
            return r
        }
    }
    let tf = getMemberDyn(prog, h, "toString", st)
    if isCallableIn(st, tf) {
        var noB: Vec<JSValue> = Vec.new()
        let r2 = callValue(prog, tf, noB, JSValue.Obj(h), st)
        if objHandle(r2) < 0 && funcHandle(r2) < 0 {
            popTemp(st)
            return r2
        }
    }
    popTemp(st)
    return noPrimitive(st)
}

// Both conversion methods were unusable — missing, not callable, or answering
// another object. The spec's answer is a TypeError, and it used to be the string
// "[object Object]": `String({ toString: 5 })` quietly produced that instead of
// throwing, which is how a non-callable toString reached the caller as a value.
// Guarded on st.throwing so a toString that threw keeps ITS error rather than
// having this one written over it.
fn noPrimitive(st: &mut Interp): JSValue {
    if !st.throwing {
        st.throwing = true
        st.thrownValue = makeError(st, "TypeError", "Cannot convert object to primitive value")
    }
    return JSValue.Str("")
}

// ToPrimitive with the STRING hint: toString before valueOf, the reverse of the
// default hint. `String(x)` and Array.prototype.join both convert this way, and
// the order is observable — an object with both methods gives its toString here
// and its valueOf under `+`.
fn toPrimitiveString(prog: &Prog, v: &JSValue, st: &mut Interp): JSValue {
    let bh = objHandle(v)
    if bh >= 0 && isWrapperObj(st, bh) {
        return boxedPrimitive(st, bh)
    }
    let h = objHandle(v)
    if h < 0 {
        return cloneValue(v)
    }
    if let Option.Some(r) = trySymToPrimitive(prog, h, "string", st) {
        return r
    }
    if st.objects[h].isArray {
        return JSValue.Str(joinArrayProg(prog, st, h, ","))
    }
    pushTemp(st, JSValue.Obj(h))
    let tf = getMemberDyn(prog, h, "toString", st)
    if isCallableIn(st, tf) {
        var noA: Vec<JSValue> = Vec.new()
        let r = callValue(prog, tf, noA, JSValue.Obj(h), st)
        if objHandle(r) < 0 && funcHandle(r) < 0 {
            popTemp(st)
            return r
        }
    }
    let vf = getMemberDyn(prog, h, "valueOf", st)
    if isCallableIn(st, vf) {
        var noB: Vec<JSValue> = Vec.new()
        let r2 = callValue(prog, vf, noB, JSValue.Obj(h), st)
        if objHandle(r2) < 0 && funcHandle(r2) < 0 {
            popTemp(st)
            return r2
        }
    }
    popTemp(st)
    return noPrimitive(st)
}

// ToString for the paths that DO have a Prog, so a user-defined toString is
// honoured. `toStr` alone cannot call back into the interpreter and answers
// "[object Object]" for any plain object.
pub fn toStrProg(prog: &Prog, v: &JSValue, st: &mut Interp): string {
    // ToString of a function is its SOURCE, not the word "function": `String(fn)`
    // and `"" + fn` both print the text, and value.milo has neither the source
    // registry nor the native name table to answer that.
    match v {
        JSValue.Func(vf, _ve) => {
            return funcSourceText(prog, vf)
        }
        JSValue.Native(vn) => {
            return nativeSourceText(st, vn)
        }
        _ => {
        }
    }
    if objHandle(v) < 0 {
        return toStr(v)
    }
    let p = toPrimitiveString(prog, v, st)
    return toStr(p)
}

// ToNumber for the paths that DO have a Prog, so a user-defined valueOf is
// honoured. The mirror of toStrProg.
pub fn toNumProg(prog: &Prog, v: &JSValue, st: &mut Interp): f64 {
    if objHandle(v) < 0 {
        return toNum(v)
    }
    let p = toPrimitiveNumber(prog, v, st)
    return toNum(p)
}

// ToNumber for an ARGUMENT position, where a symbol is a TypeError rather than
// NaN. toNumProg cannot do this for every caller: loose equality reaches it too,
// and `Symbol() == 1` is false rather than an exception.
pub fn toNumArg(prog: &Prog, v: &JSValue, st: &mut Interp): f64 {
    if isSymbolValue(v) {
        st.throwing = true
        st.thrownValue = makeError(st, "TypeError", "Cannot convert a Symbol value to a number")
        return jsNan()
    }
    return toNumProg(prog, v, st)
}

// Which argument positions of a String.prototype method the spec ToStrings, and
// which it ToNumbers.
//
// builtins.milo has no Prog and so cannot re-enter the interpreter: its argStr
// and argNum answer "[object Object]" and NaN for every object, silently
// skipping the user toString/valueOf the spec requires calling. Converting here,
// at the dispatch boundary where a Prog exists, keeps builtins.milo prog-free
// and is also the only place a coercion that THROWS has somewhere to throw from.
//
// Not a nicety: is-regex identifies a regex by handing exec an argument whose
// toString throws, and tape depends on is-regex. An engine that quietly declines
// to call the argument's toString fails every package tape tests.
fn strArgWantsString(name: &string, i: i64): bool {
    if i == 0 {
        return name == "indexOf" || name == "lastIndexOf" || name == "includes" || name == "startsWith" || name == "endsWith" || name == "split" || name == "localeCompare" || name == "normalize" || name == "replace" || name == "replaceAll"
    }
    if i == 1 {
        return name == "padStart" || name == "padEnd" || name == "replace" || name == "replaceAll"
    }
    return false
}

fn strArgWantsNumber(name: &string, i: i64): bool {
    if i == 0 {
        return name == "at" || name == "charAt" || name == "charCodeAt" || name == "codePointAt" || name == "repeat" || name == "slice" || name == "substring" || name == "substr" || name == "padStart" || name == "padEnd"
    }
    if i == 1 {
        return name == "indexOf" || name == "lastIndexOf" || name == "includes" || name == "startsWith" || name == "endsWith" || name == "split" || name == "slice" || name == "substring" || name == "substr"
    }
    return false
}

// Objects only, and only in positions that are coerced: the common all-primitive
// call must not pay for a copy of its argument vector.
fn stringArgsNeedCoercion(name: &string, args: &Vec<JSValue>): bool {
    var i: i64 = 0
    while i < args.len() {
        if objHandle(args[i]) >= 0 && (strArgWantsString(name, i) || strArgWantsNumber(name, i)) {
            return true
        }
        i = i + 1
    }
    return false
}

// Callers must run this AFTER the regex-op and concat branches: a RegExp
// argument to replace/split belongs to those, and stringifying it here would
// turn `s.replace(/a/g, "x")` into a search for the literal text "/a/g".
fn coercedStringArgs(prog: &Prog, name: &string, args: &Vec<JSValue>, st: &mut Interp): Vec<JSValue> {
    var out: Vec<JSValue> = Vec.new()
    // includes/startsWith/endsWith REJECT a RegExp argument rather than
    // stringifying it: the spec says so precisely because the coercion below
    // would otherwise turn the call into a substring search for "/re/" and
    // answer false. The check has to happen here, before the coercion, because
    // by the time stringMethod sees the argument it is already a string.
    if name == "includes" || name == "startsWith" || name == "endsWith" {
        if args.len() > 0 {
            let rh = objHandle(args[0])
            if rh >= 0 && st.objExtras[st.objects[rh].extra].regexId >= 0 {
                st.throwing = true
                st.thrownValue = makeError(st, "TypeError", "First argument to String.prototype." + name.clone() + " must not be a regular expression")
                return out
            }
        }
    }
    var i: i64 = 0
    while i < args.len() {
        if objHandle(args[i]) >= 0 && strArgWantsString(name, i) && !isCallableIn(st, args[i]) {
            out.push(JSValue.Str(toStrProg(prog, args[i], st)))
        } else if objHandle(args[i]) >= 0 && strArgWantsNumber(name, i) {
            out.push(JSValue.Number(toNumProg(prog, args[i], st)))
        } else {
            out.push(cloneValue(args[i]))
        }
        if st.throwing {
            return out
        }
        i = i + 1
    }
    return out
}

// String.prototype.concat, converting each argument through `prog`. It cannot
// live in stringMethod with the rest of the string methods: that function has no
// Prog, so its `toStr` answered "[object Object]" for every object argument —
// including an array or a Date, which have perfectly good toStrings.
fn strConcatProg(prog: &Prog, s: &string, args: &Vec<JSValue>, st: &mut Interp): string {
    var out = s.clone()
    var i: i64 = 0
    while i < args.len() {
        out = out + toStrProg(prog, args[i], st)
        i = i + 1
    }
    return out
}

// join with each element converted through `prog`. The prog-free joinArray
// remains for the coercion paths that have no Prog to re-enter user code with.
// Element read that honours the prototype chain including ACCESSORS. arrGet
// has no Prog and so cannot call a getter: with a getter installed at
// `Array.prototype[1]`, a hole at index 1 read as undefined and indexOf could
// never find its value.
pub fn arrGetDyn(prog: &Prog, o: i64, idx: i64, st: &mut Interp): JSValue {
    // A scratch array adapting an array-like receiver reads THROUGH to the
    // original. The adapter copies once up front, and the spec's methods do a real
    // [[Get]] per index — so a callback that mutates the receiver mid-loop
    // (`Array.prototype.forEach.call(o, function(){ o[1] = 99 })`) must be
    // observed, and reading the copy could never see it.
    let orig = st.objExtras[st.objects[o].extra].arrayLikeOrig
    if orig >= 0 {
        return getMemberDyn(prog, orig, i64ToStr(idx), st)
    }
    // An own ACCESSOR on an index shadows the dense slot: after
    // `Object.defineProperty(a, 0, {get(){...}})` the element is still present in
    // `elems`, so the fast path below returned the stale value it had before the
    // getter was installed and every callback method saw the wrong element.
    // Guarded on props being non-empty, so an ordinary array pays one length check.
    if st.objects[o].props.len() > 0 {
        let ai = objOwnIndex(st, o, i64ToStr(idx))
        if ai >= 0 && propIsAccessor(st, o, ai) {
            return getMemberDyn(prog, o, i64ToStr(idx), st)
        }
    }
    if !arrIsHole(st, o, idx) {
        return arrGet(st, o, idx)
    }
    return getMemberDyn(prog, o, i64ToStr(idx), st)
}

pub fn joinArrayProg(prog: &Prog, st: &mut Interp, o: i64, sep: &string): string {
    var seen: Vec<i64> = Vec.new()
    return joinArrayInner(prog, st, o, sep, seen)
}

// `seen` is every array currently being joined, not just the outermost one. The
// old guard compared against the immediate receiver, which catches `a.push(a)`
// but not `a.push([a])`: an INDIRECT cycle recursed until the native stack died,
// and the process exited 0 having printed nothing.
//
// The separator is only used at THIS level. A nested array is converted by
// ToString, which is its own toString, which is join() with the DEFAULT comma, so
// `[1,[2,3]].join("-")` is "1-2,3" and not "1-2-3".
fn joinArrayInner(prog: &Prog, st: &mut Interp, o: i64, sep: &string, seen: &mut Vec<i64>): string {
    var out = ""
    var i: i64 = 0
    let n = arrLen(st, o)
    seen.push(o)
    while i < n {
        if i > 0 {
            out = out + sep
        }
        let e = arrGetDyn(prog, o, i, st)
        match e {
            JSValue.Null => {
            }
            JSValue.Undefined => {
            }
            _ => {
                let eh = objHandle(e)
                if eh >= 0 && st.objects[eh].isArray {
                    var cyclic = false
                    var si: i64 = 0
                    while si < seen.len() {
                        if seen[si] == eh {
                            cyclic = true
                        }
                        si = si + 1
                    }
                    if !cyclic {
                        out = out + joinArrayInner(prog, st, eh, ",", seen)
                    }
                } else {
                    // ToString of a symbol throws; join must propagate that rather
                    // than writing the internal tag or answering undefined.
                    if isSymbolValue(e) {
                        st.throwing = true
                        st.thrownValue = makeError(st, "TypeError", "Cannot convert a Symbol value to a string")
                        let _p = seen.pop()
                        return out
                    }
                    out = out + toStrProg(prog, e, st)
                }
            }
        }
        i = i + 1
    }
    let _popped = seen.pop()
    return out
}

// `#x@Foo$3` reads back as `#x` in a diagnostic; the mangling is an
// implementation detail and should not leak into a message.
fn privDisplay(key: &string): string {
    var i: i64 = 0
    while i < key.len() {
        if key[i] == '@' {
            return strSlice(key.clone(), 0, i)
        }
        i = i + 1
    }
    return key.clone()
}

pub fn getMemberDyn(prog: &Prog, o: i64, key: &string, st: &mut Interp): JSValue {
    if st.objects[o].isProxy {
        // A proxy carries no private state and does not forward it: `this.#x`
        // where `this` is a proxy over the instance is a TypeError, which is what
        // makes the brand check meaningful across a proxy at all.
        if isPrivateKey(key) {
            return throwTypeErr(st, "Cannot read private member " + privDisplay(key) + " from an object whose class did not declare it")
        }
        let trap = proxyTrapChecked(prog, st, o, "get")
        if st.throwing {
            return JSValue.Undefined
        }
        let target = proxyTargetOf(st, o)
        if !isUndefinedValue(trap) {
            var args: Vec<JSValue> = Vec.new()
            args.push(cloneValue(target))
            args.push(JSValue.Str(key.clone()))
            args.push(JSValue.Obj(o))
            let r = callTrap(prog, st, o, trap, args)
            if st.throwing {
                return JSValue.Undefined
            }
            checkProxyGetResult(prog, st, target, key, r)
            if st.throwing {
                return JSValue.Undefined
            }
            return r
        }
        // no trap: forward to the target, which may itself be a proxy
        let th = propertyBagOf(st, target)
        if th >= 0 {
            // a proxy over a function answers to call/apply/bind, and the
            // receiver has to be the PROXY: `p.call(x)` routes through the apply
            // trap. Forwarding to the target's statics bag instead found nothing
            // there, since those three are dispatched rather than stored.
            if st.objects[o].isFunctionLike && (key == "call" || key == "apply" || key == "bind") && objOwnIndex(st, th, key) < 0 {
                return makeBoundMethod(st, JSValue.Obj(o), key.clone())
            }
            return getMemberDyn(prog, th, key, st)
        }
        return JSValue.Undefined
    }
    // promise.then/catch/finally dispatch natively, so reading them as VALUES
    // returned undefined. The standard thenable test every library uses is
    // `typeof x.then === "function"`, which that silently failed — hand back a
    // bound method instead.
    if objOwnIndex(st, o, key) < 0 {
        // A PROXY in the prototype chain answers the read, with the ORIGINAL
        // object as the receiver: `Object.create(proxy).x` fires the get trap.
        if st.anyProxy && !(st.objects[o].isArray && asArrayIndex(key) >= 0) {
            var gw = protoOfHandle(st, o)
            while gw >= 0 {
                if st.objects[gw].isProxy {
                    return reflectGet(prog, st, JSValue.Obj(gw), key, JSValue.Obj(o))
                }
                gw = protoOfHandle(st, gw)
            }
        }
        // Reading a PRIVATE member from an object that does not carry it is a
        // TypeError, not undefined: the brand check is the whole point of
        // private state, and answering undefined let `other.#x` read as "absent
        // field" instead of "wrong object".
        if isPrivateKey(key) {
            var pw = st.objects[o].proto
            var found = false
            while pw >= 0 {
                if objOwnIndex(st, pw, key) >= 0 {
                    found = true
                    pw = -1
                } else {
                    pw = st.objects[pw].proto
                }
            }
            if !found {
                st.throwing = true
                st.thrownValue = makeError(st, "TypeError", "Cannot read private member " + privDisplay(key) + " from an object whose class did not declare it")
                return JSValue.Undefined
            }
        }
        // obj.__proto__ mirrors Object.getPrototypeOf (a Object.prototype accessor
        // in the spec); resolve it through the same type-based helper
        // ...and only when the object inherits the accessor. An own "__proto__"
        // data property on a null-prototype object is an ordinary property, and
        // reading it off one that has neither answers undefined, not null.
        if key == "__proto__" && objOwnIndex(st, o, key) < 0 {
            if inheritsObjectProto(st, o) {
                let pp = protoOfHandle(st, o)
                if pp >= 0 {
                    return JSValue.Obj(pp)
                }
                return JSValue.Null
            }
            return JSValue.Undefined
        }
        // builtin methods are dispatched by name, not stored as properties, so
        // reading one as a value needs a bound method synthesised here
        if st.objects[o].promiseState >= 0 && (key == "then" || key == "catch" || key == "finally") {
            return makeBoundMethod(st, JSValue.Obj(o), key.clone())
        }
        if (st.objects[o].isMap || st.objects[o].isSet) && isMapSetMethodName(key) {
            return makeBoundMethod(st, JSValue.Obj(o), key.clone())
        }
        if st.objExtras[st.objects[o].extra].regexId >= 0 && isRegexMethodName(key) {
            return makeBoundMethod(st, JSValue.Obj(o), key.clone())
        }
        if st.objects[o].isArrayBuffer && (key == "slice" || key == "resize" || key == "transfer") {
            return makeBoundMethod(st, JSValue.Obj(o), key.clone())
        }
        if st.objects[o].isDataView && isDataViewMethodName(key) {
            return makeBoundMethod(st, JSValue.Obj(o), key.clone())
        }
        if st.objects[o].isAsyncGenerator && key == symAsyncIteratorKey() {
            return makeBoundMethod(st, JSValue.Obj(o), key.clone())
        }
        if st.objects[o].isGenerator && (key == "next" || key == "throw" || key == "return" || key == symIteratorKey()) {
            return makeBoundMethod(st, JSValue.Obj(o), key.clone())
        }
        if st.objExtras[st.objects[o].extra].taBuf >= 0 && isTypedArrayMethodName(key)
            && !typedArrayOverride(st, o, key) {
            return makeBoundMethod(st, JSValue.Obj(o), key.clone())
        }
        // NB: no array-method arm here. Arrays link Array.prototype as a real
        // proto, so the chain walk below finds them — and only if the user has
        // not replaced one, which is what makes `Array.prototype.map = …` take
        // effect the way it does in a real engine.
        // every object inherits these from Object.prototype, including the
        // built-in constructors — `Object.hasOwnProperty.call(x, k)` is a common
        // way to borrow the method, and it read as undefined before
        // Every one of these synthesises an Object.prototype method for an
        // object the raw proto walk cannot reach it from. An object with a NULL
        // prototype must reach nothing, so it skips the whole group.
        if st.objects[o].protoNull {
            return getMember(st, o, key)
        }
        if key == "hasOwnProperty" || key == "isPrototypeOf" || key == "propertyIsEnumerable" {
            // "the ordinary walk found nothing", the same condition toString
            // uses below: objHasInChain reaches Object.prototype by TYPE, so it
            // reported the method as present on objects whose raw proto walk
            // could never reach it — a function's property bag among them, which
            // is why `fn.hasOwnProperty` read as undefined
            if isUndefinedValue(getMember(st, o, key)) {
                return makeBoundMethod(st, JSValue.Obj(o), key.clone())
            }
        }
        // Object.prototype.toString/valueOf were unreachable from an ordinary
        // object: a plain `{}` has proto == -1 and the fallback to
        // Object.prototype lives in protoOfHandle, which the chain walk below
        // does not use. So `({}).toString` read as undefined — and ToPrimitive
        // with the STRING hint then skipped straight to valueOf, which is the
        // wrong order (`String({valueOf: () => 5})` answered "5").
        // the condition is "the ordinary chain walk found nothing", not
        // objHasInChain: that helper now reaches Object.prototype by type, which
        // is what `in` and napi_has_property need, but getMember still walks the
        // raw proto field and so still needs the synthesised method here
        if key == "toString" && isUndefinedValue(getMember(st, o, key)) {
            // unbound, so the call-site receiver wins, exactly as the copy
            // stored on Object.prototype is
            return makeBoundMethod(st, JSValue.Undefined, "@@objProtoToString")
        }
        if key == "valueOf" && isUndefinedValue(getMember(st, o, key)) {
            return makeBoundMethod(st, JSValue.Obj(o), "valueOf")
        }
        if st.objects[o].isError && (key == "toString" || key == "valueOf") {
            return makeBoundMethod(st, JSValue.Obj(o), key.clone())
        }
        if st.objects[o].isDate {
            for dn in dateProtoMethodNames() {
                if dn == key {
                    return makeBoundMethod(st, JSValue.Obj(o), key.clone())
                }
            }
        }
    }
    // arr[Symbol.iterator] — a bound `values`, so arr[Symbol.iterator]() yields
    // the same iterator for-of drives. Lives here rather than in getMember
    // because building the bound method allocates and getMember is immutable.
    // No array arm here: Array.prototype carries Symbol.iterator as a real
    // property and arrays link it as a real proto, so the ordinary walk finds
    // it and a program that deletes or replaces it is obeyed.
    // The same for Map and Set. for-of and spread already worked, because those
    // drive the collection directly, but READING the member gave undefined —
    // and get-intrinsic resolves %MapIteratorPrototype% by calling it.
    if st.objects[o].isMap && key == symIteratorKey() && objOwnIndex(st, o, key) < 0 {
        return makeBoundMethod(st, JSValue.Obj(o), "entries")
    }
    if st.objects[o].isSet && key == symIteratorKey() && objOwnIndex(st, o, key) < 0 {
        return makeBoundMethod(st, JSValue.Obj(o), "values")
    }
    // globalThis.x reads the global binding, so it stays in step with bare `x`
    if st.objects[o].isGlobal && objOwnIndex(st, o, key) < 0 {
        if scopeHasOwn(st, 0, key) {
            return scopeLookup(st, 0, key)
        }
    }
    if st.objects[o].isEnv && objOwnIndex(st, o, key) < 0 {
        match Env.get(key.clone()) {
            Option.Some(v) => {
                let val = JSValue.Str(v)
                objSet(st, o, key.clone(), cloneValue(val))
                return val
            }
            Option.None => {
                return JSValue.Undefined
            }
        }
    }
    if (st.objects[o].isMap || st.objects[o].isSet) && key == "size" {
        return JSValue.Number(st.objExtras[st.objects[o].extra].mapKeys.len() as f64)
    }
    let g = findGetter(st, o, key)
    // isCallableIn, not isCallable: a Node-API function is an OBJECT carrying a
    // napiFn index, which the value-only predicate does not recognise, so an
    // accessor defined by an addon never fired and read as undefined.
    if isCallableIn(st, g) {
        var noArgs: Vec<JSValue> = Vec.new()
        return callValue(prog, g, noArgs, JSValue.Obj(o), st)
    }
    let direct = getMember(st, o, key)
    // `constructor` fallback for builtins whose faked prototype chain has none.
    // Only when the chain gave nothing, so a user constructor is never shadowed.
    if isUndefinedValue(direct) && key == "constructor" {
        let c = builtinConstructorOf(st, o)
        if !isUndefinedValue(c) {
            return c
        }
    }
    return direct
}

// Receiver brands. 0 none, 1 %TypedArray%, 2 ArrayBuffer, 3 DataView are the
// original set; these extend it to the prototypes whose methods the spec
// brand-checks against an internal slot rather than coercing the receiver.
pub let BRAND_STRING: i64 = 4
pub let BRAND_NUMBER: i64 = 5
pub let BRAND_BOOLEAN: i64 = 6
pub let BRAND_BIGINT: i64 = 7
pub let BRAND_SYMBOL: i64 = 8
pub let BRAND_DATE: i64 = 9
// Everything on String.prototype that is NOT valueOf/toString: generic, so it
// ToStrings whatever receiver it is handed. `String.prototype.indexOf.call(["a",
// "b"], "b")` is 2, because the receiver becomes "a,b" — the array is not
// searched as an array. Only null and undefined are rejected.
pub let BRAND_STRING_GENERIC: i64 = 10
// Function.prototype.toString requires a callable receiver. is-callable is built
// on that throw: it calls it inside a try/catch and reports what comes back.
pub let BRAND_CALLABLE: i64 = 11
// Map/Set carry an internal slot the spec brand-checks; `size` is an accessor on
// each prototype, and reading it off anything else is a TypeError rather than
// undefined.
pub let BRAND_MAP: i64 = 12
pub let BRAND_SET: i64 = 13
// Promise and RegExp prototype methods brand-check their receiver too:
// `Promise.prototype.then.call({})` and `RegExp.prototype.exec.call({})` are
// TypeErrors, not calls that quietly answer undefined. Without a brand they
// accepted anything, which reads to the caller as a call that worked.
pub let BRAND_PROMISE: i64 = 14
pub let BRAND_REGEXP: i64 = 15

fn brandMatches(st: &Interp, brand: i64, recv: &JSValue): bool {
    if brand == 0 {
        return true
    }
    // The wrapper brands accept the PRIMITIVE too: String.prototype.valueOf
    // called on "abc" is fine, on [] is a TypeError. That asymmetry is exactly
    // what the is-string / is-number-object / is-boolean-object family uses as
    // its detector, and without the throw they answered true for everything.
    if brand == BRAND_CALLABLE {
        return isCallableIn(st, recv)
    }
    if brand == BRAND_STRING_GENERIC {
        match recv {
            JSValue.Null => {
                return false
            }
            JSValue.Undefined => {
                return false
            }
            _ => {
                return true
            }
        }
    }
    if brand >= BRAND_STRING && brand <= BRAND_SYMBOL {
        var prim = cloneValue(recv)
        let wh = objHandle(recv)
        if wh >= 0 {
            prim = boxedPrimitive(st, wh)
        }
        match prim {
            JSValue.Str(ps) => {
                if isSymbolStr(ps) {
                    return brand == BRAND_SYMBOL
                }
                return brand == BRAND_STRING
            }
            JSValue.Number(_pn) => {
                return brand == BRAND_NUMBER
            }
            JSValue.Bool(_pb) => {
                return brand == BRAND_BOOLEAN
            }
            JSValue.BigInt(_pg) => {
                return brand == BRAND_BIGINT
            }
            _ => {
                return false
            }
        }
    }
    let h = objHandle(recv)
    if h < 0 {
        return false
    }
    if brand == BRAND_DATE {
        return st.objects[h].isDate
    }
    if brand == 2 {
        return st.objects[h].isArrayBuffer
    }
    if brand == 3 {
        return st.objects[h].isDataView
    }
    if brand == BRAND_MAP {
        return st.objects[h].isMap
    }
    if brand == BRAND_SET {
        return st.objects[h].isSet
    }
    if brand == BRAND_PROMISE {
        return st.objects[h].promiseState >= 0
    }
    if brand == BRAND_REGEXP {
        return st.objExtras[st.objects[h].extra].regexId >= 0
    }
    return st.objExtras[st.objects[h].extra].taBuf >= 0 && !st.objects[h].isDataView
}

// Throws and returns false when `recv` is not of the bound method's brand.
fn brandOk(st: &mut Interp, boundObj: i64, mname: &string, recv: &JSValue): bool {
    let brand = st.objExtras[st.objects[boundObj].extra].boundBrand
    if brandMatches(st, brand, recv) {
        return true
    }
    // RegExp's flag accessors take any OBJECT receiver: `flags` reads its answer
    // off the receiver's properties, and %RegExp.prototype% has its own defined
    // answers. regexMethod decides which; the brand cannot, because it only sees
    // the receiver. A primitive receiver still fails here, as the spec requires.
    if brand == BRAND_REGEXP && isRegexAccessorName(mname) {
        if let JSValue.Obj(_h) = recv {
            return true
        }
    }
    st.throwing = true
    if brand == BRAND_CALLABLE {
        // node's exact wording: is-callable only checks that it throws, but
        // other code matches on the message
        st.thrownValue = makeError(st, "TypeError", "Function.prototype." + mname + " requires that 'this' be a Function")
        return false
    }
    st.thrownValue = makeError(st, "TypeError", "Method " + brandName(brand) + ".prototype." + mname + " called on incompatible receiver")
    return false
}

// A generic String.prototype method converts its receiver rather than
// dispatching on it, so the array/number/regex cases must arrive as strings.
fn coerceGenericStringReceiver(prog: &Prog, st: &mut Interp, boundObj: i64, recv: JSValue): JSValue {
    if st.objExtras[st.objects[boundObj].extra].boundBrand != BRAND_STRING_GENERIC {
        return recv
    }
    match recv {
        JSValue.Str(sv) => {
            return JSValue.Str(sv)
        }
        _ => {
            return JSValue.Str(toStrProg(prog, recv, st))
        }
    }
}

// Function.prototype.apply takes an ARRAY-LIKE, not only a real array: it reads
// `length` and then the index properties. Accepting arrays alone silently called
// the function with NO arguments for `fn.apply(null, arguments)` and for the
// `{0: x, length: 1}` shape feature-detectors use — is-callable probes exactly
// that, with a length getter that throws.
fn applyArgsInto(prog: &Prog, st: &mut Interp, v: &JSValue, out: &mut Vec<JSValue>) {
    let h = objHandle(v)
    if h < 0 {
        return
    }
    if st.objects[h].isArray {
        var ai: i64 = 0
        while ai < arrLen(st, h) {
            out.push(arrGetDyn(prog, h, ai, st))
            ai = ai + 1
        }
        return
    }
    // reading length can run a getter, and that getter can throw
    let lenV = getMemberDyn(prog, h, "length", st)
    if st.throwing {
        return
    }
    let n = toNum(lenV) as i64
    var i: i64 = 0
    while i < n {
        out.push(getMemberDyn(prog, h, numToStr(i as f64), st))
        if st.throwing {
            return
        }
        i = i + 1
    }
}

// ValidateAndApplyPropertyDescriptor's rejection rules. Answers "" when the
// definition is legal, otherwise the message Object.defineProperty would throw.
// Reported rather than thrown because Reflect.defineProperty has to turn the
// same rejection into a plain `false` — and it cannot do that by catching, since
// a Test262Error raised by user code inside a proxy trap must still propagate.
fn descRejectReason(st: &mut Interp, o: i64, key: &string, d: i64): string {
    // Copied out of the AST before anything below can re-enter the
    // interpreter and move the program storage this reference points into.
    let keyCopy = key.clone()
    let hasGet = objHasInChain(st, d, "get")
    let hasSet = objHasInChain(st, d, "set")
    let hasValue = objHasInChain(st, d, "value")
    let hasWritable = objHasInChain(st, d, "writable")
    let cannotRedefine = "Cannot redefine property: " + keyCopy.clone()
    // an accessor descriptor and a data descriptor cannot be combined
    if (hasGet || hasSet) && (hasValue || hasWritable) {
        return "Invalid property descriptor. Cannot both specify accessors and a value or writable attribute"
    }
    if hasGet {
        let g = getMember(st, d, "get")
        if !isCallableIn(st, g) && !isUndefinedValue(g) {
            return "Getter must be a function"
        }
    }
    if hasSet {
        let sv = getMember(st, d, "set")
        if !isCallableIn(st, sv) && !isUndefinedValue(sv) {
            return "Setter must be a function"
        }
    }
    // adding a property to a non-extensible object is rejected; changing one
    // that is already there stays legal
    let existing = objOwnIndex(st, o, keyCopy)
    if existing < 0 && (st.objects[o].frozen || st.objects[o].sealed || st.objects[o].noExtend) {
        return "Cannot define property " + keyCopy.clone() + ", object is not extensible"
    }
    if existing >= 0 && st.objects[o].frozen {
        return cannotRedefine
    }
    if existing >= 0 && !st.objects[o].props[existing].configurable {
        var wantsConfigurable = false
        if objHasInChain(st, d, "configurable") {
            wantsConfigurable = truthy(getMember(st, d, "configurable"))
        }
        if wantsConfigurable {
            return cannotRedefine
        }
        // a non-configurable property cannot change KIND, and cannot change its
        // enumerability
        let wasAccessor = propIsAccessor(st, o, existing)
        if (hasGet || hasSet) != wasAccessor {
            return cannotRedefine
        }
        if objHasInChain(st, d, "enumerable") && truthy(getMember(st, d, "enumerable")) != st.objects[o].props[existing].enumerable {
            return cannotRedefine
        }
        if hasValue && !st.objects[o].props[existing].writable {
            let nv = getMember(st, d, "value")
            let cur = cloneValue(st.objects[o].props[existing].value)
            // SameValue, not strict equality: redefining a non-writable +0 as -0
            // is a rejected redefinition even though the two compare equal, and
            // redefining NaN as NaN is allowed even though they do not.
            if !sameValue(nv, cur) {
                return cannotRedefine
            }
        }
        if hasWritable && !st.objects[o].props[existing].writable && truthy(getMember(st, d, "writable")) {
            return cannotRedefine
        }
    }
    return ""
}

// The throwing spelling, for Object.defineProperty and friends.
fn validDescriptor(st: &mut Interp, o: i64, key: &string, d: i64): bool {
    let reason = descRejectReason(st, o, key, d)
    if reason.len() == 0 {
        return true
    }
    st.throwing = true
    st.thrownValue = makeError(st, "TypeError", reason)
    return false
}

// Which natives answer to `new`. Everything else — Math.max, JSON.parse, every
// Object static — is a plain function, and `new` on one is a TypeError rather
// than a silently constructed object.
fn nativeIsConstructor(n: &Native): bool {
    match n {
        Native.TypedArrayCtor(_kind) => {
            return true
        }
        Native.Resolver(_promise, _isReject) => {
            return false
        }
        Native.Fn(b) => {
            return builtinIsConstructor(b)
        }
    }
}

fn builtinIsConstructor(id: Builtin): bool {
    if isErrorCtor(id) {
        return true
    }
    return id == Builtin.Proxy || id == Builtin.ObjectCtor || id == Builtin.String || id == Builtin.Number || id == Builtin.Boolean
        || id == Builtin.Date || id == Builtin.Map || id == Builtin.Set || id == Builtin.RegExp
        || id == Builtin.ArrayBuffer || id == Builtin.DataView || id == Builtin.FunctionCtor
}

// Is `new v()` allowed? Callable and constructable are different: arrows,
// methods, generators, async functions and every built-in that is a plain
// method (Math.sqrt, Array.prototype.map) can be called but not constructed.
// Mirrors the arms of the `new` evaluation below, which is what makes the two
// agree.
pub fn valueIsConstructor(prog: &Prog, st: &Interp, v: &JSValue): bool {
    if let Option.Some(n) = nativeHandle(v) {
        return nativeIsConstructor(n)
    }
    let f = funcHandle(v)
    if f >= 0 {
        if f >= prog.funcs.len() {
            return false
        }
        var mi: i64 = 0
        while mi < st.nonCtorFns.len() {
            if st.nonCtorFns[mi] == f {
                return false
            }
            mi = mi + 1
        }
        return !prog.funcs[f].isArrow && !prog.funcs[f].isMethod && !prog.funcs[f].isGenerator && !prog.funcs[f].isAsync
    }
    let o = objHandle(v)
    if o >= 0 {
        if st.objects[o].isBound {
            let ex = st.objects[o].extra
            // a built-in method VALUE (String.prototype.trim, JSON.parse read
            // off its namespace) is bound but carries a method name and no
            // target: callable, never constructable
            if st.objExtras[ex].boundMethod.len() > 0 {
                return false
            }
            return valueIsConstructor(prog, st, st.objExtras[ex].boundTarget)
        }
        // a proxy is constructable exactly when its target is
        if st.objects[o].isProxy {
            return valueIsConstructor(prog, st, st.objExtras[st.objects[o].extra].proxyTarget)
        }
        // Function.prototype is callable (it is the empty function) but is NOT
        // constructable, the one function-like object where the two differ
        if o == st.functionProtoObj {
            return false
        }
        // Array, Promise and a napi-defined class are constructor OBJECTS rather
        // than natives; isFunctionLike is what marks them
        if st.objects[o].isFunctionLike {
            return true
        }
    }
    return false
}

fn brandName(brand: i64): string {
    if brand == 2 {
        return "ArrayBuffer"
    }
    if brand == BRAND_MAP {
        return "Map"
    }
    if brand == BRAND_SET {
        return "Set"
    }
    if brand == BRAND_PROMISE {
        return "Promise"
    }
    if brand == BRAND_REGEXP {
        return "RegExp"
    }
    if brand == 3 {
        return "DataView"
    }
    if brand == BRAND_STRING {
        return "String"
    }
    if brand == BRAND_NUMBER {
        return "Number"
    }
    if brand == BRAND_BOOLEAN {
        return "Boolean"
    }
    if brand == BRAND_BIGINT {
        return "BigInt"
    }
    if brand == BRAND_SYMBOL {
        return "Symbol"
    }
    if brand == BRAND_STRING_GENERIC {
        return "String"
    }
    if brand == BRAND_CALLABLE {
        return "Function"
    }
    if brand == BRAND_DATE {
        return "Date"
    }
    return "TypedArray"
}

// GENERATED from node (see docs/backlog.md): the `length` every built-in
// function carries. test262 has a length.js per method asserting it exactly.
//
// Three names disagree across prototypes: constructor (excluded), toString
// (Number.prototype.toString is 1, everything else 0) and set
// (Map.prototype.set is 2, %TypedArray%.prototype.set is 1). `set` is no longer
// resolved from this table alone: builtinArityOn(host, name) takes the receiver
// brand and this table holds only its fallback. `toString` still uses the
// commoner value.
// GENERATED from node: the `length` of a built-in STATIC. Kept separate from
// builtinArity because the same name can differ — Object.keys is 1 while
// Array.prototype.keys is 0.
// GENERATED from node: a built-in CONSTRUCTOR own `length`.
//
// All three are DATA. They used to be 1,184 lines of `if n == "x" { return N }`,
// a linear string-compare chain per table walked on every lookup. Same 402
// values, one comma-separated string each, decoded once into a HashMap on first
// use. tools/check-arity.mjs parses these strings and still holds every value
// against node, which is what makes it safe to keep them as data.
// The table, embedded at compile time. A fn rather than a global because a
// global string needs an initializer that runs, and the embeddable library is
// built with --no-entry (same reason src/engine/uniprops.milo spells its data upData()).
pub fn ctorArityData(): string {
    return "Object:1,Array:1,String:1,Number:1,Boolean:1,Promise:1,Date:7,ArrayBuffer:1,Symbol:0,RegExp:2,Map:0,Set:0,Error:1,Function:1,WeakMap:0,WeakSet:0,Proxy:2,DataView:1,BigInt:1"
}

// The table, embedded at compile time. A fn rather than a global because a
// global string needs an initializer that runs, and the embeddable library is
// built with --no-entry (same reason src/engine/uniprops.milo spells its data upData()).
pub fn staticArityData(): string {
    return "UTC:7,abs:1,anchor:1,fontcolor:1,fontsize:1,link:1,big:0,blink:0,bold:0,fixed:0,italics:0,small:0,strike:0,sub:0,sup:0,acos:1,acosh:1,all:1,allSettled:1,any:1,apply:3,asin:1,asinh:1,assign:2,atan:1,atan2:2,atanh:1,captureStackTrace:2,cbrt:1,ceil:1,clz32:1,construct:2,cos:1,cosh:1,create:2,defineProperties:2,defineProperty:3,deleteProperty:2,entries:1,escape:1,exp:1,expm1:1,f16round:1,floor:1,for:1,freeze:1,from:1,fromAsync:1,fromCharCode:1,fromCodePoint:1,fromEntries:1,fround:1,get:2,getOwnPropertyDescriptor:2,getOwnPropertyDescriptors:1,getOwnPropertyNames:1,getOwnPropertySymbols:1,getPrototypeOf:1,groupBy:2,has:2,hasOwn:2,hypot:2,imul:2,is:2,isArray:1,isError:1,isExtensible:1,isFinite:1,isFrozen:1,isInteger:1,isNaN:1,isRawJSON:1,isSafeInteger:1,isSealed:1,isView:1,keyFor:1,keys:1,log:1,log10:1,log1p:1,log2:1,max:2,min:2,now:0,of:0,ownKeys:1,parse:2,parseFloat:1,parseInt:2,pow:2,prepareStackTrace:2,preventExtensions:1,prototype:0,race:1,random:0,raw:1,rawJSON:1,reject:1,resolve:1,round:1,seal:1,set:3,setPrototypeOf:2,sign:1,sin:1,sinh:1,sqrt:1,stringify:3,tan:1,tanh:1,trunc:1,try:1,values:1,withResolvers:0"
}

// The table, embedded at compile time. A fn rather than a global because a
// global string needs an initializer that runs, and the embeddable library is
